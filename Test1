import {
  Card,
  CardContent,
  Stack,
  Typography,
  Box,
  Paper,
  Button,
} from "@mui/material";
import React, { useState, useEffect } from "react";
import { useNavigate } from "react-router-dom";

// Icon imports remain the same...
import SpeedIcon from "@mui/icons-material/Speed";
import BusinessIcon from "@mui/icons-material/Business";
import HelpOutlineIcon from "@mui/icons-material/HelpOutline";
import LockOpenIcon from "@mui/icons-material/LockOpen";
import UploadFileIcon from "@mui/icons-material/UploadFile";
import RuleIcon from "@mui/icons-material/Rule";
import AssignmentIndIcon from "@mui/icons-material/AssignmentInd";
import MailOutlineIcon from "@mui/icons-material/MailOutline";
import ManageAccountsIcon from "@mui/icons-material/ManageAccounts";
import ArticleIcon from "@mui/icons-material/Article";
import DomainVerificationIcon from "@mui/icons-material/DomainVerification";

// Data and helper functions remain the same
const allActions = {
  IAM: {
    View: "/IamView",
    Manage_Empanelment: "/ManageSAEmpanelment",
    Empanelment_Data: "/ViewFirmDetails",
    Firm_Requests: "/EmpReqManagement",
    PreEmpanelment_Checks: "/PreEmpanelment",
    Help: "/IamHelp",
  },
  IAC: {
    View: "/IamView",
    Empanelment_Data: "/ViewFirmDetails",
    Requests: "/IamAuthoriseRequests",
    PreEmpanelment_Checks: "/PreEmpanelment",
    Template: "/EmailTemplate",
    Intimation: "/EmpanelmentIntimation",
    Help: "/IamHelp",
  },
  SAC: {
    View: "/IamView",
    Empanelment_Data: "/ViewFirmDetails",
    Firm_Requests: "/EmpReqManagement",
    PreEmpanelment_Checks: "/PreEmpanelment",
    Template: "/EmailTemplate",
    Intimation: "/EmpanelmentIntimation",
    Help: "/IamHelp",
  },
  SAM: {
    View: "/IamView",
    Manage_Empanelment: "/ManageSAEmpanelment",
    Empanelment_Data: "/ViewFirmDetails",
    Firm_Requests: "/EmpReqManagement",
    PreEmpanelment_Checks: "/PreEmpanelment",
    Help: "/IamHelp",
  },
  94: {
    View: "/IamView",
    Access: "/IamAccessAssignment",
    Requests: "/IamAuthoriseRequests",
    Help: "/IamHelp",
  },
  96: {
    View: "/IamView",
    Access: "/IamAccessAssignment",
    Requests: "/IamAuthoriseRequests",
    Help: "/IamHelp",
  },
  MAKER: { View: "/IamView", Help: "/IamHelp" },
  CHECKER: { View: "/IamView", Help: "/IamHelp" },
  Other: { View: "/IamView", Help: "/IamHelp" },
};

const actionIcons = {
  View: <SpeedIcon color="primary" sx={{ fontSize: 40 }} />,
  Access: <LockOpenIcon color="primary" sx={{ fontSize: 40 }} />,
  Help: <HelpOutlineIcon color="primary" sx={{ fontSize: 40 }} />,
  Upload_Users: <UploadFileIcon color="primary" sx={{ fontSize: 40 }} />,
  Empanelment_Data: <BusinessIcon color="primary" sx={{ fontSize: 40 }} />,
  PreEmpanelment_Checks: <RuleIcon color="primary" sx={{ fontSize: 40 }} />,
  Requests: <DomainVerificationIcon color="primary" sx={{ fontSize: 40 }} />,
  Manage_Empanelment: <ManageAccountsIcon color="primary" sx={{ fontSize: 40 }} />,
  Assignment: <AssignmentIndIcon color="primary" sx={{ fontSize: 40 }} />,
  Firm_Requests: <ArticleIcon color="primary" sx={{ fontSize: 40 }} />,
  Template: <MailOutlineIcon color="primary" sx={{ fontSize: 40 }} />,
  Intimation: <MailOutlineIcon color="primary" sx={{ fontSize: 40 }} />,
  Default: <ArticleIcon color="primary" sx={{ fontSize: 40 }} />,
};

const formatActionName = (name) => name.replace(/_/g, " ");

const glowKeyframes = `
  @keyframes textGlow {
    0% { text-shadow: 0 0 2px rgba(0, 123, 255, 0.7); }
    100% { text-shadow: 0 0 8px rgba(0, 123, 255, 1), 0 0 10px rgba(0, 123, 255, 1); }
  }
`;

export default function IamView() {
  const [userData, setUserData] = useState(null);
  const [currentUserActions, setCurrentUserActions] = useState(null);
  const navigate = useNavigate();

  useEffect(() => {
    try {
      const storedData = localStorage.getItem("user");
      if (!storedData) {
        console.error("User data not found in local storage.");
        return;
      }
      const data = JSON.parse(storedData);
      setUserData(data);

      const accessRole = data.access;
      const userRole = data.user_role;

      if (accessRole === "SAC" || accessRole === "SAM" || accessRole === "IAC" || accessRole === "IAM") {
        setCurrentUserActions(allActions[accessRole]);
      } else if (userRole === "94" || userRole === "96") {
        setCurrentUserActions(allActions[userRole]);
      } else {
        setCurrentUserActions(allActions["Other"]);
      }
    } catch (error) {
      console.error("Failed to parse user data from local storage:", error);
    }
  }, []);

  if (!userData) {
    return <p>Loading user data...</p>;
  }

  // A small component for displaying each info line to avoid repetition
  const InfoRow = ({ label, value }) => (
    <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', width: '100%' }}>
      <Typography variant="body1" color="text.secondary">
        {label}
      </Typography>
      <Box sx={{ backgroundColor: '#eef2f6', padding: '4px 12px', borderRadius: '8px', minWidth: '100px', textAlign: 'center' }}>
        <Typography variant="body2" sx={{ fontWeight: 'bold', color: '#1e3a8a' }}>
          {value}
        </Typography>
      </Box>
    </Box>
  );

  return (
    <Box sx={{ p: 3, backgroundColor: "#f0f2f5", minHeight: "100vh" }}>
      <style>{glowKeyframes}</style>
      <Typography variant="h4" gutterBottom sx={{ fontWeight: "bold", color: "#1e3a8a" }}>
        Welcome to IAM Module, {userData.first_name}!
      </Typography>

      {/* Top Information Cards -- START OF CHANGES */}
      <Stack direction={{ xs: "column", md: "row" }} spacing={3} sx={{ mb: 3 }}>
        {/* Financial Period Card */}
        <Card sx={{ flex: 1, boxShadow: 3, borderRadius: 2 }}>
          <CardContent>
            <Typography variant="h6" component="div" gutterBottom sx={{ fontWeight: "600" }}>
              Financial Period 🗓️
            </Typography>
            <Stack direction="column" spacing={2.5} sx={{ mt: 2 }}>
              <InfoRow label="Financial Year:" value={userData.financial_year} />
              <InfoRow label="Quarter:" value={userData.quarter} />
              <InfoRow label="Quarter End Date:" value={userData.quarterEndDate} />
            </Stack>
          </CardContent>
        </Card>

        {/* Circle Information Card */}
        <Card sx={{ flex: 1, boxShadow: 3, borderRadius: 2 }}>
          <CardContent>
            <Typography variant="h6" component="div" gutterBottom sx={{ fontWeight: "600" }}>
              Circle Information 🏢
            </Typography>
            <Stack direction="column" spacing={2.5} sx={{ mt: 2 }}>
              <InfoRow label="Circle Name:" value={userData.circleName} />
              <InfoRow label="Circle Code:" value={userData.circleCode} />
            </Stack>
          </CardContent>
        </Card>
      </Stack>
      {/* Top Information Cards -- END OF CHANGES */}

      {/* Quick Actions Card */}
      <Card sx={{ boxShadow: 3, borderRadius: 2 }}>
        <CardContent>
          <Typography variant="h5" sx={{ fontWeight: "bold", mb: 3, color: "#005a9c", animation: "textGlow 1.5s infinite alternate" }}>
            Quick Actions
          </Typography>
          <Stack direction="row" spacing={3} justifyContent="flex-start" sx={{ flexWrap: "wrap", gap: 2 }}>
            {currentUserActions &&
              Object.entries(currentUserActions).map(([name, path]) => (
                <Paper
                  key={name}
                  elevation={2}
                  sx={{
                    p: 2,
                    textAlign: "center",
                    width: 180,
                    height: 160,
                    display: "flex",
                    flexDirection: "column",
                    justifyContent: "space-around",
                    alignItems: "center",
                    transition: "transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out",
                    "&:hover": {
                      transform: "translateY(-8px)",
                      boxShadow: 6,
                    },
                  }}
                >
                  {actionIcons[name] || actionIcons.Default}
                  <Typography variant="body1" sx={{ fontWeight: "medium" }}>
                    {formatActionName(name)}
                  </Typography>
                  <Button
                    variant="contained"
                    size="small"
                    onClick={() => navigate(path)}
                    sx={{ textTransform: "none", borderRadius: "16px" }}
                  >
                    Access Now
                  </Button>
                </Paper>
              ))}
          </Stack>
        </CardContent>
      </Card>
    </Box>
  );
}
