    public ResponseEntity<List<RequestVoucher>> getFilteredVouchers(
            @RequestParam(required = false) @Pattern(regexp = "^[a-zA-Z0-9-]{0,50}$", message = "Invalid format") String category, 
            @RequestParam(required = false) @Pattern(regexp = "^[0-9]{0,10}$", message = "Invalid format") String role, 
            @RequestParam(required = false) @DateTimeFormat(pattern = "yyyy-MM-dd") LocalDate date) {
