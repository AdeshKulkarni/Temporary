    /**
     * The core asynchronous engine for processing massive bulk voucher uploads.
     * * PURPOSE:
     * This method safely moves up to 100,000+ rows from the Redis Cache into the Oracle Database
     * without causing OutOfMemory (OOM) errors. It acts as the final "cook" in the kitchen,
     * taking the prepared chunks, firing them into the DB in parallel, and notifying the next approver.
     * * @param batchId       The permanent Database ID for this batch (e.g., BAT-1001)
     * @param journalPrefix The prefix for individual row IDs (e.g., JRNL-500)
     * @param requestId     The temporary Cache ID used to locate the uploaded Excel data in Redis
     * @param commonRemarks Remarks applied to the batch by the maker
     * @param creatorId     The User ID of the person uploading the file
     * @param creatorRole   The Role ID of the person uploading the file
     * @param vid           The Voucher Configuration ID associated with this upload
     */
    @Async("bulkExecutor")
    public void executeAsyncBatchCreation(String batchId, String journalPrefix, String requestId, String commonRemarks, String creatorId, Integer creatorRole,  String vid) {
        
        // --- BLOCK 1: THREAD CONTEXT & SETUP ---
        // Lock key used to prevent multiple rapid clicks from processing the same file twice
        String lockKey = "LOCK_REQ_" + requestId;
        
        // MDC (Mapped Diagnostic Context) attaches the batchId and user to all logs 
        // generated by this specific background thread, making debugging in Kibana/Splunk much easier.
        MDC.put("batchId", batchId);
        MDC.put("user", creatorId);

        // Capture the MDC context to manually pass it down to the child threads we are about to spawn
        Map<String, String> contextMap = MDC.getCopyOfContextMap();
        
        // Thread-safe counter to track exactly how many rows actually made it into the database
        AtomicInteger successfulRowsCount = new AtomicInteger(0);

        log.info("ASYNC_BATCH_START | Batch: {} | Source: {}", batchId, requestId);
        long start = System.currentTimeMillis();

        try {
            // --- BLOCK 2: IDEMPOTENCY (SAFE RETRIES) ---
            // If this batch failed halfway through previously and is retrying, we delete the orphaned 
            // rows first. This guarantees we never accidentally insert duplicate data.
            jdbcTemplate.update("DELETE FROM VOUCHER_POSTING_DATA WHERE BATCH_ID = ?", batchId);
//            jdbcTemplate.update("DELETE FROM VOUCHER_POSTING WHERE BATCH_ID = ?", batchId);

            progressService.sendProgress(batchId, creatorId, 5, "PROCESSING", "Preparing Data...");

            // --- BLOCK 3: CHUNKING DISCOVERY (MEMORY PROTECTION) ---
            // We ask Redis exactly how many chunks exist. 
            // CRITICAL: We do NOT load the actual data into memory here. We just get the count.
            int totalChunks = validationStateManager.getTotalChunks(requestId);

            if (totalChunks == 0) {
                log.error("CACHE_MISS | Batch: {} | Status: No valid rows found", batchId);
                progressService.sendProgress(batchId, creatorId, 0, "FAILED", "Data cache expired or empty.");
                return;
            }

            int batchSize = 5000;
            long totalRows = batchSize * (long) totalChunks; // Used for UI progress bar estimation

            // Arrays to hold the active threads and thread-safe accumulators for balancing checks
            List<CompletableFuture<Void>> futures = new ArrayList<>();
            AtomicReference<BigDecimal> totalDebit = new AtomicReference<>(BigDecimal.ZERO);
            AtomicReference<BigDecimal> totalCredit = new AtomicReference<>(BigDecimal.ZERO);
            AtomicInteger completedChunks = new AtomicInteger(0);

            // --- BLOCK 4: THE PARALLEL ENGINE ---
            // Loop through the total number of chunks (e.g., 20 chunks of 5,000 rows = 100,000 rows)
            for (int i = 0; i < totalChunks; i++) {
                final int chunkIndex = i;
                final int startIdx = i * batchSize;

                // Spawn a new background thread for EACH chunk using the custom chunkWorkerExecutor pool
                CompletableFuture<Void> future = CompletableFuture.supplyAsync(() -> {
                    
                    // THREAD STEP A: Fetch exactly one chunk (5000 rows) from Redis into memory
                    // Once this thread finishes, Java's Garbage Collector will instantly delete this chunk from RAM.
                    return validationStateManager.getChunkFromCache(requestId, chunkIndex);
                    
                }, chunkWorkerExecutor).thenAcceptAsync(chunk -> {
                    
                    // THREAD STEP B: Insert the chunk into Oracle
                    if (contextMap != null) MDC.setContextMap(contextMap); // Restore logging context
                    try {
                        // Pass the 5000 rows to raw JDBC for ultra-fast bulk insertion
                        self.processChunkRaw(chunk, batchId, journalPrefix, commonRemarks, creatorId, creatorRole, startIdx, totalDebit, totalCredit);
                        successfulRowsCount.addAndGet(chunk.size());
                    } finally {
                        MDC.clear(); // Clean up thread local variables to prevent memory leaks
                    }
                    
                }, chunkWorkerExecutor).thenRun(() -> {
                    
                    // THREAD STEP C: Update the UI Progress Bar
                    // Every time a thread finishes, increment the counter and push the % to the React frontend
                    int done = completedChunks.incrementAndGet();
                    int percent = 5 + (done * 90 / totalChunks);
                    progressService.sendProgress(batchId, creatorId, percent, "PROCESSING", String.format("Writing chunks: %d of %d", done, totalChunks));
                });

                // Add this thread to our tracking list
                futures.add(future);
            }
            
            // --- BLOCK 5: THE SYNCHRONIZATION BARRIER ---
            // The main thread pauses here. It waits until ALL 50/100/etc spawned threads finish their work.
            // Timeout is set to 45 minutes to prevent infinite hanging if the DB crashes.
            CompletableFuture.allOf(futures.toArray(new CompletableFuture[0])).get(45, TimeUnit.MINUTES);

            progressService.sendProgress(batchId, creatorId, 100, "COMPLETED", "Batch Created Successfully");

            // --- BLOCK 6: HANDSHAKE & NOTIFICATION ---
            
            // 6A. FLIP STATUS TO PENDING 
            // Only update to 'P' if the Maker has already clicked "Submit" on Step 3 (meaning it is currently 'S' and a schedule choice was made).
            jdbcTemplate.update("""
                UPDATE VOUCHER_POSTING 
                SET BATCH_STATUS = 'P' 
                WHERE BATCH_ID = ? 
                AND (IS_EXECUTION_SCHEDULED = 'YES' OR IS_EXECUTION_SCHEDULED = 'NO')
                AND BATCH_STATUS = 'S'
            """, batchId);

            log.info("BATCH_CREATION_FINISHED | Batch: {} | Rows: {}", batchId, totalRows);

            // 6B. SEND CHECKER NOTIFICATION
            // Because the data is now fully loaded in the DB, it is 100% safe to email the Checker.
            try {
                // Look up the role ID and stage name for "Step 2" in the workflow configurations
                String wfSql = """
                    SELECT wt.ALLOWED_ROLE_ID, wt.WORKFLOW_STAGE 
                    FROM VOUCHER_POSTING vp 
                    JOIN WORKFLOW_TRANSITIONS wt ON vp.PENDING_AT = wt.WORKFLOW_ID 
                    WHERE vp.BATCH_ID = ? AND wt.WORKFLOW_ORDER = 2
                """;

                Map<String, Object> step2Info = jdbcTemplate.queryForMap(wfSql, batchId);
                String nextApproverRoleId = String.valueOf(step2Info.get("ALLOWED_ROLE_ID"));
                String stageName = (String) step2Info.get("WORKFLOW_STAGE");

                // Trigger the email/alert to the Checker's inbox
                notificationWriterService.createNextStepApprovalNotification(batchId, nextApproverRoleId, stageName);
                log.info("Notification sent to Checker Role {} for Bulk Batch {}", nextApproverRoleId, batchId);
            } catch (EmptyResultDataAccessException e) {
                log.error("Could not find Step 2 workflow configuration for Batch {} to send notification.", batchId);
            }


        }
        // --- BLOCK 7: ERROR HANDLING & CLEANUP ---
        catch (Exception e) {
            // If the database connection drops, or threads time out, catch the fatal error.
            log.error("BATCH_FATAL_ERROR | Batch: {} | Error: {}", batchId, e.getMessage());
            // Revert the DB status to 'ERROR' and notify the Maker that their upload crashed.
            handleAsyncFailure(batchId, creatorId, requestId, "An internal error occurred.");
        } finally {
            // ALWAYS release the Redis lock so the user can try again, and clear the logging context.
            redisTemplate.delete(lockKey);
            MDC.clear();
        }
    }

