You are an absolute lifesaver, and you hit the nail right on the head!
You found the exact Oracle limitation. Oracle 12c's OFFSET ... FETCH NEXT syntax internally rewrites the query using analytic functions (like ROW_NUMBER()). When Oracle Data Redaction is enabled on those columns, it panics and throws **ORA-28094** because it refuses to apply those internal functions to protected data.
To bypass this Oracle bug, we must abandon the modern OFFSET ... FETCH NEXT syntax and use the **Classic Oracle ROWNUM Pagination** (SELECT * FROM (SELECT a.*, ROWNUM rnum FROM (...) a WHERE ROWNUM <= limit) WHERE rnum > offset).
Here are the completely fixed versions of **BOTH** methods in your VoucherQueryService.java. Replace them exactly as shown:
### 1. Fixed getPendingBatchesForChecker
```java
    public Map<String, Object> getPendingBatchesForChecker(Integer userRole, String userId, int page, int size, String batchIdFilter, String vidFilter) {
        
        // 1. Flattened WHERE Clause (Safe from Redaction)
        StringBuilder whereClause = new StringBuilder("""
            WHERE w.ALLOWED_ROLE_ID = ? AND p.BATCH_STATUS = 'P'
            AND vw_check.BATCH_ID_FK IS NULL
        """);
        
        List<Object> params = new java.util.ArrayList<>();
        params.add(userRole);

        if (batchIdFilter != null && !batchIdFilter.trim().isEmpty()) {
            whereClause.append(" AND p.BATCH_ID LIKE ? ");
            params.add("%" + batchIdFilter.trim() + "%");
        }
        if (vidFilter != null && !vidFilter.trim().isEmpty()) {
            whereClause.append(" AND p.VID_FK LIKE ? "); 
            params.add("%" + vidFilter.trim() + "%");
        }

        // 2. Count Query
        String countSql = """
            SELECT COUNT(*) 
            FROM VOUCHER_POSTING p 
            INNER JOIN WORKFLOW_TRANSITIONS w ON p.PENDING_AT = w.WORKFLOW_ID
            LEFT JOIN VOUCHER_WORKFLOW vw_check ON vw_check.BATCH_ID_FK = p.BATCH_ID AND vw_check.LAST_ACTION_BY = ?
            """ + whereClause.toString();
        
        List<Object> countParams = new java.util.ArrayList<>(params);
        countParams.add(userId);
        Long totalElements = jdbcTemplate.queryForObject(countSql, Long.class, countParams.toArray());

        // 3. CLASSIC ORACLE ROWNUM PAGINATION (Bypasses ORA-28094)
        int offset = page * size;
        int limit = offset + size;
        
        String sql = """
            SELECT * FROM (
                SELECT a.*, ROWNUM rnum FROM (
                    SELECT 
                        p.BATCH_ID, p.VID_FK AS VID, p.CREATED_BY AS CREATOR_ID, p.CREATED_AT AS REQ_DATE, 
                        p.COMMON_BATCH_REMARKS AS BATCH_REMARKS, p.RECORDS_COUNT AS TOTAL_ROWS, 
                        p.SCHEDULED_TIME, w.WORKFLOW_STAGE, w.WORKFLOW_CODE, w.ESCALATION_TIME, 
                        w.WORKFLOW_ORDER, w.IS_FINAL_APPROVAL,
                        COALESCE(u.FIRST_NAME || ' ' || u.LAST_NAME, p.CREATED_BY) AS CREATOR_NAME
                    FROM VOUCHER_POSTING p
                    INNER JOIN WORKFLOW_TRANSITIONS w ON p.PENDING_AT = w.WORKFLOW_ID
                    LEFT JOIN USERS u ON p.CREATED_BY = u.USER_ID
                    LEFT JOIN VOUCHER_WORKFLOW vw_check ON vw_check.BATCH_ID_FK = p.BATCH_ID AND vw_check.LAST_ACTION_BY = ?
                    """ + whereClause.toString() + """
                    ORDER BY p.CREATED_AT DESC
                ) a WHERE ROWNUM <= ?
            ) WHERE rnum > ?
        """;

        List<Object> dataParams = new java.util.ArrayList<>(params);
        dataParams.add(userId); 
        dataParams.add(limit);   // ROWNUM <= limit
        dataParams.add(offset);  // rnum > offset

        List<Map<String, Object>> pendingList = jdbcTemplate.query(sql, (rs, rowNum) -> {
            Map<String, Object> map = new HashMap<>();
            map.put("batchId", rs.getString("BATCH_ID"));
            map.put("vid", rs.getString("VID"));
            map.put("creatorId", rs.getString("CREATOR_ID"));
            map.put("creatorName", rs.getString("CREATOR_NAME"));
            map.put("requestDate", rs.getTimestamp("REQ_DATE"));
            map.put("commonBatchRemarks", rs.getString("BATCH_REMARKS"));
            map.put("requestCount", rs.getLong("TOTAL_ROWS"));
            map.put("escalationTime", rs.getLong("ESCALATION_TIME"));
            map.put("workflowState", rs.getString("WORKFLOW_STAGE"));
            map.put("approvalWorkflow", rs.getString("WORKFLOW_CODE"));
            map.put("currentOrder", rs.getObject("WORKFLOW_ORDER"));
            map.put("isFinalApproval", rs.getString("IS_FINAL_APPROVAL"));
            return map;
        }, dataParams.toArray());

        for (Map<String, Object> row : pendingList) {
            row.put("timeSinceLastAction", calculateTimeSinceLastAction((String) row.get("batchId")));
        }

        Map<String, Object> response = new HashMap<>();
        response.put("content", pendingList);
        response.put("totalElements", totalElements != null ? totalElements : 0);
        return response;
    }

