This update restructures the Frontend to use two distinct steppers as requested:
 * Main Stepper: Tracks the overall user flow (Upload & Validate → Preview & Submit).
 * Validation Stepper: Tracks the internal progress of the validation (Format → Database → Balance).
I also moved the Product Code column to the last position in the preview table and added the Back button functionality.
Frontend Code: JournalBulkUpload.js
import React, { useState, useRef, useEffect } from "react";
import {
  Box,
  Typography,
  Paper,
  TextField,
  Button,
  CircularProgress,
  Chip,
  Alert,
  Stack,
  Stepper,
  Step,
  StepLabel,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  TablePagination
} from "@mui/material";
import {
  CloudUpload as CloudUploadIcon,
  RestartAlt as RestartAltIcon,
  Description as DescriptionIcon,
  Send as SendIcon,
  FileDownload as FileDownloadIcon,
  ArrowBack as ArrowBackIcon
} from "@mui/icons-material";
import { alpha } from "@mui/material/styles";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

// ==========================================
//  STYLES
// ==========================================
const mainContainerStyle = { padding: 3, height: "100%", width: "100%" };
const controlPanelStyle = { padding: "30px", marginBottom: "20px", borderRadius: "12px", backgroundColor: "background.paper", boxShadow: (theme) => theme.shadows[1] };
const uploadBoxStyle = { display: "flex", flexDirection: "column", justifyContent: "center", alignItems: "center", border: 2, borderStyle: "dashed", borderColor: "primary.main", borderRadius: "12px", padding: "40px", cursor: "pointer", backgroundColor: (theme) => alpha(theme.palette.primary.main, 0.02), transition: "all 0.3s ease", minHeight: "200px", "&:hover": { backgroundColor: (theme) => alpha(theme.palette.primary.main, 0.08), borderColor: "primary.dark" } };
const iconStyle = { fontSize: "5rem", color: "primary.main", marginBottom: "16px" };
const headerTextStyle = { fontWeight: 600, fontSize: "1.1rem", textAlign: "center", color: "text.primary" };
const subTextStyle = { color: "text.secondary", fontSize: "0.85rem", textAlign: "center", marginTop: "4px" };
const dateinputfield = { display: "flex", justifyContent: "center", marginBottom: "30px", "& .MuiTextField-root": { minWidth: "250px" } };
const tableContainerStyle = { borderRadius: "12px", border: "1px solid", borderColor: "divider", overflow: "hidden", marginTop: "20px", boxShadow: (theme) => theme.shadows[1], maxHeight: 600 };
const tableHeaderStyle = { backgroundColor: (theme) => alpha(theme.palette.primary.main, 0.08) };
const tableHeaderCellStyle = { color: "text.primary", fontWeight: "bold", fontSize: "0.95rem" };
const actionButtonsContainer = { display: "flex", justifyContent: "center", marginTop: 4, gap: 2 };

// ==========================================
//  CONSTANTS
// ==========================================
// Main Workflow Steps
const mainSteps = ['Upload & Validate', 'Preview & Submit'];

// Inner Validation Progress Steps
const validationSteps = ['Format Validation', 'Database Validation', 'Balance Validation'];

const JournalBulkUpload = () => {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  // --- STATE ---
  const [activeStep, setActiveStep] = useState(0); // 0 = Upload, 1 = Preview

  const [selectedDate, setSelectedDate] = useState("");
  const [file, setFile] = useState(null);
  const [isCsvFile, setIsCsvFile] = useState(false);
  const fileInputRef = useRef(null);

  const [requestId, setRequestId] = useState(null);
  const [isProcessing, setIsProcessing] = useState(false);
  
  // validationStage: 0=Idle, 1=Format, 2=DB, 3=Balance, 4=Done
  const [validationStage, setValidationStage] = useState(0); 
  const [resultStatus, setResultStatus] = useState(null); // 'SUCCESS' or 'ERROR'
  const [resultMsg, setResultMsg] = useState("");
  const [autoDlTriggered, setAutoDlTriggered] = useState(false);
  
  const [previewRows, setPreviewRows] = useState([]);
  const [totalRows, setTotalRows] = useState(0);

  const [page, setPage] = useState(0);
  const [rowsPerPage, setRowsPerPage] = useState(50);
  const [isCreatingBatch, setIsCreatingBatch] = useState(false);

  // --- HANDLERS ---

  const handleDateChange = (e) => setSelectedDate(e.target.value);

  const handleFileSelect = (e) => {
    if (e.target.files[0]) {
      const selected = e.target.files[0];
      setFile(selected);
      setIsCsvFile(selected.name.toLowerCase().endsWith(".csv") || selected.name.toLowerCase().endsWith(".txt"));
      
      // Reset validation state, but keep the file
      setResultStatus(null);
      setResultMsg("");
      setValidationStage(0);
      setPreviewRows([]);
      setAutoDlTriggered(false);
    }
  };

  const resetAll = () => {
    setActiveStep(0);
    setRequestId(null);
    setResultStatus(null);
    setValidationStage(0);
    setResultMsg("");
    setPreviewRows([]);
    setTotalRows(0);
    setIsProcessing(false);
    setAutoDlTriggered(false);
    setIsCsvFile(false);
    setFile(null);
    setPage(0);
    if (fileInputRef.current) fileInputRef.current.value = "";
  };

  const handleBack = () => {
    // Go back to upload step, reset validation visualization but keep file/date
    setActiveStep(0);
    setResultStatus(null);
    setValidationStage(0);
    setResultMsg("");
    setIsProcessing(false);
    setAutoDlTriggered(false);
  };

  const handleDownloadTemplate = async () => {
    try {
      let token = "";
      const sAuth = sessionStorage.getItem("persist:auth") || localStorage.getItem("persist:auth");
      if (sAuth) { try { token = JSON.parse(sAuth).token.replace(/"/g, ""); } catch (e) { } }
      const res = await fetch("/JS/journals/download-template", { headers: { Authorization: `Bearer ${token}` } });
      if (!res.ok) throw new Error("Template download failed");
      const blob = await res.blob();
      const url = window.URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url; link.setAttribute("download", "Journal_Upload_Template.xlsx");
      document.body.appendChild(link); link.click(); link.remove();
    } catch (e) { showSnackBar("Failed to download template", "error"); }
  };

  const handleStartValidation = async () => {
    if (!selectedDate || !file) { showSnackBar("Please select Date and File.", "warning"); return; }
    setResultStatus(null); setResultMsg(""); setValidationStage(0); 
    setIsProcessing(true); setAutoDlTriggered(false);

    const formData = new FormData();
    formData.append("file", file);
    formData.append("postingDate", selectedDate);

    try {
      let token = "";
      const sAuth = sessionStorage.getItem("persist:auth") || localStorage.getItem("persist:auth");
      if (sAuth) { try { token = JSON.parse(sAuth).token.replace(/"/g, ""); } catch (e) { } }

      const res = await fetch("/JS/journals/bulk-validate-init", {
        method: "POST", headers: { "Authorization": `Bearer ${token}` }, body: formData
      });
      if (!res.ok) throw new Error(await res.text());
      const data = await res.json();
      setRequestId(data.requestId);
    } catch (err) {
      setIsProcessing(false); setResultStatus("ERROR"); setResultMsg("Init Failed: " + err.message);
    }
  };

  // --- POLLING EFFECT ---
  useEffect(() => {
    let interval;
    if (isProcessing && requestId) {
      interval = setInterval(async () => {
        try {
          const res = await callApi(`/JS/journals/bulk-status/${requestId}`, null, "GET");
          if (!res) return;
          
          if (res.totalRows) setTotalRows(res.totalRows);
          
          if (res.status === "ERROR") {
            setIsProcessing(false);
            setResultStatus("ERROR");
            setResultMsg(res.message);
            // Ensure stage reflects where it failed for the inner stepper
            setValidationStage(res.currentStage || 1); 
            
            clearInterval(interval);
            showSnackBar(res.message, "error", 5000);
            
            if (res.hasErrorFile && !autoDlTriggered) {
              setAutoDlTriggered(true);
              handleDownloadFile("ERROR", res.requestId);
            }
          }
          else if (res.status === "SUCCESS") {
            setIsProcessing(false);
            setResultStatus("SUCCESS");
            setValidationStage(4); // Inner stepper complete
            setTotalRows(res.totalRows);
            
            if (res.previewDataJson) {
              setPreviewRows(JSON.parse(res.previewDataJson));
            }
            clearInterval(interval);
            showSnackBar("Validation Complete. Proceeding to Preview...", "success");
            
            // AUTOMATICALLY GO FORWARD TO STEP 2
            setTimeout(() => {
                setActiveStep(1);
            }, 1000);
          } else {
             // Still Processing
             setValidationStage(res.currentStage);
          }
        } catch (e) { }
      }, 800);
    }
    return () => clearInterval(interval);
  }, [isProcessing, requestId, callApi, showSnackBar, autoDlTriggered]);

  const handleDownloadFile = async (type, reqId = requestId) => {
    try {
      if(type === "ERROR") showSnackBar("Downloading Error Report...", "info");
      let token = "";
      const sAuth = sessionStorage.getItem("persist:auth") || localStorage.getItem("persist:auth");
      if (sAuth) { try { token = JSON.parse(sAuth).token.replace(/"/g, ""); } catch (e) { } }
      const response = await fetch(`/JS/journals/download-bulk-file/${reqId}?type=${type}`, {
        headers: { Authorization: `Bearer ${token}` }
      });
      if (!response.ok) throw new Error("Download failed");
      const blob = await response.blob();
      const url = window.URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.setAttribute("download", type === "ERROR" ? "Error_Report.xlsx" : "Success_Batch.csv");
      document.body.appendChild(link); link.click(); link.remove();
      if(type === "SUCCESS") showSnackBar("Downloaded successfully.", "success");
    } catch (e) { showSnackBar("Download failed", "error"); }
  };

  const handleCreateBatch = async () => {
    setIsCreatingBatch(true);
    try {
      const payloadRows = previewRows.map((row) => ({
        changeType: "ADD",
        branch: row.branch,
        currency: row.currency,
        cgl: row.cgl,
        amount: row.amount, 
        productType: row.productCode,
        remarks: row.remarks,
        arFlag: "A",
        acClassification: "A",
      }));
      const finalPayload = { commonBatchRemarks: `Bulk Upload - ${selectedDate}`, rows: payloadRows };
      const response = await callApi("/JS/journals/create-bulk-batch", finalPayload, "POST");
      if (response && response.status === "SUCCESS") {
        showSnackBar(`Batch Created! ID: ${response.batchId}`, "success", 5000);
        resetAll();
      } else { throw new Error(response.message || "Failed"); }
    } catch (e) { showSnackBar("Failed to create batch: " + e.message, "error");
    } finally { setIsCreatingBatch(false); }
  };

  // --- PAGINATION LOGIC ---
  const handleChangePage = (event, newPage) => {
    const maxRows = 2000;
    const nextIndex = newPage * rowsPerPage;
    if (nextIndex >= maxRows || nextIndex >= previewRows.length) {
       if (previewRows.length >= maxRows) {
          showSnackBar("We are showing a maximum of 2000 rows for preview.", "info");
       }
    }
    setPage(newPage);
  };

  const handleChangeRowsPerPage = (event) => {
    setRowsPerPage(parseInt(event.target.value, 10));
    setPage(0);
  };

  const visibleRows = previewRows.slice(page * rowsPerPage, page * rowsPerPage + rowsPerPage);

  // --- INNER STEPPER HELPER ---
  const isValidationStepFailed = (index) => {
    return resultStatus === 'ERROR' && index === (validationStage - 1);
  };

  return (
    <Box sx={mainContainerStyle}>
      <Paper elevation={1} sx={controlPanelStyle}>
        
        {/* HEADER ACTIONS */}
        <Box sx={{ display: 'flex', justifyContent: 'flex-end', mb: 2 }}>
          <Button variant="text" startIcon={<FileDownloadIcon />} onClick={handleDownloadTemplate}>Download Template</Button>
        </Box>

        {/* --- MAIN STEPPER (Upload -> Preview) --- */}
        <Box sx={{ width: '100%', mb: 4 }}>
          <Stepper activeStep={activeStep}>
            {mainSteps.map((label) => (
              <Step key={label}>
                <StepLabel>{label}</StepLabel>
              </Step>
            ))}
          </Stepper>
        </Box>

        {/* ========================================================= */}
        {/* STEP 1: UPLOAD & VALIDATE */}
        {/* ========================================================= */}
        {activeStep === 0 && (
          <Box>
            
            {/* INPUTS */}
            <Box sx={dateinputfield}>
               <TextField type="date" label="Posting Date" value={selectedDate} onChange={handleDateChange} InputLabelProps={{ shrink: true }} size="small" disabled={isProcessing} sx={{ width: 200 }} />
            </Box>
           
            <Box 
              sx={{
                ...uploadBoxStyle, 
                borderColor: resultStatus === 'ERROR' ? 'error.main' : 'primary.main', 
                opacity: isProcessing ? 0.6 : 1
              }} 
              onClick={() => { if (!isProcessing) fileInputRef.current.click(); }}
            >
              <input type="file" hidden ref={fileInputRef} onChange={handleFileSelect} accept=".xlsx,.csv" />
              {file ? (
                <>
                  <DescriptionIcon sx={{ fontSize: 60, color: "success.main", mb: 1 }} />
                  <Typography sx={headerTextStyle}>{file.name}</Typography>
                  <Typography sx={subTextStyle}>Click to change</Typography>
                </>
              ) : (
                <>
                  <CloudUploadIcon sx={iconStyle} />
                  <Typography sx={headerTextStyle}>Click to Upload File</Typography>
                  <Typography sx={subTextStyle}>.xlsx, .csv (Max 50MB)</Typography>
                </>
              )}
            </Box>

            {/* INNER STEPPER: VISIBLE ONLY DURING PROCESSING OR ERROR */}
            {(isProcessing || resultStatus) && (
                <Box sx={{ mt: 4, mb: 2 }}>
                    <Stepper activeStep={validationStage - 1} alternativeLabel>
                        {validationSteps.map((label, index) => {
                        const labelProps = {};
                        if (isValidationStepFailed(index)) {
                            labelProps.optional = <Typography variant="caption" color="error">Failed</Typography>;
                            labelProps.error = true;
                        }
                        return (
                            <Step key={label}>
                            <StepLabel {...labelProps}>{label}</StepLabel>
                            </Step>
                        );
                        })}
                    </Stepper>
                </Box>
            )}

            {/* ERROR MESSAGE */}
            {resultStatus === 'ERROR' && (
                <Alert severity="error" sx={{ mt: 3, mx: 'auto', maxWidth: '80%' }}>
                    {resultMsg} — Downloading Error Report...
                </Alert>
            )}

            <Stack direction="row" sx={actionButtonsContainer}>
              <Button 
                variant="contained" 
                size="large" 
                onClick={handleStartValidation} 
                disabled={!file || !selectedDate || isProcessing} 
                startIcon={isProcessing ? <CircularProgress size={20} color="inherit"/> : <SendIcon/>}
              > 
                {isProcessing ? "Validating..." : "Start Validation"} 
              </Button>
            </Stack>
          </Box>
        )}

        {/* ========================================================= */}
        {/* STEP 2: PREVIEW & SUBMIT */}
        {/* ========================================================= */}
        {activeStep === 1 && (
          <Box>
            <Stack direction="row" justifyContent="space-between" alignItems="center" sx={{mb: 2}}>
                <Alert severity="success" sx={{ flexGrow: 1, mr: 2 }}>
                  Validation Successful! Total Rows: {totalRows.toLocaleString()}
                </Alert>
                
                {/* HIDE DOWNLOAD IF CSV UPLOADED */}
                {!isCsvFile && (
                  <Button variant="outlined" startIcon={<FileDownloadIcon />} onClick={() => handleDownloadFile("SUCCESS")}>
                    Download CSV
                  </Button>
                )}
            </Stack>

            {/* TABLE PREVIEW */}
            <TableContainer sx={tableContainerStyle}>
              <Table stickyHeader size="small">
                <TableHead sx={tableHeaderStyle}>
                  <TableRow>
                    <TableCell sx={tableHeaderCellStyle} align="center">Branch</TableCell>
                    <TableCell sx={tableHeaderCellStyle} align="center">Currency</TableCell>
                    <TableCell sx={tableHeaderCellStyle} align="center">CGL</TableCell>
                    <TableCell sx={tableHeaderCellStyle} align="right">Amount</TableCell>
                    <TableCell sx={tableHeaderCellStyle} align="center">Type</TableCell>
                    <TableCell sx={tableHeaderCellStyle} align="center">Remarks</TableCell>
                    {/* PRODUCT CODE MOVED TO LAST */}
                    <TableCell sx={tableHeaderCellStyle} align="center">Product</TableCell>
                  </TableRow>
                </TableHead>
                <TableBody>
                  {visibleRows.map((row, index) => (
                    <TableRow key={index} hover>
                      <TableCell align="center">{row.branch}</TableCell>
                      <TableCell align="center">{row.currency}</TableCell>
                      <TableCell align="center">{row.cgl}</TableCell>
                      <TableCell align="right">{row.amount}</TableCell>
                      <TableCell align="center">
                        <Chip 
                          label={row.txnType} 
                          color={row.txnType.includes("Credit") ? "error" : "success"} 
                          size="small" 
                          variant="filled" 
                          sx={{ fontWeight: "bold", width: "80px" }}
                        />
                      </TableCell>
                      <TableCell align="center">{row.remarks}</TableCell>
                      {/* PRODUCT CODE MOVED TO LAST */}
                      <TableCell align="center">{row.productCode || "-"}</TableCell>
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            </TableContainer>
            
            <TablePagination
              rowsPerPageOptions={[50, 100, 200]}
              component="div"
              count={previewRows.length} // Should be max 2000 based on backend
              rowsPerPage={rowsPerPage}
              page={page}
              onPageChange={handleChangePage}
              onRowsPerPageChange={handleChangeRowsPerPage}
              labelDisplayedRows={({ from, to, count }) => {
                 return `${from}-${to} of ${count !== -1 ? count : `more than ${to}`}`;
              }}
            />

            <Stack direction="row" sx={actionButtonsContainer}>
              <Button variant="outlined" onClick={handleBack} disabled={isCreatingBatch} startIcon={<ArrowBackIcon />}>
                Back
              </Button>
              <Button variant="text" onClick={resetAll} disabled={isCreatingBatch} startIcon={<RestartAltIcon />}>
                 Cancel
              </Button>
              <Button 
                variant="contained" 
                color="success" 
                size="large" 
                onClick={handleCreateBatch} 
                disabled={isCreatingBatch} 
                startIcon={isCreatingBatch ? <CircularProgress size={20} color="inherit" /> : <SendIcon />}
              > 
                {isCreatingBatch ? "Creating Batch..." : "Submit Batch"} 
              </Button>
            </Stack>
          </Box>
        )}
      </Paper>
    </Box>
  );
};
export default JournalBulkUpload;

