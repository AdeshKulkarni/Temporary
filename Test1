CREATE INDEX "FINCORE"."IDX_JR_BATCH_ID" 
ON "FINCORE"."VOUCHER_POSTING_DATA" ("BATCH_ID") 
TABLESPACE "TBS_FINCORE";

-- 2. Batch ID & Status Composite Index
CREATE INDEX "FINCORE"."IDX_JR_BATCH_OPT" 
ON "FINCORE"."VOUCHER_POSTING_DATA" ("BATCH_ID", "REQ_STATUS") 
TABLESPACE "TBS_FINCORE";

-- 3. Branch Code Index
CREATE INDEX "FINCORE"."IDX_JR_BRANCH_CODE" 
ON "FINCORE"."VOUCHER_POSTING_DATA" ("REQ_BRANCH_CODE") 
TABLESPACE "TBS_FINCORE";

-- 4. Journal ID Index (Only run this if JOURNAL_ID is NOT your Primary Key!)
CREATE INDEX "FINCORE"."IDX_JR_JOURNAL_ID" 
ON "FINCORE"."VOUCHER_POSTING_DATA" ("JOURNAL_ID") 
TABLESPACE "TBS_FINCORE";
