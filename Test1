  "sofia",
];
Quill.register(Font, true);

const iv = crypto.getRandomValues(new Uint8Array(12));
const ivBase64 = btoa(String.fromCharCode.apply(null, iv));
const salt = crypto.getRandomValues(new Uint8Array(16));
const saltBase64 = btoa(String.fromCharCode.apply(null, salt));

const EmailTemplate = () => {
  // Split template into header and body
  const [headerContent, setHeaderContent] = useState(
    "Non-editable header will appear here"
  );
  const [bodyContent, setBodyContent] = useState(
    "Editable body will appear here"
  );
  const [sbar, setSbar] = useState({ isOpen: false, Msg: "" });
  const [wordCount, setWordCount] = useState(0);
  const [isEditing, setIsEditing] = useState(false);
  const [isPreviewing, setIsPreviewing] = useState(false);
  const [templateContent, settemplateContent] = useState(null);

  const draftVar = [
    "{{DATE}}",
    "{{REF_NO}}",
    "{{FIRM_NAME}}",
    "{{FRN_NO}}",
    "{{FIRM_ADDR}}",
    "{{ASSIGNMENT_TYPE}}",
    "{{GSTN}}",
  ];

  const bodyEditorRef = useRef(null);
  const headerEditorRef = useRef(null);

  const modules = {
    toolbar: [
      [
        {
          font: Font.whitelist,
        },
      ],
      [
        {
          size: [
            "8px",
            "10px",
            "12px",
            "14px",
            "16px",
            "18px",
            "20px",
            "22px",
            "24px",
            "26px",
          ],
        },
      ],
      [
        { color: ["red", "green", "blue", "black", "orange"] },
        { background: ["red", "green", "blue", "yellow", "gray"] },
      ],
      [{ align: "justify" }, { align: "center" }, { align: "right" }],
      [{ script: "sub" }, { script: "super" }],
      [{ header: [1, 2, 3, false] }],
      [{ list: "ordered" }, { list: "bullet" }],
      ["bold", "italic", "underline", "strike"],
      ["link", "image", "clean"],
      [{ indent: "-1" }, { indent: "+1" }],
    ],
    clipboard: {
      matchVisual: false,
    },
    imageResize: {
      modules: ["Resize", "DisplaySize"],
    },
  };

  useEffect(() => {
    Quill.register(VariableBlot);
    fetchData();
  }, []);

  const fetchData = async () => {
    try {
      const response = await axios.post(
        "Server/IAMServices/EmailTemplate",
        {},
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      let res = response.data.result;

      // Split template into header and body sections
      let str = "EMPANELMENT OF THE FIRM INTIMATION</h4>";
      const splitIndex = res.indexOf(str) + str.length;

      if (splitIndex > str.length - 1) {
        setHeaderContent(res.substring(0, splitIndex));
        setBodyContent(res.substring(splitIndex));
      } else {
        setHeaderContent(res);
        setBodyContent("");
      }
      setWordCount(countWord(res));
    } catch (e) {
      console.log(e);
    }
  };

  function countWord(str) {
    const text = str.replace(/<[^>]*>/g, "");
    const words = text.trim().split(/\s+/).filter(Boolean);
    return words.length;
  }
  const handleBodyChange = (content, delta, source, editor) => {
    if (source == "api") {
      return;
    }
    let htmlContent = editor.getHTML();
    let length = countWord(htmlContent);

    // Validation for special characters
    const insertedOp = delta.ops?.find((op) => typeof op.insert === "string");
    if (insertedOp) {
      const inserted = insertedOp.insert;
      const len = insertedOp.insert.length;

      // Block characters that are NOT allowed
      const illegalChar = inserted.match(/[^a-zA-Z0-9_\s.,;!?'"()\{\}\-@]/);

      if (illegalChar) {
        setTimeout(() => {
          const quillEditor = bodyEditorRef.current?.getEditor();
          if (quillEditor) {
            const selection = quillEditor.getSelection();
            let position = selection?.index || quillEditor.getLength();
            quillEditor.deleteText(position - len, len, "silent");
          }
        }, 10);
        setSbar({
          isOpen: true,
          Msg: "❌ Special characters are not allowed!",
        });
      }
    }

    // Word limit validation
    if (length > 2000) {
      const quillEditor = bodyEditorRef.current?.getEditor();
      if (quillEditor) {
        const selection = quillEditor.getSelection();
        let position = selection?.index || quillEditor.getLength();
        quillEditor.deleteText(position - 1, 1, "silent");
        setSbar({
          isOpen: true,
          Msg: "Word limit exceeded. Please reduce content.",
        });
        return;
      }
    }

    setBodyContent(htmlContent);
    setWordCount(length);
  };
  const handleDragStart = (e) => {
    const text = e.target.innerText;
    e.dataTransfer.setData("text", text);
  };

  // const handleDrop = (e) => {
  //   e.preventDefault();
  //   if (!isEditing) return;

  //   const editor = bodyEditorRef.current?.getEditor();
  //   if (!editor) return;

  //   const range = editor.getSelection(true);
  //   if (range) {
  //     editor.insertText(range.index, e.dataTransfer.getData("text"));
  //   }
  // };
  const handleDrop = (e) => {
    e.preventDefault();
    if (!isEditing) return;

    const editor = bodyEditorRef.current?.getEditor();
    if (!editor) return;

    const text = e.dataTransfer.getData("text");
    const range = editor.getSelection(true);

    if (range) {
      // Insert the blot by its registered name ('variable')
      // and pass the dragged text as its value
      editor.insertEmbed(range.index, "variable", text, Quill.sources.USER);

      // Move the cursor immediately after the new tag for a smooth UX
      editor.setSelection(range.index + 1, Quill.sources.USER);
    }
  };

  const handleSave = async () => {
    setIsEditing(false);
    let i = bodyContent.search(/<[\w-_=\\":;\s]+><br><\/[\w]+>/g);
    console.log(i);
    let fullContent = "";
    if (i == 0) {
      fullContent = headerContent + bodyContent;
    } else {
      fullContent = headerContent + "<p><br/><p>" + bodyContent;
    }

    let str = fullContent.match(/\{{2}[A-Z_]+\}{2}/g);
    let checked = str?.filter((w) => {
      return draftVar.some((str) => str == w);
    });

    if (str != null && str.length > checked.length) {
      setSbar({
        isOpen: true,
        Msg: "Invalid Variable Names added!! Ensure that entered variable names are correct and there should not be whitespaces between curly braces",
      });
      handleCloseDialog();
      return;
    }

    let dataToSend = { MASTER_TEMPLATE: `<html>${fullContent}</html>` };
    try {
      let jsonFormData = JSON.stringify(dataToSend);
      await encrypt(iv, salt, jsonFormData).then(function (result) {
        jsonFormData = result;
      });
      let payload = {
        iv: ivBase64,
        salt: saltBase64,
        data: jsonFormData,
      };
      const response = await axios.post(
        "Server/IAMServices/saveMasterTemplate",
        payload,
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      if (response.data.statusCode === 200 && response.data.result !== "") {
        console.log("Saved successfully!");
      }
    } catch (error) {
      console.error("Error saving template:", error);
    }
    setSbar({
      isOpen: true,
      Msg: "Saved Successfully!",
    });
    setIsPreviewing(false);
    handleCloseDialog();
  };

  const handlePreview = async () => {
    let i = bodyContent.search(/<[\w-_=\\":;\s]+><br><\/[\w]+>/g);
    console.log(i);
    let fullContent = "";
    if (i == 0) {
      fullContent = headerContent + bodyContent;
    } else {
      fullContent = headerContent + "<p><br/><p>" + bodyContent;
    }

    let data = {
      DATE: "xx/xx/xxxx",
      REF_NO: "9999xxx",
      FIRM_NAME: "xxxxxxxxxx",
      FRN_NO: "999999999",
      GSTN: "99xx99xx",
      FIRM_ADDR: "xxxxxxxx,xxxxxxxx",
      ASSIGNMENT_TYPE: "xxxxxxx",
    };

    let str = fullContent.replace(/<br\s*\/?>/gi, "<br></br>");
    let StrToSend = str.replace(/\{{2}([A-Z_]+)\}{2}/g, (match, p1) => {
      return data[p1];
    });

    settemplateContent(StrToSend);
    setIsPreviewing(true);
  };

  const handleCloseDialog = () => {
    setIsPreviewing(false);
  };

  const handleReset = async () => {
    try {
      const response = await axios.post(
        "Server/IAMServices/resetTemplate",
        {},
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      let res = response.data.result;
      const splitIndex = res.indexOf("Dear Sir/Madam");
      if (splitIndex !== -1) {
        setHeaderContent(res.substring(0, splitIndex));
        setBodyContent(res.substring(splitIndex));
      } else {
        setHeaderContent(res);
        setBodyContent("");
      }
    } catch (e) {
      console.error("Error resetting template:", e);
    }
  };

  const handleHeaderCopy = (e) => {
    e.preventDefault();
    setSbar({
      isOpen: true,
      Msg: "❌ Copying from non-editable section is not allowed!",
    });
  };

  return (
    <>
      <Typography gutterBottom variant="h5" component="div">
        Empanelment Intimation Letter Template
      </Typography>
      <Divider />
      <Grid container spacing={2} sx={{ p: 2 }}>
        <Grid item xs={14} md={4}>
          <Box
            sx={{
              height: "100%",
              width: "100%",
              borderRadius: 2,
              boxShadow: 2,
            }}
          >
            <Paper sx={{ height: "48%", mb: "30px" }}>
              <Typography variant="h6">
                Drag Required Variables and Drop into letter draft.
              </Typography>
              <hr></hr>
              {draftVar.map((label) => (
                <span
                  key={label}
                  draggable={isEditing}
                  onDragStart={handleDragStart}
                  style={{
                    margin: 10,
                    backgroundColor: "#0c476e",
                    padding: "5px 8px",
                    cursor: "move",
                    borderRadius: "3px",
                    color: "white",
                    fontWeight: "bold",
                    boxShadow: "0 4px 8px rgba(0, 0, 0, 0.2)",
                    transition: "background-color 0.3s ease",
                    display: "inline-block",
                  }}
                >
                  {label}
                </span>
              ))}
            </Paper>
            <Paper sx={{ height: "48%" }}>
              <Typography variant="h6" ml="2">
                Instructions
              </Typography>
              <hr></hr>
              <Container sx={{ ml: 3 }}>
                <li>Special characters are not allowed</li>
                <li>Only use allowed variables from the list</li>
                <li>Header section is non-editable and non-copyable</li>
                <li>Body section is editable when in edit mode</li>
                <li>Maximum word limit: 2000 words</li>
              </Container>
            </Paper>
          </Box>
        </Grid>
        <Grid item xs={12} md={8}>
          <Box
            sx={{
              width: "100%",
              bgcolor: "background.default",
              borderRadius: 2,
              boxShadow: 2,
            }}
          >
            <Typography variant="h6"> Draft</Typography>
            <hr></hr>
            <Paper sx={{ padding: 2 }}>
              {/* Non-editable Header Section */}
              <Typography
                variant="subtitle2"
                sx={{ mb: 1, color: "#666", size: "" }}
              >
                Non-editable Header
              </Typography>
              <Box
                sx={{
                  bgcolor: "#f5f5f5",
                  p: 1,
                  mb: 1,
                  border: "1px solid #e0e0e0",
                  borderRadius: "4px",
                }}
                onCopy={handleHeaderCopy}
              >
                <ReactQuill
                  style={{ height: "26vh" }}
                  theme="bubble"
                  value={headerContent}
                  ref={headerEditorRef}
                  readOnly={true}
                  modules={{ toolbar: false }}
                  formats={[
                    "size",
                    "align",
                    "color",
                    "font",
                    "bold",
                    "italic",
                    "underline",
                    "strike",
                    "list",
                    "bullet",
                    "link",
                    "image",
                    "background",
                    "header",
                    "script",
                    "indent",
                  ]}
                />
              </Box>

              {/* Editable Body Section */}
              <Typography variant="subtitle2" sx={{ mb: 1 }}>
                Editable Body
              </Typography>
              {/* <Box
                sx={{
                  bgcolor: "#fff",
                  p: 1,
                  height:"40%",
                  border: "1px solid #e0e0e0",
                  borderRadius: "4px",
                }}
              > */}

              <div onDragover={(e) => e.preventDefault()} onDrop={handleDrop}>
                <ReactQuill
                  theme="snow"
                  style={{ height: "25vh" }}
                  modules={modules}
                  value={bodyContent}
                  ref={bodyEditorRef}
                  onChange={handleBodyChange}
                  readOnly={!isEditing}
                  formats={[
                    "size",
                    "align",
                    "color",
                    "font",
                    "bold",
                    "italic",
                    "underline",
                    "strike",
                    "list",
                    "bullet",
                    "link",
                    "image",
                    "background",
                    "header",
                    "script",
                    "indent",
                  ]}
                />
              </div>
              {/* </Box> */}

              <Typography
                variant="body2"
                color="textSecondary"
                sx={{ mt: 10, textAlign: "left" }}
              >
                Word Count: {wordCount} / 2000
              </Typography>

              <Box sx={{ textAlign: "right" }}>
                {!isEditing ? (
                  <Button
                    variant="contained"
                    color="primary"
                    onClick={() => setIsEditing(true)}
                    sx={{ mr: 1 }}
                  >
                    Edit
                  </Button>
                ) : (
                  <Button
                    variant="contained"
                    color="error"
                    onClick={() => setIsEditing(false)}
                    sx={{ mr: 1 }}
                  >
                    Cancel
                  </Button>
                )}
                <Button
                  variant="contained"
                  color="info"
                  onClick={handlePreview}
                  sx={{ mr: 1 }}
                >
                  Preview
                </Button>
                <Button variant="contained" color="info" onClick={handleReset}>
                  Reset Template
                </Button>
              </Box>
            </Paper>
          </Box>
        </Grid>
      </Grid>
      {/* Modal for Preview */}
      <Dialogue
        open={isPreviewing}
        close={handleCloseDialog}
        save={handleSave}
        content={templateContent}
      />

      <Snackbar
        open={sbar.isOpen}
        autoHideDuration={6000}
        onClose={() => setSbar({ isOpen: false, Msg: "" })}
        message={sbar.Msg}
      />
    </>
  );
};

const BootstrapDialog = styled(Dialog)(({ theme }) => ({
  "& .MuiDialogContent-root": {
    padding: theme.spacing(2),
  },
  "& .MuiDialogActions-root": {
    padding: theme.spacing(1),
  },
}));

const Dialogue = ({ open, close, save, content }) => {
  return (
    <>
      <BootstrapDialog
        onClose={close}
        aria-labelledby="customized-dialog-title"
        open={open}
        fullWidth
        maxWidth="md"
      >
        <DialogTitle sx={{ m: 0, p: 2 }} id="customized-dialog-title">
          Intimation letter draft preview
        </DialogTitle>
        <IconButton
          aria-label="close"
          onClick={close}
          sx={(theme) => ({
            position: "absolute",
            right: 8,
            top: 8,
            color: theme.palette.grey[500],
          })}
        >
          <CloseIcon />
        </IconButton>
        <DialogContent dividers>
          <div
            style={{
              width: "210mm",
              height: "297mm",
              margin: "0 auto",
              padding: "20mm",
              boxShadow: "0 0 10px rgba(0, 0, 0, 0.1)",
              boxSizing: "border-box",
              backgroundColor: "#ffffff",
              border: "1px solid #ddd",
              overflow: "auto",
              overflowWrap: "break-word",
            }}
            dangerouslySetInnerHTML={{ __html: content }}
          ></div>
        </DialogContent>
        <DialogActions>
          <Button autoFocus onClick={save}>
            Save Draft
          </Button>
        </DialogActions>
      </BootstrapDialog>
    </>
  );
};

export default EmailTemplate;
