useEffect(() => {
  const quill = editorRef.current.getEditor();

  quill.on("text-change", (delta, oldDelta, source) => {
    if (source !== "user") return;

    const insertedOp = delta.ops?.find((op) => typeof op.insert === "string");

    if (insertedOp) {
      const inserted = insertedOp.insert;

      // ✅ Block characters that are NOT allowed
      const illegalChar = inserted.match(/[^a-zA-Z0-9\s.,;!?'"()\-@]/);

      if (illegalChar) {
        // ❗ Delay deletion slightly to override Quill's insert
        setTimeout(() => {
          const position = quill.getSelection()?.index || quill.getLength();
          quill.deleteText(position - 1, 1, "silent"); // Remove just-typed character
        }, 0);

        setSbar({
          isOpen: true,
          Msg: "❌ Special characters are not allowed!",
        });
      }
    }
  });

  return () => {
    quill.off("text-change");
  };
}, []);




const [sbar, setSbar] = useState({ isOpen: false, Msg: "" });
