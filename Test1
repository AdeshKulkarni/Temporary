useEffect(() => {
  const quill = editorRef.current.getEditor();

  quill.on("text-change", (delta, oldDelta, source) => {
    if (source !== "user") return;

    const currentLength = quill.getLength(); // Includes trailing newline
    const insertedOp = delta.ops?.find((op) => typeof op.insert === "string");

    if (insertedOp) {
      const inserted = insertedOp.insert;

      // Check each character in the inserted string
      for (let i = 0; i < inserted.length; i++) {
        const char = inserted[i];

        // Customize regex to block your definition of special characters
        if (/[^a-zA-Z0-9\s.,;!?'"()\-@]/.test(char)) {
          // Remove the special character
          quill.deleteText(currentLength - 2, 1, "silent"); // -2 = just inserted char before trailing newline
          setSbar({
            isOpen: true,
            Msg: "❌ Special characters are not allowed!",
          });
          return;
        }
      }
    }
  });

  return () => {
    quill.off("text-change");
  };
}, []);
