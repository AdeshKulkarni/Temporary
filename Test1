const validateWordLength = (text, maxLength = 30) => {
  // Split text into words and check each word length
  const words = text.split(/\s+/);
  const longWords = words.filter(word => word.length > maxLength);
  
  if (longWords.length > 0) {
    return {
      isValid: false,
      message: `❌ Words cannot exceed ${maxLength} characters. Found: ${longWords.join(', ')}`,
      longWords: longWords
    };
  }
  
  return { isValid: true };
};


const handleBodyChange = (content, delta, source, editor) => {
  if (source === "api") return;

  // Validation for consecutive newlines
  const isPressingEnter = delta.ops?.some((op) => op.insert === "\n");
  if (isPressingEnter) {
    const quillEditor = bodyEditorRef.current?.getEditor();
    const selection = quillEditor.getSelection();
    if (selection) {
      const precedingText = quillEditor.getText(selection.index - 5, 4);
      if (precedingText === "\n\n\n\n") {
        setTimeout(() => {
          quillEditor.deleteText(selection.index - 1, 1, "silent");
          setSbar({
            isOpen: true,
            Msg: "❌ Cannot add more than 4 consecutive newlines.",
          });
        }, 0);
        return;
      }
    }
  }

  let htmlContent = editor.getHTML();
  let length = countWord(htmlContent);

  // Validation for special characters
  const insertedOp = delta.ops?.find((op) => typeof op.insert === "string");
  if (insertedOp) {
    const inserted = insertedOp.insert;
    const len = inserted.length;
    const illegalChar = inserted.match(/[^a-zA-Z0-9_\s.,;!?'"()\{\}\-@\n]/);

    if (illegalChar) {
      setTimeout(() => {
        const quillEditor = bodyEditorRef.current?.getEditor();
        if (quillEditor) {
          const selection = quillEditor.getSelection();
          let position = selection?.index || quillEditor.getLength();
          quillEditor.deleteText(position - len, len, "silent");
        }
      }, 10);
      setSbar({
        isOpen: true,
        Msg: "❌ Special characters are not allowed!",
      });
      return;
    }

    // Word length validation - NEW
    const plainText = editor.getText();
    const wordValidation = validateWordLength(plainText, 30);
    if (!wordValidation.isValid) {
      setTimeout(() => {
        const quillEditor = bodyEditorRef.current?.getEditor();
        if (quillEditor) {
          const selection = quillEditor.getSelection();
          let position = selection?.index || quillEditor.getLength();
          quillEditor.deleteText(position - len, len, "silent");
        }
      }, 10);
      setSbar({
        isOpen: true,
        Msg: wordValidation.message,
      });
      return;
    }
  }

  // Word limit validation
  if (length > 2000) {
    const quillEditor = bodyEditorRef.current?.getEditor();
    if (quillEditor) {
      const selection = quillEditor.getSelection();
      let position = selection?.index || quillEditor.getLength();
      const lastOp = delta.ops[delta.ops.length - 1];
      const lastInsertLength =
        typeof lastOp.insert === "string" ? lastOp.insert.length : 1;
      quillEditor.deleteText(
        position - lastInsertLength,
        lastInsertLength,
        "silent"
      );
      setSbar({
        isOpen: true,
        Msg: "Word limit exceeded. Please reduce content.",
      });
      return;
    }
  }

  setBodyContent(htmlContent);
  setWordCount(countWord(editor.getHTML()));
};
