### 2 & 5. Remove Confirmation Pop-up Modal & Process Batch ID in Success Alerts
We will completely strip out the extra intermediate modal window step and bypass it by directly processing data updates through handleValidateClick. This function will now pass confirmation updates natively while incorporating the tracking batch ID into the notification alert string.
**First, replace the entire handleValidateClick and handleConfirmSubmit functions in VoucherPosting.js with this unified single method logic:**
```javascript
  const handleValidateClick = async () => {
    if (!isCommonRemarksValid(commonBatchRemarks)) {
      showSnackBar("Common Batch Remarks must be 2-30 characters if provided.", "error");
      return;
    }

    const branchCurrencyTotals = new Map();
    const branchEntryCheck = new Map();

    for (const [index, row] of rows.entries()) {
      if (
        !row.branch || !row.currency || !row.cgl || !row.amount ||
        parseFloat(row.amount) === 0 || !row.txnType || !isRowRemarksValid(row.remarks)
      ) {
        showSnackBar(
          `Row ${index + 1} is incomplete or has a zero amount. Amount must be greater than 0, and remarks must be 2-30 characters.`,
          "error"
        );
        return;
      }

      const branchCode = row.branch.code;
      const currency = row.currency;

      const cglNumber = String(row.cgl.cglNumber);
      const isMemo = cglNumber.startsWith("5");
      const type = isMemo ? "MEMO" : "NORMAL";

      const [integerPart = "0", fractionalPart = "0"] = (row.amount || "0").split(".");
      const fractionalPadded = fractionalPart.substring(0, 4).padEnd(4, "0");
      const amountAsBigInt = BigInt(integerPart + fractionalPadded);

      const compositeKey = `${branchCode}-${currency}-${type}`;

      if (!branchCurrencyTotals.has(compositeKey)) {
        branchCurrencyTotals.set(compositeKey, { totalDebit: 0n, totalCredit: 0n });
      }
      const currencyTotals = branchCurrencyTotals.get(compositeKey);

      if (row.txnType === "Debit") {
        currencyTotals.totalDebit += amountAsBigInt;
      } else if (row.txnType === "Credit") {
        currencyTotals.totalCredit += amountAsBigInt;
      }

      if (!branchEntryCheck.has(branchCode)) {
        branchEntryCheck.set(branchCode, { hasDebit: false, hasCredit: false });
      }
      const branchCheck = branchEntryCheck.get(branchCode);

      if (row.txnType === "Debit" && amountAsBigInt > 0n) branchCheck.hasDebit = true;
      else if (row.txnType === "Credit" && amountAsBigInt > 0n) branchCheck.hasCredit = true;
    }

    for (const [branchCode, totals] of branchEntryCheck.entries()) {
      const { hasDebit, hasCredit } = totals;
      if (!hasDebit || !hasCredit) {
        showSnackBar("Branch must have at least one Debit and one Credit entry.", "error");
        return;
      }
    }

    for (const [compositeKey, totals] of branchCurrencyTotals.entries()) {
      const { totalDebit, totalCredit } = totals;
      if (totalDebit !== totalCredit) {
        showSnackBar("Branch and Currency Debit/Credit Mismatch for Real/Memo CGL.", "error");
        return;
      }
    }

    // --- DIRECT SUBMIT DOWNSTREAM PROCESSING (MODAL BYPASSED) ---
    setIsSubmitting(true);

    const [day, month, year] = postingDate.split("-");
    const formattedBackendDate = `${day}/${month}/${year}`;
    const rowPayloads = [];

    for (const row of rows) {
      const finalAmount = row.txnType === "Credit" ? "-" + row.amount : row.amount;
      rowPayloads.push({
        branch: row.branch.code,
        currency: row.currency,
        cgl: row.cgl.cglNumber,
        amount: finalAmount,
        txnType: row.txnType,          
        productType: row.productCode,
        remarks: row.remarks,
        postingDate: formattedBackendDate
      });
    }

    const finalPayload = {
      vid: selectedVoucher?.vid,
      scheduledTime: null,
      commonBatchRemarks: commonBatchRemarks ? commonBatchRemarks.trim() : "Voucher created successfully",
      rows: rowPayloads,
    };

    try {
      const response = await callApi("/JS/voucher/create-batch", finalPayload, "POST");
      const newBatchId = response?.[0]?.batchId || response?.batchId || "N/A";
      setSubmittedBatchId(newBatchId);

      // ISSUE 2 ALERT FIX: Explicitly appending generated Batch ID into the transaction notice
      showSnackBar(`Batch ${newBatchId} validated and created successfully.`, "success");

      setRows([createNewRow()]);
      setCommonBatchRemarks("");
      setChecked(false);
      setBranchInputValues({});
      setCglInputValues({});
      setActiveStep(3); // Route forward automatically to Step 3
    } catch (error) {
      const serverMsg = error?.response?.data?.message || error?.response?.data?.error || error?.message;
      showSnackBar(serverMsg || "Unable to submit the voucher request. Please try again.", "error");
    } finally {
      setIsSubmitting(false);
    }
  };

