import { useState, useEffect, useRef } from "react";
import {
  Snackbar,
  IconButton,
  Divider,
  Dialog,
  DialogContent,
  Typography,
  Grid,
  Paper,
  Button,
  Box,
  Container
} from "@mui/material";
import DialogActions from "@mui/material/DialogActions";
import CloseIcon from "@mui/icons-material/Close";
import ReactQuill from "react-quill";
import Quill from "quill";
import "react-quill/dist/quill.snow.css";
import { styled } from "@mui/system";
import axios from "axios";
import { encrypt } from "../../Security/AES-GCM256";
import PdfViewer from "../../PdfViewer/pdfViewer";

const Size = Quill.import("formats/size");
Size.whitelist = ["small", "large", "huge"];
Quill.register(Size, true);

const iv = crypto.getRandomValues(new Uint8Array(12));
const ivBase64 = btoa(String.fromCharCode.apply(null, iv));
const salt = crypto.getRandomValues(new Uint8Array(16));
const saltBase64 = btoa(String.fromCharCode.apply(null, salt));

const EmailTemplate = () => {
  const [value, setValue] = useState("<p>Hey there!</p>");
  const [sbar, setSbar] = useState({ isOpen: false, Msg: "" });
  const [wordCount, setWordCount] = useState(0);
  const editorRef = useRef(null);
  const [isEditing, setIsEditing] = useState(false);

  useEffect(() => {
    const quill = editorRef.current.getEditor();
    quill.on("text-change", (delta, oldDelta, source) => {
      if (source !== "user") return;

      const text = quill.getText().trim();
      const words = text.split(/\s+/).filter(Boolean);
      const count = words.length;

      setWordCount(count);

      if (count > 2000) {
        // Reverse the change
        quill.updateContents(delta.invert(quill.getContents()), "silent");
        setSbar({ isOpen: true, Msg: "Word limit exceeded (2000 words)!" });
      }
    });

    return () => {
      quill.off("text-change");
    };
  }, []);

  const modules = {
    toolbar: [
      [{ font: ["", "serif", "monospace", "arial"] }],
      [{ size: Size.whitelist }],
      [
        { color: ["red", "green", "blue", "black", "orange"] },
        { background: ["red", "green", "blue", "yellow", "gray"] },
      ],
      [{ align: [] }],
      [{ script: "sub" }, { script: "super" }],
      [{ header: [1, 2, 3, false] }],
      [{ list: "ordered" }, { list: "bullet" }],
      ["bold", "italic", "underline", "strike"],
      ["link", "image", "clean"],
      [{ indent: "-1" }, { indent: "+1" }],
    ],
    clipboard: {
      matchVisual: false,
    },
  };

  return (
    <>
      <Typography variant="h5" gutterBottom>
        Empanelment Intimation Letter Template
      </Typography>
      <Divider />
      <Box sx={{ p: 2 }}>
        <Paper sx={{ p: 2 }}>
          <ReactQuill
            ref={editorRef}
            theme="snow"
            value={value}
            modules={modules}
            onChange={setValue}
            readOnly={!isEditing}
            style={{ height: "400px" }}
          />
          <Typography variant="body2" sx={{ mt: 2 }}>
            Word Count: {wordCount} / 2000
          </Typography>
          <Box sx={{ mt: 2, textAlign: "right" }}>
            {!isEditing ? (
              <Button
                variant="contained"
                color="primary"
                onClick={() => setIsEditing(true)}
                sx={{ mr: 1 }}
              >
                Edit
              </Button>
            ) : (
              <Button
                variant="contained"
                color="error"
                onClick={() => setIsEditing(false)}
                sx={{ mr: 1 }}
              >
                Cancel
              </Button>
            )}
          </Box>
        </Paper>
      </Box>
      <Snackbar
        open={sbar.isOpen}
        autoHideDuration={4000}
        onClose={() => setSbar({ isOpen: false, Msg: "" })}
        message={sbar.Msg}
      />
    </>
  );
};

export default EmailTemplate;
