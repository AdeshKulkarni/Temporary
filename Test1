        if (currentCreateEditSts === '10') {
          mainFormDataResponse = await callApi(INDEX_API_URL, mainDataPayload, 'POST');
        } else {
          mainFormDataResponse = await callApi(EDIT_API_URL, mainDataPayload, 'POST');
        }
        // ... processing logic ...

        // STEP 4: Call the third API. The function PAUSES for the last time.
        const payload = { /* ... */ };
        const responseData = await callApi(ADDITIONAL_DATA_URL, payload, 'POST');
