            @PathVariable @Pattern(regexp = "^[a-zA-Z0-9-]{1,30}$", message = "Invalid VID format") String vid) { 
        return ResponseEntity.ok(queryService.getVidDetails(vid)); 
    }

    @GetMapping("/active")
    public ResponseEntity<Map<String, Object>> getAvailableVouchers(@RequestParam Long roleId) {
        Map<String, Object> response = new HashMap<>(); response.put("data", queryService.getAvailableVouchersVid(roleId)); response.put("message", "Success"); response.put("status", "OK");
        return ResponseEntity.ok(response);
    }
}

package com.fincore.VoucherService.Controllers;

import com.fincore.VoucherService.Dto.CglDto;
import com.fincore.VoucherService.Service.CglService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.ResponseEntity;
import org.springframework.validation.annotation.Validated;
import jakarta.validation.constraints.Pattern;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import java.util.Collections;
import java.util.List;

@RestController
@RequestMapping("/api/cgl-journal")
@RequiredArgsConstructor
@Slf4j
@Validated // FORTIFY FIX: Enable method-level validation
public class CglController {

    private final CglService cglService;

    @GetMapping("/search")
    public ResponseEntity<List<CglDto>> searchCgl(
            // FORTIFY FIX: Restrict search strings to alphanumeric inputs to defeat DB access injection
            @RequestParam(value = "query", required = false, defaultValue = "") 
            @Pattern(regexp = "^[a-zA-Z0-9]{0,20}$", message = "Invalid search query") String query) {

        if (query == null || query.trim().isEmpty()) {
            return ResponseEntity.ok(Collections.emptyList());
        }

        log.info("CGL_CONTROLLER_PREFIX_SEARCH | Action: Filtering CGLs starting with: {}", query);

        List<CglDto> results = cglService.searchCgls(query.trim());
        return ResponseEntity.ok(results);
    }
}




