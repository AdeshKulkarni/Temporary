import React, { useState, useMemo } from 'react';
import {
  Button,
  Box,
  Paper,
  Typography,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Checkbox,
} from '@mui/material';
import { DataGrid, GridToolbar } from '@mui/x-data-grid';
import PreviewIcon from '@mui/icons-material/Preview';
import CheckCircleIcon from '@mui/icons-material/CheckCircle';
import CancelIcon from '@mui/icons-material/Cancel';

const WorkFlow = () => {
  const [selectedRows, setSelectedRows] = useState([]);
  const [previewData, setPreviewData] = useState(null);
  
  // Generate mock data for the specified columns
  const rows = useMemo(() => {
    const firmNames = [
      'Alpha Enterprises', 'Beta Solutions', 'Gamma Industries', 
      'Delta Technologies', 'Omega Services', 'Sigma Innovations'
    ];
    
    const cities = ['Mumbai', 'Delhi', 'Bangalore', 'Chennai', 'Kolkata', 'Hyderabad'];
    const states = ['Maharashtra', 'Karnataka', 'Tamil Nadu', 'West Bengal', 'Telangana', 'Gujarat'];
    const districts = ['Mumbai City', 'Bangalore Urban', 'Chennai District', 'Kolkata District', 'Hyderabad District'];
    const designations = ['Owner', 'Manager', 'Director', 'Proprietor', 'Partner'];
    const establishmentTypes = ['Proprietorship', 'Partnership', 'LLP', 'Private Limited', 'Public Limited'];
    
    const count = 5 + Math.floor(Math.random() * 5); // 5-10 entries
    return Array.from({ length: count }, (_, index) => {
      const firmName = firmNames[Math.floor(Math.random() * firmNames.length)];
      const poc = ['Raj Sharma', 'Priya Patel', 'Vikram Singh', 'Ananya Gupta', 'Arjun Kumar'][Math.floor(Math.random() * 5)];
      const city = cities[Math.floor(Math.random() * cities.length)];
      const state = states[Math.floor(Math.random() * states.length)];
      
      return {
        id: index + 1,
        serial: index + 1,
        ucn: `UCN${Math.floor(1000000000 + Math.random() * 9000000000)}`,
        firmRegNo: `FRN${Math.floor(100000 + Math.random() * 900000)}`,
        firmName,
        panNo: `ABCDE${Math.floor(1000 + Math.random() * 9000)}F`,
        gstinNo: `${state.substring(0,2)}${Math.floor(1000000000 + Math.random() * 9000000000)}Z`,
        address: `${Math.floor(100) + index} ${firmName.split(' ')[0]} Street`,
        city,
        stateName: state,
        districtName: districts[Math.floor(Math.random() * districts.length)],
        mobileNo: `9${Math.floor(100000000 + Math.random() * 900000000)}`,
        pointOfContact: poc,
        pocDesignation: designations[Math.floor(Math.random() * designations.length)],
        pocEmail: `${poc.split(' ')[0].toLowerCase()}@${firmName.split(' ')[0].toLowerCase()}.com`,
        establishmentType: establishmentTypes[Math.floor(Math.random() * establishmentTypes.length)],
        status: 'Pending' // Added status field
      };
    });
  }, []);

  const columns = [
    {
      field: 'selected',
      headerName: 'Select',
      width: 80,
      renderHeader: () => (
        <Checkbox
          checked={selectedRows.length === rows.length}
          indeterminate={selectedRows.length > 0 && selectedRows.length < rows.length}
          onChange={handleSelectAll}
        />
      ),
      renderCell: (params) => (
        <Checkbox
          checked={selectedRows.includes(params.row.id)}
          onChange={() => handleSelectRow(params.row.id)}
        />
      )
    },
    { field: 'serial', headerName: 'Sr. No', width: 80 },
    { field: 'ucn', headerName: 'UCN', width: 180 },
    { field: 'firmRegNo', headerName: 'Firm Reg No.', width: 150 },
    { field: 'firmName', headerName: 'Firm Name', width: 200 },
    { field: 'panNo', headerName: 'PAN NO.', width: 140 },
    { field: 'gstinNo', headerName: 'GSTIN NO.', width: 180 },
    { field: 'address', headerName: 'Address', width: 200 },
    { field: 'city', headerName: 'City', width: 120 },
    { field: 'stateName', headerName: 'State', width: 150 },
    { field: 'districtName', headerName: 'District', width: 150 },
    { field: 'mobileNo', headerName: 'Mobile No.', width: 150 },
    { field: 'pointOfContact', headerName: 'Point of Contact', width: 180 },
    { field: 'pocDesignation', headerName: 'POC Designation', width: 180 },
    { field: 'pocEmail', headerName: 'POC Email', width: 200 },
    { field: 'establishmentType', headerName: 'Establishment Type', width: 180 },
    {
      field: 'actions',
      headerName: 'Actions',
      width: 250,
      sortable: false,
      filterable: false,
      renderCell: (params) => (
        <div style={{ display: 'flex', gap: '8px' }}>
          <Button
            variant="outlined"
            color="info"
            size="small"
            startIcon={<PreviewIcon />}
            onClick={() => handleRowPreview(params.row)}
            sx={{ 
              textTransform: 'none',
              '&:hover': {
                backgroundColor: 'info.light',
              }
            }}
          >
            Preview
          </Button>
          <Button
            variant="contained"
            color="success"
            size="small"
            startIcon={<CheckCircleIcon />}
            onClick={() => handleApprove(params.row)}
            sx={{ 
              textTransform: 'none',
              '&:hover': {
                backgroundColor: 'success.dark',
              }
            }}
          >
            Approve
          </Button>
          <Button
            variant="contained"
            color="error"
            size="small"
            startIcon={<CancelIcon />}
            onClick={() => handleReject(params.row)}
            sx={{ 
              textTransform: 'none',
              '&:hover': {
                backgroundColor: 'error.dark',
              }
            }}
          >
            Reject
          </Button>
        </div>
      )
    }
  ];

  const handleSelectRow = (id) => {
    setSelectedRows(prev => 
      prev.includes(id) 
        ? prev.filter(rowId => rowId !== id) 
        : [...prev, id]
    );
  };

  const handleSelectAll = () => {
    if (selectedRows.length === rows.length) {
      setSelectedRows([]);
    } else {
      setSelectedRows(rows.map(row => row.id));
    }
  };

  const handleRowPreview = (rowData) => {
    setPreviewData(rowData);
  };

  const handleClosePreview = () => {
    setPreviewData(null);
  };

  const handleApprove = (row) => {
    console.log('Approved:', row);
    alert(`Firm ${row.firmName} has been approved!`);
    // Add your approval logic here
  };

  const handleReject = (row) => {
    console.log('Rejected:', row);
    alert(`Firm ${row.firmName} has been rejected!`);
    // Add your rejection logic here
  };

  return (
    <Box sx={{ p: 3, overflow: 'hidden' }}>
      <Paper elevation={3} sx={{ p: 3, borderRadius: 2 }}>
        {/* Made title bolder with fontWeight: 600 */}
        <Typography variant="h6" gutterBottom sx={{ mb: 2, fontWeight: 600 }}>
          Firm Registration Approval Workflow
        </Typography>
        
        <Box sx={{ height: 500, width: '100%', overflow: 'auto' }}>
          <DataGrid
            rows={rows}
            columns={columns}
            getRowId={(row) => row.id}
            disableColumnMenu
            hideFooterSelectedRowCount
            components={{
              Toolbar: GridToolbar,
            }}
            componentsProps={{
              toolbar: {
                showQuickFilter: true,
                quickFilterProps: { debounceMs: 500 },
              },
            }}
            sx={{
              '& .MuiDataGrid-cell': {
                fontSize: '0.75rem',
              },
              '& .MuiDataGrid-columnHeader': {
                fontSize: '0.75rem',
              },
            }}
          />
        </Box>
      </Paper>
      
      {/* Preview Dialog */}
      <Dialog 
        open={!!previewData} 
        onClose={handleClosePreview}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle sx={{ fontWeight: 600 }}>Firm Details Preview</DialogTitle>
        
        <DialogContent dividers>
          {previewData && (
            <Box sx={{ p: 2, display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 2 }}>
              {Object.entries(previewData).map(([key, value]) => {
                if (key === 'id' || key === 'selected' || key === 'actions') return null;
                return (
                  <div key={key} style={{ minHeight: 24 }}>
                    <Typography variant="subtitle1" sx={{ fontWeight: 500 }}>
                      {key.replace(/([A-Z])/g, ' $1').replace(/^./, s => s.toUpperCase())}:
                    </Typography>
                    <Typography variant="body1" sx={{ mt: 0.5 }}>{value}</Typography>
                  </div>
                );
              })}
            </Box>
          )}
        </DialogContent>
        
        <DialogActions>
          <Button 
            onClick={handleClosePreview} 
            color="primary"
            variant="outlined"
            sx={{ mr: 1 }}
          >
            Close
          </Button>
          <Button 
            onClick={() => handleApprove(previewData)} 
            color="success"
            variant="contained"
            startIcon={<CheckCircleIcon />}
            sx={{ mr: 1 }}
          >
            Approve
          </Button>
          <Button 
            onClick={() => handleReject(previewData)} 
            color="error"
            variant="contained"
            startIcon={<CancelIcon />}
          >
            Reject
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
};

export default WorkFlow;
