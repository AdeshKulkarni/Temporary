### 3. Create a Single Finalize Handler
We no longer need separate functions for immediate vs. scheduled execution. We will combine them into one smart handler.
**Delete handleApplySchedule and handleExecuteImmediately (around lines 205-256) and replace them with this single function:**
```javascript
  const handleFinalizeRouting = async () => {
    setIsFinalizing(true);
    let formattedSchedule = null;

    try {
      if (routingChoice === "SCHEDULE") {
        if (!scheduledTime || !scheduledTime.isValid()) {
          showSnackBar("Please select a valid time.", "warning");
          setIsFinalizing(false);
          return;
        }

        const today = dayjs();
        const finalSchedule = scheduledTime
          .year(today.year())
          .month(today.month())
          .date(today.date());

        const minAllowed = dayjs().add(30, 'minute');
        const maxAllowed = dayjs().endOf('day');

        if (finalSchedule.isBefore(minAllowed)) {
          showSnackBar("Schedule time must be at least 31 minutes from now.", "warning");
          setIsFinalizing(false);
          return;
        }
        if (finalSchedule.isAfter(maxAllowed)) {
          showSnackBar("Schedule time cannot exceed today's end of day (11:59 PM).", "warning");
          setIsFinalizing(false);
          return;
        }
        formattedSchedule = finalSchedule.format('YYYY-MM-DD HH:mm:ss');
      }

      await callApi("/JS/voucher/update-schedule", {
        batchId: submittedBatchId,
        scheduledTime: formattedSchedule // Will be null if IMMEDIATE
      }, "POST");

      showSnackBar("Execution routing finalized successfully!", "success");
      handleResetWizard();
    } catch (e) {
      showSnackBar(e.message || "Failed to finalize batch execution.", "error");
    } finally {
      setIsFinalizing(false);
    }
  };

```
