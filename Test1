const handleEditorDrop = (e) => {
  e.preventDefault();
  const text = e.dataTransfer.getData("text");
  if (!text) return;

  const quill = bodyEditorRef.current?.getEditor();
  if (!quill) return;
  const range = quill.getSelection(true);
  if (!range) return;

  // Get the full text content up to the drop index
  const fullText = quill.getText(0, quill.getLength());
  // Find the start of the current line
  const before = fullText.slice(0, range.index);
  const lineStart = before.lastIndexOf('\n') + 1;
  const lineEnd = fullText.indexOf('\n', range.index);
  const lineText = fullText.slice(lineStart, lineEnd === -1 ? undefined : lineEnd);

  // Get all Delta ops for the current line
  const ops = quill.getContents(lineStart, (lineEnd === -1 ? quill.getLength() : lineEnd) - lineStart).ops;
  // Check if any op is a variable blot
  const hasVariable = ops.some(op => typeof op.insert === 'object' && op.insert.variable);

  if (hasVariable) {
    setSbar({
      isOpen: true,
      Msg: `❌ Only one variable allowed per line.`,
    });
    return;
  }

  // Insert variable blot
  quill.insertEmbed(range.index, "variable", text, Quill.sources.USER);
  quill.setSelection(range.index + 1, Quill.sources.USER);
};