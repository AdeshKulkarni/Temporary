      // CRITICAL FIX: Defensively extract the array whether it's wrapped in a DTO or not
      let fetchedRows = [];
      if (Array.isArray(response)) {
        fetchedRows = response;
      } else if (response && Array.isArray(response.data)) {
        fetchedRows = response.data;
      } else if (response && Array.isArray(response.content)) {
        fetchedRows = response.content;
      }

      // 2. Extract unique workflow codes
      const uniqueWorkflows = [
        ...new Set(
          fetchedRows.map((row) => row.approvalWorkflow).filter(Boolean)
        ),
      ];

      // 3. Dynamically fetch the step configurations for each workflow
      const stepsMap = {};
      await Promise.all(
        uniqueWorkflows.map(async (wfCode) => {
          try {
            const stepsResponse = await callApi(
              `/JS/voucher/workflow/steps/${wfCode}`,
              null,
              "GET"
            );
            // Defensively unwrap steps
            const steps = Array.isArray(stepsResponse) ? stepsResponse : (stepsResponse?.data || []);

            // CRITICAL FIX: Store the raw object so both steppers can read it safely
            stepsMap[wfCode] = steps;
          } catch (e) {
            stepsMap[wfCode] = [
              { state: "P", designation: "Creator" },
              { state: "APPROVED", designation: "Approver" }
            ]; // Fallback
          }
        })
      );

      // 4. Update states
      if (isMounted.current) {
        setWorkflowStepsMap(stepsMap);
        setRows(fetchedRows);
      }
    } catch (err) {
      if (isMounted.current && err.name !== "CanceledError")
        showSnackBar("Failed to load requests", "error");
    } finally {
      if (isMounted.current) setLoading(false);
    }
  }, [callApi, showSnackBar]);

  useEffect(() => {
    const fetchRoles = async () => {
      try {
        // Fetch the { "9001": "TCSGLIF" } map from our new API
        const rolesData = await callApi(
          "/JS/voucher/active-roles",
          null,
          "GET"
        );
        if (rolesData && isMounted.current) {
          setDbRoleMap(rolesData);
        }
      } catch (err) {
        console.error("Failed to fetch roles mapping", err);
      }
    };
    fetchRoles();
  }, [callApi]);

  useEffect(() => {
