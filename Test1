package com.fincore.VoucherService.Service;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Service;

import jakarta.annotation.PostConstruct;
import java.util.HashSet;
import java.util.List;
import java.util.Set;
import java.util.concurrent.CompletableFuture;

@Service
@RequiredArgsConstructor
@Slf4j
public class ValidationMasterService {

    @Autowired
    @Qualifier("oracleJdbcTemplate")
    private JdbcTemplate oracleJdbcTemplate;

    // Volatile ensures instant zero-delay updates for all users during the pointer swap
    private volatile Set<String> activeBranches = new HashSet<>();
    private volatile Set<String> activeCurrencies = new HashSet<>();
    private volatile Set<String> activeCgls = new HashSet<>();

    // 1. Load data instantly when the server starts up
    @PostConstruct
    public void init() {
        refreshMasterData();
    }

    // 2. The Background Worker: Runs every 60 seconds.
    // Zero downtime. Users keep validating against RAM while this runs.
    @Scheduled(fixedRate = 60000)
    public void refreshMasterData() {
        log.info("MASTER_DATA_SYNC | Starting PARALLEL fetch from Oracle...");
        long startTime = System.currentTimeMillis();

        try {
            // Fire all three queries at the exact same time on background threads
            // Increased fetchSize to 10000 for massive speed improvements
            CompletableFuture<List<String>> branchFuture = CompletableFuture.supplyAsync(() -> 
                oracleJdbcTemplate.query(
                    con -> {
                        var ps = con.prepareStatement("SELECT CODE FROM BRANCH_MASTER WHERE STATUS = 1");
                        ps.setFetchSize(10000); 
                        return ps;
                    }, 
                    (rs, rowNum) -> rs.getString(1)
                )
            );

            CompletableFuture<List<String>> currencyFuture = CompletableFuture.supplyAsync(() -> 
                oracleJdbcTemplate.query(
                    con -> {
                        var ps = con.prepareStatement("SELECT CURRENCY_CODE FROM CURRENCY_MASTER WHERE FLAG = 1");
                        ps.setFetchSize(10000);
                        return ps;
                    }, 
                    (rs, rowNum) -> rs.getString(1)
                )
            );

            CompletableFuture<List<String>> cglFuture = CompletableFuture.supplyAsync(() -> 
                oracleJdbcTemplate.query(
                    con -> {
                        var ps = con.prepareStatement("SELECT CGL_NUMBER FROM CGL_MASTER WHERE STATUS = 1");
                        ps.setFetchSize(10000);
                        return ps;
                    }, 
                    (rs, rowNum) -> rs.getString(1)
                )
            );

            // Wait for the longest query to finish, then proceed
            CompletableFuture.allOf(branchFuture, currencyFuture, cglFuture).join();

            // THE NANOSECOND POINTER SWAP
            this.activeBranches = new HashSet<>(branchFuture.get());
            this.activeCurrencies = new HashSet<>(currencyFuture.get());
            this.activeCgls = new HashSet<>(cglFuture.get());

            long duration = System.currentTimeMillis() - startTime;
            log.info("MASTER_DATA_SYNC_SUCCESS | Loaded in {} ms. CGLs: {} | Branches: {} | Currencies: {}", 
                    duration, this.activeCgls.size(), this.activeBranches.size(), this.activeCurrencies.size());

        } catch (Exception e) {
            log.error("MASTER_DATA_SYNC_FAIL | Retaining old RAM cache to prevent validation failure. Error: {}", e.getMessage());
        }
    }

    // ====================================================================
    // User Validation Methods: These read purely from RAM (Zero DB Hits)
    // ====================================================================
    public boolean isValidBranch(String branch) {
        return branch != null && this.activeBranches.contains(branch);
    }

    public boolean isValidCurrency(String currency) {
        return currency != null && this.activeCurrencies.contains(currency);
    }

    public boolean isValidCgl(String cgl) {
        return cgl != null && this.activeCgls.contains(cgl);
    }
}

