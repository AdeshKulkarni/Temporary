import React, { useState } from 'react';

// --- Material-UI Imports ---
import {
    Box,
    Typography,
    Fab,
    Dialog,
    DialogActions,
    DialogContent,
    DialogTitle,
    TextField,
    Button,
    Container
} from '@mui/material';
import AddIcon from '@mui/icons-material/Add';
import { DataGrid } from '@mui/x-data-grid';

/**
 * CurrencyMaster Component
 * Renders a data grid to display currency information and provides a dialog form
 * to add new currency entries.
 * @returns {JSX.Element} The rendered component.
 */
function CurrencyMaster() {
    // --- State Management ---

    // State to control the visibility of the "Add Currency" dialog
    const [isDialogOpen, setIsDialogOpen] = useState(false);

    // State to hold the data for the new currency being added through the form
    const [newCurrency, setNewCurrency] = useState({
        currencyCode: '',
        currencyName: '',
        currencyRate: '',
        rateDate: '',
        flagUrl: '', // A simple URL for the flag image
    });

    // State to hold validation errors for the form fields
    const [errors, setErrors] = useState({});

    // --- Mock Data ---
    // In a real application, this data would come from an API call (e.g., in a useEffect hook)
    const [rows, setRows] = useState([
        { id: 1, currencyCode: 'USD', currencyName: 'United States Dollar', flag: 'us', currencyRate: 1.00, rateDate: '2025-09-29' },
        { id: 2, currencyCode: 'EUR', currencyName: 'Euro', flag: 'eu', currencyRate: 0.92, rateDate: '2025-09-29' },
        { id: 3, currencyCode: 'INR', currencyName: 'Indian Rupee', flag: 'in', currencyRate: 83.50, rateDate: '2025-09-29' },
        { id: 4, currencyCode: 'GBP', currencyName: 'British Pound', flag: 'gb', currencyRate: 0.79, rateDate: '2025-09-28' },
        { id: 5, currencyCode: 'JPY', currencyName: 'Japanese Yen', flag: 'jp', currencyRate: 149.82, rateDate: '2025-09-29' },
    ]);

    // --- Grid Column Definitions ---
    const columns = [
        { field: 'id', headerName: 'ID', width: 90 },
        {
            field: 'currencyCode',
            headerName: 'Currency Code',
            width: 150,
        },
        {
            field: 'currencyName',
            headerName: 'Currency Name',
            width: 250,
        },
        {
            field: 'flag',
            headerName: 'Flag',
            width: 100,
            // Custom render function to display an image instead of text
            renderCell: (params) => (
                <img
                    src={`https://flagcdn.com/w40/${params.value.toLowerCase()}.png`}
                    alt={`${params.row.currencyName} flag`}
                    style={{ width: '30px', height: '20px' }}
                />
            ),
        },
        {
            field: 'currencyRate',
            headerName: 'Currency Rate',
            type: 'number',
            width: 150,
        },
        {
            field: 'rateDate',
            headerName: 'Rate Date',
            width: 150,
        },
    ];

    // --- Event Handlers ---

    /**
     * Opens the "Add New Currency" dialog.
     */
    const handleOpenDialog = () => {
        setIsDialogOpen(true);
    };

    /**
     * Closes the "Add New Currency" dialog and resets the form fields and errors.
     */
    const handleCloseDialog = () => {
        setIsDialogOpen(false);
        setNewCurrency({
            currencyCode: '',
            currencyName: '',
            currencyRate: '',
            rateDate: '',
            flagUrl: '',
        });
        setErrors({});
    };

    /**
     * Updates the state for the form input fields as the user types.
     * @param {React.ChangeEvent<HTMLInputElement>} e - The input change event.
     */
    const handleInputChange = (e) => {
        const { name, value } = e.target;
        setNewCurrency({
            ...newCurrency,
            [name]: value,
        });
    };

    /**
     * Validates the form fields and returns an object of errors.
     * @returns {object} An object containing error messages for invalid fields.
     */
    const validateForm = () => {
        let tempErrors = {};
        if (!newCurrency.currencyCode) tempErrors.currencyCode = "Currency Code is required.";
        else if (newCurrency.currencyCode.length > 3) tempErrors.currencyCode = "Code must be 3 characters or less.";
        if (!newCurrency.currencyName) tempErrors.currencyName = "Currency Name is required.";
        if (!newCurrency.currencyRate) tempErrors.currencyRate = "Rate is required.";
        else if (isNaN(newCurrency.currencyRate)) tempErrors.currencyRate = "Rate must be a number.";
        if (!newCurrency.rateDate) tempErrors.rateDate = "Rate Date is required.";
        setErrors(tempErrors);
        // Returns true if the form is valid (no errors), false otherwise
        return Object.keys(tempErrors).length === 0;
    };

    /**
     * Handles the form submission. It validates the form, and if valid,
     * logs the data and closes the dialog.
     */
    const handleSubmit = () => {
        if (validateForm()) {
            console.log("Form Submitted. Data in JSON format:");
            console.log(JSON.stringify(newCurrency, null, 2));

            // Here you would typically make an API call to save the data
            // For this example, we'll just log it and close the dialog.
            handleCloseDialog();
        }
    };

    // --- JSX Rendering ---

    return (
        <Container maxWidth="lg" sx={{ mt: 4, mb: 4 }}>
            <Typography variant="h4" component="h1" gutterBottom sx={{ fontWeight: 'bold' }}>
                Currency Master
            </Typography>
            
            {/* The main data grid */}
            <Box sx={{ height: 400, width: '100%', backgroundColor: 'white' }}>
                <DataGrid
                    rows={rows}
                    columns={columns}
                    initialState={{
                        pagination: {
                            paginationModel: {
                                pageSize: 5,
                            },
                        },
                    }}
                    pageSizeOptions={[5, 10, 20]}
                    disableRowSelectionOnClick
                />
            </Box>

            {/* Floating Action Button (FAB) to open the dialog */}
            <Fab
                color="primary"
                aria-label="add"
                onClick={handleOpenDialog}
                sx={{
                    position: 'fixed',
                    bottom: 30,
                    right: 30,
                }}
            >
                <AddIcon />
            </Fab>

            {/* Dialog Form for adding a new currency */}
            <Dialog open={isDialogOpen} onClose={handleCloseDialog}>
                <DialogTitle sx={{ fontWeight: 'bold' }}>Add New Currency</DialogTitle>
                <DialogContent>
                    {/* Form fields are ordered logically for banking/finance contexts */}
                    <TextField
                        autoFocus
                        margin="dense"
                        name="currencyCode"
                        label="Currency Code (e.g., USD)"
                        type="text"
                        fullWidth
                        variant="outlined"
                        value={newCurrency.currencyCode}
                        onChange={handleInputChange}
                        error={!!errors.currencyCode}
                        helperText={errors.currencyCode}
                        inputProps={{ maxLength: 3 }}
                    />
                    <TextField
                        margin="dense"
                        name="currencyName"
                        label="Currency Name (e.g., United States Dollar)"
                        type="text"
                        fullWidth
                        variant="outlined"
                        value={newCurrency.currencyName}
                        onChange={handleInputChange}
                        error={!!errors.currencyName}
                        helperText={errors.currencyName}
                    />
                    <TextField
                        margin="dense"
                        name="currencyRate"
                        label="Currency Rate"
                        type="number"
                        fullWidth
                        variant="outlined"
                        value={newCurrency.currencyRate}
                        onChange={handleInputChange}
                        error={!!errors.currencyRate}
                        helperText={errors.currencyRate}
                    />
                    <TextField
                        margin="dense"
                        name="rateDate"
                        label="Rate Date"
                        type="date"
                        fullWidth
                        variant="outlined"
                        value={newCurrency.rateDate}
                        onChange={handleInputChange}
                        error={!!errors.rateDate}
                        helperText={errors.rateDate}
                        InputLabelProps={{ shrink: true }} // Ensures label doesn't overlap date
                    />
                    <TextField
                        margin="dense"
                        name="flagUrl"
                        label="Flag Country Code (e.g., 'us', 'in')"
                        type="text"
                        fullWidth
                        variant="outlined"
                        value={newCurrency.flagUrl}
                        onChange={handleInputChange}
                        helperText="2-letter country code (lowercase)."
                        inputProps={{ maxLength: 2 }}
                    />
                </DialogContent>
                <DialogActions>
                    <Button onClick={handleCloseDialog}>Cancel</Button>
                    <Button onClick={handleSubmit} variant="contained">Submit</Button>
                </DialogActions>
            </Dialog>
        </Container>
    );
}

export default CurrencyMaster;

