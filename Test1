import React, { useState, useMemo, useEffect, useCallback } from "react"; // 1. Import useCallback
import {
  Box,
  Typography,
  Fab,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  TextField,
  Button,
} from "@mui/material";
import { DataGrid, GridActionsCellItem } from "@mui/x-data-grid";
import AddIcon from "@mui/icons-material/Add";
import EditIcon from "@mui/icons-material/Edit";
import useApi from "../../../hooks/useApi";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";

const initialFormState = {
  currencyCode: "",
  currencyName: "",
  currencyRate: "",
};

export default function CurrencyMaster() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const [rows, setRows] = useState([]);
  const [isLoading, setIsLoading] = useState(true);

  const [isDialogOpen, setIsDialogOpen] = useState(false);
  const [formData, setFormData] = useState(initialFormState);
  const [editingRow, setEditingRow] = useState(null);
  const [errors, setErrors] = useState({});

  const fetchData = async () => {
    setIsLoading(true);
    try {
      const response = await callApi("CM/currency-master", null, "GET");

      // DEBUGGING: Check the actual data from the API in your console
      console.log("API Response Data:", response.data);

      if (response && response.data && Array.isArray(response.data)) {
        const dataWithIds = response.data.map((row) => ({
          ...row,
          id: row.currencyCode, // Make sure currencyCode is unique
        }));

        setRows(dataWithIds);
        if (dataWithIds.length === 0) {
          showSnackBar("No currency data found.", "info");
        }
      } else {
        showSnackBar("Received invalid data format.", "error");
        setRows([]);
      }
    } catch (error) {
      console.error("Error fetching currency data:", error);
      showSnackBar(
        "Something went wrong while fetching data. Please try again later.",
        "error"
      );
      setRows([]);
    } finally {
      setIsLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const handleOpenDialog = () => {
    setEditingRow(null);
    setFormData(initialFormState);
    setErrors({});
    setIsDialogOpen(true);
  };

  const handleCloseDialog = () => {
    setIsDialogOpen(false);
    setEditingRow(null);
    setFormData(initialFormState);
    setErrors({});
  };

  // BEST PRACTICE 3: Wrap handleEditClick in useCallback
  const handleEditClick = useCallback(
    (id) => () => {
      const rowToEdit = rows.find((row) => row.id === id);
      if (rowToEdit) {
        setEditingRow(rowToEdit);
        setFormData({
          currencyCode: rowToEdit.currencyCode,
          currencyName: rowToEdit.currencyName,
          currencyRate: rowToEdit.currencyRate,
        });
        setErrors({});
        setIsDialogOpen(true);
      }
    },
    [rows] // Dependency array ensures the function is stable unless `rows` changes
  );

  // REFACTOR 2: Simplified and more robust validation logic
  const validate = () => {
    let tempErrors = {};

    // Validate Currency Name (for both add and edit)
    if (!formData.currencyName?.trim()) {
      tempErrors.currencyName = "Currency Name is required.";
    } else if (/\d/.test(formData.currencyName)) {
      tempErrors.currencyName = "Numbers are not allowed in Currency Name.";
    }

    // Validate fields only required for new entries
    if (!editingRow) {
      if (!formData.currencyCode?.trim()) {
        tempErrors.currencyCode = "Currency Code is required.";
      } else if (formData.currencyCode.length !== 3) {
        tempErrors.currencyCode = "Currency Code must be exactly 3 characters.";
      }

      if (!String(formData.currencyRate).trim()) {
        tempErrors.currencyRate = "Currency Rate is required.";
      }
    }

    setErrors(tempErrors);
    return Object.keys(tempErrors).length === 0;
  };

  const handleInputChange = (e) => {
    const { name, value } = e.target;
    let processedValue = value;

    if (name === "currencyCode") {
      processedValue = value.toUpperCase().slice(0, 3).replace(/[^A-Z]/g, "");
    }
    if (name === "currencyName") {
      processedValue = value.slice(0, 30).replace(/[^a-zA-Z\s]/g, "");
    }
    if (name === "currencyRate") {
      if (value !== "" && !/^\d{0,6}(\.\d{0,6})?$/.test(value)) {
        return;
      }
      processedValue = value;
    }

    setFormData({ ...formData, [name]: processedValue });
    if (errors[name]) {
      setErrors({ ...errors, [name]: "" });
    }
  };

  const handleSubmit = async () => {
    if (!validate()) {
      return;
    }

    const isEditing = !!editingRow;
    // FIX 1: Use a dynamic changeType
    const changeType = isEditing ? "UPDATE" : "ADD";

    const apiPayload = {
      requestType: "CURRENCY_MASTER",
      changeType: changeType, // Use the dynamic variable here
      payload: {
        currencyCode: formData.currencyCode,
        currencyName: formData.currencyName,
        currencyRate: parseFloat(formData.currencyRate) || 0,
        flag: 0,
      },
    };

    console.log("Submitting API Payload:", apiPayload);

    try {
      await callApi("CR/create-request", apiPayload, "POST");

      showSnackBar(
        `Request to ${isEditing ? "update" : "add"} currency submitted successfully!`,
        "success"
      );
      handleCloseDialog();
      fetchData(); // Refresh data after submission
    } catch (error) {
      console.error("Error submitting request:", error);
      showSnackBar(
        error.response?.data?.message ||
          `Failed to submit ${isEditing ? "update" : "add"} request.`,
        "error"
      );
    }
  };

  const columns = useMemo(
    () => [
      {
        field: "currencyCode",
        headerName: "Currency Code",
        flex: 1,
        sortable: true,
        align: "center",
        headerAlign: "center",
      },
      {
        field: "currencyName",
        headerName: "Currency Name",
        flex: 2,
        sortable: true,
        align: "center",
        headerAlign: "center",
      },
      {
        field: "currencyRate",
        headerName: "Currency Rate",
        type: "number",
        flex: 1,
        sortable: true,
        align: "center",
        headerAlign: "center",
      },
      {
        field: "updatedAt",
        headerName: "Last Updated",
        flex: 1,
        sortable: true,
        align: "center",
        headerAlign: "center",
        valueFormatter: (params) =>
          params.value ? new Date(params.value).toLocaleString() : "N/A",
      },
      {
        field: "actions",
        type: "actions",
        headerName: "Actions",
        width: 80,
        headerAlign: "center",
        align: "center",
        cellClassName: "actions",
        getActions: ({ id }) => [
          <GridActionsCellItem
            icon={<EditIcon />}
            label="Edit"
            onClick={handleEditClick(id)}
            color="primary"
          />,
        ],
      },
    ],
    [handleEditClick] // BEST PRACTICE 3: Update dependency array
  );

  return (
    <Box sx={{ p: 3 }}>
        <DataGrid
            rows={rows}
            columns={columns}
            disableRowSelectionOnClick
            pageSizeOptions={[5, 10, 25, 50]}
            initialState={{
            pagination: { paginationModel: { pageSize: 10, page: 0 } },
            sorting: { sortModel: [{ field: "updatedAt", sort: "desc" }] },
            }}
            loading={isLoading}
            autoHeight
            sx={{
                width: "100%",
                "& .MuiDataGrid-cell:focus, & .MuiDataGrid-cell:focus-within": {
                    outline: "none",
                },
                "& .MuiDataGrid-row:nth-of-type(odd)": {
                    backgroundColor: (theme) => theme.palette.action.hover,
                },
            }}
        />

        <Fab
            color="primary"
            aria-label="add"
            onClick={handleOpenDialog}
            sx={{ position: "fixed", bottom: 30, right: 30 }}
        >
            <AddIcon />
        </Fab>

        <Dialog open={isDialogOpen} onClose={handleCloseDialog} fullWidth maxWidth="sm">
            <DialogTitle sx={{ fontWeight: "bold" }}>
            {editingRow ? "Edit Currency" : "Add New Currency"}
            </DialogTitle>
            <DialogContent>
            <TextField
                autoFocus
                margin="dense"
                name="currencyCode"
                label="Currency Code"
                type="text"
                fullWidth
                variant="outlined"
                value={formData.currencyCode}
                onChange={handleInputChange}
                error={!!errors.currencyCode}
                helperText={errors.currencyCode}
                disabled={!!editingRow}
                inputProps={{ maxLength: 3 }}
            />
            <TextField
                margin="dense"
                name="currencyName"
                label="Currency Name"
                type="text"
                fullWidth
                variant="outlined"
                value={formData.currencyName}
                onChange={handleInputChange}
                error={!!errors.currencyName}
                helperText={errors.currencyName} // Make sure to show the error
                inputProps={{ maxLength: 30 }}
            />
            <TextField
                margin="dense"
                name="currencyRate"
                label="Currency Rate"
                type="text"
                fullWidth
                variant="outlined"
                value={formData.currencyRate}
                onChange={handleInputChange}
                error={!!errors.currencyRate}
                helperText={errors.currencyRate} // Make sure to show the error
                disabled={!!editingRow}
            />
            </DialogContent>
            <DialogActions sx={{ p: "16px 24px" }}>
            <Button onClick={handleCloseDialog}>Cancel</Button>
            <Button onClick={handleSubmit} variant="contained">
                Submit
            </Button>
            </DialogActions>
        </Dialog>
    </Box>
  );
}
