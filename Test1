-- This query provides the raw data the crosstab needs.
SELECT
  mp.map_sc1,
  mp.map_type,
  mp.map_comp,
  (case when $P{TYPE} = 'PRE' then NVL(mst.PRE,0)
        when $P{TYPE} = 'POST' then (NVL(mst.PRE,0) + nvl(MOC_AMT,0))
   end) AS PRE
FROM
  BS_MAP mp
LEFT OUTER JOIN
  bs_master_vw mst ON ((
    CASE
      WHEN mp.map_type IN('LIABILITY','ASSET') THEN 'YSA' || mp.MAP_COMP
      WHEN mp.map_type IN('INCOME','EXPENSE') THEN 'PNL' || mp.MAP_COMP
    END
  ) = mst.comp_code)
LEFT OUTER JOIN
  (SELECT moc_head, moc_comp, sum(nvl(moc_amt,0)) AS moc_amt
   FROM bs_moc
   WHERE moc_date = to_date($P{DATE},'dd/mm/yyyy')
   GROUP BY moc_head, moc_comp, moc_circle) moc_sub
   ON (moc_sub.moc_head = mp.MAP_TYPE AND moc_sub.MOC_COMP = mp.MAP_COMP)
WHERE
  mp.MAP_SCH = '5A'
ORDER BY
  map_sc1, map_type
