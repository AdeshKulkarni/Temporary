const handleDrop = (e) => {
  e.preventDefault();
  if (!isEditing) return;
  
  const editor = bodyEditorRef.current?.getEditor();
  if (!editor) return;

  const range = editor.getSelection(true);
  if (!range) return;
  
  const text = e.dataTransfer.getData("text");
  
  // Get the document content and check for consecutive variables
  const content = editor.getContents();
  const currentIndex = range.index;
  
  // Find the previous insert operation
  let previousOp = null;
  let opIndex = 0;
  let textIndex = 0;
  
  // Scan through operations to find what's immediately before our cursor
  for (let i = 0; i < content.ops.length; i++) {
    const op = content.ops[i];
    const length = op.insert ? (typeof op.insert === 'string' ? op.insert.length : 1) : 0;
    
    if (textIndex + length > currentIndex && textIndex <= currentIndex) {
      // We found the operation where the cursor is
      break;
    }
    
    textIndex += length;
    opIndex = i;
    previousOp = op;
  }
  
  // Check if previous operation is a variable embed with the same value
  if (previousOp && 
      typeof previousOp.insert === 'object' && 
      previousOp.insert.variable === text &&
      textIndex === currentIndex) {
    // Found the same variable immediately before cursor
    setSbar({
      isOpen: true,
      Msg: `❌ Cannot add the same variable consecutively.`,
    });
    return;
  }
  
  // If validation passes, insert the new variable
  editor.insertEmbed(range.index, "variable", text, Quill.sources.USER);
  editor.setSelection(range.index + 1, Quill.sources.USER);
};
