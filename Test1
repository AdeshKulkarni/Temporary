import React, { useState, useEffect } from "react";
import {
  Divider,
  Typography,
  Box,
  Stack,
  Paper,
  MenuItem,
  TextField,
  Tabs,
  Tab,
  Menu,
} from "@mui/material";
import { DataGrid, GridToolbar } from "@mui/x-data-grid";
import { encrypt } from "../../Security/AES-GCM256";
import axios from "axios";

// Crypto setup for payloads
const iv = crypto.getRandomValues(new Uint8Array(12));
const ivBase64 = btoa(String.fromCharCode.apply(null, iv));
const salt = crypto.getRandomValues(new Uint8Array(16));
const saltBase64 = btoa(String.fromCharCode.apply(null, salt));

const subtypes = {
  IA: ["ia", "ib", "ic", "id"],
  SA: ["SCA", "SBA", "SAC", "SA"],
  Year: ["2025-2026"],
};

const columns = [
  { field: "FRN", headerName: "FRN", width: 170 },
  { field: "FIRM_NAME", headerName: "FIRM NAME", width: 200 },
  {
    field: "EMPANELMENT_SUB_TYPE",
    headerName: "EMPANELMENT SUB TYPE",
    width: 280,
  },
  { field: "EMPANELED_BY", headerName: "EMPANELED BY", width: 140 },
  { field: "EMPANELED_STATUS", headerName: "EMPANELED STATUS", width: 160 },
  { field: "EMPANELMENT_TYPE", headerName: "EMPANELMENT TYPE", width: 160 },
  { field: "FINANCIAL_YEAR", headerName: "FINANCIAL YEAR", width: 160 },
  { field: "REQUEST_STATUS", headerName: "REQUEST STATUS", width: 160 },
];

const ViewActiveAuditor = () => {
  const [filteredData, setFilteredData] = useState([]);
  const [empanelmentData, setEmpanelmentData] = useState([]);
  const [userIp, setUserIp] = useState({ datatype: "", type: "", subType: "" });

  useEffect(() => {
    if (userIp.type !== "") {
      fetchData(userIp.type);
    }
    // eslint-disable-next-line
  }, [userIp.type]);

  const fetchData = async (type) => {
    const dataToSend = { EMPANELMENT_TYPE: type };
    try {
      const jsonFormData = JSON.stringify(dataToSend);
      const encryptedData = await encrypt(iv, salt, jsonFormData);
      const payload = {
        iv: ivBase64,
        salt: saltBase64,
        data: encryptedData,
      };
      const response = await axios.post(
        "Server/IAMServices/getActiveFRN",
        payload,
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      const resData = response.data.result;
      setEmpanelmentData(resData);
    } catch (e) {
      console.error("Fetch Error:", e);
    }
  };

  const handleTabChange = (event, newValue) => {
    setUserIp({ datatype: newValue, type: "", subType: "" });
    setFilteredData([]);
  };

  const handleSelectType = (type) => {
    setUserIp((prev) => ({ ...prev, type, subType: "" }));
    setFilteredData([]);
  };

  const handleSelectSubType = (subType) => {
    if (subType === "") {
      setUserIp((prev) => ({ ...prev, subType: "" }));
      setFilteredData([]);
    } else {
      const filtered = empanelmentData.filter(
        (row) => row.EMPANELMENT_SUB_TYPE === subType
      );
      setFilteredData(filtered);
      setUserIp((prev) => ({ ...prev, subType }));
    }
  };

  return (
    <>
      <Typography variant="h5" sx={{ fontWeight: 600, mb: 0.5 }}>
        Empanelment Data
      </Typography>
      <Divider sx={{ mb: 3 }} />
      <Paper
        sx={{
          p: 3,
          maxWidth: "98vw",
          height: "80%",
          mx: "auto",
          my: 4,
          boxShadow: 4,
        }}
      >
        <Box sx={{ mb: 3 }}>
          <Tabs
            value={userIp.datatype}
            onChange={handleTabChange}
            textColor="primary"
            indicatorColor="primary"
            sx={{
              "& .MuiTab-root": {
                fontWeight: 500,
                fontSize: 16,
                minWidth: 120,
              },
            }}
          >
            <Tab label="Active" value="Active" />
            <Tab label="Archive" value="Archive" />
          </Tabs>
        </Box>

        {userIp.datatype && (
          <Stack direction="row" spacing={2} alignItems="center" sx={{ mb: 3 }}>
            <TextField
              select
              label="Type"
              value={userIp.type}
              onChange={(e) => handleSelectType(e.target.value)}
              sx={{ minWidth: 200 }}
              size="small"
              InputLabelProps={{ shrink: true }}
            >
              <MenuItem disabled value="">
                -- Select Type --
              </MenuItem>
              <MenuItem value="IA">IA</MenuItem>
              <MenuItem value="SA">SA</MenuItem>
            </TextField>

            {userIp.datatype === "Archive" && userIp.type !== "" && (
              <TextField
                select
                label="Sub-Type"
                value={userIp.subType}
                onChange={(e) => handleSelectSubType(e.target.value)}
                sx={{ minWidth: 220 }}
                size="small"
                InputLabelProps={{ shrink: true }}
              >
                <MenuItem disabled value="">
                  -- Select Sub-Type --
                </MenuItem>
                {subtypes.Year.map((option) => (
                  <MenuItem key={option} value={option}>
                    {option}
                  </MenuItem>
                ))}
              </TextField>
            )}
          </Stack>
        )}

        {userIp.type !== "" && (
          <Box sx={{ width: "100%", mt: 2 }}>
            <Paper
              elevation={2}
              sx={{
                borderRadius: 2,
                overflow: "hidden",
                minHeight: 420,
                background: "#f9f9f9",
              }}
            >
              <DataGrid
                rows={
                  filteredData.length === 0 && userIp.subType === ""
                    ? empanelmentData
                    : filteredData
                }
                columns={columns}
                getRowId={(row) => row.FRN}
                pageSizeOptions={[5, 10, 20, 50]}
                initialState={{
                  pagination: { paginationModel: { pageSize: 10 } },
                }}
                disableRowSelectionOnClick
                slots={{
                  toolbar: () => (
                    <Box
                      sx={{
                        display: "flex",
                        justifyContent: "flex-end",
                        width: "100%",
                      }}
                    >
                      <GridToolbar />
                    </Box>
                  ),
                }}
                sx={{
                  border: "none",
                  "& .MuiDataGrid-columnHeaders": {
                    background: "#e3e7ef",
                    fontWeight: 600,
                    fontSize: 15,
                  },
                  "& .MuiDataGrid-row": {
                    background: "#fff",
                  },
                  "& .MuiDataGrid-footerContainer": {
                    background: "#fafafa",
                  },
                }}
                autoHeight
              />
            </Paper>
          </Box>
        )}
      </Paper>
    </>
  );
};

export default ViewActiveAuditor;

// ---------- Optional: Professional BasicMenu ----------
export function BasicMenu({ types }) {
  const [anchorEl, setAnchorEl] = useState(null);
  const open = Boolean(anchorEl);
  const handleClick = (event) => setAnchorEl(event.currentTarget);
  const handleClose = () => setAnchorEl(null);

  return (
    <>
      <Button
        id="basic-button"
        aria-controls={open ? "basic-menu" : undefined}
        aria-haspopup="true"
        aria-expanded={open ? "true" : undefined}
        onClick={handleClick}
        sx={{ fontWeight: 500, textTransform: "capitalize" }}
      >
        Dashboard
      </Button>
      <Menu
        id="basic-menu"
        anchorEl={anchorEl}
        open={open}
        onClose={handleClose}
        slotProps={{
          list: { "aria-labelledby": "basic-button" },
        }}
      >
        {(types || []).map((type) => (
          <MenuItem key={type} onClick={handleClose}>
            {type}
          </MenuItem>
        ))}
      </Menu>
    </>
  );
}