import { Box, Grid, Typography, keyframes } from '@mui/material';

const sweepAndFinalize = keyframes`
  /* Animation from 0% to 99%: A rotating gradient border */
  0% {
    transform: rotate(0deg);
    background: conic-gradient(
      from 180deg at 50% 50%,
      transparent 0%,
      #00aaff 30%,
      #ff00aa 50%,
      #ffaa00 70%,
      transparent 90%
    );
  }
 
  99% {
    transform: rotate(360deg);
    background: conic-gradient(
      from 180deg at 50% 50%,
      transparent 0%,
      #00aaff 30%,
      #ff00aa 50%,
      #ffaa00 70%,
      transparent 90%
    );
  }
 
  100% {
    transform: rotate(360deg);
    background: #00aaff; /* final static border color */
  }
`;

function AnimatedBorderBox({props}) {
  return (
    <Grid item xs={12} sm={5} md={4}>
      <Box
        sx={{
          position: 'relative',
          borderRadius: 1,
          p: 1,
          overflow: 'hidden',

          '&::before': {
            content: '""',
            position: 'absolute',
            inset: -20,
            zIndex: 0,

            animation: `${sweepAndFinalize} 2.5s ease-out forwards`,
          },

          '&::after': {
            content: '""',
            position: 'absolute',
            inset: '1px',
            // background: (theme) => theme.palette.background.paper,
            borderRadius: 'inherit',
            zIndex: 1,
            backgroundColor: 'background.paper',
          },
        }}
      >
        <Box
          className="inner-content"
          sx={{
            position: 'relative',
            zIndex: 2,
            borderRadius: 'inherit',
            display: 'flex',
            alignItems: 'center',
            p: 1,
            backgroundColor: 'background.paper',
          }}
        >
          {props}
        </Box>
      </Box>
    </Grid>
  );
}

export default AnimatedBorderBox;


