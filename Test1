const Inline = Quill.import("blots/inline");

// Custom Blot for Invalid Variables
class InvalidBlot extends Inline {
  static blotName = "invalid-variable";
  static tagName = "span";
  static className = "invalid-variable";
}
Quill.register(InvalidBlot);

// Custom Blot for Variable Tags
class VariableBlot extends Inline {
  static blotName = "variable";
  static tagName = "span";

  static create(value) {
    let node = super.create();
    node.setAttribute("data-variable", value);
    node.textContent = value;
    node.setAttribute("contenteditable", "false");
    node.style.backgroundColor = "#e0e0e0";
    node.style.color = "#333";
    node.style.padding = "3px 8px";
    node.style.borderRadius = "16px";
    node.style.margin = "0 4px";
    node.style.cursor = "default";
    node.style.display = "inline-block";
    return node;
  }

  static formats(domNode) {
    return domNode.getAttribute("data-variable");
  }
}
Quill.register(VariableBlot);

