package com.fincore.VoucherEnquiryService.service;

import com.fincore.VoucherEnquiryService.dto.VoucherTransactionRequestDTO;
import com.fincore.VoucherEnquiryService.exception.ExportGenerationException;
import com.fincore.VoucherEnquiryService.service.utils.BaseStreamingExcelExporter;
import com.fincore.VoucherEnquiryService.service.utils.ExcelExportUtil;
import com.fincore.VoucherEnquiryService.service.utils.ExcelStyleUtil;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.apache.poi.ss.usermodel.*;
import org.apache.poi.ss.util.CellRangeAddress;
import org.apache.poi.xssf.streaming.SXSSFSheet;
import org.apache.poi.xssf.streaming.SXSSFWorkbook;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Service;
import org.springframework.util.StringUtils;

import java.io.ByteArrayOutputStream;
import java.io.IOException;
import java.sql.Date;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.concurrent.atomic.AtomicInteger;

@Service
@RequiredArgsConstructor
@Slf4j
public class VoucherTransactionStreamingExportService
                extends BaseStreamingExcelExporter {

        private final JdbcTemplate jdbcTemplate;

        public byte[] export(
                        VoucherTransactionRequestDTO request) {

                DateTimeFormatter formatter = DateTimeFormatter.ofPattern("dd-MM-yyyy");

                LocalDate transactionDate = null;
                LocalDate fromDate = null;
                LocalDate toDate = null;

                if (request.getTransactionDate() != null
                                && !request.getTransactionDate().isBlank()) {

                        transactionDate = LocalDate.parse(
                                        request.getTransactionDate(),
                                        formatter);

                } else {

                        if (request.getFromDate() != null
                                        && !request.getFromDate().isBlank()) {

                                fromDate = LocalDate.parse(
                                                request.getFromDate(),
                                                formatter);
                        }

                        if (request.getToDate() != null
                                        && !request.getToDate().isBlank()) {

                                toDate = LocalDate.parse(
                                                request.getToDate(),
                                                formatter);
                        }
                }

                final LocalDate finalTransactionDate = transactionDate;
                final LocalDate finalFromDate = fromDate;
                final LocalDate finalToDate = toDate;

                try (SXSSFWorkbook workbook = new SXSSFWorkbook(100);

                                ByteArrayOutputStream out = new ByteArrayOutputStream()) {

                        workbook.setCompressTempFiles(true);

                        SXSSFSheet sheet = workbook.createSheet(
                                        "Voucher Transactions");
                        sheet.setHorizontallyCenter(true);
                        sheet.setVerticallyCenter(false);

                        PrintSetup printSetup = sheet.getPrintSetup();
                        printSetup.setLandscape(true);

                        sheet.setFitToPage(true);
                        printSetup.setFitWidth((short) 1);
                        printSetup.setFitHeight((short) 0);

                        CellStyle headerStyle = ExcelStyleUtil.createHeaderStyle(
                                        workbook);
                        headerStyle.setAlignment(HorizontalAlignment.CENTER);
                        headerStyle.setVerticalAlignment(VerticalAlignment.CENTER);

                        CellStyle titleStyle = ExcelStyleUtil.createTitleStyle(
                                        workbook);
                        titleStyle.setAlignment(HorizontalAlignment.CENTER);
                        titleStyle.setVerticalAlignment(VerticalAlignment.CENTER);

                        CellStyle amountStyle = ExcelStyleUtil.createAmountStyle(
                                        workbook);
                        amountStyle.setAlignment(HorizontalAlignment.CENTER);
                        amountStyle.setVerticalAlignment(VerticalAlignment.CENTER);

                        CreationHelper creationHelper = workbook.getCreationHelper();

                        CellStyle criteriaValueStyle = workbook.createCellStyle();

                        criteriaValueStyle.cloneStyleFrom(headerStyle);
                        criteriaValueStyle.setAlignment(HorizontalAlignment.CENTER);
                        criteriaValueStyle.setVerticalAlignment(VerticalAlignment.CENTER);

                        CellStyle dateStyle = workbook.createCellStyle();

                        dateStyle.setDataFormat(
                                        creationHelper
                                                        .createDataFormat()
                                                        .getFormat("dd-MM-yyyy"));
                        dateStyle.setAlignment(HorizontalAlignment.CENTER);
                        dateStyle.setVerticalAlignment(VerticalAlignment.CENTER);

                        CellStyle timestampStyle = workbook.createCellStyle();

                        timestampStyle.setDataFormat(
                                        creationHelper.createDataFormat().getFormat("dd-MM-yyyy HH:mm:ss"));
                        timestampStyle.setAlignment(HorizontalAlignment.CENTER);
                        timestampStyle.setVerticalAlignment(VerticalAlignment.CENTER);

                        CellStyle centerStyle = workbook.createCellStyle();

                        centerStyle.setAlignment(
                                        HorizontalAlignment.CENTER);

                        AtomicInteger rowNum = new AtomicInteger(0);

                        // ==========================================
                        // TITLE
                        // ==========================================

                        Row titleRow = sheet.createRow(
                                        rowNum.getAndIncrement());
                        titleRow.setHeightInPoints(30);

                        Cell titleCell = titleRow.createCell(0);

                        titleCell.setCellValue(
                                        "Voucher Transactions(MIS) Report");

                        titleCell.setCellStyle(
                                        titleStyle);

                        sheet.addMergedRegion(
                                        new CellRangeAddress(
                                                        0,
                                                        0,
                                                        0,
                                                        12));

                        rowNum.incrementAndGet();

                        String acClassificationDesc = "";

                        if (StringUtils.hasText(request.getAcClassification())) {

                                acClassificationDesc = jdbcTemplate.queryForObject(
                                                """
                                                                SELECT DESCRIPTION
                                                                FROM AC_CLASSIFICATION_MASTER
                                                                WHERE AC_CLASSIFICATION = ?
                                                                """,
                                                String.class,
                                                request.getAcClassification());
                        }

                        // ==========================================
                        // SEARCH CRITERIA
                        // ==========================================

                        Row criteriaHeader = sheet.createRow(rowNum.getAndIncrement());
                        Row criteriaRow = sheet.createRow(rowNum.getAndIncrement());

                        int col = 0;

                        if (request.getAcClassification() != null && !request.getAcClassification().isBlank()) {
                                criteriaHeader.createCell(col).setCellValue("Classification");
                                criteriaHeader.getCell(col).setCellStyle(headerStyle);
                                Cell cell = criteriaRow.createCell(col++);
                                cell.setCellValue(acClassificationDesc);
                                cell.setCellStyle(criteriaValueStyle);
                        }

                        if (request.getCgl() != null && !request.getCgl().isBlank()) {
                                criteriaHeader.createCell(col).setCellValue("CGL");
                                criteriaHeader.getCell(col).setCellStyle(headerStyle);
                                Cell cell = criteriaRow.createCell(col++);
                                cell.setCellValue(request.getCgl());
                                cell.setCellStyle(criteriaValueStyle);
                        }

                        if (request.getBranchCode() != null && !request.getBranchCode().isBlank()) {
                                criteriaHeader.createCell(col).setCellValue("Branch");
                                criteriaHeader.getCell(col).setCellStyle(headerStyle);
                                Cell cell = criteriaRow.createCell(col++);
                                cell.setCellValue(request.getBranchCode());
                                cell.setCellStyle(criteriaValueStyle);
                        }

                        if (request.getTransactionDate() != null && !request.getTransactionDate().isBlank()) {
                                criteriaHeader.createCell(col).setCellValue("Transaction Date");
                                criteriaHeader.getCell(col).setCellStyle(headerStyle);
                                Cell cell = criteriaRow.createCell(col++);
                                cell.setCellValue(request.getTransactionDate());
                                cell.setCellStyle(criteriaValueStyle);
                        }

                        if (request.getFromDate() != null && !request.getFromDate().isBlank()) {
                                criteriaHeader.createCell(col).setCellValue("From Date");
                                criteriaHeader.getCell(col).setCellStyle(headerStyle);
                                Cell cell = criteriaRow.createCell(col++);
                                cell.setCellValue(request.getFromDate());
                                cell.setCellStyle(criteriaValueStyle);
                        }

                        if (request.getToDate() != null && !request.getToDate().isBlank()) {
                                criteriaHeader.createCell(col).setCellValue("To Date");
                                criteriaHeader.getCell(col).setCellStyle(headerStyle);
                                Cell cell = criteriaRow.createCell(col++);
                                cell.setCellValue(request.getToDate());
                                cell.setCellStyle(criteriaValueStyle);
                        }

                        rowNum.incrementAndGet();

                        // ==========================================
                        // MAIN HEADER
                        // ==========================================

                        String[] columns = {
                                        "Transaction ID",
                                        "Batch ID",
                                        "Journal ID",
                                        "Transaction Date",
                                        "Post Date",
                                        "Branch Code",
                                        "Currency",
                                        "CGL",
                                        "Narration",
                                        "Debit Amount",
                                        "Credit Amount",
                                        "Transaction Count",
                                        "Source Flag"
                        };

                        Row headerRow = sheet.createRow(
                                        rowNum.getAndIncrement());

                        for (int i = 0; i < columns.length; i++) {

                                Cell cell = headerRow.createCell(i);

                                cell.setCellValue(
                                                columns[i]);

                                cell.setCellStyle(
                                                headerStyle);
                        }
                        // ==================================================
                        // SQL
                        // ==================================================

                        String sql = """
                                        SELECT
                                            TRANSACTION_ID,
                                            BATCH_ID,
                                            JOURNAL_ID,
                                            TRANSACTION_DATE,
                                            POST_DATE,
                                            BRANCH_CODE,
                                            CURRENCY,
                                            CGL,
                                            NARRATION,
                                            DEBIT_AMOUNT,
                                            CREDIT_AMOUNT,
                                            TRANSACTION_COUNT,
                                            SOURCE_FLAG
                                        FROM VOUCHER_TRANSACTIONS
                                        WHERE
                                            (? IS NULL OR CGL = ?)

                                        AND
                                            (? IS NULL OR BRANCH_CODE = ?)

                                        AND
                                            (
                                                ? IS NULL
                                                OR
                                                CGL IN (
                                                    SELECT CGL_NUMBER
                                                    FROM CGL_MASTER
                                                    WHERE AC_CLASSIFICATION = ?
                                                )
                                            )

                                        AND
                                            (
                                                ? IS NULL
                                                OR TRUNC(TRANSACTION_DATE) = ?
                                            )

                                        AND
                                            (
                                                ? IS NOT NULL

                                                OR

                                                (
                                                    (? IS NULL OR TRUNC(TRANSACTION_DATE) >= ?)
                                                    AND
                                                    (? IS NULL OR TRUNC(TRANSACTION_DATE) <= ?)
                                                )
                                            )

                                        ORDER BY TRANSACTION_DATE DESC
                                        """;

                        jdbcTemplate.setFetchSize(20000);

                        jdbcTemplate.query(connection -> {

                                var ps = connection.prepareStatement(sql);

                                ps.setFetchSize(20000);

                                int index = 1;

                                ps.setString(index++, request.getCgl());
                                ps.setString(index++, request.getCgl());

                                ps.setString(index++, request.getBranchCode());
                                ps.setString(index++, request.getBranchCode());

                                ps.setString(index++, request.getAcClassification());
                                ps.setString(index++, request.getAcClassification());

                                if (finalTransactionDate != null) {

                                        ps.setDate(index++, Date.valueOf(finalTransactionDate));
                                        ps.setDate(index++, Date.valueOf(finalTransactionDate));

                                } else {

                                        ps.setNull(index++, java.sql.Types.DATE);
                                        ps.setNull(index++, java.sql.Types.DATE);
                                }

                                if (finalTransactionDate != null) {

                                        ps.setDate(index++, Date.valueOf(finalTransactionDate));

                                } else {

                                        ps.setNull(index++, java.sql.Types.DATE);
                                }

                                if (finalFromDate != null) {

                                        ps.setDate(index++, Date.valueOf(finalFromDate));
                                        ps.setDate(index++, Date.valueOf(finalFromDate));

                                } else {

                                        ps.setNull(index++, java.sql.Types.DATE);
                                        ps.setNull(index++, java.sql.Types.DATE);
                                }

                                if (finalToDate != null) {

                                        ps.setDate(index++, Date.valueOf(finalToDate));
                                        ps.setDate(index++, Date.valueOf(finalToDate));

                                } else {

                                        ps.setNull(index++, java.sql.Types.DATE);
                                        ps.setNull(index++, java.sql.Types.DATE);
                                }

                                return ps;

                        }, rs -> {

                                Row row = sheet.createRow(
                                                rowNum.getAndIncrement());

                                int column = 0;

                                row.createCell(column++)
                                                .setCellValue(
                                                                rs.getLong("TRANSACTION_ID"));

                                row.createCell(column++)
                                                .setCellValue(
                                                                ExcelExportUtil.safeString(
                                                                                rs.getString("BATCH_ID")));

                                row.createCell(column++)
                                                .setCellValue(
                                                                ExcelExportUtil.safeString(
                                                                                rs.getString("JOURNAL_ID")));

                                Cell transactionDateCell = row.createCell(column++);

                                if (rs.getTimestamp("TRANSACTION_DATE") != null) {

                                        transactionDateCell.setCellValue(
                                                        rs.getTimestamp("TRANSACTION_DATE"));

                                        transactionDateCell.setCellStyle(
                                                        dateStyle);
                                }

                                Cell postDateCell = row.createCell(column++);

                                if (rs.getTimestamp("POST_DATE") != null) {

                                        postDateCell.setCellValue(
                                                        rs.getTimestamp("POST_DATE"));

                                        postDateCell.setCellStyle(
                                                        timestampStyle);
                                }

                                row.createCell(column++)
                                                .setCellValue(
                                                                ExcelExportUtil.safeString(
                                                                                rs.getString("BRANCH_CODE")));

                                row.createCell(column++)
                                                .setCellValue(
                                                                ExcelExportUtil.safeString(
                                                                                rs.getString("CURRENCY")));

                                row.createCell(column++)
                                                .setCellValue(
                                                                ExcelExportUtil.safeString(
                                                                                rs.getString("CGL")));

                                row.createCell(column++)
                                                .setCellValue(
                                                                ExcelExportUtil.safeString(
                                                                                rs.getString("NARRATION")));

                                Cell debitCell = row.createCell(column++);

                                debitCell.setCellValue(
                                                rs.getBigDecimal("DEBIT_AMOUNT") == null
                                                                ? 0
                                                                : rs.getBigDecimal("DEBIT_AMOUNT").doubleValue());

                                debitCell.setCellStyle(amountStyle);

                                Cell creditCell = row.createCell(column++);

                                creditCell.setCellValue(
                                                rs.getBigDecimal("CREDIT_AMOUNT") == null
                                                                ? 0
                                                                : rs.getBigDecimal("CREDIT_AMOUNT").doubleValue());

                                creditCell.setCellStyle(amountStyle);

                                Cell countCell = row.createCell(column++);

                                countCell.setCellValue(
                                                rs.getLong("TRANSACTION_COUNT"));

                                countCell.setCellStyle(centerStyle);

                                Cell sourceCell = row.createCell(column++);

                                sourceCell.setCellValue(
                                                ExcelExportUtil.safeString(
                                                                rs.getString("SOURCE_FLAG")));

                                sourceCell.setCellStyle(centerStyle);

                                ExcelExportUtil.flushIfNeeded(
                                                sheet,
                                                rowNum.get());
                        });
                        // ==================================================
                        // COLUMN WIDTHS
                        // ==================================================

                        sheet.setColumnWidth(0, 5500); // Transaction ID
                        sheet.setColumnWidth(1, 5500); // Batch ID
                        sheet.setColumnWidth(2, 5500); // Journal ID
                        sheet.setColumnWidth(3, 5000); // Transaction Date
                        sheet.setColumnWidth(4, 7000); // Post Date
                        sheet.setColumnWidth(5, 5000); // Branch Code
                        sheet.setColumnWidth(6, 4500); // Currency
                        sheet.setColumnWidth(7, 5000); // CGL
                        sheet.setColumnWidth(8, 15000); // Narration
                        sheet.setColumnWidth(9, 5500); // Debit Amount
                        sheet.setColumnWidth(10, 5500); // Credit Amount
                        sheet.setColumnWidth(11, 6000); // Transaction Count
                        sheet.setColumnWidth(12, 5000);// Source Flag

                        workbook.write(out);

                        byte[] bytes = out.toByteArray();

                        return bytes;

                } catch (IOException e) {

                        throw new ExportGenerationException(
                                        "Failed to generate Voucher Transaction export",
                                        e);
                }
        }

}

 @PostMapping("/export")
    public ResponseEntity<byte[]> export(
            @Valid @RequestBody VoucherTransactionRequestDTO request) {

        byte[] file = service.exportTransactions(request);

        return ResponseEntity.ok()
                .header(HttpHeaders.CONTENT_DISPOSITION,
                        "attachment; filename=MIS_REPORTS.xlsx")
                .contentType(MediaType.parseMediaType(
                        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"))
                .body(file);
    }


