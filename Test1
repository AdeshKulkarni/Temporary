import {
  Card,
  CardContent,
  Stack,
  Typography,
  Box,
  Paper,
  Button,
  Avatar,
  Divider,
} from "@mui/material";
import React, { useState, useEffect } from "react";
import { useNavigate } from "react-router-dom";
import { styled } from "@mui/system";

// Icon imports
import SpeedIcon from "@mui/icons-material/Speed";
import BusinessIcon from "@mui/icons-material/Business";
import HelpOutlineIcon from "@mui/icons-material/HelpOutline";
import LockOpenIcon from "@mui/icons-material/LockOpen";
import UploadFileIcon from "@mui/icons-material/UploadFile";
import RuleIcon from "@mui/icons-material/Rule";
import AssignmentIndIcon from "@mui/icons-material/AssignmentInd";
import MailOutlineIcon from "@mui/icons-material/MailOutline";
import ManageAccountsIcon from "@mui/icons-material/ManageAccounts";
import ArticleIcon from "@mui/icons-material/Article";
import DomainVerificationIcon from "@mui/icons-material/DomainVerification";
import CalendarMonthIcon from "@mui/icons-material/CalendarMonth";
import CorporateFareIcon from "@mui/icons-material/CorporateFare";

// Data and helper functions remain the same
const allActions = {
  IAM: {
    View: "/IamView",
    Manage_Empanelment: "/ManageSAEmpanelment",
    Empanelment_Data: "/ViewFirmDetails",
    Firm_Requests: "/EmpReqManagement",
    PreEmpanelment_Checks: "/PreEmpanelment",
    Help: "/IamHelp",
  },
  IAC: {
    View: "/IamView",
    Empanelment_Data: "/ViewFirmDetails",
    Requests: "/IamAuthoriseRequests",
    PreEmpanelment_Checks: "/PreEmpanelment",
    Template: "/EmailTemplate",
    Intimation: "/EmpanelmentIntimation",
    Help: "/IamHelp",
  },
  SAC: {
    View: "/IamView",
    Empanelment_Data: "/ViewFirmDetails",
    Firm_Requests: "/EmpReqManagement",
    PreEmpanelment_Checks: "/PreEmpanelment",
    Template: "/EmailTemplate",
    Intimation: "/EmpanelmentIntimation",
    Help: "/IamHelp",
  },
  SAM: {
    View: "/IamView",
    Manage_Empanelment: "/ManageSAEmpanelment",
    Empanelment_Data: "/ViewFirmDetails",
    Firm_Requests: "/EmpReqManagement",
    PreEmpanelment_Checks: "/PreEmpanelment",
    Help: "/IamHelp",
  },
  94: {
    View: "/IamView",
    Access: "/IamAccessAssignment",
    Requests: "/IamAuthoriseRequests",
    Help: "/IamHelp",
  },
  96: {
    View: "/IamView",
    Access: "/IamAccessAssignment",
    Requests: "/IamAuthoriseRequests",
    Help: "/IamHelp",
  },
  MAKER: { View: "/IamView", Help: "/IamHelp" },
  CHECKER: { View: "/IamView", Help: "/IamHelp" },
  Other: { View: "/IamView", Help: "/IamHelp" },
};

const actionIcons = {
  View: <SpeedIcon color="primary" sx={{ fontSize: 40 }} />,
  Access: <LockOpenIcon color="primary" sx={{ fontSize: 40 }} />,
  Help: <HelpOutlineIcon color="primary" sx={{ fontSize: 40 }} />,
  Upload_Users: <UploadFileIcon color="primary" sx={{ fontSize: 40 }} />,
  Empanelment_Data: <BusinessIcon color="primary" sx={{ fontSize: 40 }} />,
  PreEmpanelment_Checks: <RuleIcon color="primary" sx={{ fontSize: 40 }} />,
  Requests: <DomainVerificationIcon color="primary" sx={{ fontSize: 40 }} />,
  Manage_Empanelment: (
    <ManageAccountsIcon color="primary" sx={{ fontSize: 40 }} />
  ),
  Assignment: <AssignmentIndIcon color="primary" sx={{ fontSize: 40 }} />,
  Firm_Requests: <ArticleIcon color="primary" sx={{ fontSize: 40 }} />,
  Template: <MailOutlineIcon color="primary" sx={{ fontSize: 40 }} />,
  Intimation: <MailOutlineIcon color="primary" sx={{ fontSize: 40 }} />,
  Default: <ArticleIcon color="primary" sx={{ fontSize: 40 }} />,
};

const formatActionName = (name) => name.replace(/_/g, " ");
const glowKeyframes = `@keyframes textGlow { 0% { text-shadow: 0 0 2px rgba(0, 123, 255, 0.7); } 100% { text-shadow: 0 0 8px rgba(0, 123, 255, 1), 0 0 10px rgba(0, 123, 255, 1); } }`;

// New styled components for a consistent theme
const PageContainer = styled(Box)(({ theme }) => ({
  p: 3,
  backgroundColor: "#f0f2f5",
  minHeight: "100vh",
  fontFamily: "Roboto, sans-serif",
}));

const HeaderStack = styled(Stack)(({ theme }) => ({
  flexDirection: "row",
  alignItems: "center",
  justifyContent: "space-between",
  mb: 3,
}));

const StyledCard = styled(Card)(({ theme }) => ({
  boxShadow: "0 4px 12px rgba(0,0,0,0.1)",
  borderRadius: "12px",
  transition: "transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out",
  "&:hover": {
    transform: "translateY(-4px)",
    boxShadow: "0 6px 20px rgba(0,0,0,0.15)",
  },
}));

const ActionPaper = styled(Paper)(({ theme }) => ({
  p: 2,
  textAlign: "center",
  width: 180,
  height: 160,
  display: "flex",
  flexDirection: "column",
  justifyContent: "space-around",
  alignItems: "center",
  transition: "transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out",
  "&:hover": {
    transform: "translateY(-8px)",
    boxShadow: "0 6px 20px rgba(0,0,0,0.15)",
  },
}));

const InfoBlock = ({ label, value }) => (
  <Box sx={{ flex: 1, textAlign: "center", p: 1 }}>
    <Typography
      variant="caption"
      color="text.secondary"
      sx={{ display: "block", mb: 0.5, fontWeight: 500 }}
    >
      {label}
    </Typography>
    <Typography
      variant="subtitle1"
      sx={{ fontWeight: "bold", color: "text.primary" }}
    >
      {value}
    </Typography>
  </Box>
);

// New component for the user initials logo
const UserLogo = ({ firstName, lastName }) => {
  const initials = `${firstName ? firstName[0] : ""}${lastName ? lastName[0] : ""
    }`;
  return (
    <Avatar
      sx={{
        bgcolor: "#1e3a8a",
        width: 48,
        height: 48,
        fontSize: "1.2rem",
        fontWeight: "bold",
      }}
    >
      {initials.toUpperCase()}
    </Avatar>
  );
};

export default function IamView() {
  const [userData, setUserData] = useState(null);
  const [currentUserActions, setCurrentUserActions] = useState(null);
  const navigate = useNavigate();

  useEffect(() => {
    try {
      const storedData = localStorage.getItem("user");
      if (!storedData) {
        console.error("User data not found in local storage.");
        return;
      }
      const data = JSON.parse(storedData);
      setUserData(data);

      const accessRole = data.access;
      const userRole = data.user_role;

      if (
        accessRole === "SAC" ||
        accessRole === "SAM" ||
        accessRole === "IAC" ||
        accessRole === "IAM"
      ) {
        setCurrentUserActions(allActions[accessRole]);
      } else if (userRole === "94" || userRole === "96") {
        setCurrentUserActions(allActions[userRole]);
      } else {
        setCurrentUserActions(allActions["Other"]);
      }
    } catch (error) {
      console.error("Failed to parse user data from local storage:", error);
    }
  }, []);

  if (!userData) {
    return <p>Loading user data...</p>;
  }

  return (
    <PageContainer>
      <style>{glowKeyframes}</style>

      {/* Header section with Logo and Welcome message */}
      <HeaderStack>
        <Stack direction="row" alignItems="center" spacing={2}>
          <UserLogo
            firstName={userData.first_name}
            lastName={userData.last_name}
          />
          <Typography
            variant="h4"
            sx={{ fontWeight: "bold", color: "#1e3a8a" }}
          >
            Welcome to IAM Module, {userData.first_name}!
          </Typography>
        </Stack>
      </HeaderStack>

      {/* Internal Module Assignment Section */}
      <Box sx={{ my: 4 }}>
        <Card sx={{ boxShadow: 3, borderRadius: 2 }}>
          <CardContent>
            <Stack
              direction="row"
              justifyContent="space-between"
              alignItems="center"
              sx={{ mb: 2 }}
            >
              <Typography
                variant="h5"
                sx={{
                  fontWeight: "bold",
                  color: "#1e3a8a",
                }}
              >
                Internal Module Assignment
              </Typography>
              <Box
                sx={{
                  border: "1px solid #1e3a8a",
                  borderRadius: "4px",
                  p: "4px 8px",
                }}
              >
                <Typography variant="body2" sx={{ fontWeight: "bold" }}>
                  access
                </Typography>
              </Box>
            </Stack>
            <Stack
              direction={{ xs: "column", sm: "row" }}
              spacing={2}
              divider={<Divider orientation="vertical" flexItem />}
            >
              <InfoBlock label="Branch" value={userData.branch || "N/A"} />
              <InfoBlock
                label="Assignment Type"
                value={userData.assignmentType || "N/A"}
              />
              <InfoBlock label="Logo" value={userData.logo || "N/A"} />
            </Stack>
          </CardContent>
        </Card>
      </Box>

      {/* Financial and Circle Information Cards */}
      <Stack direction={{ xs: "column", md: "row" }} spacing={3} sx={{ mb: 3 }}>
        {/* Financial Period Card */}
        <StyledCard sx={{ flex: 1 }}>
          <CardContent>
            <Box sx={{ display: "flex", alignItems: "center", mb: 2 }}>
              <CalendarMonthIcon color="action" sx={{ mr: 1.5 }} />
              <Typography
                variant="h6"
                component="div"
                sx={{ fontWeight: "600" }}
              >
                Current Financial Period
              </Typography>
            </Box>
            <Paper variant="outlined" sx={{ backgroundColor: "#fdfdff" }}>
              <Stack
                direction="row"
                spacing={1}
                justifyContent="space-around"
                sx={{ p: 1 }}
              >
                <InfoBlock
                  label="Financial Year"
                  value={userData.financial_year}
                />
                <InfoBlock label="Current Quarter" value={userData.quarter} />
                <InfoBlock
                  label="Quarter End Date"
                  value={userData.quarterEndDate}
                />
              </Stack>
            </Paper>
          </CardContent>
        </StyledCard>

        {/* Circle Information Card */}
        <StyledCard sx={{ flex: 1 }}>
          <CardContent>
            <Box sx={{ display: "flex", alignItems: "center", mb: 2 }}>
              <CorporateFareIcon color="action" sx={{ mr: 1.5 }} />
              <Typography
                variant="h6"
                component="div"
                sx={{ fontWeight: "600" }}
              >
                Circle Information
              </Typography>
            </Box>
            <Paper variant="outlined" sx={{ backgroundColor: "#fdfdff" }}>
              <Stack
                direction="row"
                spacing={1}
                justifyContent="space-around"
                sx={{ p: 1 }}
              >
                <InfoBlock label="Circle Name" value={userData.circleName} />
                <InfoBlock label="Circle Code" value={userData.circleCode} />
              </Stack>
            </Paper>
          </CardContent>
        </StyledCard>
      </Stack>

      {/* Quick Actions Card */}
      <StyledCard>
        <CardContent>
          <Typography variant="h5" m="10px" sx={{ fontWeight: "bold" }}>
            Quick Actions
          </Typography>
          <Stack
            direction="row"
            spacing={3}
            justifyContent="flex-start"
            sx={{ flexWrap: "wrap", gap: 2 }}
          >
            {currentUserActions &&
              Object.entries(currentUserActions).map(([name, path]) => (
                <ActionPaper key={name} elevation={2}>
                  {actionIcons[name] || actionIcons.Default}
                  <Typography variant="body1" sx={{ fontWeight: "medium" }}>
                    {formatActionName(name)}
                  </Typography>
                  <Button
                    variant="contained"
                    size="small"
                    onClick={() => navigate(path)}
                    sx={{ textTransform: "none", borderRadius: "16px" }}
                  >
                    Access Now
                  </Button>
                </ActionPaper>
              ))}
          </Stack>
        </CardContent>
      </StyledCard>
    </PageContainer>
  );
}
