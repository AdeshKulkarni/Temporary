CREATE TABLE MOC_REQUEST (
    REQ_ID              NUMBER PRIMARY KEY,
    REQ_STATUS          VARCHAR2(2 BYTE) DEFAULT 'P' NOT NULL, -- P: Pending, A: Accepted, R: Rejected
    CHANGE_TYPE         VARCHAR2(2 BYTE) NOT NULL, -- A: Add, U: Update, D: Delete
    REQ_DATE            DATE DEFAULT SYSDATE NOT NULL,
    CREATOR_ID          VARCHAR2(12 BYTE) NOT NULL,
    EXECUTOR_ID         VARCHAR2(12 BYTE),
    EXECUTION_DATE      DATE,
    EXECUTOR_REMARKS    VARCHAR2(500 BYTE),
    PAYLOAD             CLOB, -- JSON containing the MOC data for the request
    TARGET_ID           VARCHAR2(50 BYTE) NOT NULL -- A unique key for the MOC record (e.g., branch + CGL + date)
);

-- Sequence for the primary key
CREATE SEQUENCE MOC_REQUEST_SEQ START WITH 1 INCREMENT BY 1;
