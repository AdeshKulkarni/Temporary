To implement a PDF export for the same data, you will need a PDF generation library. OpenPDF (com.github.librepdf:openpdf) is widely used in Spring Boot applications as it's free and open-source.
If you don't have it yet, add this dependency to your pom.xml:
<dependency>
    <groupId>com.github.librepdf</groupId>
    <artifactId>openpdf</artifactId>
    <version>1.3.32</version> <!-- Use latest version -->
</dependency>

Here is the new Controller endpoint and the corresponding PDF Service class.
1. The Controller Endpoint
Add this new endpoint to your existing controller class.
import org.springframework.http.HttpHeaders;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RestController;
import jakarta.validation.Valid;

@RestController
// @RequestMapping("/api/vouchers") // Assuming your base path
public class VoucherExportController {

    private final VoucherTransactionPdfExportService pdfService;
    // ... existing constructor/injections

    @PostMapping("/export/pdf")
    public ResponseEntity<byte[]> exportPdf(
            @Valid @RequestBody VoucherTransactionRequestDTO request) {

        byte[] file = pdfService.exportToPdf(request);

        return ResponseEntity.ok()
                .header(HttpHeaders.CONTENT_DISPOSITION,
                        "attachment; filename=MIS_REPORTS.pdf")
                .contentType(MediaType.APPLICATION_PDF)
                .body(file);
    }
}

2. The PDF Service Implementation
This service creates a landscape A4 PDF, adds the title, and streams the SQL ResultSet directly into a PdfPTable.
package com.fincore.VoucherEnquiryService.service;

import com.fincore.VoucherEnquiryService.dto.VoucherTransactionRequestDTO;
import com.fincore.VoucherEnquiryService.exception.ExportGenerationException;
import com.lowagie.text.*;
import com.lowagie.text.pdf.PdfPCell;
import com.lowagie.text.pdf.PdfPTable;
import com.lowagie.text.pdf.PdfWriter;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Service;

import java.awt.Color;
import java.io.ByteArrayOutputStream;
import java.sql.Date;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.Optional;

@Service
@RequiredArgsConstructor
@Slf4j
public class VoucherTransactionPdfExportService {

    private final JdbcTemplate jdbcTemplate;

    public byte[] exportToPdf(VoucherTransactionRequestDTO request) {

        DateTimeFormatter formatter = DateTimeFormatter.ofPattern("dd-MM-yyyy");

        LocalDate transactionDate = null;
        LocalDate fromDate = null;
        LocalDate toDate = null;

        if (request.getTransactionDate() != null && !request.getTransactionDate().isBlank()) {
            transactionDate = LocalDate.parse(request.getTransactionDate(), formatter);
        } else {
            if (request.getFromDate() != null && !request.getFromDate().isBlank()) {
                fromDate = LocalDate.parse(request.getFromDate(), formatter);
            }
            if (request.getToDate() != null && !request.getToDate().isBlank()) {
                toDate = LocalDate.parse(request.getToDate(), formatter);
            }
        }

        final LocalDate finalTransactionDate = transactionDate;
        final LocalDate finalFromDate = fromDate;
        final LocalDate finalToDate = toDate;

        // Use Landscape A4 for 13 columns
        try (ByteArrayOutputStream out = new ByteArrayOutputStream();
             Document document = new Document(PageSize.A4.rotate(), 20, 20, 30, 30)) {

            PdfWriter.getInstance(document, out);
            document.open();

            // ==========================================
            // TITLE
            // ==========================================
            Font titleFont = FontFactory.getFont(FontFactory.HELVETICA_BOLD, 14, Color.BLACK);
            Paragraph title = new Paragraph("Voucher Transactions (MIS) Report", titleFont);
            title.setAlignment(Element.ALIGN_CENTER);
            title.setSpacingAfter(15);
            document.add(title);

            // ==========================================
            // MAIN TABLE
            // ==========================================
            PdfPTable table = new PdfPTable(13);
            table.setWidthPercentage(100);
            // Relative widths for 13 columns
            table.setWidths(new float[]{2f, 2f, 2f, 2f, 2.5f, 2f, 1.5f, 2f, 4f, 2f, 2f, 2f, 2f});

            String[] columns = {
                    "Txn ID", "Batch ID", "Journal ID", "Txn Date", "Post Date",
                    "Branch", "Curr", "CGL", "Narration", "Debit", "Credit", "Count", "Source"
            };

            Font headerFont = FontFactory.getFont(FontFactory.HELVETICA_BOLD, 7, Color.WHITE);
            for (String col : columns) {
                PdfPCell cell = new PdfPCell(new Phrase(col, headerFont));
                cell.setBackgroundColor(new Color(64, 64, 64)); // Dark grey header
                cell.setHorizontalAlignment(Element.ALIGN_CENTER);
                cell.setVerticalAlignment(Element.ALIGN_MIDDLE);
                cell.setPadding(4f);
                table.addCell(cell);
            }

            Font dataFont = FontFactory.getFont(FontFactory.HELVETICA, 7, Color.BLACK);

            // ==================================================
            // SQL QUERY & STREAMING
            // ==================================================
            String sql = """
                        SELECT
                            TRANSACTION_ID, BATCH_ID, JOURNAL_ID, TRANSACTION_DATE, POST_DATE,
                            BRANCH_CODE, CURRENCY, CGL, NARRATION, DEBIT_AMOUNT, CREDIT_AMOUNT,
                            TRANSACTION_COUNT, SOURCE_FLAG
                        FROM VOUCHER_TRANSACTIONS
                        WHERE (? IS NULL OR CGL = ?)
                        AND (? IS NULL OR BRANCH_CODE = ?)
                        AND (
                            ? IS NULL OR CGL IN (
                                SELECT CGL_NUMBER FROM CGL_MASTER WHERE AC_CLASSIFICATION = ?
                            )
                        )
                        AND (? IS NULL OR TRUNC(TRANSACTION_DATE) = ?)
                        AND (
                            ? IS NOT NULL OR (
                                (? IS NULL OR TRUNC(TRANSACTION_DATE) >= ?) AND
                                (? IS NULL OR TRUNC(TRANSACTION_DATE) <= ?)
                            )
                        )
                        ORDER BY TRANSACTION_DATE DESC
                        """;

            jdbcTemplate.setFetchSize(10000); // Standard fetch size for PDFs

            jdbcTemplate.query(connection -> {
                var ps = connection.prepareStatement(sql);
                ps.setFetchSize(10000);
                int index = 1;

                ps.setString(index++, request.getCgl());
                ps.setString(index++, request.getCgl());

                ps.setString(index++, request.getBranchCode());
                ps.setString(index++, request.getBranchCode());

                ps.setString(index++, request.getAcClassification());
                ps.setString(index++, request.getAcClassification());

                if (finalTransactionDate != null) {
                    ps.setDate(index++, Date.valueOf(finalTransactionDate));
                    ps.setDate(index++, Date.valueOf(finalTransactionDate));
                } else {
                    ps.setNull(index++, java.sql.Types.DATE);
                    ps.setNull(index++, java.sql.Types.DATE);
                }

                if (finalTransactionDate != null) {
                    ps.setDate(index++, Date.valueOf(finalTransactionDate));
                } else {
                    ps.setNull(index++, java.sql.Types.DATE);
                }

                if (finalFromDate != null) {
                    ps.setDate(index++, Date.valueOf(finalFromDate));
                    ps.setDate(index++, Date.valueOf(finalFromDate));
                } else {
                    ps.setNull(index++, java.sql.Types.DATE);
                    ps.setNull(index++, java.sql.Types.DATE);
                }

                if (finalToDate != null) {
                    ps.setDate(index++, Date.valueOf(finalToDate));
                    ps.setDate(index++, Date.valueOf(finalToDate));
                } else {
                    ps.setNull(index++, java.sql.Types.DATE);
                    ps.setNull(index++, java.sql.Types.DATE);
                }
                return ps;

            }, rs -> {
                // Populate row cells
                addCell(table, String.valueOf(rs.getLong("TRANSACTION_ID")), dataFont, Element.ALIGN_CENTER);
                addCell(table, rs.getString("BATCH_ID"), dataFont, Element.ALIGN_CENTER);
                addCell(table, rs.getString("JOURNAL_ID"), dataFont, Element.ALIGN_CENTER);

                addCell(table, rs.getTimestamp("TRANSACTION_DATE") != null ? rs.getTimestamp("TRANSACTION_DATE").toString().split(" ")[0] : "", dataFont, Element.ALIGN_CENTER);
                addCell(table, rs.getTimestamp("POST_DATE") != null ? rs.getTimestamp("POST_DATE").toString() : "", dataFont, Element.ALIGN_CENTER);

                addCell(table, rs.getString("BRANCH_CODE"), dataFont, Element.ALIGN_CENTER);
                addCell(table, rs.getString("CURRENCY"), dataFont, Element.ALIGN_CENTER);
                addCell(table, rs.getString("CGL"), dataFont, Element.ALIGN_CENTER);
                addCell(table, rs.getString("NARRATION"), dataFont, Element.ALIGN_LEFT);

                addCell(table, String.format("%.2f", rs.getBigDecimal("DEBIT_AMOUNT") == null ? 0.0 : rs.getBigDecimal("DEBIT_AMOUNT").doubleValue()), dataFont, Element.ALIGN_RIGHT);
                addCell(table, String.format("%.2f", rs.getBigDecimal("CREDIT_AMOUNT") == null ? 0.0 : rs.getBigDecimal("CREDIT_AMOUNT").doubleValue()), dataFont, Element.ALIGN_RIGHT);

                addCell(table, String.valueOf(rs.getLong("TRANSACTION_COUNT")), dataFont, Element.ALIGN_CENTER);
                addCell(table, rs.getString("SOURCE_FLAG"), dataFont, Element.ALIGN_CENTER);
            });

            document.add(table);
            document.close();

            return out.toByteArray();

        } catch (Exception e) {
            log.error("Error writing PDF", e);
            throw new ExportGenerationException("Failed to generate Voucher Transaction PDF export", e);
        }
    }

    private void addCell(PdfPTable table, String text, Font font, int alignment) {
        PdfPCell cell = new PdfPCell(new Phrase(Optional.ofNullable(text).orElse(""), font));
        cell.setHorizontalAlignment(alignment);
        cell.setVerticalAlignment(Element.ALIGN_MIDDLE);
        cell.setPaddingBottom(4f);
        table.addCell(cell);
    }
}

