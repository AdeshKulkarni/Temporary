import java.io.ByteArrayInputStream;
import java.io.IOException;
import java.io.InputStream;
import java.lang.reflect.Type;

@ControllerAdvice
public class DecryptionAdvice extends RequestBodyAdviceAdapter {

    @Override
    public boolean supports(MethodParameter methodParameter, Type targetType, Class<? extends HttpMessageConverter<?>> converterType) {
        // Return true for endpoints that need decryption. You can use a custom annotation here to be specific.
        return true; 
    }

    @Override
    public HttpInputMessage beforeBodyRead(HttpInputMessage inputMessage, MethodParameter parameter, Type targetType, Class<? extends HttpMessageConverter<?>> converterType) throws IOException {
        // 1. Read the encrypted raw string from inputMessage.getBody()
        // 2. Decrypt it into a JSON String
        // 3. Return a new HttpInputMessage containing the decrypted JSON bytes
        
        String decryptedJson = "{ ... }"; // Replace with actual decryption logic
        
        return new HttpInputMessage() {
            @Override
            public InputStream getBody() throws IOException {
                return new ByteArrayInputStream(decryptedJson.getBytes());
            }
            @Override
            public HttpHeaders getHeaders() {
