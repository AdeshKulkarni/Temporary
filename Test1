import React, { useEffect, useState } from "react";
import { EditorContent, useEditor, ReactNodeViewRenderer } from "@tiptap/react";
import StarterKit from "@tiptap/starter-kit";
import Placeholder from "@tiptap/extension-placeholder";
import { TextStyle } from "@tiptap/extension-text-style";
import Color from "@tiptap/extension-color";
import FontSize from "@tiptap/extension-font-size";
import { Node, mergeAttributes } from "@tiptap/core";

import {
  Button,
  Typography,
  Divider,
  Grid,
  Card,
  CardHeader,
  CardContent,
  Chip,
  Snackbar,
  Paper,
  List,
  ListItem,
  ListItemIcon,
  ListItemText,
  Box,
  Dialog,
  DialogTitle,
  DialogContent,
  IconButton,
} from "@mui/material";

import EditIcon from "@mui/icons-material/Edit";
import PreviewIcon from "@mui/icons-material/Preview";
import RestartAltIcon from "@mui/icons-material/RestartAlt";
import SaveIcon from "@mui/icons-material/Save";
import CancelIcon from "@mui/icons-material/Cancel";
import CheckCircleOutlineIcon from "@mui/icons-material/CheckCircleOutline";
import CloseIcon from "@mui/icons-material/Close";

// ----- Variable List -----
const VARIABLE_LIST = [
  "{{DATE}}",
  "{{REF_NO}}",
  "{{FIRM_NAME}}",
  "{{FRN_NO}}",
  "{{FIRM_ADDR}}",
  "{{ASSIGNMENT_TYPE}}",
  "{{GSTN}}",
];

// Sample variable replacements for preview
const PREVIEW_MAP = {
  DATE: "xx/xx/xxxx",
  REF_NO: "9999xxx",
  FIRM_NAME: "xxxxxxxxxx",
  FRN_NO: "999999999",
  GSTN: "99xx99xx",
  FIRM_ADDR: "xxxxxxxx,xxxxxxxx",
  ASSIGNMENT_TYPE: "xxxxxxx",
};

const initialHeader = `<h4 style="margin:0;">Non-editable header will appear here</h4>`;
const initialBody = `<p>Editable body will appear here</p>`;

const MAX_WORDS = 2000;
const ALLOWED_CHARS_REGEX =
  /^[a-zA-Z0-9_\s.+|\\/*&,;!?'"()\[\]%{}\-\u0900-\u097F]*$/;

function VariableChipComponent({ node, editor, getPos }) {
  const removeChip = () => {
    const pos = getPos();
    editor
      .chain()
      .focus()
      .deleteRange({ from: pos, to: pos + node.nodeSize })
      .run();
  };

  return (
    <span
      contentEditable={false}
      style={{
        backgroundColor: "#A9A9A9",
        color: "black",
        padding: "4px 18px 4px 4px",
        borderRadius: "3px",
        display: "inline-block",
        position: "relative",
        margin: "0 4px",
        userSelect: "none",
      }}
    >
      <span style={{ pointerEvents: "none" }}>{node.attrs.value}</span>
      <span
        onClick={removeChip}
        style={{
          position: "absolute",
          right: 4,
          top: "50%",
          transform: "translateY(-50%)",
          fontWeight: "bold",
          fontFamily: "monospace",
          fontSize: 14,
          cursor: "pointer",
          userSelect: "none",
          paddingLeft: 6,
          paddingRight: 6,
        }}
        title="Remove variable"
      >
        ×
      </span>
    </span>
  );
}

const VariableChipExtension = Node.create({
  name: "variableChip",
  group: "inline",
  inline: true,
  atom: true,

  addAttributes() {
    return {
      value: {
        default: "",
      },
    };
  },

  parseHTML() {
    return [{ tag: "variable-chip" }];
  },

  renderHTML({ node, HTMLAttributes }) {
    return [
      "variable-chip",
      mergeAttributes(HTMLAttributes, {}),
      0, // content ignored because atom: true
    ];
  },

  addNodeView() {
    return ReactNodeViewRenderer(VariableChipComponent);
  },

  addCommands() {
    return {
      insertVariable:
        (value) =>
        ({ chain }) => {
          return chain()
            .insertContent({
              type: this.name,
              attrs: { value },
            })
            .run();
        },
    };
  },
});

function EmailTemplateTiptap() {
  const [headerContent] = useState(initialHeader);
  const [bodyHtml, setBodyHtml] = useState(initialBody);
  const [isEditing, setIsEditing] = useState(false);
  const [snackbar, setSnackbar] = useState({ open: false, msg: "" });
  const [previewOpen, setPreviewOpen] = useState(false);
  const [previewHtml, setPreviewHtml] = useState("");
  const [wordCount, setWordCount] = useState(0);

  const editor = useEditor({
    editable: isEditing,
    content: bodyHtml,
    extensions: [
      StarterKit.configure({
        // disable horizontal rule, code block etc. if you want — customize here
        horizontalRule: false,
      }),
      TextStyle,
      Color,
      FontSize,
      Placeholder.configure({
        placeholder: "Type the email body here...",
        emptyEditorClass: "is-editor-empty",
      }),
      VariableChipExtension,
    ],

    onUpdate: ({ editor }) => {
      const newHtml = editor.getHTML();
      setBodyHtml(newHtml);

      const text = editor.getText();
      const words = text.trim().split(/\s+/).filter(Boolean);
      setWordCount(words.length);

      // Word limit check here - snackbars show for limit exceeded
      if (words.length > MAX_WORDS) {
        setSnackbar({
          open: true,
          msg: "Word limit exceeded. Please reduce content.",
        });
      }
    },
  });

  // Drag start handler for chips
  const handleDragStart = (e, label) => {
    e.dataTransfer.setData("variable", label);
  };

  // Drag & Drop handling on editor DOM
  useEffect(() => {
    if (!editor) return;

    const dom = editor.view.dom;

    const handleDrop = (event) => {
      event.preventDefault();
      event.stopPropagation();

      const variable = event.dataTransfer.getData("variable");
      if (isEditing && VARIABLE_LIST.includes(variable)) {
        // Prevent consecutive duplicates by checking previously inserted node
        const { from } = editor.state.selection;

        // Check the node before the cursor position
        const beforePos = Math.max(0, from - 1);
        const beforeNode = editor.state.doc.nodeAt(beforePos);
        if (
          beforeNode?.type.name === "variableChip" &&
          beforeNode.attrs.value === variable
        ) {
          setSnackbar({
            open: true,
            msg: "❌ Cannot add the same variable consecutively.",
          });
          return;
        }

        editor.chain().focus().insertVariable(variable).run();
      }
    };

    dom.addEventListener("drop", handleDrop);
    return () => dom.removeEventListener("drop", handleDrop);
  }, [editor, isEditing]);

  // Paste handler for validation - block paste if special characters or too many blank lines
  useEffect(() => {
    if (!editor) return;

    editor.setOptions({
      handlePaste(view, event) {
        const text = event.clipboardData.getData("text/plain");
        if (!ALLOWED_CHARS_REGEX.test(text)) {
          setSnackbar({
            open: true,
            msg: "❌ Special characters are not allowed!",
          });
          return true; // block paste
        }
        // Prevent >3 consecutive blank lines
        if (text.match(/\n{4,}/)) {
          setSnackbar({
            open: true,
            msg: "❌ You cannot enter more than 3 consecutive blank lines.",
          });
          return true; // block paste
        }
        return false;
      },
    });
  }, [editor]);

  // Copy protection for header
  const handleHeaderCopy = (e) => {
    e.preventDefault();
    setSnackbar({
      open: true,
      msg: "❌ Copying from the header is not allowed!",
    });
  };

  // Preview: replace variable chips with preview values
  const handlePreview = () => {
    let html = bodyHtml.replace(
      /<variable-chip>(\{\{[A-Z_]+\}\})<\/variable-chip>/g,
      (match, variable) => {
        const key = variable.replace(/\{\{|\}\}/g, "");
        return `<span style="background:#e3f2fd;padding:2px 4px;border-radius:2px;">${
          PREVIEW_MAP[key] || variable
        }</span>`;
      }
    );
    setPreviewHtml(`${headerContent}<hr/>${html}`);
    setPreviewOpen(true);
  };

  const handleSave = () => {
    setIsEditing(false);
    setSnackbar({ open: true, msg: "✅ Template saved successfully!" });
    setPreviewOpen(false);
    // Do your save logic here (send to backend, localStorage etc.)
  };

  const handleReset = () => {
    editor.chain().focus().setContent(initialBody).run();
    setSnackbar({ open: true, msg: "✅ Template reset to default." });
    setIsEditing(false);
    setWordCount(0);
  };

  return (
    <>
      <Typography gutterBottom variant="h5" sx={{ mb: 1 }}>
        Empanelment Intimation Letter Template (Tiptap)
      </Typography>
      <Divider sx={{ mb: 1 }} />

      <Box sx={{ p: 1, minHeight: "80%" }}>
        <Grid container spacing={3}>
          {/* Sidebar */}
          <Grid item xs={12} md={4}>
            <Card sx={{ mb: 3 }}>
              <CardHeader title="Variables" />
              <CardContent sx={{ display: "flex", flexWrap: "wrap", gap: 1 }}>
                {VARIABLE_LIST.map((label) => (
                  <Chip
                    key={label}
                    label={label}
                    color="primary"
                    draggable={isEditing}
                    onDragStart={(e) => handleDragStart(e, label)}
                    sx={{
                      borderRadius: "0",
                      cursor: isEditing ? "move" : "not-allowed",
                      fontWeight: "medium",
                      userSelect: "none",
                    }}
                  />
                ))}
              </CardContent>
            </Card>
            <Card>
              <CardHeader title="Instructions" />
              <CardContent>
                <List dense>
                  {[
                    "Special characters are not allowed.",
                    "Only use variables from the list above.",
                    "Header section is non-editable.",
                    "Click 'Edit' to modify the template body.",
                    "Maximum word limit is 2000 words.",
                  ].map((text) => (
                    <ListItem key={text} disablePadding>
                      <ListItemIcon sx={{ minWidth: 32 }}>
                        <CheckCircleOutlineIcon
                          color="primary"
                          fontSize="small"
                        />
                      </ListItemIcon>
                      <ListItemText primary={text} />
                    </ListItem>
                  ))}
                </List>
              </CardContent>
            </Card>
          </Grid>

          {/* Editor */}
          <Grid item xs={12} md={8}>
            <Card>
              <CardHeader title="Empanelment Intimation Letter Draft" />
              <CardContent>
                <Typography variant="subtitle1" sx={{ color: "text.secondary" }}>
                  Non Configurable
                </Typography>
                <Paper
                  variant="outlined"
                  sx={{
                    bgcolor: "#f5f5f5",
                    p: 1,
                    mb: 3,
                    border: "1px solid #e0e0e0",
                    borderRadius: 1,
                    userSelect: "text",
                  }}
                  onCopy={handleHeaderCopy}
                >
                  <div
                    dangerouslySetInnerHTML={{ __html: headerContent }}
                    style={{
                      minHeight: 48,
                      color: "#888",
                      fontWeight: 500,
                      fontSize: 16,
                    }}
                  />
                </Paper>

                <Typography variant="subtitle1" sx={{ color: "text.secondary" }}>
                  Configurable
                </Typography>
                <Paper
                  variant="outlined"
                  sx={{ minHeight: 180, p: 1, position: "relative" }}
                >
                  {/* Toolbar */}
                  <Box sx={{ display: "flex", gap: "4px", mb: 1 }}>
                    <Button
                      size="small"
                      variant={editor?.isActive("bold") ? "contained" : "outlined"}
                      onClick={() => editor?.chain().focus().toggleBold().run()}
                      disabled={!isEditing}
                    >
                      B
                    </Button>
                    <Button
                      size="small"
                      variant={editor?.isActive("italic") ? "contained" : "outlined"}
                      onClick={() => editor?.chain().focus().toggleItalic().run()}
                      disabled={!isEditing}
                    >
                      I
                    </Button>
                    <Button
                      size="small"
                      variant={editor?.isActive("underline") ? "contained" : "outlined"}
                      onClick={() => editor?.chain().focus().toggleUnderline().run()}
                      disabled={!isEditing}
                    >
                      U
                    </Button>
                    {/* Add more toolbar buttons here */}
                  </Box>

                  <EditorContent editable={isEditing} editor={editor} />

                  <Box
                    sx={{
                      display: "flex",
                      justifyContent: "space-between",
                      alignItems: "center",
                      mt: 2,
                      mb: 1,
                    }}
                  >
                    <Typography variant="body2" color="textSecondary">
                      Word Count: {wordCount} / {MAX_WORDS}
                    </Typography>
                    <Box sx={{ display: "flex", gap: 1 }}>
                      {!isEditing ? (
                        <Button
                          variant="contained"
                          startIcon={<EditIcon />}
                          onClick={() => setIsEditing(true)}
                        >
                          Edit
                        </Button>
                      ) : (
                        <Button
                          variant="outlined"
                          color="error"
                          startIcon={<CancelIcon />}
                          onClick={() => setIsEditing(false)}
                        >
                          Cancel
                        </Button>
                      )}

                      <Button
                        variant="outlined"
                        color="info"
                        startIcon={<PreviewIcon />}
                        onClick={handlePreview}
                        disabled={!editor}
                      >
                        Preview
                      </Button>

                      <Button
                        variant="outlined"
                        color="secondary"
                        startIcon={<RestartAltIcon />}
                        onClick={handleReset}
                        disabled={!editor}
                      >
                        Reset
                      </Button>
                    </Box>
                  </Box>
                </Paper>
              </CardContent>
            </Card>
          </Grid>
        </Grid>
      </Box>

      {/* Preview Dialog */}
      <Dialog
        open={previewOpen}
        onClose={() => setPreviewOpen(false)}
        fullWidth
        maxWidth="md"
      >
        <DialogTitle>
          Intimation Letter Draft Preview
          <IconButton
            aria-label="close"
            onClick={() => setPreviewOpen(false)}
            sx={{
              position: "absolute",
              right: 8,
              top: 8,
              color: (theme) => theme.palette.grey[500],
            }}
          >
            <CloseIcon />
          </IconButton>
        </DialogTitle>
        <DialogContent>
          <Paper
            elevation={3}
            dangerouslySetInnerHTML={{ __html: previewHtml }}
            sx={{
              width: "210mm",
              minHeight: "297mm",
              margin: "2rem auto",
              padding: "20mm",
              boxSizing: "border-box",
              backgroundColor: "#fff",
              overflow: "auto",
              overflowWrap: "break-word",
            }}
          />
        </DialogContent>
        <Box
          sx={{
            p: 2,
            borderTop: "1px solid #eee",
            display: "flex",
            gap: 2,
            justifyContent: "flex-end",
          }}
        >
          <Button onClick={() => setPreviewOpen(false)} color="secondary">
            Cancel
          </Button>
          <Button
            autoFocus
            onClick={handleSave}
            variant="contained"
            startIcon={<SaveIcon />}
          >
            Save Draft
          </Button>
        </Box>
      </Dialog>

      <Snackbar
        open={snackbar.open}
        autoHideDuration={6000}
        onClose={() => setSnackbar({ open: false, msg: "" })}
        message={snackbar.msg}
        anchorOrigin={{ vertical: "bottom", horizontal: "right" }}
      />
    </>
  );
}

export default EmailTemplateTiptap;
