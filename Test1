import { useState, useEffect, useRef } from "react";
import {
  Snackbar,
  IconButton,
  Divider,
  Dialog,
  DialogTitle,
  DialogContent,
} from "@mui/material";
import Button from "@mui/material/Button";
import { Box, styled } from "@mui/system";
import DialogActions from "@mui/material/DialogActions";
import CloseIcon from "@mui/icons-material/Close";
import ReactQuill from "react-quill";
import Quill from "quill";
import "react-quill/dist/quill.snow.css";
import axios from "axios";
import { encrypt } from "../../Security/AES-GCM256";
import PdfViewer from "../../PdfViewer/pdfViewer";
import { Paper, Typography, Grid, Container } from "@mui/material";

// 👉 Register custom fonts
const Font = Quill.import("formats/font");
Font.whitelist = [
  "arial",
  "times-new-roman",
  "comic-sans",
  "georgia",
  "courier-new",
  "verdana",
  "tahoma",
];
Quill.register(Font, true);

// 👉 Inject font styles directly
const styleTag = document.createElement("style");
styleTag.innerHTML = `
.ql-font-arial { font-family: Arial, sans-serif; }
.ql-font-times-new-roman { font-family: "Times New Roman", Times, serif; }
.ql-font-comic-sans { font-family: "Comic Sans MS", cursive, sans-serif; }
.ql-font-georgia { font-family: Georgia, serif; }
.ql-font-courier-new { font-family: "Courier New", Courier, monospace; }
.ql-font-verdana { font-family: Verdana, Geneva, sans-serif; }
.ql-font-tahoma { font-family: Tahoma, Geneva, sans-serif; }
`;
document.head.appendChild(styleTag);

const EmailTemplate = () => {
  const [value, setValue] = useState("<p>Hey there!</p>");
  const [sbar, setSbar] = useState({ isOpen: false, Msg: "" });
  const [wordCount, setWordCount] = useState(0);
  const [isEditing, setIsEditing] = useState(false);
  const [isPreviewing, setIsPreviewing] = useState(false);
  const [templateContent, settemplateContent] = useState(null);
  const [previewContent, setPreviewContent] = useState(false);
  const [base64, setBase64] = useState(null);
  const editorRef = useRef();
  const iv = crypto.getRandomValues(new Uint8Array(12));
  const ivBase64 = btoa(String.fromCharCode.apply(null, iv));
  const salt = crypto.getRandomValues(new Uint8Array(16));
  const saltBase64 = btoa(String.fromCharCode.apply(null, salt));
  const draftVar = [
    "{{DATE}}",
    "{{REF_NO}}",
    "{{FIRM_NAME}}",
    "{{FRN_NO}}",
    "{{FIRM_ADDR}}",
    "{{ASSIGNMENT_TYPE}}",
    "{{GSTN}}",
  ];

  useEffect(() => {
    fetchData();
  }, []);

  const fetchData = async () => {
    try {
      const response = await axios.post(
        "Server/IAMServices/EmailTemplate",
        {},
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      let res = response.data.result;
      setValue(res);
      setWordCount(countWord(res));
    } catch (e) {
      console.log(e);
    }
  };

  function countWord(str) {
    const text = str.replace(/<[^>]*>/g, "");
    const words = text.trim().split(/\s+/).filter(Boolean);
    return words.length;
  }

  const handleChange = (content, delta, source, editor) => {
    let a = editor.getHTML();
    let length = countWord(a);
    if (length > 128) {
      editorRef.current.editor.blur();
      setSbar({
        isOpen: true,
        Msg: "Word limit exceeded.",
      });
      setIsEditing(false);
      return;
    }
    setValue(a);
    setWordCount(length);
  };

  const handlePreview = async () => {
    setIsEditing(false);
    let StrToSend = value.replace(/<br\s*\/?>/gi, "<br></br>");
    settemplateContent(StrToSend);
    let dataToSend = {
      user: { template: `<html><head>${StrToSend}</head></html>` },
      data: {
        DATE: "31/03/2025",
        REF_NO: "1001",
        FIRM_NAME: "TRINITY ENT",
        FRN_NO: "45687",
        GSTN: "27AAHCK850D1ZK",
        FIRM_ADDR: "NAVI MUMBAI, BELPAUR",
        ASSIGNMENT_TYPE: "INTERNAL",
      },
    };
    try {
      let jsonFormData = JSON.stringify(dataToSend);
      await encrypt(iv, salt, jsonFormData).then((result) => {
        jsonFormData = result;
      });
      let payload = {
        iv: ivBase64,
        salt: saltBase64,
        data: jsonFormData,
      };
      const response = await axios.post(
        "Server/IAMServices/generateTemplate",
        payload,
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      if (response.data.statusCode === 200 && response.data.result !== "") {
        setPreviewContent(true);
        setIsPreviewing(true);
        setBase64(response.data.result);
      }
    } catch (error) {
      console.error("Error saving template:", error);
    }
  };

  const handleCloseModal = () => {
    setIsPreviewing(false);
  };

  const handleReset = async () => {
    try {
      const response = await axios.post(
        "Server/IAMServices/resetTemplate",
        {},
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      let res = response.data.result;
      setValue(res);
    } catch (e) {
      console.error("Error resetting template:", e);
    }
  };

  const modules = {
    toolbar: [
      [{ font: Font.whitelist }],
      [{ size: ["small", "large", "huge"] }],
      [{ color: [] }, { background: [] }],
      [{ align: [] }],
      [{ script: "sub" }, { script: "super" }],
      [{ header: [1, 2, 3, false] }],
      [{ list: "ordered" }, { list: "bullet" }],
      ["bold", "italic", "underline", "strike"],
      ["link", "image", "clean"],
      [{ indent: "-1" }, { indent: "+1" }],
    ],
    clipboard: { matchVisual: false },
  };

  return (
    <>
      <Typography gutterBottom variant="h5" component="div">
        Empanelment Intimation Letter Template
      </Typography>
      <Divider />
      <Grid container spacing={2} sx={{ p: 2 }}>
        <Grid item xs={12} md={4}>
          <Paper sx={{ p: 2, mb: 2 }}>
            <Typography variant="h6">Drag Variables</Typography>
            <Divider />
            {draftVar.map((label) => (
              <span
                key={label}
                style={{
                  margin: 6,
                  backgroundColor: "#0c476e",
                  padding: "8px 12px",
                  cursor: "move",
                  borderRadius: "5px",
                  color: "white",
                  fontWeight: "bold",
                  display: "inline-block",
                }}
              >
                {label}
              </span>
            ))}
          </Paper>
        </Grid>
        <Grid item xs={12} md={8}>
          <Paper sx={{ p: 2 }}>
            <Typography variant="h6">Template Editor</Typography>
            <Divider />
            <ReactQuill
              style={{ height: "300px" }}
              theme="snow"
              modules={modules}
              value={value}
              ref={editorRef}
              onChange={handleChange}
              readOnly={!isEditing}
            />
            <Typography
              variant="body2"
              color="textSecondary"
              sx={{ mt: 2 }}
            >
              Word Count: {wordCount} / 2000
            </Typography>
            <Box sx={{ mt: 2, textAlign: "right" }}>
              {!isEditing ? (
                <Button
                  variant="contained"
                  color="primary"
                  onClick={() => setIsEditing(true)}
                  sx={{ mr: 1 }}
                >
                  Edit
                </Button>
              ) : (
                <Button
                  variant="contained"
                  color="error"
                  onClick={() => setIsEditing(false)}
                  sx={{ mr: 1 }}
                >
                  Cancel
                </Button>
              )}
              <Button
                variant="contained"
                color="info"
                onClick={handlePreview}
                sx={{ mr: 1 }}
              >
                Preview
              </Button>
              <Button
                variant="contained"
                color="secondary"
                onClick={handleReset}
              >
                Reset
              </Button>
            </Box>
          </Paper>
        </Grid>
      </Grid>

      <Dialogue open={isPreviewing} close={handleCloseModal} />

      <Snackbar
        open={sbar.isOpen}
        autoHideDuration={6000}
        onClose={() => setSbar({ isOpen: false, Msg: "" })}
        message={sbar.Msg}
      />
    </>
  );
};

const BootstrapDialog = styled(Dialog)(({ theme }) => ({
  "& .MuiDialogContent-root": {
    padding: theme.spacing(2),
  },
  "& .MuiDialogActions-root": {
    padding: theme.spacing(1),
  },
}));

const Dialogue = ({ open, close }) => {
  return (
    <BootstrapDialog onClose={close} open={open} fullWidth maxWidth="md">
      <DialogTitle>Template Preview</DialogTitle>
      <IconButton
        aria-label="close"
        onClick={close}
        sx={(theme) => ({
          position: "absolute",
          right: 8,
          top: 8,
          color: theme.palette.grey[500],
        })}
      >
        <CloseIcon />
      </IconButton>
      <DialogContent dividers>
        <div
          id="preview-html"
          style={{ fontFamily: "Arial", lineHeight: 1.5 }}
        >
          Preview Content Here...
        </div>
      </DialogContent>
      <DialogActions>
        <Button autoFocus onClick={close}>
          Close
        </Button>
      </DialogActions>
    </BootstrapDialog>
  );
};

export default EmailTemplate;
