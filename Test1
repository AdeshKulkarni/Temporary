package com.tcs.fincore.MOCService.Service;

import com.tcs.fincore.MOCService.Repository.BatchSeqRepository;
import com.tcs.fincore.MOCService.Repository.JournalSeqRepository;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;

@Service
@RequiredArgsConstructor
public class SequenceService {

    private final BatchSeqRepository batchSeqRepository;
    private final JournalSeqRepository journalSeqRepository;

    /**
     * Pads the given number with leading zeros to a total length of 7.
     * 1 -> "0000001"
     * 899 -> "0000899"
     */
    private String padToSevenDigits(Long id) {
        return String.format("%07d", id);
    }

    /**
     * Gets the next BATCH_ID from the sequence and formats it.
     */
    public String getNextBatchId() {
        Long nextId = batchSeqRepository.getNextValue();
        return padToSevenDigits(nextId);
    }

    /**
     * Gets the next JOURNAL_ID prefix from the sequence and formats it.
     */
    public String getNextJournalIdPrefix() {
        Long nextId = journalSeqRepository.getNextValue();
        return padToSevenDigits(nextId);
    }
}
