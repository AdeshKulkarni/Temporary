import * as React from "react";
import {
  Button,
  Dialog,
  DialogActions,
  DialogContent,
  DialogContentText,
  DialogTitle,
  Divider,
  IconButton,
  TextField,
  Typography,
  Grid,
  MenuItem,
} from "@mui/material";
import { dividerClasses } from "@mui/material/Divider";
import Slide from "@mui/material/Slide";
import CreateIcon from "@mui/icons-material/Create";
import DeleteOutlineOutlinedIcon from "@mui/icons-material/DeleteOutlineOutlined";
import { Box } from "@mui/system";
import apiCaller from "../../apiCaller";
import useCustomSnackbar from "../../../Hooks/useCustomSnackbar";
import InputAdornment from "@mui/material/InputAdornment";
import SearchIcon from "@mui/icons-material/Search";
import CloseIcon from "@mui/icons-material/Close";
import { editingStateInitializer } from "@mui/x-data-grid/internals";
/**
 * Slide transition for Dialog
 */
const Transition = React.forwardRef(function Transition(props, ref) {
  return <Slide direction="up" ref={ref} {...props} />;
});

/**
 * Reusable Flex Center Utility
 */
const SET_CENTER = ({ x = "center", y = "center" } = {}) => ({
  display: "flex",
  justifyContent: x,
  alignItems: y,
});

/**
 * Max lengths for input fields
 */
const maxLengthMap = {
  UCN: 6,
  "Mobile Number": 10,
  "Point Of Contact": 50,
  "POC's Designation": 20,
  "POC's Email": 100,
  FRN: 14,
  "Firm Name": 100,
  "Firm Type": 25,
  PAN: 10,
  GSTIN: 15,
  "Address Line": 100,
  City: 20,
  District: 20,
  State: 50,
  PIN: 6,
};

/**
 * Field categories
 */
const AUDIT_FIRM_DETAILS = [
  "FRN",
  "UCN",
  "Firm Name",
  "Firm Type",
  "PAN",
  "GSTIN",
];
const ADDRESS = ["Address Line", "City", "District", "State", "PIN"];
const CONTACT = [
  "Mobile Number",
  "Point Of Contact",
  "POC's Designation",
  "POC's Email",
];
const FIRM_TYPE_OPTIONS = [
  "Proprietorship",
  "Partnership",
  "Limited Liablity Partnership LLP",
];

/**
 * @component FirmDetails
 * Renders a dialog for viewing/editing firm details.
 */
export default function FirmDetails({
  open,
  setOpen,
  action,
  setAction,
  empanelmentDetails,
}) {
  const [firmDetails, setFirmDetails] = React.useState({});
  const [errors, setErrors] = React.useState({});
  const [disableFRN, setDisableFRN] = React.useState(false);
  const showSnackbar = useCustomSnackbar();

  React.useEffect(() => {
    if (open) {
      if (action === "view") {
        console.log(empanelmentDetails);
        handleFRNSearch(empanelmentDetails.FRN);
      }
      setErrors({});
    }
  }, [open, action, empanelmentDetails]);

  /**
   * Closes dialog and resets form
   */
  const handleClose = () => {
    setFirmDetails({});
    setOpen(false);
    setDisableFRN(false);
  };

  /**
   * Validates input data based on field
   * @param {string} name
   * @param {string} value
   * @returns {boolean}
   */
  const validateData = (name, value) => {
    const patterns = {
      UCN: /^[0-9]{6}$/,
      "Mobile Number": /^[6-9]\d{9}$/,
      "Point Of Contact": /^[A-Za-z\s]{3,50}$/,
      "POC's Designation": /^[A-Za-z\s]{2,50}$/,
      "POC's Email": /^[\w.-]+@[a-zA-Z\d.-]+\.[a-zA-Z]{2,6}$/,
      FRN: /^[0-9A-Z]{6,14}$/,
      "Firm Name": /^[A-Za-z0-9\s&.,'-]{3,100}$/,
      "Firm Type":
        /^(Partnership|Proprietorship|Limited Liablity Partnership LLP)$/,
      PAN: /^[A-Z]{5}[0-9]{4}[A-Z]$/,
      GSTIN: /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}[Z]{1}[0-9A-Z]{1}$/,
      "Address Line": /^.{5,100}$/,
      City: /^[A-Za-z\s]{2,20}$/,
      District: /^[A-Za-z\s]{2,20}$/,
      State: /^[A-Za-z\s]{2,20}$/,
      PIN: /^[1-9][0-9]{5}$/,
    };
    const pattern = patterns[name];
    return pattern ? pattern.test(value) : true;
  };
  const backendToFrontendMap = {
    GSTN_NO: "GSTIN",
    DISTRICT: "District",
    CITY: "City",
    FRN_NO: "FRN",
    UCN_NO: "UCN",
    PAN_NO: "PAN",
    FIRM_TYPE: "Firm Type",
    STATE: "State",
    PIN_CODE: "PIN",
    ADDRESS: "Address Line",
    FIRM_NAME: "Firm Name",
    POC_DESIGNATION: "POC's Designation",
    CONTACT_PERSON: "Point Of Contact",
    POC_EMAIL: "POC's Email",
    MOB_NO: "Mobile Number",
  };

  /**
   * Handles FRN (Firm Registration Number) search.
   * Validates input, calls backend API, and populates firm details if found.
   */
  const handleFRNSearch = async (frn) => {
    if (action === "add") {
      frn = firmDetails?.FRN?.trim().toUpperCase();
    }

    if (!frn) {
      showSnackbar("Please enter FRN before searching", "warning");
      return;
    }

    try {
      const { data, error } = await apiCaller(
        "POST",
        "Server/empanelment/searchFRN",
        { frn }
      );

      if (error || !data?.result?.result) {
        showSnackbar(
          data?.message ||
            "FRN not found, you need to mannually enter the firm data",
          "warning"
        );
        if (action === "add" || action === "edit") {
          setDisableFRN(true);
        }
        return;
      }

      const rawFirmDetails = data.result.result;

      // Map backend keys to frontend keys
      const mappedFirmDetails = {};

      Object.entries(backendToFrontendMap).forEach(
        ([backendKey, frontendKey]) => {
          if (rawFirmDetails[backendKey] !== undefined) {
            mappedFirmDetails[frontendKey] = rawFirmDetails[backendKey];
          }
        }
      );

      setFirmDetails((prev) => ({
        ...prev,
        ...mappedFirmDetails,
      }));

      showSnackbar("FRN found and loaded successfully", "success");

      if (action === "add" || action === "edit") {
        setDisableFRN(true);
      }
    } catch (err) {
      console.error("FRN Search Failed:", err);
      showSnackbar("Unexpected error while searching FRN", "error");
    }
  };
  /**
   * Handles input change with validation
   */
  const handleChange = (e) => {
    const { name, value } = e.target;

    // Validate
    const isValid = validateData(name, value);
    setErrors((prev) => ({ ...prev, [name]: isValid ? "" : "Invalid value" }));

    let finalValue = value;

    // Convert to uppercase if field is FRN, PAN, or GSTIN
    if (["FRN", "PAN", "GSTIN"].includes(name)) {
      finalValue = value.toUpperCase();
    }

    // Set field regardless of validity to allow user to fix

    setFirmDetails((prev) => ({ ...prev, [name]: finalValue }));
  };

  const fieldKeyMap = {
    FRN: "FRNNO",
    GSTIN: "GSTNNO",
    District: "DISTRICT",
    City: "CITY",
    UCN: "UCNNO",
    PAN: "PAN_NO",
    "Firm Type": "FIRM_TYPE",
    State: "STATE",
    PIN: "PINCODE",
    "Address Line": "ADDRESS",
    "Firm Name": "FIRM_NAME",
    "POC's Designation": "PODESIGNATION",
    "Point Of Contact": "CONTACT_PERSON",
    "POC's Email": "POC_EMAIL",
    "Mobile Number": "MOBNO",
  };

  /**
   * Submits firm details after validation
   */
  const handleSubmit = async (req) => {
    if (action === "edit") {
      req = "M";
    }
    const newErrors = {};

    // Validate all fields
    [...AUDIT_FIRM_DETAILS, ...ADDRESS, ...CONTACT].forEach((key) => {
      const value = firmDetails?.[key] || "";
      if (!validateData(key, value)) {
        newErrors[key] = "Invalid value";
      }
    });

    if (Object.keys(newErrors).length > 0) {
      setErrors(newErrors);
      showSnackbar("Please correct the errors before submitting", "warning");
      // ** The form remains in its current 'add' or 'edit' state for correction **
      return;
    }

    // Transform firmDetails keys using fieldKeyMap
    const transformedFirmDetails = {};
    for (const key in firmDetails) {
      const mappedKey = fieldKeyMap[key] || key;
      transformedFirmDetails[mappedKey] = firmDetails[key];
    }
    transformedFirmDetails["REQUEST_EMPANELMENT_TYPE"] =
      empanelmentDetails["Empaneled for"]?.split("-")[0];
    transformedFirmDetails["REQUEST_EMPANELMENT_SUBTYPE"] =
      empanelmentDetails["Empaneled for"]?.split("-")[2];

    transformedFirmDetails["REQUEST_TYPE"] = req;
    transformedFirmDetails["REQUEST_STATUS"] = "1";

    // Transform empanelmentDetails too if needed
    const transformedEmpanelmentDetails = { ...empanelmentDetails };
    if (empanelmentDetails?.["Empaneled for"]) {
      transformedEmpanelmentDetails["ASSIGNMENT_TYPE"] =
        empanelmentDetails["Empaneled for"];
      delete transformedEmpanelmentDetails["Empaneled for"];
    }

    // Submit transformed data
    const { data, error } = await apiCaller(
      "POST",
      "/Server/empanelment/uploadExcelData",
      {
        firms: [transformedFirmDetails],
      }
    );

    if (error) {
      showSnackbar(error.data?.message, "warning");
    } else {
      if (req === "C") {
        showSnackbar(data?.message, data.result ? "success" : "error");
      } else {
        showSnackbar(
          "Request to delete empanelment has been raised",
          "warning"
        );
      }

      handleClose();
    }
  };

  /**
   * Renders input fields with labels, validation and length
   */
  const renderFields = (
    label,
    fields,
    firmDetails,
    handleChange,
    errors,
    action,
    disableFRN
  ) => {
    return (
      <>
        <Typography variant="subtitle1" sx={{ mt: 3 }} gutterBottom>
          {label}
        </Typography>

        {fields.map((vd, i) => (
          <Grid container key={`key-${label}-${i}`} sx={{ p: 1 }}>
            <Grid item sm={3} sx={{ display: "flex", alignItems: "center" }}>
              <Typography variant="body2">{vd}</Typography>
            </Grid>
            <Grid item sm={9} sx={{ position: "relative" }}>
              {/* CHANGE START: Add an overlay in 'view' mode to enable editing on click */}
              {action === "view" && (
                <Box
                  sx={{
                    position: "absolute",
                    top: 0,
                    left: 0,
                    width: "100%",
                    height: "100%",
                    zIndex: 1,
                    cursor: "pointer",
                  }}
                  onClick={() => {
                    setAction("edit");
                    setDisableFRN(true);
                  }}
                />
              )}
              {/* CHANGE END */}

              {vd === "Firm Type" ? (
                <TextField
                  select
                  fullWidth
                  disabled={action === "view" || !disableFRN}
                  name={vd}
                  variant="standard"
                  value={firmDetails?.[vd] || ""}
                  onChange={handleChange}
                  error={!!errors[vd]}
                  helperText={errors[vd]}
                >
                  <MenuItem value="" disabled>
                    Select Firm Type
                  </MenuItem>
                  {FIRM_TYPE_OPTIONS.map((option) => (
                    <MenuItem key={option} value={option}>
                      {option}
                    </MenuItem>
                  ))}
                </TextField>
              ) : vd === "FRN" ? (
                <TextField
                  fullWidth
                  disabled={
                    action === "view" || action === "edit" || disableFRN
                  }
                  name={vd}
                  placeholder={"Enter FRN"}
                  variant="standard"
                  value={firmDetails?.[vd] || ""}
                  onChange={handleChange}
                  error={!!errors?.[vd]}
                  helperText={errors?.[vd]}
                  inputProps={{
                    maxLength: maxLengthMap[vd] || 100,
                    style: ["FRN", "PAN", "GSTIN"].includes(vd)
                      ? { textTransform: "uppercase" }
                      : {},
                  }}
                  InputProps={{
                    endAdornment:
                      vd === "FRN" && action === "add" ? (
                        <InputAdornment position="end">
                          <IconButton onClick={handleFRNSearch} edge="end">
                            <SearchIcon />
                          </IconButton>
                        </InputAdornment>
                      ) : null,
                  }}
                />
              ) : (
                // Other than FRN fields
                <TextField
                  fullWidth
                  disabled={action === "view" || !disableFRN}
                  name={vd}
                  placeholder={"Enter value"}
                  variant="standard"
                  value={firmDetails?.[vd] || ""}
                  onChange={handleChange}
                  error={!!errors?.[vd]}
                  helperText={errors?.[vd]}
                  inputProps={{
                    maxLength: maxLengthMap[vd] || 100,
                    style: ["FRN", "PAN", "GSTIN"].includes(vd)
                      ? { textTransform: "uppercase" }
                      : {},
                  }}
                  InputProps={{
                    endAdornment:
                      vd === "FRN" && action === "add" ? (
                        <InputAdornment position="end">
                          <IconButton onClick={handleFRNSearch} edge="end">
                            <SearchIcon />
                          </IconButton>
                        </InputAdornment>
                      ) : null,
                  }}
                />
              )}
            </Grid>
          </Grid>
        ))}
      </>
    );
  };

  return (
    <Dialog
      fullWidth
      maxWidth="xl"
      open={open}
      onClose={handleClose}
      TransitionComponent={Transition}
      scroll="paper"
      keepMounted
    >
      <DialogTitle>Empanelment Audit Firm Details</DialogTitle>

      {action !== "add" && (
        <>
          <IconButton
            aria-label="close"
            sx={{ position: "absolute", right: 40, top: 8 }}
            onClick={() => handleSubmit("D")}
          >
            <DeleteOutlineOutlinedIcon sx={{ color: "red" }} />
          </IconButton>
          <IconButton
            aria-label="edit"
            onClick={() => {
              setAction("edit");
              setDisableFRN(true);
            }}
            sx={{ position: "absolute", right: 70, top: 8 }}
          >
            <CreateIcon sx={{ color: "blue" }} />
          </IconButton>
        </>
      )}
      <IconButton
        aria-label="close"
        onClick={handleClose}
        sx={{ position: "absolute", right: 8, top: 8 }}
      >
        <CloseIcon />
      </IconButton>

      <Divider />
      <DialogContent>
        <DialogContentText sx={{ ...SET_CENTER, flexDirection: "column" }}>
          <Grid
            container
            sx={{
              [`& .${dividerClasses.root}`]: {
                mx: 1,
              },
            }}
          >
            <Grid item md={6}>
              {renderFields(
                "Audit Firm Details",
                AUDIT_FIRM_DETAILS,
                firmDetails,
                handleChange,
                errors,
                action,
                disableFRN
              )}
              {renderFields(
                "Address",
                ADDRESS,
                firmDetails,
                handleChange,
                errors,
                action,
                disableFRN
              )}
            </Grid>
            <Divider orientation="vertical" variant="middle" flexItem />
            <Grid item md={5}>
              {renderFields(
                "Contact",
                CONTACT,
                firmDetails,
                handleChange,
                errors,
                action,
                disableFRN
              )}
            </Grid>
          </Grid>
        </DialogContentText>
      </DialogContent>

      <Divider />
      <DialogActions>
        <Box display="flex" justifyContent="flex-end" gap={2}>
          <Button
            variant="contained"
            color="primary"
            onClick={() => {
              handleSubmit("C");
              setDisableFRN(false);
            }}
            disabled={action === "view"}
          >
            Submit
          </Button>
        </Box>
      </DialogActions>
    </Dialog>
  );
}
