import { useState, useEffect, useRef } from "react";
import {
  Snackbar,
  IconButton,
  Divider,
  Dialog,
  DialogTitle,
  DialogContent,
} from "@mui/material";
import Button from "@mui/material/Button";
import { Box, height, style, styled } from "@mui/system";
import DialogActions from "@mui/material/DialogActions";
import CloseIcon from "@mui/icons-material/Close";
import ReactQuill from "react-quill";
import Quill from "quill";
import "react-quill/dist/quill.snow.css";
import RTE from "./RTE";
import quillTemplate from "./quill.css";

import {
  Paper,
  Modal,
  Card,
  CardContent,
  Typography,
  Grid,
  Container,
} from "@mui/material";
import axios from "axios";
import { encrypt } from "../../Security/AES-GCM256";
import PdfViewer from "../../PdfViewer/pdfViewer";

// Quill registrations (keeping your existing code)
var DirectionAttribute = Quill.import("attributors/attribute/direction");
Quill.register(DirectionAttribute, true);
var AlignClass = Quill.import("attributors/class/align");
Quill.register(AlignClass, true);
var BackgroundClass = Quill.import("attributors/class/background");
Quill.register(BackgroundClass, true);
var ColorClass = Quill.import("attributors/class/color");
Quill.register(ColorClass, true);
var DirectionClass = Quill.import("attributors/class/direction");
Quill.register(DirectionClass, true);
var FontClass = Quill.import("attributors/class/font");
Quill.register(FontClass, true);
var SizeClass = Quill.import("attributors/class/size");
Quill.register(SizeClass, true);
var AlignStyle = Quill.import("attributors/style/align");
Quill.register(AlignStyle, true);
var BackgroundStyle = Quill.import("attributors/style/background");
Quill.register(BackgroundStyle, true);
var ColorStyle = Quill.import("attributors/style/color");
Quill.register(ColorStyle, true);
var DirectionStyle = Quill.import("attributors/style/direction");
Quill.register(DirectionStyle, true);
var FontStyle = Quill.import("attributors/style/font");
Quill.register(FontStyle, true);
var SizeStyle = Quill.import("attributors/style/size");
Quill.register(SizeStyle, true);

const Size = Quill.import("formats/size");
Size.whitelist = ["small", "large", "huge"];
Quill.register(Size, true);

const iv = crypto.getRandomValues(new Uint8Array(12));
const ivBase64 = btoa(String.fromCharCode.apply(null, iv));
const salt = crypto.getRandomValues(new Uint8Array(16));
const saltBase64 = btoa(String.fromCharCode.apply(null, salt));

const EmailTemplate = () => {
  const [value, setValue] = useState("<p>Hey there!</p>");
  const [sbar, setSbar] = useState({ isOpen: false, Msg: "" });
  const [value1, setValue1] = useState("");
  const [wordCount, setWordCount] = useState(0);
  const [previousValue, setPreviousValue] = useState("<p>Hey there!</p>"); // Store previous valid value
  const newRef = useRef();
  const editorRef = useRef();
  const [isEditing, setIsEditing] = useState(false);
  const [isPreviewing, setIsPreviewing] = useState(false);
  const [previewContent, setPreviewContent] = useState(false);
  const [base64, setBase64] = useState(null);
  const [templateContent, settemplateContent] = useState(null);
  const [isPreviewingFe, setFe] = useState(false);

  const WORD_LIMIT = 2000;
  
  // Define allowed characters - letters, numbers, spaces, basic punctuation, and template variables
  const ALLOWED_CHARS_REGEX = /^[a-zA-Z0-9\s.,!?;:()"'\-\n\r{}]+$/;
  
  const draftVar = [
    "{{DATE}}",
    "{{REF_NO}}",
    "{{FIRM_NAME}}",
    "{{FRN_NO}}",
    "{{FIRM_ADDR}}",
    "{{ASSIGNMENT_TYPE}}",
    "{{GSTN}}",
  ];

  const modules = {
    toolbar: [
      [{ font: ["", "serif", "monospace", "arial"] }],
      [{ size: Size.whitelist }],
      [
        { color: ["red", "green", "blue", "black", "orange"] },
        { background: ["red", "green", "blue", "yellow", "gray"] },
      ],
      [{ align: "justify" }, { align: "center" }, { align: "right" }],
      [{ script: "sub" }, { script: "super" }],
      [{ header: [1, 2, 3, false] }],
      [{ list: "ordered" }, { list: "bullet" }],
      ["bold", "italic", "underline", "strike"],
      ["link", "image", "clean"],
      [{ indent: "-1" }, { indent: "+1" }],
    ],
    clipboard: {
      matchVisual: false,
    },
  };

  useEffect(() => {
    fetchData();
  }, []);

  const fetchData = async () => {
    try {
      const response = await axios.post(
        "Server/IAMServices/EmailTemplate",
        {},
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      let res = response.data.result;
      console.log(res);
      setValue(res);
      setPreviousValue(res);
      setWordCount(countWord(res));
    } catch (e) {
      console.log(e);
    }
  };

  function countWord(str) {
    const text = str.replace(/<[^>]*>/g, ""); // Remove HTML tags
    const words = text.trim().split(/\s+/).filter(Boolean);
    return words.length;
  }

  // Function to check for special characters
  function hasSpecialCharacters(str) {
    const textOnly = str.replace(/<[^>]*>/g, ""); // Remove HTML tags
    return !ALLOWED_CHARS_REGEX.test(textOnly);
  }

  // Function to extract HTML and CSS for backend
  const extractHtmlAndCss = (element) => {
    const computedStyles = window.getComputedStyle(element);
    const styles = {};
    
    // Get all computed style properties
    for (let i = 0; i < computedStyles.length; i++) {
      const property = computedStyles[i];
      styles[property] = computedStyles.getPropertyValue(property);
    }
    
    // Get inline CSS string
    const inlineCSS = Object.entries(styles)
      .map(([property, value]) => `${property}: ${value}`)
      .join('; ');

    return {
      innerHTML: element.innerHTML,
      outerHTML: element.outerHTML,
      styles: styles,
      inlineCSS: inlineCSS,
      timestamp: new Date().toISOString()
    };
  };

  // Function to send extracted data to backend
  const sendToBackend = async () => {
    if (editorRef.current) {
      const quillEditor = editorRef.current.getEditor();
      const editorElement = quillEditor.container;
      
      const extractedData = extractHtmlAndCss(editorElement);
      
      // Add template content to extracted data
      const dataToSend = {
        ...extractedData,
        templateContent: value,
        wordCount: wordCount,
        variables: draftVar
      };

      try {
        // Your existing encryption logic
        let jsonFormData = JSON.stringify(dataToSend);
        await encrypt(iv, salt, jsonFormData).then(function (result) {
          jsonFormData = result;
        });
        
        let payload = {
          iv: ivBase64,
          salt: saltBase64,
          data: jsonFormData,
        };

        const response = await axios.post(
          "Server/IAMServices/saveTemplateWithStyles",
          payload,
          {
            headers: {
              Authorization: `Bearer ${localStorage.getItem("token")}`,
            },
          }
        );

        if (response.data.statusCode === 200) {
          setSbar({
            isOpen: true,
            Msg: "Template with styles saved successfully!",
          });
        }
      } catch (error) {
        console.error("Error saving template with styles:", error);
        setSbar({
          isOpen: true,
          Msg: "Error saving template with styles!",
        });
      }
    }
  };

  const handleChange = (content, delta, source, editor) => {
    console.log(editor.getHTML());
    let htmlContent = editor.getHTML();
    let length = countWord(htmlContent);
    
    // Check word limit
    if (length > WORD_LIMIT) {
      setSbar({
        isOpen: true,
        Msg: `Word limit exceeded! Maximum ${WORD_LIMIT} words allowed. Current: ${length} words.`,
      });
      // Revert to previous value
      setValue(previousValue);
      return;
    }
    
    // Check for special characters
    if (hasSpecialCharacters(htmlContent)) {
      setSbar({
        isOpen: true,
        Msg: "Special characters are not allowed! Only letters, numbers, spaces, and basic punctuation are permitted.",
      });
      // Revert to previous value
      setValue(previousValue);
      return;
    }
    
    // If all validations pass, update the value
    setPreviousValue(htmlContent); // Store as previous valid value
    setValue(htmlContent);
    setWordCount(length);
  };

  const handleEdit = () => {
    setIsEditing(true);
    setIsPreviewing(false);
  };

  const handleDragStart = (e) => {
    console.log(e);
    const text = e.target.innerText;
    e.dataTransfer.setData("text", text);
  };

  const handleDrop = (e) => {
    console.log(e);
    e.preventDefault();
    var range = editorRef.current.editor?.getSelection(true);
    console.log("range", range);
    editorRef.current.editor?.insertText(
      range || 0,
      e.dataTransfer.getData("text")
    );
  };

  const handleSave = async () => {
    setIsEditing(false);
    let str = value.match(/\{{2}[A-Z_]+\}{2}/g);
    console.log(str);
    let checked = str?.filter((w) => {
      return draftVar.some((str) => str == w);
    });
    console.log(checked);
    
    if (str != null && str.length > checked.length) {
      console.log("inside if");
      setSbar({
        isOpen: true,
        Msg: "Invalid Variable Names added!! Ensure that entered variable names are correct and there should not be whitespaces between curly braces",
      });
      handleCloseModal();
      return;
    }

    let dataToSend = { MASTER_TEMPLATE: `<html>${value}</html>` };
    try {
      let jsonFormData = JSON.stringify(dataToSend);
      await encrypt(iv, salt, jsonFormData).then(function (result) {
        jsonFormData = result;
      });
      let payload = {
        iv: ivBase64,
        salt: saltBase64,
        data: jsonFormData,
      };
      const response = await axios.post(
        "Server/IAMServices/saveMasterTemplate",
        payload,
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      if (response.data.statusCode === 200 && response.data.result !== "") {
        console.log("successfull!");
      }
    } catch (error) {
      console.error("Error saving template:", error);
    }
    setSbar({
      isOpen: true,
      Msg: "Saved Successfully!",
    });
    setIsPreviewing("false");
    handleCloseModal();
  };

  const handlePreviewfe = async () => {
    setIsEditing(false);
    console.log(value);
    setIsPreviewing(true);
    settemplateContent(value);
    setFe(true);
  };

  const handlePreview = async () => {
    setIsEditing(false);
    console.log(value);
    let StrToSend = value.replace(/<br\s*\/?>/gi, "<br></br>");
    settemplateContent(StrToSend);
    console.log(StrToSend);
    let dataToSend = {
      user: { template: `<html><head>${StrToSend}</head></html>` },
      data: {
        DATE: "31/03/2025",
        REF_NO: "1001",
        FIRM_NAME: "TRINITY ENT",
        FRN_NO: "45687",
        GSTN: "27AAHCK850D1ZK",
        FIRM_ADDR: "NAVI MUMBAI, BELPAUR",
        ASSIGNMENT_TYPE: "INTERNAL",
      },
    };
    try {
      let jsonFormData = JSON.stringify(dataToSend);
      await encrypt(iv, salt, jsonFormData).then(function (result) {
        jsonFormData = result;
      });
      let payload = {
        iv: ivBase64,
        salt: saltBase64,
        data: jsonFormData,
      };
      const response = await axios.post(
        "Server/IAMServices/generateTemplate",
        payload,
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      console.log("response" + response.data.result);
      if (response.data.statusCode === 200 && response.data.result !== "") {
        setPreviewContent(true);
        setIsPreviewing(true);
        setBase64(response.data.result);
      }
    } catch (error) {
      console.error("Error saving template:", error);
    }
  };

  const handleCloseModal = () => {
    if (isPreviewingFe) {
      setFe(false);
    }
    setIsPreviewing(false);
  };

  const handleReset = async () => {
    try {
      const response = await axios.post(
        "Server/IAMServices/resetTemplate",
        {},
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      let res = response.data.result;
      console.log(res);
      setValue(res);
      setPreviousValue(res);
      setWordCount(countWord(res));
    } catch (e) {
      console.error("Error resetting template:", e);
    }
  };

  // Get word count color based on limit
  const getWordCountColor = () => {
    const percentage = (wordCount / WORD_LIMIT) * 100;
    if (percentage >= 90) return "error";
    if (percentage >= 75) return "warning";
    return "textSecondary";
  };

  return (
    <>
      <Typography gutterBottom variant="h5" component="div">
        Empanelment Intimation Letter Template
      </Typography>
      <Divider />
      <Grid container spacing={2} sx={{ p: 2 }}>
        <Grid item xs={12} md={4}>
          <Box
            sx={{
              height: "100%",
              width: "100%",
              bgcolor: "#737270",
              borderRadius: 2,
              boxShadow: 2,
            }}
          >
            <Paper sx={{ height: "48%", mb: "30px" }}>
              <Typography variant="h6">
                Drag Required Variables and Drop into template draft.
              </Typography>
              <hr></hr>
              {draftVar.map((label) => (
                <span
                  key={label}
                  draggable={isEditing}
                  onDragStart={handleDragStart}
                  style={{
                    margin: 10,
                    backgroundColor: "#0c476e",
                    padding: "10px 15px",
                    cursor: "move",
                    borderRadius: "5px",
                    color: "white",
                    fontWeight: "bold",
                    boxShadow: "0 4px 8px rgba(0, 0, 0, 0.2)",
                    transition: "background-color 0.3s ease",
                    display: "inline-block",
                  }}
                >
                  {label}
                </span>
              ))}
            </Paper>
            <Paper sx={{ height: "48%" }}>
              <Typography variant="h6" ml="2">
                Instructions
              </Typography>
              <hr></hr>
              <Container sx={{ ml: 3 }}>
                <li>Maximum {WORD_LIMIT} words allowed</li>
                <li>Special characters are not permitted</li>
                <li>Only letters, numbers, spaces, and basic punctuation allowed</li>
                <li>Drag variables from above section</li>
                <li>Use template variables like {draftVar[0]}</li>
              </Container>
            </Paper>
          </Box>
        </Grid>
        <Grid item xs={12} md={8}>
          <Box
            sx={{
              width: "100%",
              bgcolor: "background.default",
              borderRadius: 2,
              boxShadow: 2,
            }}
          >
            <Typography variant="h6">Template Draft</Typography>
            <hr></hr>
            <Paper sx={{ padding: 2 }}>
              <div style={{ height: "55vh", overflowY: "auto" }}>
                <ReactQuill
                  style={{ height: "500px" }}
                  theme="snow"
                  modules={modules}
                  value={value}
                  ref={editorRef}
                  onDragover={(e) => e.preventDefault()}
                  onDrop={handleDrop}
                  formats={[
                    "size",
                    "align",
                    "color",
                    "font",
                    "bold",
                    "italic",
                    "underline",
                    "strike",
                    "list",
                    "bullet",
                    "link",
                    "image",
                    "background",
                    "header",
                    "script",
                    "indent",
                  ]}
                  onChange={handleChange}
                  readOnly={!isEditing}
                />
              </div>
              <hr></hr>

              <Box sx={{ mt: 2, display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                <Typography
                  variant="body2"
                  color={getWordCountColor()}
                  sx={{ fontWeight: wordCount > WORD_LIMIT * 0.9 ? "bold" : "normal" }}
                >
                  Word Count: {wordCount} / {WORD_LIMIT}
                  {wordCount > WORD_LIMIT * 0.9 && ` (${Math.round((wordCount / WORD_LIMIT) * 100)}%)`}
                </Typography>
                
                <Box>
                  {!isEditing ? (
                    <Button
                      variant="contained"
                      color="primary"
                      onClick={() => setIsEditing(true)}
                      sx={{ mr: 1 }}
                    >
                      Edit
                    </Button>
                  ) : (
                    <Button
                      variant="contained"
                      color="error"
                      onClick={() => setIsEditing(false)}
                      sx={{ mr: 1 }}
                    >
                      Cancel
                    </Button>
                  )}
                  <Button
                    variant="contained"
                    color="info"
                    onClick={handlePreview}
                    sx={{ mr: 1 }}
                  >
                    Preview
                  </Button>
                  <Button
                    variant="contained"
                    color="info"
                    onClick={handlePreviewfe}
                    sx={{ mr: 1 }}
                  >
                    Preview Frontend
                  </Button>
                  <Button
                    variant="contained"
                    color="success"
                    onClick={sendToBackend}
                    sx={{ mr: 1 }}
                  >
                    Send to Backend
                  </Button>
                  <Button 
                    variant="contained" 
                    color="warning" 
                    onClick={handleReset}
                  >
                    Reset Template
                  </Button>
                </Box>
              </Box>
            </Paper>
          </Box>
        </Grid>
      </Grid>

      {/* Your existing modal code */}
      <Dialog open={isPreviewing} onClose={handleCloseModal} maxWidth="lg" fullWidth>
        <DialogTitle>
          Template Preview
          <IconButton
            onClick={handleCloseModal}
            sx={{ position: 'absolute', right: 8, top: 8 }}
          >
            <CloseIcon />
          </IconButton>
        </DialogTitle>
        <DialogContent>
          {isPreviewingFe && (
            <div
              style={{ height: "500px", overflow: "auto" }}
              className="ql-editor"
              dangerouslySetInnerHTML={{ __html: templateContent }}
            />
          )}
          {!isPreviewingFe && (
            <PdfViewer
              pdfData={base64}
              style={{ height: "500px" }}
            />
          )}
        </DialogContent>
        <DialogActions>
          <Button onClick={handleCloseModal} color="error">
            Close
          </Button>
          <Button onClick={handleSave} color="primary">
            Save
          </Button>
        </DialogActions>
      </Dialog>

      <Snackbar
        open={sbar.isOpen}
        autoHideDuration={6000}
        onClose={() => setSbar({ isOpen: false, Msg: "" })}
        message={sbar.Msg}
      />
    </>
  );
};

export default EmailTemplate;
