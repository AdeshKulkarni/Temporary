useEffect(() => {
  const quill = editorRef.current.getEditor();

  quill.on("text-change", (delta, oldDelta, source) => {
    if (source !== "user") return;

    const inserted = delta.ops?.find((op) => op.insert)?.insert;

    if (inserted && /[^a-zA-Z0-9\s.,;!?'"()\-@]/.test(inserted)) {
      // ❌ If special character found, delete it
      quill.deleteText(
        quill.getLength() - inserted.length - 1,
        inserted.length,
        "silent"
      );

      setSbar({
        isOpen: true,
        Msg: "❌ Special characters are not allowed!",
      });
    }
  });

  return () => {
    quill.off("text-change");
  };
}, []);
