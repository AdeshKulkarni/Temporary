router.post("/downloadZip", extractToken, DataValidator, async (req, res) => {
  if (req.user.access !== "SAC" && req.user.access !== "IAC") {
    return res.status(401).json({
      message: "Unauthorized api call, request not from legal source",
    });
  }
  console.log(
    JSON.stringify({
      user: { financial_year: req.user.financial_year },
      data: { firms: req.data.data },
    })
  );
  try {
    const response = await fetch(
      //  baseServiceUrl + "/IAMService/FRNController/downloadZip",
      "http://10.0.26.158:8081/FRNController/downloadZip",

      {
        method: "POST",
        body: JSON.stringify({
          user: { financial_year: req.user.financial_year },
        }),
        headers: {
          "Content-Type": "application/json",
        },
      }
    );
    const data = await response.json();
    res.json(data);
  } catch (e) {
    res.status(500).json({
      status: "Failed to bring reports list, no connection between LB and APP",
    });
  }
});
