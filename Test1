                              </Box>

                              <Stack direction="row" spacing={1} alignItems="center" sx={{ mb: 1.5, flexWrap: "wrap", gap: 1 }}>
                                {/* NEW: Use the 'cleanAction' variable here instead of the raw string */}
                                <Chip
