package com.fincore.VoucherService.Service.external;

import com.fincore.VoucherService.Dto.HdfsSyncDto;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.dao.DataAccessException;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Service;

import java.util.ArrayList;
import java.util.List;
import java.util.concurrent.CompletableFuture;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;
import java.util.concurrent.CompletionException;

/**
 * Enterprise-grade Service for synchronizing massive GL balances (100k+ rows) to HDFS.
 * Utilizes Multi-threaded Parallel Execution and SQL String Compression.
 */
@Service
@RequiredArgsConstructor
@Slf4j
public class HdfsSyncService {

    @Autowired
    @Qualifier("hiveJdbcTemplate")
    private JdbcTemplate hiveJdbcTemplate;

    public void syncToDataLake(List<HdfsSyncDto> data) {
        if (data == null || data.isEmpty()) return;

        log.info("HDFS_SYNC_START | Target: Hive Data Lake | Total Records: {}", data.size());
        long startTime = System.currentTimeMillis();

        // 1. STRATEGY CHANGE: Increased chunk size to 5,000 due to SQL compression
        int chunkSize = 5000;
        
        // 2. STRATEGY CHANGE: Execute 10 Spark jobs simultaneously instead of waiting sequentially
        ExecutorService executor = Executors.newFixedThreadPool(10);
        List<CompletableFuture<Void>> futures = new ArrayList<>();

        try {
            for (int i = 0; i < data.size(); i += chunkSize) {
                int startIdx = i;
                int endIdx = Math.min(data.size(), i + chunkSize);
                List<HdfsSyncDto> chunk = data.subList(startIdx, endIdx);

                // Spin up a parallel thread for each chunk
                CompletableFuture<Void> future = CompletableFuture.runAsync(() -> {
                    processChunk(chunk, startIdx, endIdx, data.size());
                }, executor);
                
                futures.add(future);
            }

            // Wait for all parallel threads to finish processing their chunks
            CompletableFuture.allOf(futures.toArray(new CompletableFuture[0])).join();

            log.info("HDFS_SYNC_SUCCESS | Total Duration: {}ms | Processed all {} records in parallel",
                    (System.currentTimeMillis() - startTime), data.size());

        } catch (CompletionException e) {
            // Extract the actual database exception from the Thread wrapper
            Throwable cause = e.getCause() != null ? e.getCause() : e;
            String exactSparkError = cause.getMessage();
            log.error("HDFS_SYNC_PARALLEL_FAIL | Spark Error Details: {}", exactSparkError);
            throw new RuntimeException("Data Lake Sync Failed during parallel execution", cause);
        } finally {
            // Always shut down the thread pool to free up memory
            executor.shutdown();
        }
    }

    /**
     * Private helper method to process an individual chunk in its own Thread.
     */
    private void processChunk(List<HdfsSyncDto> chunk, int startIdx, int endIdx, int totalSize) {
        StringBuilder usingClause = new StringBuilder("USING (");
        List<Object> parameters = new ArrayList<>();

        for (int j = 0; j < chunk.size(); j++) {
            HdfsSyncDto dto = chunk.get(j);
            String glccKey = dto.getBranch() + dto.getCurrency() + dto.getCgl();

            if (j > 0) {
                usingClause.append(" UNION ALL ");
            }

            // 3. STRATEGY CHANGE: SQL COMPRESSION. 
            // We only cast data types on the FIRST row. The database automatically infers it for the rest.
            // This shrinks the query size by 80%, allowing 5,000 rows without hitting query limits.
            if (j == 0) {
                usingClause.append("SELECT ? AS glcc, cast(? AS date) AS BALANCE_DATE, CAST(? AS DECIMAL(25,4)) AS BALANCE, CAST(? AS DECIMAL(25,4)) AS INR_BALANCE");
            } else {
                usingClause.append("SELECT ?, ?, ?, ?"); 
            }

            parameters.add(glccKey);
            parameters.add(dto.getBalanceDate().toString());
            parameters.add(dto.getNewBalance());
            parameters.add(dto.getNewInrBalance());
        }
        usingClause.append(") AS source ");

        String mergeSql = "MERGE INTO fincoredatalakevoucher.gl_balance AS target " +
                usingClause.toString() +
                "ON target.glcc = source.glcc AND target.BALANCE_DATE = source.BALANCE_DATE " +
                "WHEN MATCHED THEN " +
                "  UPDATE SET target.BALANCE = source.BALANCE, target.INR_BALANCE = source.INR_BALANCE " +
                "WHEN NOT MATCHED THEN " +
                "  INSERT (glcc, BALANCE_DATE, BALANCE, INR_BALANCE) " +
                "  VALUES (source.glcc, source.BALANCE_DATE, source.BALANCE, source.INR_BALANCE)";

        hiveJdbcTemplate.update(mergeSql, parameters.toArray());
        
        log.info("HDFS_SYNC_THREAD_DONE | Thread: {} | Processed records {} to {} of {}", 
                 Thread.currentThread().getName(), startIdx, endIdx, totalSize);
    }
}


