public void frequencyArrayTemplate(String s) {// 1. Create the array
// Use size 26 for lowercase OR uppercase letters.
// Use size 128 if the string contains a mix of upper/lower/numbers/symbols.
int[] freq = new int[26];

// 2. Add characters to the array (Expanding window)
for (int i = 0; i < s.length(); i++) {
    char c = s.charAt(i);

    // If string is ONLY lowercase: use c - 'a'
    // If string is ONLY uppercase: use c - 'A'
    freq[c - 'A']++;
}
// 3. Remove a character (Shrinking window)
char charToRemove = 'B';
freq[charToRemove - 'A']--;

// 4. Check the frequency of a specific character
char charToCheck = 'C';
int countOfC = freq[charToCheck - 'A'];

// 5. Find the most frequent character overall
int maxCount = 0;
for (int i = 0; i < 26; i++) {
    if (freq[i] > maxCount) {
        maxCount = freq[i];
    }
}
