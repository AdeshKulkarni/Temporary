            View & Action
          </Button>
        );
      },
    },
  ];

  return (
    <Paper elevation={0} sx={jaStyles.mainPaper}>
      <Typography variant="h6" fontWeight="bold" gutterBottom color="primary.main" sx={{ ml: 6, mt: 2 }}>
        Voucher Authorization
      </Typography>
      <Box sx={styles.mainContainer}>
        <DataGrid
          rows={rows}
          columns={columns}
