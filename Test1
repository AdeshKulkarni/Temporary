  /**
   * Validates input data based on field
   * @param {string} name
   ** @param {string} value
   * @returns {boolean}
   */
  const validateData = (name, value) => {
    const patterns = {
      UCN: /^[0-9]{6}$/,
      "Mobile Number": /^[6-9]\d{9}$/,
      "Point Of Contact": /^[A-Za-z\s]{3,50}$/,
      "POC's Designation": /^[A-Za-z\s]{2,50}$/,
      "POC's Email": /^[\w.-]+@[a-zA-Z\d.-]+\.[a-zA-Z]{2,6}$/,
      FRN: /^[0-9A-Z]{6,14}$/,
      "Firm Name": /^[A-Za-z0-9\s&.,'-]{3,100}$/,
      "Firm Type":
        /^(Partnership|Proprietorship|Limited Liablity Partnership LLP)$/,
      PAN: /^[A-Z]{5}[0-9]{4}[A-Z]$/,
      GSTIN: /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}[Z]{1}[0-9A-Z]{1}$/,
      "Address Line": /^.{5,100}$/,
      City: /^[A-Za-z\s]{2,20}$/,
      District: /^[A-Za-z\s]{2,20}$/,
      State: /^[A-Za-z\s]{2,20}$/,
      // CORRECTED: Checks for a starting digit from 1-9, followed by 5 more digits (total 6).
      PIN: /^[1-9][0-9]{5}$/,
    };
    const pattern = patterns[name];
    return pattern ? pattern.test(value) : true;
  };
