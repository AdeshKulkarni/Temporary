import { useState, useEffect, useRef } from "react";
import {
  Snackbar,
  IconButton,
  Button,
  Divider,
  Dialog,
  DialogTitle,
  DialogContent,
  Paper,
  Typography,
  Grid,
  Container,
} from "@mui/material";
import { Box, styled } from "@mui/system";
import DialogActions from "@mui/material/DialogActions";
import CloseIcon from "@mui/icons-material/Close";
import ReactQuill from "react-quill";
import Quill from "quill";
import "react-quill/dist/quill.snow.css";
import axios from "axios";
import { encrypt } from "../../Security/AES-GCM256";
import ImageResize from "quill-image-resize-module-react";

// Register Quill modules
Quill.register("modules/imageResize", ImageResize);

// Quill formatting
const DirectionAttribute = Quill.import("attributors/attribute/direction");
Quill.register(DirectionAttribute, true);

const AlignClass = Quill.import("attributors/class/align");
Quill.register(AlignClass, true);

const BackgroundClass = Quill.import("attributors/class/background");
Quill.register(BackgroundClass, true);

const ColorClass = Quill.import("attributors/class/color");
Quill.register(ColorClass, true);

const DirectionClass = Quill.import("attributors/class/direction");
Quill.register(DirectionClass, true);

const FontClass = Quill.import("attributors/class/font");
Quill.register(FontClass, true);

const SizeClass = Quill.import("attributors/class/size");
Quill.register(SizeClass, true);

const AlignStyle = Quill.import("attributors/style/align");
Quill.register(AlignStyle, true);

const BackgroundStyle = Quill.import("attributors/style/background");
Quill.register(BackgroundStyle, true);

const ColorStyle = Quill.import("attributors/style/color");
Quill.register(ColorStyle, true);

const DirectionStyle = Quill.import("attributors/style/direction");
Quill.register(DirectionStyle, true);

const FontStyle = Quill.import("attributors/style/font");
Quill.register(FontStyle, true);

const SizeStyle = Quill.import("attributors/style/size");
Quill.register(SizeStyle, true);

const Size = Quill.import("formats/size");
Size.whitelist = [
  "8px", "10px", "12px", "14px", "16px", 
  "18px", "20px", "22px", "24px", "26px"
];
Quill.register(Size, true);

const Font = Quill.import("formats/font");
Font.whitelist = [
  "arial", "times-new-roman", "courier-new", "sans-serif", "serif",
  "monospace", "georgia", "tahoma", "verdana", "sofia"
];
Quill.register(Font, true);

const iv = crypto.getRandomValues(new Uint8Array(12));
const ivBase64 = btoa(String.fromCharCode.apply(null, iv));
const salt = crypto.getRandomValues(new Uint8Array(16));
const saltBase64 = btoa(String.fromCharCode.apply(null, salt));

const EmailTemplate = () => {
  // State variables
  const [headerContent, setHeaderContent] = useState("");
  const [bodyContent, setBodyContent] = useState("");
  const [sbar, setSbar] = useState({ isOpen: false, Msg: "" });
  const [wordCount, setWordCount] = useState(0);
  const [isEditing, setIsEditing] = useState(false);
  const [isPreviewing, setIsPreviewing] = useState(false);
  const [templateContent, setTemplateContent] = useState(null);
  const [isLoading, setIsLoading] = useState(true);

  const draftVar = [
    "{{DATE}}",
    "{{REF_NO}}",
    "{{FIRM_NAME}}",
    "{{FRN_NO}}",
    "{{FIRM_ADDR}}",
    "{{ASSIGNMENT_TYPE}}",
    "{{GSTN}}",
  ];

  const bodyEditorRef = useRef(null);
  const headerEditorRef = useRef(null);

  // Quill modules configuration
  const modules = {
    toolbar: [
      [{ font: Font.whitelist }],
      [{ size: Size.whitelist }],
      [
        { color: ["red", "green", "blue", "black", "orange"] },
        { background: ["red", "green", "blue", "yellow", "gray"] }
      ],
      [
        { align: "justify" }, 
        { align: "center" }, 
        { align: "right" }
      ],
      [
        { script: "sub" }, 
        { script: "super" }
      ],
      [
        { header: [1, 2, 3, false] }
      ],
      [
        { list: "ordered" }, 
        { list: "bullet" }
      ],
      ["bold", "italic", "underline", "strike"],
      ["link", "image", "clean"],
      [
        { indent: "-1" }, 
        { indent: "+1" }
      ],
    ],
    clipboard: {
      matchVisual: false,
    },
    imageResize: {
      modules: ["Resize", "DisplaySize"],
    },
  };

  // Fetch template data on mount
  useEffect(() => {
    fetchData();
  }, []);

  const fetchData = async () => {
    try {
      setIsLoading(true);
      const response = await axios.post(
        "Server/IAMServices/EmailTemplate",
        {},
        { headers: { Authorization: `Bearer ${localStorage.getItem("token")}` } }
      );
      
      if (response.data && response.data.result) {
        updateContent(response.data.result);
      } else {
        setSbar({ isOpen: true, Msg: "No template data found" });
      }
    } catch (e) {
      console.error("Error fetching template:", e);
      setSbar({ isOpen: true, Msg: "Failed to load template" });
    } finally {
      setIsLoading(false);
    }
  };

  const updateContent = (content) => {
    // Split template into header and body sections
    const splitIndex = content.indexOf("Dear Sir/Madam");
    if (splitIndex !== -1) {
      setHeaderContent(content.substring(0, splitIndex));
      setBodyContent(content.substring(splitIndex));
    } else {
      setHeaderContent(content);
      setBodyContent("");
    }
    setWordCount(countWord(content));
  };

  const countWord = (str) => {
    if (!str) return 0;
    const text = str.replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim();
    return text ? text.split(" ").length : 0;
  };

  const handleBodyChange = (content, delta, source, editor) => {
    if (source !== "user") return;

    const htmlContent = editor.getHTML();
    const textContent = editor.getText();
    const length = countWord(textContent);

    // Validate inserted text
    const insertedOp = delta.ops?.find(op => typeof op.insert === "string");
    if (insertedOp) {
      const inserted = insertedOp.insert;
      const illegalChar = inserted.match(/[^a-zA-Z0-9_\s.,;!?'"()\{\}\-@$%^&*=+\\/|<>]/);
      
      if (illegalChar) {
        setTimeout(() => {
          const quillEditor = bodyEditorRef.current?.getEditor();
          if (quillEditor) {
            const selection = quillEditor.getSelection();
            const position = selection?.index || quillEditor.getLength();
            quillEditor.deleteText(position - inserted.length, inserted.length, "silent");
          }
        }, 10);
        
        setSbar({ isOpen: true, Msg: "❌ Special characters are not allowed!" });
        return;
      }
    }

    // Word limit validation
    if (length > 2000) {
      setSbar({ isOpen: true, Msg: "Word limit exceeded. Please reduce content." });
      return;
    }

    setBodyContent(htmlContent);
    setWordCount(length);
  };

  const handleDragStart = (e) => {
    const text = e.target.innerText;
    e.dataTransfer.setData("text/plain", text);
  };

  const handleDrop = (e) => {
    e.preventDefault();
    if (!isEditing) return;

    const editor = bodyEditorRef.current?.getEditor();
    if (!editor) return;

    const range = editor.getSelection(true);
    if (range) {
      const text = e.dataTransfer.getData("text/plain");
      editor.insertText(range.index, text);
    }
  };

  const handleSave = async () => {
    setIsEditing(false);
    const fullContent = headerContent + bodyContent;

    // Validate template variables
    const variables = fullContent.match(/\{\{([A-Z_]+)\}\}/g) || [];
    const invalidVars = variables.filter(v => !draftVar.includes(v));
    
    if (invalidVars.length > 0) {
      setSbar({
        isOpen: true,
        Msg: "Invalid variables detected: " + invalidVars.join(", "),
      });
      return;
    }

    const dataToSend = { MASTER_TEMPLATE: fullContent };
    try {
      let encryptedData = await encrypt(iv, salt, JSON.stringify(dataToSend));
      const payload = {
        iv: ivBase64,
        salt: saltBase64,
        data: encryptedData,
      };
      
      await axios.post(
        "Server/IAMServices/saveMasterTemplate",
        payload,
        { headers: { Authorization: `Bearer ${localStorage.getItem("token")}` } }
      );
      
      setSbar({ isOpen: true, Msg: "Saved Successfully!" });
    } catch (error) {
      console.error("Error saving template:", error);
      setSbar({ isOpen: true, Msg: "Failed to save template" });
    }
    setIsPreviewing(false);
  };

  const handlePreview = () => {
    const fullContent = headerContent + bodyContent;
    const data = {
      DATE: "xx/xx/xxxx",
      REF_NO: "9999xxx",
      FIRM_NAME: "xxxxxxxxxx",
      FRN_NO: "999999999",
      GSTN: "99xx99xx",
      FIRM_ADDR: "xxxxxxxx,xxxxxxxx",
      ASSIGNMENT_TYPE: "xxxxxxx",
    };

    const StrToSend = fullContent.replace(/\{\{([A-Z_]+)\}\}/g, (match, p1) => {
      return data[p1] || match;
    });

    setTemplateContent(StrToSend);
    setIsPreviewing(true);
  };

  const handleReset = async () => {
    try {
      const response = await axios.post(
        "Server/IAMServices/resetTemplate",
        {},
        { headers: { Authorization: `Bearer ${localStorage.getItem("token")}` } }
      );
      
      if (response.data && response.data.result) {
        updateContent(response.data.result);
        setSbar({ isOpen: true, Msg: "Template reset successfully" });
      }
    } catch (e) {
      console.error("Error resetting template:", e);
      setSbar({ isOpen: true, Msg: "Failed to reset template" });
    }
  };

  const handleHeaderCopy = (e) => {
    e.preventDefault();
    setSbar({
      isOpen: true,
      Msg: "❌ Copying from non-editable section is not allowed!",
    });
  };

  // Quill formats configuration
  const formats = [
    "font", "size", "color", "background",
    "bold", "italic", "underline", "strike",
    "list", "bullet", "indent", "script",
    "align", "direction", "link", "image",
    "header"
  ];

  return (
    <>
      <Typography gutterBottom variant="h5" component="div">
        Empanelment Intimation Letter Template
      </Typography>
      <Divider />
      
      {isLoading ? (
        <Box sx={{ display: "flex", justifyContent: "center", py: 4 }}>
          <Typography variant="h6">Loading template...</Typography>
        </Box>
      ) : (
        <Grid container spacing={2} sx={{ p: 2 }}>
          <Grid item xs={12} md={4}>
            <Box sx={{ height: "100%", borderRadius: 2, boxShadow: 2 }}>
              <Paper sx={{ height: "48%", mb: 3, p: 2 }}>
                <Typography variant="h6" gutterBottom>
                  Drag Required Variables
                </Typography>
                <Divider />
                <Box sx={{ display: "flex", flexWrap: "wrap", mt: 2 }}>
                  {draftVar.map((label) => (
                    <Box
                      key={label}
                      draggable={isEditing}
                      onDragStart={handleDragStart}
                      sx={{
                        m: 1,
                        bgcolor: "#0c476e",
                        px: 1.5,
                        py: 0.5,
                        cursor: "move",
                        borderRadius: "4px",
                        color: "white",
                        fontWeight: "bold",
                        boxShadow: 1,
                        "&:hover": { bgcolor: "#0a3a5a" },
                      }}
                    >
                      {label}
                    </Box>
                  ))}
                </Box>
              </Paper>
              
              <Paper sx={{ height: "48%", p: 2 }}>
                <Typography variant="h6" gutterBottom>
                  Instructions
                </Typography>
                <Divider />
                <Box component="ul" sx={{ pl: 2, mt: 2, mb: 0 }}>
                  <li>Special characters are not allowed</li>
                  <li>Only use allowed variables from the list</li>
                  <li>Header section is non-editable and non-copyable</li>
                  <li>Body section is editable when in edit mode</li>
                  <li>Maximum word limit: 2000 words</li>
                </Box>
              </Paper>
            </Box>
          </Grid>
          
          <Grid item xs={12} md={8}>
            <Box sx={{ borderRadius: 2, boxShadow: 2 }}>
              <Paper sx={{ p: 2 }}>
                <Typography variant="h6">Draft</Typography>
                <Divider sx={{ my: 2 }} />
                
                {/* Non-editable Header Section */}
                <Box
                  sx={{
                    bgcolor: "#f5f5f5",
                    p: 2,
                    mb: 2,
                    border: "1px solid #e0e0e0",
                    borderRadius: "4px",
                  }}
                  onCopy={handleHeaderCopy}
                >
                  <Typography variant="subtitle2" sx={{ mb: 1, color: "#666" }}>
                    Non-editable Header
                  </Typography>
                  <ReactQuill
                    theme="bubble"
                    value={headerContent}
                    ref={headerEditorRef}
                    readOnly={true}
                    modules={{ toolbar: false }}
                    formats={[]}
                  />
                </Box>
                
                {/* Editable Body Section */}
                <Box
                  sx={{
                    bgcolor: "#fff",
                    p: 2,
                    border: "1px solid #e0e0e0",
                    borderRadius: "4px",
                  }}
                >
                  <Typography variant="subtitle2" sx={{ mb: 1 }}>
                    Editable Body
                  </Typography>
                  <Box
                    sx={{ height: "40vh", overflowY: "auto" }}
                    onDragover={(e) => e.preventDefault()}
                    onDrop={handleDrop}
                  >
                    <ReactQuill
                      theme="snow"
                      modules={modules}
                      formats={formats}
                      value={bodyContent}
                      ref={bodyEditorRef}
                      onChange={handleBodyChange}
                      readOnly={!isEditing}
                      placeholder="Start writing your content here..."
                    />
                  </Box>
                </Box>
                
                <Divider sx={{ my: 2 }} />
                <Box sx={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                  <Typography variant="body2" color="textSecondary">
                    Word Count: {wordCount} / 2000
                  </Typography>
                  
                  <Box>
                    {!isEditing ? (
                      <Button
                        variant="contained"
                        color="primary"
                        onClick={() => setIsEditing(true)}
                        sx={{ mr: 1 }}
                      >
                        Edit
                      </Button>
                    ) : (
                      <Button
                        variant="contained"
                        color="error"
                        onClick={() => setIsEditing(false)}
                        sx={{ mr: 1 }}
                      >
                        Cancel
                      </Button>
                    )}
                    
                    <Button
                      variant="contained"
                      color="info"
                      onClick={handlePreview}
                      sx={{ mr: 1 }}
                      disabled={wordCount === 0}
                    >
                      Preview
                    </Button>
                    
                    <Button
                      variant="contained"
                      color="secondary"
                      onClick={handleReset}
                    >
                      Reset Template
                    </Button>
                  </Box>
                </Box>
              </Paper>
            </Box>
          </Grid>
        </Grid>
      )}
      
      {/* Preview Dialog */}
      <Dialog
        open={isPreviewing}
        onClose={() => setIsPreviewing(false)}
        fullWidth
        maxWidth="md"
      >
        <DialogTitle sx={{ m: 0, p: 2, bgcolor: "#f5f5f5", display: "flex", justifyContent: "space-between", alignItems: "center" }}>
          Intimation Letter Preview
          <IconButton onClick={() => setIsPreviewing(false)}>
            <CloseIcon />
          </IconButton>
        </DialogTitle>
        
        <DialogContent dividers>
          <Box
            sx={{
              width: "100%",
              minHeight: "500px",
              p: 3,
              border: "1px solid #ddd",
              overflow: "auto",
              overflowWrap: "break-word",
              bgcolor: "white",
            }}
            dangerouslySetInnerHTML={{ __html: templateContent }}
          />
        </DialogContent>
        
        <DialogActions sx={{ p: 2, bgcolor: "#f5f5f5" }}>
          <Button onClick={() => setIsPreviewing(false)}>Close</Button>
          <Button variant="contained" onClick={handleSave}>
            Save Changes
          </Button>
        </DialogActions>
      </Dialog>
      
      <Snackbar
        open={sbar.isOpen}
        autoHideDuration={6000}
        onClose={() => setSbar({ isOpen: false, Msg: "" })}
        message={sbar.Msg}
      />
    </>
  );
};

export default EmailTemplate;
