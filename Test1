import { useState, useEffect, useRef } from "react";
import {
  Snackbar,
  IconButton,
  Button,
  Divider,
  Dialog,
  DialogTitle,
  DialogContent,
  Paper,
  Typography,
  Grid,
  Card,
  CardContent,
  CardHeader,
  List,
  ListItem,
  ListItemIcon,
  ListItemText,
} from "@mui/material";
import { Box, styled } from "@mui/system";
import DialogActions from "@mui/material/DialogActions";
import CloseIcon from "@mui/icons-material/Close";
import InfoIcon from "@mui/icons-material/Info";
import AddCircleOutlineIcon from '@mui/icons-material/AddCircleOutline';
import ReactQuill from "react-quill";
import Quill from "quill";
import "react-quill/dist/quill.snow.css";
import "./quill.css";
import axios from "axios";
import { encrypt } from "../../Security/AES-GCM256";
import ImageResize from "quill-image-resize-module-react";

// Quill formatting (no changes here)
var DirectionAttribute = Quill.import("attributors/attribute/direction");
Quill.register(DirectionAttribute, true);
var AlignClass = Quill.import("attributors/class/align");
Quill.register(AlignClass, true);
var BackgroundClass = Quill.import("attributors/class/background");
Quill.register(BackgroundClass, true);
var ColorClass = Quill.import("attributors/class/color");
Quill.register(ColorClass, true);
var DirectionClass = Quill.import("attributors/class/direction");
Quill.register(DirectionClass, true);
var FontClass = Quill.import("attributors/class/font");
Quill.register(FontClass, true);
var SizeClass = Quill.import("attributors/class/size");
Quill.register(SizeClass, true);
var AlignStyle = Quill.import("attributors/style/align");
Quill.register(AlignStyle, true);
var BackgroundStyle = Quill.import("attributors/style/background");
Quill.register(BackgroundStyle, true);
var ColorStyle = Quill.import("attributors/style/color");
Quill.register(ColorStyle, true);
var DirectionStyle = Quill.import("attributors/style/direction");
Quill.register(DirectionStyle, true);
var FontStyle = Quill.import("attributors/style/font");
Quill.register(FontStyle, true);
var SizeStyle = Quill.import("attributors/style/size");
Quill.register(SizeStyle, true);
const Size = Quill.import("formats/size");
Quill.register("modules/imageResize", ImageResize);
Size.whitelist = [
  "2px", "4px", "6px", "8px", "10px", "12px", "14px", "16px",
  "18px", "20px", "22px", "24px", "26px",
];
Quill.register(Size, true);
const Font = Quill.import("formats/font");
Font.whitelist = [
  "arial", "times-new-roman", "courier-new", "sans-serif", "serif",
  "monospace", "georgia", "tahoma", "verdana", "sofia",
];
Quill.register(Font, true);

// Register custom blot for invalid variables
const Inline = Quill.import('blots/inline');
class InvalidBlot extends Inline {
  static blotName = 'invalid-variable';
  static tagName = 'span';
  static className = 'invalid-variable';
}
Quill.register(InvalidBlot);


const iv = crypto.getRandomValues(new Uint8Array(12));
const ivBase64 = btoa(String.fromCharCode.apply(null, iv));
const salt = crypto.getRandomValues(new Uint8Array(16));
const saltBase64 = btoa(String.fromCharCode.apply(null, salt));

// Styled component for draggable variables to look like Chips
const DraggableVariable = styled("span")(({ theme, isediting }) => ({
  margin: theme.spacing(0.5),
  backgroundColor: isediting ? theme.palette.primary.main : theme.palette.grey[400],
  color: isediting ? theme.palette.primary.contrastText : theme.palette.getContrastText(theme.palette.grey[400]),
  padding: theme.spacing(0.5, 1.5),
  cursor: isediting ? "move" : "not-allowed",
  borderRadius: "16px",
  fontWeight: "bold",
  boxShadow: theme.shadows[2],
  transition: "background-color 0.3s ease, box-shadow 0.3s ease",
  display: "inline-block",
  "&:hover": {
    boxShadow: isediting ? theme.shadows[4] : theme.shadows[2],
  },
}));

const EmailTemplate = () => {
  const [headerContent, setHeaderContent] = useState("Non-editable header will appear here");
  const [bodyContent, setBodyContent] = useState("Editable body will appear here");
  const [sbar, setSbar] = useState({ isOpen: false, Msg: "" });
  const [wordCount, setWordCount] = useState(0);
  const [isEditing, setIsEditing] = useState(false);
  const [isPreviewing, setIsPreviewing] = useState(false);
  const [templateContent, settemplateContent] = useState(null);
  const [lastState, setLastState] = useState(null); // For undo reset

  const draftVar = [
    "{{DATE}}", "{{REF_NO}}", "{{FIRM_NAME}}", "{{FRN_NO}}",
    "{{FIRM_ADDR}}", "{{ASSIGNMENT_TYPE}}", "{{GSTN}}",
  ];

  const instructions = [
      "Special characters are not allowed.",
      "Only use allowed variables from the list.",
      "Header section is non-editable and non-copyable.",
      "Body section is editable when in edit mode.",
      "Maximum word limit: 2000 words.",
  ];

  const bodyEditorRef = useRef(null);

  const modules = {
    toolbar: [
      [{ font: Font.whitelist }],
      [{ size: ["8px", "10px", "12px", "14px", "16px", "18px", "20px", "22px", "24px", "26px"] }],
      [{ color: ["red", "green", "blue", "black", "orange"] }, { background: ["red", "green", "blue", "yellow", "gray"] }],
      [{ align: "justify" }, { align: "center" }, { align: "right" }],
      [{ script: "sub" }, { script: "super" }],
      [{ header: [1, 2, 3, false] }],
      [{ list: "ordered" }, { list: "bullet" }],
      ["bold", "italic", "underline", "strike"],
      ["link", "image", "clean"],
      [{ indent: "-1" }, { indent: "+1" }],
    ],
    clipboard: { matchVisual: false },
    imageResize: { modules: ["Resize", "DisplaySize"] },
  };

  useEffect(() => {
    fetchData();
  }, []);

  // Autosave functionality
  useEffect(() => {
    if (!isEditing) return;

    const handler = setTimeout(() => {
      handleSave(true); // Pass true for autosave
    }, 3000); // 3-second delay

    return () => {
      clearTimeout(handler);
    };
  }, [bodyContent, isEditing]);


  const fetchData = async () => {
    try {
      const response = await axios.post("Server/IAMServices/EmailTemplate", {}, {
        headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
      });
      let res = response.data.result;
      let str = "EMPANELMENT OF THE FIRM INTIMATION</h4>";
      const splitIndex = res.indexOf(str) + str.length;

      if (splitIndex > str.length - 1) {
        setHeaderContent(res.substring(0, splitIndex));
        setBodyContent(res.substring(splitIndex));
      } else {
        setHeaderContent(res);
        setBodyContent("");
      }
      setWordCount(countWord(res));
    } catch (e) {
      console.log(e);
    }
  };

  function countWord(str) {
    const text = str.replace(/<[^>]*>/g, "");
    return text.trim().split(/\s+/).filter(Boolean).length;
  }

  const handleBodyChange = (content, delta, source, editor) => {
    if (source === 'api') return;
    
    const quillEditor = bodyEditorRef.current?.getEditor();
    if (!quillEditor) return;

    let htmlContent = quillEditor.getHTML();
    let textContent = quillEditor.getText();
    let length = countWord(htmlContent);

    // --- Inline Variable Validation ---
    const allVars = textContent.match(/\{{2}[A-Z_]+\}{2}/g) || [];
    quillEditor.formatText(0, textContent.length, 'invalid-variable', false, 'silent'); // Clear previous formatting
    allVars.forEach(variable => {
      if (!draftVar.includes(variable)) {
        let match;
        const regex = new RegExp(variable.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&'), 'g');
        while ((match = regex.exec(textContent)) !== null) {
          quillEditor.formatText(match.index, variable.length, 'invalid-variable', true, 'silent');
        }
      }
    });

    const insertedOp = delta.ops?.find((op) => typeof op.insert === "string");
    if (insertedOp) {
      const inserted = insertedOp.insert;
      const len = inserted.length;
      const illegalChar = inserted.match(/[^a-zA-Z0-9_\s.,\/\\;!?'"()\{\}\-@]/);
      if (illegalChar) {
        setTimeout(() => {
          if (quillEditor) {
            const selection = quillEditor.getSelection();
            let position = selection?.index - (getSelection()?.toString().length > 0 ? 0 : len) || quillEditor.getLength();
            quillEditor.deleteText(position, len, "silent");
          }
        }, 10);
        setSbar({ isOpen: true, Msg: "❌ Special characters are not allowed!" });
      }
    }

    if (length > 2000) {
      if (quillEditor) {
        const selection = quillEditor.getSelection();
        let position = selection?.index || quillEditor.getLength();
        quillEditor.deleteText(position - 1, 1, "silent");
        setSbar({ isOpen: true, Msg: "Word limit exceeded. Please reduce content." });
        return;
      }
    }
    setBodyContent(htmlContent);
    setWordCount(length);
  };

  const handleDragStart = (e) => {
    const text = e.target.innerText;
    e.dataTransfer.setData("text/plain", text);
  };

  const handleDrop = (e) => {
    e.preventDefault();
    if (!isEditing) return;
    const editor = bodyEditorRef.current?.getEditor();
    if (!editor) return;
    const range = editor.getSelection(true);
    if (range) {
      editor.insertText(range.index, e.dataTransfer.getData("text/plain"));
    }
  };

  const insertVariable = (variable) => {
    const editor = bodyEditorRef.current?.getEditor();
    if (editor && isEditing) {
      const range = editor.getSelection(true) || { index: editor.getLength() };
      editor.insertText(range.index, variable, 'user');
      editor.focus();
    } else if (!isEditing) {
      setSbar({ isOpen: true, Msg: "Please enable Edit mode to add variables." });
    }
  };

  const handleSave = async (isAutosave = false) => {
    if (!isEditing && !isAutosave) {
        setIsEditing(false);
    }
    
    const fullContent = headerContent + bodyContent;
    let str = fullContent.match(/\{{2}[A-Z_]+\}{2}/g);
    let checked = str?.filter((w) => draftVar.some((s) => s === w));

    if (str != null && str.length > checked.length) {
      if (!isAutosave) {
        setSbar({
          isOpen: true,
          Msg: "Invalid Variable Names found! Please fix them before saving.",
        });
        handleCloseDialog();
      }
      return;
    }

    let dataToSend = { MASTER_TEMPLATE: `<html>${fullContent}</html>` };
    try {
      let jsonFormData = JSON.stringify(dataToSend);
      let encryptedData = await encrypt(iv, salt, jsonFormData);
      let payload = {
        iv: ivBase64,
        salt: saltBase64,
        data: encryptedData,
      };
      const response = await axios.post("Server/IAMServices/saveMasterTemplate", payload, {
        headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
      });
      if (response.data.statusCode === 200 && !isAutosave) {
        setSbar({ isOpen: true, Msg: "✅ Saved Successfully!" });
      } else if (isAutosave) {
        console.log("Draft autosaved.");
      }
    } catch (error) {
      console.error("Error saving template:", error);
      if (!isAutosave) setSbar({ isOpen: true, Msg: "❌ Error saving template." });
    }

    if (!isAutosave) {
        setIsPreviewing(false);
        handleCloseDialog();
    }
  };

  const handlePreview = async () => {
    const fullContent = headerContent + bodyContent;
    let data = {
      DATE: "xx/xx/xxxx", REF_NO: "9999xxx", FIRM_NAME: "xxxxxxxxxx",
      FRN_NO: "999999999", GSTN: "99xx99xx", FIRM_ADDR: "xxxxxxxx, xxxxxxxx",
      ASSIGNMENT_TYPE: "xxxxxxx",
    };
    let str = fullContent.replace(/<br\s*\/?>/gi, "<br></br>");
    let StrToSend = str.replace(/\{{2}([A-Z_]+)\}{2}/g, (match, p1) => data[p1] || match);
    settemplateContent(StrToSend);
    setIsPreviewing(true);
  };

  const handleCloseDialog = () => setIsPreviewing(false);

  const handleReset = async () => {
    setLastState({ header: headerContent, body: bodyContent }); // Save current state for undo
    try {
      const response = await axios.post("Server/IAMServices/resetTemplate", {}, {
        headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
      });
      let res = response.data.result;
      let str = "EMPANELMENT OF THE FIRM INTIMATION</h4>";
      const splitIndex = res.indexOf(str) + str.length;
      if (splitIndex > str.length - 1) {
        setHeaderContent(res.substring(0, splitIndex));
        setBodyContent(res.substring(splitIndex));
      } else {
        setHeaderContent(res);
        setBodyContent("");
      }
      setSbar({ isOpen: true, Msg: "🔄 Template has been reset." });
    } catch (e) {
      console.error("Error resetting template:", e);
      setSbar({ isOpen: true, Msg: "❌ Error resetting template." });
    }
  };
  
  const handleUndoReset = () => {
    if (lastState) {
      setHeaderContent(lastState.header);
      setBodyContent(lastState.body);
      setLastState(null);
      setSbar({ isOpen: true, Msg: "Undo successful." });
    }
  };

  const handleHeaderCopy = (e) => {
    e.preventDefault();
    setSbar({ isOpen: true, Msg: "❌ Copying from the header is not allowed!" });
  };

  return (
    <Box sx={{ p: 3, backgroundColor: "#f4f6f8", minHeight: "100vh" }}>
      <Typography gutterBottom variant="h4" component="div" sx={{ mb: 2, fontWeight: '600' }}>
        Empanelment Intimation Letter Template
      </Typography>
      <Divider sx={{ mb: 3 }} />
      <Grid container spacing={3}>
        <Grid item xs={12} md={4}>
          <Grid container direction="column" spacing={3}>
            <Grid item>
              <Card elevation={3}>
                <CardHeader title="Available Variables" subheader="Drag or click the icon to add" />
                <CardContent>
                  {draftVar.map((label) => (
                    <Box key={label} sx={{ display: 'inline-flex', alignItems: 'center', mr: 1, mb: 1 }}>
                        <DraggableVariable
                          draggable={isEditing}
                          onDragStart={handleDragStart}
                          isediting={isEditing ? 1 : 0}
                        >
                          {label}
                        </DraggableVariable>
                        <IconButton
                            size="small"
                            onClick={() => insertVariable(label)}
                            aria-label={`Insert ${label} variable`}
                            disabled={!isEditing}
                            sx={{ ml: 0.5, p: 0.2 }}
                        >
                            <AddCircleOutlineIcon fontSize="small" />
                        </IconButton>
                    </Box>
                  ))}
                </CardContent>
              </Card>
            </Grid>
            <Grid item>
              <Card elevation={3}>
                <CardHeader title="Instructions" />
                <CardContent sx={{ pt: 0 }}>
                    <List dense>
                        {instructions.map((text, index) => (
                            <ListItem key={index} sx={{ py: 0 }}>
                                <ListItemIcon sx={{minWidth: '32px'}}><InfoIcon fontSize="small" color="primary"/></ListItemIcon>
                                <ListItemText primary={text} />
                            </ListItem>
                        ))}
                    </List>
                </CardContent>
              </Card>
            </Grid>
          </Grid>
        </Grid>
        <Grid item xs={12} md={8}>
          <Card elevation={3}>
            <CardHeader title="Template Draft" />
            <CardContent>
              <Typography variant="subtitle1" sx={{ mb: 1, fontWeight: "500" }}>
                Intimation Letter Header (Non-Editable)
              </Typography>
              <Box
                onCopy={handleHeaderCopy}
                sx={{
                  bgcolor: "#f5f5f5", p: 1, mb: 2, border: "1px solid #e0e0e0", borderRadius: 1,
                  "& .ql-editor": { padding: "12px 0" },
                }}
              >
                <ReactQuill
                  theme="bubble"
                  value={headerContent}
                  readOnly={true}
                  modules={{ toolbar: false }}
                />
              </Box>

              <Typography variant="subtitle1" sx={{ mb: 1, fontWeight: "500" }}>
                Intimation Body (Editable)
              </Typography>
              <Box
                sx={{
                  border: "1px solid #e0e0e0", borderRadius: 1,
                  "& .ql-toolbar": { borderBottom: "1px solid #e0e0e0", borderRadius: "4px 4px 0 0" },
                  "& .ql-container": { border: "none" },
                  "& .ql-editor": { minHeight: "250px" },
                }}
              >
                <div onDragOver={(e) => e.preventDefault()} onDrop={handleDrop}>
                  <ReactQuill
                    theme="snow"
                    modules={modules}
                    value={bodyContent}
                    ref={bodyEditorRef}
                    onChange={handleBodyChange}
                    readOnly={!isEditing}
                  />
                </div>
              </Box>
              <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mt: 2 }}>
                 <Typography variant="caption" color="textSecondary">
                    Word Count: {wordCount} / 2000
                </Typography>
                <Box>
                  {!isEditing ? (
                    <Button variant="contained" onClick={() => setIsEditing(true)} sx={{ mr: 1 }}>
                      Edit
                    </Button>
                  ) : (
                    <Button variant="outlined" color="error" onClick={() => setIsEditing(false)} sx={{ mr: 1 }}>
                      Cancel
                    </Button>
                  )}
                  <Button variant="contained" color="secondary" onClick={handlePreview} sx={{ mr: 1 }}>
                    Preview
                  </Button>
                  <Button variant="outlined" color="secondary" onClick={handleReset} sx={{ mr: lastState ? 1 : 0}}>
                    Reset
                  </Button>
                  {lastState && (
                     <Button variant="outlined" color="primary" onClick={handleUndoReset}>
                        Undo
                     </Button>
                  )}
                </Box>
              </Box>
            </CardContent>
          </Card>
        </Grid>
      </Grid>

      <Dialogue
        open={isPreviewing}
        close={handleCloseDialog}
        save={() => handleSave(false)} // Explicitly call save without autosave flag
        content={templateContent}
      />

      <Snackbar
        open={sbar.isOpen}
        autoHideDuration={4000}
        onClose={() => setSbar({ isOpen: false, Msg: "" })}
        message={sbar.Msg}
        anchorOrigin={{ vertical: 'bottom', horizontal: 'right' }}
      />
    </Box>
  );
};

const BootstrapDialog = styled(Dialog)(({ theme }) => ({
  "& .MuiDialogContent-root": {
    padding: theme.spacing(2),
    backgroundColor: '#f0f0f0',
  },
  "& .MuiDialogActions-root": {
    padding: theme.spacing(1),
  },
}));
const Dialogue = ({ open, close, save, content }) => {
  return (
    <BootstrapDialog
      onClose={close}
      open={open}
      fullWidth
      maxWidth="lg"
    >
      <DialogTitle sx={{ m: 0, p: 2 }}>
        Intimation Letter Draft Preview
        <IconButton
          aria-label="close"
          onClick={close}
          sx={{ position: "absolute", right: 8, top: 8, color: (theme) => theme.palette.grey[500] }}
        >
          <CloseIcon />
        </IconButton>
      </DialogTitle>
      <DialogContent dividers>
        <Paper
            elevation={0}
            dangerouslySetInnerHTML={{ __html: content }}
            sx={{
                width: "210mm",
                minHeight: "297mm",
                margin: "0 auto",
                padding: "20mm",
                boxSizing: "border-box",
                backgroundColor: "#ffffff",
                overflowWrap: "break-word",
            }}
        />
      </DialogContent>
      <DialogActions>
        <Button onClick={close}>Cancel</Button>
        <Button variant="contained" autoFocus onClick={save}>
          Save Draft
        </Button>
      </DialogActions>
    </BootstrapDialog>
  );
};

export default EmailTemplate;
