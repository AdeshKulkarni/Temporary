import { useState, useEffect, useRef } from "react";
import {
  Snackbar,
  IconButton,
  Button,
  Divider,
  Dialog,
  DialogTitle,
  DialogContent,
  Paper,
  Typography,
  Grid,
  Container,
} from "@mui/material";
import { Box, styled } from "@mui/system";
import DialogActions from "@mui/material/DialogActions";
import CloseIcon from "@mui/icons-material/Close";
import ReactQuill from "react-quill";
import Quill from "quill";
import "react-quill/dist/quill.snow.css";
import "./quill.css";
import axios from "axios";
import { encrypt } from "../../Security/AES-GCM256";
import ImageResize from "quill-image-resize-module-react";

// Register Quill modules
Quill.register("modules/imageResize", ImageResize);

const iv = crypto.getRandomValues(new Uint8Array(12));
const ivBase64 = btoa(String.fromCharCode.apply(null, iv));
const salt = crypto.getRandomValues(new Uint8Array(16));
const saltBase64 = btoa(String.fromCharCode.apply(null, salt));

const EmailTemplate = () => {
  // Initial states
  const [headerContent, setHeaderContent] = useState("");
  const [bodyContent, setBodyContent] = useState("");
  const [sbar, setSbar] = useState({ isOpen: false, Msg: "" });
  const [wordCount, setWordCount] = useState(0);
  const [isEditing, setIsEditing] = useState(false);
  const [isPreviewing, setIsPreviewing] = useState(false);
  const [templateContent, settemplateContent] = useState(null);

  const draftVar = [
    "{{DATE}}",
    "{{REF_NO}}",
    "{{FIRM_NAME}}",
    "{{FRN_NO}}",
    "{{FIRM_ADDR}}",
    "{{ASSIGNMENT_TYPE}}",
    "{{GSTN}}",
  ];

  const bodyEditorRef = useRef(null);
  const headerEditorRef = useRef(null);

  // Configure Quill modules
  const modules = {
    toolbar: [
      [{ font: ["arial", "times-new-roman", "courier-new", "sans-serif", "serif", "monospace", "georgia", "tahoma", "verdana", "sofia"] }],
      [{ size: ["8px", "10px", "12px", "14px", "16px", "18px", "20px", "22px", "24px", "26px"] }],
      [{ color: ["red", "green", "blue", "black", "orange"] }, { background: ["red", "green", "blue", "yellow", "gray"] }],
      [{ align: "justify" }, { align: "center" }, { align: "right" }],
      [{ script: "sub" }, { script: "super" }],
      [{ header: [1, 2, 3, false] }],
      [{ list: "ordered" }, { list: "bullet" }],
      ["bold", "italic", "underline", "strike"],
      ["link", "image", "clean"],
      [{ indent: "-1" }, { indent: "+1" }],
    ],
    clipboard: {
      matchVisual: false,
    },
    imageResize: {
      modules: ["Resize", "DisplaySize"],
    },
  };

  useEffect(() => {
    fetchData();
  }, []);

  const fetchData = async () => {
    try {
      const response = await axios.post(
        "Server/IAMServices/EmailTemplate",
        {},
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      const res = response.data.result;
      updateContent(res);
    } catch (e) {
      console.error("Error fetching template:", e);
      setSbar({
        isOpen: true,
        Msg: "Failed to load template",
      });
    }
  };

  function updateContent(res) {
    // Split template into header and body sections
    const splitIndex = res.indexOf("Dear Sir/Madam");
    if (splitIndex !== -1) {
      setHeaderContent(res.substring(0, splitIndex));
      setBodyContent(res.substring(splitIndex));
    } else {
      setHeaderContent(res);
      setBodyContent("");
    }
    setWordCount(countWord(res));
  }

  function countWord(str) {
    if (!str) return 0;
    const text = str.replace(/<[^>]*>/g, "");
    const words = text.trim().split(/\s+/).filter(Boolean);
    return words.length;
  }

  const handleBodyChange = (content, delta, source, editor) => {
    if (source !== "user") return;

    const htmlContent = editor.getHTML();
    const textContent = editor.getText();
    const length = countWord(textContent);

    // Validate inserted text only
    const insertedOp = delta.ops?.find((op) => typeof op.insert === "string");
    if (insertedOp) {
      const inserted = insertedOp.insert;
      const illegalChar = inserted.match(/[^a-zA-Z0-9_\s.,;!?'"()\{\}\-@]/);

      if (illegalChar) {
        setTimeout(() => {
          const quillEditor = bodyEditorRef.current?.getEditor();
          if (quillEditor) {
            const selection = quillEditor.getSelection();
            const position = selection?.index || quillEditor.getLength();
            quillEditor.deleteText(position - inserted.length, inserted.length, "silent");
          }
        }, 10);
        setSbar({
          isOpen: true,
          Msg: "❌ Special characters are not allowed!",
        });
        return;
      }
    }

    // Word limit validation
    if (length > 2000) {
      setSbar({
        isOpen: true,
        Msg: "Word limit exceeded. Please reduce content.",
      });
      return;
    }

    setBodyContent(htmlContent);
    setWordCount(length);
  };

  const handleDragStart = (e) => {
    const text = e.target.innerText;
    e.dataTransfer.setData("text", text);
  };

  const handleDrop = (e) => {
    e.preventDefault();
    if (!isEditing) return;

    const editor = bodyEditorRef.current?.getEditor();
    if (!editor) return;

    const range = editor.getSelection(true);
    if (range) {
      editor.insertText(range.index, e.dataTransfer.getData("text"));
    }
  };

  const handleSave = async () => {
    setIsEditing(false);
    const fullContent = headerContent + bodyContent;

    // Validate template variables
    const variables = fullContent.match(/\{{2}[A-Z_]+\}{2}/g) || [];
    const invalidVars = variables.filter(v => !draftVar.includes(v));
    
    if (invalidVars.length > 0) {
      setSbar({
        isOpen: true,
        Msg: "Invalid variables detected. Please use only allowed variables.",
      });
      setIsPreviewing(false);
      return;
    }

    const dataToSend = { MASTER_TEMPLATE: `<html>${fullContent}</html>` };
    try {
      let jsonFormData = JSON.stringify(dataToSend);
      await encrypt(iv, salt, jsonFormData).then(function (result) {
        jsonFormData = result;
      });
      const payload = {
        iv: ivBase64,
        salt: saltBase64,
        data: jsonFormData,
      };
      
      const response = await axios.post(
        "Server/IAMServices/saveMasterTemplate",
        payload,
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      
      if (response.data.statusCode === 200) {
        setSbar({
          isOpen: true,
          Msg: "Saved Successfully!",
        });
      }
    } catch (error) {
      console.error("Error saving template:", error);
      setSbar({
        isOpen: true,
        Msg: "Failed to save template",
      });
    }
    setIsPreviewing(false);
  };

  const handlePreview = () => {
    const fullContent = headerContent + bodyContent;
    const data = {
      DATE: "xx/xx/xxxx",
      REF_NO: "9999xxx",
      FIRM_NAME: "xxxxxxxxxx",
      FRN_NO: "999999999",
      GSTN: "99xx99xx",
      FIRM_ADDR: "xxxxxxxx,xxxxxxxx",
      ASSIGNMENT_TYPE: "xxxxxxx",
    };

    let StrToSend = fullContent.replace(/\{{2}([A-Z_]+)\}{2}/g, (match, p1) => {
      return data[p1] || match;
    });

    settemplateContent(StrToSend);
    setIsPreviewing(true);
  };

  const handleCloseDialog = () => {
    setIsPreviewing(false);
  };

  const handleReset = async () => {
    try {
      const response = await axios.post(
        "Server/IAMServices/resetTemplate",
        {},
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      updateContent(response.data.result);
      setSbar({
        isOpen: true,
        Msg: "Template reset successfully",
      });
    } catch (e) {
      console.error("Error resetting template:", e);
      setSbar({
        isOpen: true,
        Msg: "Failed to reset template",
      });
    }
  };

  const handleHeaderCopy = (e) => {
    e.preventDefault();
    setSbar({
      isOpen: true,
      Msg: "❌ Copying from non-editable section is not allowed!",
    });
  };

  return (
    <>
      <Typography gutterBottom variant="h5" component="div">
        Empanelment Intimation Letter Template
      </Typography>
      <Divider />
      <Grid container spacing={2} sx={{ p: 2 }}>
        <Grid item xs={12} md={4}>
          <Box
            sx={{
              height: "100%",
              width: "100%",
              borderRadius: 2,
              boxShadow: 2,
            }}
          >
            <Paper sx={{ height: "48%", mb: "30px", p: 2 }}>
              <Typography variant="h6">
                Drag Required Variables and Drop into letter draft.
              </Typography>
              <Divider sx={{ my: 1 }} />
              <Box sx={{ display: "flex", flexWrap: "wrap" }}>
                {draftVar.map((label) => (
                  <Box
                    key={label}
                    draggable={isEditing}
                    onDragStart={handleDragStart}
                    sx={{
                      m: 1,
                      bgcolor: "#0c476e",
                      px: 1.5,
                      py: 0.5,
                      cursor: "move",
                      borderRadius: "4px",
                      color: "white",
                      fontWeight: "bold",
                      boxShadow: 1,
                      "&:hover": {
                        bgcolor: "#0a3a5a",
                      },
                    }}
                  >
                    {label}
                  </Box>
                ))}
              </Box>
            </Paper>
            <Paper sx={{ height: "48%", p: 2 }}>
              <Typography variant="h6">Instructions</Typography>
              <Divider sx={{ my: 1 }} />
              <Box component="ul" sx={{ pl: 3, mb: 0 }}>
                <li>Special characters are not allowed</li>
                <li>Only use allowed variables from the list</li>
                <li>Header section is non-editable and non-copyable</li>
                <li>Body section is editable when in edit mode</li>
                <li>Maximum word limit: 2000 words</li>
              </Box>
            </Paper>
          </Box>
        </Grid>
        <Grid item xs={12} md={8}>
          <Box
            sx={{
              width: "100%",
              bgcolor: "background.default",
              borderRadius: 2,
              boxShadow: 2,
            }}
          >
            <Typography variant="h6" sx={{ p: 2 }}> Draft</Typography>
            <Divider />
            <Paper sx={{ p: 2 }}>
              {/* Non-editable Header Section */}
              <Box
                sx={{
                  bgcolor: "#f5f5f5",
                  p: 2,
                  mb: 2,
                  border: "1px solid #e0e0e0",
                  borderRadius: "4px",
                }}
                onCopy={handleHeaderCopy}
              >
                <Typography variant="subtitle2" sx={{ mb: 1, color: "#666" }}>
                  Non-editable Header
                </Typography>
                <ReactQuill
                  theme="bubble"
                  value={headerContent}
                  ref={headerEditorRef}
                  readOnly={true}
                  modules={{ toolbar: false }}
                  formats={[]}
                />
              </Box>

              {/* Editable Body Section */}
              <Box
                sx={{
                  bgcolor: "#fff",
                  p: 2,
                  border: "1px solid #e0e0e0",
                  borderRadius: "4px",
                }}
              >
                <Typography variant="subtitle2" sx={{ mb: 1 }}>
                  Editable Body
                </Typography>
                <Box
                  sx={{ height: "40vh", overflowY: "auto" }}
                  onDragover={(e) => e.preventDefault()}
                  onDrop={handleDrop}
                >
                  <ReactQuill
                    theme="snow"
                    modules={modules}
                    value={bodyContent}
                    ref={bodyEditorRef}
                    onChange={handleBodyChange}
                    readOnly={!isEditing}
                    formats={[
                      "size",
                      "align",
                      "color",
                      "font",
                      "bold",
                      "italic",
                      "underline",
                      "strike",
                      "list",
                      "bullet",
                      "link",
                      "image",
                      "background",
                      "header",
                      "script",
                      "indent",
                    ]}
                  />
                </Box>
              </Box>

              <Divider sx={{ my: 2 }} />
              <Box sx={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                <Typography variant="body2" color="textSecondary">
                  Word Count: {wordCount} / 2000
                </Typography>
                <Box>
                  {!isEditing ? (
                    <Button
                      variant="contained"
                      color="primary"
                      onClick={() => setIsEditing(true)}
                      sx={{ mr: 1 }}
                    >
                      Edit
                    </Button>
                  ) : (
                    <Button
                      variant="contained"
                      color="error"
                      onClick={() => setIsEditing(false)}
                      sx={{ mr: 1 }}
                    >
                      Cancel
                    </Button>
                  )}
                  <Button
                    variant="contained"
                    color="info"
                    onClick={handlePreview}
                    sx={{ mr: 1 }}
                    disabled={wordCount === 0}
                  >
                    Preview
                  </Button>
                  <Button 
                    variant="contained" 
                    color="info" 
                    onClick={handleReset}
                  >
                    Reset Template
                  </Button>
                </Box>
              </Box>
            </Paper>
          </Box>
        </Grid>
      </Grid>
      
      {/* Preview Dialog */}
      <PreviewDialog
        open={isPreviewing}
        close={handleCloseDialog}
        save={handleSave}
        content={templateContent}
      />

      <Snackbar
        open={sbar.isOpen}
        autoHideDuration={6000}
        onClose={() => setSbar({ isOpen: false, Msg: "" })}
        message={sbar.Msg}
      />
    </>
  );
};

const PreviewDialog = ({ open, close, save, content }) => {
  return (
    <Dialog
      open={open}
      onClose={close}
      fullWidth
      maxWidth="md"
      sx={{
        "& .MuiDialog-paper": {
          borderRadius: "8px",
          overflow: "hidden",
        },
      }}
    >
      <DialogTitle sx={{ m: 0, p: 2, bgcolor: "#f5f5f5" }}>
        Intimation letter draft preview
        <IconButton
          aria-label="close"
          onClick={close}
          sx={{
            position: "absolute",
            right: 8,
            top: 8,
            color: "grey.500",
          }}
        >
          <CloseIcon />
        </IconButton>
      </DialogTitle>
      <DialogContent dividers>
        <Box
          sx={{
            width: "210mm",
            minHeight: "297mm",
            margin: "0 auto",
            p: "20mm",
            bgcolor: "white",
            border: "1px solid #ddd",
            boxShadow: "0 0 10px rgba(0,0,0,0.1)",
            overflow: "auto",
            overflowWrap: "break-word",
          }}
          dangerouslySetInnerHTML={{ __html: content }}
        />
      </DialogContent>
      <DialogActions sx={{ p: 2, bgcolor: "#f5f5f5" }}>
        <Button variant="contained" onClick={close} sx={{ mr: 1 }}>
          Close
        </Button>
        <Button variant="contained" color="primary" onClick={save}>
          Save Draft
        </Button>
      </DialogActions>
    </Dialog>
  );
};

export default EmailTemplate;
