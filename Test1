package com.tcs.fincore.MOCService.Service;

import jakarta.persistence.EntityManager;
import jakarta.persistence.PersistenceContext;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;
import jakarta.transaction.Transactional;

@Service
@RequiredArgsConstructor
public class SequenceService {

    // 1. Inject the EntityManager directly
    @PersistenceContext
    private EntityManager entityManager;

    /**
     * Pads the given number with leading zeros to a total length of 7.
     * 1 -> "0000001"
     * 899 -> "0000899"
     */
    private String padToSevenDigits(Long id) {
        if (id == null) {
            throw new IllegalStateException("Sequence query returned null");
        }
        return String.format("%07d", id);
    }

    /**
     * Gets the next BATCH_ID from the sequence and formats it.
     * We add @Transactional to allow the query to run.
     */
    @Transactional
    public String getNextBatchId() {
        // 2. Run the native query
        // We cast to Number for safety, as Oracle returns BigDecimal
        Number nextId = (Number) entityManager.createNativeQuery("select BATCH_SEQ.nextval from dual")
                .getSingleResult();
        
        return padToSevenDigits(nextId.longValue());
    }

    /**
     * Gets the next JOURNAL_ID prefix from the sequence and formats it.
     */
    @Transactional
    public String getNextJournalIdPrefix() {
        // 3. Run the native query
        Number nextId = (Number) entityManager.createNativeQuery("select JRNL_SEQ.nextval from dual")
                .getSingleResult();
        
        return padToSevenDigits(nextId.longValue());
    }
}
