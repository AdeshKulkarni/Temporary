// Quill formatting setup
const setupQuillFormats = () => {
  const DirectionAttribute = Quill.import("attributors/attribute/direction");
  Quill.register(DirectionAttribute, true);
  
  const formats = [
    { type: "class", name: "align", import: "attributors/class/align" },
    { type: "class", name: "background", import: "attributors/class/background" },
    { type: "class", name: "color", import: "attributors/class/color" },
    { type: "class", name: "direction", import: "attributors/class/direction" },
    { type: "class", name: "font", import: "attributors/class/font" },
    { type: "class", name: "size", import: "attributors/class/size" },
    { type: "style", name: "align", import: "attributors/style/align" },
    { type: "style", name: "background", import: "attributors/style/background" },
    { type: "style", name: "color", import: "attributors/style/color" },
    { type: "style", name: "direction", import: "attributors/style/direction" },
    { type: "style", name: "font", import: "attributors/style/font" },
    { type: "style", name: "size", import: "attributors/style/size" },
  ];

  formats.forEach(({ type, name, import: importPath }) => {
    const Klass = Quill.import(importPath);
    Quill.register(Klass, true);
  });

  const Size = Quill.import("formats/size");
  Size.whitelist = ["8px", "10px", "12px", "14px", "16px", "18px", "20px", "22px", "24px", "26px"];
  Quill.register(Size, true);

  const Font = Quill.import("formats/font");
  Font.whitelist = [
    "arial", "times-new-roman", "courier-new", "sans-serif", 
    "serif", "monospace", "georgia", "tahoma", "verdana", "sofia"
  ];
  Quill.register(Font, true);
};

setupQuillFormats();

