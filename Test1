import React, { useState, useEffect } from "react";
import {
  Button,
  Box,
  Paper,
  Typography,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Checkbox,
  Divider,
  CircularProgress
} from "@mui/material";
import { DataGrid, GridToolbar } from "@mui/x-data-grid";
import PreviewIcon from "@mui/icons-material/Preview";
import { Container } from "@mui/system";
import axios from "axios";
import { encrypt } from "../Security/AES-GCM256";

const iv = crypto.getRandomValues(new Uint8Array(12)); // for encryption
const ivBase64 = btoa(String.fromCharCode.apply(null, iv)); // for decryption
const salt = crypto.getRandomValues(new Uint8Array(16)); // for encryption
const saltBase64 = btoa(String.fromCharCode.apply(null, salt)); // for decryption

const WorkFlow = () => {
  const [selectedRows, setSelectedRows] = useState([]);
  const [previewData, setPreviewData] = useState(null);
  const [displayList, setDisplayList] = useState(false);
  const [rows, setRows] = useState([]);
  const [loading, setLoading] = useState(true);
  const [templateContent, setTemplateContent] = useState('');
  const [templateLoading, setTemplateLoading] = useState(false);

  useEffect(() => {
    const fetchData = async () => {
      let dataToSend = { EMPANELMENT_TYPE: "SA" };
      try {
        let jsonFormData = JSON.stringify(dataToSend);
        const encryptedData = await encrypt(iv, salt, jsonFormData);
        const payload = {
          iv: ivBase64,
          salt: saltBase64,
          data: encryptedData,
        };

        const response = await axios.post(
          "Server/IAMServices/getActiveFRN",
          payload,
          {
            headers: {
              Authorization: `Bearer ${localStorage.getItem("token")}`,
            },
          }
        );

        const resData = response.data;
        
        if (resData.statusCode === 200) {
          const formattedData = resData.result.map((item, index) => ({
            id: index + 1,
            serial: index + 1,
            frn: item.FRN,
            firmName: item.FIRM_NAME,
            empanelmentType: item.EMPANELMENT_TYPE,
            empanelmentSubType: item.EMPANELMENT_SUB_TYPE,
            empaneledStatus: item.EMPANELED_STATUS,
            empaneledBy: item.EMPANELED_BY,
          }));
          setRows(formattedData);
        } else {
          console.error("API Error:", resData.message);
        }
      } catch (e) {
        console.error("Fetch Error:", e);
      } finally {
        setLoading(false);
      }
    };

    fetchData();
  }, []);

  const handleRowPreview = async (rowData) => {
    setPreviewData(rowData);
    setTemplateLoading(true);
    setTemplateContent('');

    try {
      const templateData = {
        user: { template: "Hi " },
        data: {
          DATE: new Date().toLocaleDateString(),
          REF_NO: "1001",
          FIRM_NAME: rowData.firmName,
          FRN_NO: rowData.frn,
          GSTN: "27AAHCK850D1ZK",
          FIRM_ADDR: "NAVI MUMBAI, BELPAUR",
          ASSIGNMENT_TYPE: `${rowData.empanelmentType}, ${rowData.empanelmentSubType}`
        }
      };

      let jsonFormData = JSON.stringify(templateData);
      const encryptedData = await encrypt(iv, salt, jsonFormData);
      const payload = {
        iv: ivBase64,
        salt: saltBase64,
        data: encryptedData,
      };

      const response = await axios.post(
        "Server/IAMServices/genarateTemplate",
        payload,
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );

      if (response.data.statusCode === 200) {
        setTemplateContent(response.data.result);
      } else {
        console.error("Template API Error:", response.data.message);
        setTemplateContent("Error generating template");
      }
    } catch (e) {
      console.error("Template Fetch Error:", e);
      setTemplateContent("Error generating template");
    } finally {
      setTemplateLoading(false);
    }
  };

  const handleClosePreview = () => {
    setPreviewData(null);
    setTemplateContent('');
  };

  const handleSelectRow = (id) => {
    setSelectedRows((prev) =>
      prev.includes(id) ? prev.filter((rowId) => rowId !== id) : [...prev, id]
    );
  };

  const handleSelectAll = () => {
    if (selectedRows.length === rows.length) {
      setSelectedRows([]);
    } else {
      setSelectedRows(rows.map((row) => row.id));
    }
  };

  const columns = [
    {
      field: "selected",
      headerName: "Select",
      width: 80,
      renderHeader: () => (
        <Checkbox
          checked={selectedRows.length === rows.length}
          indeterminate={
            selectedRows.length > 0 && selectedRows.length < rows.length
          }
          onChange={handleSelectAll}
        />
      ),
      renderCell: (params) => (
        <Checkbox
          checked={selectedRows.includes(params.row.id)}
          onChange={() => handleSelectRow(params.row.id)}
        />
      ),
    },
    { field: "serial", headerName: "Sr. No", width: 80 },
    { field: "frn", headerName: "FRN", width: 200 },
    { field: "firmName", headerName: "Firm Name", width: 250 },
    { field: "empanelmentType", headerName: "Empanelment Type", width: 180 },
    {
      field: "empanelmentSubType",
      headerName: "Empanelment Sub Type",
      width: 250,
    },
    { field: "empaneledStatus", headerName: "Status", width: 130 },
    {
      field: "actions",
      headerName: "Actions",
      width: 270,
      sortable: false,
      filterable: false,
      renderCell: (params) => (
        <div>
          <Button
            variant="outlined"
            color="primary"
            size="small"
            startIcon={<PreviewIcon />}
            onClick={() => handleRowPreview(params.row)}
            sx={{
              mr: 1,
              textTransform: "none",
              "&:hover": {
                backgroundColor: "primary.light",
              },
            }}
          >
            Preview
          </Button>
          <Button
            variant="contained"
            color="success"
            size="small"
            onClick={() => console.log("Approve", params.row)}
            sx={{
              mr: 1,
              textTransform: "none",
              "&:hover": {
                backgroundColor: "success.dark",
              },
            }}
          >
            Approve
          </Button>
          <Button
            variant="contained"
            color="error"
            size="small"
            onClick={() => console.log("Reject", params.row)}
            sx={{
              textTransform: "none",
              "&:hover": {
                backgroundColor: "error.dark",
              },
            }}
          >
            Reject
          </Button>
        </div>
      ),
    },
  ];

  return (
    <Box sx={{ p: 3, overflow: "hidden" }}>
      <Typography variant="h6" gutterBottom sx={{ mb: 2 }}>
        Empanelment Authorisation
      </Typography>
      <Divider />
      <Container sx={{ mt: 2, textAlign: "center" }}>
        <span>Select Financial Year </span>
        <select>
          <option value="2025">24-25</option>
          <option value="2025">23-24</option>
          <option value="2025">22-23</option>
        </select>
        <br />
        <Button
          sx={{ m: 5 }}
          variant="contained"
          size="large"
          onClick={() => setDisplayList(true)}
        >
          List 1
        </Button>
        <Button
          variant="contained"
          size="large"
          onClick={() => setDisplayList(false)}
        >
          List 2
        </Button>
      </Container>
      {displayList && (
        <Paper elevation={3} sx={{ mt: 2, p: 3, borderRadius: 2 }}>
          <Box sx={{ height: 500, width: "100%", overflow: "auto" }}>
            <DataGrid
              rows={rows}
              columns={columns}
              loading={loading}
              getRowId={(row) => row.id}
              disableColumnMenu
              hideFooterSelectedRowCount
              components={{
                Toolbar: GridToolbar,
              }}
              componentsProps={{
                toolbar: {
                  showQuickFilter: true,
                  quickFilterProps: { debounceMs: 500 },
                },
              }}
              sx={{
                "& .MuiDataGrid-cell": {
                  fontSize: "0.75rem",
                },
                "& .MuiDataGrid-columnHeader": {
                  fontSize: "0.9rem",
                  fontWeight: "bold",
                },
              }}
            />
          </Box>
        </Paper>
      )}

      <Dialog
        open={!!previewData}
        onClose={handleClosePreview}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle>
          Firm Letter Preview: {previewData?.firmName}
        </DialogTitle>

        <DialogContent dividers>
          {templateLoading ? (
            <Box sx={{ display: 'flex', justifyContent: 'center', py: 4 }}>
              <CircularProgress />
              <Typography variant="body1" sx={{ ml: 2 }}>
                Generating template...
              </Typography>
            </Box>
          ) : templateContent ? (
            <Box sx={{ 
              p: 2, 
              whiteSpace: 'pre-line',
              fontFamily: 'monospace',
              fontSize: '0.9rem',
              border: '1px solid #eee',
              borderRadius: 1,
              minHeight: 300
            }}>
              {templateContent}
            </Box>
          ) : (
            <Typography variant="body1" sx={{ textAlign: 'center', py: 4 }}>
              No template content available
            </Typography>
          )}
        </DialogContent>

        <DialogActions>
          <Button
            onClick={handleClosePreview}
            color="primary"
            variant="contained"
          >
            Close
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
};

export default WorkFlow;
