import { useState, useEffect, useRef, useCallback } from "react";
import {
  Snackbar,
  IconButton,
  Button,
  Divider,
  Dialog,
  DialogTitle,
  DialogContent,
  Paper,
  Typography,
  Grid,
  Container,
} from "@mui/material";
import { Box, styled } from "@mui/system";
import DialogActions from "@mui/material/DialogActions";
import CloseIcon from "@mui/icons-material/Close";
import ReactQuill from "react-quill";
import Quill from "quill";
import "react-quill/dist/quill.snow.css";
import "./quill.css";
import axios from "axios";
import { encrypt } from "../../Security/AES-GCM256";
import PdfViewer from "../../PdfViewer/pdfViewer";

// Quill formatting setup
const registerQuillFormats = () => {
  const DirectionAttribute = Quill.import("attributors/attribute/direction");
  Quill.register(DirectionAttribute, true);
  const AlignClass = Quill.import("attributors/class/align");
  Quill.register(AlignClass, true);
  const BackgroundClass = Quill.import("attributors/class/background");
  Quill.register(BackgroundClass, true);
  const ColorClass = Quill.import("attributors/class/color");
  Quill.register(ColorClass, true);
  const DirectionClass = Quill.import("attributors/class/direction");
  Quill.register(DirectionClass, true);
  const FontClass = Quill.import("attributors/class/font");
  Quill.register(FontClass, true);
  const SizeClass = Quill.import("attributors/class/size");
  Quill.register(SizeClass, true);
  const AlignStyle = Quill.import("attributors/style/align");
  Quill.register(AlignStyle, true);
  const BackgroundStyle = Quill.import("attributors/style/background");
  Quill.register(BackgroundStyle, true);
  const ColorStyle = Quill.import("attributors/style/color");
  Quill.register(ColorStyle, true);
  const DirectionStyle = Quill.import("attributors/style/direction");
  Quill.register(DirectionStyle, true);
  const FontStyle = Quill.import("attributors/style/font");
  Quill.register(FontStyle, true);
  const SizeStyle = Quill.import("attributors/style/size");
  Quill.register(SizeStyle, true);
  
  const Size = Quill.import("formats/size");
  Size.whitelist = [
    "2px", "4px", "6px", "8px", "10px", "12px", "14px", 
    "16px", "18px", "20px", "22px", "24px", "26px"
  ];
  Quill.register(Size, true);
  
  const Font = Quill.import("formats/font");
  Font.whitelist = [
    "arial", "times-new-roman", "courier-new", "sans-serif", 
    "serif", "monospace", "georgia", "tahoma", "verdana", "sofia"
  ];
  Quill.register(Font, true);
};

registerQuillFormats();

const iv = crypto.getRandomValues(new Uint8Array(12));
const ivBase64 = btoa(String.fromCharCode.apply(null, iv));
const salt = crypto.getRandomValues(new Uint8Array(16));
const saltBase64 = btoa(String.fromCharCode.apply(null, salt));

const EmailTemplate = () => {
  const [value, setValue] = useState("Draft will appear here");
  const [sbar, setSbar] = useState({ isOpen: false, Msg: "" });
  const [wordCount, setWordCount] = useState(0);
  const editorRef = useRef();
  const [isEditing, setIsEditing] = useState(false);
  const [isPreviewing, setIsPreviewing] = useState(false);
  const [templateContent, settemplateContent] = useState(null);

  const draftVar = [
    "{{DATE}}",
    "{{REF_NO}}",
    "{{FIRM_NAME}}",
    "{{FRN_NO}}",
    "{{FIRM_ADDR}}",
    "{{ASSIGNMENT_TYPE}}",
    "{{GSTN}}",
  ];

  const MAX_WORD_LIMIT = 2000;

  const countWords = useCallback((html) => {
    if (!html) return 0;
    const text = html.replace(/<[^>]*>/g, " "); // Replace HTML tags with space
    return text.trim().split(/\s+/).filter(word => word.length > 0).length;
  }, []);

  const sanitizePastedText = (text) => {
    const allowedCharsRegex = /[^a-zA-Z0-9\s.,;!?'"(){}@\-]/g;
    const sanitizedText = text.replace(allowedCharsRegex, "");
    return {
      text: sanitizedText,
      hadInvalidChars: sanitizedText.length !== text.length,
    };
  };

  const modules = {
    toolbar: [
      [{ font: Font.whitelist }],
      [{ size: ["8px", "10px", "12px", "14px", "16px", "18px", "20px", "22px", "24px", "26px"] }],
      [{ color: ["red", "green", "blue", "black", "orange"] }, { background: ["red", "green", "blue", "yellow", "gray"] }],
      [{ align: "justify" }, { align: "center" }, { align: "right" }],
      [{ script: "sub" }, { script: "super" }],
      [{ header: [1, 2, 3, false] }],
      [{ list: "ordered" }, { list: "bullet" }],
      ["bold", "italic", "underline", "strike"],
      ["link", "image", "clean"],
      [{ indent: "-1" }, { indent: "+1" }],
    ],
    clipboard: {
      matchVisual: false,
      matchers: [
        ["text", (node, delta) => {
          if (delta.ops?.length > 0) {
            const newOps = delta.ops.map((op) => {
              if (op.insert && typeof op.insert === "string") {
                const { text } = sanitizePastedText(op.insert);
                return { ...op, insert: text };
              }
              return op;
            });
            return { ops: newOps };
          }
          return delta;
        }]
      ]
    }
  };

  useEffect(() => {
    fetchData();
  }, []);

  useEffect(() => {
    if (!editorRef.current) return;

    const quill = editorRef.current.getEditor();

    const handleTextChange = () => {
      const text = quill.getText();
      const disallowedChars = /[^a-zA-Z0-9\s.,;!?'"(){}@\-]/g;
      const illegalChars = text.match(disallowedChars);

      if (illegalChars?.length > 0) {
        const selection = quill.getSelection();
        const sanitizedText = text.replace(disallowedChars, "");

        quill.updateContents(quill.clipboard.convert(sanitizedText), "silent");

        if (selection) {
          setTimeout(() => {
            const newPosition = Math.min(selection.index, sanitizedText.length);
            quill.setSelection(newPosition, 0, "silent");
          }, 0);
        }

        setSbar({
          isOpen: true,
          Msg: "❌ Special characters were removed!",
        });
      }
    };

    const handlePaste = (e) => {
      e.preventDefault();
      const clipboardData = e.clipboardData || window.clipboardData;
      const pastedText = clipboardData.getData("text/plain");

      const { text: sanitizedText, hadInvalidChars } = sanitizePastedText(pastedText);

      if (hadInvalidChars) {
        setSbar({
          isOpen: true,
          Msg: "❌ Special characters were removed from pasted content!",
        });
      }

      const range = quill.getSelection();
      if (range) {
        quill.insertText(range.index, sanitizedText);
        quill.setSelection(range.index + sanitizedText.length, 0);
      }
    };

    quill.on("text-change", handleTextChange);
    quill.root.addEventListener("paste", handlePaste);

    return () => {
      quill.off("text-change", handleTextChange);
      quill.root.removeEventListener("paste", handlePaste);
    };
  }, []);

  const fetchData = async () => {
    try {
      const response = await axios.post(
        "Server/IAMServices/EmailTemplate",
        {},
        { headers: { Authorization: `Bearer ${localStorage.getItem("token")}` } }
      );
      const res = response.data.result;
      setValue(res);
      setWordCount(countWords(res));
    } catch (e) {
      console.error("Error fetching template:", e);
      setSbar({ isOpen: true, Msg: "Failed to load template" });
    }
  };

  const handleChange = (content, delta, source, editor) => {
    const html = editor.getHTML();
    const currentWordCount = countWords(html);
    
    if (currentWordCount > MAX_WORD_LIMIT) {
      setSbar({
        isOpen: true,
        Msg: `Word limit exceeded (${MAX_WORD_LIMIT} words max). Please reduce content.`,
      });
      return;
    }
    
    setValue(html);
    setWordCount(currentWordCount);
  };

  const handleDragStart = (e) => {
    if (!isEditing) return;
    const text = e.target.innerText;
    e.dataTransfer.setData("text", text);
  };

  const handleDrop = (e) => {
    if (!isEditing) return;
    e.preventDefault();
    const range = editorRef.current.editor?.getSelection(true);
    if (range) {
      editorRef.current.editor.insertText(range.index, e.dataTransfer.getData("text"));
    }
  };

  const validateVariables = (content) => {
    const variables = content.match(/\{{2}[A-Z_]+\}{2}/g) || [];
    const invalidVars = variables.filter(v => !draftVar.includes(v));
    return invalidVars.length === 0;
  };

  const handleSave = async () => {
    if (!validateVariables(value)) {
      setSbar({
        isOpen: true,
        Msg: "Invalid variable names detected. Please use only the provided variables.",
      });
      return;
    }

    const wordCount = countWords(value);
    if (wordCount > MAX_WORD_LIMIT) {
      setSbar({
        isOpen: true,
        Msg: `Content exceeds word limit (${wordCount}/${MAX_WORD_LIMIT}). Please reduce content before saving.`,
      });
      return;
    }

    try {
      const dataToSend = { MASTER_TEMPLATE: `<html>${value}</html>` };
      let jsonFormData = JSON.stringify(dataToSend);
      
      await encrypt(iv, salt, jsonFormData).then(result => {
        jsonFormData = result;
      });

      const payload = {
        iv: ivBase64,
        salt: saltBase64,
        data: jsonFormData,
      };

      const response = await axios.post(
        "Server/IAMServices/saveMasterTemplate",
        payload,
        { headers: { Authorization: `Bearer ${localStorage.getItem("token")}` } }
      );

      if (response.data.statusCode === 200) {
        setSbar({ isOpen: true, Msg: "Template saved successfully!" });
        setIsPreviewing(false);
      }
    } catch (error) {
      console.error("Error saving template:", error);
      setSbar({ isOpen: true, Msg: "Failed to save template" });
    }
  };

  const handlePreview = () => {
    if (!validateVariables(value)) {
      setSbar({
        isOpen: true,
        Msg: "Cannot preview with invalid variables. Please correct them first.",
      });
      return;
    }

    const previewData = {
      DATE: "xx/xx/xxxx",
      REF_NO: "9999xxx",
      FIRM_NAME: "xxxxxxxxxx",
      FRN_NO: "999999999",
      GSTN: "99xx99xx",
      FIRM_ADDR: "xxxxxxxx,xxxxxxxx",
      ASSIGNMENT_TYPE: "xxxxxxx",
    };

    let processedContent = value.replace(/<br\s*\/?>/gi, "<br></br>");
    processedContent = processedContent.replace(
      /\{{2}([A-Z_]+)\}{2}/g, 
      (match, p1) => previewData[p1] || match
    );

    settemplateContent(processedContent);
    setIsPreviewing(true);
  };

  const handleReset = async () => {
    try {
      const response = await axios.post(
        "Server/IAMServices/resetTemplate",
        {},
        { headers: { Authorization: `Bearer ${localStorage.getItem("token")}` } }
      );
      const res = response.data.result;
      setValue(res);
      setWordCount(countWords(res));
      setSbar({ isOpen: true, Msg: "Template reset to default" });
    } catch (e) {
      console.error("Error resetting template:", e);
      setSbar({ isOpen: true, Msg: "Failed to reset template" });
    }
  };

  return (
    <>
      <Typography gutterBottom variant="h5" component="div">
        Empanelment Intimation Letter Template
      </Typography>
      <Divider />
      <Grid container spacing={2} sx={{ p: 2 }}>
        <Grid item xs={14} md={4}>
          <Box sx={{ height: "100%", width: "100%", borderRadius: 2, boxShadow: 2 }}>
            <Paper sx={{ height: "48%", mb: "30px" }}>
              <Typography variant="h6">
                Drag Required Variables and Drop into template draft.
              </Typography>
              <hr />
              {draftVar.map((label) => (
                <span
                  key={label}
                  draggable={isEditing}
                  onDragStart={handleDragStart}
                  style={{
                    margin: 10,
                    backgroundColor: "#0c476e",
                    padding: "5px 8px",
                    cursor: isEditing ? "move" : "default",
                    borderRadius: "3px",
                    color: "white",
                    fontWeight: "bold",
                    boxShadow: "0 4px 8px rgba(0, 0, 0, 0.2)",
                    transition: "background-color 0.3s ease",
                    display: "inline-block",
                    opacity: isEditing ? 1 : 0.6,
                  }}
                >
                  {label}
                </span>
              ))}
            </Paper>
            <Paper sx={{ height: "48%" }}>
              <Typography variant="h6" ml="2">
                Instructions
              </Typography>
              <hr />
              <Container sx={{ ml: 3 }}>
                <li>Special characters are not allowed</li>
                <li>Maximum word limit: {MAX_WORD_LIMIT} words</li>
                <li>Use only the provided variables</li>
                <li>Formatting will be preserved in the final output</li>
              </Container>
            </Paper>
          </Box>
        </Grid>
        <Grid item xs={12} md={8}>
          <Box sx={{ width: "100%", bgcolor: "background.default", borderRadius: 2, boxShadow: 2 }}>
            <Typography variant="h6">Template Draft</Typography>
            <hr />
            <Paper sx={{ padding: 2 }}>
              <div style={{ height: "55vh", overflowY: "auto" }}>
                <ReactQuill
                  style={{ height: "500px" }}
                  theme="snow"
                  modules={modules}
                  value={value}
                  ref={editorRef}
                  onDragOver={(e) => e.preventDefault()}
                  onDrop={handleDrop}
                  formats={[
                    "size", "align", "color", "font", "bold", "italic", 
                    "underline", "strike", "list", "bullet", "link", "image", 
                    "background", "header", "script", "indent"
                  ]}
                  onChange={handleChange}
                  readOnly={!isEditing}
                />
              </div>
              <hr />
              <Box sx={{ mt: 2, textAlign: "right" }}>
                <Typography variant="body2" color="textSecondary" sx={{ mt: 2, textAlign: "left" }}>
                  Word Count: {wordCount} / {MAX_WORD_LIMIT}
                  {wordCount > MAX_WORD_LIMIT && (
                    <span style={{ color: "red", marginLeft: "10px" }}>
                      (Limit exceeded!)
                    </span>
                  )}
                </Typography>
                {!isEditing ? (
                  <Button
                    variant="contained"
                    color="primary"
                    onClick={() => setIsEditing(true)}
                    sx={{ mr: 1 }}
                  >
                    Edit
                  </Button>
                ) : (
                  <Button
                    variant="contained"
                    color="error"
                    onClick={() => setIsEditing(false)}
                    sx={{ mr: 1 }}
                  >
                    Cancel
                  </Button>
                )}
                <Button
                  variant="contained"
                  color="info"
                  onClick={handlePreview}
                  sx={{ mr: 1 }}
                  disabled={wordCount > MAX_WORD_LIMIT}
                >
                  Preview
                </Button>
                <Button variant="contained" color="info" onClick={handleReset}>
                  Reset Template
                </Button>
              </Box>
            </Paper>
          </Box>
        </Grid>
      </Grid>
      
      <PreviewDialog 
        open={isPreviewing}
        onClose={() => setIsPreviewing(false)}
        onSave={handleSave}
        content={templateContent}
      />

      <Snackbar
        open={sbar.isOpen}
        autoHideDuration={6000}
        onClose={() => setSbar({ isOpen: false, Msg: "" })}
        message={sbar.Msg}
      />
    </>
  );
};

const PreviewDialog = ({ open, onClose, onSave, content }) => {
  return (
    <Dialog
      open={open}
      onClose={onClose}
      aria-labelledby="preview-dialog-title"
      fullWidth
      maxWidth="md"
    >
      <DialogTitle sx={{ m: 0, p: 2 }} id="preview-dialog-title">
        Intimation letter draft preview
      </DialogTitle>
      <IconButton
        aria-label="close"
        onClick={onClose}
        sx={(theme) => ({
          position: "absolute",
          right: 8,
          top: 8,
          color: theme.palette.grey[500],
        })}
      >
        <CloseIcon />
      </IconButton>
      <DialogContent dividers>
        <div
          style={{
            width: "210mm",
            minHeight: "297mm",
            margin: "0 auto",
            padding: "20mm",
            boxShadow: "0 0 10px rgba(0, 0, 0, 0.1)",
            boxSizing: "border-box",
            backgroundColor: "#ffffff",
            border: "1px solid #ddd",
            overflow: "auto",
            overflowWrap: "break-word",
          }}
          dangerouslySetInnerHTML={{ __html: content }}
        />
      </DialogContent>
      <DialogActions>
        <Button autoFocus onClick={onSave}>
          Save Draft
        </Button>
      </DialogActions>
    </Dialog>
  );
};

export default EmailTemplate;
