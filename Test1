-- Create the CURRENCY_RATE_CHANGE table
CREATE TABLE CURRENCY_RATE_CHANGE (
    id                NUMBER GENERATED ALWAYS AS IDENTITY,
    currency_code     VARCHAR2(3)  NOT NULL,
    currency_rate     NUMBER(19, 9) NOT NULL,
    rate_change_date  DATE NOT NULL,
    CONSTRAINT pk_crc_id PRIMARY KEY (id)
);
 
-- Add comments to the table and columns
COMMENT ON TABLE CURRENCY_RATE_CHANGE IS 'Stores the historical exchange rate changes for various currencies.';
 
COMMENT ON COLUMN CURRENCY_RATE_CHANGE.id IS 'Primary key, a unique identifier for each rate change record.';
 
COMMENT ON COLUMN CURRENCY_RATE_CHANGE.currency_code IS 'The three-letter ISO currency code (e.g., USD, EUR).';
 
COMMENT ON COLUMN CURRENCY_RATE_CHANGE.currency_rate IS 'The exchange rate value for the specified currency.';
 
COMMENT ON COLUMN CURRENCY_RATE_CHANGE.rate_change_date IS 'The date on which the exchange rate was recorded.';
