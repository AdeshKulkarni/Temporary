import {
  Card,
  CardContent,
  Stack,
  Typography,
  Box,
  Paper,
  Button,
} from "@mui/material";
import React, { useState, useEffect } from "react";
import { useNavigate } from "react-router-dom";
import { Container, styled } from "@mui/system";

// Icon imports
import SpeedIcon from "@mui/icons-material/Speed";
import BusinessIcon from "@mui/icons-material/Business";
import HelpOutlineIcon from "@mui/icons-material/HelpOutline";
import LockOpenIcon from "@mui/icons-material/LockOpen";
import UploadFileIcon from "@mui/icons-material/UploadFile";
import RuleIcon from "@mui/icons-material/Rule";
import AssignmentIndIcon from "@mui/icons-material/AssignmentInd";
import MailOutlineIcon from "@mui/icons-material/MailOutline";
import ManageAccountsIcon from "@mui/icons-material/ManageAccounts";
import ArticleIcon from "@mui/icons-material/Article";
import DomainVerificationIcon from "@mui/icons-material/DomainVerification";
import CalendarMonthIcon from "@mui/icons-material/CalendarMonth";
import CorporateFareIcon from "@mui/icons-material/CorporateFare";

const allActions = {
  IAM: {
    Role: "Internal Assignment Maker",
    Manage_Empanelment: "/ManageSAEmpanelment",
    Empanelment_Data: "/ViewFirmDetails",
    Firm_Requests: "/EmpReqManagement",
    PreEmpanelment_Checks: "/PreEmpanelment",
    Help: "/IamHelp",
  },
  IAC: {
    Role: "Internal Assignment Checker",
    Empanelment_Data: "/ViewFirmDetails",
    Requests: "/IamAuthoriseRequests",
    PreEmpanelment_Checks: "/PreEmpanelment",
    Template: "/EmailTemplate",
    Intimation: "/EmpanelmentIntimation",
    Help: "/IamHelp",
  },
  SAC: {
    Role: "Statutory Assignment Checker",
    Empanelment_Data: "/ViewFirmDetails",
    Firm_Requests: "/EmpReqManagement",
    PreEmpanelment_Checks: "/PreEmpanelment",
    Template: "/EmailTemplate",
    Intimation: "/EmpanelmentIntimation",
    Help: "/IamHelp",
  },
  SAM: {
    Role: "Statutory Assignment Maker",
    Manage_Empanelment: "/ManageSAEmpanelment",
    Empanelment_Data: "/ViewFirmDetails",
    Firm_Requests: "/EmpReqManagement",
    PreEmpanelment_Checks: "/PreEmpanelment",
    Help: "/IamHelp",
  },
  94: {
    Role: "FRT CHECKER",
    Access: "/IamAccessAssignment",
    Requests: "/IamAuthoriseRequests",
    Help: "/IamHelp",
  },
  96: {
    Role: "FRT_MAKER",
    Access: "/IamAccessAssignment",
    Requests: "/IamAuthoriseRequests",
    Help: "/IamHelp",
  },
  MAKER: { Role: "Branch Maker", Help: "/IamHelp" },
  CHECKER: { Role: "Branch Checker", Help: "/IamHelp" },
  Other: { Role: "General User", Help: "/IamHelp" },
};

const actionIcons = {
  View: <SpeedIcon color="primary" sx={{ fontSize: 40 }} />,
  Access: <LockOpenIcon color="primary" sx={{ fontSize: 40 }} />,
  Help: <HelpOutlineIcon color="primary" sx={{ fontSize: 40 }} />,
  Upload_Users: <UploadFileIcon color="primary" sx={{ fontSize: 40 }} />,
  Empanelment_Data: <BusinessIcon color="primary" sx={{ fontSize: 40 }} />,
  PreEmpanelment_Checks: <RuleIcon color="primary" sx={{ fontSize: 40 }} />,
  Requests: <DomainVerificationIcon color="primary" sx={{ fontSize: 40 }} />,
  Manage_Empanelment: (
    <ManageAccountsIcon color="primary" sx={{ fontSize: 40 }} />
  ),
  Assignment: <AssignmentIndIcon color="primary" sx={{ fontSize: 40 }} />,
  Firm_Requests: <ArticleIcon color="primary" sx={{ fontSize: 40 }} />,
  Template: <MailOutlineIcon color="primary" sx={{ fontSize: 40 }} />,
  Intimation: <MailOutlineIcon color="primary" sx={{ fontSize: 40 }} />,
  Default: <ArticleIcon color="primary" sx={{ fontSize: 40 }} />,
};

const formatActionName = (name) => name.replace(/_/g, " ");

const ActionPaper = styled(Paper)(({ theme }) => ({
  padding: theme.spacing(2),
  textAlign: "center",
  width: 180,
  height: 160,
  display: "flex",
  flexDirection: "column",
  justifyContent: "space-around",
  alignItems: "center",
  borderRadius: "12px",
  transition: "transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out",
  "&:hover": {
    transform: "translateY(-8px)",
    boxShadow: "0 6px 20px rgba(0,0,0,0.15)",
  },
}));

const InfoBlock = ({ label, value }) => (
  <Box sx={{ flex: 1, textAlign: "center", p: 1 }}>
    <Typography
      variant="caption"
      color="text.secondary"
      sx={{ display: "block", mb: 0.5, fontWeight: "bold" }}
    >
      {label}
    </Typography>
    <Typography
      variant="subtitle1"
      sx={{ fontWeight: "bold", color: "text.primary" }}
    >
      {value}
    </Typography>
  </Box>
);

const UserInfoLine = ({ label, value }) => (
  <Box sx={{ display: "flex", alignItems: "baseline", mb: 2.5 }}>
    <Typography
      variant="body2"
      sx={{
        fontWeight: "bold",
        color: "text.secondary",
        textTransform: "uppercase",
        width: "140px",
        flexShrink: 0,
      }}
    >
      {label}
    </Typography>
    <Typography
      variant="body1"
      color="text.primary"
      sx={{ mr: 1, fontWeight: "bold" }}
    >
      :
    </Typography>
    <Typography variant="body1" color="text.primary">
      {value}
    </Typography>
  </Box>
);

export default function IamView() {
  const [userData, setUserData] = useState(null);
  const [currentUserActions, setCurrentUserActions] = useState(null);
  const navigate = useNavigate();

  useEffect(() => {
    try {
      const storedData = localStorage.getItem("user");

      if (storedData) {
        const data = JSON.parse(storedData);
        setUserData(data);

        const accessRole = data.access;
        const userRole = data.user_role;
        let actions = allActions["Other"];

        if (
          accessRole === "SAC" ||
          accessRole === "SAM" ||
          accessRole === "IAC" ||
          accessRole === "IAM"
        ) {
          actions = allActions[accessRole];
        } else if (userRole === "94" || userRole === "96") {
          actions = allActions[userRole];
        } else if (allActions[userRole]) {
          actions = allActions[userRole];
        }

        setCurrentUserActions(actions);
      } else {
        console.warn(
          "No user data found in local storage. User might need to log in."
        );
      }
    } catch (error) {
      console.error("Failed to parse user data from local storage:", error);
    }
  }, []);

  if (!userData || !currentUserActions) {
    return <p>Loading user data...</p>;
  }

  const infoCardStyle = {
    flex: 1,
    borderRadius: "12px",
    boxShadow: "0 4px 12px rgba(0,0,0,0.1)",
    p: 1,
  };

  const staticCardStyle = {
    flex: 1,
    boxShadow: "0 4px 12px rgba(0,0,0,0.1)",
    borderRadius: "12px",
  };
    
  // ***MODIFICATION START***
  // Look up the full role name for the 'Access' field.
  // Uses optional chaining (?.) and a fallback (||) for safety.
  const displayedAccessRole = allActions[userData.access]?.Role || userData.access;
  // ***MODIFICATION END***

  return (
    <Container sx={{ mt: 3, mb: 3 }}>
      <Box sx={{ mb: 4 }}>
        <Typography variant="h4" sx={{ mb: 2, fontWeight: "normal" }}>
          Internal Module Assignment
        </Typography>
        <Stack direction={{ xs: "column", md: "row" }} spacing={3}>
          <Card sx={infoCardStyle}>
            <CardContent>
              <UserInfoLine
                label="User"
                value={`${userData.pf_number} - ${userData.first_name} ${userData.last_name}`}
              />
              <UserInfoLine label="Role" value={currentUserActions.Role} />
              <UserInfoLine
                label="Mobile Number"
                value={userData.mobile_number}
              />
              <UserInfoLine label="Email" value={userData.email_id} />
            </CardContent>
          </Card>

          <Card sx={infoCardStyle}>
            <CardContent>
              <UserInfoLine
                label="Branch"
                value={`${userData.branch_code} - ${userData.branch_name}`}
              />
              {/* ***MODIFICATION START*** */}
              {/* Display the full role name instead of just the code */}
              <UserInfoLine label="Access" value={displayedAccessRole} />
              {/* ***MODIFICATION END*** */}
            </CardContent>
          </Card>
        </Stack>
      </Box>

      <Stack direction={{ xs: "column", md: "row" }} spacing={3} sx={{ mb: 4 }}>
        <Card sx={staticCardStyle}>
          <CardContent>
            <Box sx={{ display: "flex", alignItems: "center", mb: 2 }}>
              <CalendarMonthIcon color="action" sx={{ mr: 1.5 }} />
              <Typography
                variant="h5"
                component="div"
                sx={{ fontWeight: "normal" }}
              >
                Current Financial Period
              </Typography>
            </Box>
            <Paper
              variant="outlined"
              sx={{ backgroundColor: "#fdfdff", borderRadius: "8px" }}
            >
              <Stack
                direction="row"
                spacing={1}
                justifyContent="space-around"
                sx={{ p: 1 }}
              >
                <InfoBlock
                  label="Financial Year"
                  value={userData.financial_year}
                />
                <InfoBlock label="Current Quarter" value={userData.quarter} />
                <InfoBlock
                  label="Quarter End Date"
                  value={userData.quarterEndDate}
                />
              </Stack>
            </Paper>
          </CardContent>
        </Card>

        <Card sx={staticCardStyle}>
          <CardContent>
            <Box sx={{ display: "flex", alignItems: "center", mb: 2 }}>
              <CorporateFareIcon color="action" sx={{ mr: 1.5 }} />
              <Typography
                variant="h5"
                component="div"
                sx={{ fontWeight: "normal" }}
              >
                Circle Information
              </Typography>
            </Box>
            <Paper
              variant="outlined"
              sx={{ backgroundColor: "#fdfdff", borderRadius: "8px" }}
            >
              <Stack
                direction="row"
                spacing={1}
                justifyContent="space-around"
                sx={{ p: 1 }}
              >
                <InfoBlock label="Circle Name" value={userData.circleName} />
                <InfoBlock label="Circle Code" value={userData.circleCode} />
              </Stack>
            </Paper>
          </CardContent>
        </Card>
      </Stack>

      <Card sx={staticCardStyle}>
        <CardContent>
          <Typography variant="h5" sx={{ mb: 3, fontWeight: "normal" }}>
            Quick Actions
          </Typography>
          <Stack
            direction="row"
            justifyContent={{ xs: "center", sm: "flex-start" }}
            sx={{ flexWrap: "wrap", gap: 2.5 }}
          >
            {currentUserActions &&
              Object.entries(currentUserActions)
                // Filter out the 'Role' property so it doesn't render as a card
                .filter(([name]) => name !== "Role")
                .map(([name, path]) => (
                  <ActionPaper key={name} elevation={2}>
                    {actionIcons[name] || actionIcons.Default}
                    <Typography variant="body1" sx={{ fontWeight: "medium" }}>
                      {formatActionName(name)}
                    </Typography>
                    <Button
                      variant="contained"
                      size="small"
                      onClick={() => navigate(path)}
                      sx={{ textTransform: "none", borderRadius: "16px" }}
                    >
                      Access Now
                    </Button>
                  </ActionPaper>
                ))}
          </Stack>
        </CardContent>
      </Card>
    </Container>
  );
}
