Understood! We will pull the description directly into the textbox itself by combining the code and the name in the input field. We will also add the "MEMO" indicator as a small badge sitting neatly inside the right side of the CGL textbox.
Here are the exact replacements for your **Branch** and **CGL** Autocomplete grids inside VoucherPosting.jsx.
### 1. Update the Branch Autocomplete
Replace your entire Grid item for **Branch** (around line 621) with this:
```javascript
                        {/* Branch */}
                        <Grid item size={{ xl: 1.5, lg: 2 }}>
                          <Autocomplete
                            autoHighlight
                            popupIcon={null}
                            options={
                              (branchInputValues[row.id] || "").length < 3
                                ? []
                                : (row.branch && !branchSearch.options.some((o) => o.code === row.branch.code)
                                  ? [row.branch, ...branchSearch.options]
                                  : branchSearch.options)
                            }
                            // SHOW CODE AND DESCRIPTION INSIDE THE TEXT BOX
                            getOptionLabel={(option) => option && option.code ? `${option.code} - ${option.name}` : ""}
                            // SHOW ELLIPSIS IN DROPDOWN
                            renderOption={(props, option) => (
                              <li {...props} key={option.code}>
                                <Typography noWrap sx={{ textOverflow: 'ellipsis', overflow: 'hidden', whiteSpace: 'nowrap' }}>
                                  {option.code} - {option.name}
                                </Typography>
                              </li>
                            )}
                            slotProps={{
                              popper: {
                                placement: 'bottom-start',
                                modifiers: [{ name: 'flip', enabled: false }, { name: 'preventOverflow', enabled: false }],
                              },
                            }}
                            value={row.branch || null}
                            onChange={(event, newValue) => handleRowChange(row.id, "branch", newValue)}
                            inputValue={branchInputValues[row.id] || ""}
                            onInputChange={(event, newInputValue, reason) => {
                              if (reason === 'input') {
                                const cleanInput = newInputValue.replace(BRANCH_REPLACE_REGEX, "").substring(0, 5);
                                setBranchInputValues(prev => ({ ...prev, [row.id]: cleanInput }));

                                let queryForSearch = cleanInput;
                                if (cleanInput.length > 0 && cleanInput.length <= 2) {
                                  queryForSearch = cleanInput.padStart(5, '0');
                                }

                                searchBranches(queryForSearch, row.id);
                              } else {
                                setBranchInputValues(prev => ({ ...prev, [row.id]: newInputValue }));
                              }
                            }}
                            onKeyDown={(e) => {
                              if (e.key === 'Tab' && !row.branch && branchSearch.options?.length > 0) {
                                handleRowChange(row.id, "branch", branchSearch.options[0]);
                              }
                            }}
                            onBlur={() => {
                              const typedValue = branchInputValues[row.id];
                              if (!row.branch && typedValue && typedValue.length === 5) {
                                const match = branchSearch.options.find(opt => opt.code === typedValue);
                                if (match) {
                                  handleRowChange(row.id, "branch", match);
                                }
                              }
                            }}
                            loading={branchSearch.loadingId === row.id}
                            filterOptions={(x) => x}
                            isOptionEqualToValue={(option, value) => option?.code === value?.code}
                            noOptionsText={
                              (branchInputValues[row.id] || "").length < 3
                                ? "Enter 3 Digits to Search"
                                : "No branches found"
                            }
                            renderInput={(params) => (
                              <Tooltip title={row.branch ? `${row.branch.code} - ${row.branch.name}` : "Search by Branch Code"} placement="top-start">
                                <TextField
                                  {...params}
                                  label="Branch *"
                                  placeholder="Select Branch"
                                  InputLabelProps={{ shrink: true }}
                                  // Prevents text from breaking out of the box
                                  inputProps={{ ...params.inputProps, style: { textOverflow: 'ellipsis', whiteSpace: 'nowrap', overflow: 'hidden' } }}
                                  InputProps={{
                                    ...params.InputProps,
                                    endAdornment: (
                                      <Box>
                                        {branchSearch.loadingId === row.id ? (<CircularProgress color="inherit" size={20} />) : null}
                                        {params.InputProps.endAdornment}
                                      </Box>
                                    )
                                  }}
                                  onPaste={(e) => { e.preventDefault(); showSnackBar("Pasting is not allowed here.", "warning"); }}
                                  onCopy={(e) => e.preventDefault()}
                                />
                              </Tooltip>
                            )}
                          />
                        </Grid>

