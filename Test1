    public ResponseEntity<List<Map<String, Object>>> getWorkflowSteps(
            @PathVariable @Pattern(regexp = "^[a-zA-Z0-9-_]{1,50}$", message = "Invalid Workflow format") String workflowCode) {
        return ResponseEntity.ok(queryService.getWorkflowSteps(workflowCode)); 
