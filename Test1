/**
 * ManageSAEmpanelment.jsx
 * Component to manage SA Empanelment actions such as Web form entry and Excel upload.
 *
 * @author V1010939
 */

import { useEffect, useMemo, useState } from "react";
import {
  Autocomplete,
  Box,
  Button,
  Dialog,
  DialogActions,
  DialogContent,
  DialogContentText,
  DialogTitle,
  Divider,
  InputAdornment,
  Paper,
  SpeedDial,
  SpeedDialAction,
  SpeedDialIcon,
  TextField,
  Typography,
} from "@mui/material";
import {
  KeyboardOutlined as KeyboardOutlinedIcon,
  FileUploadOutlined as FileUploadOutlinedIcon,
  DateRange as DateRangeIcon,
  FileDownloadOutlined as FileDownloadOutlinedIcon,
  Archive as ArchiveIcon,
  AccessTime as AccessTimeIcon,
  Close as CloseIcon,
} from "@mui/icons-material";
import { DataGrid } from "@mui/x-data-grid";
import * as XLSX from "xlsx";
import FirmDetails from "./FirmDetails";
import apiCaller from "../../apiCaller";
import useCustomSnackbar from "../../../Hooks/useCustomSnackbar";
import { useNavigate } from "react-router-dom";
import { saveAs } from "file-saver";

/**
 * Reusable Flex Center Utility
 */
const SET_CENTER = ({ x = "center", y = "center" } = {}) => ({
  display: "flex",
  justifyContent: x,
  alignItems: y,
});

/**
 * Reusable Main Paper
 */
const MAIN_PAPER = {
  height: 100,
  width: 200,
  "&:hover": {
    backgroundColor: "#E6E6E6",
    cursor: "pointer",
  },
};

const ACTIONS = [
  { icon: <FileUploadOutlinedIcon />, name: "Excel Upload" },
  { icon: <KeyboardOutlinedIcon />, name: "Web Form" },
];

export default function ManageSAEmpanelment() {
  document.title = "IAM | Manage Empanelment";
  const showSnackbar = useCustomSnackbar();
  const user = useMemo(() => JSON.parse(localStorage.getItem("user")), []);
  const navigate = useNavigate();

  const [childData, setChildData] = useState({ columns: [], rows: [] });
  const [firmTypeList, setFirmTypeList] = useState([]);
  const [empanelmentDetails, setEmpanelmentDetails] = useState({});
  const [period, setPeriod] = useState("2025-2026");
  const [part, setPart] = useState(false);
  const [assignmnetType, setAssignmentType] = useState("");
  const [assignmnetKeyType, setAssignmentKeyType] = useState("");
  const [loading, setLoading] = useState(false);
  const [dialogOpen, setDialogOpen] = useState(false);
  const [dialogAction, setDialogAction] = useState("view"); // or "edit", "add"
  const [selectedFirmDetails, setSelectedFirmDetails] = useState(null);
  const [errorMessage, setErrorMessage] = useState("No Rows Found");
  const [selectedId, setSelectedId] = useState(null);
  const [showAlert, setShowAlert] = useState(false);

  const isPAN = (pan) => /^[A-Z]{5}[0-9]{4}[A-Z]$/.test(pan);
  const isGSTIN = (gstin) =>
    /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}[Z]{1}[0-9A-Z]{1}$/.test(
      gstin
    );
  const isMobile = (num) => /^[6-9]\d{9}$/.test(num);
  const isPinCode = (pin) => /^\d{6}$/.test(pin);
  const isAlpha = (text) => /^[A-Za-z\s]+$/.test(text);
  const isOnlyNumbers = (val) => /^\d+$/.test(val);
  const isAlphanumeric = (val) => /^[A-Za-z0-9]+$/.test(val);
  const isAddress = (val) => /^[a-zA-Z0-9!{}:;=(),.:/\-_'\? ]+$/.test(val);

  const yearList = useMemo(() => {
    const currentYear = new Date().getFullYear();
    const currentFYStart =
      new Date().getMonth() >= 3 ? currentYear : currentYear - 1;
    return Array.from({ length: currentFYStart - 2024 }, (_, i) => {
      const year = 2025 + i;
      return `${year}-${year + 1}`;
    });
  }, []);

  // Fetch empanelment sub types
  useEffect(() => {
    (async () => {
      try {
        const { data, error } = await apiCaller(
          "GET",
          "/Server/empanelment/getEmpanelmentSubType"
        );
        if (error) return showSnackbar(error.data?.message, "warning");
        setFirmTypeList(data?.result || []);
      } catch (err) {
        console.error("Error fetching firm types:", err);
      }
    })();
  }, [showSnackbar]);

  const fetchActiveEmpanelments = async (type) => {
    setLoading(true);
    console.log(type);
    try {
      const { data, error } = await apiCaller(
        "POST",
        "/Server/empanelment/fetchActiveEmpanelments",
        { empSubType: type }
      );

      if (error || !data?.result) {
        showSnackbar(error?.data?.message || "Failed to fetch data", "error");
        return;
      }

      const rows = data.result || [];

      const formattedColumns = Object.keys(rows[0] || {}).map((key) => ({
        field: key,
        headerName: key.replaceAll("_", " ").toUpperCase(),
        flex: 1,
        headerAlign: "center",
      }));

      const formattedRows = rows.map((row, index) => ({
        id: index + 1,
        ...row,
      }));

      setChildData({
        columns: formattedColumns,
        rows: formattedRows,
      });

      showSnackbar(
        rows.length !== 0
          ? "Active Empanelments Loaded Successfully"
          : `No Active Empaneled Firms Found For ${period}`,
        rows.length !== 0 ? "success" : "warning"
      );
    } catch (err) {
      console.error("Error fetching active empanelments:", err);
      showSnackbar("Something went wrong!", "error");
    } finally {
      setLoading(false);
    }
  };

  // Handle Firm Type Card Click
  const handleTypeClick = async (type, id) => {
    setSelectedId(id);
    setAssignmentType(`${user?.access?.substring(0, 2)}-${type}`);
    setAssignmentKeyType(id);
    setEmpanelmentDetails({
      "Empaneled for": `${user?.access?.substring(0, 2)}-${type}-${id}`,
      "Empanelment Period": period,
      "Empanelment approved on": "",
      "Empanelment Approved By": "",
    });
    await fetchActiveEmpanelments(id).then(setPart(true));
  };

  // Handle Speed Dial Action
  const handleSpeedDialClick = (name) => {
    if (name === "Web Form") {
      setSelectedFirmDetails(null);
      setSelectedFirmDetails(empanelmentDetails);
      setDialogAction("add");
      setDialogOpen(true);
    } else if (name === "Excel Upload") {
      document.getElementById("excel-upload").click();
    }
  };

  const renameKeys = (dataList) => {
    const keyMap = {
      UCN: "UCNNO",
      "Firm Registration No.": "FRNNO",
      "Firm Name": "FIRM_NAME",
      "PAN NO.": "PAN_NO",
      "GSTIN NO.": "GSTNNO",
      "Address Line": "ADDRESS",
      City: "CITY",
      "State Name": "STATE",
      "District Name": "DISTRICT",
      "Pin Code": "PINCODE",
      "Type of Establishment": "FIRM_TYPE",
      "Primary Mobile No.": "MOBNO",
      "Point of Contact": "CONTACT_PERSON",
      "Point of Contact's Designation": "PODESIGNATION",
      "Point of Contact Email": "POC_EMAIL",
    };

    return dataList.map((row) => {
      const renamed = {};
      Object.entries(row).forEach(([key, value]) => {
        const newKey = keyMap[key] || key; // fallback to original if no mapping found
        renamed[newKey] = value;
      });

      renamed["REQUEST_EMPANELMENT_TYPE"] = assignmnetType.split("-")[0];
      renamed["REQUEST_EMPANELMENT_SUBTYPE"] = assignmnetKeyType;
      renamed["REQUEST_STATUS"] = "1";
      renamed["REQUEST_TYPE"] = "C";
      return renamed;
    });
  };

  // List of required headers (case-sensitive as in Excel)
  const REQUIRED_HEADERS = [
    "UCN",
    "Firm Registration No.",
    "Firm Name",
    "PAN NO.",
    "GSTIN NO.",
    "Address Line",
    "City",
    "State Name",
    "District Name",
    "Pin Code",
    "Primary Mobile No.",
    "Point of Contact",
    "Point of Contact's Designation",
    "Point of Contact Email",
    "Type of Establishment",
  ];

  //  Excel Upload Handler
  const handleExcelUpload = async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;

    const MAX_SIZE_MB = 5;
    const maxSizeBytes = MAX_SIZE_MB * 1024 * 1024;
    if (file.size > maxSizeBytes) {
      showSnackbar(
        `File size exceed: File size should not exceed more than ${MAX_SIZE_MB} MB`,
        "error"
      );
      e.target.value = null;
      return;
    }

    try {
      setLoading(true);
      const reader = new FileReader();

      reader.onload = async (evt) => {
        const excelData = new Uint8Array(evt.target.result);
        const workbook = XLSX.read(excelData, { type: "array" });
        const sheetName = workbook.SheetNames[0];
        const sheet = workbook.Sheets[sheetName];
        const rows = XLSX.utils.sheet_to_json(sheet);

        //  Header validation
        const actualHeaders = Object.keys(rows[0] || {});
        const missingHeaders = REQUIRED_HEADERS.filter(
          (header) => !actualHeaders.includes(header)
        );

        if (missingHeaders.length > 0) {
          showSnackbar(
            `Invalid Excel Format. Missing headers: ${missingHeaders.join(
              ", "
            )}`,
            "error"
          );
          setChildData({ columns: [], rows: [] });
          e.target.value = null;
          return;
        }

        const errors = [];
        const validRows = [];

        rows.forEach((row, index) => {
          const {
            rowNumber,
            isValid,
            errors: rowErrors,
          } = validateRow(row, index);

          if (isValid) {
            validRows.push(row);
          } else {
            errors.push({ row: rowNumber, issues: rowErrors });
          }
        });

        if (errors.length > 0) {
          console.error("Validation Errors", errors);
          showSnackbar(
            `${errors.length} row(s) have issues. Downloading Excel...`,
            "error"
          );
          exportInvalidRows(errors, rows);
          setLoading(false);
          return;
        } else {
          showSnackbar("All rows validated successfully!", "success");
        }

        const renamedRows = renameKeys(validRows);

        const { data, error } = await apiCaller(
          "POST",
          "/Server/empanelment/uploadExcelData",
          { firms: renamedRows }
        );

        if (error || !data?.result?.result) {
          setErrorMessage(data?.message || "FRN not found");
          showSnackbar(data?.message || "FRN not found", "error");
          setChildData({ columns: [], rows: [] });
        } else {
          setChildData({
            columns: Object.keys(rows[0] || {}).map((field) => ({
              field,
              headerName: field,
              flex: 1,
            })),
            rows: validRows.map((row, i) => ({ id: i + 1, ...row })),
          });
        }
      };

      reader.readAsArrayBuffer(file);
    } catch (e) {
      console.error(e);
      showSnackbar("An error occurred while processing the file.", "error");
      setChildData({ columns: [], rows: [] });
    } finally {
      setLoading(false);
      e.target.value = null; // Clear input
    }
  };

  //  Row Validation Function
  const validateRow = (row, index) => {
    const rowNumber = index + 2;
    const rowErrors = [];

    const {
      UCN: ucn,
      "Firm Registration No.": frn,
      "Firm Name": firmName,
      "PAN NO.": pan,
      "GSTIN NO.": gstin,
      "Address Line": address,
      City: city,
      "State Name": state,
      "District Name": district,
      "Pin Code": pin,
      "Primary Mobile No.": mobile,
      "Point of Contact": contactName,
      "Point of Contact's Designation": contactDesig,
      "Point of Contact Email": contactEmail,
      "Type of Establishment": establishment,
    } = row;

    if (!isOnlyNumbers(ucn)) rowErrors.push("UCN must be numbers only");
    if (!isAlphanumeric(frn))
      rowErrors.push("Firm Registration No. must be alphanumeric");
    if (!firmName?.trim()) rowErrors.push("Firm Name is required");
    if (!isPAN(pan)) rowErrors.push("Invalid PAN (alphanumeric only)");
    if (!isGSTIN(gstin)) rowErrors.push("Invalid GSTIN (alphanumeric only)");
    if (!isAddress(address))
      rowErrors.push("Address must contain only alphabets");
    if (!isAlpha(city)) rowErrors.push("City must contain only alphabets");
    if (!isAlpha(state)) rowErrors.push("State must contain only alphabets");
    if (!isAlpha(district))
      rowErrors.push("District must contain only alphabets");
    if (!isPinCode(pin)) rowErrors.push("Pin Code must be 6 digits");
    if (!isMobile(mobile)) rowErrors.push("Mobile number must be 10 digits");
    if (!isAlpha(contactName))
      rowErrors.push("Contact Name must contain only text");
    if (!isAlpha(contactDesig))
      rowErrors.push("Designation must contain only text");
    if (!contactEmail?.trim()) rowErrors.push("Contact Email is required");

    if (
      !["partnership firm", "proprietorship firm", "other"].includes(
        establishment?.toString().toLowerCase()
      )
    ) {
      rowErrors.push("Invalid Type of Establishment");
    }

    return { rowNumber, isValid: rowErrors.length === 0, errors: rowErrors };
  };

  // function to export invalid rows.
  const exportInvalidRows = (invalidRows, originalRows) => {
    const dataWithErrors = invalidRows.map(({ row, issues }) => {
      const originalRow = originalRows[row - 2]; // because header is row 1
      return {
        "Row Number": row,
        ...originalRow,
        Issues: issues.join("; "),
      };
    });

    const worksheet = XLSX.utils.json_to_sheet(dataWithErrors, {
      cellStyles: true,
    });
    const range = XLSX.utils.decode_range(worksheet["!ref"]);

    for (let R = range.s.r; R <= range.e.r; ++R) {
      for (let C = range.s.c; C <= range.e.c; ++C) {
        const cellAddress = { c: C, r: R };
        const cellRef = XLSX.utils.encode_cell(cellAddress);
        const cell = worksheet[cellRef];
        if (!cell) continue;

        // Add border to every cell
        cell.s = {
          border: {
            top: { style: "thin", color: { rgb: "000000" } },
            bottom: { style: "thin", color: { rgb: "000000" } },
            left: { style: "thin", color: { rgb: "000000" } },
            right: { style: "thin", color: { rgb: "000000" } },
          },
        };

        // Style "Row Number" and "Issues" columns with red font and yellow highlight
        const headerCell = worksheet[XLSX.utils.encode_cell({ r: 0, c: C })];
        const headerValue = headerCell?.v;

        if (headerValue === "Row Number" || headerValue === "Issues") {
          cell.s.font = { color: { rgb: "FF0000" }, bold: R === 0 };
          cell.s.fill = {
            fgColor: { rgb: "FFF2CC" }, // Light yellow background
          };
        }
      }
    }

    worksheet["!cols"] = Object.keys(dataWithErrors[0]).map(() => ({
      wch: 25,
    })); // Auto column width

    const workbook = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(workbook, worksheet, "Validation_Errors");
    XLSX.writeFile(workbook, "Invalid_Rows.xlsx");
  };

  const handleRowClick = (params) => {
    const rowData = params.row;
    setSelectedFirmDetails(rowData);
    setDialogAction("view");
    setDialogOpen(true);
  };

  const handleArchieveRequest = async () => {
    let renamedRows = {
      REQUEST_EMPANELMENT_TYPE:
        empanelmentDetails["Empaneled for"].split("-")[0],
      REQUEST_EMPANELMENT_SUBTYPE:
        empanelmentDetails["Empaneled for"].split("-")[2],
      REQUEST_TYPE: "A",
      REQUEST_STATUS: "1",
    };

    const { data, error } = await apiCaller(
      "POST",
      "/Server/empanelment/uploadExcelData",
      { firms: [renamedRows] }
    );

    if (error || !data?.result?.result) {
      setErrorMessage(data?.message || "FRN not found");
      showSnackbar(data?.message || "FRN not found", "error");
    } else {
      showSnackbar(
        `Archieved request raised for ${assignmnetType} for financial year ${period}`,
        "success"
      );
      setShowAlert(false);
    }
  };

  const alert = () => {
    setShowAlert(true);
  };

  const handleKeyDown = (event, type, id) => {
    if (event.key === "Enter" || event.key === " ") {
      event.preventDefault();
      handleTypeClick(type, id);
    }
  };

  /**
   * Downloads the data currently shown in a DataGrid as an Excel file.
   *
   * @param {Array} rows - The row data from the DataGrid.
   * @param {Array} columns - The column definitions from the DataGrid.
   * @param {string} fileName - The name of the downloaded Excel file.
   */
  const downloadExcelFromGrid = (
    rows,
    columns,
    fileName = "DataGrid_Export.xlsx"
  ) => {
    if (!rows?.length || !columns?.length) {
      console.warn("No data to export.");
      return;
    }

    // Build the header from column "headerName" or "field"
    const headers = columns.map((col) => col.headerName || col.field);

    // Create row data using column "field" mapping
    const data = rows.map((row) => columns.map((col) => row[col.field]));

    const worksheetData = [headers, ...data];
    const worksheet = XLSX.utils.aoa_to_sheet(worksheetData);
    const workbook = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(workbook, worksheet, "Sheet1");

    const excelBuffer = XLSX.write(workbook, {
      bookType: "xlsx",
      type: "array",
    });

    const blob = new Blob([excelBuffer], {
      type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    });

    saveAs(blob, fileName);
  };

  const handleDownload = () => {
    const link = document.createElement("a");
    link.href = `${process.env.PUBLIC_URL}/Assets/Docs/FirmDataTempelate.xlsx`;
    link.download = "FirmDataTempelate.xlsx";
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  return (
    <Box>
      <Typography variant="h5">Manage Empanelment</Typography>
      <Divider />

      {/* Period Selection */}
      <Box sx={SET_CENTER()}>
        <Autocomplete
          options={yearList}
          value={period}
          onChange={(_, value) => setPeriod(value || "")}
          sx={{ minWidth: 250 }}
          renderInput={(params) => (
            <TextField
              {...params}
              sx={{ background: "#FFFFFF", borderRadius: 1 }}
              variant="outlined"
              size="small"
              margin="normal"
              placeholder="Select Financial Year"
              InputProps={{
                ...params.InputProps,
                startAdornment: (
                  <InputAdornment position="start">
                    <DateRangeIcon />
                  </InputAdornment>
                ),
              }}
            />
          )}
        />
      </Box>

      {/* Firm Type Cards */}
      <Box sx={{ ...SET_CENTER(), flexWrap: "wrap", gap: 2, px: 2, mb: 2 }}>
        {firmTypeList.map((item) => {
          const [id, type] = item.split("~");
          const isSelected = selectedId === id;

          return (
          <Paper
  key={id}
  role="button"
  tabIndex={0}
  sx={{
    ...SET_CENTER(),
    ...MAIN_PAPER,
    flexDirection: "column", 
    textAlign: "center",     
    cursor: "pointer",
    outline: isSelected ? "2px solid #1976d2" : "none",
    backgroundColor: isSelected ? "#e3f2fd" : "white",
    transition: "all 0.2s ease-in-out",
    "&:hover": {
      backgroundColor: "#f5f5f5",
    },
  }}
  onClick={() => handleTypeClick(type, id)}
  onKeyDown={(e) => handleKeyDown(e, type, id)}
>
  {type}
</Paper>
          );
        })}
      </Box>

      {/* Details View */}
      {part && (
        <>
          <Box
            sx={{
              ...SET_CENTER({ x: "flex-end" }),
              gap: 2,
              flexWrap: "wrap",
              mb: 2,
            }}
          >
            <Button
              variant="contained"
              color="info"
              startIcon={<FileDownloadOutlinedIcon />}
              onClick={handleDownload}
            >
              Download Template
            </Button>

            <Button
              variant="contained"
              color="success"
              startIcon={<FileDownloadOutlinedIcon />}
              onClick={() =>
                downloadExcelFromGrid(
                  childData.rows,
                  childData.columns,
                  "FirmData.xlsx"
                )
              }
            >
              Download
            </Button>
            <Button
              variant="contained"
              color="warning"
              startIcon={<ArchiveIcon />}
              onClick={alert}
            >
              Archive
            </Button>
            <Button
              variant="contained"
              color="secondary"
              startIcon={<AccessTimeIcon />}
              onClick={() => navigate("/EmpReqManagement")}
            >
              View Pending Requests
            </Button>
            <Button
              variant="contained"
              color="error"
              onClick={() => {
                setPart(false);
                setChildData({ columns: [], rows: [] });
              }}
              startIcon={<CloseIcon />}
            >
              Close
            </Button>
          </Box>

          {/* Data Grid */}
          <Paper sx={{ height: 450 }}>
            <DataGrid
              {...childData}
              columnBufferPx={100}
              localeText={{ noRowsLabel: errorMessage }}
              pageSizeOptions={[10, 25, 50, 100]}
              initialState={{
                pagination: {
                  paginationModel: { pageSize: 10, page: 0 },
                },
              }}
              pagination
              loading={loading}
              onRowClick={handleRowClick}
            />
          </Paper>

          {/* Hidden File Input for Excel Upload */}
          <input
            type="file"
            accept=".xlsx, .xls"
            id="excel-upload"
            style={{ display: "none" }}
            onChange={handleExcelUpload}
          />

      

    {/* Speed Dial */}
<Box sx={{ height: 70, position: "absolute", right: 0, top: 0 }}>
  <SpeedDial
    ariaLabel="Empanelment Actions"
    sx={{ position: "absolute", top: 60, right: 40 }} 
    icon={<SpeedDialIcon />}
  >
    {ACTIONS.map((action) => (
      <SpeedDialAction
        key={action.name}
        sx={{
          width: 200,
        }}
        icon={
          <Box sx={{ display: "flex", alignItems: "center", gap: 1 }}>
            {action.icon}

            <Typography variant="body2" sx={{ color: "#000" }}>
              {action.name}
            </Typography>
          </Box>
        }
        FabProps={{
          sx: {
            backgroundColor: "#B0FFB0",
            "&:hover": { backgroundColor: "#A2F0A2" },
            px: 2,
            borderRadius: 5,
            minHeight: 40,
            width: 150,
          },
        }}
        tooltipOpen={false} 
        onClick={() => handleSpeedDialClick(action.name)}
      />
    ))}
  </SpeedDial>
</Box>
  </>
      )} 
      

      {/* Web Form Modal */}
      <FirmDetails
        open={dialogOpen}
        setOpen={setDialogOpen}
        action={dialogAction}
        setAction={setDialogAction}
        empanelmentDetails={selectedFirmDetails}
      />

      <AlertDialog
        open={showAlert}
        setOpen={setShowAlert}
        type={assignmnetType}
        period={period}
        handleArchieveRequest={() => handleArchieveRequest}
      />
    </Box>
  );
}

const AlertDialog = ({
  open,
  setOpen,
  type,
  period,
  handleArchieveRequest,
}) => {
  const handleClose = () => {
    setOpen(false);
  };

  return (
    <Dialog
      fullWidth
      maxWidth="sm"
      open={open}
      onClose={handleClose}
      aria-labelledby="alert-dialog-title"
      aria-describedby="alert-dialog-description"
    >
      <DialogTitle id="alert-dialog-title" color="orange">
        {"!Warning"}
      </DialogTitle>
      <DialogContent>
        <DialogContentText id="alert-dialog-description">
          {`You are about to archive all firms classified as ${type} for the financial year ${period}.
           Please note that this action is permanent and cannot be undone.`}
        </DialogContentText>
      </DialogContent>
      <DialogActions>
        <Button
          variant={"contained"}
          onClick={handleArchieveRequest()}
          autoFocus
        >
          Agree
        </Button>
      </DialogActions>
    </Dialog>
  );
};


<Box sx={{ height: 70, position: "absolute", right: 0, top: 0 }}>
  <SpeedDial
    ariaLabel="Empanelment Actions"
    sx={{ position: "absolute", top: 60, right: 40 }} 
