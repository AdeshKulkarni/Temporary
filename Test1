      if (!query || query.trim().length < 3) {
        setCglSearch({ loadingId: null, options: [] });
        return;
      }
      setCglSearch((prev) => ({ ...prev, loadingId: rowId }));

      try {
        const response = await callApi(
          `/JS/cgl-journal/search?query=${encodeURIComponent(query)}`,
          null,
          "GET"
        );

        setCglSearch({ loadingId: null, options: response || [] });
      } catch (error) {
        showSnackBar("CGL search failed.", "error");
        setCglSearch({ loadingId: null, options: [] });
      }
    }, 300),
    [callApi, showSnackBar]
  );

  const handleSubmit = async () => {
    if (!isCommonRemarksValid(commonBatchRemarks)) {
      showSnackBar("Common Batch Remarks must be 2-30 characters if provided.", "error");
      return;
    }


    setIsSubmitting(true);

    const [day, month, year] = postingDate.split("-");
    const formattedBackendDate = `${year}-${month}-${day}`;


    const branchCurrencyTotals = new Map();
    const branchEntryCheck = new Map();
    const rowPayloads = [];

    for (const [index, row] of rows.entries()) {
      if (
        !row.branch ||
        !row.currency ||
        !row.cgl ||
        !row.amount ||
        parseFloat(row.amount) === 0 ||
        !row.txnType ||
        !isRowRemarksValid(row.remarks)
      ) {
        showSnackBar(
          `Row ${index + 1} is incomplete or has a zero amount. Amount must be greater than 0, and remarks must be 2-30 characters.`,
          "error"
        );
        setIsSubmitting(false);
        return;
      }


      const branchCode = row.branch.code;
      const branchName = row.branch.name;
      const currency = row.currency;

      const cglNumber = String(row.cgl.cglNumber);
      const isMemo = cglNumber.startsWith("5");
      const type = isMemo ? "MEMO" : "NORMAL";

      const [integerPart = "0", fractionalPart = "0"] = (
        row.amount || "0"
      ).split(".");
      const fractionalPadded = fractionalPart.substring(0, 4).padEnd(4, "0");
      const amountAsBigInt = BigInt(integerPart + fractionalPadded);

      const compositeKey = `${branchCode}-${currency}-${type}`;

      if (!branchCurrencyTotals.has(compositeKey)) {
        branchCurrencyTotals.set(compositeKey, {
          totalDebit: 0n,
          totalCredit: 0n,
          branchName: branchName,
          branchCode: branchCode,
          currency: currency,
          type: type,
        });
      }
      const currencyTotals = branchCurrencyTotals.get(compositeKey);

      if (row.txnType === "Debit") {
        currencyTotals.totalDebit += amountAsBigInt;
      } else if (row.txnType === "Credit") {
        currencyTotals.totalCredit += amountAsBigInt;
      }

      if (!branchEntryCheck.has(branchCode)) {
        branchEntryCheck.set(branchCode, {
          hasDebit: false,
          hasCredit: false,
          branchName: branchName,
        });
      }
      const branchCheck = branchEntryCheck.get(branchCode);

      if (row.txnType === "Debit" && amountAsBigInt > 0n) {
        branchCheck.hasDebit = true;
      } else if (row.txnType === "Credit" && amountAsBigInt > 0n) {
        branchCheck.hasCredit = true;
      }

      const finalAmount =
        row.txnType === "Credit" ? "-" + row.amount : row.amount;

      rowPayloads.push({
        branch: row.branch.code,
        currency: row.currency,
        cgl: row.cgl.cglNumber,
        amount: finalAmount,
        productType: row.productCode,
        remarks: row.remarks,
        arFlag: "A",
        postingDate: formattedBackendDate
      });
    }

    for (const [branchCode, totals] of branchEntryCheck.entries()) {
      const { hasDebit, hasCredit } = totals;
      if (!hasDebit || !hasCredit) {
        showSnackBar("Branch must have at least one Debit and one Credit entry.", "error");
        setIsSubmitting(false);
        return;
      }
    }


    for (const [compositeKey, totals] of branchCurrencyTotals.entries()) {
      const { totalDebit, totalCredit } = totals;

      if (totalDebit !== totalCredit) {
        showSnackBar("Branch and Currency Debit/Credit Mismatch for Real/Memo CGL.", "error");
        setIsSubmitting(false);
        return;
      }
    }

    let formattedSchedule = null;
    if (scheduledTime) {
      const dateObj = new Date(scheduledTime);
      formattedSchedule = dateObj.toISOString().slice(0, 19).replace('T', ' ');
    }

    const finalPayload = {
      vid: selectedVoucher?.vid,
      scheduledTime: null, // Handled in Step 3 now
      // commonBatchRemarks: commonBatchRemarks.trim(),
      commonBatchRemarks: "Voucher created successfully",
      rows: rowPayloads,
    };
    try {
      const response = await callApi(
        "/JS/voucher/create-batch",
        finalPayload,
        "POST"
      );

      // Extract the Batch ID created by the backend
      const newBatchId = response?.[0]?.batchId || response?.batchId || "N/A";
      setSubmittedBatchId(newBatchId);

      setRows([createNewRow()]);
      setCommonBatchRemarks("");
      setChecked(false);
      setBranchInputValues({});
      setCglInputValues({});
      setActiveStep(3);
    } catch (error) {
      // If it fails instantly (e.g. server down, bad network), show an error snackbar
      const errMsg = error?.response?.data?.message || error.message || "System error occurred.";
      showSnackBar(`Failed to initiate request: ${errMsg}`, "error");
    } finally {
      setIsSubmitting(false);
    }
  };

  const isFormReadyToSubmit = rows.length >= 2 && rows.every(
    (row) =>
      row.branch &&
      row.currency &&
      row.cgl &&
      row.amount &&
      parseFloat(row.amount) > 0 &&
      row.txnType &&
      isRowRemarksValid(row.remarks)
  );

  const SelectedVoucherCard = () => {
    const [isDescExpanded, setIsDescExpanded] = useState(false);

    if (!selectedVoucher) return null;

    const desc = selectedVoucher.description || "No description provided.";
    const isLongDesc = desc.length > 100 || desc.split(/\r?\n/).length > 2;

    return (
      <Paper elevation={0} sx={jpStyles.svPaper}>
        <Box sx={jpStyles.svHeaderBox}>
          <Typography variant="subtitle1" fontWeight="bold" color="text.primary">
            Voucher Request Details
          </Typography>
        </Box>

        <Grid container spacing={2}>
          <Grid item size={12} sx={{ mb: 2 }}>
            <Stack direction="row" spacing={8}>
              <Box>
                <Typography variant="caption" color="text.secondary" display="block" gutterBottom>VID</Typography>
                <Typography variant="body1" fontWeight="bold" color="primary">{selectedVoucher.vid}</Typography>
              </Box>
              <Box>
                <Typography variant="caption" color="text.secondary" display="block" gutterBottom>Category</Typography>
                <Typography variant="body1" fontWeight="500">{selectedVoucher.categoryName || "General"}</Typography>
              </Box>
              <Box>
                <Typography variant="caption" color="text.secondary" display="block" gutterBottom>Issue Categories</Typography>
                <Box>
                  {selectedVoucher.issueCategories ? selectedVoucher.issueCategories.split(",").map((cat, index) => (
                    <Chip key={index} label={cat.trim()} size="small" sx={jpStyles.issueCategoryChip} />
                  )) : <Typography variant="body2" color="text.secondary">N/A</Typography>}
                </Box>
              </Box>
            </Stack>
          </Grid>
          <Grid item size={12}>
            <Typography variant="caption" color="text.secondary" display="block" gutterBottom>
              Description
            </Typography>

            <Box sx={{ position: "relative" }}>
              {/* collapsedSize={44} perfectly frames about 2 lines of body2 text */}
              <Collapse in={!isLongDesc || isDescExpanded} collapsedSize={20}>
                <Typography variant="body2" sx={{ whiteSpace: "pre-wrap", lineHeight: 1.6, fontWeight: 400, color: "text.primary" }}>
                  {desc}
                </Typography>
              </Collapse>

              {isLongDesc && (
                <Box sx={{ display: "flex", justifyContent: "flex-start", mt: 0.5 }}>
                  <Button
