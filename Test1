  const handlePreview = async () => {
    let i = bodyContent.search(/<[\w-_=\\":;\s]+><br><\/[\w]+>/g);
    let fullContent =
      i === 0
        ? headerContent + bodyContent
        : headerContent + "<p><br/><p>" + bodyContent;
    let data = {
      DATE: "xx/xx/xxxx",
      REF_NO: "9999xxx",
      FIRM_NAME: "xxxxxxxxxx",
      FRN_NO: "999999999",
      GSTN: "99xx99xx",
      FIRM_ADDR: "xxxxxxxx,xxxxxxxx",
      ASSIGNMENT_TYPE: "xxxxxxx",
    };

    // Create a temporary div to parse the HTML content
    const tempDiv = document.createElement("div");
    tempDiv.innerHTML = fullContent;

    // Find all variable blots and replace them with their corresponding data
    const variableBlots = tempDiv.querySelectorAll(".variable-blot");
    variableBlots.forEach((blot) => {
      const variableName = blot.textContent.replace("X", "").trim(); // Removes the 'X' from delete icon
      const key = variableName.substring(2, variableName.length - 2); // Extracts variable key e.g., DATE from {{DATE}}
      if (data[key]) {
        blot.replaceWith(document.createTextNode(data[key]));
      }
    });

    let StrToSend = tempDiv.innerHTML.replace(/<br\s*\/?>/gi, "<br></br>");

    settemplateContent(StrToSend);
    setIsPreviewing(true);
  };
