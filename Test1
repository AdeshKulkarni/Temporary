package com.tcs.fincore.MOCService.Dto;

import com.tcs.fincore.MOCService.Models.enums.ChangeType;
import jakarta.validation.Valid;
import jakarta.validation.constraints.NotNull;
import jakarta.validation.constraints.Size;
import java.math.BigDecimal;
// import java.time.LocalDate; // <-- Can be removed if not used elsewhere
import lombok.Data;
import java.util.List;

@Data
public class BatchRequestDto {

    // This DTO will be sent from the frontend
    // It contains just the row data, without batch/journal IDs
    @Data
    public static class MocRequestRow {
        @NotNull
        private ChangeType changeType = ChangeType.ADD; // Default to ADD
        private Long masterMocId; // Will be null for ADD

        // --- THIS FIELD IS NOW REMOVED ---
        // @NotNull 
        // private LocalDate pdate;
        // --- END OF REMOVAL ---
        
        @NotNull @Size(min = 1, max = 50) 
        private String branch; 

        @NotNull @Size(min = 3, max = 3) 
        private String currency;

        @NotNull @Size(min = 1, max = 50)
        private String cgl;

        @NotNull
        private BigDecimal amount;

        @Size(max = 20)
        private String transactionType; 
        
        @Size(max = 20) 
        private String productType;
        
        @Size(max = 40) 
        private String remarks;
        
        @Size(min = 1, max = 1)
        private String arFlag = "A"; // Default to "A"
        
        @Size(min = 1, max = 1) 
        private String acClassification; 
    }

    @Size(max = 200)
    private String commonBatchRemarks;

    @Valid
    @NotNull
    private List<MocRequestRow> rows;
}
