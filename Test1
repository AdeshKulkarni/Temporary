@Data
@Getter
@Setter
public class CreateMocRequestDto {

    @NotNull // Added validation
    private ChangeType changeType;
  
    private Long masterMocId; // Only used for UPDATE/DELETE

    @NotNull // Added validation
    private LocalDate pDate;
    
    @NotNull @Size(min = 1, max = 50) // Added validation
    private String branch; // This will be the branch CODE from frontend

    @NotNull @Size(min = 3, max = 3) // Added validation
    private String currency;

    @NotNull @Size(min = 1, max = 50) // Added validation
    private String cgl; // This will be the CGL NUMBER from frontend

    @NotNull // Added validation
    private BigDecimal amount;

    @Size(max = 20) // Added validation
    private String transactionType; // Frontend will send "Debit" or "Credit"
    
    @Size(max = 20) // Added validation
    private String productType;
    
    @Size(max = 40) // Added validation
    private String remarks;
    
    @Size(min = 1, max = 1) // Added validation
    private String arFlag;
    
    @Size(min = 1, max = 1) // Added validation
    private String acClassification; // Frontend sends 'A', 'E', etc.

    // --- ADD THESE FIELDS ---
