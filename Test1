const JournalBulkUpload = () => {
  const { callApi, loading } = useApi();
  const showSnackBar = useCustomSnackbar();

  const [selectedDate, setSelectedDate] = useState("");
  const [file, setFile] = useState(null);
  const [isCsvInput, setIsCsvInput] = useState(false);

  const [uiError, setUiError] = useState("");
  const [errorCount, setErrorCount] = useState(0);
  const [downloadStatus, setDownloadStatus] = useState(""); // "" | "DOWNLOADING" | "DOWNLOADED"

  const [successFile, setSuccessFile] = useState(null);
  const [previewRows, setPreviewRows] = useState([]);
  const [totalRowsProcessed, setTotalRowsProcessed] = useState(0);

  const [isSubmitting, setIsSubmitting] = useState(false);
  const [timer, setTimer] = useState(0); // Progress Timer

  const fileInputRef = useRef(null);

  // Timer Effect
  useEffect(() => {
    let interval = null;
    if (isSubmitting) {
      setTimer(0);
      interval = setInterval(() => {
        setTimer((prev) => prev + 1);
      }, 1000);
    } else {
      clearInterval(interval);
    }
    return () => clearInterval(interval);
  }, [isSubmitting]);

  const downloadBase64File = (base64String, fileName, mimeType) => {
    try {
      const byteCharacters = atob(base64String);
      const byteNumbers = new Array(byteCharacters.length);
      for (let i = 0; i < byteCharacters.length; i++) {
        byteNumbers[i] = byteCharacters.charCodeAt(i);
      }
      const byteArray = new Uint8Array(byteNumbers);
      const blob = new Blob([byteArray], { type: mimeType });
      const url = window.URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.setAttribute("download", fileName);
      document.body.appendChild(link);
      link.click();
      link.parentNode.removeChild(link);
      window.URL.revokeObjectURL(url);
      setDownloadStatus("DOWNLOADED");
    } catch (e) {
      console.error("Failed to download", e);
      showSnackBar("Failed to download file.", "error");
    }
  };

  const handleDateChange = (e) => {
    setSelectedDate(e.target.value);
    setUiError("");
    setSuccessFile(null);
    setPreviewRows([]);
    setTotalRowsProcessed(0);
    setDownloadStatus("");
  };

  const handleFileChange = (e) => {
    const selectedFile = e.target.files[0];
    if (selectedFile) {
      const name = selectedFile.name.toLowerCase();
      if (
        !name.endsWith(".xlsx") &&
        !name.endsWith(".xls") &&
        !name.endsWith(".csv")
      ) {
        const msg = "Invalid file type. Supported: .xlsx, .xls, .csv";
        setUiError(msg);
        showSnackBar(msg, "error");
        setFile(null);
        return;
      }
      setFile(selectedFile);
      setIsCsvInput(name.endsWith(".csv"));

      setUiError("");
      setErrorCount(0);
      setSuccessFile(null);
      setPreviewRows([]);
      setTotalRowsProcessed(0);
      setDownloadStatus("");
    }
  };

  const resetForm = () => {
    setFile(null);
    setSelectedDate("");
    setUiError("");
    setErrorCount(0);
    setSuccessFile(null);
    setPreviewRows([]);
    setTotalRowsProcessed(0);
    setIsSubmitting(false);
    setIsCsvInput(false);
    setDownloadStatus("");
    if (fileInputRef.current) fileInputRef.current.value = "";
  };

  const handleValidation = async () => {
    if (!selectedDate || !file) {
      const msg = "Please select a Date and upload a File.";
      setUiError(msg);
      showSnackBar(msg, "warning");
      return;
    }

    setUiError("");
    setErrorCount(0);
    setSuccessFile(null);
    setPreviewRows([]);
    setTotalRowsProcessed(0);
    setDownloadStatus("");
    setIsSubmitting(true); // START

    const formData = new FormData();
    formData.append("file", file);
    formData.append("postingDate", selectedDate);

    try {
      const response = await callApi(
        "/JS/journals/bulk-validate",
        formData,
        "POST",
        "json",
        "multipart/form-data"
      );

      if (response && response.status === "ERROR") {
        const count = response.errorCount || 0;
        setErrorCount(count);
        setUiError(`Validation Failed with ${count} errors.`);
        
        if (response.errorReportBase64) {
          setDownloadStatus("DOWNLOADING");
          setTimeout(() => {
             downloadBase64File(
                response.errorReportBase64,
                `Error_Report.xlsx`,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
             );
          }, 500); // Slight delay for UX
        }
      } else if (response && response.status === "SUCCESS") {
        showSnackBar(response.message, "success");
        if (response.successFileBase64)
          setSuccessFile(response.successFileBase64);
        if (response.previewData) setPreviewRows(response.previewData);
        if (response.totalRows) setTotalRowsProcessed(response.totalRows);
      }
    } catch (err) {
      console.error("Validation Error:", err);
    } finally {
        setIsSubmitting(false); // STOP
    }
  };

  const handleSubmitBatch = async () => {
    if (previewRows.length === 0) {
      showSnackBar("No validated data to submit.", "warning");
      return;
    }

    setIsSubmitting(true);

    try {
      const payloadRows = previewRows.map((row) => {
        let amt = parseFloat(row.amount.replace(/,/g, ""));
        if (row.txnType === "Credit") {
          amt = -Math.abs(amt);
        } else {
          amt = Math.abs(amt);
        }

        return {
          changeType: "ADD",
          branch: row.branch,
          currency: row.currency,
          cgl: row.cgl,
          amount: amt,
          productType: row.productCode || "",
          remarks: row.remarks || "",
          arFlag: "A",
          acClassification: "A",
        };
      });

      const finalPayload = {
        commonBatchRemarks: `Bulk Upload - ${selectedDate}`,
        rows: payloadRows,
      };

      const response = await callApi(
        "/JS/journals/create-bulk-batch",
        finalPayload,
        "POST"
      );

      if (response && response.status === "SUCCESS") {
        showSnackBar(
          `Batch Created Successfully! Batch ID: ${response.batchId}`,
          "success"
        );
        resetForm();
      }
    } catch (error) {
      console.error("Batch Creation Failed:", error);
      showSnackBar("Failed to create batch.", "error");
    } finally {
      setIsSubmitting(false);
    }
  };

  // Grid Columns
  const columns = [
    { field: "branch", headerName: "Branch", flex: 1, align: "center", headerAlign: "center" },
    { field: "currency", headerName: "Currency", width: 100, align: "center", headerAlign: "center" },
    { field: "cgl", headerName: "CGL", flex: 1.5, align: "center", headerAlign: "center" },
    { field: "productCode", headerName: "Product", width: 120, align: "center", headerAlign: "center", renderCell: (p) => p.value || "-" },
    { 
      field: "amount", headerName: "Amount", flex: 1.5, minWidth: 150, align: "right", headerAlign: "center",
      valueFormatter: (params) => {
        const val = params?.value || params;
        if (!val) return "0.00";
        const parts = String(val).split(".");
        parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        return parts.join(".");
      }
    },
    { 
      field: "txnType", headerName: "Type", width: 100, align: "center", headerAlign: "center",
      renderCell: (params) => (
        <Chip 
          label={params.value} 
          color={params.value === "Credit" ? "error" : "success"} 
          size="small" 
          variant="filled"
          sx={{ fontWeight: "bold", width: "80px" }}
        />
      )
    },
    { field: "remarks", headerName: "Remarks", flex: 2, align: "center", headerAlign: "center" },
  ];

  return (
    <Box sx={mainContainerStyle}>
      <Paper elevation={1} sx={controlPanelStyle}>
        
        <Box sx={dateinputfield}>
            <TextField
                type="date"
                label="Posting Date"
                sx={{ alignItems: "center" }}
                size="small"
                value={selectedDate}
                onChange={handleDateChange}
                InputLabelProps={{ shrink: true }}
                // FUTURE DATE RESTRICTION
                inputProps={{ max: new Date().toISOString().split("T")[0] }}
            />
        </Box>

        <br />

        <Box sx={uploadBoxStyle} onClick={() => fileInputRef.current.click()}>
          <input
            type="file"
            hidden
            accept=".xlsx, .xls, .csv"
            onChange={handleFileChange}
            ref={fileInputRef}
          />

          {file ? (
            <>
              <DescriptionIcon color="success" sx={{ fontSize: 60, mb: 1 }} />
              <Typography variant="h6" sx={headerTextStyle}>{file.name}</Typography>
              <Chip label="Ready" color="success" size="small" variant="outlined" />
              <Typography variant="caption" sx={{ mt: 1, color: "text.disabled" }}>Click to change</Typography>
            </>
          ) : (
            <>
              <CloudUploadIcon sx={iconStyle} />
              <Typography variant="h6" sx={headerTextStyle}>Click to Upload</Typography>
              <Typography sx={subTextStyle}>Supported: .xlsx, .xls, .csv</Typography>
            </>
          )}
        </Box>

        <br />
        <Stack direction="row" sx={{ display: "flex", justifyContent: "center" }} spacing={2}>
          <Button
            variant="contained"
            sx={{ cursor: "pointer" }}
            onClick={handleValidation}
            disabled={loading || !file || !selectedDate || isSubmitting}
            startIcon={isSubmitting ? <CircularProgress size={20} color="inherit" /> : <CheckCircleIcon />}
            size="large"
          >
            {/* BUTTON TEXT UPDATE */}
            {isSubmitting ? `Processing (${timer}s)...` : "Validate"}
          </Button>

          <Button variant="outlined" color="error" onClick={resetForm} startIcon={<RestartAltIcon />} disabled={isSubmitting} size="large">
            Reset
          </Button>
        </Stack>

        {/* FEEDBACK SECTION */}
        <Box sx={{ mt: 3 }}>
          {/* LIVE PROGRESS (When Processing) */}
          {isSubmitting && (
             <Box sx={{ width: '100%', mb: 2 }}>
                <Typography variant="body2" color="text.secondary" align="center" gutterBottom>
                    Validating large file, please wait...
                </Typography>
                <LinearProgress />
             </Box>
          )}

          {uiError && (
            <Alert severity="error" sx={{ mb: 2, border: "1px solid #ee0404ff" }}>
              <Typography variant="subtitle2" fontWeight="bold">Validation Failed</Typography>
              <Typography variant="body2">{uiError}</Typography>
              {/* STATUS TEXT UPDATE */}
              {downloadStatus === "DOWNLOADED" && (
                  <Typography variant="caption" sx={{ display: 'block', mt: 1, fontStyle: 'italic' }}>
                      Error Report Downloaded. Please check your downloads folder.
                  </Typography>
              )}
            </Alert>
          )}

          {!uiError && previewRows.length > 0 && (
            <Paper variant="outlined" sx={{ p: 2, borderColor: "success.main" }}>
              <Stack direction={{ xs: "column", sm: "row" }} justifyContent="space-between" alignItems="center" spacing={2}>
                <Box>
                  <Stack direction="row" alignItems="center" spacing={1}>
                    <CheckCircleIcon color="success" />
                    <Typography variant="subtitle1" fontWeight="bold">Validation Successful!</Typography>
                  </Stack>
                  {/* ROW COUNT SUMMARY */}
                  <Typography variant="body2">
                    {totalRowsProcessed} rows validated. Ready for submission.
                  </Typography>
                </Box>
                <Stack direction="row" spacing={2}>
                  {!isCsvInput && successFile && (
                    <Button
                      variant="outlined"
                      color="success"
                      startIcon={<DownloadIcon />}
                      onClick={() => downloadBase64File(successFile, `Processed_Journal_${selectedDate}.csv`, "text/csv")}
                      sx={{ bgcolor: "background.paper" }}
                    >
                      Download CSV
                    </Button>
                  )}
                  <Button
                    variant="contained"
                    color="success"
                    startIcon={isSubmitting ? <CircularProgress size={20} color="inherit" /> : <SendIcon />}
                    onClick={handleSubmitBatch}
                    disabled={isSubmitting}
                  >
                    {isSubmitting ? "Creating Batch..." : "Create Batch"}
                  </Button>
                </Stack>
              </Stack>
            </Paper>
          )}
        </Box>
      </Paper>

      {/* GRID */}
      {previewRows.length > 0 && !uiError && (
        <Paper elevation={1} sx={{ p: 0, mt: 3, height: 600, width: "100%", borderRadius: 2, overflow: "hidden" }}>
          <Box sx={{ p: 2, borderBottom: 1, borderColor: "divider" }}>
            <Typography variant="h6" sx={{ fontWeight: 600 }}>Data Preview</Typography>
          </Box>
          <DataGrid
            rows={previewRows}
            columns={columns}
            pageSize={10}
            rowsPerPageOptions={[10, 25, 50, 100]}
            disableSelectionOnClick
            density="comfortable"
            sx={{ border: "none" }}
          />
        </Paper>
      )}
    </Box>
  );
};

export default JournalBulkUpload;

