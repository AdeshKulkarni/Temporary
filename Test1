useEffect(() => {
  const quill = editorRef.current.getEditor();

  quill.on("text-change", (delta, oldDelta, source) => {
    if (source !== "user") return;

    const text = quill.getText().trim();
    const words = text.split(/\s+/).filter(Boolean);
    const count = words.length;

    setWordCount(count);

    if (count > 2000) {
      // Prevent further input: revert last change by deleting inserted text
      const lastOp = delta.ops[delta.ops.length - 1];
      if (lastOp.insert) {
        quill.deleteText(
          quill.getLength() - lastOp.insert.length - 1,
          lastOp.insert.length,
          "silent"
        );
      }

      quill.blur(); // remove cursor
      setMessage("❌ Word limit exceeded (2000 words)!");
    }
  });

  return () => {
    quill.off("text-change");
  };
}, []);
