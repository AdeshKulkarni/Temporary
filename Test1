DROP SEQUENCE JRNL_SEQ;

CREATE SEQUENCE JRNL_SEQ
  START WITH 88
  INCREMENT BY 1
  MAXVALUE 999999999
  NOCACHE
  NOCYCLE;

-- Run this if you need to reset your batch sequence
DROP SEQUENCE BATCH_SEQ;

-- This one starts at 600
CREATE SEQUENCE BATCH_SEQ
  START WITH 600
  INCREMENT BY 1
  MAXVALUE 999999999
  NOCACHE
  NOCYCLE;
