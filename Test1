  const handleDrop = (e) => {
    e.preventDefault();
    if (!isEditing) return;
    const editor = bodyEditorRef.current?.getEditor();
    if (!editor) return;

    const range = editor.getSelection(true);
    if (!range) return;
    
    const text = e.dataTransfer.getData("text");

    // Check the content immediately before the drop position
    if (range.index > 0) {
      const [leaf, offset] = editor.getLeaf(range.index - 1);
      // Check if the leaf before the cursor is a 'variable' blot
      // and if the cursor is at the very end of that blot.
      if (leaf && leaf.statics.blotName === 'variable' && leaf.length() === offset) {
        const lastVariableValue = leaf.value();
        if (lastVariableValue === text) {
          setSbar({
            isOpen: true,
            Msg: `❌ Cannot add the same variable consecutively.`,
          });
          return; // Prevent dropping the same variable
        }
      }
    }

    // If validation passes, insert the new variable
    editor.insertEmbed(range.index, "variable", text, Quill.sources.USER);
    editor.setSelection(range.index + 1, Quill.sources.USER);
  };
