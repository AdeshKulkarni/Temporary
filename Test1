package com.tcs.fincore.MOCService.Models;
import java.math.BigDecimal;
import java.time.LocalDate;
import jakarta.persistence.*;
import lombok.Data;

@Entity
@Table(name = "MASTER_MOC")
@Data
public class MasterMoc {
      @Id
      @GeneratedValue(strategy = GenerationType.SEQUENCE, generator = "MASTER_MOC_SEQ")
      @SequenceGenerator(name = "MASTER_MOC_SEQ", sequenceName = "MASTER_MOC_SEQ", allocationSize = 1)
      @Column(name = "MOC_ID")
      private Long id;

      @Column(name = "TMMOC_PDATE")
      private LocalDate pDate;

      @Column(name = "TMMOC_BRANCH", length = 50)
      private String branch;

      @Column(name = "CURRENCY", length = 3)
      private String currency;

      @Column(name = "TMMOC_CGL", length = 50)
      private String cgl;

      @Column(name = "TMMOC_AMT")
      private BigDecimal amount;

      @Column(name = "TXN_TYPE", length = 20)
      private String transactionType;

      @Column(name = "PRODUCT_TYPE", length = 20)
      private String productType;

      @Column(name = "REMARKS", length = 40)
      private String remarks;

      @Column(name = "AR_FLAG", length = 1)
      private String arFlag;
      
      
      @Column(name= "AC_CLASSIFICATION")
      private String acClassification;

      // --- ADD THESE FIELDS ---
      @Column(name = "BATCH_ID", length = 50)
      private String batchId;

      @Column(name = "JOURNAL_ID", length = 50)
      private String journalId;
      // --- END ADD ---
}