const steps = ["Upload File", "Validation", "Preview & Submit"];

const JournalBulkUpload = () => {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  // --- State ---
  const [selectedDate, setSelectedDate] = useState("");
  const [file, setFile] = useState(null);
  const fileInputRef = useRef(null);

  // Process Status
  const [activeStep, setActiveStep] = useState(0);
  const [requestId, setRequestId] = useState(null);
  const [isProcessing, setIsProcessing] = useState(false);
  const [resultStatus, setResultStatus] = useState(null); // 'SUCCESS' | 'ERROR'
  const [errorMsg, setErrorMsg] = useState("");

  // Data
  const [previewRows, setPreviewRows] = useState([]);
  const [totalRows, setTotalRows] = useState(0);
  const [hasProductColumn, setHasProductColumn] = useState(false);
  const [autoDlTriggered, setAutoDlTriggered] = useState(false);

  // Batch Creation
  const [isCreatingBatch, setIsCreatingBatch] = useState(false);

  // --- Handlers ---
  const handleDateChange = (e) => {
    setSelectedDate(e.target.value);
    // If user changes date after failure, reset the process
    if (resultStatus) resetProcess();
  };

  const handleFileSelect = (e) => {
    if (e.target.files[0]) {
      setFile(e.target.files[0]);
      resetProcess();
    }
  };

  const resetProcess = () => {
    setActiveStep(0);
    setRequestId(null);
    setResultStatus(null);
    setErrorMsg("");
    setPreviewRows([]);
    setTotalRows(0);
    setIsProcessing(false);
    setAutoDlTriggered(false);
    if (fileInputRef.current) fileInputRef.current.value = "";
  };

  const handleDownloadTemplate = async () => {
    try {
      let token = "";
      const storageAuth = sessionStorage.getItem("persist:auth") || localStorage.getItem("persist:auth");
      if (storageAuth) { try { token = JSON.parse(storageAuth).token.replace(/"/g, ""); } catch (e) { } }

      const response = await fetch("/JS/journals/download-template", {
        headers: { Authorization: `Bearer ${token}` }
      });

      if (!response.ok) throw new Error("Template download failed");

      const blob = await response.blob();
      const url = window.URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.setAttribute("download", "Journal_Upload_Template.xlsx");
      document.body.appendChild(link);
      link.click();
      link.remove();
    } catch (e) {
      showSnackBar("Failed to download template", "error");
    }
  };

  const handleStartValidation = async () => {
    if (!selectedDate) {
      showSnackBar("Please select a Posting Date first.", "warning");
      return;
    }
    if (!file) {
      showSnackBar("Please select a file.", "warning");
      return;
    }
    if (file.size === 0) {
      showSnackBar("The selected file is empty.", "error");
      return;
    }

    setIsProcessing(true);
    setActiveStep(1); // Move to Processing Step

    const formData = new FormData();
    formData.append("file", file);
    formData.append("postingDate", selectedDate);

    try {
      // Get Token
      let token = "";
      const storageAuth = sessionStorage.getItem("persist:auth") || localStorage.getItem("persist:auth");
      if (storageAuth) { try { token = JSON.parse(storageAuth).token.replace(/"/g, ""); } catch (e) { } }

      const res = await fetch("/JS/journals/bulk-validate-init", {
        method: "POST",
        headers: { "Authorization": `Bearer ${token}` },
        body: formData
      });

      if (!res.ok) {
        const txt = await res.text();
        throw new Error(txt || "Upload initialization failed");
      }

      const data = await res.json();
      setRequestId(data.requestId); // Triggers useEffect polling
    } catch (err) {
      setIsProcessing(false);
      setResultStatus("ERROR");
      setErrorMsg("Upload failed: " + err.message);
      showSnackBar("Upload initialization failed.", "error");
    }
  };

  // --- Polling for Status ---
  useEffect(() => {
    let interval;
    if (isProcessing && requestId) {
      interval = setInterval(async () => {
        try {
          const res = await callApi(`/JS/journals/bulk-status/${requestId}`, null, "GET");

          if (res.status === "ERROR") {
            setIsProcessing(false);
            setResultStatus("ERROR");
            setErrorMsg(res.message);
            clearInterval(interval);
            showSnackBar(res.message, "error", 5000);

            // Auto Download Error File
            if (res.hasErrorFile && !autoDlTriggered) {
              setAutoDlTriggered(true);
              handleDownloadFile("ERROR", res.requestId);
            }
          }
          else if (res.status === "SUCCESS") {
            setIsProcessing(false);
            setResultStatus("SUCCESS");
            setTotalRows(res.totalRows);
            if (res.previewDataJson) {
              const rows = JSON.parse(res.previewDataJson);
              setPreviewRows(rows);
              // Check if any row has a real product code
              setHasProductColumn(rows.some(r => r.productCode && r.productCode !== "A"));
            }
            setActiveStep(2); // Move to Preview Step
            clearInterval(interval);
            showSnackBar("Validation Successful!", "success", 5000);
          }
        } catch (e) { console.error(e); }
      }, 1000);
    }
    return () => clearInterval(interval);
  }, [isProcessing, requestId, callApi, showSnackBar, autoDlTriggered]);

  const handleDownloadFile = async (type, reqId = requestId) => {
    try {
      let token = "";
      const storageAuth = sessionStorage.getItem("persist:auth") || localStorage.getItem("persist:auth");
      if (storageAuth) { try { token = JSON.parse(storageAuth).token.replace(/"/g, ""); } catch (e) { } }

      const response = await fetch(`/JS/journals/download-bulk-file/${reqId}?type=${type}`, {
        headers: { Authorization: `Bearer ${token}` }
      });
      if (!response.ok) throw new Error("Download failed");

      const blob = await response.blob();
      const url = window.URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.setAttribute("download", type === "ERROR" ? "Error_Report.xlsx" : "Success_Batch.csv");
      document.body.appendChild(link);
      link.click();
      link.remove();

      if (type === "ERROR") {
        showSnackBar("Error report downloaded. Please check Site, Date, Year, Period columns.", "info", 6000);
      }
    } catch (e) {
      showSnackBar("Download failed", "error");
    }
  };

  const handleCreateBatch = async () => {
    setIsCreatingBatch(true);
    try {
      // Optimized: Send RequestID only. Backend fetches data from Redis cache.
      const payload = {
        requestId: requestId,
        commonBatchRemarks: `Bulk Upload - ${selectedDate}`
      };

      const res = await callApi("/JS/journals/create-bulk-batch-optimized", payload, "POST");

      if (res.status === "SUCCESS") {
        showSnackBar(`Batch ${res.batchId} Created Successfully!`, "success", 5000);
        resetProcess();
        setFile(null);
        setSelectedDate("");
      } else {
        throw new Error(res.message);
      }
    } catch (e) {
      showSnackBar("Failed to create batch: " + e.message, "error", 5000);
    } finally {
      setIsCreatingBatch(false);
    }
  };

  return (
    <Box sx={styles.mainContainer}>
      <Paper sx={styles.controlPanel}>

        {/* Header Actions */}
        <Box sx={{ display: 'flex', justifyContent: 'flex-end', mb: 2 }}>
          <Button startIcon={<FileDownload />} onClick={handleDownloadTemplate}>
            Download Template
          </Button>
        </Box>

        {/* Stepper */}
        <Stepper activeStep={activeStep} sx={styles.stepperContainer} alternativeLabel>
          {steps.map((label, idx) => (
            <Step key={label}>
              <StepLabel error={resultStatus === "ERROR" && activeStep === idx}>
                {label}
              </StepLabel>
            </Step>
          ))}
        </Stepper>

        {/* --- STEP 0: UPLOAD --- */}
        {activeStep === 0 && (
          <>
            <Box sx={styles.dateInputContainer}>
              <TextField
                type="date"
                label="Posting Date"
                value={selectedDate}
                onChange={handleDateChange}
                InputLabelProps={{ shrink: true }}
                size="small"
                helperText="Matches CSV Date (e.g., 02122025)"
              />
            </Box>

            <Box
              sx={styles.uploadBox}
              onClick={() => {
                if (selectedDate) fileInputRef.current.click();
                else showSnackBar("Select Date First", "warning");
              }}
            >
              <input type="file" hidden ref={fileInputRef} onChange={handleFileSelect} accept=".xlsx,.csv" />
              {file ? (
                <>
                  <CheckCircle sx={{ fontSize: 60, color: "success.main" }} />
                  <Typography sx={styles.uploadText}>{file.name}</Typography>
                  <Chip label="Ready to Validate" color="primary" sx={{ mt: 1 }} />
                  <Typography sx={styles.uploadSubText}>Click to change</Typography>
                </>
              ) : (
                <>
                  <CloudUpload sx={styles.uploadIcon} />
                  <Typography sx={styles.uploadText}>Click to Upload</Typography>
                  <Typography sx={styles.uploadSubText}>.xlsx, .csv (Max 50MB)</Typography>
                </>
              )}
            </Box>

            <Box sx={styles.actionButtons}>
              <Button
                variant="contained"
                size="large"
                onClick={handleStartValidation}
                disabled={!file || !selectedDate}
              >
                Next: Validate
              </Button>
            </Box>
          </>
        )}

        {/* --- STEP 1: VALIDATION PROGRESS --- */}
        {activeStep === 1 && (
          <Box sx={{ textAlign: 'center', py: 5 }}>
            {resultStatus === "ERROR" ? (
              <Alert severity="error" sx={{ maxWidth: 600, mx: 'auto', border: '1px solid red' }}>
                <Typography variant="h6">Validation Failed</Typography>
                <Typography>{errorMsg}</Typography>
                <Button startIcon={<RestartAlt />} onClick={resetProcess} sx={{ mt: 2 }} color="error">
                  Try Again
                </Button>
              </Alert>
            ) : (
              <>
                <CircularProgress size={50} />
                <Typography sx={{ mt: 2 }}>Validating Records...</Typography>
              </>
            )}
          </Box>
        )}

        {/* --- STEP 2: PREVIEW & SUBMIT --- */}
        {activeStep === 2 && (
          <>
            <Alert severity="success" icon={<CheckCircle fontSize="inherit" />} sx={{ mb: 2 }}>
              Validation Successful! {totalRows.toLocaleString()} rows ready.
            </Alert>

            {totalRows > 2000 && (
              <Alert severity="warning" sx={{ mb: 2 }}>
                Displaying first 2000 rows only. The full batch will be created.
              </Alert>
            )}

            <TableContainer component={Paper} sx={styles.tableContainer}>
              <Table stickyHeader size="small">
                <TableHead>
                  <TableRow>
                    <TableCell sx={styles.tableHeader}>ID</TableCell>
                    <TableCell sx={styles.tableHeader}>Branch</TableCell>
                    <TableCell sx={styles.tableHeader}>Currency</TableCell>
                    <TableCell sx={styles.tableHeader}>CGL</TableCell>
                    <TableCell align="right" sx={styles.tableHeader}>Amount</TableCell>
                    <TableCell align="center" sx={styles.tableHeader}>Type</TableCell>
                    <TableCell sx={styles.tableHeader}>Remarks</TableCell>
                    {hasProductColumn && <TableCell sx={styles.tableHeader}>Product</TableCell>}
                  </TableRow>
                </TableHead>
                <TableBody>
                  {previewRows.map((row, idx) => (
                    <TableRow key={idx} hover>
                      <TableCell>{row.id}</TableCell>
                      <TableCell>{row.branch}</TableCell>
                      <TableCell>{row.currency}</TableCell>
                      <TableCell>{row.cgl}</TableCell>
                      <TableCell align="right">{row.amount}</TableCell>
                      <TableCell align="center">
                        <Chip
                          label={row.txnType}
                          size="small"
                          color={row.txnType.includes("Credit") ? "error" : "success"}
                          variant="filled"
                        />
                      </TableCell>
                      <TableCell>{row.remarks}</TableCell>
                      {hasProductColumn && <TableCell>{row.productCode}</TableCell>}
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            </TableContainer>

            <Box sx={styles.actionButtons}>
              <Button variant="outlined" onClick={resetProcess} disabled={isCreatingBatch}>
                Back / Cancel
              </Button>
              <Button
                variant="contained"
                color="success"
                size="large"
                startIcon={isCreatingBatch ? <CircularProgress size={20} color="inherit" /> : <Send />}
                onClick={handleCreateBatch}
                disabled={isCreatingBatch}
              >
                {isCreatingBatch ? "Creating Batch..." : "Confirm & Create Batch"}
              </Button>
            </Box>
          </>
        )}
      </Paper>
    </Box>
  );
};
export default JournalBulkUpload;

