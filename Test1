import { useState, useEffect, useRef, useCallback } from "react";
import {
  Snackbar,
  IconButton,
  Divider,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Button,
  Box,
  Paper,
  Typography,
  Grid,
  Container,
  styled
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import ReactQuill from "react-quill";
import Quill from "quill";
import "react-quill/dist/quill.snow.css";
import axios from "axios";
import { encrypt } from "../../Security/AES-GCM256";
import PdfViewer from "../../PdfViewer/pdfViewer";

// Constants
const DRAFT_VARIABLES = [
  "{{DATE}}",
  "{{REF_NO}}",
  "{{FIRM_NAME}}",
  "{{FRN_NO}}",
  "{{FIRM_ADDR}}",
  "{{ASSIGNMENT_TYPE}}",
  "{{GSTN}}",
];

const WORD_LIMIT = 128;
const INITIAL_TEMPLATE = "<p>Hey there!</p>";

// Quill Configuration
const configureQuill = () => {
  const DirectionAttribute = Quill.import("attributors/attribute/direction");
  const AlignClass = Quill.import("attributors/class/align");
  const BackgroundClass = Quill.import("attributors/class/background");
  const ColorClass = Quill.import("attributors/class/color");
  const DirectionClass = Quill.import("attributors/class/direction");
  const FontClass = Quill.import("attributors/class/font");
  const SizeClass = Quill.import("attributors/class/size");
  const AlignStyle = Quill.import("attributors/style/align");
  const BackgroundStyle = Quill.import("attributors/style/background");
  const ColorStyle = Quill.import("attributors/style/color");
  const DirectionStyle = Quill.import("attributors/style/direction");
  const FontStyle = Quill.import("attributors/style/font");
  const SizeStyle = Quill.import("attributors/style/size");

  Quill.register(DirectionAttribute, true);
  Quill.register(AlignClass, true);
  Quill.register(BackgroundClass, true);
  Quill.register(ColorClass, true);
  Quill.register(DirectionClass, true);
  Quill.register(FontClass, true);
  Quill.register(SizeClass, true);
  Quill.register(AlignStyle, true);
  Quill.register(BackgroundStyle, true);
  Quill.register(ColorStyle, true);
  Quill.register(DirectionStyle, true);
  Quill.register(FontStyle, true);
  Quill.register(SizeStyle, true);

  const Size = Quill.import("formats/size");
  Size.whitelist = ["2px", "4px", "6px", "8px", "10px", "12px", "14px", "16px", "18px", "20px", "22px", "24px", "26px"];
  Quill.register(Size, true);

  const Font = Quill.import("formats/font");
  Font.whitelist = ["arial", "times-new-roman", "courier-new", "sans-serif", "serif", "monospace", "georgia", "tahoma", "verdana", "sofia"];
  Quill.register(Font, true);
};

configureQuill();

// Encryption setup
const iv = crypto.getRandomValues(new Uint8Array(12));
const ivBase64 = btoa(String.fromCharCode.apply(null, iv));
const salt = crypto.getRandomValues(new Uint8Array(16));
const saltBase64 = btoa(String.fromCharCode.apply(null, salt));

// Styled Components
const BootstrapDialog = styled(Dialog)(({ theme }) => ({
  "& .MuiDialogContent-root": {
    padding: theme.spacing(2),
  },
  "& .MuiDialogActions-root": {
    padding: theme.spacing(1),
  },
}));

const VariableTag = styled('span')(({ theme, draggable }) => ({
  margin: 10,
  backgroundColor: theme.palette.primary.main,
  padding: "10px 15px",
  cursor: draggable ? "move" : "default",
  borderRadius: "5px",
  color: "white",
  fontWeight: "bold",
  boxShadow: "0 4px 8px rgba(0, 0, 0, 0.2)",
  transition: "background-color 0.3s ease",
  display: "inline-block",
  opacity: draggable ? 1 : 0.6,
}));

// Main Component
const EmailTemplate = () => {
  const [value, setValue] = useState(INITIAL_TEMPLATE);
  const [snackbar, setSnackbar] = useState({ open: false, message: "" });
  const [wordCount, setWordCount] = useState(0);
  const [isEditing, setIsEditing] = useState(false);
  const [isPreviewing, setIsPreviewing] = useState(false);
  const [previewContent, setPreviewContent] = useState("");
  const [base64, setBase64] = useState(null);
  const [isFrontendPreview, setIsFrontendPreview] = useState(false);
  
  const editorRef = useRef(null);
  const user = JSON.parse(localStorage.getItem("user"));

  // Quill modules configuration
  const modules = {
    toolbar: [
      [{ font: Font.whitelist }],
      [{ size: ["8px", "10px", "12px", "14px", "16px", "18px", "20px", "22px", "24px", "26px"] }],
      [
        { color: ["red", "green", "blue", "black", "orange"] },
        { background: ["red", "green", "blue", "yellow", "gray"] },
      ],
      [{ align: "justify" }, { align: "center" }, { align: "right" }],
      [{ script: "sub" }, { script: "super" }],
      [{ header: [1, 2, 3, false] }],
      [{ list: "ordered" }, { list: "bullet" }],
      ["bold", "italic", "underline", "strike"],
      ["link", "image", "clean"],
      [{ indent: "-1" }, { indent: "+1" }],
    ],
    clipboard: {
      matchVisual: false,
    },
  };

  // Count words in text
  const countWord = useCallback((str) => {
    const text = str.replace(/<[^>]*>/g, "");
    const words = text.trim().split(/\s+/).filter(Boolean);
    return words.length;
  }, []);

  // Fetch template data
  const fetchData = useCallback(async () => {
    try {
      const response = await axios.post(
        "Server/IAMServices/EmailTemplate",
        {},
        { headers: { Authorization: `Bearer ${localStorage.getItem("token")}` } }
      );
      const res = response.data.result;
      setValue(res);
      setWordCount(countWord(res));
    } catch (error) {
      console.error("Error fetching template:", error);
      setSnackbar({ open: true, message: "Failed to load template" });
    }
  }, [countWord]);

  useEffect(() => {
    fetchData();
  }, [fetchData]);

  // Handle editor changes
  const handleChange = (content, delta, source, editor) => {
    const html = editor.getHTML();
    const length = countWord(html);

    if (length > WORD_LIMIT) {
      editorRef.current.editor.blur();
      setSnackbar({
        open: true,
        message: "Word limit exceeded. Click Edit to make changes.",
      });
      setIsEditing(false);
      return;
    }

    setValue(html);
    setWordCount(length);
  };

  // Handle drag start for variables
  const handleDragStart = (e) => {
    e.dataTransfer.setData("text", e.target.innerText);
  };

  // Handle drop event in editor
  const handleDrop = (e) => {
    e.preventDefault();
    const range = editorRef.current.editor?.getSelection(true);
    editorRef.current.editor?.insertText(
      range || 0,
      e.dataTransfer.getData("text")
    );
  };

  // Validate template variables
  const validateVariables = (content) => {
    const variables = content.match(/\{{2}[A-Z_]+\}{2}/g) || [];
    const invalidVariables = variables.filter(
      (variable) => !DRAFT_VARIABLES.includes(variable)
    );
    return invalidVariables.length === 0;
  };

  // Save template
  const handleSave = async () => {
    if (!validateVariables(value)) {
      setSnackbar({
        open: true,
        message: "Invalid variables detected. Please check your template.",
      });
      return;
    }

    const dataToSend = { MASTER_TEMPLATE: `<html>${value}</html>` };
    
    try {
      let encryptedData = await encrypt(iv, salt, JSON.stringify(dataToSend));
      const payload = {
        iv: ivBase64,
        salt: saltBase64,
        data: encryptedData,
      };

      await axios.post("Server/IAMServices/saveMasterTemplate", payload, {
        headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
      });

      setSnackbar({ open: true, message: "Template saved successfully!" });
      setIsPreviewing(false);
    } catch (error) {
      console.error("Error saving template:", error);
      setSnackbar({ open: true, message: "Failed to save template" });
    }
  };

  // Generate preview
  const generatePreview = async () => {
    const processedContent = value.replace(/<br\s*\/?>/gi, "<br></br>");
    const dataToSend = {
      user: { template: `<html><head>${processedContent}</head></html>` },
      data: {
        DATE: "xx/xx/xxxx",
        REF_NO: "0000xxx",
        FIRM_NAME: "xxxxxxxxxx",
        FRN_NO: "45687",
        GSTN: "27AAHCK850D1ZK",
        FIRM_ADDR: "NAVI MUMBAI, BELPAUR",
        ASSIGNMENT_TYPE: "INTERNAL",
      },
    };

    try {
      let encryptedData = await encrypt(iv, salt, JSON.stringify(dataToSend));
      const payload = {
        iv: ivBase64,
        salt: saltBase64,
        data: encryptedData,
      };

      const response = await axios.post(
        "Server/IAMServices/generateTemplate",
        payload,
        { headers: { Authorization: `Bearer ${localStorage.getItem("token")}` } }
      );

      if (response.data.statusCode === 200 && response.data.result) {
        setPreviewContent(processedContent);
        setBase64(response.data.result);
        setIsPreviewing(true);
      }
    } catch (error) {
      console.error("Error generating preview:", error);
      setSnackbar({ open: true, message: "Failed to generate preview" });
    }
  };

  // Reset template
  const handleReset = async () => {
    try {
      const response = await axios.post(
        "Server/IAMServices/resetTemplate",
        {},
        { headers: { Authorization: `Bearer ${localStorage.getItem("token")}` } }
      );
      setValue(response.data.result);
      setSnackbar({ open: true, message: "Template reset successfully" });
    } catch (error) {
      console.error("Error resetting template:", error);
      setSnackbar({ open: true, message: "Failed to reset template" });
    }
  };

  // Preview dialog component
  const PreviewDialog = ({ open, onClose, content }) => (
    <BootstrapDialog onClose={onClose} open={open} maxWidth="md" fullWidth>
      <DialogTitle sx={{ m: 0, p: 2 }}>
        Intimation letter draft preview
      </DialogTitle>
      <IconButton
        aria-label="close"
        onClick={onClose}
        sx={(theme) => ({
          position: "absolute",
          right: 8,
          top: 8,
          color: theme.palette.grey[500],
        })}
      >
        <CloseIcon />
      </IconButton>
      <DialogContent dividers>
        {isFrontendPreview ? (
          <div
            className="ql-editor"
            dangerouslySetInnerHTML={{ __html: content }}
          />
        ) : (
          <PdfViewer base64={base64} />
        )}
      </DialogContent>
      <DialogActions>
        <Button onClick={onClose} color="secondary">
          Close
        </Button>
        <Button onClick={handleSave} color="primary" variant="contained">
          Save Template
        </Button>
      </DialogActions>
    </BootstrapDialog>
  );

  return (
    <>
      <Typography gutterBottom variant="h5" component="div">
        Empanelment Intimation Letter Template
      </Typography>
      <Divider />
      
      <Grid container spacing={2} sx={{ p: 2 }}>
        {/* Variables Panel */}
        <Grid item xs={12} md={4}>
          <Box sx={{ height: "100%", width: "100%", borderRadius: 2, boxShadow: 2 }}>
            <Paper sx={{ height: "48%", mb: "30px", p: 2 }}>
              <Typography variant="h6" gutterBottom>
                Available Variables
              </Typography>
              <Divider />
              <Box sx={{ mt: 2 }}>
                {DRAFT_VARIABLES.map((variable) => (
                  <VariableTag
                    key={variable}
                    draggable={isEditing}
                    onDragStart={handleDragStart}
                  >
                    {variable}
                  </VariableTag>
                ))}
              </Box>
            </Paper>
            
            <Paper sx={{ height: "48%", p: 2 }}>
              <Typography variant="h6" gutterBottom>
                Instructions
              </Typography>
              <Divider />
              <Container sx={{ mt: 2 }}>
                <ul>
                  <li>Drag and drop variables into the editor</li>
                  <li>Word limit: {WORD_LIMIT} words</li>
                  <li>Only allowed variables can be used</li>
                  <li>Save your template when done</li>
                </ul>
              </Container>
            </Paper>
          </Box>
        </Grid>

        {/* Editor Panel */}
        <Grid item xs={12} md={8}>
          <Box sx={{ width: "100%", borderRadius: 2, boxShadow: 2, p: 2 }}>
            <Typography variant="h6" gutterBottom>
              Template Editor
            </Typography>
            <Divider />
            
            <Paper sx={{ p: 2, mt: 2 }}>
              <Box sx={{ height: "55vh", overflowY: "auto" }}>
                <ReactQuill
                  theme="snow"
                  modules={modules}
                  value={value}
                  ref={editorRef}
                  onDragover={(e) => e.preventDefault()}
                  onDrop={handleDrop}
                  onChange={handleChange}
                  readOnly={!isEditing}
                  formats={[
                    "size",
                    "align",
                    "color",
                    "font",
                    "bold",
                    "italic",
                    "underline",
                    "strike",
                    "list",
                    "bullet",
                    "link",
                    "image",
                    "background",
                    "header",
                    "script",
                    "indent",
                  ]}
                  style={{ height: "450px" }}
                />
              </Box>
              
              <Divider sx={{ my: 2 }} />
              
              <Box sx={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                <Typography variant="body2" color="textSecondary">
                  Word Count: {wordCount} / {WORD_LIMIT}
                </Typography>
                
                <Box>
                  {!isEditing ? (
                    <Button
                      variant="contained"
                      color="primary"
                      onClick={() => setIsEditing(true)}
                      sx={{ mr: 1 }}
                    >
                      Edit
                    </Button>
                  ) : (
                    <Button
                      variant="outlined"
                      color="error"
                      onClick={() => setIsEditing(false)}
                      sx={{ mr: 1 }}
                    >
                      Cancel
                    </Button>
                  )}
                  
                  <Button
                    variant="contained"
                    color="info"
                    onClick={generatePreview}
                    sx={{ mr: 1 }}
                    disabled={isEditing}
                  >
                    Preview
                  </Button>
                  
                  <Button
                    variant="contained"
                    color="secondary"
                    onClick={() => {
                      setIsFrontendPreview(true);
                      setIsPreviewing(true);
                      setPreviewContent(value);
                    }}
                    sx={{ mr: 1 }}
                    disabled={isEditing}
                  >
                    HTML Preview
                  </Button>
                  
                  <Button
                    variant="contained"
                    color="warning"
                    onClick={handleReset}
                    disabled={isEditing}
                  >
                    Reset
                  </Button>
                </Box>
              </Box>
            </Paper>
          </Box>
        </Grid>
      </Grid>

      {/* Preview Dialog */}
      <PreviewDialog
        open={isPreviewing}
        onClose={() => {
          setIsPreviewing(false);
          setIsFrontendPreview(false);
        }}
        content={previewContent}
      />

      {/* Snackbar for notifications */}
      <Snackbar
        open={snackbar.open}
        autoHideDuration={6000}
        onClose={() => setSnackbar({ open: false, message: "" })}
        message={snackbar.message}
      />
    </>
  );
};

export default EmailTemplate;
