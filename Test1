  useEffect(() => {
    const handleBeforeUnload = (e) => {
      // 1. THE MICROSECOND RELEASE: If they close the tab, instantly drop the Redis lock via Beacon
      if (lockedVidRef.current) {
        navigator.sendBeacon(`/api/voucher/unlock/${lockedVidRef.current}`);
      }

      // 2. THE WARNING: If they are on Step 3 and haven't clicked the final submit button yet
      if (activeStep === 3 && !isFinalizing) {
        e.preventDefault();
        e.returnValue = "You have an unfinalized batch. If you leave, it will not be sent for approval!";
      }
    };

    window.addEventListener("beforeunload", handleBeforeUnload);

    return () => {
      window.removeEventListener("beforeunload", handleBeforeUnload);
    };
  }, [activeStep, isFinalizing]); // Dependencies kept updated

