router.post("/sendEmail", extractToken, DataValidator, async (req, res) => {
  if (req.user.user_role !== "1") {
    return res.status(401).json({
      message: "Unauthorized api call, request not from legal source",
    });
  }

  try {
    // Logging for debugging
    console.log("req.data", req.data);
    console.log("req.user", req.user);

    // Prepare payload
    const payload = {
      user: {
        template: "",
        financial_year: req.user.financial_year,
        pf_number: req.user.pf_number,
      },
      data: { firms: req.data },
    };

    // Send request to external service
    const response = await fetch(
      "http://10.0.26.158:8081/FRNController/generateAllPdf",
      {
        method: "POST",
        body: JSON.stringify(payload),
        headers: {
          "Content-Type": "application/json",
        },
      }
    );

    // Parse and send back response
    const data = await response.json();
    res.json(data);
  } catch (e) {
    res.status(500).json({
      status: "Failed to bring reports list, no connection between LB and APP",
    });
  }
});