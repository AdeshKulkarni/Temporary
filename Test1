/* ----- Variable Tag Styling (Slate Editor) ----- */
.variable-blot {
  background-color: #A9A9A9;
  color: black;
  padding: 5px 20px 5px 8px;
  margin: 0 4px;
  border-radius: 3px;
  position: relative;
  user-select: none;
  cursor: default;
  display: inline-block;
  font-weight: 500;
  font-family: inherit;
  transition: box-shadow 0.1s;
  box-shadow: 1px 1px 2px #eee;
}

.variable-delete-icon {
  display: none;
  position: absolute;
  right: 5px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 12px;
  font-weight: bold;
  font-family: monospace;
  color: black;
  cursor: pointer;
  background: #f4f4f488;
  padding: 0 2px;
  border-radius: 50%;
  z-index: 2;
}

.variable-blot:hover .variable-delete-icon {
  display: inline-block;
}

.variable-blot:active {
  box-shadow: 0 0 6px #1976d2;
}

.invalid-variable {
  text-decoration: underline wavy red;
  background-color: #ffebee;
}

.preview-variable {
  background: #e3f2fd;
  padding: 4px 8px;
  margin: 0 2px;
  border-radius: 3px;
  display: inline-block;
  font-family: monospace;
  font-size: 1em;
}

.ql-editor .draggable-tag,
.slate-editor .draggable-tag {
  position: relative;
  display: inline-block;
  vertical-align: middle;
  margin-right: 4px;
}

.ql-editor .draggable-tag .remove-tag-button,
.slate-editor .draggable-tag .remove-tag-button {
  display: none;
  position: absolute;
  right: 1px;
  top: -2px;
  cursor: pointer;
  font-size: 14px;
  font-weight: bold;
  color: #ffbaba;
  padding: 0 4px;
  background-color: white;
  border-radius: 50%;
  line-height: 1;
}

.ql-editor .draggable-tag:hover .remove-tag-button,
.slate-editor .draggable-tag:hover .remove-tag-button {
  display: inline;
}

/*--- Some typographic reset for better visuals ---*/
.slate-editor, .ql-editor {
  line-height: 1.55;
  font-size: 15px;
}

/*--- Bold/italic/underline preview ---*/
.slate-editor b, .slate-editor strong { font-weight: bold; }
.slate-editor i, .slate-editor em { font-style: italic; }
.slate-editor u { text-decoration: underline; }

/*--- Just an example for editable/readonly backgrounds ---*/
.slate-editor[contenteditable="false"] {
  background: #f5f5f5;
  color: #888;
}

.slate-editor[contenteditable="true"] {
  background: #fff;
  color: #393939;
}

/* --- Make chip drag highlight, optional --- */
.MuiChip-root[draggable="true"]:active {
  box-shadow: 0 0 8px #1976d2;
  background: #b7d2f5;
}
