public void streamBatchExcel(String batchId, java.io.OutputStream outputStream) throws java.io.IOException {
    try (org.apache.poi.xssf.streaming.SXSSFWorkbook workbook = new org.apache.poi.xssf.streaming.SXSSFWorkbook(100)) {
        org.apache.poi.ss.usermodel.Sheet sheet = workbook.createSheet("Batch Details");
        
        // Header
        String[] headers = {"Branch", "Currency", "CGL", "Amount", "Type", "Remarks", "Product Code"};
        org.apache.poi.ss.usermodel.Row headerRow = sheet.createRow(0);
        for (int i = 0; i < headers.length; i++) {
            headerRow.createCell(i).setCellValue(headers[i]);
        }

        // The query matches your schema exactly
        String sql = "SELECT REQ_BRANCH_CODE, REQ_CURRENCY, REQ_CGL, REQ_AMOUNT, REQ_NARRATION, REQ_PRODUCT FROM VOUCHER_POSTING_DATA WHERE BATCH_ID = ?";
        
        int[] rowIdx = {1};
        jdbcTemplate.query(sql, rs -> {
            org.apache.poi.ss.usermodel.Row row = sheet.createRow(rowIdx[0]++);
            
            // FIX: The keys here must exactly match the SELECT clause above
            row.createCell(0).setCellValue(rs.getString("REQ_BRANCH_CODE"));
            row.createCell(1).setCellValue(rs.getString("REQ_CURRENCY"));
            row.createCell(2).setCellValue(rs.getString("REQ_CGL"));
            
            BigDecimal amt = rs.getBigDecimal("REQ_AMOUNT");
            if (amt != null) {
                row.createCell(3).setCellValue(amt.abs().doubleValue());
                row.createCell(4).setCellValue(amt.compareTo(BigDecimal.ZERO) < 0 ? "Credit" : "Debit");
            }
            
            row.createCell(5).setCellValue(rs.getString("REQ_NARRATION"));
            row.createCell(6).setCellValue(rs.getString("REQ_PRODUCT"));
        }, batchId);

        workbook.write(outputStream);
        workbook.dispose();
    }
}
