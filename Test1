            <Alert severity="warning" sx={jaStyles.lapseAlert}>
              The originally scheduled execution time{" "}
              <strong>
                {vidDetails?.SCHEDULED_TIME ? formatDateTime(vidDetails.SCHEDULED_TIME) : "N/A"}
