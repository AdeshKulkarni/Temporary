      /**
       * Searches for CGLs by CGL Number or Description.
       * @param query The search term from the user (e.g., "123" or "Cash")
       * @return A list of matching CGLs
       */
      public List<CglDto> searchCgls(String query) {
        
          boolean hasQuery = StringUtils.hasText(query); 
          
          if (!hasQuery) {
              log.info("No CGL query provided.");
              return List.of(); 
          }

          log.info("Searching CGLs by query '{}'", query);
          // Call the new combined repository method
          List<CglMaster> results = cglMasterRepository
                  .findByCglNumberContainingOrDescriptionContainingIgnoreCase(query, query);
          
          return results.stream()
                  .map(this::convertToDto)
                  .collect(Collectors.toList());
      }
    
