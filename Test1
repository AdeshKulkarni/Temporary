                            <Typography
                              component="span"
                              color="primary"
                              onClick={() => setIsDescExpanded(!isDescExpanded)}
                              sx={{ cursor: "pointer", ml: 1, fontWeight: "bold", '&:hover': { textDecoration: 'underline' } }}
                            >
                              {isDescExpanded ? "Read Less" : "Read More"}
