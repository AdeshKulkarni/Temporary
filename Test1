const handlePreview = async () => {
  setIsEditing(false);

  // Replace variables with dummy values
  const dummyData = {
    DATE: "31/03/2025",
    REF_NO: "1001",
    FIRM_NAME: "TRINITY ENT",
    FRN_NO: "45687",
    GSTN: "27AAHCK850D1ZK",
    FIRM_ADDR: "NAVI MUMBAI, BELAPUR",
    ASSIGNMENT_TYPE: "INTERNAL",
  };

  let content = value;
  Object.entries(dummyData).forEach(([key, val]) => {
    const regex = new RegExp(`{{${key}}}`, "g");
    content = content.replace(regex, val);
  });

  // Optional HTML fix for <br> tags (you already had this)
  let StrToSend = content.replace(/<br\s*\/?>/gi, "<br></br>");
  settemplateContent(StrToSend); // For preview in frontend modal
  console.log("Final Content for Backend Preview: ", StrToSend);

  // Payload structure
  let dataToSend = {
    user: { template: `<html><head>${StrToSend}</head></html>` },
    data: dummyData,
  };

  try {
    let jsonFormData = JSON.stringify(dataToSend);
    await encrypt(iv, salt, jsonFormData).then(function (result) {
      jsonFormData = result;
    });
    let payload = {
      iv: ivBase64,
      salt: saltBase64,
      data: jsonFormData,
    };

    const response = await axios.post(
      "Server/IAMServices/generateTemplate",
      payload,
      {
        headers: {
          Authorization: `Bearer ${localStorage.getItem("token")}`,
        },
      }
    );

    console.log("Backend response:", response.data.result);

    if (response.data.statusCode === 200 && response.data.result !== "") {
      setPreviewContent(true);
      setIsPreviewing(true);
      setBase64(response.data.result); // You can use this base64 for PDF Viewer if needed
    }
  } catch (error) {
    console.error("Error generating template:", error);
  }
};


