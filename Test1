            <queryString>
                  <![CDATA[SELECT  map_sc1,
mp.map_type,
mp.map_comp,
  (case when     $P{TYPE}    ='PRE' then  sum (NVL(mst.PRE,0))
            when     $P{TYPE} ='POST' then  sum( NVL(mst.PRE,0)  + nvl(MOC_AMT,0) ) end) PRE
FROM  BS_MAP mp
LEFT OUTER join bs_master_vw mst
ON ((
  CASE
    WHEN mp.map_type IN('LIABILITY','ASSET')
    THEN 'YSA'
      ||mp.MAP_COMP
    WHEN mp.map_type IN('INCOME','EXPENSE')
    THEN 'PNL'
      ||mp.MAP_COMP
  END            =mst.comp_code))
  LEFT OUTER JOIN (SELECT moc_head,moc_comp,sum(nvl(moc_amt,0))moc_amt FROM
bs_moc WHERE moc_date=to_date( $P{DATE} ,'dd/mm/yyyy')
 GROUP BY moc_head,moc_comp,moc_circle) ON (moc_head=MAP_TYPE AND MOC_COMP=MAP_COMP    )
WHERE mp.MAP_SCH = '5A'
group by
  mp.map_sc1,
map_type,
mp.map_comp
order by map_sc1,
map_type]]>
            </queryString>
