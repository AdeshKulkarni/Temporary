                FROM JOURNAL_REQUEST jr WHERE jr.REQ_STATUS = 'P' AND jr.CREATOR_ID != ? AND 
            """ + targetClause;
            List<Object> iArgs = new ArrayList<>(); iArgs.add(executorId); iArgs.addAll(args);
