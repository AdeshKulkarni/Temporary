# ==========================================
# 1. APPLICATION & ACTUATOR SETTINGS
# ==========================================
spring.application.name=VoucherService
#spring.profiles.active=dev

management.endpoints.web.exposure.include=*
management.endpoint.health.show-details=always
info.app.name=JournalService
info.app.description=Service for managing journals.
info.app.version=1.0.0

# ==========================================
# 2. JWT & FILE UPLOAD LIMITS
# ==========================================
jwt.secret=bWV0aGlvbnlsdGhyZW9ueWx0aHJlb255bGdsdXRhbWlueWxhbGFueWw=

# 600k rows in Excel can be 50MB+. Ensure Spring accepts it.
spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=50MB

# ==========================================
# 3. REDIS & KAFKA/TOPIC CONFIGURATION
# ==========================================
notification.progress.topic=notifications:progress

# Ensure timeouts are set so a Redis glitch doesn't hang the app
spring.data.redis.host=IP
spring.data.redis.port=6379
spring.data.redis.timeout=2000
spring.data.redis.jedis.pool.max-active=50
spring.data.redis.jedis.pool.max-idle=10
spring.data.redis.jedis.pool.min-idle=5

# ==========================================
# 4. ASYNC EXECUTOR TUNING
# ==========================================
app.async.core-pool-size=5
app.async.max-pool-size=20
app.async.queue-capacity=500


# ==========================================
# 5. PRIMARY DATABASE: ORACLE (High Traffic)
# ==========================================
# NOTE: Prefix must be exactly "spring.datasource" to match OracleDbConfig.java
spring.datasource.url=url
spring.datasource.username=sds
spring.datasource.password=sdsd#1234
spring.datasource.driver-class-name=oracle.jdbc.OracleDriver

# Oracle Hibernate Settings
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.OracleDialect
spring.jpa.show-sql=false

# Oracle HikariCP Settings (Handles 1 Lakh+ Users)
spring.datasource.hikari.maximum-pool-size=65
spring.datasource.hikari.minimum-idle=10
spring.datasource.hikari.idle-timeout=300000
spring.datasource.hikari.connection-timeout=60000
spring.datasource.hikari.max-lifetime=1800000


# ==========================================
# 6. SECONDARY DATABASE: HIVE (Delta Lake)
# ==========================================
# NOTE: Prefix must be exactly "spring.hive.datasource" to match HiveConfig.java
spring.hive.datasource.url=jdbc:hive2://localhost:10000/fincoredatalakejournal
spring.hive.datasource.username=spark
spring.hive.datasource.driver-class-name=org.apache.hive.jdbc.HiveDriver

# Hive Validation
spring.hive.datasource.test-on-borrow=true
spring.hive.datasource.validation-query=SELECT 1

# Hive HikariCP Settings (Kept smaller so Hadoop doesn't crash)
spring.hive.datasource.hikari.maximum-pool-size=10
spring.hive.datasource.hikari.minimum-idle=2
spring.hive.datasource.hikari.idle-timeout=300000
spring.hive.datasource.hikari.connection-timeout=60000
spring.hive.datasource.hikari.max-lifetime=1800000
