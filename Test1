import React, { useState, useMemo, useEffect } from "react";
import {
  Box,
  Typography,
  Fab,
  Dialog,
  DialogActions,
  DialogContent,
  DialogTitle,
  TextField,
  Button,
} from "@mui/material";
import { DataGrid, GridActionsCellItem } from "@mui/x-data-grid";
import AddIcon from "@mui/icons-material/Add";
import EditIcon from "@mui/icons-material/Edit";
import useApi from "../../../hooks/useApi"; // Assuming correct path
import useCustomSnackbar from "../../../utils/useCustomSnackbar"; // Assuming correct path

// Initial state for the form in the dialog
const initialFormState = {
  currencyCode: "",
  currencyName: "",
  currencyRate: "",
};

export default function CurrencyMaster() {
  // --- Hooks and State from both files ---
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const [rows, setRows] = useState([]);
  const [isLoading, setIsLoading] = useState(true);

  // State for Dialog and Form Management (from second file)
  const [isDialogOpen, setIsDialogOpen] = useState(false);
  const [formData, setFormData] = useState(initialFormState);
  const [editingRow, setEditingRow] = useState(null);
  const [errors, setErrors] = useState({});

  // --- Core Data Fetching Logic (from first file) ---
  const fetchData = async () => {
    setIsLoading(true);
    try {
      const response = await callApi("CM/currency-master", null, "GET");

      if (response && response.data && Array.isArray(response.data)) {
        // Using currencyCode as the unique 'id' for the DataGrid is crucial
        const dataWithIds = response.data.map((row) => ({
          ...row,
          id: row.currencyCode,
        }));

        setRows(dataWithIds);
        if (dataWithIds.length === 0) {
          showSnackBar("No currency data found.", "info");
        }
      } else {
        showSnackBar("Received invalid data format.", "error");
        setRows([]);
      }
    } catch (error) {
      console.error("Error fetching currency data:", error);
      showSnackBar(
        "Something went wrong while fetching data. Please try again later.",
        "error"
      );
      setRows([]);
    } finally {
      setIsLoading(false);
    }
  };

  // Fetch data on initial component mount
  useEffect(() => {
    fetchData();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  // --- Dialog and Form Handlers (from second file) ---

  const handleOpenDialog = () => {
    setEditingRow(null);
    setFormData(initialFormState);
    setErrors({});
    setIsDialogOpen(true);
  };

  const handleCloseDialog = () => {
    setIsDialogOpen(false);
    setEditingRow(null);
    setFormData(initialFormState);
    setErrors({});
  };
  
  const handleEditClick = (id) => () => {
    const rowToEdit = rows.find((row) => row.id === id);
    if (rowToEdit) {
      setEditingRow(rowToEdit);
      setFormData({
        currencyCode: rowToEdit.currencyCode,
        currencyName: rowToEdit.currencyName,
        currencyRate: rowToEdit.currencyRate,
      });
      setErrors({});
      setIsDialogOpen(true);
    }
  };

  const validate = () => {
    let tempErrors = {};
    
    // Validate Currency Name
    if (!formData.currencyName?.trim()) {
        tempErrors.currencyName = "Currency Name is required.";
    } else if (/\d/.test(formData.currencyName)) {
        tempErrors.currencyName = "Numbers are not allowed in Currency Name.";
    }

    // Only validate code and rate for new entries (since they are disabled for edits)
    if (!editingRow) {
        if (!formData.currencyCode?.trim()) {
            tempErrors.currencyCode = "Currency Code is required.";
        } else if (formData.currencyCode.length !== 3) {
            tempErrors.currencyCode = "Currency Code must be exactly 3 characters.";
        }
        
        if (!String(formData.currencyRate).trim()) {
            tempErrors.currencyRate = "Currency Rate is required.";
        }
    }

    setErrors(tempErrors);
    // Returns true if there are no errors
    return Object.keys(tempErrors).length === 0;
  };


  const handleInputChange = (e) => {
    const { name, value } = e.target;
    let processedValue = value;

    // Apply specific rules for each input field
    if (name === 'currencyCode') {
        processedValue = value.toUpperCase().slice(0, 3).replace(/[^A-Z]/g, '');
    }
    if (name === 'currencyName') {
        processedValue = value.slice(0, 30).replace(/[^a-zA-Z\s]/g, '');
    }
    if (name === 'currencyRate') {
        if (value !== "" && !/^\d{0,6}(\.\d{0,6})?$/.test(value)) {
           return; // Do not update state if the format is invalid
        }
        processedValue = value;
    }

    setFormData({ ...formData, [name]: processedValue });
    // Clear the error for the field being edited
    if (errors[name]) {
        setErrors({ ...errors, [name]: '' });
    }
  };


  // --- MODIFIED: handleSubmit to include API call and console log ---
  const handleSubmit = async () => {
    if (!validate()) {
      return; // Stop submission if validation fails
    }

    // *** As requested: Log the JSON data to the console ***
    console.log("Submitting JSON data:", formData);

    const isEditing = !!editingRow;
    const method = isEditing ? "PUT" : "POST";
    // For PUT, you might need to specify the ID in the URL
    const endpoint = isEditing ? `CM/currency-master/${editingRow.currencyCode}` : "CM/currency-master";

    try {
      // You can customize the payload if your backend expects something different
      const payload = { ...formData };
      
      await callApi(endpoint, payload, method);

      showSnackBar(
        `Currency successfully ${isEditing ? "updated" : "added"}!`,
        "success"
      );
      handleCloseDialog();
      fetchData(); // Refresh the data grid to show the new/updated data
    } catch (error) {
      console.error("Error submitting currency:", error);
      showSnackBar(
        error.response?.data?.message || `Failed to ${isEditing ? "update" : "add"} currency.`,
        "error"
      );
    }
  };

  // --- Column Definitions (Merged from both files) ---
  const columns = useMemo(
    () => [
      {
        field: "currencyCode",
        headerName: "Currency Code",
        flex: 1,
        sortable: true,
        align: "center",
        headerAlign: "center",
      },
      {
        field: "currencyName",
        headerName: "Currency Name",
        flex: 2,
        sortable: true,
        align: "center",
        headerAlign: "center",
      },
      {
        field: "currencyRate",
        headerName: "Currency Rate",
        type: "number",
        flex: 1,
        sortable: true,
        align: "center",
        headerAlign: "center",
      },
      {
        field: "updatedAt",
        headerName: "Last Updated",
        flex: 1,
        sortable: true,
        align: "center",
        headerAlign: "center",
        valueFormatter: (params) =>
          params.value ? new Date(params.value).toLocaleString() : "N/A",
      },
      // --- ADDED: Actions column for Edit button ---
      {
        field: "actions",
        type: "actions",
        headerName: "Actions",
        width: 80,
        headerAlign: "center",
        align: "center",
        cellClassName: "actions",
        getActions: ({ id }) => [
          <GridActionsCellItem
            icon={<EditIcon />}
            label="Edit"
            onClick={handleEditClick(id)}
            color="primary"
          />,
        ],
      },
    ],
    // eslint-disable-next-line react-hooks/exhaustive-deps
    [rows] // Dependency added to re-render actions when rows change
  );


  // --- JSX / Rendering (Merged from both files) ---
  return (
    <Box sx={{ p: 3 }}>
        <Typography variant="h4" component="h1" sx={{ fontWeight: '600', color: 'primary.main', textAlign: 'center', mb: 3 }}>
            Currency Master
        </Typography>
        <DataGrid
            rows={rows}
            columns={columns}
            disableRowSelectionOnClick
            pageSizeOptions={[5, 10, 25, 50]}
            initialState={{
            pagination: { paginationModel: { pageSize: 10, page: 0 } },
            sorting: { sortModel: [{ field: "updatedAt", sort: "desc" }] },
            }}
            loading={isLoading}
            autoHeight
            sx={{
                width: "100%",
                "& .MuiDataGrid-cell:focus, & .MuiDataGrid-cell:focus-within": {
                    outline: "none",
                },
                "& .MuiDataGrid-row:nth-of-type(odd)": {
                    backgroundColor: (theme) => theme.palette.action.hover,
                },
            }}
        />

        {/* --- ADDED: Floating Action Button --- */}
        <Fab
            color="primary"
            aria-label="add"
            onClick={handleOpenDialog}
            sx={{ position: "fixed", bottom: 30, right: 30 }}
        >
            <AddIcon />
        </Fab>

        {/* --- ADDED: Dialog for Add/Edit Form --- */}
        <Dialog open={isDialogOpen} onClose={handleCloseDialog} fullWidth maxWidth="sm">
            <DialogTitle sx={{ fontWeight: "bold" }}>
            {editingRow ? "Edit Currency" : "Add New Currency"}
            </DialogTitle>
            <DialogContent>
            <TextField
                autoFocus
                margin="dense"
                name="currencyCode"
                label="Currency Code"
                type="text"
                fullWidth
                variant="outlined"
                value={formData.currencyCode}
                onChange={handleInputChange}
                error={!!errors.currencyCode}
                helperText={errors.currencyCode}
                disabled={!!editingRow}
                inputProps={{ maxLength: 3 }}
            />
            <TextField
                margin="dense"
                name="currencyName"
                label="Currency Name"
                type="text"
                fullWidth
                variant="outlined"
                value={formData.currencyName}
                onChange={handleInputChange}
                error={!!errors.currencyName}
                helperText={errors.currencyName}
                inputProps={{ maxLength: 30 }}
            />
            <TextField
                margin="dense"
                name="currencyRate"
                label="Currency Rate"
                type="text" // Use text to allow for better control over decimal input
                fullWidth
                variant="outlined"
                value={formData.currencyRate}
                onChange={handleInputChange}
                error={!!errors.currencyRate}
                helperText={errors.currencyRate}
                disabled={!!editingRow}
            />
            </DialogContent>
            <DialogActions sx={{ p: "16px 24px" }}>
            <Button onClick={handleCloseDialog}>Cancel</Button>
            <Button onClick={handleSubmit} variant="contained">
                Submit
            </Button>
            </DialogActions>
        </Dialog>
    </Box>
  );
}
