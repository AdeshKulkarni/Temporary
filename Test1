package com.fincore.VoucherService.Service.core;

import com.fincore.VoucherService.Exception.CustomExceptions;
import com.fincore.VoucherService.Models.JournalRequest;
import com.fincore.VoucherService.Repository.JournalRequestRepository;
import com.fincore.VoucherService.Repository.VoucherWorkflowRepository;
import com.fincore.VoucherService.config.SecuritySanitizer;
import lombok.extern.slf4j.Slf4j;
import org.apache.poi.xssf.streaming.SXSSFWorkbook;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.dao.EmptyResultDataAccessException;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Service;

import java.math.BigDecimal;
import java.sql.Timestamp;
import java.time.Duration;
import java.time.LocalDateTime;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

@Service
@Slf4j
public class VoucherQueryService {

    @Autowired
    @Qualifier("oracleJdbcTemplate")
    private JdbcTemplate jdbcTemplate;

    private final JournalRequestRepository journalRequestRepository;
    private final VoucherWorkflowRepository workflowRepository;

    public VoucherQueryService(JournalRequestRepository journalRequestRepository, VoucherWorkflowRepository workflowRepository) {
        this.journalRequestRepository = journalRequestRepository;
        this.workflowRepository = workflowRepository;
    }

    public long getRequestCountByBatchId(String batchId) {
        log.info("COUNT_QUERY_START | BatchID: {}", SecuritySanitizer.sanitizeForLog(batchId));
        String safeBatchId = SecuritySanitizer.sanitizeId(batchId); 
        
        // CRITICAL FIX: Changed table name from the non-existent 'voucher_requests' to 'REQUEST_VOUCHER'
        // NOTE: If your actual database table name is different (like 'JOURNAL_REQUEST'), please change it here!
        String sql = "SELECT COUNT(*) FROM REQUEST_VOUCHER WHERE batch_id = '" + safeBatchId + "'";
        Long count = jdbcTemplate.queryForObject(sql, Long.class);
        return count != null ? count : 0L;
    }

    public List<Map<String, Object>> getWorkflowHistory(String batchId) {
        log.info("WORKFLOW_HISTORY_FETCH | BatchID: {}", SecuritySanitizer.sanitizeForLog(batchId));

        String sql = """
        SELECT 
            w.LAST_ACTION_BY, 
            COALESCE(u.FIRST_NAME || ' ' || u.LAST_NAME, w.LAST_ACTION_BY) AS ACTION_USER_NAME, 
            w.LAST_ACTION, 
            w.LAST_ACTION_AT, 
            w.REMARKS,
            w.SCHEDULED_TIME
        FROM VOUCHER_WORKFLOW w 
        LEFT JOIN USERS u ON w.LAST_ACTION_BY = u.USER_ID
        WHERE w.BATCH_ID_FK = ? 
        ORDER BY w.LAST_ACTION_AT ASC
        """;

        List<Map<String, Object>> history = jdbcTemplate.queryForList(sql, batchId);

        for (int i = 0; i < history.size() - 1; i++) {
            LocalDateTime start = ((Timestamp) history.get(i).get("LAST_ACTION_AT")).toLocalDateTime();
            LocalDateTime end = ((Timestamp) history.get(i + 1).get("LAST_ACTION_AT")).toLocalDateTime();

            Duration d = Duration.between(start, end);
            String durationStr = d.toHours() + "h " + d.toMinutesPart() + "m";
            history.get(i).put("TIME_TAKEN", durationStr);
        }
        return history;
    }

    public Map<String, Object> getBatchSummaryDetails(String batchId) {
        log.info("BATCH_SUMMARY_FETCH | BatchID: {}", SecuritySanitizer.sanitizeForLog(batchId));

        String sql = """
            SELECT 
                vp.BATCH_ID,
                vp.STATUS,
                vp.TOTAL_AMOUNT,
                vp.CREATED_BY,
                rv.CREATED_BY as VID_CREATED_BY,
                COALESCE(u.FIRST_NAME || ' ' || u.LAST_NAME, vp.CREATED_BY) AS BATCH_CREATOR_NAME,
                COALESCE(vu.FIRST_NAME || ' ' || vu.LAST_NAME, rv.CREATED_BY) AS VID_CREATOR_NAME
            FROM VOUCHER_POSTING vp
            LEFT JOIN REQUEST_VOUCHER rv ON vp.VID_FK = rv.VID
            LEFT JOIN USERS u ON vp.CREATED_BY = u.USER_ID
            LEFT JOIN USERS vu ON rv.CREATED_BY = vu.USER_ID
            WHERE vp.BATCH_ID = ?
        """;

        try {
            return jdbcTemplate.queryForMap(sql, batchId);
        } catch (EmptyResultDataAccessException e) {
            return new HashMap<>();
        }
    }

    public byte[] generateBatchExcel(String batchId) {
        
        String safeBatchId = SecuritySanitizer.sanitizeId(batchId);
        int initialBufferSize = 5 * 1024 * 1024; // 5 MB

        try (SXSSFWorkbook workbook = new SXSSFWorkbook(100);
             java.io.ByteArrayOutputStream out = new java.io.ByteArrayOutputStream(initialBufferSize)) {

            org.apache.poi.ss.usermodel.Sheet sheet = workbook.createSheet("Batch_" + safeBatchId);
            org.apache.poi.ss.usermodel.Row headerRow = sheet.createRow(0);
            String[] columns = {"Branch", "Currency", "CGL", "Amount", "Dr/Cr", "Remarks", "Product Code"};

            for (int i = 0; i < columns.length; i++) {
                org.apache.poi.ss.usermodel.Cell cell = headerRow.createCell(i);
                cell.setCellValue(columns[i]);
            }

            // CRITICAL FIX: Fixed Oracle Error 942! Changed table to 'REQUEST_VOUCHER' and column to 'REQ_BRANCH_CODE'.
            // NOTE: If your actual database table is different, please change 'REQUEST_VOUCHER' below.
            String sql = "SELECT REQ_BRANCH_CODE, REQ_CURRENCY, REQ_CGL, REQ_AMOUNT, REQ_NARRATION, REQ_PRODUCT " +
                         "FROM REQUEST_VOUCHER WHERE batch_id = '" + safeBatchId + "'";

            final int[] rowIdx = {1};
            
            jdbcTemplate.query(
                    connection -> {
                        java.sql.PreparedStatement ps = connection.prepareStatement(
                                sql,
                                java.sql.ResultSet.TYPE_FORWARD_ONLY,
                                java.sql.ResultSet.CONCUR_READ_ONLY
                        );
                        ps.setFetchSize(2000); 
                        return ps;
                    },
                    rs -> {
                        org.apache.poi.ss.usermodel.Row row = sheet.createRow(rowIdx[0]++);

                        row.createCell(0).setCellValue(rs.getString("REQ_BRANCH_CODE") != null ? rs.getString("REQ_BRANCH_CODE") : "");
                        row.createCell(1).setCellValue(rs.getString("REQ_CURRENCY") != null ? rs.getString("REQ_CURRENCY") : "");
                        row.createCell(2).setCellValue(rs.getString("REQ_CGL") != null ? rs.getString("REQ_CGL") : "");

                        BigDecimal amt = rs.getBigDecimal("REQ_AMOUNT");
                        if (amt != null) {
                            row.createCell(3).setCellValue(amt.abs().stripTrailingZeros().toPlainString());
                            row.createCell(4).setCellValue(amt.compareTo(BigDecimal.ZERO) < 0 ? "Credit" : "Debit");
                        }

                        row.createCell(5).setCellValue(rs.getString("REQ_NARRATION") != null ? rs.getString("REQ_NARRATION") : "");
                        row.createCell(6).setCellValue(rs.getString("REQ_PRODUCT") != null ? rs.getString("REQ_PRODUCT") : "");
                    }
            );

            if (rowIdx[0] == 1) {
                throw new CustomExceptions.InvalidDataException("No records found for batch.");
            }

            workbook.write(out);
            workbook.dispose();
            return out.toByteArray();

        } catch (Exception e) {
            log.error("EXCEL_GEN_ERROR | Batch: {} | Error: {}", SecuritySanitizer.sanitizeForLog(batchId), e.getMessage(), e);
            throw new CustomExceptions.DatabaseOperationException("Failed to generate Excel file", e);
        }
    }

    public Map<String, Object> getVidDetails(String vid) {
        log.info("VID_DETAILS_FETCH | VID: {}", SecuritySanitizer.sanitizeForLog(vid));
        String safeVid = SecuritySanitizer.sanitizeId(vid);
        
        String sql = "SELECT * FROM vid_master WHERE vid_code = '" + safeVid + "'";
        
        List<Map<String, Object>> results = jdbcTemplate.queryForList(sql);
        if (results.isEmpty()) {
            throw new IllegalArgumentException("VID details not found");
        }
        return results.get(0);
    }
}


