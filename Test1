class VariableBlot extends Quill.import('blots/embed') {
  static create(value) {
    const node = super.create();
    node.setAttribute('contenteditable', 'false');
    node.classList.add('variable-blot');

    const text = document.createElement('span');
    text.innerText = value;

    const closer = document.createElement('span');
    closer.innerText = "X";
    closer.classList.add("variable-delete-icon");
    closer.style.color = "#000";
    closer.style.marginLeft = "6px";
    closer.style.fontWeight = "normal";
    closer.style.cursor = "pointer";

    node.appendChild(text);
    node.appendChild(closer);

    Object.assign(node.style, {
      border: "2px solid #000",
      borderRadius: "0px",
      fontWeight: "bold",
      color: "#000",
      background: "none",
      padding: "2px 8px",
      margin: "0 4px",
      display: "inline-block",
      cursor: "default",
      userSelect: "none",
      boxSizing: "border-box",
    });

    return node;
  }
  static value(domNode) {
    return domNode.firstChild.innerText;
  }
}
VariableBlot.blotName = "variable";
VariableBlot.tagName = "span";
Quill.register(VariableBlot);