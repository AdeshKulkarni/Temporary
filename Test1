  const handleDrop = (e) => {
    e.preventDefault();
    if (!isEditing) return;
    const editor = bodyEditorRef.current?.getEditor();
    if (!editor) return;

    const content = editor.getHTML();
    const variableCount = (content.match(/class="variable-blot"/g) || []).length;

    if (variableCount >= 4) {
      setSbar({ isOpen: true, Msg: "❌ You cannot add more than 4 variables." });
      return;
    }

    const text = e.dataTransfer.getData("text");
    const range = editor.getSelection(true);
    if (range) {
      editor.insertEmbed(range.index, "variable", text, Quill.sources.USER);
      editor.setSelection(range.index + 1, Quill.sources.USER);
    }
  };
