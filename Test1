    public ResponseEntity<List<Map<String, Object>>> getWorkflowHistory(
            @PathVariable @Pattern(regexp = "^[0-9]{1,10}$", message = "Invalid Batch ID") String batchId) {
        return ResponseEntity.ok(queryService.getWorkflowHistory(batchId));
    }

    @GetMapping("/batch-summary/{batchId}")
    public ResponseEntity<Map<String, Object>> getBatchSummaryDetails(
            @PathVariable @Pattern(regexp = "^[0-9]{1,10}$", message = "Invalid Batch ID") String batchId) {
        return ResponseEntity.ok(queryService.getBatchSummaryDetails(batchId));
