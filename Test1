            applyHighlighting(richText, stage1Text, "CGL*", boldBlue);
            applyHighlighting(richText, stage1Text, "Amount*", boldBlue);
            applyHighlighting(richText, stage1Text, "Type*", boldBlue);
            applyHighlighting(richText, stage1Text, "Product Code", boldBlue);
