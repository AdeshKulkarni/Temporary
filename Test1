import com.fincore.VoucherService.Models.RequestVoucher;
import com.fincore.VoucherService.Repository.RequestVoucherRepository;
import jakarta.persistence.criteria.Predicate;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.data.jpa.domain.Specification;
import org.springframework.stereotype.Service;

import java.time.LocalDate;
import java.time.LocalDateTime;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;

@Service
@RequiredArgsConstructor
@Slf4j
public class RequestVoucherService {

    private final RequestVoucherRepository requestVoucherRepository;

    public List<RequestVoucher> getFilteredVouchers(String category, String role, LocalDate date) {
        log.info("Fetching Request Vouchers | Category: {}, Role: {}, Date: {}", category, role, date);

        Specification<RequestVoucher> spec = (root, query, cb) -> {
            List<Predicate> predicates = new ArrayList<>();

            // 1. Add Category Filter if provided
            if (category != null && !category.trim().isEmpty()) {
                predicates.add(cb.equal(root.get("category"), category.trim()));
            }

            // 2. Add Role Filter if provided
            if (role != null && !role.trim().isEmpty()) {
                predicates.add(cb.equal(root.get("allowedRole"), role.trim()));
            }

            // 3. Add Date Filter if provided (Matches from 00:00:00 to 23:59:59 of that day)
            if (date != null) {
                LocalDateTime startOfDay = date.atStartOfDay();
                LocalDateTime endOfDay = date.atTime(23, 59, 59, 999999999);
                predicates.add(cb.between(root.get("createdAt"), startOfDay, endOfDay));
            }

            // If no filters were added, this returns all records.
            return cb.and(predicates.toArray(new Predicate[0]));
        };

        // Sort by ID or CreatedAt descending so newest records appear first
        return requestVoucherRepository.findAll(spec, org.springframework.data.domain.Sort.by(org.springframework.data.domain.Sort.Direction.DESC, "createdAt"));
    }


}

package com.fincore.VoucherService.Service;

import com.fincore.VoucherService.Exception.CustomExceptions;
import jakarta.persistence.EntityManager;
import jakarta.persistence.PersistenceContext;
import jakarta.persistence.PersistenceException;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;
import jakarta.transaction.Transactional;

/**
 * Provides unique, zero-padded identifiers for batches and journals.
 * Interacts directly with Oracle Sequences via native queries for maximum reliability.
 */
@Service
@RequiredArgsConstructor
@Slf4j
public class SequenceService {

    @PersistenceContext
    private EntityManager entityManager;

    /**
     * Pads the given number with leading zeros to a total length of 7.
     * Logic preserved exactly as defined.
     */
    private String padToSevenDigits(Long id) {
        if (id == null) {
            log.error("SEQUENCE_PADDING_FAIL | Status: DATABASE_SEQUENCE_EXHAUSTED_OR_NULL");

            throw new CustomExceptions.DatabaseOperationException("Critical failure: Oracle Sequence returned null. Check Sequence limits.");
        }
        return String.format("%07d", id);
    }

    /**
     * Gets the next BATCH_ID from the BATCH_SEQ sequence.
     * Wrapped in specific error handling for database persistence issues.
     */
    @Transactional
    public String getNextBatchId() {
        try {
            Number nextId = (Number) entityManager
                    .createNativeQuery("select BATCH_SEQ.nextval from dual")
                    .getSingleResult();

            String paddedId = padToSevenDigits(nextId.longValue());
            log.info("SEQUENCE_GENERATED | Type: BATCH_ID | Value: {}", paddedId);
            return paddedId;

        } catch (PersistenceException e) {
            log.error("SEQUENCE_FETCH_FAIL | Type: BATCH_ID | Status: Oracle sequence error");
            throw new CustomExceptions.DatabaseOperationException("Critical failure: Batch sequence unavailable", e);
        }
    }

    /**
     * Gets the next JOURNAL_ID prefix from the JRNL_SEQ sequence.
     */
    @Transactional
    public String getNextJournalIdPrefix() {
        try {
            Number nextId = (Number) entityManager
                    .createNativeQuery("select JRNL_SEQ.nextval from dual")
                    .getSingleResult();

            String paddedId = padToSevenDigits(nextId.longValue());
            log.info("SEQUENCE_GENERATED | Type: JRNL_ID | Value: {}", paddedId);
            return paddedId;

        } catch (PersistenceException e) {
            log.error("SEQUENCE_FETCH_FAIL | Type: JRNL_ID | Reason: Oracle JRNL_SEQ unavailable: {}", e.getMessage());
            throw new CustomExceptions.DatabaseOperationException("Critical failure: Could not generate Journal ID sequence", e);
        }
    }
}
package com.fincore.VoucherService.Service;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.dao.DataAccessException;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Service;

import java.util.HashSet;
import java.util.List;
import java.util.Set;

/**
 * Loads active master records into memory-efficient HashSets for O(1) validation lookups.
 * Utilizes optimized JDBC fetch sizes to handle high-volume data transfers from Oracle.
 */
@Service
@RequiredArgsConstructor
@Slf4j
public class ValidationMasterService {

    @Autowired
    @Qualifier("oracleJdbcTemplate")
    private JdbcTemplate jdbcTemplate;

    /**
     * Fetches all active branch codes.
     * Uses a fetchSize of 5000 to minimize network round-trips for large branch networks.
     */
    public Set<String> getAllActiveBranches() {
        long start = System.currentTimeMillis();
        String sql = "SELECT CODE FROM BRANCH_MASTER WHERE STATUS = 1";

        try {
            List<String> list = jdbcTemplate.query(con -> {
                var ps = con.prepareStatement(sql);
                ps.setFetchSize(5000);
                return ps;
            }, (rs, rowNum) -> rs.getString(1));

            log.info("MASTER_DATA_LOADED | Type: BRANCHES | Count: {} | Duration: {}ms", list.size(), System.currentTimeMillis() - start);
            return new HashSet<>(list);

        } catch (DataAccessException e) {
            log.error("MASTER_DATA_FETCH_FAIL | Type: BRANCHES | Reason: {}", e.getMessage());
            return new HashSet<>(); // Returning empty set to trigger validation failure safely
        }
    }

    /**
     * Fetches all active currency codes.
     * Uses a fetchSize of 1000 for standard currency volume.
     */
