const WorkFlow = () => {
  // ... existing states ...

  useEffect(() => {
    const fetchData = async () => {
      let dataToSend = { EMPANELMENT_TYPE: 'SA' };
      try {
        let jsonFormData = JSON.stringify(dataToSend);
        const encryptedData = await encrypt(iv, salt, jsonFormData);
        const payload = {
          iv: ivBase64,
          salt: saltBase64,
          data: encryptedData,
        };

        const response = await axios.post(
          "Server/IAMServices/getActiveFRN",
          payload,
          {
            headers: {
              Authorization: `Bearer ${localStorage.getItem("token")}`,
            },
          }
        );

        // PROPERLY HANDLE AXIOS RESPONSE STRUCTURE
        const resData = response.data; 
        
        if (resData.statusCode === 200) {
          const formattedData = resData.result.map((item, index) => ({
            id: index + 1,
            serial: index + 1,
            frn: item.FRN,
            firmName: item.FIRM_NAME,
            empanelmentType: item.EMPANELMENT_TYPE,
            empanelmentSubType: item.EMPANELMENT_SUB_TYPE,
            empaneledStatus: item.EMPANELED_STATUS,
            empaneledBy: item.EMPANELED_BY,
          }));
          setRows(formattedData);
        } else {
          console.error("API Error:", resData.message);
        }
      } catch (e) {
        console.error("Fetch Error:", e);
      } finally {
        setLoading(false); // ENSURES LOADING STOPS
      }
    };

    fetchData();
  }, []);
  
  // ... rest of component ...
}


router.post("/getActiveFRN", extractToken, DataValidator, async (req, res) => {
  if (req.user.user_role !== "1") {
    return res.status(401).json({
      message: "Unauthorized api call, request not from legal source",
    });
  }

  try {
    // FORWARD PROPER REQUEST BODY
    const internalResponse = await fetch(
      "http://10.0.26.158:8081/FRNController/getActiveFRN",
      {
        method: "POST",
        body: JSON.stringify(req.data), // Send decrypted data directly
        headers: {
          "Content-Type": "application/json",
        },
      }
    );
    
    const data = await internalResponse.json();
    res.json(data);
    
  } catch (e) {
    console.error("Internal Service Error:", e);
    res.status(500).json({
      status: "Failed to connect to internal service",
      error: e.message
    });
  }
});
