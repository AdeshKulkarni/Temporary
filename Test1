useEffect(() => {
    if (!isEditing) return;
    const quill = bodyEditorRef.current?.getEditor();
    if (!quill) return;
    const editorRoot = quill.root;

    const handleEditorDrop = (e) => {
      e.preventDefault();
      const text = e.dataTransfer.getData("text");
      if (!text) return;
      const range = quill.getSelection(true);
      if (!range) return;

      const content = quill.getContents();
      const currentIndex = range.index;
      let previousOp = null;

      // --- Start of Corrected Logic ---
      let lengthSoFar = 0;
      for (const op of content.ops) {
        const opLength = typeof op.insert === "string" ? op.insert.length : 1;
        
        // Check if the end of this operation is exactly where the cursor is.
        if (lengthSoFar + opLength === currentIndex) {
          previousOp = op;
          break;
        }
        
        // If the cursor is somewhere inside this operation, then there is no
        // preceding operation to check, so we can stop.
        if (lengthSoFar + opLength > currentIndex) {
          break;
        }
        
        lengthSoFar += opLength;
      }

      if (
        previousOp &&
        typeof previousOp.insert === "object" &&
        previousOp.insert.variable && // First, check that it IS a variable
        previousOp.insert.variable === text // Then, check if it's the SAME variable
      ) {
        setSbar({
          isOpen: true,
          Msg: `❌ Cannot add the same variable consecutively.`,
        });
        return;
      }
      // --- End of Corrected Logic ---

      quill.insertEmbed(range.index, "variable", text, Quill.sources.USER);
      quill.setSelection(range.index + 1, Quill.sources.USER);
    };

    const handleEditorDragOver = (e) => {
      e.preventDefault();
    };

    editorRoot.addEventListener("drop", handleEditorDrop);
    editorRoot.addEventListener("dragover", handleEditorDragOver);

    return () => {
      editorRoot.removeEventListener("drop", handleEditorDrop);
      editorRoot.removeEventListener("dragover", handleEditorDragOver);
    };
  }, [isEditing, setSbar]); // Added setSbar to dependency array