This is a very common situation in production environments. If you cannot create an Index (which would solve the problem instantly), you must change HOW you query the database.
The Problem:
Currently, your code runs 1,500 separate UPDATE queries.
Without an index, the database scans the entire table 1,500 separate times. This is why it takes 10 minutes.
The Solution: "Fetch-Match-Batch" Pattern
Instead of hitting the database 1,500 times blindly, we will:
 * Fetch (Once): Ask the DB once for all 1,500 records using a bulk SELECT. (1 Full Table Scan vs 1,500).
 * Match (In Java): Compare the DB results with your file data in Java (Instant).
 * Batch (Fast): Perform Updates using the ID (Primary Key), which is always indexed and fast.
Here is the optimized code. It does not require any new indexes.
@Override
@Transactional
public List<JournalRequest> processBulkRequests(BulkProcessJournalRequestDto dto, String executorId, Integer executorRole) {
    long startTime = System.currentTimeMillis();

    // 1. Validate Input
    if (!StringUtils.hasText(dto.getBatchId()) && (dto.getJournalIdPrefixes() == null || dto.getJournalIdPrefixes().isEmpty())) {
        throw new IllegalArgumentException("Batch ID or Journal Prefixes required.");
    }

    // 2. Build Selection Clause (Existing logic)
    String targetClause;
    List<Object> args = new ArrayList<>();
    if (StringUtils.hasText(dto.getBatchId())) {
        targetClause = "jr.BATCH_ID = ?";
        args.add(dto.getBatchId());
    } else {
        List<String> conds = new ArrayList<>();
        for (String p : dto.getJournalIdPrefixes()) {
            conds.add("jr.JOURNAL_ID LIKE ?");
            args.add(p + "%");
        }
        targetClause = "(" + String.join(" OR ", conds) + ")";
    }

    if (RequestStatus.ACCEPTED.equals(dto.getStatus())) {
        log.info(">>> STARTING OPTIMIZED APPROVAL (FETCH-MATCH-BATCH) <<<");

        // --- STEP 1: Parse & Aggregate in Java ---
        // We fetch the raw JSON payloads first.
        String fetchSql = "SELECT jr.PAYLOAD FROM JOURNAL_REQUEST jr WHERE jr.REQ_STATUS = 'P' AND jr.CREATOR_ID != ? AND " + targetClause;
        
        List<Object> fetchArgs = new ArrayList<>();
        fetchArgs.add(executorId);
        fetchArgs.addAll(args);

        List<String> payloads = jdbcTemplate.queryForList(fetchSql, String.class, fetchArgs.toArray());

        // Map Key: "Branch|Currency|Cgl|DateString" -> Data Object
        Map<String, GlAggregatedDataDto> aggregationMap = new HashMap<>();
        List<GlTransaction> transactionList = new ArrayList<>();

        for (String json : payloads) {
            try {
                CreateJournalRequestDto row = objectMapper.readValue(json, CreateJournalRequestDto.class);

                // SANITIZE DATA (Trim spaces here to match DB)
                String branch = row.getBranch().trim();
                String currency = row.getCurrency().trim();
                String cgl = row.getCgl().trim();
                LocalDate txnDate = (row.getPDate() != null) ? row.getPDate() : LocalDate.now();

                String key = generateKey(branch, currency, cgl, txnDate);

                // Aggregate Amounts
                aggregationMap.computeIfAbsent(key, k -> new GlAggregatedDataDto(
                        branch, currency, cgl, txnDate, BigDecimal.ZERO, BigDecimal.ZERO
                ));
                GlAggregatedDataDto agg = aggregationMap.get(key);
                
                BigDecimal amount = row.getAmount();
                BigDecimal convertedAmount = "INR".equalsIgnoreCase(currency) ? amount : amount; // Simplified conversion logic
                
                agg.setRawAmount(agg.getRawAmount().add(amount));
                agg.setConvertedAmount(agg.getConvertedAmount().add(convertedAmount));

                // Prepare Audit Trail
                GlTransaction txn = new GlTransaction();
                txn.setBatchId(row.getBatchId());
                txn.setJournalId(row.getJournalId());
                txn.setTransactionDate(txnDate);
                txn.setBranchCode(branch);
                txn.setCurrency(currency);
                txn.setCgl(cgl);
                txn.setNarration(row.getRemarks());
                txn.setDebitAmount(amount.compareTo(BigDecimal.ZERO) > 0 ? amount : BigDecimal.ZERO);
                txn.setCreditAmount(amount.compareTo(BigDecimal.ZERO) < 0 ? amount.abs() : BigDecimal.ZERO);
                txn.setTransactionCount(row.getTransactionCount());
                transactionList.add(txn);

            } catch (Exception e) {
                log.error("Error parsing JSON", e);
            }
        }

        // --- STEP 2: BULK FETCH EXISTING BALANCES (The "Safe" Optimization) ---
        // Instead of 1500 updates, we run a few SELECTs to find the IDs of existing rows.
        
        List<GlAggregatedDataDto> finalAggregates = new ArrayList<>(aggregationMap.values());
        
        // Oracle 'IN' clause limit is 1000. We chunk by 500 to be safe.
        final int CHUNK_SIZE = 500;
        
        for (int i = 0; i < finalAggregates.size(); i += CHUNK_SIZE) {
            List<GlAggregatedDataDto> chunk = finalAggregates.subList(i, Math.min(i + CHUNK_SIZE, finalAggregates.size()));
            fetchAndMapExistingIds(chunk); // Helper method below
        }

        // --- STEP 3: SPLIT INTO UPDATES (by ID) AND INSERTS ---
        List<GlAggregatedDataDto> toUpdate = new ArrayList<>();
        List<GlAggregatedDataDto> toInsert = new ArrayList<>();

        for (GlAggregatedDataDto agg : finalAggregates) {
            if (agg.getId() != null) {
                toUpdate.add(agg);
            } else {
                toInsert.add(agg);
            }
        }

        // 3a. Batch UPDATE by ID (Super Fast - PK Index usage)
        if (!toUpdate.isEmpty()) {
            log.info("Updating {} existing GL balances...", toUpdate.size());
            String updateSql = "UPDATE GL_BALANCE SET BALANCE = NVL(BALANCE, 0) + ?, INR_BALANCE = NVL(INR_BALANCE, 0) + ? WHERE ID = ?";
            
            jdbcTemplate.batchUpdate(updateSql, new BatchPreparedStatementSetter() {
                @Override
                public void setValues(PreparedStatement ps, int i) throws SQLException {
                    GlAggregatedDataDto row = toUpdate.get(i);
                    ps.setBigDecimal(1, row.getRawAmount());
                    ps.setBigDecimal(2, row.getConvertedAmount());
                    ps.setLong(3, row.getId()); // Using Primary Key!
                }
                @Override
                public int getBatchSize() { return toUpdate.size(); }
            });
        }

        // 3b. Batch INSERT
        if (!toInsert.isEmpty()) {
            log.info("Inserting {} new GL balances...", toInsert.size());
            String insertSql = "INSERT INTO GL_BALANCE (ID, BALANCE_DATE, BRANCH_CODE, CURRENCY, CGL, BALANCE, INR_BALANCE) " +
                               "VALUES (GL_BALANCE_SEQ.nextval, ?, ?, ?, ?, ?, ?)";
            
            jdbcTemplate.batchUpdate(insertSql, new BatchPreparedStatementSetter() {
                @Override
                public void setValues(PreparedStatement ps, int i) throws SQLException {
                    GlAggregatedDataDto row = toInsert.get(i);
                    ps.setDate(1, java.sql.Date.valueOf(row.getTxnDate()));
                    ps.setString(2, row.getBranch());
                    ps.setString(3, row.getCurrency());
                    ps.setString(4, row.getCgl());
                    ps.setBigDecimal(5, row.getRawAmount());
                    ps.setBigDecimal(6, row.getConvertedAmount());
                }
                @Override
                public int getBatchSize() { return toInsert.size(); }
            });
        }

        // --- STEP 4: INSERT AUDIT TRAIL ---
        if (!transactionList.isEmpty()) {
             // Split into chunks of 1000 to avoid memory issues
            int batchSize = 1000;
            for (int k = 0; k < transactionList.size(); k += batchSize) {
                List<GlTransaction> batch = transactionList.subList(k, Math.min(k + batchSize, transactionList.size()));
                String txnInsertSql = "INSERT INTO GL_TRANSACTIONS (TRANSACTION_ID, BATCH_ID, JOURNAL_ID, TRANSACTION_DATE, POST_DATE, " +
                        "BRANCH_CODE, CURRENCY, CGL, NARRATION, DEBIT_AMOUNT, CREDIT_AMOUNT, TRANSACTION_COUNT, SOURCE_FLAG) " +
                        "VALUES (GL_TRANSACTIONS_SEQ.nextval, ?, ?, ?, SYSTIMESTAMP, ?, ?, ?, ?, ?, ?, ?, 'J')";

                jdbcTemplate.batchUpdate(txnInsertSql, new BatchPreparedStatementSetter() {
                    @Override
                    public void setValues(PreparedStatement ps, int j) throws SQLException {
                        GlTransaction txn = batch.get(j);
                        ps.setString(1, txn.getBatchId());
                        ps.setString(2, txn.getJournalId());
                        ps.setDate(3, java.sql.Date.valueOf(txn.getTransactionDate()));
                        ps.setString(4, txn.getBranchCode());
                        ps.setString(5, txn.getCurrency());
                        ps.setString(6, txn.getCgl());
                        ps.setString(7, txn.getNarration());
                        ps.setBigDecimal(8, txn.getDebitAmount());
                        ps.setBigDecimal(9, txn.getCreditAmount());
                        ps.setInt(10, txn.getTransactionCount() != null ? txn.getTransactionCount() : 0);
                    }
                    @Override
                    public int getBatchSize() { return batch.size(); }
                });
            }
        }
    }

    // --- STEP 5: UPDATE REQUEST STATUS (Standard) ---
    String updateTarget = targetClause.replace("jr.", "");
    String updateStatusSql = "UPDATE JOURNAL_REQUEST SET REQ_STATUS = ?, EXECUTOR_ID = ?, EXECUTOR_REMARKS = ?, EXECUTION_DATE = SYSDATE " +
                             "WHERE REQ_STATUS = 'P' AND CREATOR_ID != ? AND " + updateTarget;

    List<Object> uArgs = new ArrayList<>();
    uArgs.add(dto.getStatus().getCode());
    uArgs.add(executorId);
    uArgs.add(dto.getRemarks());
    uArgs.add(executorId);
    uArgs.addAll(args);

    jdbcTemplate.update(updateStatusSql, uArgs.toArray());

    log.info("Batch Processed in {} ms", System.currentTimeMillis() - startTime);
    return Collections.emptyList();
}

/**
 * Helper to fetch existing IDs from DB using a single SELECT statement.
 * This does ONE full table scan (at worst) instead of 500 scans.
 */
private void fetchAndMapExistingIds(List<GlAggregatedDataDto> chunk) {
    if (chunk.isEmpty()) return;

    // 1. Build Dynamic IN clause: (BRANCH, CURR, CGL, DATE) IN ((...),(...))
    StringBuilder sql = new StringBuilder("SELECT ID, BRANCH_CODE, CURRENCY, CGL, BALANCE_DATE FROM GL_BALANCE WHERE (TRIM(BRANCH_CODE), TRIM(CURRENCY), TRIM(CGL), TRUNC(BALANCE_DATE)) IN (");
    
    List<Object> params = new ArrayList<>();
    for (int i = 0; i < chunk.size(); i++) {
        if (i > 0) sql.append(",");
        sql.append("(?,?,?,?)");
        GlAggregatedDataDto row = chunk.get(i);
        params.add(row.getBranch());
        params.add(row.getCurrency());
        params.add(row.getCgl());
        params.add(java.sql.Date.valueOf(row.getTxnDate()));
    }
    sql.append(")");

    // 2. Execute Query
    jdbcTemplate.query(sql.toString(), params.toArray(), rs -> {
        // 3. Map returned ID to the matching object in our list
        String b = rs.getString("BRANCH_CODE").trim();
        String c = rs.getString("CURRENCY").trim();
        String g = rs.getString("CGL").trim();
        LocalDate d = rs.getDate("BALANCE_DATE").toLocalDate();
        Long id = rs.getLong("ID");

        String dbKey = generateKey(b, c, g, d);
        
        // Find the matching object in the chunk and set its ID
        for (GlAggregatedDataDto agg : chunk) {
            String aggKey = generateKey(agg.getBranch(), agg.getCurrency(), agg.getCgl(), agg.getTxnDate());
            if (aggKey.equals(dbKey)) {
                agg.setId(id); // Set the ID found in DB
                break;
            }
        }
    });
}

private String generateKey(String b, String c, String g, LocalDate d) {
    return b + "|" + c + "|" + g + "|" + d.toString();
}

Required DTO Update
You must add an id field to your GlAggregatedDataDto so we can store the DB ID when we find it.
// In GlAggregatedDataDto.java
@Data
@AllArgsConstructor
@NoArgsConstructor
public class GlAggregatedDataDto {
    private Long id; // Add this field
    private String branch;
    private String currency;
    private String cgl;
    private LocalDate txnDate;
    private BigDecimal rawAmount;
    private BigDecimal convertedAmount;
    
    // Existing Constructor used in map (id will be null initially)
    public GlAggregatedDataDto(String branch, String currency, String cgl, LocalDate txnDate, BigDecimal rawAmount, BigDecimal convertedAmount) {
        this.branch = branch;
        this.currency = currency;
        this.cgl = cgl;
        this.txnDate = txnDate;
        this.rawAmount = rawAmount;
        this.convertedAmount = convertedAmount;
    }
}

Why this is "Safe" and Fast
 * No Schema Changes: You don't need CREATE INDEX.
 * Scan Efficiency:
   * Old Code: 1,500 Full Table Scans (because UPDATE ... WHERE TRIM(...) runs 1,500 times).
   * New Code: ~3 Full Table Scans (The fetchAndMapExistingIds chunks of 500). Even if GL_BALANCE is huge, scanning it 3 times is vastly faster than 1,500 times.
 * Fast Updates: The final UPDATE uses WHERE ID = ?. Since ID is the Primary Key, these updates are instantaneous (0.001ms each).
