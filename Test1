import React, { useState, useEffect, useMemo } from "react";
import {
  Divider,
  Typography,
  Box,
  Stack,
  Button,
  Paper,
  MenuItem,
  TextField,
  Tabs,
  Tab,
} from "@mui/material";
import { DataGrid, GridToolbar, GridOverlay } from "@mui/x-data-grid";
import { encrypt } from "../../Security/AES-GCM256";
import axios from "axios";
import downloadFile from "../../DownloadFile/DownloadFile";

// Generate IV and salt for encryption.
const iv = crypto.getRandomValues(new Uint8Array(12));
const ivBase64 = btoa(String.fromCharCode(...iv));
const salt = crypto.getRandomValues(new Uint8Array(16));
const saltBase64 = btoa(String.fromCharCode(...salt));

/**
 * EmpanelmentData Component
 *
 * Renders a UI for viewing, filtering, and downloading empanelment data.
 * It features tabs for "Active" and "Archive" data, dynamic filters,
 * and a data grid to display the results.
 */
const EmpanelmentData = () => {
  const [empanelmentData, setEmpanelmentData] = useState([]);
  const [userIp, setUserIp] = useState({
    datatype: "Active",
    type: "",
    subType: "",
    year: "",
  });
  const [selectionOptions, setSelectionOptions] = useState({});
  const [archiveYears, setArchiveYears] = useState([]);
  const [loadingYears, setLoadingYears] = useState(false);

  const columns = [
    { field: "FRN", headerName: "FRN", width: 170, flex: 1 },
    { field: "FIRM_NAME", headerName: "FIRM NAME", width: 200, flex: 1.5 },
    {
      field: "EMPANELMENT_SUB_TYPE",
      headerName: "EMPANELMENT SUB TYPE",
      width: 280,
      flex: 2,
      /**
       * valueGetter to translate EMPANELMENT_SUB_TYPE ID to its name.
       * @param {object} params - The DataGrid parameters for the cell.
       * @returns {string} The subtype name or the original ID if not found.
       */
      valueGetter: (params) => {
        const row = params.row;
        const type = userIp.type;

        if (
          !type ||
          !selectionOptions[type] ||
          !Array.isArray(selectionOptions[type]) ||
          !row?.EMPANELMENT_SUB_TYPE
        ) {
          return row?.EMPANELMENT_SUB_TYPE ?? "";
        }

        const match = selectionOptions[type].find(
          (opt) =>
            String(opt.ASSIGNMENT_TYPE_ID) === String(row.EMPANELMENT_SUB_TYPE)
        );

        return match ? match.ASSIGNMENT_SUBTYPE : row.EMPANELMENT_SUB_TYPE;
      },
    },
    {
      field: "EMPANELMENT_TYPE",
      headerName: "EMPANELMENT TYPE",
      width: 160,
      flex: 1,
    },
    {
      field: "CONTACT_PERSON",
      headerName: "Contact Person",
      width: 180,
      flex: 1,
    },
    {
      field: "POC_EMAIL",
      headerName: "Contact Email",
      width: 220,
      flex: 1,
    },
  ];

  /**
   * Memoized calculation of rows to be displayed in the DataGrid.
   */
  const filteredRows = useMemo(() => {
    let data = Array.isArray(empanelmentData)
      ? empanelmentData.filter(
          (row) =>
            row &&
            typeof row === "object" &&
            row.FRN &&
            row.EMPANELMENT_TYPE !== undefined &&
            row.EMPANELMENT_SUB_TYPE !== undefined
        )
      : [];
    if (userIp.type) {
      data = data.filter((row) => row.EMPANELMENT_TYPE === userIp.type);
    }
    if (userIp.subType) {
      data = data.filter(
        (row) => String(row.EMPANELMENT_SUB_TYPE) === String(userIp.subType)
      );
    }
    return data;
  }, [empanelmentData, userIp.type, userIp.subType]);

  /**
   * Fetches the assignment type options for filters when the component mounts.
   */
  useEffect(() => {
    fetchOptions();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  /**
   * Fetches empanelment data whenever a filter value changes.
   */
  useEffect(() => {
    if (userIp.type) {
      fetchData();
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [userIp.datatype, userIp.type, userIp.subType, userIp.year]);

  /**
   * Fetches the available archive years when the user switches to the "Archive" tab.
   */
  useEffect(() => {
    if (userIp.datatype === "Archive") {
      fetchArchiveYears();
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [userIp.datatype]);

  /**
   * Fetches assignment types and subtypes to populate the filter dropdowns.
   */
  const fetchOptions = async () => {
    try {
      const response = await axios.post(
        "Server/IAMServices/getAssignmentType",
        {},
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      const result = response.data.result || [];
      const options = {};
      const typeNames = new Set(result.map((op) => op.ASSIGNMENT_TYPE_NAME));
      typeNames.forEach((typeName) => {
        options[typeName] = result.filter(
          (op) => op.ASSIGNMENT_TYPE_NAME === typeName
        );
      });
      setSelectionOptions(options);
    } catch (e) {
      console.error("Failed to fetch selection options:", e);
    }
  };

  /**
   * Fetches the list of years for which archived data is available.
   */
  const fetchArchiveYears = async () => {
    setLoadingYears(true);
    try {
      const response = await axios.post(
        "Server/IAMServices/getArchiveYears",
        {},
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      setArchiveYears(response.data.result || []);
    } catch (e) {
      console.error("Failed to fetch archive years:", e);
    } finally {
      setLoadingYears(false);
    }
  };

  /**
   * Fetches the main empanelment data from the server based on current filters.
   */
  const fetchData = async () => {
    const dataToSend = {
      Type: userIp.datatype,
      EMPANELMENT_TYPE: userIp.type,
      EMPANELMENT_SUB_TYPE: userIp.subType,
      financial_year: userIp.year,
    };

    try {
      const jsonFormData = JSON.stringify(dataToSend);
      const encryptedData = await encrypt(iv, salt, jsonFormData);
      const payload = {
        iv: ivBase64,
        salt: saltBase64,
        data: encryptedData,
      };
      const response = await axios.post(
        "Server/IAMServices/getActiveFRN",
        payload,
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      setEmpanelmentData(response.data.result || []);
    } catch (e) {
      console.error("Failed to fetch empanelment data:", e);
      setEmpanelmentData([]);
    }
  };

  /**
   * Handles the "Download Excel" button click.
   */
  const handleDownload = async () => {
    if (filteredRows.length === 0) {
      alert("No data to download.");
      return;
    }
    try {
      const jsonFormData = JSON.stringify(filteredRows);
      const encryptedData = await encrypt(iv, salt, jsonFormData);
      const payload = {
        iv: ivBase64,
        salt: saltBase64,
        data: encryptedData,
      };
      const response = await axios.post(
        "Server/IAMServices/download_empanelment_data",
        payload,
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      const resData = response.data.result;
      if (resData) {
        downloadFile(resData, "excel", `${userIp.datatype}_Empanelment_list`);
      }
    } catch (e) {
      console.error("Failed to download Excel file:", e);
    }
  };

  /**
   * Handles the "Download ZIP" button click.
   */
  const handleDownloadZip = async () => {
    try {
      const response = await axios.post(
        "Server/IAMServices/downloadZip",
        {},
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
          responseType: "blob",
        }
      );
      const url = window.URL.createObjectURL(new Blob([response.data]));
      const link = document.createElement("a");
      link.href = url;
      link.setAttribute("download", "all_reports.zip");
      document.body.appendChild(link);
      link.click();
      link.remove();
      window.URL.revokeObjectURL(url);
    } catch (e) {
      const errorMessage =
        e.response?.data?.message || "Failed to download ZIP.";
      alert(errorMessage);
      console.error("Failed to download ZIP file:", e);
    }
  };

  /**
   * Custom overlay component to display when the DataGrid has no rows.
   */
  const CustomNoRowsOverlay = () => {
    let message = "No data available. Please select filters to begin.";

    const subTypeName =
      selectionOptions[userIp.type]?.find(
        (opt) => String(opt.ASSIGNMENT_TYPE_ID) === String(userIp.subType)
      )?.ASSIGNMENT_SUBTYPE || userIp.subType;

    if (userIp.type && userIp.subType) {
      message = `No data available for Type: '${userIp.type}' and Subtype: '${subTypeName}'.`;
      if (userIp.year) {
        message += ` in Financial Year: ${userIp.year}.`;
      }
    } else if (userIp.type) {
      message = `Please select a Sub Type for '${userIp.type}'.`;
    }

    return (
      <GridOverlay>
        <Box p={2} sx={{ textAlign: "center", color: "text.secondary" }}>
          <Typography>{message}</Typography>
        </Box>
      </GridOverlay>
    );
  };

  /**
   * Handles changing between the "Active" and "Archive" tabs.
   */
  const handleTabChange = (event, newValue) => {
    setUserIp({ datatype: newValue, type: "", subType: "", year: "" });
    setEmpanelmentData([]);
  };

  /**
   * Handles selection of an empanelment type.
   */
  const handleSelectType = (type) => {
    setUserIp((prev) => ({ ...prev, type, subType: "" }));
  };

  /**
   * Handles selection of an empanelment sub-type.
   */
  const handleSelectSubType = (subType) => {
    setUserIp((prev) => ({ ...prev, subType }));
  };

  /**
   * Handles selection of a financial year (in Archive mode).
   */
  const handleSelectYear = (year) => {
    setUserIp((prev) => ({ ...prev, year }));
  };

  return (
    <Box sx={{ p: 3, width: "100%" }}>
      <Typography variant="h5" sx={{ mb: 2 }}>
        Empanelment Data
      </Typography>
      <Divider sx={{ mb: 3 }} />

      <Paper sx={{ p: 3, width: "100%", overflow: "hidden" }}>
        <Box sx={{ mb: 3 }}>
          <Tabs
            value={userIp.datatype}
            onChange={handleTabChange}
            sx={{ borderBottom: 1, borderColor: "divider" }}
          >
            <Tab label="Active" value="Active" />
            <Tab label="Archive" value="Archive" />
          </Tabs>
        </Box>

        <Stack
          direction={{ xs: "column", sm: "row" }}
          spacing={2}
          sx={{ mb: 3 }}
          alignItems={{ xs: "stretch", sm: "center" }}
        >
          {userIp.datatype === "Archive" && (
            <TextField
              select
              label="Year"
              value={userIp.year}
              onChange={(e) => handleSelectYear(e.target.value)}
              sx={{ width: { xs: "100%", sm: 200 } }}
              size="small"
              disabled={loadingYears}
            >
              <MenuItem value="">
                <em>Select Year</em>
              </MenuItem>
              {archiveYears.map((year) => (
                <MenuItem key={year} value={year}>
                  {year}
                </MenuItem>
              ))}
            </TextField>
          )}

          <TextField
            select
            label="Type"
            value={userIp.type}
            onChange={(e) => handleSelectType(e.target.value)}
            sx={{ width: { xs: "100%", sm: 200 } }}
            size="small"
          >
            <MenuItem value="">
              <em>Select Type</em>
            </MenuItem>
            {Object.keys(selectionOptions).map((type) => (
              <MenuItem key={type} value={type}>
                {type}
              </MenuItem>
            ))}
          </TextField>

          {userIp.type && (
            <TextField
              select
              label="Sub Type"
              value={userIp.subType}
              onChange={(e) => handleSelectSubType(e.target.value)}
              sx={{ width: { xs: "100%", sm: 220 } }}
              size="small"
              disabled={!selectionOptions[userIp.type]}
            >
              <MenuItem value="">
                <em>All Sub Types</em>
              </MenuItem>
              {selectionOptions[userIp.type]?.map((option) => (
                <MenuItem
                  key={option.ASSIGNMENT_TYPE_ID}
                  value={option.ASSIGNMENT_TYPE_ID}
                >
                  {option.ASSIGNMENT_SUBTYPE}
                </MenuItem>
              ))}
            </TextField>
          )}
        </Stack>

        {userIp.type && (
          <Box sx={{ width: "100%" }}>
            <Box
              sx={{
                display: "flex",
                justifyContent: "flex-end",
                mb: 2,
                alignItems: "center",
              }}
            >
              <Typography
                variant="body2"
                sx={{
                  fontStyle: "italic",
                  color: "text.secondary",
                  mr: "auto",
                }}
              >
                *Excel download contains all available data fields.
              </Typography>
              <Button
                onClick={handleDownload}
                variant="contained"
                size="medium"
                disabled={filteredRows.length === 0}
              >
                Download Excel
              </Button>
              <Button
                onClick={handleDownloadZip}
                variant="contained"
                size="medium"
                color="secondary"
                sx={{ ml: 2 }}
              >
                Download ZIP
              </Button>
            </Box>

            <Box sx={{ height: 500, width: "100%" }}>
              <DataGrid
                rows={filteredRows}
                columns={columns}
                getRowId={(row) =>
                  row.FRN ??
                  `${row.EMPANELMENT_TYPE}_${
                    row.EMPANELMENT_SUB_TYPE
                  }_${Math.random()}`
                }
                slots={{
                  noRowsOverlay: CustomNoRowsOverlay,
                  toolbar: GridToolbar,
                }}
                pageSizeOptions={[10, 25, 50]}
                initialState={{
                  pagination: {
                    paginationModel: { pageSize: 10 },
                  },
                }}
                sx={{
                  "& .MuiDataGrid-columnHeaders": {
                    backgroundColor: "grey.100",
                    fontWeight: "bold",
                  },
                }}
              />
            </Box>
          </Box>
        )}
      </Paper>
    </Box>
  );
};

export default EmpanelmentData;
