);

// Helper component for the user info cards with corrected alignment
const UserInfoLine = ({ label, value }) => (
  <Box sx={{ mb: 2.5 }}>
    <Typography
      variant="body2"
      sx={{ fontWeight: "bold", color: "text.secondary", textTransform: "uppercase" }}
    >
      {label}
    </Typography>
    <Typography variant="body1" color="text.primary">
      {value}
    </Typography>
  </Box>
);

export default function IamView() {
  const [userData, setUserData] = useState(null);
  const [currentUserActions, setCurrentUserActions] = useState(null);
  const navigate = useNavigate();

  useEffect(() => {
    try {
      const storedData = localStorage.getItem("user");
      if (!storedData) {
        console.error("User data not found in local storage.");
        return;
      }
      const data = JSON.parse(storedData);
      setUserData(data);

      const accessRole = data.access;
      const userRole = data.user_role;

      if (
        accessRole === "SAC" ||
        accessRole === "SAM" ||
        accessRole === "IAC" ||
        accessRole === "IAM"
      ) {
        setCurrentUserActions(allActions[accessRole]);
      } else if (userRole === "94" || userRole === "96") {
        setCurrentUserActions(allActions[userRole]);
      } else {
        setCurrentUserActions(allActions["Other"]);
      }
    } catch (error) {
      console.error("Failed to parse user data from local storage:", error);
    }
  }, []);

  if (!userData) {
    return <p>Loading user data...</p>;
  }

  // Style for the info cards (without hover effect)
  const infoCardStyle = {
    flex: 1,
    borderRadius: "12px",
    boxShadow: "0 4px 12px rgba(0,0,0,0.1)",
    p: 1, // Add some internal padding
  };

  return (
    <Container sx={{ mt: 3, mb: 3 }}>
      {/* Internal Module Assignment Section */}
      <Box sx={{ mb: 4 }}>
        <Typography
          variant="h5"
          sx={{ fontWeight: "bold", color: "#1e3a8a", mb: 2 }}
        >
          Internal Module Assignment
        </Typography>
        <Stack direction={{ xs: "column", md: "row" }} spacing={3}>
          {/* Left Card: User Details */}
          <Card sx={infoCardStyle}>
            <CardContent>
              <UserInfoLine
                label="User"
                value={`${userData.pf_number} - ${userData.first_name} ${userData.last_name}`}
              />
              <UserInfoLine
                label="Role"
                value="Maker" // As shown in the image
              />
              <UserInfoLine
                label="Mobile Number"
                value={userData.mobile_number}
              />
              <UserInfoLine label="Email" value={userData.email_id} />
            </CardContent>
          </Card>

          {/* Right Card: Branch Details */}
          <Card sx={infoCardStyle}>
            <CardContent>
              <UserInfoLine
                label="Branch"
                value={`${userData.branch_code} - ${userData.branch_name}`}
              />
              <UserInfoLine
                label="Access"
                value="Auditable Branch" // As shown in the image
              />
            </CardContent>
          </Card>
        </Stack>
      </Box>

      {/* Financial and Circle Information Cards */}
      <Stack direction={{ xs: "column", md: "row" }} spacing={3} sx={{ mb: 4 }}>
        {/* Financial Period Card */}
        <StyledCard sx={{ flex: 1 }}>
          <CardContent>
            <Box sx={{ display: "flex", alignItems: "center", mb: 2 }}>
              <CalendarMonthIcon color="action" sx={{ mr: 1.5 }} />
              <Typography
                variant="h6"
                component="div"
                sx={{ fontWeight: "600" }}
              >
                Current Financial Period
              </Typography>
            </Box>
            <Paper
              variant="outlined"
              sx={{ backgroundColor: "#fdfdff", borderRadius: "8px" }}
            >
              <Stack
                direction="row"
                spacing={1}
                justifyContent="space-around"
                sx={{ p: 1 }}
              >
                <InfoBlock
                  label="Financial Year"
                  value={userData.financial_year}
                />
                <InfoBlock label="Current Quarter" value={userData.quarter} />
                <InfoBlock
                  label="Quarter End Date"
                  value={userData.quarterEndDate}
                />
              </Stack>
            </Paper>
          </CardContent>
        </StyledCard>

        {/* Circle Information Card */}
        <StyledCard sx={{ flex: 1 }}>
          <CardContent>
            <Box sx={{ display: "flex", alignItems: "center", mb: 2 }}>
              <CorporateFareIcon color="action" sx={{ mr: 1.5 }} />
              <Typography
                variant="h6"
                component="div"
                sx={{ fontWeight: "600" }}
              >
                Circle Information
              </Typography>
            </Box>
            <Paper
              variant="outlined"
              sx={{ backgroundColor: "#fdfdff", borderRadius: "8px" }}
            >
              <Stack
                direction="row"
                spacing={1}
                justifyContent="space-around"
                sx={{ p: 1 }}
              >
                <InfoBlock label="Circle Name" value={userData.circleName} />
                <InfoBlock label="Circle Code" value={userData.circleCode} />
              </Stack>
            </paper>
          </CardContent>
        </StyledCard>
      </Stack>

      {/* Quick Actions Card */}
      <StyledCard>
        <CardContent>
          <Typography variant="h5" sx={{ mb: 2, fontWeight: "bold" }}>
            Quick Actions
          </Typography>
          <Stack
            direction="row"
            spacing={3}
            justifyContent="flex-start"
            sx={{ flexWrap: "wrap", gap: 2 }}
          >
            {currentUserActions &&
              Object.entries(currentUserActions).map(([name, path]) => (
                <ActionPaper key={name} elevation={2}>
                  {actionIcons[name] || actionIcons.Default}
                  <Typography variant="body1" sx={{ fontWeight: "medium" }}>
                    {formatActionName(name)}
                  </Typography>
                  <Button
                    variant="contained"
                    size="small"
                    onClick={() => navigate(path)}
                    sx={{ textTransform: "none", borderRadius: "16px" }}
                  >
                    Access Now
                  </Button>
                </ActionPaper>
              ))}
          </Stack>
        </CardContent>
      </StyledCard>
    </Container>
  );
}

