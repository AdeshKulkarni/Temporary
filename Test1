import React, { useState, useMemo } from 'react';
import {
  Button,
  Box,
  Paper,
  Typography,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Checkbox
} from '@mui/material';
import { DataGrid, GridToolbar } from '@mui/x-data-grid';

const NamesPreviewComponent = () => {
  // State for selected rows
  const [selectedRows, setSelectedRows] = useState([]);
  const [isPreviewOpen, setIsPreviewOpen] = useState(false);
  
  // Generate random names data
  const generateNames = () => {
    const names = [
      'Emma Johnson', 'Noah Smith', 'Olivia Williams', 'Liam Brown', 
      'Ava Jones', 'William Garcia', 'Sophia Miller', 'James Davis',
      'Isabella Rodriguez', 'Benjamin Martinez'
    ];
    
    return names.slice(0, Math.floor(Math.random() * 6) + 5).map((name, index) => ({
      id: index + 1,
      name,
      selected: false
    }));
  };

  // Memoized data to prevent regeneration on every render
  const rows = useMemo(() => generateNames(), []);
  
  // Columns configuration
  const columns = [
    {
      field: 'selected',
      headerName: 'Select',
      width: 80,
      renderHeader: () => (
        <Checkbox
          checked={selectedRows.length === rows.length}
          indeterminate={selectedRows.length > 0 && selectedRows.length < rows.length}
          onChange={handleSelectAll}
        />
      ),
      renderCell: (params) => (
        <Checkbox
          checked={selectedRows.includes(params.id)}
          onChange={() => handleSelectRow(params.id)}
        />
      )
    },
    {
      field: 'id',
      headerName: 'Sr. No',
      width: 100,
      valueGetter: (params) => params.row.id
    },
    {
      field: 'name',
      headerName: 'Name',
      flex: 1,
      minWidth: 200
    }
  ];

  // Handle row selection
  const handleSelectRow = (id) => {
    setSelectedRows(prev => 
      prev.includes(id) 
        ? prev.filter(rowId => rowId !== id) 
        : [...prev, id]
    );
  };

  // Handle select all
  const handleSelectAll = () => {
    if (selectedRows.length === rows.length) {
      setSelectedRows([]);
    } else {
      setSelectedRows(rows.map(row => row.id));
    }
  };

  // Handle preview
  const handlePreview = () => {
    setIsPreviewOpen(true);
  };

  // Close preview dialog
  const handleClosePreview = () => {
    setIsPreviewOpen(false);
  };

  // Get selected names
  const selectedNames = rows
    .filter(row => selectedRows.includes(row.id))
    .map(row => row.name);

  return (
    <Box sx={{ p: 3 }}>
      <Paper elevation={3} sx={{ p: 3, borderRadius: 2 }}>
        <Typography variant="h6" gutterBottom sx={{ mb: 2 }}>
          Employee Selection
        </Typography>
        
        <Box sx={{ height: 400, width: '100%' }}>
          <DataGrid
            rows={rows}
            columns={columns}
            disableColumnMenu
            hideFooterSelectedRowCount
            components={{
              Toolbar: GridToolbar,
            }}
            componentsProps={{
              toolbar: {
                showQuickFilter: true,
                quickFilterProps: { debounceMs: 500 },
              },
            }}
          />
        </Box>
        
        <Box sx={{ mt: 2, display: 'flex', justifyContent: 'flex-end' }}>
          <Button
            variant="contained"
            color="primary"
            onClick={handlePreview}
            disabled={selectedRows.length === 0}
            sx={{ 
              backgroundColor: '#1976d2',
              '&:hover': { backgroundColor: '#1565c0' },
              minWidth: 120
            }}
          >
            Preview
          </Button>
        </Box>
      </Paper>
      
      {/* Preview Dialog */}
      <Dialog 
        open={isPreviewOpen} 
        onClose={handleClosePreview}
        maxWidth="sm"
        fullWidth
      >
        <DialogTitle>
          Selected Names Preview
        </DialogTitle>
        
        <DialogContent dividers>
          <Typography variant="body1" gutterBottom>
            Selected {selectedNames.length} names:
          </Typography>
          
          <Box 
            component="ul" 
            sx={{ 
              pl: 3, 
              maxHeight: 300, 
              overflow: 'auto',
              border: '1px solid #eee',
              borderRadius: 1,
              p: 2,
              mt: 1
            }}
          >
            {selectedNames.map((name, index) => (
              <li key={index}>
                <Typography variant="body1">
                  {name}
                </Typography>
              </li>
            ))}
          </Box>
        </DialogContent>
        
        <DialogActions>
          <Button 
            onClick={handleClosePreview} 
            color="primary"
            variant="outlined"
          >
            Close
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
};

export default NamesPreviewComponent;
