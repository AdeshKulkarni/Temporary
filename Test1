package com.fincore.VoucherService.Service;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Service;

import jakarta.annotation.PostConstruct;
import java.util.HashSet;
import java.util.List;
import java.util.Set;

@Service
@RequiredArgsConstructor
@Slf4j
public class ValidationMasterService {

    @Autowired
    @Qualifier("oracleJdbcTemplate")
    private JdbcTemplate oracleJdbcTemplate;

    // Volatile ensures all threads see updates instantly when the Redis trigger fires
    private volatile Set<String> activeBranches = new HashSet<>();
    private volatile Set<String> activeCurrencies = new HashSet<>();
    private volatile Set<String> activeCgls = new HashSet<>();

    @PostConstruct
    public void init() {
        refreshMasterData();
    }

    /**
     * Triggered on startup and by Redis Pub/Sub when Admins change data.
     */
    public void refreshMasterData() {
        log.info("MASTER_DATA_SYNC | Refreshing local cache from Oracle DB...");
        try {
            List<String> newBranches = oracleJdbcTemplate.query("SELECT CODE FROM BRANCH_MASTER WHERE STATUS = 1", (rs, rowNum) -> rs.getString(1));
            List<String> newCurrencies = oracleJdbcTemplate.query("SELECT CURRENCY_CODE FROM CURRENCY_MASTER WHERE FLAG = 1", (rs, rowNum) -> rs.getString(1));
            List<String> newCgls = oracleJdbcTemplate.query("SELECT CGL_NUMBER FROM CGL_MASTER WHERE STATUS = 1", (rs, rowNum) -> rs.getString(1));

            this.activeBranches = new HashSet<>(newBranches);
            this.activeCurrencies = new HashSet<>(newCurrencies);
            this.activeCgls = new HashSet<>(newCgls);
            
            log.info("MASTER_DATA_SYNC_SUCCESS | CGLs: {} | Branches: {} | Currencies: {}", 
                    newCgls.size(), newBranches.size(), newCurrencies.size());
        } catch (Exception e) {
            log.error("MASTER_DATA_SYNC_FAIL | Retaining old memory cache. Error: {}", e.getMessage());
        }
    }

    // High-speed memory reads for your Excel Parser. Zero database hits here.
    public Set<String> getAllActiveBranches() { return this.activeBranches; }
    public Set<String> getAllActiveCurrencies() { return this.activeCurrencies; }
    public Set<String> getAllActiveCgls() { return this.activeCgls; }
}

```

