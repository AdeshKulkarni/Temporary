import React, { useState, useMemo, useEffect } from "react";
import {
  Box,
  Button,
  IconButton,
  Stack,
  Tooltip,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  TextField,
  Typography,
  Chip,
} from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import { Check as CheckIcon, Clear as ClearIcon } from "@mui/icons-material";
import useApi from "../../../hooks/useApi";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";
import AccountCircleIcon from "@mui/icons-material/AccountCircle";
import AddBoxIcon from "@mui/icons-material/AddBox";
import EditDocumentIcon from "@mui/icons-material/EditDocument";
import AutoDeleteIcon from '@mui/icons-material/AutoDelete';

export default function AcceptRejectCGL() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const [remarks, setRemarks] = useState("");
  const [rows, setRows] = useState([]);
  const [isLoading, setIsLoading] = useState(true);
  const [confirmDialog, setConfirmDialog] = useState({
    open: false,
    type: null,
    rowId: null,
  });

  const fetchData = async () => {
    setIsLoading(true);
    try {
      console.log("Fetching Data");
      const payload = {};
      const response = await callApi("/CL/cgl-requests", payload, "GET");
      console.log("response ::", response);
      if (response && response.length > 0) {
        const result = response.map((row) => {
          let parsedPayload = {};
          parsedPayload = row.payload ? JSON.parse(row.payload) : {};

          const {
            comp1 = "",
            segmentCode = "",
            comp2 = "",
            description = "",
          } = parsedPayload;

          return {
            ...row,
            description: description,
            cglCode: `${comp1} ${segmentCode} ${comp2}`,
          };
        });
        console.log(result);
        setRows(result);
      } else {
        showSnackBar("No pending requests found to take action", "warning");
        setRows([]);
      }
    } catch (error) {
      console.error(error);
      showSnackBar(
        "Something went wrong while fetching data, Kindly try again later",
        "error"
      );
      setRows([]);
    } finally {
      setIsLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
  }, []);

  const handleConfirm = async () => {
    try {
      if (confirmDialog.type === "reject" && !remarks.trim()) {
        showSnackBar("Please provide remarks before rejecting.", "warning");
        return;
      }
      const payload = {
        id: confirmDialog.rowId,
        remarks: confirmDialog.type === "reject" ? remarks.trim() : null,
      };
      const apiUrl =
        confirmDialog.type === "accept" ? "/CL/cgl-accept" : "/CL/cgl-reject";
      console.log(`Sending ${confirmDialog.type} payload:`, payload);

      // Assuming your API call is something like this:
      await callApi(apiUrl, payload, "PATCH");

      if (confirmDialog.type === "accept") {
        showSnackBar("Request Accepted Successfully", "success");
      } else {
        showSnackBar("Request Rejected Successfully", "success");
      }
      fetchData(); // Refresh the data after a successful action
    } catch (error) {
      console.error(error);
      showSnackBar(
        "Failed to process your action on the request, Kindly try again",
        "error"
      );
    }
    closeConfirmDialog();
  };

  const openConfirmDialog = (type, rowId) => {
    setConfirmDialog({ open: true, type, rowId });
    setRemarks("");
  };

  const closeConfirmDialog = () => {
    setConfirmDialog({ open: false, type: null, rowId: null });
    setRemarks("");
  };

  const columns = useMemo(
    () => [
      {
        field: "cglCode",
        headerName: "CGL Code",
        flex: 1,
        sortable: true,
        align: "left",
        headerAlign: "left",
      },
      {
        field: "description",
        headerName: "CGL Description",
        flex: 2,
        sortable: true,
      },
      {
        field: "changeType",
        headerName: "Request type",
        flex: 1,
        sortable: true,
        align: "center",
        headerAlign: "center",
        renderCell: (params) => {
          const value = params.value;
          return (
            <Box>
              {value === "A" ? (
                <Chip icon={<AddBoxIcon />} label={"Added"} size="small" />
              ) : value === "D" ? (
                <Chip icon={<AutoDeleteIcon />} label={"Deleted"} size="small" />
              ) : (
                <Chip
                  icon={<EditDocumentIcon />}
                  label={"Modified"}
                  size="small"
                />
              )}
            </Box>
          );
        },
      },
      {
        field: "creatorId",
        headerName: "Creator ID",
        flex: 1,
        sortable: true,
        align: "center",
        headerAlign: "center",
        renderCell: (params) => {
          const value = params.value;
          return (
            <Box>
              <Chip icon={<AccountCircleIcon />} label={value} size="small" />
            </Box>
          );
        },
      },
      {
        field: "reqDate",
        headerName: "Requested Date",
        flex: 1,
        sortable: true,
        align: "center",
        headerAlign: "center",
      },
      {
        field: "actions",
        headerName: "Actions",
        sortable: false,
        flex: 1,
        align: "center",
        headerAlign: "center",
        renderCell: (params) => (
          <Stack
            direction="row"
            spacing={1}
            alignItems="center"
            justifyContent="center"
          >
            <Tooltip title="Approve">
              <IconButton
                size="small"
                onClick={() => openConfirmDialog("accept", params.row.id)}
                color="success"
              >
                <CheckIcon fontSize="inherit" />
              </IconButton>
            </Tooltip>
            <Tooltip title="Reject">
              <IconButton
                size="small"
                onClick={() => openConfirmDialog("reject", params.row.id)}
                color="error"
              >
                <ClearIcon fontSize="inherit" />
              </IconButton>
            </Tooltip>
          </Stack>
        ),
      },
    ],
    []
  );

  return (
    <Box>
      <DataGrid
        rows={rows}
        columns={columns}
        disableRowSelectionOnClick
        pageSizeOptions={[5, 10, 25, 50]}
        initialState={{
          pagination: { paginationModel: { pageSize: 10, page: 0 } },
          sorting: { sortModel: [{ field: "reqDate", sort: "desc" }] },
        }}
        getRowId={(row) => row.id}
        loading={isLoading}
        sx={{
          height: 600,
          width: "100%",
          "& .MuiDataGrid-cell:focus": {
            outline: "none",
          },
        }}
      />

      {/* Confirmation Dialog */}
      <Dialog
        open={confirmDialog.open}
        onClose={closeConfirmDialog}
        maxWidth="sm"
        fullWidth
      >
        <DialogTitle>
          {confirmDialog.type === "accept"
            ? "Confirm Approval"
            : "Confirm Rejection"}
        </DialogTitle>
        <DialogContent>
          <Typography sx={{ p: 2 }}>
            {confirmDialog.type === "accept"
              ? "Are you sure you want to approve this request?"
              : "Are you sure you want to reject this request? Kindly enter remarks for rejecting this request."}
          </Typography>

          {confirmDialog.type === "reject" && (
            <TextField
              fullWidth
              label="Rejection Remarks"
              value={remarks}
              onChange={(e) => setRemarks(e.target.value.slice(0, 100))}
              multiline
              rows={2}
              margin="dense"
              inputProps={{ maxLength: 100 }}
            />
          )}
        </DialogContent>
        <DialogActions>
          <Button
            onClick={closeConfirmDialog}
            color="inherit"
            variant="contained"
          >
            Cancel
          </Button>
          <Button
            onClick={handleConfirm}
            color={confirmDialog.type === "accept" ? "success" : "error"}
            variant="contained"
          >
            {confirmDialog.type === "accept" ? "Approve" : "Reject"}
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
}
