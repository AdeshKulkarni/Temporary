import { useState, useEffect, useRef } from "react";
import {
  Snackbar,
  IconButton,
  Button,
  Divider,
  Dialog,
  DialogTitle,
  DialogContent,
  Paper,
  Typography,
  Grid,
  Container,
} from "@mui/material";
import { Box, styled } from "@mui/system";
import DialogActions from "@mui/material/DialogActions";
import CloseIcon from "@mui/icons-material/Close";
import ReactQuill from "react-quill";
import Quill from "quill";
import Delta from "quill/core";
import "react-quill/dist/quill.snow.css";
import "./quill.css";
import axios from "axios";
import { encrypt } from "../../Security/AES-GCM256";
import { set } from "date-fns";

//Quill formatting
var DirectionAttribute = Quill.import("attributors/attribute/direction");
Quill.register(DirectionAttribute, true);
var AlignClass = Quill.import("attributors/class/align");
Quill.register(AlignClass, true);
var BackgroundClass = Quill.import("attributors/class/background");
Quill.register(BackgroundClass, true);
var ColorClass = Quill.import("attributors/class/color");
Quill.register(ColorClass, true);
var DirectionClass = Quill.import("attributors/class/direction");
Quill.register(DirectionClass, true);
var FontClass = Quill.import("attributors/class/font");
Quill.register(FontClass, true);
var SizeClass = Quill.import("attributors/class/size");
Quill.register(SizeClass, true);
var AlignStyle = Quill.import("attributors/style/align");
Quill.register(AlignStyle, true);
var BackgroundStyle = Quill.import("attributors/style/background");
Quill.register(BackgroundStyle, true);
var ColorStyle = Quill.import("attributors/style/color");
Quill.register(ColorStyle, true);
var DirectionStyle = Quill.import("attributors/style/direction");
Quill.register(DirectionStyle, true);
var FontStyle = Quill.import("attributors/style/font");
Quill.register(FontStyle, true);
var SizeStyle = Quill.import("attributors/style/size");
Quill.register(SizeStyle, true);
const Size = Quill.import("formats/size");
Size.whitelist = [
  "2px",
  "4px",
  "6px",
  "8px",
  "10px",
  "12px",
  "14px",
  "16px",
  "18px",
  "20px",
  "22px",
  "24px",
  "26px",
];
Quill.register(Size, true);
const Font = Quill.import("formats/font");
Font.whitelist = [
  "arial",
  "times-new-roman",
  "courier-new",
  "sans-serif",
  "serif",
  "monospace",
  "georgia",
  "tahoma",
  "verdana",
  "sofia",
];
Quill.register(Font, true);

const iv = crypto.getRandomValues(new Uint8Array(12)); // for encryption
const ivBase64 = btoa(String.fromCharCode.apply(null, iv)); // for decryption
const salt = crypto.getRandomValues(new Uint8Array(16)); // for encryption
const saltBase64 = btoa(String.fromCharCode.apply(null, salt)); // for decryption

const EmailTemplate = () => {
  const [value, setValue] = useState("Draft will appear here");
  const [sbar, setSbar] = useState({ isOpen: false, Msg: "" });
  const [wordCount, setWordCount] = useState(0);
  const editorRef = useRef();
  const [isEditing, setIsEditing] = useState(false);
  const [isPreviewing, setIsPreviewing] = useState(false);
  const [templateContent, settemplateContent] = useState(null);

  const draftVar = [
    "{{DATE}}",
    "{{REF_NO}}",
    "{{FIRM_NAME}}",
    "{{FRN_NO}}",
    "{{FIRM_ADDR}}",
    "{{ASSIGNMENT_TYPE}}",
    "{{GSTN}}",
  ];

  const quillRef = useRef(null);
  const modules = {
    toolbar: [
      [
        {
          font: Font.whitelist,
        },
      ],
      [
        {
          size: [
            "8px",
            "10px",
            "12px",
            "14px",
            "16px",
            "18px",
            "20px",
            "22px",
            "24px",
            "26px",
          ],
        },
      ],
      [
        { color: ["red", "green", "blue", "black", "orange"] },
        { background: ["red", "green", "blue", "yellow", "gray"] },
      ],
      [{ align: "justify" }, { align: "center" }, { align: "right" }],
      [{ script: "sub" }, { script: "super" }],
      [{ header: [1, 2, 3, false] }],
      [{ list: "ordered" }, { list: "bullet" }],
      ["bold", "italic", "underline", "strike"],
      ["link", "image", "clean"],
      [{ indent: "-1" }, { indent: "+1" }], // Add indent options
    ],
    clipboard: {
      matchVisual: false,
    },
  };

  useEffect(() => {
    fetchData();
  }, []);

  const fetchData = async () => {
    try {
      const response = await axios.post(
        "Server/IAMServices/EmailTemplate",
        {},
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      let res = response.data.result;
      console.log(res);
      setValue(res);
      setWordCount(countWord(res));
    } catch (e) {
      console.log(e);
    }
  };

  function countWord(str) {
    const text = str.replace(/<[^>]*>/g, ""); // Remove HTML tags
    const words = text.trim().split(/\s+/).filter(Boolean);
    return words.length;
  }

  const handleChange = (content, delta, source, editor) => {
    let a = editor.getHTML();
    let length = countWord(a);
    
    // Only validate user input, not programmatic changes
    if (source === "user") {
      const insertedOp = delta.ops?.find((op) => typeof op.insert === "string");
      if (insertedOp) {
        const inserted = insertedOp.insert;
        const len = inserted.length;
        
        // Allow non-breaking space (used by Quill formatting)
        const allowedCharsRegex = /[a-zA-Z0-9\s.,;!?'"()\{\}\-@\u00A0]/;
        
        // Check each character individually
        for (let i = 0; i < inserted.length; i++) {
          const char = inserted[i];
          if (!allowedCharsRegex.test(char)) {
            setTimeout(() => {
              const selection = editorRef.current.editor.getSelection();
              if (selection) {
                // Delete only the invalid character
                editorRef.current.editor.deleteText(
                  selection.index - 1, 
                  1, 
                  "silent"
                );
              }
            }, 10);
            
            setSbar({
              isOpen: true,
              Msg: `❌ Character '${char}' is not allowed!`,
            });
            return; // Exit after first invalid char
          }
        }
      }
    }

    if (length > 2000) {
      let pos = editor.getLength();
      let i = delta.ops.length;
      let ret = delta.ops[0]["retain"];
      let len = delta.ops[i - 1]["insert"]
        ? delta.ops[i - 1]["insert"].length
        : 0;
      editorRef.current.editor.deleteText(pos - 1, len, "silent");
      editorRef.current.editor.setSelection(ret - 1);
      setSbar({
        isOpen: "true",
        Msg: "Word limit exceeded. if You Want Change Anything Click on Edit Button !!",
      });
      return;
    }
    
    setValue(a);
    setWordCount(length);
  };

  const handleDragStart = (e) => {
    const text = e.target.innerText;
    e.dataTransfer.setData("text", text);
  };

  const handleDrop = (e) => {
    e.preventDefault();
    var range = editorRef.current.editor?.getSelection(true);
    editorRef.current.editor?.insertText(
      range || 0,
      e.dataTransfer.getData("text")
    );
  };

  const handleSave = async () => {
    setIsEditing(false);
    let str = value.match(/\{{2}[A-Z_]+\}{2}/g);
    let checked = str?.filter((w) => {
      return draftVar.some((str) => str == w);
    });
    if (str != null && str.length > checked.length) {
      setSbar({
        isOpen: true,
        Msg: "Invalid Variable Names added!!  Ensure that entered variable names are correct and there should not be whitespaces between curly braces",
      });
      handleCloseDialog();
      return;
    }

    let dataToSend = { MASTER_TEMPLATE: `<html>${value}</html>` };
    try {
      let jsonFormData = JSON.stringify(dataToSend);
      await encrypt(iv, salt, jsonFormData).then(function (result) {
        jsonFormData = result;
      });
      let payload = {
        iv: ivBase64,
        salt: saltBase64,
        data: jsonFormData,
      };
      const response = await axios.post(
        "Server/IAMServices/saveMasterTemplate",
        payload,
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      if (response.data.statusCode === 200 && response.data.result !== "") {
        console.log("successfull!");
      }
    } catch (error) {
      console.error("Error saving template:", error);
    }
    setSbar({
      isOpen: true,
      Msg: "Saved Successfully!",
    });
    setIsPreviewing(false);
    handleCloseDialog();
  };

  const handlePreview = async () => {
    setIsEditing(false);
    let data = {
      DATE: "xx/xx/xxxx",
      REF_NO: "9999xxx",
      FIRM_NAME: "xxxxxxxxxx",
      FRN_NO: "999999999",
      GSTN: "99xx99xx",
      FIRM_ADDR: "xxxxxxxx,xxxxxxxx",
      ASSIGNMENT_TYPE: "xxxxxxx",
    };
    let str = value.replace(/<br\s*\/?>/gi, "<br></br>");
    let StrToSend = str.replace(/\{{2}([A-Z_]+)\}{2}/g, (match, p1) => {
      return data[p1];
    });
    settemplateContent(StrToSend);
    setIsPreviewing(true);
  };

  const handleCloseDialog = () => {
    setIsPreviewing(false);
  };

  //Reset Draft to default one
  const handleReset = async () => {
    try {
      const response = await axios.post(
        "Server/IAMServices/resetTemplate",
        {},
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      let res = response.data.result;
      setValue(res);
    } catch (e) {
      console.error("Error resetting template:", e);
    }
  };

  return (
    <>
      <Typography gutterBottom variant="h5" component="div">
        Empanelment Intimation Letter Template
      </Typography>
      <Divider />
      <Grid container spacing={2} sx={{ p: 2 }}>
        <Grid item xs={14} md={4}>
          <Box
            sx={{
              height: "100%",
              width: "100%",
              borderRadius: 2,
              boxShadow: 2,
            }}
          >
            <Paper sx={{ height: "48%", mb: "30px" }}>
              <Typography variant="h6">
                Drag Required Variables and Drop into letter draft.
              </Typography>
              <hr></hr>
              {draftVar.map((label) => (
                <span
                  key={label}
                  draggable={isEditing}
                  onDragStart={handleDragStart}
                  style={{
                    margin: 10,
                    backgroundColor: "#0c476e",
                    padding: "5px 8px",
                    cursor: "move",
                    borderRadius: "3px",
                    color: "white",
                    fontWeight: "bold",
                    boxShadow: "0 4px 8px rgba(0, 0, 0, 0.2)",
                    transition: "background-color 0.3s ease",
                    display: "inline-block",
                  }}
                >
                  {label}
                </span>
              ))}
            </Paper>
            <Paper sx={{ height: "48%" }}>
              <Typography variant="h6" ml="2">
                Instructions
              </Typography>
              <hr></hr>
              <Container sx={{ ml: 3 }}>
                <li>Special characters are not allowed</li>
                <li>Only drag variables when in edit mode</li>
                <li>Maximum 2000 words allowed</li>
                <li>Save after making changes</li>
              </Container>
            </Paper>
          </Box>
        </Grid>
        <Grid item xs={12} md={8}>
          <Box
            sx={{
              width: "100%",
              bgcolor: "background.default",
              borderRadius: 2,
              boxShadow: 2,
            }}
          >
            <Typography variant="h6"> Draft</Typography>
            <hr></hr>
            <Paper sx={{ padding: 2 }}>
              <div ref={quillRef} style={{ height: "55vh", overflowY: "auto" }}>
                <ReactQuill
                  style={{ height: "500px" }}
                  theme="snow"
                  modules={modules}
                  value={value}
                  ref={editorRef}
                  onDragover={(e) => e.preventDefault()}
                  onDrop={handleDrop}
                  formats={[
                    "size",
                    "align",
                    "color",
                    "font",
                    "bold",
                    "italic",
                    "underline",
                    "strike",
                    "list",
                    "bullet",
                    "link",
                    "image",
                    "background",
                    "header",
                    "script",
                    "indent",
                  ]}
                  onChange={handleChange}
                  readOnly={!isEditing}
                />
              </div>
              <hr></hr>

              <Box sx={{ mt: 2, textAlign: "right" }}>
                <Typography
                  variant="body2"
                  color="textSecondary"
                  sx={{ mt: 2, textAlign: "left" }}
                >
                  Word Count: {wordCount} / 2000
                </Typography>
                {!isEditing ? (
                  <Button
                    variant="contained"
                    color="primary"
                    onClick={() => setIsEditing(true)}
                    sx={{ mr: 1 }}
                  >
                    Edit
                  </Button>
                ) : (
                  <Button
                    variant="contained"
                    color="error"
                    onClick={() => setIsEditing(false)}
                    sx={{ mr: 1 }}
                  >
                    Cancel
                  </Button>
                )}
                <Button
                  variant="contained"
                  color="info"
                  onClick={handlePreview}
                  sx={{ mr: 1 }}
                >
                  Preview
                </Button>
                <Button variant="contained" color="info" onClick={handleReset}>
                  Reset Template
                </Button>
              </Box>
            </Paper>
          </Box>
        </Grid>
      </Grid>
      {/* Modal for Preview */}
      <Dialogue
        open={isPreviewing}
        close={handleCloseDialog}
        save={handleSave}
        content={templateContent}
      />

      <Snackbar
        open={sbar.isOpen}
        autoHideDuration={6000}
        onClose={() => setSbar({ isOpen: false, Msg: "" })}
        message={sbar.Msg}
      />
    </>
  );
};

const BootstrapDialog = styled(Dialog)(({ theme }) => ({
  "& .MuiDialogContent-root": {
    padding: theme.spacing(2),
  },
  "& .MuiDialogActions-root": {
    padding: theme.spacing(1),
  },
}));

const Dialogue = ({ open, close, save, content }) => {
  return (
    <>
      <BootstrapDialog
        onClose={close}
        aria-labelledby="customized-dialog-title"
        open={open}
        fullWidth
        maxWidth="md"
      >
        <DialogTitle sx={{ m: 0, p: 2 }} id="customized-dialog-title">
          Intimation letter draft preview
        </DialogTitle>
        <IconButton
          aria-label="close"
          onClick={close}
          sx={(theme) => ({
            position: "absolute",
            right: 8,
            top: 8,
            color: theme.palette.grey[500],
          })}
        >
          <CloseIcon />
        </IconButton>
        <DialogContent dividers>
          <div
            style={{
              width: "210mm",
              height: "297mm",
              margin: "0 auto",
              padding: "20mm",
              boxShadow: "0 0 10px rgba(0, 0, 0, 0.1)",
              boxSizing: "border-box",
              backgroundColor: "#ffffff",
              border: "1px solid #ddd",
              overflow: "auto",
              overflowWrap: "break-word",
            }}
            dangerouslySetInnerHTML={{ __html: content }}
          ></div>
        </DialogContent>
        <DialogActions>
          <Button autoFocus onClick={save}>
            Save Draft
          </Button>
        </DialogActions>
      </BootstrapDialog>
    </>
  );
};

export default EmailTemplate;
