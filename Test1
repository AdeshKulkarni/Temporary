const iv = crypto.getRandomValues(new Uint8Array(12)); // for encryption
const ivBase64 = btoa(String.fromCharCode.apply(null, iv)); // for decryption
const salt = crypto.getRandomValues(new Uint8Array(16)); // for encryption
const saltBase64 = btoa(String.fromCharCode.apply(null, salt)); // for decryption

const EmailTemplate = () => {
  const [value, setValue] = useState("Draft will appear here");
  const [sbar, setSbar] = useState({ isOpen: false, Msg: "" });
  const [wordCount, setWordCount] = useState(0);
  const editorRef = useRef();
  const [isEditing, setIsEditing] = useState(false);
  const [isPreviewing, setIsPreviewing] = useState(false);
  const [templateContent, settemplateContent] = useState(null);

  const draftVar = [
    "{{DATE}}",
    "{{REF_NO}}",
    "{{FIRM_NAME}}",
    "{{FRN_NO}}",
    "{{FIRM_ADDR}}",
    "{{ASSIGNMENT_TYPE}}",
    "{{GSTN}}",
  ];

  const sanitizePastedText = (text) => {
    const allowedCharsRegex = /[^a-zA-Z0-9\s.,;!?'"(){}@\-]/g;
    const sanitizedText = text.replace(allowedCharsRegex, "");
    return {
      text: sanitizedText,
      hadInvalidChars: sanitizedText.length !== text.length,
    };
  };

  const quillRef = useRef(null);
  const modules = {
    toolbar: [
      [
        {
          font: Font.whitelist,
        },
      ],
      [
        {
          size: [
            "8px",
            "10px",
            "12px",
            "14px",
            "16px",
            "18px",
            "20px",
            "22px",
            "24px",
            "26px",
          ],
        },
      ],
      [
        { color: ["red", "green", "blue", "black", "orange"] },
        { background: ["red", "green", "blue", "yellow", "gray"] },
      ],
      [{ align: "justify" }, { align: "center" }, { align: "right" }],
      [{ script: "sub" }, { script: "super" }],
      [{ header: [1, 2, 3, false] }],
      [{ list: "ordered" }, { list: "bullet" }],
      ["bold", "italic", "underline", "strike"],
      ["link", "image", "clean"],
      [{ indent: "-1" }, { indent: "+1" }], // Add indent options
    ],
    clipboard: {
      matchVisual: false,
      matchers: [
        [
          "text",
          (node, delta) => {
            if (delta.ops?.length > 0) {
              const newOps = delta.ops.map((op) => {
                if (op.insert && typeof op.insert === "string") {
                  const { text } = sanitizePastedText(op.insert);
                  return { ...op, insert: text };
                }
                return op;
              });
              return { ops: newOps };
            }
            return delta;
          },
        ],
      ],
    },
  };

  useEffect(() => {
    fetchData();
  }, []);

  useEffect(() => {
    const quill = editorRef.current.getEditor();

    const handleTextChange = () => {
      const text = quill.getText();
      const disallowedChars = /[^a-zA-Z0-9\s.,;!?'"(){}@\-]/g;
      const illegalChars = text.match(disallowedChars);

      if (illegalChars?.length > 0) {
        const selection = quill.getSelection();
        const sanitizedText = text.replace(disallowedChars, "");

        quill.updateContents(quill.clipboard.convert(sanitizedText), "silent");

        if (selection) {
          setTimeout(() => {
            const newPosition = Math.min(selection.index, sanitizedText.length);
            quill.setSelection(newPosition, 0, "silent");
          }, 0);
        }

        setSbar({
          isOpen: true,
          Msg: "❌ Special characters were removed!",
        });
      }
    };

    const handlePaste = (e) => {
      e.preventDefault();
      const clipboardData = e.clipboardData || window.clipboardData;
      const pastedText = clipboardData.getData("text/plain");

      const { text: sanitizedText, hadInvalidChars } =
        sanitizePastedText(pastedText);

      if (hadInvalidChars) {
        setSbar({
          isOpen: true,
          Msg: "❌ Special characters were removed from pasted content!",
        });
      }

      const range = quill.getSelection();
      if (range) {
        quill.insertText(range.index, sanitizedText);
        quill.setSelection(range.index + sanitizedText.length, 0);
      }
    };

    quill.on("text-change", handleTextChange);
    quill.root.addEventListener("paste", handlePaste);

    return () => {
      quill.off("text-change", handleTextChange);
      quill.root.removeEventListener("paste", handlePaste);
    };
  }, []);

  const fetchData = async () => {
    try {
      const response = await axios.post(
        "Server/IAMServices/EmailTemplate",
        {},
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      let res = response.data.result;
      console.log(res);
      setValue(res);
      setWordCount(countWord(res));
      // contentSet(res);
    } catch (e) {
      console.log(e);
    }
  };

  function countWord(str) {
    const text = str.replace(/<[^>]*>/g, ""); // Remove HTML tags
    const words = text.trim().split(/\s+/).filter(Boolean);
    return words.length;
  }

  const handleChange = (content, delta, source, editor) => {
    console.log(editor.getHTML());
    let a = editor.getHTML();
    let length = countWord(a);

    if (length > 128) {
      console.log(delta);
      editorRef.current.editor.blur();
      setSbar({
        isOpen: "true",
        Msg: "Word limit exceeded. if You Want Change Anything Click on Edit Button !!",
      });

      setIsEditing(false);
      console.log(editorRef.current.value);
      return;
    }
    setValue(a); // Update the state with the HTML content
    // const text = a.replace(/<[^>]*>/g, ""); // Remove HTML tags
    // const words = text.trim().split(/\s+/).filter(Boolean); // Split by whitespace
    setWordCount(length);
  };

  const handleDragStart = (e) => {
    console.log(e);
    const text = e.target.innerText;
    e.dataTransfer.setData("text", text);
  };

  const handleDrop = (e) => {
    console.log(e);
    e.preventDefault();
    // const cursorPosition = e.target.selectionStart;
    // const newText =
    //   value.slice(0, cursorPosition) +
    //   "{{" +
    //   e.dataTransfer.getData("text") +
    //   "}}" +
    //   value.slice(cursorPosition);
    // setValue(newText);
    var range = editorRef.current.editor?.getSelection(true);
    console.log("range", range);
    // let position = range ? range.index : 0;
    editorRef.current.editor?.insertText(
      range || 0,
      e.dataTransfer.getData("text")
    );
  };

  const handleSave = async () => {
    setIsEditing(false);
    let str = value.match(/\{{2}[A-Z_]+\}{2}/g);
    // let str1 = str.forEach((str) => str.replace(/\{{2}|\}{2}/g, ""));
    console.log(str);
    let checked = str?.filter((w) => {
      return draftVar.some((str) => str === w);
    });
    console.log(checked);
    if (str != null && str.length > checked.length) {
      console.log("inside if");
      setSbar({
        isOpen: true,
        Msg: "Invalid Variable Names added!!  Ensure that entered variable names are correct and there should not be whitespaces between curly braces",
      });
      handleCloseDialog();
      return;
    }

    let dataToSend = { MASTER_TEMPLATE: `<html>${value}</html>` };
    try {
      let jsonFormData = JSON.stringify(dataToSend);
      await encrypt(iv, salt, jsonFormData).then(function (result) {
        jsonFormData = result;
      });
      let payload = {
        iv: ivBase64,
        salt: saltBase64,
        data: jsonFormData,
      };
      const response = await axios.post(
        "Server/IAMServices/saveMasterTemplate",
        payload,
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      if (response.data.statusCode === 200 && response.data.result !== "") {
        console.log("successfull!");
      }
    } catch (error) {
      console.error("Error saving template:", error);
    }
    setSbar({
      isOpen: true,
      Msg: "Saved Successfully!",
    });
    setIsPreviewing("false");
    handleCloseDialog();
  };

  const handlePreview = async () => {
    setIsEditing(false);
    console.log(value);
    let data = {
      DATE: "xx/xx/xxxx",
      REF_NO: "9999xxx",
      FIRM_NAME: "xxxxxxxxxx",
      FRN_NO: "999999999",
      GSTN: "99xx99xx",
      FIRM_ADDR: "xxxxxxxx,xxxxxxxx",
      ASSIGNMENT_TYPE: "xxxxxxx",
    };
    let str = value.replace(/<br\s*\/?>/gi, "<br></br>");
    let StrToSend = str.replace(/\{{2}([A-Z_]+)\}{2}/g, (match, p1) => {
      return data[p1];
    });
    settemplateContent(StrToSend);
    console.log(StrToSend);

    // let StrToSend = value.replace(/<br\s*\/?>/gi, "<br></br>");
    setIsPreviewing(true);
  };

  const handleCloseDialog = () => {
    setIsPreviewing(false); // Close the modal
  };

  function handleblur(e) {
    setValue(e.target.value);
    console.log(e.target.innerHTML);
  }

  //Reset Draft to default one
  const handleReset = async () => {
    try {
      const response = await axios.post(
        "Server/IAMServices/resetTemplate",
        {}, // Sending an empty object
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      let res = response.data.result;
      console.log(res);
      setValue(res); // Assuming res contains the template data
    } catch (e) {
      console.error("Error resetting template:", e);
    }
  };

  return (
    <>
      <Typography gutterBottom variant="h5" component="div">
        Empanelment Intimation Letter Template
      </Typography>
      <Divider />
      <Grid container spacing={2} sx={{ p: 2 }}>
        <Grid item xs={14} md={4}>
          <Box
            sx={{
              height: "100%",
              width: "100%",
              borderRadius: 2,
              boxShadow: 2,
            }}
          >
            <Paper sx={{ height: "48%", mb: "30px" }}>
              <Typography variant="h6">
                Drag Required Variables and Drop into template draft.
              </Typography>
              <hr></hr>
              {draftVar.map((label) => (
                <span
                  key={label}
                  draggable={isEditing}
                  onDragStart={handleDragStart}
                  style={{
                    margin: 10,
                    backgroundColor: "#0c476e",
                    padding: "5px 8px",
                    cursor: "move",
                    borderRadius: "3px",
                    color: "white",
                    fontWeight: "bold",
                    boxShadow: "0 4px 8px rgba(0, 0, 0, 0.2)",
                    transition: "background-color 0.3s ease",
                    display: "inline-block",
                  }}
                >
                  {label}
                </span>
              ))}
            </Paper>
            <Paper sx={{ height: "48%" }}>
              <Typography variant="h6" ml="2">
                Instructions
              </Typography>
              <hr></hr>
              <Container sx={{ ml: 3 }}>
                <li>Special characters are not allowed</li>
                <li>Only </li>
                <li>Ins</li>
                <li>Ins</li>
              </Container>
            </Paper>
          </Box>
        </Grid>
        <Grid item xs={12} md={8}>
          <Box
            sx={{
              width: "100%",
              bgcolor: "background.default",
              borderRadius: 2,
              boxShadow: 2,
            }}
          >
            <Typography variant="h6">Template Draft</Typography>
            <hr></hr>
            <Paper sx={{ padding: 2 }}>
              <div ref={quillRef} style={{ height: "55vh", overflowY: "auto" }}>
                {" "}
                {/* Increased height for the editor */}
                <ReactQuill
                  style={{ height: "500px" }}
                  theme="snow"
                  modules={modules}
                  value={value}
                  ref={editorRef}
                  onDragover={(e) => e.preventDefault()}
                  onDrop={handleDrop}
                  formats={[
                    "size",
                    "align",
                    "color",
                    "font",
                    "bold",
                    "italic",
                    "underline",
                    "strike",
                    "list",
                    "bullet",
                    "link",
                    "image",
                    "background",
                    "header",
                    "script",
                    "indent",
                  ]}
                  onChange={handleChange}
                  readOnly={!isEditing}
                />
                {/* <SlateComp/> */}
                {/* <RTE iv={value} /> */}
              </div>
              <hr></hr>

              <Box sx={{ mt: 2, textAlign: "right" }}>
                <Typography
                  variant="body2"
                  color="textSecondary"
                  sx={{ mt: 2, textAlign: "left" }}
                >
                  Word Count: {wordCount} / 2000
                </Typography>
                {!isEditing ? (
                  <Button
                    variant="contained"
                    color="primary"
                    onClick={() => setIsEditing(true)}
                    sx={{ mr: 1 }}
                  >
                    Edit
                  </Button>
                ) : (
                  <Button
                    variant="contained"
                    color="error"
                    onClick={() => setIsEditing(false)}
                    sx={{ mr: 1 }}
                  >
                    Cancel
                  </Button>
                )}
                <Button
                  variant="contained"
                  color="info"
                  onClick={handlePreview}
                  sx={{ mr: 1 }}
                >
                  Preview
                </Button>
                <Button variant="contained" color="info" onClick={handleReset}>
                  Reset Template
                </Button>
              </Box>
            </Paper>
          </Box>
        </Grid>
      </Grid>
      {/* Modal for Preview */}
      <Dialogue
        open={isPreviewing}
        close={handleCloseDialog}
        save={handleSave}
        content={templateContent}
      />

      <Snackbar
        open={sbar.isOpen}
        autoHideDuration={6000}
        onClose={() => setSbar({ isOpen: false, Msg: "" })}
        message={sbar.Msg}
      />
    </>
  );
};

