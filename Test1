import React, { useState, useEffect, useMemo } from "react";
import {
  Divider,
  Typography,
  Box,
  Stack,
  Button,
  Paper,
  MenuItem,
  TextField,
  Tabs,
  Tab,
} from "@mui/material";
import { DataGrid, GridToolbar, GridOverlay } from "@mui/x-data-grid";
import { encrypt } from "../../Security/AES-GCM256";
import axios from "axios";
import downloadFile from "../../DownloadFile/DownloadFile";

// These should be generated per request for security.
// For demonstration, we define them once.
const iv = crypto.getRandomValues(new Uint8Array(12));
const ivBase64 = btoa(String.fromCharCode(...iv));
const salt = crypto.getRandomValues(new Uint8Array(16));
const saltBase64 = btoa(String.fromCharCode(...salt));

const EmpanelmentData = () => {
  const [empanelmentData, setEmpanelmentData] = useState([]);
  // Consolidated user input state
  const [userIp, setUserIp] = useState({
    selectionMode: "Empanelment", // New state: 'Empanelment' or 'Assignment'
    datatype: "Active",
    type: "",
    subType: "",
    year: "",
  });
  const [selectionOptions, setSelectionOptions] = useState({});
  const [archiveYears, setArchiveYears] = useState([]);
  const [loadingYears, setLoadingYears] = useState(false);

  // DataGrid columns definition (assuming both APIs return compatible data)
  const columns = [
    { field: "FRN", headerName: "FRN", width: 170, flex: 1 },
    { field: "FIRM_NAME", headerName: "FIRM NAME", width: 200, flex: 1.5 },
    {
      field: "EMPANELMENT_SUB_TYPE",
      headerName: "EMPANELMENT SUB TYPE",
      width: 280,
      flex: 2,
      valueGetter: (params) => {
        // Find the corresponding subtype name from the options
        // This logic now needs to search across all types for a matching ID
        for (const typeKey in selectionOptions) {
          const foundOption = selectionOptions[typeKey].find(
            (ent) => String(ent.ASSIGNMENT_TYPE_ID) === String(params.value)
          );
          if (foundOption) {
            return foundOption.ASSIGNMENT_SUBTYPE;
          }
        }
        return params.value; // Fallback to the ID if not found
      },
    },
    {
      field: "EMPANELMENT_TYPE",
      headerName: "EMPANELMENT TYPE",
      width: 160,
      flex: 1,
    },
    {
      field: "CONTACT_PERSON",
      headerName: "Contact Person",
      width: 180,
      flex: 1,
    },
    {
      field: "POC_EMAIL",
      headerName: "Contact Email",
      width: 220,
      flex: 1,
    },
  ];

  const filteredRows = useMemo(() => {
    let data = Array.isArray(empanelmentData)
      ? empanelmentData.filter(
          (row) =>
            row &&
            typeof row === "object" &&
            row.FRN &&
            row.EMPANELMENT_SUB_TYPE !== undefined
        )
      : [];
    // The existing filters will work as intended. If a filter is empty, it's ignored.
    if (userIp.type) {
      data = data.filter((row) => row.EMPANELMENT_TYPE === userIp.type);
    }
    if (userIp.subType) {
      data = data.filter(
        (row) => String(row.EMPANELMENT_SUB_TYPE) === String(userIp.subType)
      );
    }
    return data;
  }, [empanelmentData, userIp.type, userIp.subType]);

  /**
   * Fetches the assignment type options for filters when the component mounts.
   */
  useEffect(() => {
    fetchOptions();
  }, []);

  /**
   * Main data fetching trigger.
   * Calls the correct fetch function based on the selectionMode.
   */
  useEffect(() => {
    // Only fetch if a subtype has been selected
    if (userIp.subType) {
      if (userIp.selectionMode === "Empanelment") {
        fetchEmpanelmentData();
      } else if (userIp.selectionMode === "Assignment") {
        fetchAssignmentData();
      }
    } else {
        setEmpanelmentData([]); // Clear data if no subtype is selected
    }
  }, [userIp.selectionMode, userIp.datatype, userIp.type, userIp.subType, userIp.year]);

  /**
   * Fetches archive years when switching to the "Archive" tab.
   */
  useEffect(() => {
    if (userIp.datatype === "Archive") {
      fetchArchiveYears();
    }
  }, [userIp.datatype]);

  /**
   * Fetches assignment types and subtypes to populate the filter dropdowns.
   */
  const fetchOptions = async () => {
    try {
      const response = await axios.post(
        "Server/IAMServices/getAssignmentType",
        {},
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      const result = response.data.result || [];
      const options = {};
      const typeNames = new Set(result.map((op) => op.ASSIGNMENT_TYPE_NAME));
      typeNames.forEach((typeName) => {
        options[typeName] = result.filter(
          (op) => op.ASSIGNMENT_TYPE_NAME === typeName
        );
      });
      setSelectionOptions(options);
    } catch (e) {
      console.error("Failed to fetch selection options:", e);
    }
  };

  /**
   * Fetches the list of years for which archived data is available.
   */
  const fetchArchiveYears = async () => {
    setLoadingYears(true);
    try {
      const response = await axios.post(
        "Server/IAMServices/getArchiveYears",
        {},
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      setArchiveYears(response.data.result || []);
    } catch (e) {
      console.error("Failed to fetch archive years:", e);
    } finally {
      setLoadingYears(false);
    }
  };

  /**
   * Generic function to encrypt and post data.
   */
  const postEncryptedData = async (url, dataToSend) => {
    const jsonFormData = JSON.stringify(dataToSend);
    const encryptedData = await encrypt(iv, salt, jsonFormData);
    const payload = {
      iv: ivBase64,
      salt: saltBase64,
      data: encryptedData,
    };
    return axios.post(url, payload, {
      headers: {
        Authorization: `Bearer ${localStorage.getItem("token")}`,
      },
    });
  };

  /**
   * Fetches the EMPANELMENT data from the server based on current filters.
   */
  const fetchEmpanelmentData = async () => {
    const dataToSend = {
      Type: userIp.datatype,
      EMPANELMENT_TYPE: userIp.type,
      EMPANELMENT_SUB_TYPE: userIp.subType,
      financial_year: userIp.year,
    };
    try {
      const response = await postEncryptedData(
        "Server/IAMServices/getActiveFRN",
        dataToSend
      );
      setEmpanelmentData(response.data.result || []);
    } catch (e) {
      console.error("Failed to fetch empanelment data:", e);
      setEmpanelmentData([]);
    }
  };

  /**
   * NEW: Fetches the ASSIGNMENT data from the server.
   */
  const fetchAssignmentData = async () => {
    const dataToSend = {
      // Assuming the API for assignment data needs these fields. Adjust as necessary.
      Type: userIp.datatype,
      EMPANELMENT_SUB_TYPE: userIp.subType,
      financial_year: userIp.year,
    };
    try {
      const response = await postEncryptedData(
        "Server/IAMServices/fetchAssignData",
        dataToSend
      );
      setEmpanelmentData(response.data.result || []);
    } catch (e) {
      console.error("Failed to fetch assignment data:", e);
      setEmpanelmentData([]);
    }
  };

  /**
   * Handles the "Download Excel" button click.
   */
  const handleDownload = async () => {
    if (filteredRows.length === 0) {
      alert("No data to download.");
      return;
    }
    try {
      const jsonFormData = JSON.stringify(filteredRows);
      const encryptedData = await encrypt(iv, salt, jsonFormData);
      const payload = {
        iv: ivBase64,
        salt: saltBase64,
        data: encryptedData,
      };
      const response = await axios.post(
        "Server/IAMServices/download_empanelment_data",
        payload,
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      const resData = response.data.result;
      if (resData) {
        downloadFile(resData, "excel", `${userIp.datatype}_${userIp.selectionMode}_list`);
      }
    } catch (e) {
      console.error("Failed to download Excel file:", e);
    }
  };

  /**
   * Custom overlay component to display when the DataGrid has no rows.
   */
  const CustomNoRowsOverlay = () => {
    let message = "No data available. Please select filters to begin.";
    
    // Message logic for 'Assignment' mode
    if (userIp.selectionMode === "Assignment") {
        if (userIp.subType) {
            message = `No data available for the selected Assignment Subtype.`;
        } else {
            message = `Please select an Assignment Sub Type.`;
        }
    } 
    // Message logic for 'Empanelment' mode
    else {
        if (userIp.type && userIp.subType) {
            message = `No data available for the selected Type and Subtype.`;
        } else if (userIp.type) {
            message = `Please select a Sub Type for '${userIp.type}'.`;
        } else {
            message = "Please select a Type and Sub Type.";
        }
    }

    if (userIp.datatype === "Archive" && userIp.year) {
        message += ` in Financial Year: ${userIp.year}.`;
    }

    return (
      <GridOverlay>
        <Box p={2} sx={{ textAlign: "center", color: "text.secondary" }}>
          <Typography>{message}</Typography>
        </Box>
      </GridOverlay>
    );
  };
  
  /**
   * Handles changing the top-level mode between "Empanelment" and "Assignment".
   * Resets all other filters.
   */
  const handleModeChange = (event) => {
    setUserIp({
        selectionMode: event.target.value,
        datatype: "Active", // Reset to default tab
        type: "",
        subType: "",
        year: "",
    });
    setEmpanelmentData([]); // Clear data on mode switch
  };

  /**
   * Handles changing between "Active" and "Archive" tabs.
   * Resets all filters EXCEPT for the main selection mode.
   */
  const handleTabChange = (event, newValue) => {
    setUserIp((prev) => ({ 
        ...prev,
        datatype: newValue, 
        type: "", 
        subType: "", 
        year: "" 
    }));
    setEmpanelmentData([]); // Clear data on tab switch
  };

  const handleSelectType = (type) => {
    setUserIp((prev) => ({ ...prev, type, subType: "" }));
  };

  const handleSelectSubType = (subType) => {
    setUserIp((prev) => ({ ...prev, subType }));
  };

  const handleSelectYear = (year) => {
    setUserIp((prev) => ({ ...prev, year }));
  };
  
  // Determine if the DataGrid should be visible
  const showDataGrid = userIp.subType && (
    (userIp.selectionMode === "Empanelment" && userIp.type) ||
    (userIp.selectionMode === "Assignment")
  );

  return (
    <Box sx={{ width: "100%" }}>
      <Typography variant="h5" sx={{ mb: 2 }}>
        Empanelment & Assignment Data
      </Typography>
      <Divider sx={{ mb: 3 }} />

      <Paper sx={{ width: "100%", overflow: "hidden", p: 2 }}>
        <Box>
          <Tabs
            value={userIp.datatype}
            onChange={handleTabChange}
            sx={{ borderBottom: 1, borderColor: "divider" }}
          >
            <Tab label="Active" value="Active" />
            <Tab label="Archive" value="Archive" />
          </Tabs>
        </Box>

        {/* Filter Controls */}
        <Stack
          direction={{ xs: "column", sm: "row" }}
          spacing={2}
          sx={{ pl: 3, pr: 3, pb: 3, pt: 2 }}
          alignItems={{ xs: "stretch", sm: "center" }}
        >
          {/* NEW: Main Selection Dropdown */}
          <TextField
            select
            label="Select Mode"
            value={userIp.selectionMode}
            onChange={handleModeChange}
            sx={{ width: { xs: "100%", sm: 200 } }}
            size="small"
          >
            <MenuItem value="Empanelment">Empanelment</MenuItem>
            <MenuItem value="Assignment">Assignment</MenuItem>
          </TextField>

          {userIp.datatype === "Archive" && (
            <TextField
              select
              label="Year"
              value={userIp.year}
              onChange={(e) => handleSelectYear(e.target.value)}
              sx={{ width: { xs: "100%", sm: 200 } }}
              size="small"
              disabled={loadingYears}
            >
              {archiveYears.map((year) => (
                <MenuItem key={year} value={year}>
                  {year}
                </MenuItem>
              ))}
            </TextField>
          )}

          {/* Conditionally render Type dropdown only for Empanelment mode */}
          {userIp.selectionMode === "Empanelment" && (
            <TextField
              select
              label="Type"
              value={userIp.type}
              onChange={(e) => handleSelectType(e.target.value)}
              sx={{ width: { xs: "100%", sm: 200 } }}
              size="small"
            >
              {Object.keys(selectionOptions).map((type) => (
                <MenuItem key={type} value={type}>
                  {type}
                </MenuItem>
              ))}
            </TextField>
          )}

          {/* Sub Type Dropdown - available in both modes */}
          {/* Condition to show it is now dependent on mode */}
          {(userIp.selectionMode === "Assignment" || (userIp.selectionMode === "Empanelment" && userIp.type)) && (
            <TextField
              select
              label="Sub Type"
              value={userIp.subType}
              onChange={(e) => handleSelectSubType(e.target.value)}
              sx={{ width: { xs: "100%", sm: 220 } }}
              size="small"
            >
              {/* For Empanelment, filter options by type. For Assignment, show all subtypes. */}
              {userIp.selectionMode === "Empanelment"
                ? (selectionOptions[userIp.type] || []).map((option) => (
                    <MenuItem
                      key={option.ASSIGNMENT_TYPE_ID}
                      value={option.ASSIGNMENT_TYPE_ID}
                    >
                      {option.ASSIGNMENT_SUBTYPE}
                    </MenuItem>
                  ))
                : Object.values(selectionOptions).flat().map((option) => (
                    <MenuItem
                        key={option.ASSIGNMENT_TYPE_ID}
                        value={option.ASSIGNMENT_TYPE_ID}
                    >
                        {/* Show type for clarity in Assignment mode */}
                        {option.ASSIGNMENT_TYPE_NAME} - {option.ASSIGNMENT_SUBTYPE}
                    </MenuItem>
                ))}
            </TextField>
          )}
        </Stack>

        {/* Data Grid and Action Buttons */}
        {showDataGrid && (
          <Box sx={{ width: "100%" }}>
            <Box
              sx={{
                display: "flex",
                justifyContent: "flex-end",
                mb: 1,
                alignItems: "center",
              }}
            >
              <Typography
                variant="body2"
                sx={{
                  fontStyle: "italic",
                  color: "text.secondary",
                  mr: "auto",
                }}
              >
                *Excel download contains all available data fields.
              </Typography>
              <Button
                onClick={handleDownload}
                variant="contained"
                size="medium"
                disabled={filteredRows.length === 0}
              >
                Download Excel
              </Button>
            </Box>

            <Box sx={{ height: 500, width: "100%" }}>
              <DataGrid
                rows={filteredRows}
                columns={columns}
                getRowId={(row) =>
                  row.FRN ??
                  `${row.EMPANELMENT_TYPE}_${
                    row.EMPANELMENT_SUB_TYPE
                  }_${Math.random()}`
                }
                slots={{
                  noRowsOverlay: CustomNoRowsOverlay,
                  toolbar: GridToolbar,
                }}
                pageSizeOptions={[10, 25, 50]}
                initialState={{
                  pagination: {
                    paginationModel: { pageSize: 10 },
                  },
                }}
                sx={{
                  "& .MuiDataGrid-columnHeaders": {
                    backgroundColor: "grey.100",
                    fontWeight: "bold",
                  },
                }}
              />
            </Box>
          </Box>
        )}
      </Paper>
    </Box>
  );
};

export default EmpanelmentData;
