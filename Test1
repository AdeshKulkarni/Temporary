package com.fincore.VoucherService.config;

import com.fasterxml.jackson.databind.DeserializationFeature;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.SerializationFeature;
import com.fasterxml.jackson.datatype.jsr310.JavaTimeModule;
import lombok.extern.slf4j.Slf4j;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.context.annotation.Primary;

/**
 * Configures global beans such as the Jackson ObjectMapper for consistent JSON processing.
 * Ensures that Java 8 Date/Time types are serialized in ISO-8601 format across the service.
 */
@Configuration
@Slf4j
public class AppConfig {

    /**
     * Configures the primary ObjectMapper used by Spring Boot for REST request/response bodies.
     * Enforces human-readable date formats and JSR-310 compatibility.
     */
    @Bean
    @Primary
    public ObjectMapper objectMapper() {
        log.info("APP_CONFIG_INIT | Configuring Primary Jackson ObjectMapper");

        ObjectMapper mapper = new ObjectMapper();
        mapper.registerModule(new JavaTimeModule());
        mapper.disable(SerializationFeature.WRITE_DATES_AS_TIMESTAMPS);

        // --- NEW: THE ULTIMATE SAFETY NETS ---
        // 1. Forces Jackson to ignore ANY extra/garbage fields sent by ST or React
        mapper.configure(DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES, false);

        // 2. Forces Jackson to treat empty strings ("") as null instead of crashing
        mapper.configure(DeserializationFeature.ACCEPT_EMPTY_STRING_AS_NULL_OBJECT, true);

        // 3. Allows single values to be read as arrays (prevents mismatch crashes)
        mapper.configure(DeserializationFeature.ACCEPT_SINGLE_VALUE_AS_ARRAY, true);

        return mapper;
    }
}



package com.fincore.VoucherService.config;

import lombok.extern.slf4j.Slf4j;
import org.springframework.aop.interceptor.AsyncUncaughtExceptionHandler;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.scheduling.annotation.AsyncConfigurer;
import org.springframework.scheduling.annotation.EnableAsync;
import org.springframework.scheduling.annotation.EnableScheduling;
import org.springframework.scheduling.concurrent.ThreadPoolTaskExecutor;

import java.util.concurrent.Executor;

/**
 * Configures dedicated thread pools for high-volume row processing and chunking.
 * Implements global error handling for fire-and-forget async tasks.
 */
@Configuration
@EnableAsync
@EnableScheduling
@Slf4j
public class AsyncConfig implements AsyncConfigurer {


    @Bean(name = "progressExecutor")
    public Executor progressExecutor() {
        log.info("ASYNC_CONFIG_INIT | Initializing Dedicated Progress Thread Pool");
        ThreadPoolTaskExecutor executor = new ThreadPoolTaskExecutor();
        executor.setCorePoolSize(5);
        executor.setMaxPoolSize(10);
        executor.setQueueCapacity(2000);
        executor.setThreadNamePrefix("Progress-");
        executor.initialize();
        return executor;
    }

    /**
     * Dedicated executor for high-volume journal operations (Coordinator pool).
     * Logic for pool sizing and queue capacity is preserved exactly as established.
     */
    @Bean(name = "bulkExecutor")
    public Executor bulkExecutor() {
        ThreadPoolTaskExecutor executor = new ThreadPoolTaskExecutor();
        executor.setCorePoolSize(10);
        executor.setMaxPoolSize(20);
        executor.setQueueCapacity(100);
        executor.setThreadNamePrefix("BulkCoord-");
        executor.initialize();
        return executor;
    }
    /**
     * Dedicated worker pool specifically for processing inner batch chunks.
     * Prevents deadlock by separating chunk processing from the main coordinator threads.
     */
    @Bean(name = "chunkWorkerExecutor")
    public Executor chunkWorkerExecutor() {
        ThreadPoolTaskExecutor executor = new ThreadPoolTaskExecutor();
        executor.setCorePoolSize(25);
        executor.setMaxPoolSize(50);
        executor.setQueueCapacity(500);
        executor.setThreadNamePrefix("BulkWriter-");
        executor.setRejectedExecutionHandler(new java.util.concurrent.ThreadPoolExecutor.CallerRunsPolicy());
        executor.initialize();
        return executor;
    }

    /**
     * Global handler for uncaught exceptions in @Async methods that return void.
     * Replaces generic catching with structured, descriptive logging.
     */
    @Override
    public AsyncUncaughtExceptionHandler getAsyncUncaughtExceptionHandler() {
        return (ex, method, params) -> {
            log.error("ASYNC_TASK_EXCEPTION | Method: {} | Exception: {}",
                    method.getName(), ex.getClass().getSimpleName());

            if (ex instanceof org.springframework.dao.DataAccessException) {
                log.error("ASYNC_DATA_FAILURE | Status: Database connectivity lost in background thread");
            } else if (ex instanceof NullPointerException) {
                log.error("ASYNC_LOGIC_FAILURE | Status: Null pointer encountered in async task");
            }
            else {
                log.error("ASYNC_TECHNICAL_FAULT | Status: Unexpected background error");
            }
        };
    }
}
package com.fincore.VoucherService.config;

import lombok.extern.slf4j.Slf4j;
import org.springframework.cache.annotation.EnableCaching;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

@Configuration
@EnableCaching
@Slf4j
public class CacheConfig {

    @Bean
    public org.springframework.cache.CacheManager cacheManager(
            org.springframework.data.redis.connection.RedisConnectionFactory connectionFactory) {

        log.info("CACHE_CONFIG_INIT | Using Redis-backed CacheManager for K8s compatibility");

        org.springframework.data.redis.cache.RedisCacheConfiguration config =
                org.springframework.data.redis.cache.RedisCacheConfiguration.defaultCacheConfig()
                        .entryTtl(java.time.Duration.ofMinutes(30))
                        .disableCachingNullValues()
                        .serializeValuesWith(
                                org.springframework.data.redis.serializer.RedisSerializationContext.SerializationPair
                                        .fromSerializer(new org.springframework.data.redis.serializer.GenericJackson2JsonRedisSerializer()));

        return org.springframework.data.redis.cache.RedisCacheManager.builder(connectionFactory)
                .cacheDefaults(config)
                .withCacheConfiguration("notification_configs",
                        config.entryTtl(java.time.Duration.ofHours(1)))
                .build();
    }
}


