import React, { useState, useMemo } from 'react';
import {
  Button,
  Box,
  Paper,
  Typography,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Checkbox,
  IconButton
} from '@mui/material';
import { DataGrid, GridToolbar } from '@mui/x-data-grid';
import PreviewIcon from '@mui/icons-material/Preview';

const NamesPreviewComponent = () => {
  const [selectedRows, setSelectedRows] = useState([]);
  const [previewData, setPreviewData] = useState(null);
  
  // Generate stable rows with serial numbers
  const rows = useMemo(() => {
    const names = [
      'Emma Johnson', 'Noah Smith', 'Olivia Williams', 'Liam Brown', 
      'Ava Jones', 'William Garcia', 'Sophia Miller', 'James Davis',
      'Isabella Rodriguez', 'Benjamin Martinez'
    ];
    
    const count = 5 + Math.floor(Math.random() * 5); // 5-10 names
    return names.slice(0, count).map((name, index) => ({
      id: index + 1,
      serial: index + 1,
      name,
      department: ['HR', 'Finance', 'IT', 'Marketing'][Math.floor(Math.random() * 4)],
      position: ['Manager', 'Developer', 'Analyst', 'Designer'][Math.floor(Math.random() * 4)]
    }));
  }, []);

  const columns = [
    {
      field: 'selected',
      headerName: 'Select',
      width: 80,
      renderHeader: () => (
        <Checkbox
          checked={selectedRows.length === rows.length}
          indeterminate={selectedRows.length > 0 && selectedRows.length < rows.length}
          onChange={handleSelectAll}
        />
      ),
      renderCell: (params) => (
        <Checkbox
          checked={selectedRows.includes(params.row.id)}
          onChange={() => handleSelectRow(params.row.id)}
        />
      )
    },
    {
      field: 'serial',
      headerName: 'Sr. No',
      width: 100,
    },
    {
      field: 'name',
      headerName: 'Name',
      flex: 1,
      minWidth: 200
    },
    {
      field: 'department',
      headerName: 'Department',
      width: 150,
    },
    {
      field: 'preview',
      headerName: 'Preview',
      width: 120,
      sortable: false,
      filterable: false,
      renderCell: (params) => (
        <Button
          variant="outlined"
          color="primary"
          size="small"
          startIcon={<PreviewIcon />}
          onClick={() => handleRowPreview(params.row)}
          sx={{ 
            textTransform: 'none',
            '&:hover': {
              backgroundColor: 'primary.light',
              color: 'primary.contrastText'
            }
          }}
        >
          Preview
        </Button>
      )
    }
  ];

  const handleSelectRow = (id) => {
    setSelectedRows(prev => 
      prev.includes(id) 
        ? prev.filter(rowId => rowId !== id) 
        : [...prev, id]
    );
  };

  const handleSelectAll = () => {
    if (selectedRows.length === rows.length) {
      setSelectedRows([]);
    } else {
      setSelectedRows(rows.map(row => row.id));
    }
  };

  const handleRowPreview = (rowData) => {
    setPreviewData(rowData);
  };

  const handleClosePreview = () => {
    setPreviewData(null);
  };

  return (
    <Box sx={{ p: 3 }}>
      <Paper elevation={3} sx={{ p: 3, borderRadius: 2 }}>
        <Typography variant="h6" gutterBottom sx={{ mb: 2 }}>
          Employee Selection
        </Typography>
        
        <Box sx={{ height: 400, width: '100%' }}>
          <DataGrid
            rows={rows}
            columns={columns}
            getRowId={(row) => row.id}
            disableColumnMenu
            hideFooterSelectedRowCount
            components={{
              Toolbar: GridToolbar,
            }}
            componentsProps={{
              toolbar: {
                showQuickFilter: true,
                quickFilterProps: { debounceMs: 500 },
              },
            }}
          />
        </Box>
      </Paper>
      
      {/* Preview Dialog */}
      <Dialog 
        open={!!previewData} 
        onClose={handleClosePreview}
        maxWidth="sm"
        fullWidth
      >
        <DialogTitle>Employee Details Preview</DialogTitle>
        
        <DialogContent dividers>
          {previewData && (
            <Box sx={{ p: 2 }}>
              <Typography variant="subtitle1" gutterBottom>
                <strong>Name:</strong> {previewData.name}
              </Typography>
              <Typography variant="subtitle1" gutterBottom>
                <strong>Serial No:</strong> {previewData.serial}
              </Typography>
              <Typography variant="subtitle1" gutterBottom>
                <strong>Department:</strong> {previewData.department}
              </Typography>
              <Typography variant="subtitle1" gutterBottom>
                <strong>Position:</strong> {previewData.position || 'N/A'}
              </Typography>
            </Box>
          )}
        </DialogContent>
        
        <DialogActions>
          <Button 
            onClick={handleClosePreview} 
            color="primary"
            variant="contained"
          >
            Close
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
};

export default NamesPreviewComponent;
