@Service
@RequiredArgsConstructor
@Slf4j
public class NotificationWriterService {

    private final NotificationRepository notificationRepository;
    private final StringRedisTemplate stringRedisTemplate;
    private final ObjectMapper objectMapper;

    @Value("${notification.alert.topic:notifications:alerts}")
    private String alertTopic;

    /**
     * Core method to save and broadcast the notification.
     * Uses REQUIRES_NEW so the alert fires instantly during long background tasks.
     */
    @Transactional(propagation = Propagation.REQUIRES_NEW)
    public void createNotification(String userId, String targetRole, String message, String linkUrl, String aggregateId, String eventSource) {

        if (userId == null && targetRole == null) {
            log.warn("NOTIFICATION_SKIPPED | Reason: Recipient missing | AggregateID: {}", aggregateId);
            return;
        }

        if (message == null || message.isBlank()) {
            throw new IllegalArgumentException("Notification message content is required.");
        }

        try {
            Notifications notification = Notifications.builder()
                    .userId(userId)
                    .targetRole(targetRole)
                    .message(message)
                    .linkUrl(linkUrl)
                    .aggregateId(aggregateId)
                    .eventSource(eventSource)
                    .build();

            // 1. Save to Database (Like your friend's code)
            Notifications savedNotification = notificationRepository.save(notification);

            // 2. Broadcast to Redis for live UI updates (Required for your async architecture)
            try {
                String jsonPayload = objectMapper.writeValueAsString(savedNotification);
                stringRedisTemplate.convertAndSend(alertTopic, jsonPayload);
            } catch (JsonProcessingException e) {
                log.error("NOTIFICATION_BROADCAST_FAIL | AggregateID: {} | Reason: JSON Serialization failed", aggregateId);
            }

            log.info("NOTIFICATION_SENT | User/Role: {} | Ref: {}", (userId != null ? userId : targetRole), aggregateId);

        } catch (DataAccessException e) {
            log.error("NOTIFICATION_DB_FAIL | AggregateID: {} | Reason: Database persistence failure", aggregateId);
            throw e;
        }
    }

    // ==================================================================================
    // HELPER METHODS (Adapted from your friend's architecture for cleaner code)
    // ==================================================================================

    public void createBatchApprovedNotification(String batchId, String creatorId, String approverId) {
        String message = "Your voucher Batch '" + batchId + "' has been APPROVED by " + approverId;
        createNotification(creatorId, null, message, "/voucher-view/" + batchId, batchId, "VoucherService");
    }

    public void createBatchRejectedNotification(String batchId, String creatorId, String rejectorId, String reason) {
        String message = "Your voucher Batch '" + batchId + "' was REJECTED by " + rejectorId + ". Reason: " + reason;
        createNotification(creatorId, null, message, "/voucher-view/" + batchId, batchId, "VoucherService");
    }

    /**
     * Alerts the Checkers that a batch is waiting for them.
     * As per architecture, USER_ID is strictly NULL so it maps cleanly to TARGET_ROLE.
     */
    public void createNextStepApprovalNotification(String batchId, String targetRoleId) {
        String message = "Journal Batch '" + batchId + "' has advanced to your stage and requires your review.";
        // First parameter (userId) is explicitly forced to null
        createNotification(null, targetRoleId, message, "/voucher-authorization", batchId, "VoucherService");
    }

    /**
     * Alerts ALL previous actors (Creator + Previous Checkers) that the batch was rejected.
     */
    public void createBatchRejectedNotificationForUsers(String batchId, List<String> previousActors, String rejectorId, String reason) {
        String message = "voucher Batch '" + batchId + "' was REJECTED by " + rejectorId + ". Reason: " + reason;

        for (String userId : previousActors) {
            // Sends a direct alert to each individual User ID
            createNotification(userId, null, message, "/voucher-view/" + batchId, batchId, "VoucherService");
        }
    }


    /**
     * Alerts both the Batch Creator and the original VID Creator of any progress.
     */
    public void createBatchUpdateNotificationForCreators(String batchId, String vid, String batchCreator, String vidCreator, String actionName, String executorId) {

        // 1. Notify the Batch Creator
        String batchMsg = "Your Journal Batch '" + batchId + "' was " + actionName + " by " + executorId + ".";
        createNotification(batchCreator, null, batchMsg, "/voucher-posting-status", batchId, "VoucherService");

        // 2. Notify the original VID Creator (ONLY if they are a different person)
        if (vidCreator != null && !vidCreator.equalsIgnoreCase(batchCreator)) {
            String vidMsg = "A voucher Batch '" + batchId + "' utilizing your Voucher ID '" + vid + "' was " + actionName + " by " + executorId + ".";
            createNotification(vidCreator, null, vidMsg, "/voucher-view/" + batchId, batchId, "VoucherService");
        }
    }


    /**
     * Alerts the Checkers and the Maker that the SLA time limit has been breached.
     * Uses 'EscalationEngine' as the source to prevent duplicate spamming.
     */
    public void createEscalationNotification(String batchId, String targetRoleId, String stageName, String creatorId) {

        // 1. Send High-Priority Alert to the Checkers responsible for this stage
        String checkerMsg = "ESCALATION: voucher Batch '" + batchId + "' has breached the " + stageName + " SLA limit. Immediate action required.";
        createNotification(null, targetRoleId, checkerMsg, "/voucher-authorization", batchId, "EscalationEngine");

        // 2. Keep the Maker informed that there is a delay
        String makerMsg = "UPDATE: Your Batch '" + batchId + "' is taking longer than expected at the " + stageName + " stage. The respective team has been alerted.";
        createNotification(creatorId, null, makerMsg, "/voucher-posting-status", batchId, "EscalationEngine");
    }


}

