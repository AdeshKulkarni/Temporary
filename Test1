Of course. You can achieve the exact same result without using the class keyword by defining the blot with JavaScript's older, prototype-based syntax.
While React components can be functional, Quill's internal system for defining custom content (called "blots") is based on object inheritance. The following code uses functions and prototypes to create the blot, which is functionally identical to the class approach.
1. Define the Blot without class
Instead of a class, we'll use a constructor function and attach methods to its prototype. Place this code outside your component, right after the Quill imports.
// 1. Define the Custom Blot using prototype syntax
const Quill = require('quill');
const Embed = Quill.import('blots/embed');

function VariableBlot(domNode) {
  // This constructor is used by Quill internally
  // We can leave it empty for an Embed blot
}

// Set up inheritance from Quill's Embed blot
VariableBlot.prototype = Object.create(Embed.prototype);
VariableBlot.prototype.constructor = VariableBlot;

// Define the static 'create' method required by Quill
VariableBlot.create = function(value) {
  let node = Embed.create.call(this); // Call the parent 'create' method
  node.innerText = value; // Set the button's text from the dropped value
  
  // Make it non-editable and style it to look like a button/tag
  node.setAttribute('contenteditable', 'false');
  Object.assign(node.style, {
    backgroundColor: '#0c476e',
    color: 'white',
    padding: '3px 8px',
    borderRadius: '3px',
    fontWeight: 'bold',
    margin: '0 2px',
    cursor: 'default',
    userSelect: 'none',
  });
  return node;
};

// Define the static 'value' method to retrieve data from the DOM node
VariableBlot.value = function(domNode) {
  return domNode.innerText;
};

// Assign static properties for Quill to identify the blot
VariableBlot.blotName = 'variable';
VariableBlot.tagName = 'button';

2. Register the Blot & Update handleDrop (No Changes Needed Here)
The rest of your code remains exactly the same. You still register the VariableBlot and use insertEmbed in your drop handler.
Register in useEffect
This part is unchanged. It registers the blot we defined above.
useEffect(() => {
  // 2. Register the Custom Blot with Quill
  Quill.register(VariableBlot);
  fetchData();
}, []); // Runs only once

Update handleDrop
This function is also unchanged. It simply tells Quill to insert a 'variable' blot by its registered name.
const handleDrop = (e) => {
  e.preventDefault();
  if (!isEditing) return;

  const editor = bodyEditorRef.current?.getEditor();
  if (!editor) return;

  const text = e.dataTransfer.getData('text');
  const range = editor.getSelection(true);

  if (range) {
    // 3. Insert the registered blot by its name
    editor.insertEmbed(range.index, 'variable', text, Quill.sources.USER);

    // Add a space after for better UX
    editor.insertText(range.index + 1, ' ', Quill.sources.USER);
    editor.setSelection(range.index + 2);
  }
};

By using this prototype-based approach, you satisfy the "no class" requirement while still correctly integrating with Quill's blot architecture to get the functional, non-editable button you want in the editor.
