static create(value) {
  const node = super.create();
  node.setAttribute("contenteditable", "false");
  node.classList.add("variable-blot");
  const text = document.createElement("span");
  text.innerText = value;

  const closer = document.createElement("span");
  closer.innerText = "X";
  closer.classList.add("variable-delete-icon");
  node.appendChild(text);
  node.appendChild(closer);

  // Simple square black border, bold, no bg color
  Object.assign(node.style, {
    border: "2px solid #000",
    borderRadius: "0px",
    fontWeight: "bold",
    color: "#000",
    background: "none",
    padding: "2px 8px",
    margin: "0 4px",
    display: "inline-block",
    cursor: "default",
    userSelect: "none",
    boxSizing: "border-box",
  });

  // Remove all hover/active effects by not adding any, and by keeping CSS minimal
  return node;
}

