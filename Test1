const Embed = Quill.import("blots/embed");

class VariableBlot extends Embed {
  // This method is called when a new blot is created
  static create(value) {
    // Create the base DOM node
    const node = super.create();
    // Use the value (e.g., "{{FIRM_NAME}}") as the text
    node.innerText = value;
    // Important: Make it non-editable
    node.setAttribute("contenteditable", "false");
    // Apply your custom styles
    Object.assign(node.style, {
      backgroundColor: "#0c476e",
      color: "white",
      padding: "5px 8px",
      borderRadius: "3px",
      fontWeight: "bold", // This is now safe inside a blot
      margin: "0 2px",
      cursor: "default",
      userSelect: "none",
    });
    return node;
  }

  // This is used to get the value back from the blot
  static value(domNode) {
    return domNode.innerText;
  }
}

// Register the blot with a unique name and the tag to use
VariableBlot.blotName = "variable";
VariableBlot.tagName = "span"; // Use a <span> tag for rendering

// Quill formatting
