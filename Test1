const handleDrop = (e) => {
  e.preventDefault();
  if (!isEditing) return;

  const editor = bodyEditorRef.current?.getEditor();
  if (!editor) return;

  const text = e.dataTransfer.getData("text");
  const range = editor.getSelection(true);

  if (range) {
    // 1. Create the HTML for the tag
    const tagHtml = `
      <span style="background-color: #0c476e; color: white; padding: 3px 6px; border-radius: 3px; font-weight: bold; margin: 2px;" contenteditable="false">
        ${text}
      </span>
    `;

    // 2. Insert the HTML into the editor
    editor.clipboard.dangerouslyPasteHTML(range.index, tagHtml, 'user');

    // 3. Add a space after the tag for better typing experience
    editor.insertText(range.index + 1, ' ', 'user');
    editor.setSelection(range.index + 2, 0, 'user');
  }
};
