                    {dynamicSteps.map((step, index) => {
                      const isFullyDone =
                        viewingBatchState === "POSTED" ||
                        viewingBatchState === "SCHEDULED" ||
                        viewingBatchState === "APPROVED" ||
                        viewingBatchState === "C" ||
                        viewingBatchState === "S";
                      const activeStepIndex = isFullyDone
                        ? dynamicSteps.length
                        : viewingBatchOrder - 1;
                      const isCompleted = index < activeStepIndex;
                      const isCurrent = index === activeStepIndex;

                      const escalationHours =
                        viewingBatch?.escalationTime || 24;
                      const hoursPending = viewingBatch
                        ? Math.abs(
                          new Date() - new Date(viewingBatch.requestDate)
                        ) / 36e5
                        : 0;
                      const isEscalated =
                        viewingBatchState !== "REJECTED" &&
                        activeStepIndex < dynamicSteps.length &&
                        hoursPending > escalationHours;

                      let statusFlag = "PENDING";
                      if (isCompleted) statusFlag = "COMPLETED";
                      if (isCurrent && viewingBatchState === "REJECTED")
                        statusFlag = "REJECTED";
                      else if (isCurrent && isEscalated)
                        statusFlag = "ESCALATED";
                      else if (isCurrent) statusFlag = "ACTIVE";

                      // Grab the matching history item to identify who performed this step
                      const historyItem = workflowHistory[index];
                      const executorStr = historyItem ? `${historyItem.ACTION_USER_NAME} (${historyItem.LAST_ACTION_BY})` : null;



                      return (
                        <Step key={step.state} completed={isCompleted} active={isCurrent} sx={jaStyles.miniStep(viewingBatchState === "REJECTED", index, activeStepIndex)}>

