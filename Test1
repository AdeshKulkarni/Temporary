const handleDownloadZip = async () => {
  try {
    const selectedData = selectedRows.map((id) => rows.find((row) => row.id === id));
    const user = JSON.parse(localStorage.getItem("user"));

    // Fix: Send full user object (not just financial year)
    const payload = {
      user, // full user object
      data: { firms: selectedData }, // as per backend expectation
    };

    const jsonFormData = JSON.stringify(payload);
    const encryptedData = await encrypt(iv, salt, jsonFormData);
    const requestData = {
      iv: ivBase64,
      salt: saltBase64,
      data: encryptedData,
    };

    // Debug logs
    console.log("Payload sent to backend:", requestData);

    const response = await axios.post(
      "Server/IAMServices/downloadZip",
      requestData,
      {
        headers: {
          Authorization: `Bearer ${localStorage.getItem("token")}`,
        },
      }
    );

    console.log("Backend response:", response.data);

    if (response.data?.statusCode === 200 && response.data.result) {
      downloadFile(response.data.result, "zip", "Selected_Letters");
    } else {
      console.error("Download failed", response.data);
    }
  } catch (error) {
    console.error("Zip download error", error);
  }
};