package com.tcs.fincore.MOCService.Repository;

import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.Repository;

// This is an interface, not a class, used to get sequence values
public interface BatchSeqRepository extends Repository<Object, Long> {
    
    @Query(value = "select BATCH_SEQ.nextval from dual", nativeQuery = true)
    Long getNextValue();
}
