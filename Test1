import React, { useState, useMemo } from "react";
import {
  Button,
  Box,
  Paper,
  Typography,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Checkbox,
  Divider,
} from "@mui/material";
import { DataGrid, GridToolbar } from "@mui/x-data-grid";
import PreviewIcon from "@mui/icons-material/Preview";
import { Container } from "@mui/system";

const WorkFlow = () => {
  const [selectedRows, setSelectedRows] = useState([]);
  const [previewData, setPreviewData] = useState(null);
  const [displayList, setDisplayList] = useState(false);

  // Generate mock data for the specified columns
  const rows = useMemo(() => {
    const firmNames = [
      "Alpha Enterprises",
      "Beta Solutions",
      "Gamma Industries",
      "Delta Technologies",
      "Omega Services",
      "Sigma Innovations",
    ];

    const cities = [
      "Mumbai",
      "Delhi",
      "Bangalore",
      "Chennai",
      "Kolkata",
      "Hyderabad",
    ];
    const states = [
      "Maharashtra",
      "Karnataka",
      "Tamil Nadu",
      "West Bengal",
      "Telangana",
      "Gujarat",
    ];
    const districts = [
      "Mumbai City",
      "Bangalore Urban",
      "Chennai District",
      "Kolkata District",
      "Hyderabad District",
    ];
    const designations = [
      "Owner",
      "Manager",
      "Director",
      "Proprietor",
      "Partner",
    ];
    const establishmentTypes = [
      "Proprietorship",
      "Partnership",
      "LLP",
      "Private Limited",
      "Public Limited",
    ];

    const count = 5 + Math.floor(Math.random() * 5); // 5-10 entries
    return Array.from({ length: count }, (_, index) => {
      const firmName = firmNames[Math.floor(Math.random() * firmNames.length)];
      const poc = [
        "Raj Sharma",
        "Priya Patel",
        "Vikram Singh",
        "Ananya Gupta",
        "Arjun Kumar",
      ][Math.floor(Math.random() * 5)];
      const city = cities[Math.floor(Math.random() * cities.length)];
      const state = states[Math.floor(Math.random() * states.length)];

      return {
        id: index + 1,
        serial: index + 1,
        ucn: `UCN${Math.floor(1000000000 + Math.random() * 9000000000)}`,
        firmRegNo: `FRN${Math.floor(100000 + Math.random() * 900000)}`,
        firmName,
        panNo: `ABCDE${Math.floor(1000 + Math.random() * 9000)}F`,
        gstinNo: `${state.substring(0, 2)}${Math.floor(
          1000000000 + Math.random() * 9000000000
        )}Z`,
        address: `${Math.floor(100) + index} ${firmName.split(" ")[0]} Street`,
        city,
        stateName: state,
        districtName: districts[Math.floor(Math.random() * districts.length)],
        mobileNo: `9${Math.floor(100000000 + Math.random() * 900000000)}`,
        pointOfContact: poc,
        pocDesignation:
          designations[Math.floor(Math.random() * designations.length)],
        pocEmail: `${poc.split(" ")[0].toLowerCase()}@${firmName
          .split(" ")[0]
          .toLowerCase()}.com`,
        establishmentType:
          establishmentTypes[
            Math.floor(Math.random() * establishmentTypes.length)
          ],
      };
    });
  }, []);

  const columns = [
    {
      field: "selected",
      headerName: "Select",
      width: 80,
      renderHeader: () => (
        <Checkbox
          checked={selectedRows.length === rows.length}
          indeterminate={
            selectedRows.length > 0 && selectedRows.length < rows.length
          }
          onChange={handleSelectAll}
        />
      ),
      renderCell: (params) => (
        <Checkbox
          checked={selectedRows.includes(params.row.id)}
          onChange={() => handleSelectRow(params.row.id)}
        />
      ),
    },
    { field: "serial", headerName: "Sr. No", width: 80 },
    { field: "ucn", headerName: "UCN", width: 180 },
    { field: "firmRegNo", headerName: "Firm Reg No.", width: 150 },
    { field: "firmName", headerName: "Firm Name", width: 200 },
    { field: "panNo", headerName: "PAN NO.", width: 140 },
    { field: "gstinNo", headerName: "GSTIN NO.", width: 180 },
    { field: "address", headerName: "Address", width: 200 },
    { field: "city", headerName: "City", width: 120 },
    { field: "stateName", headerName: "State", width: 150 },
    { field: "districtName", headerName: "District", width: 150 },
    { field: "mobileNo", headerName: "Mobile No.", width: 150 },
    { field: "pointOfContact", headerName: "Point of Contact", width: 180 },
    { field: "pocDesignation", headerName: "POC Designation", width: 180 },
    { field: "pocEmail", headerName: "POC Email", width: 200 },
    {
      field: "establishmentType",
      headerName: "Establishment Type",
      width: 180,
    },
    {
      field: "actions",
      headerName: "Actions",
      width: 270,
      sortable: false,
      filterable: false,
      renderCell: (params) => (
        <div>
          <Button
            variant="outlined"
            color="primary"
            size="small"
            startIcon={<PreviewIcon />}
            onClick={() => handleRowPreview(params.row)}
            sx={{
              mr: 1,
              textTransform: "none",
              "&:hover": {
                backgroundColor: "primary.light",
              },
            }}
          >
            Preview
          </Button>
          <Button
            variant="contained"
            color="success"
            size="small"
            onClick={() => console.log("Approve", params.row)}
            sx={{
              mr: 1,
              textTransform: "none",
              "&:hover": {
                backgroundColor: "success.dark",
              },
            }}
          >
            Approve
          </Button>
           <Button
            variant="contained"
            color="error"
            size="small"
            onClick={() => console.log("Approve", params.row)}
            sx={{
              textTransform: "none",
              "&:hover": {
                backgroundColor: "error.dark",
              },
            }}
          >
            Reject
          </Button>
        </div>
      ),
    },
  ];

  const handleSelectRow = (id) => {
    setSelectedRows((prev) =>
      prev.includes(id) ? prev.filter((rowId) => rowId !== id) : [...prev, id]
    );
  };

  const handleSelectAll = () => {
    if (selectedRows.length === rows.length) {
      setSelectedRows([]);
    } else {
      setSelectedRows(rows.map((row) => row.id));
    }
  };

  const handleRowPreview = (rowData) => {
    setPreviewData(rowData);
  };

  const handleClosePreview = () => {
    setPreviewData(null);
  };

  return (

    <Box sx={{ p: 3, overflow: "hidden" }}>
       <Typography variant="h6" gutterBottom sx={{ mb: 2 }}>
          Empanelment Authorisation
        </Typography>
        <Divider />
        <Container sx={{mt:2,textAlign:"center"}}>
          <span>Select Financial Year  </span>
          <select>
            <option value="2025">24-25</option>
            <option value="2025">23-24</option>
            <option value="2025">22-23</option>
          </select>
          <br/>
          <Button sx={{m:5}} variant="contained" size="large"    onClick={() => setDisplayList(true)}>List 1</Button>
          <Button variant="contained" size="large"    onClick={() => setDisplayList(false)}> List 2 </Button>
        </Container>
        {displayList &&
      <Paper elevation={3} sx={{ mt: 2 , p: 3, borderRadius: 2 }}>
        <Box sx={{ height: 500, width: "100%", overflow: "auto" }}>
          <DataGrid
            rows={rows}
            columns={columns}
            getRowId={(row) => row.id}
            disableColumnMenu
            hideFooterSelectedRowCount
            components={{
              Toolbar: GridToolbar,
            }}
            componentsProps={{
              toolbar: {
                showQuickFilter: true,
                quickFilterProps: { debounceMs: 500 },
              },
            }}
            sx={{
              "& .MuiDataGrid-cell": {
                fontSize: "0.75rem",
                
              },
              "& .MuiDataGrid-columnHeader": {
                fontSize: "0.9rem",
                fontWeight: 'bold'
              },
            }}
          />
        </Box>
      </Paper>
      }

      {/* Preview Dialog */}
      <Dialog
        open={!!previewData}
        onClose={handleClosePreview}
        maxWidth="md"
        fullWidth
      >
        <DialogTitle>Firm Details Preview</DialogTitle>

        <DialogContent dividers>
          {previewData && (
            <Box
              sx={{
                p: 2,
                display: "grid",
                gridTemplateColumns: "1fr 1fr",
                gap: 2,
              }}
            >
              {Object.entries(previewData).map(([key, value]) => {
                if (key === "id" || key === "selected" || key === "actions")
                  return null;
                return (
                  <div key={key} style={{ minHeight: 24 }}>
                    <Typography variant="subtitle1">
                      <strong>
                        {key
                          .replace(/([A-Z])/g, " $1")
                          .replace(/^./, (s) => s.toUpperCase())}
                        :
                      </strong>
                    </Typography>
                    <Typography variant="body1">{value}</Typography>
                  </div>
                );
              })}
            </Box>
          )}
        </DialogContent>

        <DialogActions>
          <Button
            onClick={handleClosePreview}
            color="primary"
            variant="contained"
          >
            Close
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
};

export default WorkFlow;

