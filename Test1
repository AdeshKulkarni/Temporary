import React, { useState, useMemo, useCallback, useEffect } from "react";
import {
  Box,
  Button,
  Snackbar,
  Alert,
  Typography,
  Stack,
  Divider,
  Paper,
  DialogContent,
  Dialog,
  CircularProgress,
} from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import apiCaller from "../apiCaller";
import { Close, Done, DoNotDisturb } from "@mui/icons-material";
import { useNavigate } from "react-router-dom";

export default function AssignRequests() {
  const user = useMemo(() => JSON.parse(localStorage.getItem("user")), []);
  const [rows, setRows] = useState([]);
  const [selectionModel, setSelectionModel] = useState([]);
  const [snackbar, setSnackbar] = useState({
    open: false,
    message: "",
    severity: "success",
  });
  const [displayText, setDisplayText] = useState("Loading ...");
  const [loadOpen, setLoadOpen] = useState(false);

  const navigate = useNavigate();

  const handleCloseSnackbar = () => {
    setSnackbar({ ...snackbar, open: false });
  };

  const columns = [
    {
      field: "SNO",
      headerName: "S.No",
      flex: 0.5,
      align: "center",
      headerAlign: "center",
    },
    {
      field: "FRN_NO",
      headerName: "FRN",
      flex: 2,
      align: "center",
      headerAlign: "center",
    },
    {
      field: "ACCOUNT_NUMBER",
      headerName: "Account Number",
      flex: 2,
      align: "center",
      headerAlign: "center",
    },
    { field: "ACCOUNT_NAME", headerName: "Account Name", flex: 3 },
    {
      field: "NAME",
      headerName: "Assignment Type",
      flex: 1.5,
      align: "center",
      headerAlign: "center",
    },
    {
      field: "REQUESTED_BY",
      headerName: "Requested by",
      flex: 1.5,
      align: "center",
      headerAlign: "center",
    },
    {
      field: "REQUESTED_TIME",
      headerName: "Requested at",
      flex: 2,
      align: "center",
      headerAlign: "center",
    },
  ];

  const apiCall = useCallback(
    async (endPoint, payload = {}, apiCaller, errorMessage) => {
      try {
        const { data, error } = await apiCaller("POST", endPoint, payload);
        if (error || !data) {
          console.error(errorMessage, error.data?.message);
          setSnackbar({
            open: true,
            message: error.data?.message,
            severity: "error",
          });
          return;
        }
        return data;
      } catch (err) {
        console.error(errorMessage, err);
        return null;
      }
    },
    []
  );

  const getSelectedRequests = useCallback(
    (selectionModel) => {
      return rows.filter((row) => selectionModel.includes(row.index));
    },
    [rows]
  );

  const fetchData = useCallback(() => {
    const fetchData = async () => {
      const payload = {};
      const data = await apiCall(
        "/Server/assignAudit/getPendingRequests",
        payload,
        apiCaller,
        "Failed to load the data!"
      );
      if (data?.result?.requests) {
        setRows(
          data.result.requests.map((row, index) => ({
            ...row,
            index: index,
          })) || []
        );
        setDisplayText("No pending requests.");
        return;
      }
      setRows([]);
    };
    fetchData();
  }, []);

  const handleAction = useCallback(
    async (selectionModel, type) => {
      const requests = getSelectedRequests(selectionModel);
      const payload = { requests: requests, type: type };
      let message =
        type === "2" ? "Accept" : type === "3" ? "Reject" : "Cancel";
      const data = await apiCall(
        "/Server/assignAudit/actionOnRequests",
        payload,
        apiCaller,
        "Failed to " + message + "!"
      );
      if (data?.result?.status === "true") {
        setSelectionModel([]);
        setSnackbar({
          open: true,
          message:
            `Request${selectionModel.length !== 1 ? "s " : ""}` +
            message +
            "ed.",
          severity: type === "2" ? "success" : "warning",
        });
        await fetchData();
        setLoadOpen(false);
        return;
      }
      setSnackbar({
        open: true,
        message: "Failed to " + message + "! Kindly try again after some time.",
        severity: "error",
      });
      setLoadOpen(false);
    },
    [selectionModel]
  );

  useEffect(() => {
    if (
      (user.user_role !== "1" && user.user_role !== "9") ||
      user.module !== "IAM"
    ) {
      navigate("/");
    }
    fetchData();
  }, []);

  return (
    <Box>
      <Box sx={{ mb: 2 }}>
        <Typography variant="h5" gutterBottom>
          Audit Requests
        </Typography>
        <Divider />
      </Box>

      {user.user_role === "9" ? (
        <Stack direction="row" spacing={2} sx={{ mb: 2 }}>
          <>
            <Button
              startIcon={<Done />}
              variant="contained"
              color="success"
              onClick={() => {
                setLoadOpen(true);
                handleAction(selectionModel, "2");
              }}
              disabled={selectionModel.length === 0}
            >
              Approve Selected
            </Button>
            <Button
              startIcon={<DoNotDisturb />}
              variant="contained"
              color="error"
              onClick={() => {
                setLoadOpen(true);
                handleAction(selectionModel, "3");
              }}
              disabled={selectionModel.length === 0}
            >
              Reject Selected
            </Button>
          </>
        </Stack>
      ) : user.user_role === "1" ? (
        <Stack direction="row" spacing={2} sx={{ mb: 2 }}>
          <>
            <Button
              startIcon={<Close />}
              variant="contained"
              color="warning"
              onClick={() => {
                setLoadOpen(true);
                handleAction(selectionModel, "4");
              }}
              disabled={selectionModel.length === 0}
            >
              Cancel Selected
            </Button>
          </>
        </Stack>
      ) : (
        <></>
      )}

      <Paper>
        <DataGrid
          rows={rows}
          columns={columns}
          getRowId={(row) => rows.indexOf(row)}
          checkboxSelection
          disableRowSelectionOnClick
          onRowSelectionModelChange={(newSelection) => {
            setSelectionModel(newSelection);
          }}
          localeText={{
            noRowsLabel: displayText,
          }}
          rowSelectionModel={selectionModel}
          pageSize={10}
          sx={{
            "& .MuiDataGrid-row.Mui-selected": {
              backgroundColor: "#E6E6FA", // Custom background for selected row
              color: "#4a4a4a", // Custom text color
              fontWeight: "Bold", // Make text bold
              border: "none", // Remove borders
            },
            "& .MuiDataGrid-cell:focus": {
              outline: "none", // Remove focus outline for cells
            },
            "& .MuiDataGrid-row:hover": {
              backgroundColor: "#E6E6FA", // Hover color
            },
            "& .MuiDataGrid-columnHeader": {
              backgroundColor: "#826dfc",
              color: "#FFFFFF",
            },
            height: 620,
          }}
        />
      </Paper>

      <Snackbar
        open={snackbar.open}
        autoHideDuration={3000}
        onClose={handleCloseSnackbar}
        anchorOrigin={{
          vertical: "bottom",
          horizontal: "right",
        }}
      >
        <Alert
          variant="filled"
          onClose={handleCloseSnackbar}
          severity={snackbar.severity}
        >
          {snackbar.message}
        </Alert>
      </Snackbar>

      <Dialog
        PaperProps={{
          style: {
            backgroundColor: "transparent",
            boxShadow: "none",
          },
        }}
        open={loadOpen}
      >
        <Box>
          <DialogContent sx={{ display: "Grid" }}>
            <CircularProgress />
          </DialogContent>
        </Box>
      </Dialog>
    </Box>
  );
}


