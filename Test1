import { useState, useEffect, useRef } from "react"; import { Snackbar, IconButton, Divider, Dialog, DialogTitle, DialogContent, DialogActions, Button, Typography, Paper, Grid, Box, Container, } from "@mui/material"; import CloseIcon from "@mui/icons-material/Close"; import ReactQuill from "react-quill"; import Quill from "quill"; import "react-quill/dist/quill.snow.css"; import axios from "axios"; import { encrypt } from "../../Security/AES-GCM256"; import PdfViewer from "../../PdfViewer/pdfViewer"; import { styled } from "@mui/system";

const Size = Quill.import("formats/size"); Size.whitelist = ["small", "large", "huge"]; Quill.register(Size, true);

const iv = crypto.getRandomValues(new Uint8Array(12)); const ivBase64 = btoa(String.fromCharCode.apply(null, iv)); const salt = crypto.getRandomValues(new Uint8Array(16)); const saltBase64 = btoa(String.fromCharCode.apply(null, salt));

const EmailTemplate = () => { const [value, setValue] = useState("<p>Hey there!</p>"); const [sbar, setSbar] = useState({ isOpen: false, Msg: "" }); const [wordCount, setWordCount] = useState(0); const editorRef = useRef(); const [isEditing, setIsEditing] = useState(false); const [isPreviewing, setIsPreviewing] = useState(false); const [isPreviewingFe, setFe] = useState(false); const [templateContent, settemplateContent] = useState(""); const [base64, setBase64] = useState(null);

const draftVar = [ "{{DATE}}", "{{REF_NO}}", "{{FIRM_NAME}}", "{{FRN_NO}}", "{{FIRM_ADDR}}", "{{ASSIGNMENT_TYPE}}", "{{GSTN}}", ];

const modules = { toolbar: [ [{ font: ["", "serif", "monospace", "arial"] }], [{ size: Size.whitelist }], [ { color: ["red", "green", "blue", "black", "orange"] }, { background: ["red", "green", "blue", "yellow", "gray"] }, ], [{ align: "justify" }, { align: "center" }, { align: "right" }], [{ script: "sub" }, { script: "super" }], [{ header: [1, 2, 3, false] }], [{ list: "ordered" }, { list: "bullet" }], ["bold", "italic", "underline", "strike"], ["link", "image", "clean"], [{ indent: "-1" }, { indent: "+1" }], ], clipboard: { matchVisual: false, }, };

useEffect(() => { fetchData(); }, []);

useEffect(() => { const quill = editorRef.current?.getEditor(); if (!quill) return;

const handleTextChange = () => {
  const text = quill.getText().trim();
  const words = text.split(/\s+/).filter(Boolean);

  if (words.length > 2000) {
    quill.history.undo();
    setSbar({ isOpen: true, Msg: "Word limit of 2000 reached!" });
  } else {
    setWordCount(words.length);
  }
};

quill.on("text-change", handleTextChange);
return () => {
  quill.off("text-change", handleTextChange);
};

}, []);

const fetchData = async () => { try { const response = await axios.post( "Server/IAMServices/EmailTemplate", {}, { headers: { Authorization: Bearer ${localStorage.getItem("token")}, }, } ); let res = response.data.result; setValue(res); setWordCount(countWord(res)); } catch (e) { console.log(e); } };

const countWord = (str) => { const text = str.replace(/<[^>]*>/g, " "); const words = text.trim().split(/\s+/).filter(Boolean); return words.length; };

const handleDrop = (e) => { e.preventDefault(); const range = editorRef.current.editor?.getSelection(true); editorRef.current.editor?.insertText( range ? range.index : 0, e.dataTransfer.getData("text") ); };

const handleSave = async () => { setIsEditing(false); let dataToSend = { MASTER_TEMPLATE: <html>${value}</html> }; try { let jsonFormData = JSON.stringify(dataToSend); await encrypt(iv, salt, jsonFormData).then((result) => { jsonFormData = result; }); let payload = { iv: ivBase64, salt: saltBase64, data: jsonFormData, }; const response = await axios.post( "Server/IAMServices/saveMasterTemplate", payload, { headers: { Authorization: Bearer ${localStorage.getItem("token")}, }, } ); if (response.data.statusCode === 200 && response.data.result !== "") { setSbar({ isOpen: true, Msg: "Saved Successfully!" }); } } catch (error) { console.error("Error saving template:", error); } setIsPreviewing(false); };

const handlePreview = async () => { setIsEditing(false); let StrToSend = value.replace(/<br\s*/?>/gi, "<br></br>"); settemplateContent(StrToSend); let dataToSend = { user: { template: <html><head>${StrToSend}</head></html> }, data: { DATE: "31/03/2025", REF_NO: "1001", FIRM_NAME: "TRINITY ENT", FRN_NO: "45687", GSTN: "27AAHCK850D1ZK", FIRM_ADDR: "NAVI MUMBAI, BELPAUR", ASSIGNMENT_TYPE: "INTERNAL", }, }; try { let jsonFormData = JSON.stringify(dataToSend); await encrypt(iv, salt, jsonFormData).then((result) => { jsonFormData = result; }); let payload = { iv: ivBase64, salt: saltBase64, data: jsonFormData, }; const response = await axios.post( "Server/IAMServices/generateTemplate", payload, { headers: { Authorization: Bearer ${localStorage.getItem("token")}, }, } ); if (response.data.statusCode === 200 && response.data.result !== "") { setIsPreviewing(true); setBase64(response.data.result); } } catch (error) { console.error("Error saving template:", error); } };

const handleReset = async () => { try { const response = await axios.post( "Server/IAMServices/resetTemplate", {}, { headers: { Authorization: Bearer ${localStorage.getItem("token")}, }, } ); let res = response.data.result; setValue(res); setWordCount(countWord(res)); } catch (e) { console.error("Error resetting template:", e); } };

return ( <> <Typography gutterBottom variant="h5"> Empanelment Intimation Letter Template </Typography> <Divider /> <Grid container spacing={2} sx={{ p: 2 }}> <Grid item xs={12} md={4}> <Paper sx={{ p: 2 }}> <Typography variant="h6">Drag Required Variables</Typography> <Divider sx={{ mb: 1 }} /> {draftVar.map((label) => ( <span key={label} draggable={isEditing} onDragStart={(e) => e.dataTransfer.setData("text", label)} style={{ margin: 10, backgroundColor: "#0c476e", padding: "10px 15px", cursor: "move", borderRadius: "5px", color: "white", fontWeight: "bold", display: "inline-block", }} > {label} </span> ))} </Paper> </Grid>

<Grid item xs={12} md={8}>
      <Paper sx={{ p: 2 }}>
        <Typography variant="h6">Template Draft</Typography>
        <ReactQuill
          style={{ height: "300px" }}
          theme="snow"
          modules={modules}
          value={value}
          ref={editorRef}
          onChange={setValue}
          onDragOver={(e) => e.preventDefault()}
          onDrop={handleDrop}
          readOnly={!isEditing}
        />
        <Box mt={2}>
          <Typography variant="body2">
            Word Count: {wordCount} / 2000
          </Typography>
        </Box>
        <Box mt={2} textAlign="right">
          {!isEditing ? (
            <Button variant="contained" onClick={() => setIsEditing(true)}>
              Edit
            </Button>
          ) : (
            <Button
              variant="contained"
              color="error"
              onClick={() => setIsEditing(false)}
            >
              Cancel
            </Button>
          )}
          <Button variant="contained" sx={{ ml: 1 }} onClick={handlePreview}>
            Preview
          </Button>
          <Button variant="contained" sx={{ ml: 1 }} onClick={handleSave}>
            Save
          </Button>
          <Button variant="contained" sx={{ ml: 1 }} onClick={handleReset}>
            Reset
          </Button>
        </Box>
      </Paper>
    </Grid>
  </Grid>

  <Dialog open={isPreviewing} onClose={() => setIsPreviewing(false)} maxWidth="xl">
    <DialogTitle>Preview</DialogTitle>
    <DialogContent dividers>
      {isPreviewingFe ? (
        <div
          className="ql-editor"
          dangerouslySetInnerHTML={{ __html: templateContent }}
          style={{ height: "80vh", overflowY: "auto" }}
        />
      ) : (
        <PdfViewer pdfData={base64} />
      )}
    </DialogContent>
    <DialogActions>
      <Button onClick={() => setIsPreviewing(false)}>Close</Button>
    </DialogActions>
  </Dialog>

  <Snackbar
    open={sbar.isOpen}
    autoHideDuration={5000}
    onClose={() => setSbar({ isOpen: false, Msg: "" })}
    message={sbar.Msg}
  />
</>

); };

export default EmailTemplate;

