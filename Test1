package com.tcs.fincore.MocRequestService.repository;

import com.tcs.fincore.CommonRequestService.model.enums.RequestStatus;
import com.tcs.fincore.MocRequestService.model.MocRequest;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.stereotype.Repository;
import java.util.List;

@Repository
public interface MocRequestRepository extends JpaRepository<MocRequest, Long> {
    List<MocRequest> findByTargetIdAndRequestStatus(String targetId, RequestStatus status);
    List<MocRequest> findByCreatorId(String creatorId);
    List<MocRequest> findByRequestStatus(RequestStatus status);
}
