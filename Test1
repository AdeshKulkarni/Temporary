### 2. Update the CGL Autocomplete
Replace your entire Grid item for **CGL** (around line 718) with this:
```javascript
                        {/* CGL */}
                        <Grid item size={{ xl: 2.3, lg: 3.1 }} >
                          <Autocomplete
                            autoHighlight
                            popupIcon={null}
                            options={
                              (cglInputValues[row.id] || "").length < 3
                                ? []
                                : (row.cgl && !cglSearch.options.some((o) => o.cglNumber === row.cgl.cglNumber)
                                  ? [row.cgl, ...cglSearch.options]
                                  : cglSearch.options)
                            }
                            slotProps={{
                              popper: {
                                placement: 'bottom-start',
                                modifiers: [
                                  { name: 'flip', enabled: false },
                                  { name: 'preventOverflow', enabled: false }
                                ],
                              },
                            }}
                            // SHOW CODE AND DESCRIPTION INSIDE THE TEXTBOX
                            getOptionLabel={(option) => option && option.cglNumber ? `${option.cglNumber} - ${option.description}` : ""}
                            renderOption={(props, option) => (
                              <li {...props} key={option.cglNumber}>
                                <Typography noWrap sx={{ textOverflow: 'ellipsis', overflow: 'hidden', whiteSpace: 'nowrap' }}>
                                  {option.cglNumber} - {option.description}
                                </Typography>
                              </li>
                            )}
                            value={row.cgl || null}
                            onChange={(event, newValue) => handleRowChange(row.id, "cgl", newValue)}
                            inputValue={cglInputValues[row.id] || ""}
                            onInputChange={(event, newInputValue, reason) => {
                              if (reason === 'input') {
                                const cleanInput = newInputValue.replace(CGL_REPLACE_REGEX, "").substring(0, 10);
                                setCglInputValues(prev => ({ ...prev, [row.id]: cleanInput }));
                                searchCgls(cleanInput, row.id);
                              } else {
                                setCglInputValues(prev => ({ ...prev, [row.id]: newInputValue }));
                              }
                            }}
                            onKeyDown={(e) => {
                              if ((e.key === 'Tab' || e.key === 'Enter') && !row.cgl && cglSearch.options?.length > 0) {
                                handleRowChange(row.id, "cgl", cglSearch.options[0]);
                              }
                            }}
                            onBlur={() => {
                              const typedValue = cglInputValues[row.id];
                              if (!row.cgl && typedValue && typedValue.length === 10) {
                                const match = cglSearch.options.find(opt => String(opt.cglNumber) === typedValue) ||
                                  (cglSearch.options.length > 0 ? cglSearch.options[0] : null);
                                if (match) {
                                  handleRowChange(row.id, "cgl", match);
                                }
                              }
                            }}
                            loading={cglSearch.loadingId === row.id}
                            filterOptions={(x) => x}
                            isOptionEqualToValue={(option, value) => String(option?.cglNumber) === String(value?.cglNumber)}
                            noOptionsText={
                              (cglInputValues[row.id] || "").length < 3
                                ? "Enter 3 Digits to Search"
                                : "CGL not found"
                            }
                            renderInput={(params) => (
                              <Tooltip title={row.cgl ? `${row.cgl.cglNumber} - ${row.cgl.description}` : "Search by CGL Number"} placement="top-start">
                                <TextField
                                  {...params}
                                  label="CGL *"
                                  placeholder="CGL"
                                  InputLabelProps={{ shrink: true }}
                                  // Prevents text from breaking out of the box
                                  inputProps={{ ...params.inputProps, style: { textOverflow: 'ellipsis', whiteSpace: 'nowrap', overflow: 'hidden' } }}
                                  InputProps={{
                                    ...params.InputProps,
                                    endAdornment: (
                                      <Box sx={{ display: 'flex', alignItems: 'center', gap: 0.5 }}>
                                        {/* SMALL MEMO CHIP INSIDE THE TEXTBOX */}
                                        {row.cgl && String(row.cgl.cglNumber).startsWith("5") && (
                                          <Chip label="MEMO" size="small" color="warning" sx={{ height: 18, fontSize: '0.65rem', fontWeight: 'bold' }} />
                                        )}
                                        {cglSearch.loadingId === row.id ? <CircularProgress color="inherit" size={20} /> : null}
                                        {params.InputProps.endAdornment}
                                      </Box>
                                    )
                                  }}
                                  onPaste={(e) => { e.preventDefault(); showSnackBar("Pasting is not allowed here.", "warning"); }}
                                  onCopy={(e) => e.preventDefault()}
                                />
                              </Tooltip>
                            )}
                          />
                        </Grid>

