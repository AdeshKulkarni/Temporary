    private List<Map<String, Object>> mapToSummaryDto(List<Object[]> rawData, boolean isMyRequest) {
        List<Map<String, Object>> result = new ArrayList<>();
        for (Object[] row : rawData) {
            Map<String, Object> map = new HashMap<>();
            map.put("batchId", row[0]);
            
            if (isMyRequest) {
                // Convert DB Code ("A", "P", "R") to Full Word for Frontend
                String rawStatus = (String) row[1];
                String fullStatus = "PENDING";
                if ("A".equalsIgnoreCase(rawStatus)) fullStatus = "ACCEPTED";
                else if ("R".equalsIgnoreCase(rawStatus)) fullStatus = "REJECTED";
                else if ("P".equalsIgnoreCase(rawStatus) || "PENDING".equalsIgnoreCase(rawStatus)) fullStatus = "PENDING";
                
                map.put("requestStatus", fullStatus);
                map.put("requestDate", row[2]);
                map.put("commonBatchRemarks", row[3]);
                map.put("requestCount", row[4]);
                map.put("totalDebit", row[5]);
                map.put("totalCredit", row[6]);
                map.put("creatorId", "SELF");
                map.put("executorId", row[7]);
                map.put("executorRemarks", row[8]);
            } else {
                map.put("creatorId", row[1]);
                map.put("requestDate", row[2]);
                map.put("commonBatchRemarks", row[3]);
                map.put("requestCount", row[4]);
                map.put("totalDebit", row[5]);
                map.put("totalCredit", row[6]);
                map.put("requestStatus", "PENDING");
            }
            result.add(map);
        }
