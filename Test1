import React, { useState, useEffect } from "react";
import {
  Button,
  Paper,
  IconButton,
  Typography,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Checkbox,
  Divider,
  CircularProgress,
  MenuItem,
  FormControl,
  Select,
  InputLabel,
} from "@mui/material";
import { DataGrid, GridToolbar } from "@mui/x-data-grid";
import { Close } from "@mui/icons-material";
import { Box, styled } from "@mui/system";
import PreviewIcon from "@mui/icons-material/Preview";
import { Container } from "@mui/system";
import axios from "axios";
import { encrypt } from "../Security/AES-GCM256";
import PdfViewer from "../PdfViewer/pdfViewer";

const iv = crypto.getRandomValues(new Uint8Array(12)); // for encryption
const ivBase64 = btoa(String.fromCharCode.apply(null, iv)); // for decryption
const salt = crypto.getRandomValues(new Uint8Array(16)); // for encryption
const saltBase64 = btoa(String.fromCharCode.apply(null, salt)); // for decryption

const WorkFlow = () => {
  const [selectedRows, setSelectedRows] = useState([]);
  const [previewData, setPreviewData] = useState(null);
  const [rows, setRows] = useState([]);
  const [filteredRows, setFilteredRows] = useState([]);
  const [loading, setLoading] = useState(true);
  const [templateContent, setTemplateContent] = useState("");
  const [templateLoading, setTemplateLoading] = useState(false);
  const [selectedYear, setSelectedYear] = useState("2024-2025");
  const [activeFilter, setActiveFilter] = useState("SA");

  const financialYears = [
    "2024-2025",
    "2023-2024",
    "2022-2023",
    "2021-2022",
  ];

  useEffect(() => {
    const fetchData = async () => {
      let dataToSend = { EMPANELMENT_TYPE: "SA" };
      try {
        let jsonFormData = JSON.stringify(dataToSend);
        const encryptedData = await encrypt(iv, salt, jsonFormData);
        const payload = {
          iv: ivBase64,
          salt: saltBase64,
          data: encryptedData,
        };

        const response = await axios.post(
          "Server/IAMServices/getActiveFRN",
          payload,
          {
            headers: {
              Authorization: `Bearer ${localStorage.getItem("token")}`,
            },
          }
        );

        const resData = response.data;

        if (resData.statusCode === 200) {
          const formattedData = resData.result.map((item, index) => ({
            id: index + 1,
            serial: index + 1,
            frn: item.FRN,
            firmName: item.FIRM_NAME,
            empanelmentType: item.EMPANELMENT_TYPE,
            empanelmentSubType: item.EMPANELMENT_SUB_TYPE,
            empaneledStatus: item.EMPANELED_STATUS,
            empaneledBy: item.EMPANELED_BY,
          }));
          setRows(formattedData);
          filterData(formattedData, "SA");
        } else {
          console.error("API Error:", resData.message);
        }
      } catch (e) {
        console.error("Fetch Error:", e);
      } finally {
        setLoading(false);
      }
    };

    fetchData();
  }, []);

  const filterData = (data, filterType) => {
    const filtered = data.filter((row) => 
      row.empanelmentType === filterType
    );
    setFilteredRows(filtered);
    setActiveFilter(filterType);
  };

  const handleRowPreview = async (rowData) => {
    setPreviewData(rowData);
    setTemplateLoading(true);
    setTemplateContent("");

    try {
      const templateData = {
        user: { template: "Hi " },
        data: {
          DATE: new Date().toLocaleDateString(),
          REF_NO: "1001",
          FIRM_NAME: rowData.firmName,
          FRN_NO: rowData.frn,
          GSTN: "27AAHCK850D1ZK",
          FIRM_ADDR: "NAVI MUMBAI, BELPAUR",
          ASSIGNMENT_TYPE: `${rowData.empanelmentType}, ${rowData.empanelmentSubType}`,
        },
      };
      console.log("emplateDATA", templateData);

      let jsonFormData = JSON.stringify(templateData);
      const encryptedData = await encrypt(iv, salt, jsonFormData);
      const payload = {
        iv: ivBase64,
        salt: saltBase64,
        data: encryptedData,
      };

      const response = await axios.post(
        "Server/IAMServices/generateTemplate",
        payload,
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );

      if (response.data.statusCode === 200) {
        setTemplateContent(response.data.result);
      } else {
        console.error("Template API Error:", response.data.message);
        setTemplateContent("Error generating template");
      }
    } catch (e) {
      console.error("Template Fetch Error:", e);
      setTemplateContent("Error generating template");
    } finally {
      setTemplateLoading(false);
    }
  };

  const handleClosePreview = () => {
    setPreviewData(null);
    setTemplateContent("");
  };

  const handleSelectRow = (id) => {
    setSelectedRows((prev) =>
      prev.includes(id) ? prev.filter((rowId) => rowId !== id) : [...prev, id]
    );
  };

  const handleSelectAll = () => {
    if (selectedRows.length === filteredRows.length) {
      setSelectedRows([]);
    } else {
      setSelectedRows(filteredRows.map((row) => row.id));
    }
  };

  const columns = [
    {
      field: "selected",
      headerName: "Select",
      width: 80,
      renderHeader: () => (
        <Checkbox
          checked={selectedRows.length === filteredRows.length && filteredRows.length > 0}
          indeterminate={
            selectedRows.length > 0 && selectedRows.length < filteredRows.length
          }
          onChange={handleSelectAll}
        />
      ),
      renderCell: (params) => (
        <Checkbox
          checked={selectedRows.includes(params.row.id)}
          onChange={() => handleSelectRow(params.row.id)}
        />
      ),
    },
    { field: "serial", headerName: "Sr. No", width: 80 },
    { field: "frn", headerName: "FRN", width: 200 },
    { field: "firmName", headerName: "Firm Name", width: 250 },
    { field: "empanelmentType", headerName: "Empanelment Type", width: 180 },
    {
      field: "empanelmentSubType",
      headerName: "Empanelment Sub Type",
      width: 250,
    },
    { field: "empaneledStatus", headerName: "Status", width: 130 },
    {
      field: "actions",
      headerName: "Actions",
      width: 270,
      sortable: false,
      filterable: false,
      renderCell: (params) => (
        <div>
          <Button
            variant="outlined"
            color="primary"
            size="small"
            startIcon={<PreviewIcon />}
            onClick={() => handleRowPreview(params.row)}
            sx={{
              mr: 1,
              textTransform: "none",
              "&:hover": {
                backgroundColor: "primary.light",
              },
            }}
          >
            Preview
          </Button>
          <Button
            variant="contained"
            color="success"
            size="small"
            onClick={() => console.log("Approve", params.row)}
            sx={{
              mr: 1,
              textTransform: "none",
              "&:hover": {
                backgroundColor: "success.dark",
              },
            }}
          >
            Approve
          </Button>
          <Button
            variant="contained"
            color="error"
            size="small"
            onClick={() => console.log("Reject", params.row)}
            sx={{
              textTransform: "none",
              "&:hover": {
                backgroundColor: "error.dark",
              },
            }}
          >
            Reject
          </Button>
        </div>
      ),
    },
  ];

  const BootstrapDialog = styled(Dialog)(({ theme }) => ({
    "& .MuiDialogContent-root": {
      padding: theme.spacing(2),
    },
    "& .MuiDialogActions-root": {
      padding: theme.spacing(1),
    },
  }));

  return (
    <Box sx={{ p: 3, overflow: "hidden" }}>
      <Typography variant="h6" gutterBottom sx={{ mb: 2 }}>
        Empanelment Authorisation
      </Typography>
      <Divider />
      <Container sx={{ mt: 4, textAlign: "center" }}>
        <FormControl sx={{ minWidth: 150, mr: 3 }}>
          <InputLabel id="financial-year-label">Financial Year</InputLabel>
          <Select
            labelId="financial-year-label"
            value={selectedYear}
            onChange={(e) => setSelectedYear(e.target.value)}
            label="Financial Year"
            sx={{
              height: 40,
              "& .MuiSelect-select": {
                padding: "8px 12px",
              },
            }}
          >
            {financialYears.map((year) => (
              <MenuItem key={year} value={year}>
                {year}
              </MenuItem>
            ))}
          </Select>
        </FormControl>
        
        <Button
          variant="contained"
          size="large"
          onClick={() => filterData(rows, "SA")}
          sx={{
            m: 1,
            backgroundColor: activeFilter === "SA" ? "primary.dark" : "primary.main",
            "&:hover": {
              backgroundColor: "primary.dark",
            },
          }}
        >
          SA
        </Button>
        <Button
          variant="contained"
          size="large"
          onClick={() => filterData(rows, "SBA")}
          sx={{
            m: 1,
            backgroundColor: activeFilter === "SBA" ? "primary.dark" : "primary.main",
            "&:hover": {
              backgroundColor: "primary.dark",
            },
          }}
        >
          SBA
        </Button>
        <Button
          variant="contained"
          size="large"
          onClick={() => filterData(rows, "SCA")}
          sx={{
            m: 1,
            backgroundColor: activeFilter === "SCA" ? "primary.dark" : "primary.main",
            "&:hover": {
              backgroundColor: "primary.dark",
            },
          }}
        >
          SCA
        </Button>
      </Container>

      <Paper elevation={3} sx={{ mt: 4, p: 3, borderRadius: 2 }}>
        <Box sx={{ height: 500, width: "100%", overflow: "auto" }}>
          <DataGrid
            rows={filteredRows}
            columns={columns}
            loading={loading}
            getRowId={(row) => row.id}
            disableColumnMenu
            hideFooterSelectedRowCount
            components={{
              Toolbar: GridToolbar,
            }}
            componentsProps={{
              toolbar: {
                showQuickFilter: true,
                quickFilterProps: { debounceMs: 500 },
              },
            }}
            sx={{
              "& .MuiDataGrid-cell": {
                fontSize: "0.75rem",
              },
              "& .MuiDataGrid-columnHeader": {
                fontSize: "0.9rem",
                fontWeight: "bold",
              },
            }}
          />
        </Box>
      </Paper>

      <BootstrapDialog
        onClose={handleClosePreview}
        aria-labelledby="customized-dialog-title"
        open={!!previewData}
        fullWidth
        maxWidth="lg"
      >
        <DialogTitle sx={{ m: 0, p: 2 }} id="customized-dialog-title">
          Empanelment Letter
        </DialogTitle>
        <IconButton
          aria-label="close"
          onClick={handleClosePreview}
          sx={(theme) => ({
            position: "absolute",
            right: 8,
            top: 8,
            color: theme.palette.grey[500],
          })}
        >
          <Close />
        </IconButton>
        <DialogContent dividers>
          {templateLoading ? (
            <Box sx={{ display: "flex", justifyContent: "center", py: 4 }}>
              <CircularProgress />
              <Typography variant="body1" sx={{ ml: 2 }}>
                Generating template...
              </Typography>
            </Box>
          ) : templateContent ? (
            <PdfViewer pdfData={templateContent} sx={{ width: "100%" }} />
          ) : (
            <Typography variant="body1" sx={{ textAlign: "center", py: 4 }}>
              No template content available
            </Typography>
          )}
        </DialogContent>
      </BootstrapDialog>
    </Box>
  );
};

export default WorkFlow;
