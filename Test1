  };

  const handleResetWizard = () => {
    setSelectedVoucher(null);
    setEntryMethod("MANUAL");
    setRows([createNewRow()]);
    setCommonBatchRemarks("");
    setScheduledTime(null);
    setChecked(false);
    setSubmittedBatchId(null);
    setShowSchedulePicker(false);
    navigate("/voucher-posting-status");
  };

  const handleApplySchedule = async () => {
    if (!scheduledTime || !scheduledTime.isValid()) {
      showSnackBar("Please select a valid time.", "warning");
      return;
    }

    // Force the date to strictly be TODAY, merging it with the selected time
    const today = dayjs();
    const finalSchedule = scheduledTime
      .year(today.year())
      .month(today.month())
      .date(today.date());

    const minAllowed = dayjs().add(30, 'minute'); // 2 min network buffer
    const maxAllowed = dayjs().endOf('day'); // 11:59:59 PM today

    if (finalSchedule.isBefore(minAllowed)) {
      showSnackBar("Schedule time must be at least 30 minutes from now.", "warning");
      return;
    }

    if (finalSchedule.isAfter(maxAllowed)) {
      showSnackBar("Schedule time cannot exceed today's end of day (11:59 PM).", "warning");
      return;
    }

    setIsApplyingSchedule(true);
    try {
      // Formats it cleanly for the Oracle Backend
      const formattedSchedule = finalSchedule.format('YYYY-MM-DD HH:mm:ss');

      await callApi("/JS/voucher/update-schedule", {
        batchId: submittedBatchId,
        scheduledTime: formattedSchedule
      }, "POST");

      showSnackBar("Schedule applied successfully!", "success");
      handleResetWizard();
    } catch (e) {
      showSnackBar(e.message, "error");
    } finally {
      setIsApplyingSchedule(false);
    }
  };


  const handleExecuteImmediately = async () => {
    setIsExecutingImmediately(true);
    try {
      // Sending a null/empty scheduledTime tells the backend to just run the status flip logic
      await callApi("/JS/voucher/update-schedule", {
        batchId: submittedBatchId,
        scheduledTime: null 
      }, "POST");

      showSnackBar("Request submitted for immediate execution!", "success");
      handleResetWizard();
    } catch (e) {
      showSnackBar(e.message || "Failed to finalize batch execution.", "error");
    } finally {
      setIsExecutingImmediately(false);
    }
  };

  const handleChangePage = (event, newPage) => {
    setPage(newPage);
  };

  const handleChangeRowsPerPage = (event) => {
    setRowsPerPage(parseInt(event.target.value, 10));
    setPage(0);
  };

  const handleRowExpand = (id) => {
    setExpandedRow(expandedRow === id ? null : id);
  };
  const handleBack = () => {
    setActiveStep((prevStep) => prevStep - 1);
  };

  const filterRemarks = (val) => {
    let filtered = val.replace(/[^a-zA-Z0-9 ]/g, ""); // Allow only alphanumeric and spaces
    filtered = filtered.replace(/^\s+/, ""); // Remove leading spaces
    filtered = filtered.replace(/\s{2,}/g, " "); // Replace multiple consecutive spaces with a single space
    return filtered;
  };


  // 1. Common remarks can be empty. If filled, must be 2-30.
  const isCommonRemarksValid = (val) => val.trim().length === 0 || (val.trim().length >= 2 && val.trim().length <= 30);

  // 2. Row remarks are STRICTLY compulsory (2-30 chars).
  const isRowRemarksValid = (val) => val.trim().length >= 2 && val.trim().length <= 30;
  const filterAndWarn = (val) => {
    let filtered = val;
    let hasError = false;
    let msg = "Only alphanumeric, spaces, and / & ( ) , . - are allowed.";

    // 1. Corrected Regex: Allows Alphanumeric, Spaces, and / & ( ) , . -
    const invalidCharRegex = /[^a-zA-Z0-9 \/&(),.\-]/g;

    if (invalidCharRegex.test(filtered)) {
      hasError = true;
      filtered = filtered.replace(invalidCharRegex, "");
    }

    // 2. Strip leading space and collapse double spaces
    const beforeSpaceTrim = filtered;
    filtered = filtered.replace(/^\s+/, "").replace(/\s{2,}/g, " ");

    if (beforeSpaceTrim !== filtered && !hasError) {
      hasError = true;
      msg = "Remark should not start with a space or contain consecutive spaces.";
    }

    if (hasError) {
      showSnackBar(msg, "warning");
    }

    return filtered;
  };

  // Both Common Batch Remarks and Row Remarks are now strictly compulsory (2-30 chars)
  const isRemarksValid = (val) => val.trim().length >= 2 && val.trim().length <= 30;
  const handleAddRow = () => {
    const lastRow = rows[rows.length - 1];

    if (
      !lastRow.branch ||
      !lastRow.currency ||
      !lastRow.cgl ||
      !lastRow.amount ||
      !lastRow.txnType ||
      !isRowRemarksValid(lastRow.remarks)
    ) {
      showSnackBar(
        "Please fill all required fields (*) in the current row before adding a new one.",
        "warning"
      );
      return;
    }

    const newRow = {
      ...createNewRow(),
      remarks: checked ? commonBatchRemarks : "",
    };

    setRows([...rows, newRow]);
  };

  const handleRemarksSync = (event) => {
    const isChecked = event.target.checked;
    setChecked(isChecked);

    if (isChecked) {
      const newRows = rows.map((row) => ({
        ...row,
        remarks: commonBatchRemarks,
      }));
      setRows(newRows);
    } else {
      const newRows = rows.map((row) => ({
        ...row,
        remarks: "",
      }));
      setRows(newRows);
    }
  };

  const handleDeleteRow = (id) => {
    if (rows.length > 1) {
      setRows(rows.filter((row) => row.id !== id));
      // Cleanup input tracking
      const newBranchInputs = { ...branchInputValues };
      delete newBranchInputs[id];
      setBranchInputValues(newBranchInputs);
      const newCglInputs = { ...cglInputValues };
      delete newCglInputs[id];
      setCglInputValues(newCglInputs);
    } else {
      showSnackBar("Cannot delete the first row.", "warning");
    }
  };

  const handleRowChange = (id, field, value) => {
    setRows((prevRows) =>
      prevRows.map((row) => {
        if (row.id === id) {
          return { ...row, [field]: value };
        }
        return row;
      })
    );
  };

  const searchBranches = useCallback(
    debounce(async (query, rowId) => {
      if (!query || query.trim().length < 3) {
        setBranchSearch({ loadingId: null, options: [] });
        return;
      }
      setBranchSearch((prev) => ({ ...prev, loadingId: rowId }));
      try {
        const response = await callApi(
          `/JS/branches-journal/search?query=${encodeURIComponent(query)}`,
          null,
          "GET"
        );

