import React, { useState, useEffect, useCallback } from "react";
import {
  Box,
  Typography,
  Chip,
  Dialog,
  DialogActions,
  DialogContent,
  DialogContentText,
  DialogTitle,
  TextField,
  Button,
  CircularProgress,
  Tooltip,
  IconButton,
  Stack,
  // --- ADDED ---
  Grid,
} from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import {
  Check as CheckIcon,
  Clear as ClearIcon,
  Visibility as VisibilityIcon,
} from "@mui/icons-material";
import AccountCircleIcon from "@mui/icons-material/AccountCircle";
import InfoIcon from "@mui/icons-material/Info";

import useApi from "../../../hooks/useApi";
import useCustomSnackbar from "../../../utils/useCustomSnackbar";

// ... (formatCurrency and CustomNoRowsOverlay functions remain the same) ...
const formatCurrency = (num) => {
  return new Intl.NumberFormat("en-IN", {
    style: "decimal",
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }).format(num);
};

function CustomNoRowsOverlay() {
  return (
    <Stack height="100%" alignItems="center" justifyContent="center">
      <InfoIcon sx={{ fontSize: 48, color: "text.secondary", mb: 2 }} />
      <Typography variant="h6">No Pending Requests Found</Typography>
      <Typography>All MOC requests have been processed.</Typography>
    </Stack>
  );
}
// --- MODIFIED: Center-aligned all columns in the view modal ---
const viewModalColumns = [
  {
    field: "journalId",
    headerName: "Journal ID",
    flex: 1.5,
    minWidth: 200,
    align: "center",
    headerAlign: "center",
  },
  {
    field: "branch",
    headerName: "Branch",
    flex: 1,
    minWidth: 100,
    align: "center",
    headerAlign: "center",
  },
  {
    field: "cgl",
    headerName: "CGL",
    flex: 1,
    minWidth: 150,
    align: "center",
    headerAlign: "center",
  },
  {
    field: "acClassification",
    headerName: "Head",
    flex: 1,
    minWidth: 120,
    align: "center",
    headerAlign: "center",
  },
  {
    field: "transactionType",
    headerName: "Txn Type",
    flex: 1,
    minWidth: 100,
    align: "center",
    headerAlign: "center",
  },
  {
    field: "productType",
    headerName: "Product Code",
    flex: 1,
    minWidth: 120,
    align: "center",
    headerAlign: "center",
  },
  {
    field: "currency",
    headerName: "Currency",
    flex: 0.8,
    minWidth: 80,
    align: "center",
    headerAlign: "center",
  },
];
// -----------------------------------------------------------

export default function MocRequestApproval() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  const [loading, setLoading] = useState(true);
  const [rows, setRows] = useState([]);

  const [isModalOpen, setIsModalOpen] = useState(false);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [selectedBatch, setSelectedBatch] = useState(null);
  const [modalMode, setModalMode] = useState("ACCEPTED");
  const [executorRemarks, setExecutorRemarks] = useState("");

  const [isViewModalOpen, setIsViewModalOpen] = useState(false);
  const [isViewLoading, setIsViewLoading] = useState(false);
  const [batchDetails, setBatchDetails] = useState([]);
  const [viewingBatchId, setViewingBatchId] = useState(null);

  // --- ADDED: State for partial (journal-level) approval ---
  const [selectedJournalIds, setSelectedJournalIds] = useState([]);
  const [partialExecutorRemarks, setPartialExecutorRemarks] = useState("");
  const [isPartialSubmitting, setIsPartialSubmitting] = useState(false);
  // ---------------------------------------------------------

  const fetchPendingBatches = useCallback(async () => {
    setLoading(true);
    try {
      const pendingRequests = await callApi(
        "MS/moc/pending-requests",
        null,
        "GET"
      );

      if (!Array.isArray(pendingRequests) || pendingRequests.length === 0) {
        setRows([]);
        setLoading(false);

        return;
      }

      const groupedBatches = new Map();
      for (const request of pendingRequests) {
        const batchId = request.batchId;

        if (!groupedBatches.has(batchId)) {
          groupedBatches.set(batchId, {
            id: batchId,
            batchId: batchId,
            creatorId: request.creatorId,
            requestStatus: request.requestStatus,
            requestDate: request.requestDate,
            commonBatchRemarks: request.commonBatchRemarks,
            totalDebit: 0,
            totalCredit: 0,
            requestCount: 0,
          });
        }

        const batchDetails = groupedBatches.get(batchId);
        batchDetails.requestCount++;

        try {
          const payload = JSON.parse(request.payload);
          const amount = parseFloat(payload.amount) || 0;
          if (payload.transactionType === "Debit") {
            batchDetails.totalDebit += amount;
          } else if (payload.transactionType === "Credit") {
            batchDetails.totalCredit += amount;
          }
        } catch (e) {
          console.error(`Failed to parse payload for request ${request.id}`, e);
        }
      }
      setRows(Array.from(groupedBatches.values()));
    } catch (err) {
      console.error("Failed to fetch pending requests:", err);
      showSnackBar("Failed to load pending requests.", "error");
    } finally {
      setLoading(false);
    }
  }, [callApi, showSnackBar]);

  useEffect(() => {
    fetchPendingBatches();
  }, [fetchPendingBatches]);

  const handleOpenModal = (batch, mode) => {
    setSelectedBatch(batch);
    setModalMode(mode);
    setExecutorRemarks("");
    setIsModalOpen(true);
  };

  const handleCloseModal = () => {
    if (isSubmitting) return;
    setIsModalOpen(false);
    setSelectedBatch(null);
  };

  const handleOpenViewModal = async (batchId) => {
    setIsViewModalOpen(true);
    setIsViewLoading(true);
    setViewingBatchId(batchId);
    try {
      const data = await callApi(`MS/moc/by-batch/${batchId}`, null, "GET");

      if (Array.isArray(data)) {
        const processedData = data
          .map((req) => {
            try {
              // --- MODIFIED: Only include PENDING requests in the modal ---
              if (req.requestStatus !== "PENDING") {
                return null;
              }
              // ----------------------------------------------------------
              const payload = JSON.parse(req.payload);
              return {
                id: req.journalId,
                journalId: req.journalId,
                branch: payload.branch,
                currency: payload.currency,
                cgl: payload.cgl,
                transactionType: payload.transactionType,
                productType: payload.productType,
                acClassification: payload.acClassification,
              };
            } catch (e) {
              console.error("Failed to parse payload for req:", req.id, e);
              return null;
            }
          })
          .filter(Boolean);

        setBatchDetails(processedData);
      } else {
        setBatchDetails([]);
        showSnackBar("No details found for this batch.", "info");
      }
    } catch (error) {
      console.error("Failed to fetch batch details:", error);
      showSnackBar("Failed to load batch details.", "error");
      setBatchDetails([]);
    } finally {
      setIsViewLoading(false);
    }
  };

  const handleCloseViewModal = () => {
    setIsViewModalOpen(false);
    setBatchDetails([]);
    setViewingBatchId(null);
    // --- ADDED: Reset partial state on close ---
    setSelectedJournalIds([]);
    setPartialExecutorRemarks("");
    setIsPartialSubmitting(false);
    // -------------------------------------------
  };

  const handleSubmitAction = async () => {
    // ... (This function for *full batch* approval remains unchanged) ...
    if (modalMode === "REJECTED" && !executorRemarks.trim()) {
      showSnackBar("Approver remarks are required for rejection.", "warning");
      return;
    }

    setIsSubmitting(true);
    const payload = {
      batchId: selectedBatch.batchId,
      status: modalMode,
      remarks:
        executorRemarks.trim() ||
        (modalMode === "ACCEPTED" ? "Accepted" : "Rejected"),
    };

    try {
      await callApi("MS/moc/process-bulk", payload, "POST");
      showSnackBar(
        `Batch ${
          selectedBatch.batchId
        } successfully ${modalMode.toLowerCase()}ed.`,
        "success"
      );
      handleCloseModal();
      fetchPendingBatches();
    } catch (error) {
      console.error("Failed to process batch:", error);
      const errorMsg =
        error.response?.data?.message ||
        `Failed to ${modalMode.toLowerCase()} batch.`;
      showSnackBar(errorMsg, "error");
    } finally {
      setIsSubmitting(false);
    }
  };

  // --- ADDED: Function to handle partial (journal-level) approval/rejection ---
  const handleSubmitPartialAction = async (mode) => {
    if (mode === "REJECTED" && !partialExecutorRemarks.trim()) {
      showSnackBar("Approver remarks are required for rejection.", "warning");
      return;
    }

    if (selectedJournalIds.length === 0) {
      showSnackBar("Please select at least one entry to process.", "warning");
      return;
    }

    setIsPartialSubmitting(true);

    const payload = {
      journalIds: selectedJournalIds, // Use the state variable
      status: mode,
      remarks:
        partialExecutorRemarks.trim() ||
        (mode === "ACCEPTED" ? "Accepted" : "Rejected"),
    };

    try {
      await callApi("MS/moc/process-bulk", payload, "POST");
      showSnackBar(
        `${
          selectedJournalIds.length
        } entries successfully ${mode.toLowerCase()}ed.`,
        "success"
      );
      handleCloseViewModal(); // Close the popup
      fetchPendingBatches(); // Refresh the main grid
    } catch (error) {
      console.error("Failed to process partial batch:", error);
      const errorMsg =
        error.response?.data?.message ||
        `Failed to ${mode.toLowerCase()} selected entries.`;
      showSnackBar(errorMsg, "error");
    } finally {
      setIsPartialSubmitting(false);
    }
  };
  // -------------------------------------------------------------------------

  const columns = [
    // ... (Main grid columns remain unchanged) ...
    {
      field: "batchId",
      headerName: "Batch ID",
      flex: 1.2,
      minWidth: 150,
    },
    {
      field: "requestStatus",
      headerName: "Status",
      flex: 0.5,
      align: "center",
      headerAlign: "center",
      renderCell: (params) => (
        <Chip label={params.value} color="warning" size="small" />
      ),
    },
    {
      field: "creatorId",
      headerName: "Creator",
      flex: 0.6,
      align: "center",
      headerAlign: "center",
      renderCell: (params) => (
        <Chip icon={<AccountCircleIcon />} label={params.value} size="small" />
      ),
    },
    {
      field: "requestDate",
      headerName: "Submitted On",
      flex: 1,
      minWidth: 180,
      renderCell: (params) => (
        <Box>
          {new Date(params.value).toLocaleString("en-IN", {
            dateStyle: "medium",
            timeStyle: "short",
          })}
        </Box>
      ),
    },
    {
      field: "commonBatchRemarks",
      headerName: "Creator Remarks",
      flex: 1.5,
      minWidth: 200,
    },
    {
      field: "requestCount",
      headerName: "Entries",
      flex: 0.4,
      minWidth: 50,
      align: "center",
      headerAlign: "center",
    },
    {
      field: "totalCredit",
      headerName: "Total Credit",
      flex: 0.7,
      minWidth: 120,
      align: "right",
      headerAlign: "right",
      renderCell: (params) => (
        <Typography sx={{ color: "success.dark", fontWeight: "bold" }}>
          {formatCurrency(params.value)}
        </Typography>
      ),
    },
    {
      field: "totalDebit",
      headerName: "Total Debit",
      flex: 0.7,
      minWidth: 120,
      align: "right",
      headerAlign: "right",
      renderCell: (params) => (
        <Typography sx={{ color: "error.dark", fontWeight: "bold" }}>
          {formatCurrency(params.value)}
        </Typography>
      ),
    },
    {
      field: "actions",
      headerName: "Actions",
      flex: 0.8,
      minWidth: 130,
      align: "center",
      headerAlign: "center",
      sortable: false,
      renderCell: (params) => (
        <Stack direction="row" spacing={0.5}>
          <Tooltip title="View Details">
            <IconButton
              onClick={() => handleOpenViewModal(params.row.batchId)}
              color="primary"
            >
              <VisibilityIcon />
            </IconButton>
          </Tooltip>
          <Tooltip title="Accept Batch">
            <IconButton
              onClick={() => handleOpenModal(params.row, "ACCEPTED")}
              color="success"
            >
              <CheckIcon />
            </IconButton>
          </Tooltip>
          <Tooltip title="Reject Batch">
            <IconButton
              onClick={() => handleOpenModal(params.row, "REJECTED")}
              color="error"
            >
              <ClearIcon />
            </IconButton>
          </Tooltip>
        </Stack>
      ),
    },
  ];

  return (
    <Box sx={{ p: 3, width: "100%" }}>
      <Typography
        variant="h4"
        gutterBottom
        sx={{ fontWeight: "bold", color: "primary.main", mb: 3 }}
      >
        MOC Request Approval
      </Typography>

      <DataGrid
        // ... (Main DataGrid props remain unchanged) ...
        rows={rows}
        columns={columns}
        loading={loading}
        getRowId={(row) => row.batchId}
        disableRowSelectionOnClick
        pageSizeOptions={[5, 10, 25]}
        initialState={{
          pagination: { paginationModel: { pageSize: 10, page: 0 } },
          sorting: { sortModel: [{ field: "requestDate", sort: "desc" }] },
        }}
        slots={{
          noRowsOverlay: CustomNoRowsOverlay,
        }}
        sx={{
          height: 600,
          width: "100%",
          "& .MuiDataGrid-cell:focus": { outline: "none" },
        }}
      />

      {/* --- Action Confirmation Modal (Full Batch) --- */}
      <Dialog
        // ... (This modal remains unchanged) ...
        open={isModalOpen}
        onClose={handleCloseModal}
        fullWidth
        maxWidth="sm"
      >
        <DialogTitle
          sx={{
            backgroundColor:
              modalMode === "ACCEPTED" ? "success.main" : "error.main",
            color: "white",
            fontWeight: "bold",
          }}
        >
          {modalMode === "ACCEPTED" ? "Approve" : "Reject"} Batch
        </DialogTitle>
        <DialogContent sx={{ pt: 3, mt: 2 }}>
          <DialogContentText sx={{ mb: 2 }}>
            You are about to{" "}
            <strong
              style={{
                color: modalMode === "ACCEPTED" ? "green" : "red",
                textTransform: "uppercase",
              }}
            >
              {modalMode}
            </strong>{" "}
            the entire batch <strong>{selectedBatch?.batchId}</strong>.
            {modalMode === "REJECTED" &&
              " Please provide mandatory remarks below."}
          </DialogContentText>
          <TextField
            autoFocus={modalMode === "REJECTED"}
            required={modalMode === "REJECTED"}
            margin="dense"
            id="executorRemarks"
            label="Approver Remarks"
            type="text"
            fullWidth
            multiline
            rows={3}
            value={executorRemarks}
            onChange={(e) => setExecutorRemarks(e.target.value)}
            disabled={isSubmitting}
            InputProps={{
              inputProps: {
                maxLength: 200,
              },
            }}
          />
        </DialogContent>
        <DialogActions sx={{ p: 2 }}>
          <Button onClick={handleCloseModal} disabled={isSubmitting}>
            Cancel
          </Button>
          <Button
            onClick={handleSubmitAction}
            variant="contained"
            color={modalMode === "ACCEPTED" ? "success" : "error"}
            disabled={isSubmitting}
          >
            {isSubmitting ? (
              <CircularProgress size={24} color="inherit" />
            ) : (
              `Confirm ${modalMode === "ACCEPTED" ? "Approval" : "Rejection"}`
            )}
          </Button>
        </DialogActions>
      </Dialog>

      {/* --- MODIFIED: View Batch Details Modal --- */}
      <Dialog
        open={isViewModalOpen}
        onClose={handleCloseViewModal}
        fullWidth
        maxWidth="xl"
      >
        <DialogTitle sx={{ fontWeight: "bold", color: "primary.main" }}>
          Batch Details: {viewingBatchId}
        </DialogTitle>
        <DialogContent>
          {isViewLoading ? (
            <Box
              sx={{
                display: "flex",
                justifyContent: "center",
                alignItems: "center",
                minHeight: 300,
              }}
            >
              <CircularProgress />
            </Box>
          ) : (
            <Box sx={{ height: 400, width: "100%", mt: 2 }}>
              <DataGrid
                rows={batchDetails}
                columns={viewModalColumns}
                getRowId={(row) => row.id}
                disableRowSelectionOnClick
                pageSizeOptions={[5, 10, 25]}
                initialState={{
                  pagination: { paginationModel: { pageSize: 5, page: 0 } },
                }}
                slots={{
                  noRowsOverlay: () => (
                    <Stack
                      height="100%"
                      alignItems="center"
                      justifyContent="center"
                    >
                      {/* --- MODIFIED: More helpful message --- */}
                      <Typography>
                        No pending entries found for this batch.
                      </Typography>
                    </Stack>
                  ),
                }}
                density="compact"
                // --- ADDED: Checkbox functionality ---
                checkboxSelection={true}
                onRowSelectionModelChange={(newSelectionModel) => {
                  setSelectedJournalIds(newSelectionModel);
                }}
                rowSelectionModel={selectedJournalIds}
                // -------------------------------------
              />
            </Box>
          )}

          {/* --- ADDED: Remarks field for partial rejection --- */}
          {!isViewLoading && batchDetails.length > 0 && (
            <TextField
              margin="dense"
              id="partialExecutorRemarks"
              label="Approver Remarks (Required for Rejection)"
              type="text"
              fullWidth
              multiline
              rows={2}
              value={partialExecutorRemarks}
              onChange={(e) => setPartialExecutorRemarks(e.target.value)}
              disabled={isPartialSubmitting}
              InputProps={{
                inputProps: {
                  maxLength: 200,
                },
              }}
              sx={{ mt: 2 }}
            />
          )}
          {/* ------------------------------------------------ */}
        </DialogContent>

        {/* --- MODIFIED: Dialog actions for partial processing --- */}
        <DialogActions sx={{ p: 2 }}>
          <Grid container spacing={2} justifyContent="space-between">
            <Grid item>
              <Button
                onClick={handleCloseViewModal}
                variant="outlined"
                disabled={isPartialSubmitting}
              >
                Close
              </Button>
            </Grid>
            <Grid item>
              <Stack direction="row" spacing={2}>
                <Button
                  onClick={() => handleSubmitPartialAction("REJECTED")}
                  variant="contained"
                  color="error"
                  disabled={
                    isPartialSubmitting ||
                    selectedJournalIds.length === 0 ||
                    !partialExecutorRemarks.trim() // Remarks must not be empty for rejection
                  }
                >
                  {isPartialSubmitting ? (
                    <CircularProgress size={24} color="inherit" />
                  ) : (
                    "Reject Selected"
                  )}
                </Button>
                <Button
                  onClick={() => handleSubmitPartialAction("ACCEPTED")}
                  variant="contained"
                  color="success"
                  disabled={
                    isPartialSubmitting || selectedJournalIds.length === 0
                  }
                >
                  {isPartialSubmitting ? (
                    <CircularProgress size={24} color="inherit" />
                  ) : (
                    "Accept Selected"
                  )}
                </Button>
              </Stack>
            </Grid>
          </Grid>
        </DialogActions>
        {/* --------------------------------------------------- */}
      </Dialog>
    </Box>
  );
}
