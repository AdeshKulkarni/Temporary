  /**
   * Handles input change with validation
   */
  const handleChange = (e) => {
    const { name, value } = e.target;

    // Initialize a variable for the final value.
    let finalValue = value;

    // Convert to uppercase *before* validation for specific fields.
    if (["FRN", "PAN", "GSTIN"].includes(name)) {
      finalValue = value.toUpperCase();
    }

    // Now, validate the potentially transformed (uppercase) value.
    const isValid = validateData(name, finalValue);
    
    // Update the error state based on the validation result.
    // If it's valid, the error for this field is cleared (set to "").
    setErrors((prev) => ({ ...prev, [name]: isValid ? "" : "Invalid value" }));

    // Update the form state with the final (e.g., uppercase) value.
    setFirmDetails((prev) => ({ ...prev, [name]: finalValue }));
  };
