package com.fincore.VoucherService.Service;

import com.fincore.VoucherService.Exception.CustomExceptions;
import jakarta.persistence.EntityManager;
import jakarta.persistence.PersistenceContext;
import jakarta.persistence.PersistenceException;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;
import jakarta.transaction.Transactional;

/**
 * Provides unique, zero-padded identifiers for batches and journals.
 * Interacts directly with Oracle Sequences via native queries for maximum reliability.
 */
@Service
@RequiredArgsConstructor
@Slf4j
public class SequenceService {

    @PersistenceContext
    private EntityManager entityManager;

    /**
     * Pads the given number with leading zeros to a total length of 7.
     * Logic preserved exactly as defined.
     */
    private String padToSevenDigits(Long id) {
        if (id == null) {
            log.error("SEQUENCE_PADDING_FAIL | Status: DATABASE_SEQUENCE_EXHAUSTED_OR_NULL");

            throw new CustomExceptions.DatabaseOperationException("Critical failure: Oracle Sequence returned null. Check Sequence limits.");
        }
        return String.format("%07d", id);
    }

    /**
     * Gets the next BATCH_ID from the BATCH_SEQ sequence.
     * Wrapped in specific error handling for database persistence issues.
     */
    @Transactional
    public String getNextBatchId() {
        try {
            Number nextId = (Number) entityManager
                    .createNativeQuery("select BATCH_SEQ.nextval from dual")
                    .getSingleResult();

            String paddedId = padToSevenDigits(nextId.longValue());
            log.info("SEQUENCE_GENERATED | Type: BATCH_ID | Value: {}", paddedId);
            return paddedId;

        } catch (PersistenceException e) {
            log.error("SEQUENCE_FETCH_FAIL | Type: BATCH_ID | Status: Oracle sequence error");
            throw new CustomExceptions.DatabaseOperationException("Critical failure: Batch sequence unavailable", e);
        }
    }

    /**
     * Gets the next JOURNAL_ID prefix from the JRNL_SEQ sequence.
     */
    @Transactional
    public String getNextJournalIdPrefix() {
        try {
            Number nextId = (Number) entityManager
                    .createNativeQuery("select JRNL_SEQ.nextval from dual")
                    .getSingleResult();

            String paddedId = padToSevenDigits(nextId.longValue());
            log.info("SEQUENCE_GENERATED | Type: JRNL_ID | Value: {}", paddedId);
            return paddedId;

        } catch (PersistenceException e) {
            log.error("SEQUENCE_FETCH_FAIL | Type: JRNL_ID | Reason: Oracle JRNL_SEQ unavailable: {}", e.getMessage());
            throw new CustomExceptions.DatabaseOperationException("Critical failure: Could not generate Journal ID sequence", e);
        }
    }
}
