import React, { useState, useEffect, useMemo } from "react";
import {
  Divider,
  Typography,
  Box,
  Stack,
  Button,
  Paper,
  MenuItem,
  TextField,
  Tabs,
  Tab,
} from "@mui/material";
import { DataGrid, GridToolbar } from "@mui/x-data-grid";
import { encrypt } from "../../Security/AES-GCM256";
import axios from "axios";
import downloadFile from "../../DownloadFile/DownloadFile";

const iv = crypto.getRandomValues(new Uint8Array(12));
const ivBase64 = btoa(String.fromCharCode.apply(null, iv));
const salt = crypto.getRandomValues(new Uint8Array(16));
const saltBase64 = btoa(String.fromCharCode.apply(null, salt));

const columns = [
  { field: "FRN", headerName: "FRN", width: 170 },
  { field: "FIRM_NAME", headerName: "FIRM NAME", width: 200 },
  { field: "EMPANELMENT_SUB_TYPE", headerName: "EMPANELMENT SUB TYPE", width: 280 },
  { field: "EMPANELED_BY", headerName: "EMPANELED BY", width: 140 },
  { field: "EMPANELED_STATUS", headerName: "EMPANELED STATUS", width: 160 },
  { field: "EMPANELMENT_TYPE", headerName: "EMPANELMENT TYPE", width: 160 },
  { field: "FINANCIAL_YEAR", headerName: "FINANCIAL YEAR", width: 160 },
  { field: "REQUEST_STATUS", headerName: "REQUEST STATUS", width: 160 },
];

const ViewActiveAuditor = () => {
  const [empanelmentData, setEmpanelmentData] = useState([]);
  const [userIp, setUserIp] = useState({ datatype: "", financialYear: "", type: "", subType: "" });

  // Get FINANCIAL_YEARs for archive
  const financialYearOptions = useMemo(() => {
    if (userIp.datatype !== "Archive" || !empanelmentData.length) return [];
    return [...new Set(empanelmentData.map(row => row.FINANCIAL_YEAR))].filter(Boolean);
  }, [userIp.datatype, empanelmentData]);

  // Get Type options filtered by financial year (Archive) or just by data (Active)
  const typeOptions = useMemo(() => {
    let data = empanelmentData;
    if (userIp.datatype === "Archive" && userIp.financialYear)
      data = data.filter(row => row.FINANCIAL_YEAR === userIp.financialYear);
    return [...new Set(data.map(row => row.EMPANELMENT_TYPE))].filter(Boolean);
  }, [empanelmentData, userIp.datatype, userIp.financialYear]);

  // Get SubType options filtered by type & financial year (Archive) or type (Active)
  const subTypeOptions = useMemo(() => {
    let data = empanelmentData;
    if (userIp.datatype === "Archive" && userIp.financialYear)
      data = data.filter(row => row.FINANCIAL_YEAR === userIp.financialYear);
    if (userIp.type)
      data = data.filter(row => row.EMPANELMENT_TYPE === userIp.type);
    return [...new Set(data.map(row => row.EMPANELMENT_SUB_TYPE))].filter(Boolean);
  }, [empanelmentData, userIp.datatype, userIp.financialYear, userIp.type]);

  // Filtered rows for DataGrid
  const filteredRows = useMemo(() => {
    let data = empanelmentData;
    if (userIp.datatype === "Archive" && userIp.financialYear)
      data = data.filter(row => row.FINANCIAL_YEAR === userIp.financialYear);
    if (userIp.type)
      data = data.filter(row => row.EMPANELMENT_TYPE === userIp.type);
    if (userIp.subType)
      data = data.filter(row => row.EMPANELMENT_SUB_TYPE === userIp.subType);
    return data;
  }, [empanelmentData, userIp.datatype, userIp.financialYear, userIp.type, userIp.subType]);

  // Fetch data on tab change or type change
  useEffect(() => {
    if (userIp.datatype) {
      fetchData(userIp.datatype);
    }
    // eslint-disable-next-line
  }, [userIp.datatype]);

  const fetchData = async (datatype) => {
    // For Archive, fetch all years; for Active, fetch as before
    let dataToSend = {};
    if (datatype === "Active") {
      dataToSend.EMPANELMENT_TYPE = ""; // You can limit if needed
    }
    try {
      const jsonFormData = JSON.stringify(dataToSend);
      const encryptedData = await encrypt(iv, salt, jsonFormData);
      const payload = { iv: ivBase64, salt: saltBase64, data: encryptedData };
      const response = await axios.post(
        datatype === "Active"
          ? "Server/IAMServices/getActiveFRN"
          : "Server/IAMServices/getArchiveFRN", // adjust archive API endpoint if needed
        payload,
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      setEmpanelmentData(response.data.result || []);
    } catch (e) {
      console.error("Fetch Error:", e);
    }
  };

  const handleDownload = async () => {
    let dataToSend = filteredRows;
    try {
      let jsonFormData = JSON.stringify(dataToSend);
      const encryptedData = await encrypt(iv, salt, jsonFormData);
      const payload = {
        iv: ivBase64,
        salt: saltBase64,
        data: encryptedData,
      };
      const response = await axios.post(
        "Server/IAMServices/download_empanelment_data",
        payload,
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      const resData = response.data.result;
      if (resData) {
        downloadFile(resData, "excel", `${userIp.datatype}_Empanelment_list`);
      }
    } catch (e) {
      console.error("Download Error:", e);
    }
  };

  // Handlers
  const handleTabChange = (event, newValue) => {
    setUserIp({ datatype: newValue, financialYear: "", type: "", subType: "" });
    setEmpanelmentData([]);
  };
  const handleSelectFinancialYear = (year) => {
    setUserIp(prev => ({ ...prev, financialYear: year, type: "", subType: "" }));
  };
  const handleSelectType = (type) => {
    setUserIp(prev => ({ ...prev, type, subType: "" }));
  };
  const handleSelectSubType = (subType) => {
    setUserIp(prev => ({ ...prev, subType }));
  };

  return (
    <>
      <Typography variant="h5" sx={{ fontWeight: 600, mb: 0.5 }}>
        Empanelment Data
      </Typography>
      <Divider sx={{ mb: 3 }} />
      <Paper
        sx={{
          p: 3,
          maxWidth: "90%",
          height: "80%",
          mx: "auto",
          my: 4,
          boxShadow: 4,
        }}
      >
        <Box sx={{ mb: 3 }}>
          <Tabs
            value={userIp.datatype}
            onChange={handleTabChange}
            textColor="primary"
            indicatorColor="primary"
            sx={{
              "& .MuiTab-root": { fontWeight: 500, fontSize: 16, minWidth: 120 },
            }}
          >
            <Tab label="Active" value="Active" />
            <Tab label="Archive" value="Archive" />
          </Tabs>
        </Box>

        {userIp.datatype && (
          <Stack direction="row" spacing={2} alignItems="center" sx={{ mb: 3 }}>
            {/* Only show for Archive */}
            {userIp.datatype === "Archive" && (
              <TextField
                select
                label="Financial Year"
                value={userIp.financialYear}
                onChange={(e) => handleSelectFinancialYear(e.target.value)}
                sx={{ minWidth: 180 }}
                size="small"
                InputLabelProps={{ shrink: true }}
              >
                <MenuItem value="">-- All Years --</MenuItem>
                {financialYearOptions.map((option) => (
                  <MenuItem key={option} value={option}>
                    {option}
                  </MenuItem>
                ))}
              </TextField>
            )}
            <TextField
              select
              label="Type"
              value={userIp.type}
              onChange={(e) => handleSelectType(e.target.value)}
              sx={{ minWidth: 200 }}
              size="small"
              InputLabelProps={{ shrink: true }}
              disabled={userIp.datatype === "Archive" && !userIp.financialYear}
            >
              <MenuItem disabled value="">-- Select Type --</MenuItem>
              {typeOptions.map((type) => (
                <MenuItem key={type} value={type}>{type}</MenuItem>
              ))}
            </TextField>
            {userIp.type && (
              <TextField
                select
                label="Empanelment Sub Type"
                value={userIp.subType}
                onChange={(e) => handleSelectSubType(e.target.value)}
                sx={{ minWidth: 220 }}
                size="small"
                InputLabelProps={{ shrink: true }}
              >
                <MenuItem value="">-- All Sub Types --</MenuItem>
                {subTypeOptions.map((option) => (
                  <MenuItem key={option} value={option}>
                    {option}
                  </MenuItem>
                ))}
              </TextField>
            )}
          </Stack>
        )}

        {userIp.type !== "" && (
          <Box sx={{ width: "100%", mt: 2 }}>
            <Button
              onClick={handleDownload}
              variant="contained"
              sx={{
                mb: 2,
                ml: "auto",
                display: "block",
                fontWeight: 600,
                px: 3,
                borderRadius: 2,
              }}
            >
              Download
            </Button>
            <Paper
              elevation={2}
              sx={{
                borderRadius: 2,
                overflow: "hidden",
                minHeight: 420,
                background: "#f9f9f9",
              }}
            >
              <DataGrid
                rows={filteredRows}
                columns={columns}
                getRowId={(row) => row.FRN}
                pageSizeOptions={[5, 10, 20, 50]}
                initialState={{
                  pagination: { paginationModel: { pageSize: 10 } },
                }}
                disableRowSelectionOnClick
                slots={{
                  toolbar: () => (
                    <Box sx={{ display: "flex", justifyContent: "flex-end", width: "100%" }}>
                      <GridToolbar />
                    </Box>
                  ),
                }}
                sx={{
                  border: "none",
                  "& .MuiDataGrid-columnHeaders": {
                    background: "#e3e7ef",
                    fontWeight: 600,
                    fontSize: 15,
                  },
                  "& .MuiDataGrid-row": {
                    background: "#fff",
                  },
                  "& .MuiDataGrid-footerContainer": {
                    background: "#fafafa",
                  },
                }}
                autoHeight
              />
            </Paper>
          </Box>
        )}
      </Paper>
    </>
  );
};

export default ViewActiveAuditor;