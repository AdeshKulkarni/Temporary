import React, { useState, useMemo } from 'react';
import {
  Button,
  Box,
  Paper,
  Typography,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Checkbox
} from '@mui/material';
import { DataGrid, GridToolbar } from '@mui/x-data-grid';

const NamesPreviewComponent = () => {
  const [selectedRows, setSelectedRows] = useState([]);
  const [isPreviewOpen, setIsPreviewOpen] = useState(false);
  
  // Generate stable IDs for rows
  const generateNames = useMemo(() => {
    const names = [
      'Emma Johnson', 'Noah Smith', 'Olivia Williams', 'Liam Brown', 
      'Ava Jones', 'William Garcia', 'Sophia Miller', 'James Davis',
      'Isabella Rodriguez', 'Benjamin Martinez'
    ];
    
    return names
      .slice(0, 5 + Math.floor(Math.random() * 5)) // 5-10 names
      .map((name, index) => ({
        id: `row-${index + 1}-${Date.now()}`, // Unique ID
        serial: index + 1,
        name,
      }));
  }, []);

  const columns = [
    {
      field: 'selected',
      headerName: 'Select',
      width: 80,
      renderHeader: () => (
        <Checkbox
          checked={selectedRows.length === generateNames.length}
          indeterminate={selectedRows.length > 0 && selectedRows.length < generateNames.length}
          onChange={handleSelectAll}
        />
      ),
      renderCell: (params) => (
        <Checkbox
          checked={selectedRows.includes(params.row.id)}
          onChange={() => handleSelectRow(params.row.id)}
        />
      )
    },
    {
      field: 'serial',
      headerName: 'Sr. No',
      width: 100,
      valueGetter: (params) => params.row.serial
    },
    {
      field: 'name',
      headerName: 'Name',
      flex: 1,
      minWidth: 200
    }
  ];

  const handleSelectRow = (id) => {
    setSelectedRows(prev => 
      prev.includes(id) 
        ? prev.filter(rowId => rowId !== id) 
        : [...prev, id]
    );
  };

  const handleSelectAll = () => {
    if (selectedRows.length === generateNames.length) {
      setSelectedRows([]);
    } else {
      setSelectedRows(generateNames.map(row => row.id));
    }
  };

  const handlePreview = () => {
    setIsPreviewOpen(true);
  };

  const handleClosePreview = () => {
    setIsPreviewOpen(false);
  };

  // Get selected names with fallback
  const selectedNames = generateNames
    .filter(row => selectedRows.includes(row.id))
    .map(row => row.name);

  return (
    <Box sx={{ p: 3 }}>
      <Paper elevation={3} sx={{ p: 3, borderRadius: 2 }}>
        <Typography variant="h6" gutterBottom sx={{ mb: 2 }}>
          Employee Selection
        </Typography>
        
        <Box sx={{ height: 400, width: '100%' }}>
          <DataGrid
            rows={generateNames}
            columns={columns}
            getRowId={(row) => row.id}  // Explicit ID mapping
            disableColumnMenu
            hideFooterSelectedRowCount
            components={{
              Toolbar: GridToolbar,
            }}
            componentsProps={{
              toolbar: {
                showQuickFilter: true,
                quickFilterProps: { debounceMs: 500 },
              },
            }}
          />
        </Box>
        
        <Box sx={{ mt: 2, display: 'flex', justifyContent: 'flex-end' }}>
          <Button
            variant="contained"
            color="primary"
            onClick={handlePreview}
            disabled={selectedRows.length === 0}
            sx={{ minWidth: 120 }}
          >
            Preview
          </Button>
        </Box>
      </Paper>
      
      <Dialog 
        open={isPreviewOpen} 
        onClose={handleClosePreview}
        maxWidth="sm"
        fullWidth
      >
        <DialogTitle>Selected Names Preview</DialogTitle>
        
        <DialogContent dividers>
          <Typography variant="body1" gutterBottom>
            Selected {selectedNames.length} names:
          </Typography>
          
          <Box 
            component="ul" 
            sx={{ 
              pl: 3, 
              maxHeight: 300, 
              overflow: 'auto',
              border: '1px solid #eee',
              borderRadius: 1,
              p: 2,
              mt: 1
            }}
          >
            {selectedNames.map((name, index) => (
              <li key={index}>
                <Typography variant="body1">{name}</Typography>
              </li>
            ))}
          </Box>
        </DialogContent>
        
        <DialogActions>
          <Button 
            onClick={handleClosePreview} 
            color="primary"
            variant="outlined"
          >
            Close
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
};

export default NamesPreviewComponent;
