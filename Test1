import React, { useState, useEffect, useMemo } from "react";
import {
  Divider,
  Typography,
  Box,
  Stack,
  Button,
  Paper,
  MenuItem,
  TextField,
  Tabs,
  Tab,
} from "@mui/material";
import { DataGrid, GridToolbar } from "@mui/x-data-grid";
import { encrypt } from "../../Security/AES-GCM256";
import axios from "axios";
import downloadFile from "../../DownloadFile/DownloadFile";

const iv = crypto.getRandomValues(new Uint8Array(12));
const ivBase64 = btoa(String.fromCharCode.apply(null, iv));
const salt = crypto.getRandomValues(new Uint8Array(16));
const saltBase64 = btoa(String.fromCharCode.apply(null, salt));

const columns = [
  { field: "FRN", headerName: "FRN", width: 170 },
  { field: "FIRM_NAME", headerName: "FIRM NAME", width: 200 },
  { field: "EMPANELMENT_SUB_TYPE", headerName: "EMPANELMENT SUB TYPE", width: 280 },
  { field: "EMPANELED_BY", headerName: "EMPANELED BY", width: 140 },
  { field: "EMPANELED_STATUS", headerName: "EMPANELED STATUS", width: 160 },
  { field: "EMPANELMENT_TYPE", headerName: "EMPANELMENT TYPE", width: 160 },
  { field: "FINANCIAL_YEAR", headerName: "FINANCIAL YEAR", width: 160 },
  { field: "REQUEST_STATUS", headerName: "REQUEST STATUS", width: 160 },
];

const ViewActiveAuditor = () => {
  const [empanelmentData, setEmpanelmentData] = useState([]);
  const [userIp, setUserIp] = useState({ datatype: "", type: "", subType: "" });

  // Dynamically get unique sub types based on chosen type, from the fetched data
  const availableSubTypes = useMemo(() => {
    if (!userIp.type) return [];
    const filtered = empanelmentData.filter(row => row.EMPANELMENT_TYPE === userIp.type);
    const unique = [...new Set(filtered.map(row => row.EMPANELMENT_SUB_TYPE))];
    return unique;
  }, [empanelmentData, userIp.type]);

  // Filtered data based on selected type and subType
  const filteredRows = useMemo(() => {
    let rows = empanelmentData;
    if (userIp.type) {
      rows = rows.filter(row => row.EMPANELMENT_TYPE === userIp.type);
    }
    if (userIp.subType) {
      rows = rows.filter(row => row.EMPANELMENT_SUB_TYPE === userIp.subType);
    }
    return rows;
  }, [empanelmentData, userIp.type, userIp.subType]);

  useEffect(() => {
    if (userIp.type !== "") {
      fetchData(userIp.type);
    }
    // eslint-disable-next-line
  }, [userIp.type]);

  const fetchData = async (type) => {
    const dataToSend = { EMPANELMENT_TYPE: type };
    try {
      const jsonFormData = JSON.stringify(dataToSend);
      const encryptedData = await encrypt(iv, salt, jsonFormData);
      const payload = {
        iv: ivBase64,
        salt: saltBase64,
        data: encryptedData,
      };
      const response = await axios.post(
        "Server/IAMServices/getActiveFRN",
        payload,
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      setEmpanelmentData(response.data.result || []);
    } catch (e) {
      console.error("Fetch Error:", e);
    }
  };

  const handleDownload = async () => {
    let dataToSend = filteredRows;
    try {
      let jsonFormData = JSON.stringify(dataToSend);
      const encryptedData = await encrypt(iv, salt, jsonFormData);
      const payload = {
        iv: ivBase64,
        salt: saltBase64,
        data: encryptedData,
      };
      const response = await axios.post(
        "Server/IAMServices/download_empanelment_data",
        payload,
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      const resData = response.data.result;
      if (resData) {
        downloadFile(resData, "excel", `${userIp.datatype}_Empanelment_list`);
      }
    } catch (e) {
      console.error("Download Error:", e);
    }
  };

  const handleTabChange = (event, newValue) => {
    setUserIp({ datatype: newValue, type: "", subType: "" });
    setEmpanelmentData([]);
  };

  const handleSelectType = (type) => {
    setUserIp((prev) => ({ ...prev, type, subType: "" }));
  };

  const handleSelectSubType = (subType) => {
    setUserIp((prev) => ({ ...prev, subType }));
  };

  return (
    <>
      <Typography variant="h5" sx={{ fontWeight: 600, mb: 0.5 }}>
        Empanelment Data
      </Typography>
      <Divider sx={{ mb: 3 }} />
      <Paper
        sx={{
          p: 3,
          maxWidth: "90%",
          height: "80%",
          mx: "auto",
          my: 4,
          boxShadow: 4,
        }}
      >
        <Box sx={{ mb: 3 }}>
          <Tabs
            value={userIp.datatype}
            onChange={handleTabChange}
            textColor="primary"
            indicatorColor="primary"
            sx={{
              "& .MuiTab-root": { fontWeight: 500, fontSize: 16, minWidth: 120 },
            }}
          >
            <Tab label="Active" value="Active" />
            <Tab label="Archive" value="Archive" />
          </Tabs>
        </Box>

        {userIp.datatype && (
          <Stack direction="row" spacing={2} alignItems="center" sx={{ mb: 3 }}>
            <TextField
              select
              label="Type"
              value={userIp.type}
              onChange={(e) => handleSelectType(e.target.value)}
              sx={{ minWidth: 200 }}
              size="small"
              InputLabelProps={{ shrink: true }}
            >
              <MenuItem disabled value="">-- Select Type --</MenuItem>
              <MenuItem value="IA">IA</MenuItem>
              <MenuItem value="SA">SA</MenuItem>
            </TextField>

            {/* Show EMPANELMENT SUB TYPE dropdown if Type is selected and there are subtypes */}
            {userIp.type && availableSubTypes.length > 0 && (
              <TextField
                select
                label="Empanelment Sub Type"
                value={userIp.subType}
                onChange={(e) => handleSelectSubType(e.target.value)}
                sx={{ minWidth: 220 }}
                size="small"
                InputLabelProps={{ shrink: true }}
              >
                <MenuItem value="">-- All Sub Types --</MenuItem>
                {availableSubTypes.map((option) => (
                  <MenuItem key={option} value={option}>
                    {option}
                  </MenuItem>
                ))}
              </TextField>
            )}
          </Stack>
        )}

        {userIp.type !== "" && (
          <Box sx={{ width: "100%", mt: 2 }}>
            <Button
              onClick={handleDownload}
              variant="contained"
              sx={{
                mb: 2,
                ml: "auto",
                display: "block",
                fontWeight: 600,
                px: 3,
                borderRadius: 2,
              }}
            >
              Download
            </Button>
            <Paper
              elevation={2}
              sx={{
                borderRadius: 2,
                overflow: "hidden",
                minHeight: 420,
                background: "#f9f9f9",
              }}
            >
              <DataGrid
                rows={filteredRows}
                columns={columns}
                getRowId={(row) => row.FRN}
                pageSizeOptions={[5, 10, 20, 50]}
                initialState={{
                  pagination: { paginationModel: { pageSize: 10 } },
                }}
                disableRowSelectionOnClick
                slots={{
                  toolbar: () => (
                    <Box sx={{ display: "flex", justifyContent: "flex-end", width: "100%" }}>
                      <GridToolbar />
                    </Box>
                  ),
                }}
                sx={{
                  border: "none",
                  "& .MuiDataGrid-columnHeaders": {
                    background: "#e3e7ef",
                    fontWeight: 600,
                    fontSize: 15,
                  },
                  "& .MuiDataGrid-row": {
                    background: "#fff",
                  },
                  "& .MuiDataGrid-footerContainer": {
                    background: "#fafafa",
                  },
                }}
                autoHeight
              />
            </Paper>
          </Box>
        )}
      </Paper>
    </>
  );
};

export default ViewActiveAuditor;