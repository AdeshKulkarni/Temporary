Replace your handleAsyncApprovalError method with this block. It dynamically calculates the delay (5, 10, 20, 40 minutes) based on how many times the batch has already failed, and safely pushes the SCHEDULED_TIME into the future so your 1-minute VoucherExecutionScheduler naturally ignores it until the right moment.
```java
    private void handleAsyncApprovalError(String batchId, String executorId, RequestStatus actionStatus, String msg) {
        
        // 1. Check if this batch is handled by the Auto-Scheduler
        String scheduleFlag = "NO";
        try {
            scheduleFlag = jdbcTemplate.queryForObject(
                "SELECT IS_EXECUTION_SCHEDULED FROM VOUCHER_POSTING WHERE BATCH_ID = ?", 
                String.class, batchId
            );
        } catch (Exception ignored) {}

        String finalMsg;

        // 2. Route the Status correctly with Exponential Backoff
        if ("YES".equalsIgnoreCase(scheduleFlag)) {
            
            // A. Find out how many times it has already failed
            int retryCount = 0;
            try {
                retryCount = jdbcTemplate.queryForObject(
                    "SELECT RETRY_COUNT FROM SCHEDULED_BATCH_RETRY WHERE BATCH_ID = ?", 
                    Integer.class, batchId
                );
            } catch (Exception ignored) {}

            // B. Exponential Backoff Logic
            int delayMinutes = 5;  // Default for Attempt 1
            if (retryCount == 2) delayMinutes = 10;
            else if (retryCount == 3) delayMinutes = 20;
            else if (retryCount >= 4) delayMinutes = 40;

            // C. Push the SCHEDULED_TIME into the future so the 1-minute scheduler ignores it until then
            jdbcTemplate.update(
                "UPDATE VOUCHER_POSTING SET BATCH_STATUS = 'Q', SCHEDULED_TIME = SYSTIMESTAMP + NUMTODSINTERVAL(?, 'MINUTE') WHERE BATCH_ID = ?", 
                delayMinutes, batchId
            );
            
            finalMsg = "System fault. The system will auto-retry in " + delayMinutes + " minutes (Attempt " + Math.max(1, retryCount + 1) + " of 5).";
            
        } else {
            // Immediate manual execution logic remains the same
            jdbcTemplate.update("UPDATE VOUCHER_POSTING SET BATCH_STATUS = 'P' WHERE BATCH_ID = ?", batchId);
            finalMsg = "Execution failed due to system fault. Please click Approve again to retry.";
        }

        progressService.sendProgress(batchId, executorId, 0, "FAILED", finalMsg);

        String vid = null;
        String creatorId = null;

        // 3. Fetch BOTH the VID and the original Creator (Maker)
        try {
            Map<String, Object> batchInfo = jdbcTemplate.queryForMap(
                "SELECT VID_FK, CREATED_BY FROM VOUCHER_POSTING WHERE BATCH_ID = ?", batchId
            );
            vid = (String) batchInfo.get("VID_FK");
            creatorId = (String) batchInfo.get("CREATED_BY");
        } catch (org.springframework.dao.EmptyResultDataAccessException e) {
            log.warn("Batch info not found for Batch: {}", batchId);
        }

        // 4. Log the system failure in the Workflow History
        workflowEngine.logWorkflowAction(batchId, vid, "Execution Failed", "SYSTEM", finalMsg, null);

        String actionName = (actionStatus == RequestStatus.ACCEPTED) ? "approve" : "reject";
        
        try {
            // 5A. Notify the Checker
            String checkerMsg = String.format("SYSTEM ERROR: Failed to %s Journal Batch '%s'. %s", actionName, batchId, finalMsg);
            notificationWriterService.createNotification(executorId, null, checkerMsg, "/voucher-view/" + batchId, batchId, "VoucherService");
            
            // 5B. Notify the Maker
            if (creatorId != null && !creatorId.equalsIgnoreCase(executorId)) {
                String makerMsg = String.format("SYSTEM ERROR: Final execution failed for your Batch '%s'. %s", batchId, finalMsg);
                notificationWriterService.createNotification(creatorId, null, makerMsg, "/voucher-view/" + batchId, batchId, "VoucherService");
            }
        } catch (Exception e) {
            log.warn("NOTIFICATION_WARN | Batch: {} | Could not send failure notifications", batchId);
        }
    }

