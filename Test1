useEffect(() => {
    // 1. Establish the connection to your existing notification system
    const handleVidUpdate = (updatedVid) => {
      // If the VID that just changed is one we have in our list, refresh the grid
      if (voucherList.some(v => v.vid === updatedVid)) {
        showSnackBar(`VID ${updatedVid} has just been taken. Refreshing list...`, "info");
        
        // RE-FETCH the fresh list
        callApi(`/JS/voucher/active?roleId=${currentRoleId}`, null, "GET")
          .then(res => setVoucherList(res.data || res || []));
      }
    };

    // 2. Subscribe to the channel (assuming your existing socket/pub-sub setup)
    // You can hook this into your existing notification subscription logic
    window.addEventListener("VID_UPDATE_EVENT", (e) => handleVidUpdate(e.detail));

    return () => {
      window.removeEventListener("VID_UPDATE_EVENT", handleVidUpdate);
    };
  }, [voucherList, currentRoleId, callApi, showSnackBar]);
