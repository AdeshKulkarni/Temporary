const fetchData = async () => {
  try {
    const response = await axios.post(
      "Server/IAMServices/EmailTemplate",
      {},
      {
        headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
      }
    );

    const fullHtml = response.data.result;
    
    // Define the exact delimiter we are looking for.
    // Using a more specific delimiter is safer.
    const delimiter = "</h4>";
    const splitIndex = fullHtml.indexOf(delimiter);

    // Check if the delimiter was found in the response
    if (splitIndex !== -1) {
      // The header includes the delimiter itself.
      const headerHtml = fullHtml.substring(0, splitIndex + delimiter.length);
      
      // The body is everything after the delimiter.
      const bodyHtml = fullHtml.substring(splitIndex + delimiter.length);
      
      setHeaderContent(headerHtml);
      setBodyContent(bodyHtml);
      
      // Also, update the word count after fetching
      setWordCount(countWord(fullHtml));

    } else {
      // Fallback behavior: if the delimiter isn't found, treat the
      // entire response as the header and leave the body empty.
      console.error("Could not find the '</h4>' delimiter in the template.");
      setHeaderContent(fullHtml);
      setBodyContent("");
      setWordCount(countWord(fullHtml));
    }
  } catch (e) {
    console.error("Failed to fetch email template:", e);
    // You might want to set an error state here for the user
    setSbar({ isOpen: true, Msg: "❌ Failed to load the email template." });
  }
};

// The useEffect hook that calls fetchData is correct and does not need to be changed.
useEffect(() => {
  fetchData();
}, []); // The empty dependency array [] ensures this runs only once on component mount.