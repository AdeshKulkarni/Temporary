/**
 * Function to add element at specific index.
 * @param {*} arr
 * @param {*} index
 * @param {*} element
 * @returns copy of that array with updated indexes
 *
 * @author: V1010939
 */
function insertAtIndex(arr, index, element) {
  if (index < 0 || index > arr.length) {
    throw new Error("Invalid index");
  }
  arr.splice(index, 0, element);
  return arr;
}

