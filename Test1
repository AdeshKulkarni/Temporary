CREATE TABLE MASTER_MOC (
    MOC_ID          NUMBER PRIMARY KEY, -- Added a simple PK for easier updates/deletes
    TMMOC_PDATE     DATE,
    TMMOC_BRANCH    VARCHAR2(50 BYTE),
    CURRENCY        VARCHAR2(3 BYTE),
    TMMOC_CGL       VARCHAR2(50 BYTE),
    TMMOC_AMT       NUMBER,
    TXN_TYPE        VARCHAR2(20 BYTE),
    PRODUCT_TYPE    VARCHAR2(20 BYTE),
    REMARKS         VARCHAR2(40 BYTE),
    AR_FLAG         VARCHAR2(1 BYTE)
);

-- Sequence for the primary key
CREATE SEQUENCE MASTER_MOC_SEQ START WITH 1 INCREMENT BY 1;
