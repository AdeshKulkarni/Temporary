package com.tcs.fincore.CommonRequestService.service.strategy;

import org.springframework.stereotype.Component;
import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.tcs.fincore.CommonRequestService.dto.TMMocDto;
import com.tcs.fincore.CommonRequestService.exception.ResourceNotFoundException;
import com.tcs.fincore.CommonRequestService.model.CommonReq;
import com.tcs.fincore.CommonRequestService.model.Moc;
import com.tcs.fincore.CommonRequestService.model.TMMoc;
import com.tcs.fincore.CommonRequestService.model.enums.RequestType;
import com.tcs.fincore.CommonRequestService.repository.MocRepository;
import com.tcs.fincore.CommonRequestService.repository.TMMocRepository;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import java.time.ZoneId;

@Component
@RequiredArgsConstructor
@Slf4j
public class MocStrategy implements RequestTypeStrategy {

    private final TMMocRepository tmMoRepository;
    private final MocRepository mocRepository;
    private final ObjectMapper objectMapper;

    @Override
    public RequestType getRequestType() {
        return RequestType.MOC;
    }

    @Override
    public void processApproval(CommonReq request) throws JsonProcessingException {
        // The CommonReq 'request' object is a placeholder. 
        // We use its ID to find the actual TMMoc request.
        Long tmMoRequestId = request.getId();
        
        log.info("MOC Strategy: Processing approval for placeholder request ID {}. Looking for TMMoc request.", tmMoRequestId);

        TMMoc mocRequest = tmMoRepository.findById(tmMoRequestId)
                .orElseThrow(() -> new ResourceNotFoundException("Moc request with ID " + tmMoRequestId + " not found in temporary table."));

        switch (request.getChangeType()) {
            case ADD:
            case UPDATE: // For MOC, ADD and UPDATE might have the same logic: insert into master table.
                handleAddOrUpdate(mocRequest);
                break;
            case DELETE:
                // Implement delete logic if applicable, e.g., marking a record as inactive.
                // handleDelete(mocRequest);
                break;
            default:
                throw new UnsupportedOperationException("Change type " + request.getChangeType() + " is not supported for MOC.");
        }
    }

    private void handleAddOrUpdate(TMMoc mocRequest) throws JsonProcessingException {
        log.info("Moving MOC request ID {} to master table FIN_MOC.", mocRequest.getId());
        
        // Deserialize the payload from the temp table to map it
        TMMocDto payloadDto = objectMapper.readValue(mocRequest.getPayload(), TMMocDto.class);

        Moc masterMoc = new Moc();
        // Map fields from the temporary request or its payload to the final master entity
        masterMoc.setTmmocPdate(payloadDto.getTmmocPdate().toInstant().atZone(ZoneId.systemDefault()).toLocalDate());
        masterMoc.setTmmocBranch(payloadDto.getTmmocBranch());
        masterMoc.setCurrency(payloadDto.getCurrency());
        masterMoc.setTmmocCgl(payloadDto.getTmmocCgl());
        masterMoc.setTmmocAmt(payloadDto.getTmmocAmt());
        masterMoc.setTxnType(payloadDto.getTxnType());
        masterMoc.setProductType(payloadDto.getProductType());
        masterMoc.setRemarks(payloadDto.getRemarks());
        masterMoc.setArFlag(mocRequest.getArFlag()); // Assuming arFlag is on the main temp object

        mocRepository.save(masterMoc);
        log.info("Successfully saved MOC record to FIN_MOC master table.");
    }
}
