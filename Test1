public void streamBatchExcel(String batchId, java.io.OutputStream outputStream) throws java.io.IOException {
    // 1. Use SXSSFWorkbook for memory efficiency
    try (org.apache.poi.xssf.streaming.SXSSFWorkbook workbook = new org.apache.poi.xssf.streaming.SXSSFWorkbook(100)) {
        org.apache.poi.ss.usermodel.Sheet sheet = workbook.createSheet("Batch Details");
        
        // Header
        String[] headers = {"Branch", "Currency", "CGL", "Amount", "Type", "Remarks", "Product Code"};
        org.apache.poi.ss.usermodel.Row headerRow = sheet.createRow(0);
        for (int i = 0; i < headers.length; i++) headerRow.createCell(i).setCellValue(headers[i]);

        // 2. Stream directly from the Database (Don't load all into a List first!)
        String sql = "SELECT BRANCH_CODE, CURRENCY, CGL, AMOUNT, NARRATION, PRODUCT_CODE FROM JOURNAL_REQUEST WHERE BATCH_ID = ?";
        
        int[] rowIdx = {1}; // Counter for rows
        jdbcTemplate.query(sql, rs -> {
            org.apache.poi.ss.usermodel.Row row = sheet.createRow(rowIdx[0]++);
            row.createCell(0).setCellValue(rs.getString("BRANCH_CODE"));
            row.createCell(1).setCellValue(rs.getString("CURRENCY"));
            row.createCell(2).setCellValue(rs.getString("CGL"));
            
            BigDecimal amt = rs.getBigDecimal("AMOUNT");
            if (amt != null) {
                row.createCell(3).setCellValue(amt.abs().doubleValue());
                row.createCell(4).setCellValue(amt.compareTo(BigDecimal.ZERO) < 0 ? "Credit" : "Debit");
            }
            row.createCell(5).setCellValue(rs.getString("NARRATION"));
            row.createCell(6).setCellValue(rs.getString("PRODUCT_CODE"));
        }, batchId);

        workbook.write(outputStream);
        workbook.dispose();
    }
}
