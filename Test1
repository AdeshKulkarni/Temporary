// --- Custom Blot for Draggable Tags with Remove Button ---
const Inline = Quill.import("blots/inline");
class DraggableTagBlot extends Inline {
  static create(value) {
    const node = super.create();
    // The tag itself
    node.setAttribute("style", "background-color: #0c476e; color: white; padding: 2px 4px; border-radius: 3px; font-weight: bold;");
    node.dataset.value = value;
    node.innerText = value;
    node.classList.add('draggable-tag'); // Add a class for CSS styling

    // The remove button ('x')
    const removeButton = document.createElement('span');
    removeButton.innerText = 'x';
    removeButton.classList.add('remove-tag-button');
    // This click handler will be attached in the component
    removeButton.setAttribute('data-tag-value', value); 
    
    node.appendChild(removeButton);

    return node;
  }

  static formats(domNode) {
    return domNode.dataset.value;
  }

  // When formatting, ensure the text is updated correctly
  format(name, value) {
    if (name === 'draggable-tag' && value) {
      this.domNode.dataset.value = value;
      this.domNode.firstChild.textContent = value;
    } else {
      super.format(name, value);
    }
  }
}
DraggableTagBlot.blotName = "draggable-tag";
DraggableTagBlot.tagName = "span";
Quill.register(DraggableTagBlot);

const iv = crypto.getRandomValues(new Uint8Array(12));
const ivBase64 = btoa(String.fromCharCode.apply(null, iv));
const salt = crypto.getRandomValues(new Uint8Array(16));
const saltBase64 = btoa(String.fromCharCode.apply(null, salt));

const EmailTemplate = () => {
  const [headerContent, setHeaderContent] = useState("Non-editable header will appear here");
  const [bodyContent, setBodyContent] = useState("Editable body will appear here");
  const [sbar, setSbar] = useState({ isOpen: false, Msg: "" });
  const [wordCount, setWordCount] = useState(0);
  const [isEditing, setIsEditing] = useState(false);
  const [isPreviewing, setIsPreviewing] = useState(false);
  const [templateContent, settemplateContent] = useState(null);

  const draftVar = [
    "{{DATE}}", "{{REF_NO}}", "{{FIRM_NAME}}", "{{FRN_NO}}", "{{FIRM_ADDR}}", "{{ASSIGNMENT_TYPE}}", "{{GSTN}}",
  ];

  const bodyEditorRef = useRef(null);
  const headerEditorRef = useRef(null);
  
  // --- Attach click handlers for the 'x' button ---
  useEffect(() => {
    if (!bodyEditorRef.current) return;

    const editor = bodyEditorRef.current.getEditor();
    const root = editor.root;

    const handleClick = (e) => {
      const target = e.target;
      if (target.classList.contains('remove-tag-button')) {
        const blot = Quill.find(target.parentNode);
        if (blot instanceof DraggableTagBlot) {
          const blotOffset = editor.getIndex(blot);
          editor.deleteText(blotOffset, blot.length(), Quill.sources.USER);
        }
      }
    };

    root.addEventListener('click', handleClick);

    return () => {
      root.removeEventListener('click', handleClick);
    };
  }, [bodyEditorRef.current]);


  const modules = {
    toolbar: [
        [{ font: Font.whitelist }],
        [{ size: ["8px", "10px", "12px", "14px", "16px", "18px", "20px", "22px", "24px", "26px"] }],
        [{ color: ["red", "green", "blue", "black", "orange"] }, { background: ["red", "green", "blue", "yellow", "gray"] }],
        [{ align: "justify" }, { align: "center" }, { align: "right" }],
        [{ script: "sub" }, { script: "super" }],
        [{ header: [1, 2, 3, false] }],
        [{ list: "ordered" }, { list: "bullet" }],
        ["bold", "italic", "underline", "strike"],
        ["link", "image", "clean"],
        [{ indent: "-1" }, { indent: "+1" }],
    ],
    clipboard: { matchVisual: false },
    imageResize: { modules: ["Resize", "DisplaySize"] },
  };

  useEffect(() => {
    fetchData();
  }, []);

  const fetchData = async () => {
    try {
      const response = await axios.post("Server/IAMServices/EmailTemplate", {}, {
        headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
      });
      let res = response.data.result;
      let str = "EMPANELMENT OF THE FIRM INTIMATION</h4>";
      const splitIndex = res.indexOf(str) + str.length;

      if (splitIndex > str.length - 1) {
        setHeaderContent(res.substring(0, splitIndex));
        setBodyContent(res.substring(splitIndex));
      } else {
        setHeaderContent(res);
        setBodyContent("");
      }
      setWordCount(countWord(res));
    } catch (e) {
      console.log(e);
    }
  };

  function countWord(str) {
    const text = str.replace(/<[^>]*>/g, "");
    const words = text.trim().split(/\s+/).filter(Boolean);
    return words.length;
  }

  const handleBodyChange = (content, delta, source, editor) => {
    if (source === "api") return;
    let htmlContent = editor.getHTML();
    let length = countWord(htmlContent);
    
    const insertedOp = delta.ops?.find((op) => typeof op.insert === "string");
    if (insertedOp) {
      const inserted = insertedOp.insert;
      const len = inserted.length;
      const illegalChar = inserted.match(/[^a-zA-Z0-9_\s.,;!?'"()\{\}\-@]/);
      if (illegalChar) {
        setTimeout(() => {
          const quillEditor = bodyEditorRef.current?.getEditor();
          if (quillEditor) {
            const selection = quillEditor.getSelection();
            let position = selection?.index || quillEditor.getLength();
            quillEditor.deleteText(position - len, len, "silent");
          }
        }, 10);
        setSbar({ isOpen: true, Msg: "❌ Special characters are not allowed!" });
      }
    }

    if (length > 2000) {
      const quillEditor = bodyEditorRef.current?.getEditor();
      if (quillEditor) {
        const selection = quillEditor.getSelection();
        let position = selection?.index || quillEditor.getLength();
        quillEditor.deleteText(position - 1, 1, "silent");
        setSbar({ isOpen: true, Msg: "Word limit exceeded. Please reduce content." });
        return;
      }
    }

    setBodyContent(htmlContent);
    setWordCount(length);
  };

  const handleDragStart = (e) => {
    const text = e.target.innerText;
    e.dataTransfer.setData("text/plain", text);
  };

  const handleDrop = (e) => {
    e.preventDefault();
    if (!isEditing) return;
    const editor = bodyEditorRef.current?.getEditor();
    if (!editor) return;

    const text = e.dataTransfer.getData("text/plain");
    const range = editor.getSelection(true);
    if (range) {
      editor.insertEmbed(range.index, 'draggable-tag', text, Quill.sources.USER);
      editor.setSelection(range.index + 1, Quill.sources.SILENT);
    }
  };

  // --- Helper to clean content for save/preview ---
  const getProcessedBodyContent = (isForPreview = false) => {
    const tempDiv = document.createElement('div');
    tempDiv.innerHTML = bodyContent;

    tempDiv.querySelectorAll('span.draggable-tag').forEach(span => {
        // For preview, keep the styled tag but remove the 'x' button
        if (isForPreview) {
            const removeBtn = span.querySelector('.remove-tag-button');
            if (removeBtn) removeBtn.remove();
        } else {
            // For saving, replace the entire tag with its text value
            span.replaceWith(document.createTextNode(span.dataset.value));
        }
    });

    return tempDiv.innerHTML;
  }

  const handleSave = async () => {
    setIsEditing(false);
    const processedBodyContent = getProcessedBodyContent(false);

    let i = processedBodyContent.search(/<[\w-_=\\":;\s]+><br><\/[\w]+>/g);
    let fullContent = (i === 0) 
        ? headerContent + processedBodyContent
        : headerContent + "<p><br/></p>" + processedBodyContent;

    let str = fullContent.match(/\{{2}[A-Z_]+\}{2}/g);
    let checked = str?.filter((w) => draftVar.some((s) => s === w));

    if (str != null && str.length > checked.length) {
      setSbar({ isOpen: true, Msg: "Invalid Variable Names added! Please use only allowed variables." });
      handleCloseDialog();
      return;
    }

    let dataToSend = { MASTER_TEMPLATE: `<html>${fullContent}</html>` };
    try {
      let jsonFormData = JSON.stringify(dataToSend);
      await encrypt(iv, salt, jsonFormData).then(function (result) {
        jsonFormData = result;
      });
      let payload = { iv: ivBase64, salt: saltBase64, data: jsonFormData };
      const response = await axios.post("Server/IAMServices/saveMasterTemplate", payload, {
        headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
      });
      if (response.data.statusCode === 200 && response.data.result !== "") {
        console.log("Saved successfully!");
        setSbar({ isOpen: true, Msg: "Saved Successfully!" });
      }
    } catch (error) {
      console.error("Error saving template:", error);
      setSbar({ isOpen: true, Msg: "Error saving template." });
    }
    setIsPreviewing(false);
    handleCloseDialog();
  };

  const handlePreview = async () => {
    const processedBodyContent = getProcessedBodyContent(true);

    let i = processedBodyContent.search(/<[\w-_=\\":;\s]+><br><\/[\w]+>/g);
    let fullContent = (i === 0)
        ? headerContent + processedBodyContent
        : headerContent + "<p><br/></p>" + processedBodyContent;

    let data = {
      DATE: "xx/xx/xxxx", REF_NO: "9999xxx", FIRM_NAME: "xxxxxxxxxx", FRN_NO: "999999999",
      GSTN: "99xx99xx", FIRM_ADDR: "xxxxxxxx,xxxxxxxx", ASSIGNMENT_TYPE: "xxxxxxx",
    };

    let str = fullContent.replace(/<br\s*\/?>/gi, "<br></br>");
    let StrToSend = str.replace(/\{{2}([A-Z_]+)\}{2}/g, (match, p1) => data[p1] || match);

    settemplateContent(StrToSend);
    setIsPreviewing(true);
  };

  const handleCloseDialog = () => setIsPreviewing(false);

  const handleReset = async () => {
    try {
      const response = await axios.post("Server/IAMServices/resetTemplate", {}, {
        headers: { Authorization: `Bearer ${localStorage.getItem("token")}` },
      });
      let res = response.data.result;
      const splitIndex = res.indexOf("Dear Sir/Madam");
      if (splitIndex !== -1) {
        setHeaderContent(res.substring(0, splitIndex));
        setBodyContent(res.substring(splitIndex));
      } else {
        setHeaderContent(res);
        setBodyContent("");
      }
    } catch (e) {
      console.error("Error resetting template:", e);
    }
  };

  const handleHeaderCopy = (e) => {
    e.preventDefault();
    setSbar({ isOpen: true, Msg: "❌ Copying from non-editable section is not allowed!" });
  };

  return (
    <>
      <Typography gutterBottom variant="h5" component="div">Empanelment Intimation Letter Template</Typography>
      <Divider />
      <Grid container spacing={2} sx={{ p: 2 }}>
        <Grid item xs={14} md={4}>
          <Box sx={{ height: "100%", width: "100%", borderRadius: 2, boxShadow: 2 }}>
            <Paper sx={{ height: "48%", mb: "30px", p: 1 }}>
              <Typography variant="h6">Drag Required Variables</Typography>
              <hr />
              {draftVar.map((label) => (
                <span key={label} draggable={isEditing} onDragStart={handleDragStart}
                  style={{
                    margin: 10, backgroundColor: "#0c476e", padding: "5px 8px", cursor: "move",
                    borderRadius: "3px", color: "white", fontWeight: "bold",
                    boxShadow: "0 4px 8px rgba(0, 0, 0, 0.2)", display: "inline-block",
                  }}>
                  {label}
                </span>
              ))}
            </Paper>
            <Paper sx={{ height: "48%", p: 1 }}>
              <Typography variant="h6">Instructions</Typography>
              <hr />
              <Container>
                <ul>
                  <li>Special characters are not allowed</li>
                  <li>Only use allowed variables from the list</li>
                  <li>Header section is non-editable</li>
                  <li>Body section is editable when in edit mode</li>
                  <li>Word limit: 2000 words</li>
                </ul>
              </Container>
            </Paper>
          </Box>
        </Grid>
        <Grid item xs={12} md={8}>
          <Box sx={{ width: "100%", bgcolor: "background.default", borderRadius: 2, boxShadow: 2 }}>
            <Typography variant="h6" sx={{p:1}}>Draft</Typography>
            <hr />
            <Paper sx={{ padding: 2 }}>
              <Typography variant="subtitle2" sx={{ mb: 1, color: "#666" }}>Non-editable Header</Typography>
              <Box sx={{ bgcolor: "#f5f5f5", p: 1, mb: 1, border: "1px solid #e0e0e0", borderRadius: "4px" }} onCopy={handleHeaderCopy}>
                <ReactQuill style={{ height: "26vh" }} theme="bubble" value={headerContent} ref={headerEditorRef} readOnly={true} modules={{ toolbar: false }}
                  formats={[
                    "size", "align", "color", "font", "bold", "italic", "underline", "strike",
                    "list", "bullet", "link", "image", "background", "header", "script", "indent",
                  ]}/>
              </Box>

              <Typography variant="subtitle2" sx={{ mb: 1 }}>Editable Body</Typography>
              <div onDragOver={(e) => e.preventDefault()} onDrop={handleDrop}>
                <ReactQuill theme="snow" style={{ height: "25vh" }} modules={modules} value={bodyContent} ref={bodyEditorRef}
                  onChange={handleBodyChange} readOnly={!isEditing}
                  formats={[
                    "size", "align", "color", "font", "bold", "italic", "underline", "strike",
                    "list", "bullet", "link", "image", "background", "header", "script", "indent",
                    "draggable-tag", // Register custom format
                  ]}/>
              </div>

              <Typography variant="body2" color="textSecondary" sx={{ mt: 10, textAlign: "left" }}>
                Word Count: {wordCount} / 2000
              </Typography>

              <Box sx={{ textAlign: "right" }}>
                {!isEditing ? (
                  <Button variant="contained" color="primary" onClick={() => setIsEditing(true)} sx={{ mr: 1 }}>Edit</Button>
                ) : (
                  <Button variant="contained" color="error" onClick={() => setIsEditing(false)} sx={{ mr: 1 }}>Cancel</Button>
                )}
                <Button variant="contained" color="info" onClick={handlePreview} sx={{ mr: 1 }}>Preview</Button>
                <Button variant="contained" color="info" onClick={handleReset}>Reset Template</Button>
              </Box>
            </Paper>
          </Box>
        </Grid>
      </Grid>
      
      <Dialogue open={isPreviewing} close={handleCloseDialog} save={handleSave} content={templateContent} />

      <Snackbar open={sbar.isOpen} autoHideDuration={6000} onClose={() => setSbar({ isOpen: false, Msg: "" })} message={sbar.Msg} />
    </>
  );
};

const BootstrapDialog = styled(Dialog)(({ theme }) => ({
  "& .MuiDialogContent-root": { padding: theme.spacing(2) },
  "& .MuiDialogActions-root": { padding: theme.spacing(1) },
}));

const Dialogue = ({ open, close, save, content }) => {
  return (
    <BootstrapDialog onClose={close} aria-labelledby="customized-dialog-title" open={open} fullWidth maxWidth="md">
      <DialogTitle sx={{ m: 0, p: 2 }} id="customized-dialog-title">Intimation letter draft preview</DialogTitle>
      <IconButton aria-label="close" onClick={close}
        sx={(theme) => ({ position: "absolute", right: 8, top: 8, color: theme.palette.grey[500] })}>
        <CloseIcon />
      </IconButton>
      <DialogContent dividers>
        <div style={{
            width: "210mm", height: "297mm", margin: "0 auto", padding: "20mm",
            boxShadow: "0 0 10px rgba(0, 0, 0, 0.1)", boxSizing: "border-box",
            backgroundColor: "#ffffff", border: "1px solid #ddd", overflow: "auto", overflowWrap: "break-word",
          }}
          dangerouslySetInnerHTML={{ __html: content }}
        ></div>
      </DialogContent>
      <DialogActions>
        <Button autoFocus onClick={save}>Save Draft</Button>
      </DialogActions>
    </BootstrapDialog>
  );
};

export default EmailTemplate;
/* Styling for the draggable tag */
.ql-editor .draggable-tag {
  position: relative;
  display: inline-block;
  vertical-align: middle;
  margin-right: 4px;
}

/* Hide the remove button by default */
.ql-editor .draggable-tag .remove-tag-button {
  display: none;
  position: absolute;
  right: 1px;
  top: -2px;
  cursor: pointer;
  font-size: 14px;
  font-weight: bold;
  color: #ffbaba;
  padding: 0 4px;
  background-color: #0c476e;
  border-radius: 50%;
  line-height: 1;
}

/* Show the remove button on hover */
.ql-editor .draggable-tag:hover .remove-tag-button {
  display: inline;
}

