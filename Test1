package com.fincore.VoucherService.Service.external;

import com.fincore.VoucherService.Dto.HdfsSyncDto;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.dao.DataAccessException;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Service;

import java.util.ArrayList;
import java.util.List;

/**
 * Service responsible for synchronizing aggregated GL balances to the HDFS Data Lake.
 * Bypasses Hive JDBC fake batching by constructing a single massive execution plan.
 */
@Service
@RequiredArgsConstructor
@Slf4j
public class HdfsSyncService {

    @Autowired
    @Qualifier("hiveJdbcTemplate")
    private JdbcTemplate hiveJdbcTemplate;

    public void syncToDataLake(List<HdfsSyncDto> data) {
        if (data == null || data.isEmpty()) return;

        log.info("HDFS_SYNC_START | Target: Hive Data Lake | RecordCount: {}", data.size());
        long startTime = System.currentTimeMillis();

        // We process in chunks of 500 to avoid exceeding Spark's maximum query string length limit,
        // while still forcing it to process 500 rows in a single 1-second job.
        int chunkSize = 500;

        try {
            for (int i = 0; i < data.size(); i += chunkSize) {
                int end = Math.min(data.size(), i + chunkSize);
                List<HdfsSyncDto> chunk = data.subList(i, end);

                // 1. BUILD A SINGLE MASSIVE "UNION ALL" SOURCE TABLE IN MEMORY
                StringBuilder usingClause = new StringBuilder("USING (");
                List<Object> parameters = new ArrayList<>();

                for (int j = 0; j < chunk.size(); j++) {
                    HdfsSyncDto dto = chunk.get(j);
                    // Match Python logic: concat(col("BRANCH_CODE"), col("CURRENCY"), col("CGL"))
                    String glccKey = dto.getBranch() + dto.getCurrency() + dto.getCgl();

                    if (j > 0) {
                        usingClause.append(" UNION ALL ");
                    }

                    // First row defines the column aliases. We cast exactly as your Python script did.
                    if (j == 0) {
                        usingClause.append("SELECT ? AS glcc, cast(? AS date) AS BALANCE_DATE, CAST(? AS DECIMAL(25,4)) AS BALANCE, CAST(? AS DECIMAL(25,4)) AS INR_BALANCE");
                    } else {
                        usingClause.append("SELECT ?, cast(? AS date), CAST(? AS DECIMAL(25,4)), CAST(? AS DECIMAL(25,4))");
                    }

                    parameters.add(glccKey);
                    parameters.add(dto.getBalanceDate().toString());
                    parameters.add(dto.getNewBalance());
                    parameters.add(dto.getNewInrBalance());
                }
                usingClause.append(") AS source ");

                // 2. CONSTRUCT THE FINAL MERGE STATEMENT (Executes exactly ONCE per chunk)
                String mergeSql = "MERGE INTO fincoredatalakevoucher.gl_balance AS target " +
                        usingClause.toString() +
                        "ON target.glcc = source.glcc AND target.BALANCE_DATE = source.BALANCE_DATE " +
                        "WHEN MATCHED THEN " +
                        "  UPDATE SET target.BALANCE = source.BALANCE, target.INR_BALANCE = source.INR_BALANCE " +
                        "WHEN NOT MATCHED THEN " +
                        "  INSERT (glcc, BALANCE_DATE, BALANCE, INR_BALANCE) " +
                        "  VALUES (source.glcc, source.BALANCE_DATE, source.BALANCE, source.INR_BALANCE)";

                // 3. SEND TO SPARK/HIVE
                // This sends 500 records instantly in one highly optimized query plan.
                hiveJdbcTemplate.update(mergeSql, parameters.toArray());

                log.info("HDFS_SYNC_CHUNK_DONE | Processed {} to {} out of {}", i, end, data.size());
            }

            log.info("HDFS_SYNC_SUCCESS | Total Duration: {}ms | Total Records: {}",
                    (System.currentTimeMillis() - startTime), data.size());

        } catch (DataAccessException e) {
            Throwable rootCause = e.getRootCause();
            String exactSparkError = (rootCause != null) ? rootCause.getMessage() : e.getMessage();
            log.error("HDFS_SYNC_DB_FAIL | Spark Error Details: {}", exactSparkError);
            throw e;
        }
    }
}


