// EmailTemplate.js
import { useState, useEffect, useRef } from "react";
import {
  Snackbar,
  IconButton,
  Divider,
  Dialog,
  DialogTitle,
  DialogContent,
  Button,
  Box,
  Paper,
  Typography,
  Grid,
  Container,
  DialogActions,
} from "@mui/material";
import CloseIcon from "@mui/icons-material/Close";
import ReactQuill from "react-quill";
import Quill from "quill";
import "react-quill/dist/quill.snow.css";
import { encrypt } from "../../Security/AES-GCM256";
import axios from "axios";
import PdfViewer from "../../PdfViewer/pdfViewer";
import { styled } from "@mui/system";

var DirectionAttribute = Quill.import("attributors/attribute/direction");
Quill.register(DirectionAttribute, true);
var AlignClass = Quill.import("attributors/class/align");
Quill.register(AlignClass, true);
var BackgroundClass = Quill.import("attributors/class/background");
Quill.register(BackgroundClass, true);
var ColorClass = Quill.import("attributors/class/color");
Quill.register(ColorClass, true);
var DirectionClass = Quill.import("attributors/class/direction");
Quill.register(DirectionClass, true);
var FontClass = Quill.import("attributors/class/font");
Quill.register(FontClass, true);
var SizeClass = Quill.import("attributors/class/size");
Quill.register(SizeClass, true);
var AlignStyle = Quill.import("attributors/style/align");
Quill.register(AlignStyle, true);
var BackgroundStyle = Quill.import("attributors/style/background");
Quill.register(BackgroundStyle, true);
var ColorStyle = Quill.import("attributors/style/color");
Quill.register(ColorStyle, true);
var DirectionStyle = Quill.import("attributors/style/direction");
Quill.register(DirectionStyle, true);
var FontStyle = Quill.import("attributors/style/font");
Quill.register(FontStyle, true);
var SizeStyle = Quill.import("attributors/style/size");
Quill.register(SizeStyle, true);

const Size = Quill.import("formats/size");
Size.whitelist = ["small", "large", "huge"];
Quill.register(Size, true);

const iv = crypto.getRandomValues(new Uint8Array(12));
const ivBase64 = btoa(String.fromCharCode.apply(null, iv));
const salt = crypto.getRandomValues(new Uint8Array(16));
const saltBase64 = btoa(String.fromCharCode.apply(null, salt));

const EmailTemplate = () => {
  const [value, setValue] = useState("<p>Hey there!</p>");
  const [sbar, setSbar] = useState({ isOpen: false, Msg: "" });
  const [wordCount, setWordCount] = useState(0);
  const editorRef = useRef();
  const [isEditing, setIsEditing] = useState(false);
  const [isPreviewing, setIsPreviewing] = useState(false);
  const [previewContent, setPreviewContent] = useState(false);
  const [base64, setBase64] = useState(null);
  const [templateContent, settemplateContent] = useState(null);
  const [isPreviewingFe, setFe] = useState(false);

  const draftVar = [
    "{{DATE}}",
    "{{REF_NO}}",
    "{{FIRM_NAME}}",
    "{{FRN_NO}}",
    "{{FIRM_ADDR}}",
    "{{ASSIGNMENT_TYPE}}",
    "{{GSTN}}",
  ];

  const quillRef = useRef(null);
  const modules = {
    toolbar: [
      [{ font: ["", "serif", "monospace", "arial"] }],
      [{ size: Size.whitelist }],
      [
        { color: ["red", "green", "blue", "black", "orange"] },
        { background: ["red", "green", "blue", "yellow", "gray"] },
      ],
      [{ align: "justify" }, { align: "center" }, { align: "right" }],
      [{ script: "sub" }, { script: "super" }],
      [{ header: [1, 2, 3, false] }],
      [{ list: "ordered" }, { list: "bullet" }],
      ["bold", "italic", "underline", "strike"],
      ["link", "image", "clean"],
      [{ indent: "-1" }, { indent: "+1" }],
    ],
    clipboard: {
      matchVisual: false,
    },
  };

  useEffect(() => {
    fetchData();
  }, []);

  const fetchData = async () => {
    try {
      const response = await axios.post(
        "Server/IAMServices/EmailTemplate",
        {},
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      let res = response.data.result;
      setValue(res);
      setWordCount(countWord(res));
    } catch (e) {
      console.log(e);
    }
  };

  const countWord = (str) => {
    const text = str.replace(/<[^>]*>/g, " ");
    const words = text.trim().split(/\s+/).filter(Boolean);
    return words.length;
  };

  const handleChange = (content, delta, source, editor) => {
    const htmlContent = editor.getHTML();

    // Remove tags for plain text
    const textContent = htmlContent.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();

    // Check for special characters (excluding {{VAR}})
    const plainText = textContent.replace(/{{[^}]+}}/g, "");
    const hasSpecialChars = /[^a-zA-Z0-9\s.,'"-]/.test(plainText);

    if (hasSpecialChars) {
      setSbar({
        isOpen: true,
        Msg: "Special characters are not allowed except punctuation and variables.",
      });
      return;
    }

    const words = textContent.split(/\s+/).filter(Boolean);
    const wordLength = words.length;

    if (wordLength > 2000) {
      setSbar({ isOpen: true, Msg: "Word limit of 2000 exceeded!" });
      return;
    }

    setWordCount(wordLength);
    setValue(htmlContent);
  };

  const handleDrop = (e) => {
    e.preventDefault();
    var range = editorRef.current.editor?.getSelection(true);
    editorRef.current.editor?.insertText(
      range || 0,
      e.dataTransfer.getData("text")
    );
  };

  const handleSave = async () => {
    setIsEditing(false);
    let str = value.match(/\{{2}[A-Z_]+\}{2}/g);
    let checked = str?.filter((w) => draftVar.some((str) => str === w));
    if (str != null && str.length > checked.length) {
      setSbar({
        isOpen: true,
        Msg: "Invalid Variable Names added!! Ensure no whitespace inside {{}}",
      });
      handleCloseModal();
      return;
    }

    let dataToSend = { MASTER_TEMPLATE: `<html>${value}</html>` };
    try {
      let jsonFormData = JSON.stringify(dataToSend);
      await encrypt(iv, salt, jsonFormData).then((result) => {
        jsonFormData = result;
      });
      const response = await axios.post(
        "Server/IAMServices/saveMasterTemplate",
        {
          iv: ivBase64,
          salt: saltBase64,
          data: jsonFormData,
        },
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      if (response.data.statusCode === 200) {
        console.log("Saved successfully!");
      }
    } catch (error) {
      console.error("Error saving template:", error);
    }

    setSbar({ isOpen: true, Msg: "Saved Successfully!" });
    setIsPreviewing(false);
    handleCloseModal();
  };

  const handlePreview = async () => {
    setIsEditing(false);
    let StrToSend = value.replace(/<br\s*\/?>/gi, "<br></br>");
    settemplateContent(StrToSend);
    let dataToSend = {
      user: { template: `<html><head>${StrToSend}</head></html>` },
      data: {
        DATE: "31/03/2025",
        REF_NO: "1001",
        FIRM_NAME: "TRINITY ENT",
        FRN_NO: "45687",
        GSTN: "27AAHCK850D1ZK",
        FIRM_ADDR: "NAVI MUMBAI, BELPAUR",
        ASSIGNMENT_TYPE: "INTERNAL",
      },
    };
    try {
      let jsonFormData = JSON.stringify(dataToSend);
      await encrypt(iv, salt, jsonFormData).then((result) => {
        jsonFormData = result;
      });
      const response = await axios.post(
        "Server/IAMServices/generateTemplate",
        {
          iv: ivBase64,
          salt: saltBase64,
          data: jsonFormData,
        },
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      if (response.data.statusCode === 200 && response.data.result) {
        setPreviewContent(true);
        setIsPreviewing(true);
        setBase64(response.data.result);
      }
    } catch (error) {
      console.error("Error previewing template:", error);
    }
  };

  const handleCloseModal = () => {
    setIsPreviewing(false);
    setFe(false);
  };

  const handleReset = async () => {
    try {
      const response = await axios.post(
        "Server/IAMServices/resetTemplate",
        {},
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      setValue(response.data.result);
    } catch (e) {
      console.error("Error resetting template:", e);
    }
  };

  return (
    <>
      <Typography gutterBottom variant="h5">
        Empanelment Intimation Letter Template
      </Typography>
      <Divider />
      <Grid container spacing={2} sx={{ p: 2 }}>
        <Grid item xs={12} md={4}>
          <Paper sx={{ p: 2, mb: 2 }}>
            <Typography variant="h6">Drag Required Variables</Typography>
            <hr />
            {draftVar.map((label) => (
              <span
                key={label}
                draggable={isEditing}
                onDragStart={(e) =>
                  e.dataTransfer.setData("text", label)
                }
                style={{
                  margin: 10,
                  backgroundColor: "#0c476e",
                  padding: "10px 15px",
                  cursor: "move",
                  borderRadius: "5px",
                  color: "white",
                  fontWeight: "bold",
                  display: "inline-block",
                }}
              >
                {label}
              </span>
            ))}
          </Paper>
        </Grid>
        <Grid item xs={12} md={8}>
          <Paper sx={{ p: 2 }}>
            <Typography variant="h6">Template Draft</Typography>
            <ReactQuill
              style={{ height: "300px" }}
              theme="snow"
              modules={modules}
              value={value}
              ref={editorRef}
              onDragOver={(e) => e.preventDefault()}
              onDrop={handleDrop}
              onChange={handleChange}
              readOnly={!isEditing}
            />
            <Box mt={2} textAlign="left">
              <Typography variant="body2">
                Word Count: {wordCount} / 2000
              </Typography>
            </Box>
            <Box mt={2} textAlign="right">
              {!isEditing ? (
                <Button onClick={() => setIsEditing(true)} variant="contained">
                  Edit
                </Button>
              ) : (
                <Button
                  onClick={() => setIsEditing(false)}
                  variant="contained"
                  color="error"
                >
                  Cancel
                </Button>
              )}
              <Button onClick={handlePreview} variant="contained" sx={{ ml: 1 }}>
                Preview
              </Button>
              <Button onClick={handleSave} variant="contained" sx={{ ml: 1 }}>
                Save
              </Button>
              <Button onClick={handleReset} variant="contained" sx={{ ml: 1 }}>
                Reset
              </Button>
            </Box>
          </Paper>
        </Grid>
      </Grid>

      {/* PDF Preview Modal */}
      <Dialog open={isPreviewing} onClose={handleCloseModal} maxWidth="xl">
        <DialogTitle>Template Preview</DialogTitle>
        <IconButton
          aria-label="close"
          onClick={handleCloseModal}
          sx={{ position: "absolute", right: 8, top: 8 }}
        >
          <CloseIcon />
        </IconButton>
        <DialogContent dividers>
          {isPreviewingFe ? (
            <div
              className="ql-editor"
              dangerouslySetInnerHTML={{ __html: templateContent }}
              style={{ height: "80vh", overflowY: "auto" }}
            />
          ) : (
            <PdfViewer pdfData={base64} />
          )}
        </DialogContent>
        <DialogActions>
          <Button onClick={handleCloseModal}>Close</Button>
        </DialogActions>
      </Dialog>

      <Snackbar
        open={sbar.isOpen}
        autoHideDuration={5000}
        onClose={() => setSbar({ isOpen: false, Msg: "" })}
        message={sbar.Msg}
      />
    </>
  );
};

export default EmailTemplate;
