import React, { useState, useEffect, useMemo } from "react";
import {
  Divider,
  Typography,
  Box,
  Stack,
  Button,
  Paper,
  MenuItem,
  TextField,
  Tabs,
  Tab,
} from "@mui/material";
import { DataGrid, GridToolbar } from "@mui/x-data-grid";
import { encrypt } from "../../Security/AES-GCM256";
import axios from "axios";
import downloadFile from "../../DownloadFile/DownloadFile";

const iv = crypto.getRandomValues(new Uint8Array(12));
const ivBase64 = btoa(String.fromCharCode.apply(null, iv));
const salt = crypto.getRandomValues(new Uint8Array(16));
const saltBase64 = btoa(String.fromCharCode.apply(null, salt));

const columns = [
  { field: "FRN", headerName: "FRN", width: 200, flex: 1 },
  { field: "FIRM_NAME", headerName: "FIRM NAME", width: 250, flex: 1.5 },
  {
    field: "EMPANELMENT_SUB_TYPE",
    headerName: "EMPANELMENT SUB TYPE",
    width: 300,
    flex: 2,
  },
  { field: "EMPANELED_BY", headerName: "EMPANELED BY", width: 200, flex: 1 },
  { field: "EMPANELED_STATUS", headerName: "EMPANELED STATUS", width: 200, flex: 1 },
  { field: "EMPANELMENT_TYPE", headerName: "EMPANELMENT TYPE", width: 200, flex: 1 },
  { field: "FINANCIAL_YEAR", headerName: "FINANCIAL YEAR", width: 200, flex: 1 },
  { field: "REQUEST_STATUS", headerName: "REQUEST STATUS", width: 200, flex: 1 },
];

const EmpanelmentData = () => {
  const [empanelmentData, setEmpanelmentData] = useState([]);
  const [userIp, setUserIp] = useState({ datatype: "", type: "", subType: "", year: "" });
  const [selectionOptions, setSelectionOptions] = useState({});
  const [isLoading, setIsLoading] = useState(false);

  // Filtered rows for DataGrid
  const filteredRows = useMemo(() => {
    let data = empanelmentData;
    if (userIp.type) {
      data = data.filter((row) => row.EMPANELMENT_TYPE === userIp.type);
    }
    if (userIp.subType) {
      data = data.filter((row) => row.EMPANELMENT_SUB_TYPE === userIp.subType);
    }
    return data;
  }, [empanelmentData, userIp.type, userIp.subType]);

  useEffect(() => {
    fetchOptions();
  }, []);

  useEffect(() => {
    if (userIp.type) {
      fetchData();
    }
  }, [userIp.type, userIp.subType, userIp.datatype]);

  const fetchOptions = async () => {
    try {
      setIsLoading(true);
      const response = await axios.post(
        "Server/IAMServices/getAssignmentType",
        {},
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      
      const result = response.data.result[0] || {};
      const options = {};
      
      Object.keys(result).forEach((type) => {
        options[type] = result[type] 
          ? result[type].split(",").map(item => item.trim()).filter(item => item)
          : [];
      });
      
      setSelectionOptions(options);
    } catch (e) {
      console.error("Error fetching options:", e);
    } finally {
      setIsLoading(false);
    }
  };

  const fetchData = async () => {
    if (!userIp.type) return;
    
    try {
      setIsLoading(true);
      const dataToSend = {
        EMPANELMENT_TYPE: userIp.type,
        EMPANELMENT_SUB_TYPE: userIp.subType,
        YEAR: userIp.year,
        DATA_TYPE: userIp.datatype,
      };
      
      const jsonFormData = JSON.stringify(dataToSend);
      const encryptedData = await encrypt(iv, salt, jsonFormData);
      const payload = {
        iv: ivBase64,
        salt: saltBase64,
        data: encryptedData,
      };
      
      const response = await axios.post(
        "Server/IAMServices/getActiveFRN",
        payload,
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      setEmpanelmentData(response.data.result || []);
    } catch (e) {
      console.error("Fetch Error:", e);
    } finally {
      setIsLoading(false);
    }
  };

  const handleDownload = async () => {
    try {
      setIsLoading(true);
      const dataToSend = {
        data: filteredRows,
        type: userIp.type,
        subType: userIp.subType,
        datatype: userIp.datatype,
      };
      
      const jsonFormData = JSON.stringify(dataToSend);
      const encryptedData = await encrypt(iv, salt, jsonFormData);
      const payload = {
        iv: ivBase64,
        salt: saltBase64,
        data: encryptedData,
      };
      
      const response = await axios.post(
        "Server/IAMServices/download_empanelment_data",
        payload,
        {
          headers: {
            Authorization: `Bearer ${localStorage.getItem("token")}`,
          },
        }
      );
      
      if (response.data.result) {
        downloadFile(
          response.data.result,
          "excel",
          `${userIp.datatype}_${userIp.type || "All"}_Empanelment_list`
        );
      }
    } catch (e) {
      console.error("Download Error:", e);
    } finally {
      setIsLoading(false);
    }
  };

  const handleTabChange = (event, newValue) => {
    setUserIp(prev => ({ ...prev, datatype: newValue, type: "", subType: "" }));
    setEmpanelmentData([]);
  };

  const handleSelectYear = (year) => {
    setUserIp(prev => ({ ...prev, year, type: "", subType: "" }));
  };

  const handleSelectType = (type) => {
    setUserIp(prev => ({ ...prev, type, subType: "" }));
  };

  const handleSelectSubType = (subType) => {
    setUserIp(prev => ({ ...prev, subType }));
  };

  return (
    <Box sx={{ p: 4, width: '100%' }}>
      <Typography variant="h4" sx={{ mb: 2, fontWeight: 600 }}>
        Empanelment Data Management
      </Typography>
      <Divider sx={{ mb: 4 }} />
      
      <Paper
        sx={{
          p: 4,
          width: '100%',
          minHeight: '70vh',
          mx: 'auto',
          my: 2,
          boxShadow: 3,
          borderRadius: 2,
        }}
      >
        <Box sx={{ mb: 4 }}>
          <Tabs
            value={userIp.datatype}
            onChange={handleTabChange}
            textColor="primary"
            indicatorColor="primary"
            sx={{
              '& .MuiTabs-flexContainer': {
                gap: 2,
              },
              '& .MuiTab-root': {
                fontWeight: 600,
                fontSize: 16,
                minWidth: 120,
                px: 3,
                py: 1,
                borderRadius: 1,
                '&.Mui-selected': {
                  bgcolor: 'primary.light',
                  color: 'primary.contrastText',
                },
              },
            }}
          >
            <Tab label="Active Records" value="Active" />
            <Tab label="Archive Records" value="Archive" />
          </Tabs>
        </Box>

        {userIp.datatype && (
          <Stack 
            direction="row" 
            spacing={3} 
            alignItems="center" 
            sx={{ 
              mb: 4,
              flexWrap: 'wrap',
              rowGap: 2,
            }}
          >
            {userIp.datatype === "Archive" && (
              <TextField
                select
                label="Financial Year"
                value={userIp.year}
                onChange={(e) => handleSelectYear(e.target.value)}
                sx={{ minWidth: 220 }}
                size="medium"
                InputLabelProps={{ shrink: true }}
                variant="outlined"
              >
                <MenuItem disabled value="">
                  -- Select Year --
                </MenuItem>
                <MenuItem value="2023-24">2023-24</MenuItem>
                <MenuItem value="2024-25">2024-25</MenuItem>
                <MenuItem value="2025-26">2025-26</MenuItem>
              </TextField>
            )}

            <TextField
              select
              label="Audit Type"
              value={userIp.type}
              onChange={(e) => handleSelectType(e.target.value)}
              sx={{ minWidth: 220 }}
              size="medium"
              InputLabelProps={{ shrink: true }}
              variant="outlined"
              disabled={isLoading}
            >
              <MenuItem disabled value="">
                -- Select Type --
              </MenuItem>
              {Object.keys(selectionOptions).map((type) => (
                <MenuItem key={type} value={type}>
                  {type}
                </MenuItem>
              ))}
            </TextField>

            {userIp.type && (
              <TextField
                select
                label={`${userIp.type} Sub-Type`}
                value={userIp.subType}
                onChange={(e) => handleSelectSubType(e.target.value)}
                sx={{ minWidth: 280 }}
                size="medium"
                InputLabelProps={{ shrink: true }}
                variant="outlined"
                disabled={isLoading}
              >
                <MenuItem value="">
                  -- All Sub Types --
                </MenuItem>
                {selectionOptions[userIp.type]?.map((option) => (
                  <MenuItem key={option} value={option}>
                    {option}
                  </MenuItem>
                ))}
              </TextField>
            )}
          </Stack>
        )}

        {userIp.type && (
          <Box sx={{ width: '100%', mt: 3 }}>
            <Stack direction="row" justifyContent="flex-end" spacing={2} sx={{ mb: 3 }}>
              <Button
                onClick={handleDownload}
                variant="contained"
                color="primary"
                disabled={isLoading || filteredRows.length === 0}
                sx={{
                  fontWeight: 600,
                  px: 4,
                  py: 1,
                  borderRadius: 2,
                  textTransform: 'none',
                  fontSize: 16,
                }}
              >
                {isLoading ? 'Processing...' : 'Export to Excel'}
              </Button>
            </Stack>

            <Typography variant="body2" color="text.secondary" sx={{ mb: 2 }}>
              Showing {filteredRows.length} records {userIp.subType ? `for ${userIp.subType}` : ''}
            </Typography>

            <Paper elevation={0} sx={{ height: '60vh', width: '100%' }}>
              <DataGrid
                rows={filteredRows}
                columns={columns}
                getRowId={(row) => row.FRN}
                loading={isLoading}
                pageSizeOptions={[10, 25, 50, 100]}
                initialState={{
                  pagination: { paginationModel: { pageSize: 25 } },
                }}
                disableRowSelectionOnClick
                slots={{
                  toolbar: GridToolbar,
                }}
                slotProps={{
                  toolbar: {
                    showQuickFilter: true,
                    quickFilterProps: { debounceMs: 500 },
                  },
                }}
                sx={{
                  '& .MuiDataGrid-columnHeaders': {
                    backgroundColor: 'primary.main',
                    color: 'primary.contrastText',
                    fontSize: 15,
                    fontWeight: 600,
                  },
                  '& .MuiDataGrid-cell': {
                    py: 1,
                  },
                  '& .MuiDataGrid-virtualScroller': {
                    backgroundColor: 'background.paper',
                  },
                }}
              />
            </Paper>
          </Box>
        )}
      </Paper>
    </Box>
  );
};

export default EmpanelmentData;