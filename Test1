// UserDetailsCard.js

import React from 'react';
import { Card, CardHeader, CardContent, CardActions, Avatar, Typography, Divider, Grid } from '@mui/material';
import ManageAccountsIcon from '@mui/icons-material/ManageAccounts';
import { blue } from '@mui/material/colors';
import { CustomButton } from '../../components/ui/Buttons';
import { ChangeCircleOutlined, DeleteForever } from '@mui/icons-material';

const UserDetailsCard = ({
  fetchedUserDetails,
  roleList,
  circleList,
  isLoading,
  setIsModifyDialogOpen,
  setConfirmDeleteDialogOpen,
}) => {
  if (!fetchedUserDetails) {
    return null;
  }

  // --- START: NEW LOGIC ---
  // 1. Find the full role object for the fetched user.
  const userRole = roleList.find((r) => r.capacity === fetchedUserDetails.role);

  // 2. Determine if the user's role is a central one (not circle-specific).
  // This reuses the same logic from your UserManagement component.
  const isCentralUser = userRole && parseInt(userRole.capacity, 10) > 60;
  // --- END: NEW LOGIC ---

  const getInitials = (name) => {
    if (!name) return '';
    const words = name.split(' ');
    let initials = '';
    if (words.length >= 2) {
      initials += words[0][0];
      initials += words[1][0];
    } else if (words.length === 1 && words[0].length > 0) {
      initials += words[0][0];
    }
    return initials.toUpperCase();
  };

  const userInitials = getInitials(fetchedUserDetails.userName);

  return (
    <Card sx={{ mt: 4, borderRadius: 2, boxShadow: 3 }}>
      <CardHeader
        avatar={
          <Avatar sx={{ bgcolor: blue[800], width: 50, p: 1, height: 50, fontSize: '1.2rem' }}>
            {userInitials || <ManageAccountsIcon />}
          </Avatar>
        }
        title={
          <Typography variant="h6" component="div" fontWeight={600} color="text.secondary">
            {fetchedUserDetails.userName}
          </Typography>
        }
        subheader={
          <Typography variant="body2" color="text.secondary">
            User ID: {fetchedUserDetails.userId}
          </Typography>
        }
        sx={{ pb: 1 }}
      />
      <Divider sx={{ mx: 2 }} />
      <CardContent sx={{ pt: 3, pb: 2 }}>
        <Grid container spacing={4}>
          <Grid item xs={12} sm={6}>
            <Typography color="text.secondary" variant="body2" gutterBottom>
              Status
            </Typography>
            <Typography variant="subtitle1" fontWeight={500} color="text.primary">
              {fetchedUserDetails.userStatus}
            </Typography>
          </Grid>
          <Grid item xs={12} sm={6}>
            <Typography color="text.secondary" variant="body2" gutterBottom>
              Role
            </Typography>
            <Typography variant="subtitle1" fontWeight={500} color="text.primary">
              {userRole?.role || 'N/A'}
            </Typography>
          </Grid>

          {/* --- START: MODIFIED SECTION --- */}
          {/* 3. Only render the "Circle" grid item if the user is NOT a central user. */}
          {!isCentralUser && (
            <Grid item xs={12} sm={6}>
              <Typography color="text.secondary" variant="body2" gutterBottom>
                Circle
              </Typography>
              <Typography variant="subtitle1" fontWeight={500} color="text.primary">
                {`${fetchedUserDetails.circleCode} -
                ${circleList.find((c) => c.circleCode === fetchedUserDetails.circleCode)?.circleName}`}
              </Typography>
            </Grid>
          )}
          {/* --- END: MODIFIED SECTION --- */}
        </Grid>
      </CardContent>
      <Divider sx={{ mx: 2 }} />
      <CardActions sx={{ justifyContent: 'flex-end', p: 2.5, gap: 1.5 }}>
        <CustomButton
          buttonType="custom"
          label="Delete User"
          onClickHandler={() => setConfirmDeleteDialogOpen(true)}
          customButtonProps={{
            bgColor: 'error.main',
            hoverColor: 'error.dark',
            icon: <DeleteForever sx={{ fontSize: 18 }} />,
          }}
          disabled={isLoading}
        />

        <CustomButton
          buttonType="custom"
          label="UPDATE USER"
          onClickHandler={() => setIsModifyDialogOpen(true)}
          customButtonProps={{
            bgColor: 'success.deep',
            hoverColor: 'success.dark',
            icon: <ChangeCircleOutlined sx={{ fontSize: 16 }} />,
          }}
          disabled={isLoading}
        />
      </CardActions>
    </Card>
  );
};

export default UserDetailsCard;

