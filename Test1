                            {vidDetails.SCHEDULED_TIME ? (
                              <>
                                Yes ({formatDateTime(vidDetails.SCHEDULED_TIME)})
                                {new Date(vidDetails.SCHEDULED_TIME) < new Date() && !["POSTED", "SCHEDULED", "APPROVED", "REJECTED", "C", "S"].includes(viewingBatchState) && (
