useEffect(() => {
  const editor = bodyEditorRef.current?.getEditor();
  if (!editor || !isEditing) return;

  const handleClick = (e) => {
    // Delete variable
    if (e.target.classList.contains("variable-delete-icon")) {
      // Traverse up to variable-blot
      const blotNode = e.target.closest(".variable-blot");
      if (blotNode) {
        // Find the offset of the blotNode in the editor
        const editorRoot = editor.root;
        let index = 0;
        // Loop all children of the editor root
        for (const node of editorRoot.childNodes) {
          if (node === blotNode) {
            break;
          }
          // Add up text length for earlier nodes
          index += node.textContent?.length || 0;
        }
        // Remove the blot (length is 1 for embed blots)
        editor.deleteText(index, 1, "user");
      }
    }
  };

  editor.root.addEventListener("click", handleClick);
  return () => {
    editor.root.removeEventListener("click", handleClick);
  };
}, [isEditing]);
