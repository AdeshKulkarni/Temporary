import { useState } from "react";
import FileUploadDropBox from "./FileUploadDropBox";
import {
  Button,
  Divider,
  Paper,
  Typography,
  Snackbar,
  Alert,
} from "@mui/material";
import { DataGrid, GridArrowDownwardIcon } => "@mui/x-data-grid";
import * as XLSX from "xlsx";
import { Box } from "@mui/system";

export default function PreEmpanelmentChecks() {
  const [childData, setChildData] = useState({ columns: [], rows: [] });
  const [alertOpen, setAlertOpen] = useState(false);
  // NEW CODE: State for controlling the empty file alert
  const [emptyFileAlertOpen, setEmptyFileAlertOpen] = useState(false);

  const handleChildData = (data) => {
    // MODIFIED CODE: Check for empty data received from FileUploadDropBox
    if (data && data.rows && data.rows.length === 0) {
      setEmptyFileAlertOpen(true); // Open the empty file alert
      setChildData({ columns: [], rows: [] }); // Clear the DataGrid
    } else {
      setChildData(data);
    }
  };

  const downloadExcel = () => {
    if (!childData?.rows?.length) {
      setAlertOpen(true);
      return;
    }

    const headers = childData.columns.map((col) => col.headerName);
    const fieldKeys = childData.columns.map((col) => col.field);

    const rows = childData.rows.map((row) =>
      fieldKeys.reduce((acc, key, idx) => {
        acc[headers[idx]] = row[key];
        return acc;
      }, {})
    );

    const worksheet = XLSX.utils.json_to_sheet(rows);
    const workbook = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(workbook, worksheet, "PreEmpanelment");
    XLSX.writeFile(workbook, "PreEmpanelment_Data.xlsx");
  };

  return (
    <div>
      <Typography variant="h5">Pre-Empanelment Check</Typography>
      <Divider />
      <FileUploadDropBox onSendData={handleChildData} />
      <Box sx={{ display: "flex", justifyContent: "flex-end", mb: 1 }}>
        <Button
          variant="contained"
          color="success"
          startIcon={<GridArrowDownwardIcon />}
          onClick={downloadExcel}
        >
          Download
        </Button>
      </Box>
      <Paper style={{ height: 450, width: "100%" }}>
        <DataGrid
          {...childData}
          columnBufferPx={100}
          localeText={{
            noRowsLabel: "Kindly Select An Excel File.",
          }}
        />
      </Paper>

      {/* Alert for no data */}
      <Snackbar
        open={alertOpen}
        autoHideDuration={3000}
        onClose={() => setAlertOpen(false)}
        anchorOrigin={{ vertical: "bottom", horizontal: "right" }}
      >
        <Alert
          variant="filled"
          severity="warning"
          onClose={() => setAlertOpen(false)}
        >
          No data available to download!
        </Alert>
      </Snackbar>

      {/* NEW CODE: Alert for empty Excel file */}
      <Snackbar
        open={emptyFileAlertOpen}
        autoHideDuration={3000}
        onClose={() => setEmptyFileAlertOpen(false)}
        anchorOrigin={{ vertical: "bottom", horizontal: "right" }}
      >
        <Alert
          variant="filled"
          severity="error" // Using 'error' severity for a more distinct visual cue
          onClose={() => setEmptyFileAlertOpen(false)}
        >
          This is an empty Excel file! Please upload a file with data.
        </Alert>
      </Snackbar>
    </div>
  );
}
