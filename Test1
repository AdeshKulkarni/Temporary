    /**
     * Retrieves all Active Voucher Configurations that a specific role is allowed to initiate.
     * Uses a highly optimized "Fetch & Merge" pattern to prevent N+1 database queries
     * and handle 1-to-Many relationships without returning duplicate rows.
     */
    public List<Map<String, Object>> getAvailableVouchersVid(Long roleId) {

        // ==================================================================================
        // STEP 1: FETCH CORE VOUCHER DATA
        // Purpose: Get the distinct master records and basic details in a single query.
        // Note: We use LEFT JOINs so the voucher is still returned even if user/category data is missing.
        // ==================================================================================
        String sql = """
            SELECT 
                rv.ID,
                rv.VID,
                rv.DESCRIPTION,
                c.CATEGORY_NAME,
                rv.CREATED_BY AS CREATOR_ID,
                -- Fallback: If user isn't found in USERS table, just return their raw ID
                COALESCE(u.FIRST_NAME || ' ' || u.LAST_NAME, rv.CREATED_BY) AS CREATOR_NAME,
                rv.CREATED_AT
            FROM REQUEST_VOUCHER rv
            LEFT JOIN VOUCHER_CATEGORY c ON rv.CATEGORY_ID = c.ID
            LEFT JOIN USERS u ON rv.CREATED_BY = u.USER_ID
            WHERE rv.ALLOWED_ROLE = ? AND rv.STATUS = 'ACTIVE'
            ORDER BY rv.CREATED_AT DESC
        """;

        // Manually mapping
        List<Map<String, Object>> vouchers = jdbcTemplate.query(sql, (rs, rowNum) -> {
            Map<String, Object> map = new HashMap<>();
            map.put("id", rs.getLong("ID"));
            map.put("vid", rs.getString("VID"));
            map.put("description", rs.getString("DESCRIPTION"));
            map.put("categoryName", rs.getString("CATEGORY_NAME"));
            map.put("createdBy", rs.getString("CREATOR_ID"));
            map.put("createdByName", rs.getString("CREATOR_NAME"));

            java.sql.Timestamp ts = rs.getTimestamp("CREATED_AT");
            map.put("createdAt", ts != null ? ts.toInstant().toString() : null);
            return map;
        }, roleId);

        // Early Exit: If no vouchers are found, return immediately to save a DB call.
        if (vouchers.isEmpty()) {
            return vouchers;
        }

        // ==================================================================================
        // STEP 2: FETCH 1-TO-MANY RELATIONSHIPS (ISSUE CATEGORIES) IN BULK
        // Purpose: Avoid the N+1 query problem. Instead of querying categories 1-by-1 in a loop,
        // we extract all the IDs and ask the database for everything at once.
        // ==================================================================================
        List<Long> voucherIds = vouchers.stream()
                .map(v -> (Long) v.get("id"))
                .toList();

        // Dynamically build the "?, ?, ?" string for the SQL IN clause based on the list size
        String inClause = String.join(",", Collections.nCopies(voucherIds.size(), "?"));

        // Oracle's LISTAGG function groups multiple rows into a single comma-separated string
        // (e.g., "Category A, Category B"). This prevents Java from having to do string manipulation.
        String issueSql = String.format("""
            SELECT 
                rvic.REQUEST_VOUCHER_ID, 
                LISTAGG(ic.ISSUE_CATEGORY_NAME, ', ') WITHIN GROUP (ORDER BY ic.ISSUE_CATEGORY_NAME) AS CATEGORIES
            FROM REQUEST_VOUCHER_ISSUE_CATEGORY rvic
            JOIN ISSUE_CATEGORY ic ON rvic.ISSUE_CATEGORY_ID = ic.ID
            WHERE rvic.REQUEST_VOUCHER_ID IN (%s)
            GROUP BY rvic.REQUEST_VOUCHER_ID
        """, inClause);

        // Store the results in a Map where Key = Voucher ID, Value = "CatA, CatB"
        Map<Long, String> issueCategoryMap = new HashMap<>();
        jdbcTemplate.query(issueSql, rs -> {
            issueCategoryMap.put(rs.getLong("REQUEST_VOUCHER_ID"), rs.getString("CATEGORIES"));
        }, voucherIds.toArray());

        // ==================================================================================
        // STEP 3: STITCH DATA TOGETHER IN MEMORY
        // Purpose: Attach the category strings back to their original voucher objects.
        // ==================================================================================
        for (Map<String, Object> voucher : vouchers) {
            Long vId = (Long) voucher.get("id");

            // If the voucher has no issue categories, default to "N/A" so the React UI
            // doesn't render an empty blank space.
            voucher.put("issueCategories", issueCategoryMap.getOrDefault(vId, "N/A"));
        }

        return vouchers;
    }

    public boolean isUserAuthorizedForBatch(String batchId, String userId, Integer roleId) {
        Integer isCreator = jdbcTemplate.queryForObject("SELECT COUNT(*) FROM VOUCHER_POSTING WHERE BATCH_ID = ? AND CREATED_BY = ?", Integer.class, batchId, userId);
        if (isCreator != null && isCreator > 0) return true;
        Integer isAuthorized = jdbcTemplate.queryForObject("SELECT COUNT(*) FROM VOUCHER_POSTING vp JOIN WORKFLOW_TRANSITIONS wt ON vp.PENDING_AT = wt.WORKFLOW_ID WHERE vp.BATCH_ID = ? AND wt.ALLOWED_ROLE_ID = ?", Integer.class, batchId, roleId);
        return isAuthorized != null && isAuthorized > 0;
    }

    public byte[] generateBatchExcel(String batchId) {

        // 1. THE MEMORY HACK: Tell Java to start with a 5MB buffer so it doesn't
        // spend CPU time constantly resizing and copying small arrays in RAM.
        int initialBufferSize = 5 * 1024 * 1024; // 5 MB

        try (org.apache.poi.xssf.streaming.SXSSFWorkbook workbook = new org.apache.poi.xssf.streaming.SXSSFWorkbook(100);
             java.io.ByteArrayOutputStream out = new java.io.ByteArrayOutputStream(initialBufferSize)) {

            org.apache.poi.ss.usermodel.Sheet sheet = workbook.createSheet("Batch Details");
            org.apache.poi.ss.usermodel.Row headerRow = sheet.createRow(0);
            String[] headers = {"Branch", "Currency", "CGL", "Amount", "Type", "Remarks", "Product Code"};
            for (int i = 0; i < headers.length; i++) headerRow.createCell(i).setCellValue(headers[i]);

            String sql = "SELECT REQ_BRANCH_CODE, REQ_CURRENCY, REQ_CGL, REQ_AMOUNT, REQ_NARRATION, REQ_PRODUCT FROM VOUCHER_POSTING_DATA WHERE BATCH_ID = ?";
            int[] rowIdx = {1};

            // 2. THE NETWORK HACK: Use a custom PreparedStatement to force
            // Oracle to send us 2,000 rows per network trip instead of 10.
            jdbcTemplate.query(
                    connection -> {
                        java.sql.PreparedStatement ps = connection.prepareStatement(
                                sql,
                                java.sql.ResultSet.TYPE_FORWARD_ONLY,
                                java.sql.ResultSet.CONCUR_READ_ONLY
                        );
                        ps.setFetchSize(2000); // <--- This reduces network trips by 99%
                        ps.setString(1, batchId);
                        return ps;
                    },
                    rs -> {
                        org.apache.poi.ss.usermodel.Row row = sheet.createRow(rowIdx[0]++);

                        row.createCell(0).setCellValue(rs.getString("REQ_BRANCH_CODE") != null ? rs.getString("REQ_BRANCH_CODE") : "");
                        row.createCell(1).setCellValue(rs.getString("REQ_CURRENCY") != null ? rs.getString("REQ_CURRENCY") : "");
                        row.createCell(2).setCellValue(rs.getString("REQ_CGL") != null ? rs.getString("REQ_CGL") : "");

                        BigDecimal amt = rs.getBigDecimal("REQ_AMOUNT");
                        if (amt != null) {
                            row.createCell(3).setCellValue(amt.abs().stripTrailingZeros().toPlainString());
                            row.createCell(4).setCellValue(amt.compareTo(BigDecimal.ZERO) < 0 ? "Credit" : "Debit");
                        }

                        row.createCell(5).setCellValue(rs.getString("REQ_NARRATION") != null ? rs.getString("REQ_NARRATION") : "");
                        row.createCell(6).setCellValue(rs.getString("REQ_PRODUCT") != null ? rs.getString("REQ_PRODUCT") : "");
                    }
            );

            if (rowIdx[0] == 1) {
                throw new CustomExceptions.InvalidDataException("No records found for batch.");
            }

            workbook.write(out);
            workbook.dispose();
            return out.toByteArray();

        } catch (java.io.IOException e) {
            throw new CustomExceptions.DatabaseOperationException("Failed to generate Excel file", e);
        }
    }
}
package com.fincore.VoucherService.Service.core;


import com.fincore.VoucherService.Dto.BulkProcessVoucherPostingDto;
import com.fincore.VoucherService.Dto.ProcessVoucherRequestDto;
import com.fincore.VoucherService.Exception.CustomExceptions;
import com.fincore.VoucherService.Models.VoucherPosting;
import com.fincore.VoucherService.Models.VoucherWorkflow;
import com.fincore.VoucherService.Models.enums.RequestStatus;
import com.fincore.VoucherService.Models.enums.VoucherStatus;
import com.fincore.VoucherService.Repository.VoucherPostingRepository;
import com.fincore.VoucherService.Repository.VoucherWorkflowRepository;
import com.fincore.VoucherService.Service.NotificationWriterService;
import lombok.RequiredArgsConstructor;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.context.annotation.Lazy;
import org.springframework.dao.EmptyResultDataAccessException;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.time.LocalDateTime;
import java.util.List;
import java.util.Map;

@Service
@RequiredArgsConstructor
public class VoucherWorkflowEngine {

    @Autowired
    @Qualifier("oracleJdbcTemplate")
    private JdbcTemplate jdbcTemplate;

    private final VoucherPostingRepository voucherPostingRepository;
    private final VoucherWorkflowRepository voucherWorkflowRepository;
    private final NotificationWriterService notificationWriterService;

    // Inject the command service to trigger async execution after final approval
    @Lazy
    @Autowired
    private VoucherCommandService commandService;



    @Transactional
    public void processWorkflowAction(ProcessVoucherRequestDto dto, String executorId, Integer executorRole) {
        String batchId = dto.getBatchId();

        // --- STRICT ACTION REMARKS ENFORCEMENT ---
        if (dto.getRemarks() == null || dto.getRemarks().trim().length() < 2 || dto.getRemarks().trim().length() > 30) {
            throw new CustomExceptions.InvalidDataException("Action remarks are mandatory and must be between 2 and 30 alphanumeric characters.");
        }
        String sanitizedRemarks = dto.getRemarks().replaceAll("[^a-zA-Z0-9 ]", "").trim().replaceAll("\\s{2,}", " ");
        dto.setRemarks(sanitizedRemarks);

        // 1. Unified Fetch: NOW INCLUDES REQUEST_VOUCHER TO GET VID_CREATOR
        Map<String, Object> stepData;
        try {
            stepData = jdbcTemplate.queryForMap("""
                SELECT 
                    p.CREATED_BY AS BATCH_CREATOR, p.VID_FK, p.IS_EXECUTION_SCHEDULED, p.SCHEDULED_TIME,
                    w.WORKFLOW_CODE, w.WORKFLOW_ORDER, w.IS_FINAL_APPROVAL, 
                    w.WORKFLOW_STAGE, w.ALLOWED_ROLE_ID, w.WORKFLOW_ID,
                    rv.CREATED_BY AS VID_CREATOR
                FROM VOUCHER_POSTING p
                JOIN WORKFLOW_TRANSITIONS w ON p.PENDING_AT = w.WORKFLOW_ID
                LEFT JOIN REQUEST_VOUCHER rv ON p.VID_FK = rv.VID
                WHERE p.BATCH_ID = ?
                """, batchId);
        } catch (EmptyResultDataAccessException e) {
            throw new CustomExceptions.InvalidDataException("Batch ID not found or workflow stage invalid.");
        }

        // --- FIX: DECLARE THE VARIABLES HERE ---
        String batchCreatorId = (String) stepData.get("BATCH_CREATOR");
        String vidCreatorId = (String) stepData.get("VID_CREATOR");
        String vid = (String) stepData.get("VID_FK");

        // 2. Security & Authorization Checks
        if (executorId.equalsIgnoreCase(batchCreatorId)) {
            throw new CustomExceptions.InvalidDataException("Security Violation: You cannot approve your own batch.");
        }

        boolean hasAlreadyApproved = voucherWorkflowRepository.findByBatchIdFkOrderByLastActionAtAsc(batchId)
                .stream().anyMatch(w -> executorId.equalsIgnoreCase(w.getLastActionBy()));
        if (hasAlreadyApproved) {
            throw new CustomExceptions.InvalidDataException("Security Violation: You have already approved this batch.");
        }

        Integer allowedRoleId = ((Number) stepData.get("ALLOWED_ROLE_ID")).intValue();
        if (!allowedRoleId.equals(executorRole)) {
            throw new CustomExceptions.InvalidDataException("Unauthorized: Role mismatch.");
        }

        // 3. Variables for Logic
        String workflowCode = (String) stepData.get("WORKFLOW_CODE");
        Integer currentOrder = ((Number) stepData.get("WORKFLOW_ORDER")).intValue();
        String currentStageName = (String) stepData.get("WORKFLOW_STAGE");
        boolean isFinalStep = "Y".equalsIgnoreCase((String) stepData.get("IS_FINAL_APPROVAL"));

        VoucherPosting posting = voucherPostingRepository.findById(batchId).orElseThrow();

        // 4. Handle REJECTION
        if ("REJECTED".equals(dto.getStatus().toString())) {
            posting.setBatchStatus("R");
            voucherPostingRepository.save(posting);

            logWorkflowAction(batchId, vid, "Rejected (" + currentStageName + ")", executorId, dto.getRemarks(), null);

            // FIX: Use VOUCHER_POSTING and VOUCHER_POSTING_DATA for rejections
            jdbcTemplate.update("UPDATE VOUCHER_POSTING SET BATCH_STATUS = 'REJECTED' WHERE BATCH_ID = ?", batchId);
            jdbcTemplate.update("UPDATE VOUCHER_POSTING_DATA SET REQ_STATUS = 'R', EXECUTION_DATE = SYSTIMESTAMP WHERE BATCH_ID = ?", batchId);

            // Grabs everyone who ever took an action on this batch, excluding the current rejector
            String previousActorsSql = "SELECT DISTINCT LAST_ACTION_BY FROM VOUCHER_WORKFLOW WHERE BATCH_ID_FK = ? AND LAST_ACTION_BY != ?";
            List<String> previousActors = jdbcTemplate.queryForList(previousActorsSql, String.class, batchId, executorId);

            // Failsafe: Ensure the original creators are in the blast list
            if (!previousActors.contains(batchCreatorId)) {
                previousActors.add(batchCreatorId);
            }
            if (vidCreatorId != null && !previousActors.contains(vidCreatorId)) {
                previousActors.add(vidCreatorId);
            }

            // Fire the notifications
            notificationWriterService.createBatchRejectedNotificationForUsers(batchId, previousActors, executorId, dto.getRemarks());

            if (posting.getVidFk() != null && !posting.getVidFk().isEmpty()) updateVidStatus(posting.getVidFk(), VoucherStatus.ACTIVE);
            return;
        }

        // 5. Handle APPROVAL / PROGRESSION
        if (isFinalStep) {
            // Move to Execution Step (Order + 1)
            Long execStepId = jdbcTemplate.queryForObject("SELECT WORKFLOW_ID FROM WORKFLOW_TRANSITIONS WHERE WORKFLOW_CODE = ? AND WORKFLOW_ORDER = ?", Long.class, workflowCode, currentOrder + 1);
            posting.setPendingAt(execStepId);

            boolean isOverride = Boolean.TRUE.equals(dto.getOverrideScheduleLapse());
            if (isOverride) {

                if (dto.getNewScheduledTime() != null) {
                    validateScheduledTime(dto.getNewScheduledTime(), true);
                }

                posting.setIsScheduleOverride("YES");
                posting.setIS_EXECUTION_SCHEDULED(dto.getNewScheduledTime() != null ? "YES" : "NO");
                posting.setScheduledTime(dto.getNewScheduledTime());
            }
            else if ("YES".equalsIgnoreCase(posting.getIS_EXECUTION_SCHEDULED()) && posting.getScheduledTime() != null) {
                if (posting.getScheduledTime().isBefore(LocalDateTime.now())) {
                    throw new CustomExceptions.ScheduleLapsedException("The scheduled execution time has passed.");
                }
                else {
                    posting.setIsScheduleOverride("NO"); // Ensure it stays NO if not triggered
                }
            }

            if ("YES".equalsIgnoreCase(posting.getIS_EXECUTION_SCHEDULED()) && posting.getScheduledTime() != null && posting.getScheduledTime().isAfter(LocalDateTime.now())) {
                posting.setBatchStatus("P");

                String actionLog = isOverride ? "Final Approval(Sch. Override)" : "Final Approval(Scheduled)";
                logWorkflowAction(batchId, vid, actionLog, executorId, dto.getRemarks(), posting.getScheduledTime());

                // FIX: Update VOUCHER_POSTING
                jdbcTemplate.update("UPDATE VOUCHER_POSTING SET BATCH_STATUS = 'P' WHERE BATCH_ID = ?", batchId);
            } else {
                posting.setBatchStatus("C");
                posting.setExecutedAt(LocalDateTime.now());
                String actionLog = isOverride ? "Final Approval(Imm. Override)" : "Final Approval(Posted)";
                logWorkflowAction(batchId, vid, actionLog, executorId, dto.getRemarks(), null);

                if (posting.getVidFk() != null && !posting.getVidFk().isEmpty()) updateVidStatus(posting.getVidFk(), VoucherStatus.COMPLETED);

                BulkProcessVoucherPostingDto execDto = new BulkProcessVoucherPostingDto();
                execDto.setBatchId(batchId); execDto.setStatus(RequestStatus.ACCEPTED); execDto.setRemarks(dto.getRemarks());
                commandService.processBulkRequestsAsync(execDto, executorId, executorRole);
            }
            // --- NOTIFY BOTH CREATORS OF FINAL APPROVAL ---
            notificationWriterService.createBatchUpdateNotificationForCreators(
                    batchId, vid, batchCreatorId, vidCreatorId, "fully APPROVED", executorId
            );
        } else {
            // --- PERFECTED JOIN LOGIC ---
            // Joins VOUCHER_POSTING with WORKFLOW_TRANSITIONS to safely fetch the exact next routing stage
            String nextStepSql = """
                SELECT w_next.WORKFLOW_ID, w_next.ALLOWED_ROLE_ID
                FROM VOUCHER_POSTING vp
                JOIN WORKFLOW_TRANSITIONS w_curr 
                  ON vp.PENDING_AT = w_curr.WORKFLOW_ID
                JOIN WORKFLOW_TRANSITIONS w_next 
                  ON w_curr.WORKFLOW_CODE = w_next.WORKFLOW_CODE 
                 AND w_next.WORKFLOW_ORDER = (w_curr.WORKFLOW_ORDER + 1)
                WHERE vp.BATCH_ID = ?
            """;

            Map<String, Object> nextStepInfo = jdbcTemplate.queryForMap(nextStepSql, batchId);
            Long nextStepId = ((Number) nextStepInfo.get("WORKFLOW_ID")).longValue();
            String nextRoleId = String.valueOf(nextStepInfo.get("ALLOWED_ROLE_ID"));

            posting.setPendingAt(nextStepId);
            logWorkflowAction(batchId, vid, "Approved (" + currentStageName + ")", executorId, dto.getRemarks(), null);


            // --- NOTIFY BOTH CREATORS OF INTERMEDIATE PROGRESS ---
            notificationWriterService.createBatchUpdateNotificationForCreators(
                    batchId, vid, batchCreatorId, vidCreatorId, "Approved (" + currentStageName + ")", executorId
            );
        }

        voucherPostingRepository.save(posting);
    }


    public void logWorkflowAction(String batchId, String vid, String action, String executorId, String remarks, LocalDateTime scheduledTime) {
        VoucherWorkflow wf = new VoucherWorkflow();
        wf.setBatchIdFk(batchId);
        wf.setVidFk(vid != null ? vid : "UNKNOWN");
        wf.setLastAction(action != null && action.length() > 30 ? action.substring(0, 30) : action);
        wf.setLastActionBy(executorId);
        wf.setLastActionAt(LocalDateTime.now());
        wf.setRemarks(remarks);
        wf.setScheduledTime(scheduledTime);
        voucherWorkflowRepository.save(wf);
    }

    public void validateScheduledTime(LocalDateTime scheduledTime, boolean isFinalApproval) {
        if (scheduledTime == null) return;

        LocalDateTime now = LocalDateTime.now();
        LocalDateTime maxTime = now.with(java.time.LocalTime.MAX);

        if (isFinalApproval) {
            // Rule for Final Approvers: Just make sure it's not in the past
            if (scheduledTime.isBefore(now)) {
                throw new CustomExceptions.InvalidDataException("Scheduled time cannot be in the past.");
            }
        } else {
            // Rule for Creators: Must be ~30 minutes in the future
            LocalDateTime minTime = now.plusMinutes(28);
            if (scheduledTime.isBefore(minTime)) {
                throw new CustomExceptions.InvalidDataException("Scheduled time must be at least 30 minutes from the current time.");
            }
        }

        if (scheduledTime.isAfter(maxTime)) {
            throw new CustomExceptions.InvalidDataException("Scheduled time cannot exceed today's end of day (11:59 PM).");
        }
    }


    public void updateVidStatus(String vid, VoucherStatus status) {
        String sql = "UPDATE REQUEST_VOUCHER SET STATUS = ? WHERE VID = ?";
        jdbcTemplate.update(sql, status.name(), vid);
    }

}



package com.fincore.VoucherService.Service.validation;

import com.fasterxml.jackson.annotation.*;
import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fincore.VoucherService.Dto.BulkUploadStateDto;
import com.fincore.VoucherService.Dto.ExcelRowData;
import com.fincore.VoucherService.Exception.CustomExceptions;
import com.fincore.VoucherService.Service.ValidationMasterService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.apache.poi.ss.usermodel.*;
import org.slf4j.MDC;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.context.annotation.Lazy;
import org.springframework.dao.DataAccessException;
import org.springframework.data.redis.core.RedisTemplate;
import org.springframework.scheduling.annotation.Async;
import org.springframework.stereotype.Service;

import java.io.*;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.StandardCopyOption;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.time.format.DateTimeParseException;
import java.util.*;
import java.util.stream.Collectors;
import com.fincore.VoucherService.Dto.ParsingResult;



/**
 * Handles high-performance streaming parsing and multi-stage validation.
 * Optimized to prevent OOM errors by offloading large datasets to Redis with GZIP compression.
 */
@Service
@RequiredArgsConstructor
@Slf4j
public class VoucherBulkValidationService {

    private VoucherRuleValidator voucherRuleValidator;

    private final ExcelStreamingParser excelParser;
    private final VoucherRuleValidator ruleValidator;
    private final ValidationStateManager stateManager;
    private final ValidationReportGenerator reportGenerator;
    private final ObjectMapper objectMapper;

    // ==================================================================================
    // GLOBAL SECURITY CONFIGURATION
    // ==================================================================================
    static {
        // Prevents Zip Bomb / Decompression attacks by enforcing a strict inflation ratio
        org.apache.poi.openxml4j.util.ZipSecureFile.setMinInflateRatio(0.001);

        // Prevents massive file memory allocation attacks
        org.apache.poi.openxml4j.util.ZipSecureFile.setMaxEntrySize(100 * 1024 * 1024); // 100MB Max
    }



    @Autowired
    @Qualifier("byteArrayRedisTemplate")
    private RedisTemplate<String, byte[]> redisTemplate;

    @Autowired
    @Lazy
    private VoucherBulkValidationService self;

    private BulkUploadStateDto getStatusFromRedis(String reqId) {
        try {
            byte[] json = redisTemplate.opsForValue().get("BULK_STATUS_" + reqId);
            if (json == null) return null;
            return objectMapper.readValue(json, BulkUploadStateDto.class);
        } catch (IOException | DataAccessException e) {
            log.error("REDIS_READ_FAIL | ReqID: {} | Type: {}", reqId, e.getClass().getSimpleName());
            return null;
        }
    }


    // ==================================================================================
    // 2. UPLOAD INITIALIZATION (Security & Storage)
    // ==================================================================================

    public String initiateValidation(org.springframework.web.multipart.MultipartFile file, LocalDate postingDate) throws IOException {

        String filename = file.getOriginalFilename();
        long fileSize = file.getSize();

        // FIX 1: Lower the minimum size to 1 KB (allows small templates to pass)
        if (fileSize < 1024) {
            log.error("UPLOAD_SECURITY_DENIED | Status: File too small (Size: {} bytes)", fileSize);
            throw new CustomExceptions.FileProcessingException("File is too small. Minimum allowed size is 1 KB.");
        }

        if (fileSize > 50 * 1024 * 1024) {
            log.error("UPLOAD_SECURITY_DENIED | Status: File size out of bounds (Size: {} bytes)", fileSize);
            throw new CustomExceptions.FileProcessingException("File size cannot exceed 50MB.");
        }

        if (filename == null || filename.isBlank()) {
            throw new CustomExceptions.FileProcessingException("Filename cannot be empty.");
        }

        if (filename.length() > 35) {
            log.error("UPLOAD_SECURITY_DENIED | Status: Filename exceeds 35 characters");
            throw new CustomExceptions.FileProcessingException("File name length cannot exceed 35 characters.");
        }

        if (filename.indexOf('.') != filename.lastIndexOf('.')) {
            log.error("UPLOAD_SECURITY_DENIED | Status: Multiple extensions detected");
            throw new CustomExceptions.FileProcessingException("Files with multiple extensions are strictly prohibited.");
        }

        // FIX 3: Add \\s (spaces) and \\(\\) (parentheses) to the regex so it accepts 'Template (1).xlsx'
        if (!filename.matches("^[a-zA-Z0-9_\\-\\s\\(\\)]+\\.(xlsx|xls)$")) {
            log.error("UPLOAD_SECURITY_DENIED | Status: Invalid characters or extension in filename");
            throw new CustomExceptions.FileProcessingException("Invalid file name. Only .xls and .xlsx files with alphanumeric characters, spaces, hyphens, underscores, and parentheses are allowed.");
        }


        String mimeType = file.getContentType();
        // FIX 4: Add generic fallback MIME types. Sometimes Windows/Browsers send octet-stream or zip for Excel files.
        if (mimeType == null || (
                !"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet".equals(mimeType) &&
                        !"application/vnd.ms-excel".equals(mimeType) &&
                        !"application/octet-stream".equals(mimeType) &&
                        !"application/zip".equals(mimeType))) {
            log.error("UPLOAD_SECURITY_DENIED | Status: Invalid MIME Type: {}", mimeType);
            throw new CustomExceptions.FileProcessingException("Invalid file format. Detected MIME type does not match Excel.");
        }

        String requestId = UUID.randomUUID().toString();

      

        // --- ADD THIS: EXPLICIT SECURE FILE PERMISSIONS ---
        Path tempFile;
        try {
            // Check if running on Linux/Unix to apply strict POSIX permissions (rw-------)
            if (java.nio.file.FileSystems.getDefault().supportedFileAttributeViews().contains("posix")) {
                java.nio.file.attribute.FileAttribute<java.util.Set<java.nio.file.attribute.PosixFilePermission>> attr =
                        java.nio.file.attribute.PosixFilePermissions.asFileAttribute(java.nio.file.attribute.PosixFilePermissions.fromString("rw-------"));
                tempFile = Files.createTempFile("UPLOAD_" + requestId + "_", ".tmp", attr);
            } else {
                // Fallback for Windows environments
                tempFile = Files.createTempFile("UPLOAD_" + requestId + "_", ".tmp");
                tempFile.toFile().setReadable(true, true);
                tempFile.toFile().setWritable(true, true);
                tempFile.toFile().setExecutable(false);
            }
        } catch (IOException e) {
            throw new CustomExceptions.FileProcessingException("Failed to allocate secure storage for upload.");
        }

        // The variable is renamed to uploadStream to guarantee no naming collisions
        try (InputStream uploadStream = file.getInputStream()) {
            Files.copy(uploadStream, tempFile, StandardCopyOption.REPLACE_EXISTING);
        } catch (IOException e) {
            log.error("TEMP_FILE_CREATE_FAIL | ReqID: {} | Status: Disk IO failure", requestId);
            throw new CustomExceptions.FileProcessingException("Failed to secure uploaded file on disk.");
        }

        BulkUploadStateDto state = new BulkUploadStateDto();
        state.setRequestId(requestId);
        state.setStatus("PROCESSING");
        state.setCurrentStage(1);
        state.setMessage("Initializing Upload...");
        state.setTotalRows(0);
        stateManager.saveStatusToRedis(requestId, state);

        log.info("VALIDATION_INIT | ReqID: {} | Status: Temporary storage allocated", requestId);
        self.processAsync(requestId, tempFile.toString(), filename, postingDate);
        return requestId;
    }


    // ==================================================================================
    // 3. ORCHESTRATION ENGINE (The Async Loop)
    // ==================================================================================

    @Async("bulkExecutor")
    public void processAsync(String requestId, String tempFilePath, String filename, LocalDate postingDate) {
        MDC.put("requestId", requestId);
        long startTime = System.currentTimeMillis();
        File tempFile = new File(tempFilePath);

        try {
            stateManager.updateState(requestId, s -> s.setMessage("Parsing File..."));
            ParsingResult parsingResult;

            try (InputStream is = new FileInputStream(tempFile)) {
                // Directly parse as Excel
                parsingResult = excelParser.parseExcelStream(is, postingDate);
            }

            List<ExcelRowData> parsedRows = parsingResult.rows;
            if (parsedRows == null || parsedRows.isEmpty()) {
                throw new CustomExceptions.InvalidDataException("File data is empty. No transaction rows found.");
            }

            stateManager.updateState(requestId, s -> {
                s.setTotalRows(parsedRows.size());
                s.setMessage("Validating Formats...");
            });

            // DELEGATE: Stage 1 (Format Check)
            ruleValidator.runFormatCheck(parsedRows);
            if (parsedRows.stream().anyMatch(ExcelRowData::hasErrors)) {
                failRequest(requestId, parsedRows, "Format Validation Failed", 1, parsingResult.hasProductColumn);
                return;
            }

            // DELEGATE: Stage 2 (Database Check)
            stateManager.updateState(requestId, s -> {
                s.setCurrentStage(2);
                s.setMessage("Checking Database...");
            });
            ruleValidator.runDbCheck(parsedRows);
            if (parsedRows.stream().anyMatch(ExcelRowData::hasErrors)) {
                failRequest(requestId, parsedRows, "Database Validation Failed", 2, parsingResult.hasProductColumn);
                return;
            }

            // DELEGATE: Stage 3 (Balance Check)
            stateManager.updateState(requestId, s -> {
                s.setCurrentStage(3);
                s.setMessage("Checking Balances...");
            });
            ruleValidator.runBalanceCheck(parsedRows);
            if (parsedRows.stream().anyMatch(ExcelRowData::hasErrors)) {
                failRequest(requestId, parsedRows, "Debit/Credit Balance Mismatch", 3, parsingResult.hasProductColumn);
                return;
            }


            log.info("VALIDATION_SUCCESS | ReqID: {} | Duration: {}ms", requestId, (System.currentTimeMillis() - startTime));

            // Removed isCsv flag from the method call
            completeRequest(requestId, parsedRows, postingDate, parsingResult.hasProductColumn);

        }
        // --- ALL ORIGINAL CATCH BLOCKS RESTORED EXACTLY ---
        catch (CustomExceptions.InvalidDataException e) {
            log.warn("EMPTY_DATA_REJECTED | ReqID: {} | Reason: {}", requestId, e.getMessage());
            handleAsyncCrash(requestId, e.getMessage());
        }
        catch (FileNotFoundException e) {
            handleAsyncCrash(requestId, "System Error: File not found in temporary storage.");
        } catch (IOException e) {
            handleAsyncCrash(requestId, "System Error: Failed to read file content.");
        } catch (DateTimeParseException e) {
            log.error("DATE_PARSING_FAIL | ReqID: {} | Status: Invalid row date format", requestId);
            handleAsyncCrash(requestId, "Validation Failed: Incorrect date format detected in rows.");
        } catch (NumberFormatException e) {
            log.error("AMOUNT_PARSING_FAIL | ReqID: {} | Status: Numeric format error", requestId);
            handleAsyncCrash(requestId, "Validation Failed: Non-numeric values found in amount column.");
        } catch (DataAccessException e) {
            log.error("REDIS_OR_DB_UNAVAILABLE | ReqID: {} | Status: Backend connection failure", requestId);
            handleAsyncCrash(requestId, "System temporarily unavailable. Please try again later.");
        } catch (NullPointerException | ArrayIndexOutOfBoundsException e) {
            log.error("INTERNAL_LOGIC_ERROR | ReqID: {} | Type: {}", requestId, e.getClass().getSimpleName());
            handleAsyncCrash(requestId, "Internal system failure during processing.");
        }
        catch (Throwable t) {
            log.error("FATAL_SYSTEM_ERROR | ReqID: {} | Type: {}", requestId, t.getClass().getSimpleName(), t);
            handleAsyncCrash(requestId, "A critical system error occurred during processing.");
        }
        finally {
            if (tempFile.exists() && !tempFile.delete()) {
                log.warn("CLEANUP_WARN | Path: {} | Status: Temp file purge failed", tempFilePath);
            }
            MDC.clear();
        }
    }


    // ==================================================================================
    // 4. COMPLETION & ERROR DELEGATION
    // ==================================================================================
    private void failRequest(String reqId, List<ExcelRowData> rows, String msg, int stage, boolean hasProductColumn) throws IOException {
        log.warn("VALIDATION_FAILED | ReqID: {} | Reason: {}", reqId, msg);

        // Let the Report Generator build the Excel
        byte[] excel = reportGenerator.generateErrorExcelFast(rows, hasProductColumn);

        // Let the State Manager save it to Redis
        stateManager.saveErrorFileToRedis(reqId, excel);

        stateManager.updateState(reqId, s -> {
            s.setStatus("ERROR");
            s.setMessage(msg);
            s.setCurrentStage(stage);
            s.setErrorCount(rows.stream().filter(ExcelRowData::hasErrors).count());
            s.setHasErrorFile(true);
        });
    }

    private void completeRequest(String reqId, List<ExcelRowData> rows, LocalDate pDate, boolean hasProductColumn) throws IOException {
        stateManager.saveRowsToRedis(reqId, rows);

        List<Map<String, Object>> preview = rows.stream().limit(2000).map(this::mapToPreview).collect(Collectors.toList());

        stateManager.updateState(reqId, s -> {
            s.setCurrentStage(4);
            s.setStatus("SUCCESS");
            s.setMessage("Validation Successful");
            s.setHasSuccessFile(false);
            s.setHasProductColumn(hasProductColumn);
            try {
                s.setPreviewDataJson(objectMapper.writeValueAsString(preview));
            } catch (JsonProcessingException ignored) {}
        });
    }


    private void handleAsyncCrash(String requestId, String message) {
        log.error("ASYNC_PROCESS_CRASH | ReqID: {} | Reason: {}", requestId, message);
        stateManager.updateState(requestId, s -> {
            s.setStatus("ERROR");
            s.setMessage(message);
            s.setHasErrorFile(false);
        });
    }

    private Map<String, Object> mapToPreview(ExcelRowData r) {
        Map<String, Object> m = new java.util.HashMap<>();
        m.put("id", r.rowIndex);
        m.put("branch", r.branch);
        m.put("currency", r.currency);
        m.put("cgl", r.cgl);
        m.put("amount", r.amount != null ? r.amount.toString() : "");
        m.put("txnType", r.txnType);
        m.put("remarks", r.remarks);
        m.put("productCode", r.productCode);
        return m;
    }


    // Pass-through methods for Controllers
    public BulkUploadStateDto getState(String reqId) {
        return stateManager.getStatusFromRedis(reqId);
    }

    public byte[] getFileBytes(String reqId, String type) {
        return stateManager.getFileBytes(reqId, type);
    }

}


package com.fincore.VoucherService.Service.validation;


import com.fincore.VoucherService.Dto.ExcelRowData;
import com.fincore.VoucherService.Service.ValidationMasterService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import java.math.BigDecimal;
import java.util.List;
import java.util.Set;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.atomic.AtomicReference;

@Service
public class VoucherRuleValidator {

    @Autowired
    private final ValidationMasterService validationMasterService;

    public VoucherRuleValidator(ValidationMasterService validationMasterService) {
        this.validationMasterService = validationMasterService;
    }


    // ==================================================================================
    // 4. VALIDATION STAGES
    // ==================================================================================

    public void runFormatCheck(List<ExcelRowData> rows) {
        rows.parallelStream().forEach(d -> {

            // 1. Safely grab the value, remove all spaces, and make it uppercase
            String rawType = (d.txnType != null) ? d.txnType.trim().toUpperCase() : "";

            // 2. Check the cleaned value and instantly standardize it to full words
            if (rawType.equals("CR") || rawType.equals("CREDIT")) {
                d.txnType = "Credit";
            }
            else if (rawType.equals("DR") || rawType.equals("DEBIT")) {
                d.txnType = "Debit";
            }
            else {
                synchronized(d.formatErrors) {
                    d.formatErrors.add("The transaction type must be 'CR', 'DR', 'Debit', or 'Credit' (case-insensitive)");
                }
            }


            // Amount
            if (d.amount == null || d.amount.compareTo(BigDecimal.ZERO) <= 0) {
                synchronized(d.formatErrors) { d.formatErrors.add("Amount must be greater than 0."); }
            } else if (d.amount.precision() > 20 || d.amount.scale() > 4) {
                synchronized(d.formatErrors) { d.formatErrors.add("Exceeded maximum 16 digits or 4 decimal places."); }
            }


            // Product Code
            if (d.productCode != null && !d.productCode.isEmpty() && !d.productCode.equals("A") && !d.productCode.matches("^[0-9]{1,8}$")) {
                synchronized(d.formatErrors) { d.formatErrors.add("Product code must be up to 8 digits or left blank."); }
            }

            // Remarks (Alphanumeric, single spaces, and specific special characters)
            if (d.remarks == null || d.remarks.trim().length() < 2 || d.remarks.trim().length() > 30) {
                synchronized(d.formatErrors) {
                    d.formatErrors.add("Remarks must be 2-30 characters.");
                }
            } else if (d.remarks.startsWith(" ") || d.remarks.contains("  ")) {
                synchronized(d.formatErrors) {
                    d.formatErrors.add("Remarks cannot start with a space or contain consecutive spaces.");
                }
            } else if (!d.remarks.matches("^[a-zA-Z0-9 /&(),.\\-]+$")) {
                synchronized(d.formatErrors) {
                    d.formatErrors.add("Allowed 2-30 chars: Alphanumeric, spaces, and / & ( ) , . -");
                }
            }

            // Currency
            if (d.currency == null || d.currency.length() != 3) {
                synchronized(d.formatErrors) { d.formatErrors.add("Currency code must be exactly 3 characters."); }
            }

            // CGL (Strictly 10 digits)
            if (d.cgl == null || d.cgl.isEmpty()) {
                synchronized(d.formatErrors) { d.formatErrors.add("CGL is mandatory."); }
            } else if (!d.cgl.matches("^[0-9]{10}$")) {
                synchronized(d.formatErrors) { d.formatErrors.add("CGL must be exactly 10 digits."); }
            }

            // Branch (Strictly 5 alphanumeric characters)
            if (d.branch == null || d.branch.trim().isEmpty()) {
                synchronized(d.formatErrors) { d.formatErrors.add("Branch code is mandatory."); }
            } else if (!d.branch.matches("^[a-zA-Z0-9]{5}$")) {
                synchronized(d.formatErrors) { d.formatErrors.add("Branch code must be exactly 5 alphanumeric characters."); }
            }
        });
    }

    public void runDbCheck(List<ExcelRowData> rows) {
        Set<String> validBranches = validationMasterService.getAllActiveBranches();
        Set<String> validCurrs = validationMasterService.getAllActiveCurrencies();
        Set<String> validCgls = validationMasterService.getAllActiveCgls();

        rows.parallelStream().forEach(d -> {
            if (d.branch != null && !d.branch.isEmpty() && !validBranches.contains(d.branch))
                d.dbErrors.add("Branch is inactive or not found: " + d.branch);
            if (d.currency != null && !d.currency.isEmpty() && !validCurrs.contains(d.currency))
                d.dbErrors.add("Currency is inactive or not found: " + d.currency);
            if (d.cgl != null && !d.cgl.isEmpty() && !validCgls.contains(d.cgl))
                d.dbErrors.add("CGL is inactive or not found: " + d.cgl);
        });
    }


    /**
     * Rule 5: Balance Integrity Logic.
     * Uses LongAdder with 10^4 scale shift to perform precise integer arithmetic
     * on parallel streams, preventing floating-point drift in large batches.
     */
    public void runBalanceCheck(List<ExcelRowData> rows) {
    ConcurrentHashMap<String, AtomicReference<BigDecimal>> balanceMap = new ConcurrentHashMap<>();
        ConcurrentHashMap<String, Boolean> branchHasDebit = new ConcurrentHashMap<>();
        ConcurrentHashMap<String, Boolean> branchHasCredit = new ConcurrentHashMap<>();

        // Pass 1: Aggregate totals and check for presence
        rows.parallelStream().forEach(d -> {
            if (d.branch == null || d.currency == null || d.cgl == null || d.amount == null || d.txnType == null) return;

            // Track Debit/Credit Presence per Branch
            if ("Debit".equalsIgnoreCase(d.txnType)) branchHasDebit.put(d.branch, true);
            if ("Credit".equalsIgnoreCase(d.txnType)) branchHasCredit.put(d.branch, true);

            // Calculate Balance Groupings
            boolean isCredit = "Credit".equalsIgnoreCase(d.txnType);
            BigDecimal finalVal = isCredit ? d.amount.negate() : d.amount;

            String type = d.cgl.startsWith("5") ? "MEMO" : "NORMAL";
            String balKey = d.branch + "_" + d.currency + "_" + type;

            // Thread-safe BigDecimal addition without scaling or overflow risks
            balanceMap.computeIfAbsent(balKey, k -> new AtomicReference<>(BigDecimal.ZERO))
                    .updateAndGet(curr -> curr.add(finalVal));
        });

        // Pass 2: Apply the simple, generic error messages to the rows
        rows.parallelStream().forEach(d -> {
            if (d.branch == null || d.currency == null || d.cgl == null || d.amount == null || d.txnType == null) return;

            Boolean hasDeb = branchHasDebit.getOrDefault(d.branch, false);
            Boolean hasCred = branchHasCredit.getOrDefault(d.branch, false);

            String type = d.cgl.startsWith("5") ? "MEMO" : "NORMAL";
            String balKey = d.branch + "_" + d.currency + "_" + type;
            AtomicReference<BigDecimal> adder = balanceMap.get(balKey);

            synchronized (d.balErrors) {
                // 1. Debit/Credit Presence Check
                if ((!hasDeb || !hasCred) && !d.balErrors.contains("Branch must have at least one Debit and one Credit entry.")) {
                    d.balErrors.add("Branch must have at least one Debit and one Credit entry.");
                }

                // 2. Balance Math Check (Using BigDecimal's compareTo)
                if (adder != null && adder.get().compareTo(BigDecimal.ZERO) != 0 && !d.balErrors.contains("Branch, Currency, and CGL-wise balance mismatch.")) {
                    d.balErrors.add("Branch, Currency, and CGL-wise balance mismatch.");
                }
            }
        });
    }
}
