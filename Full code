package com.fincore.VoucherService.Dto;

import jakarta.validation.constraints.NotBlank;
import jakarta.validation.constraints.Pattern;
import jakarta.validation.constraints.AssertTrue;
import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.NoArgsConstructor;
import org.apache.htrace.fasterxml.jackson.annotation.JsonIgnoreProperties;

@Data
@NoArgsConstructor
@AllArgsConstructor
@JsonIgnoreProperties(ignoreUnknown = true)
public class VoucherRowDto {

    @NotBlank(message = "Branch is mandatory")
    private String branch;

    @NotBlank(message = "Currency is mandatory")
    private String currency;

    @NotBlank(message = "CGL is mandatory")
    private String cgl;

    // Allows optional '-', up to 16 digits, and optional decimal up to 4 places
    @NotBlank(message = "Amount is mandatory")
    @Pattern(regexp = "^-?\\d{1,16}(\\.\\d{1,4})?$", message = "Amount must be a valid number with up to 16 digits and a maximum of 4 decimal places")
    private String amount;

    // Optional field, so we just restrict it to 0-8 digits
    @Pattern(regexp = "^\\d{0,8}$", message = "Product Code must be a maximum of 8 digits")
    private String productCode;

    @NotBlank(message = "Remarks are mandatory")
    @Pattern(regexp = "^[a-zA-Z0-9]{2,30}$", message = "Remarks must be between 2 and 30 alphanumeric characters")
    private String remarks;

    @NotBlank(message = "AR Flag is mandatory")
    private String arFlag;

    // --- CROSS-FIELD VALIDATION (The Currency/Decimal Rule) ---
    // Spring Boot will automatically run any method annotated with @AssertTrue during validation
    @AssertTrue(message = "INR currency allows a maximum of 2 decimal places. Other currencies allow up to 4.")
    public boolean isAmountDecimalValid() {
        if (amount == null || currency == null) return true; // Skip if null, let @NotBlank handle the error

        String[] parts = amount.replace("-", "").split("\\.");
        int fractionLength = parts.length > 1 ? parts[1].length() : 0;

        if ("INR".equalsIgnoreCase(currency)) {
            return fractionLength <= 2;
        } else {
            return fractionLength <= 4;
        }
    }


}

package com.fincore.VoucherService.Exception;

import org.springframework.http.HttpStatus;
import org.springframework.web.bind.annotation.ResponseStatus;

/**
 * Centralized custom exceptions for the Journal Service.
 * Provides specific HTTP status mappings for consistent API error responses.
 */
public class CustomExceptions {

    @ResponseStatus(HttpStatus.BAD_REQUEST)
    public static class FileProcessingException extends RuntimeException {
        public FileProcessingException(String message, Throwable cause) { super(message, cause); }
        public FileProcessingException(String message) { super(message); }
    }

    @ResponseStatus(HttpStatus.GONE)
    public static class CacheExpiredException extends RuntimeException {
        public CacheExpiredException(String message) { super(message); }
    }

    @ResponseStatus(HttpStatus.CONFLICT)
    public static class ConcurrencyLockException extends RuntimeException {
        public ConcurrencyLockException(String message) { super(message); }
    }

    @ResponseStatus(HttpStatus.INTERNAL_SERVER_ERROR)
    public static class DatabaseOperationException extends RuntimeException {
        public DatabaseOperationException(String message) { super(message); }
        public DatabaseOperationException(String message, Throwable cause) { super(message, cause); }
    }

    @ResponseStatus(HttpStatus.SERVICE_UNAVAILABLE)
    public static class RedisOperationException extends RuntimeException {
        public RedisOperationException(String message, Throwable cause) { super(message, cause); }
    }

    @ResponseStatus(HttpStatus.UNPROCESSABLE_ENTITY)
    public static class DataMappingException extends RuntimeException {
        public DataMappingException(String message) { super(message); }
    }

    @ResponseStatus(HttpStatus.INTERNAL_SERVER_ERROR)
    public static class BatchProcessingException extends RuntimeException {
        public BatchProcessingException(String message) {
            super(message);
        }

        public BatchProcessingException(String message, Throwable cause) {
            super(message, cause);
        }
    }

    @ResponseStatus(HttpStatus.BAD_REQUEST)
    public static class InvalidDataException extends RuntimeException {
        public InvalidDataException(String message) {
            super(message);
        }
    }
    @ResponseStatus(HttpStatus.CONFLICT)
    public static class ScheduleLapsedException extends RuntimeException {
        public ScheduleLapsedException(String message) {
            super(message);
        }
    }

}


package com.fincore.VoucherService.Exception;

import com.fincore.VoucherService.Dto.ApiErrorResponseDto;
import jakarta.servlet.http.HttpServletRequest;
import lombok.extern.slf4j.Slf4j;
import org.springframework.dao.DataAccessException;
import org.springframework.dao.DataIntegrityViolationException;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.validation.FieldError;
import org.springframework.web.bind.MethodArgumentNotValidException;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.ResponseStatus;
import org.springframework.web.bind.annotation.RestControllerAdvice;
import org.springframework.web.multipart.MaxUploadSizeExceededException;

import java.io.IOException;
import java.time.LocalDateTime;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.stream.Collectors;

/**
 * Centralized error management for consistent and secure API responses.
 */
@RestControllerAdvice
@Slf4j
public class GlobalExceptionHandler {

    @ExceptionHandler(MethodArgumentNotValidException.class)
    public ResponseEntity<ApiErrorResponseDto> handleValidation(MethodArgumentNotValidException ex, HttpServletRequest request) {
        List<ApiErrorResponseDto.ValidationError> errors = ex.getBindingResult().getFieldErrors().stream()
                .map(err -> ApiErrorResponseDto.ValidationError.builder()
                        .field(err.getField())
                        .message(err.getDefaultMessage())
                        .build())
                .collect(Collectors.toList());

        // Join the custom messages for the React frontend Snackbar
        String joinedMessage = ex.getBindingResult().getFieldErrors().stream()
                .map(org.springframework.validation.FieldError::getDefaultMessage)
                .collect(Collectors.joining(" | "));

        log.warn("VALIDATION_FAILED | Path: {} | Errors: {}", request.getRequestURI(), errors.size());

        // Feed the joinedMessage into the response instead of the generic string
        return buildResponse(HttpStatus.BAD_REQUEST, "Validation Failed", joinedMessage, request.getRequestURI(), errors);
    }

    @ExceptionHandler(MaxUploadSizeExceededException.class)
    public ResponseEntity<ApiErrorResponseDto> handleMaxSize(MaxUploadSizeExceededException ex, HttpServletRequest request) {
        log.error("FILE_TOO_LARGE | Path: {}", request.getRequestURI());
        return buildResponse(HttpStatus.PAYLOAD_TOO_LARGE, "File Too Large", "Maximum upload size exceeded", request.getRequestURI(), null);
    }


    @ExceptionHandler(CustomExceptions.FileProcessingException.class)
    public ResponseEntity<ApiErrorResponseDto> handleFileProcessing(CustomExceptions.FileProcessingException ex, HttpServletRequest request) {
        log.error("FILE_PROCESS_ERROR | Path: {} | Type: {}", request.getRequestURI(), ex.getClass().getSimpleName());
        return buildResponse(HttpStatus.BAD_REQUEST, "File Error", "Failed to process the uploaded file.", request.getRequestURI(), null);
    }

    /**
     * FIXED: Removed IllegalStateException from here to resolve the Ambiguous mapping error.
     */
    @ExceptionHandler(CustomExceptions.ConcurrencyLockException.class)
    public ResponseEntity<ApiErrorResponseDto> handleConcurrency(CustomExceptions.ConcurrencyLockException ex, HttpServletRequest request) {
        log.warn("CONCURRENCY_CONFLICT | Path: {} | Message: {}", request.getRequestURI(), ex.getMessage());
        return buildResponse(HttpStatus.CONFLICT, "Operation Conflict", ex.getMessage(), request.getRequestURI(), null);
    }

    @ExceptionHandler(ResourceNotFoundException.class)
    public ResponseEntity<ApiErrorResponseDto> handleNotFound(ResourceNotFoundException ex, HttpServletRequest request) {
        log.info("RESOURCE_NOT_FOUND | Path: {} | Resource: {}", request.getRequestURI(), ex.getMessage());
        return buildResponse(HttpStatus.NOT_FOUND, "Not Found", ex.getMessage(), request.getRequestURI(), null);
    }

    @ExceptionHandler(CustomExceptions.CacheExpiredException.class)
    public ResponseEntity<ApiErrorResponseDto> handleCacheExpired(CustomExceptions.CacheExpiredException ex, HttpServletRequest request) {
        log.warn("CACHE_EXPIRED | Path: {}", request.getRequestURI());
        return buildResponse(HttpStatus.GONE, "Session Expired", ex.getMessage(), request.getRequestURI(), null);
    }

    @ExceptionHandler(DataIntegrityViolationException.class)
    public ResponseEntity<ApiErrorResponseDto> handleSqlIntegrity(DataIntegrityViolationException ex, HttpServletRequest request) {
        log.error("DB_INTEGRITY_VIOLATION | Path: {} | Type: Constraint violation", request.getRequestURI());
        return buildResponse(HttpStatus.CONFLICT, "Data Integrity Error", "Constraint violation or duplicate entry.", request.getRequestURI(), null);
    }


    @ExceptionHandler(IOException.class)
    public ResponseEntity<ApiErrorResponseDto> handleIoException(IOException ex, HttpServletRequest request) {
        log.error("IO_STREAM_FAILURE | Path: {} | Type: {}", request.getRequestURI(), ex.getClass().getSimpleName());
        return buildResponse(HttpStatus.INTERNAL_SERVER_ERROR, "IO Error", "Internal storage access failure.", request.getRequestURI(), null);
    }


    @ExceptionHandler(IllegalStateException.class)
    public ResponseEntity<ApiErrorResponseDto> handleStateErrors(IllegalStateException ex, HttpServletRequest request) {
        log.warn("INVALID_STATE | Path: {} | Msg: {}", request.getRequestURI(), ex.getMessage());
        return buildResponse(HttpStatus.CONFLICT, "Invalid State", ex.getMessage(), request.getRequestURI(), null);
    }

    @ExceptionHandler({NullPointerException.class, ArrayIndexOutOfBoundsException.class})
    public ResponseEntity<ApiErrorResponseDto> handleInternalLogicErrors(Exception ex, HttpServletRequest request) {
        log.error("INTERNAL_LOGIC_ERROR | Path: {} | Type: {}", request.getRequestURI(), ex.getClass().getSimpleName());
        return buildResponse(HttpStatus.INTERNAL_SERVER_ERROR, "Processing Error", "An internal error occurred.", request.getRequestURI(), null);
    }

    private ResponseEntity<ApiErrorResponseDto> buildResponse(HttpStatus status, String error, String message, String path, List<ApiErrorResponseDto.ValidationError> validationErrors) {
        ApiErrorResponseDto response = ApiErrorResponseDto.builder()
                .timestamp(LocalDateTime.now())
                .status(status.value())
                .error(error)
                .message(message)
                .path(path)
                .validationErrors(validationErrors)
                .build();
        return new ResponseEntity<>(response, status);
    }


    @ExceptionHandler(org.springframework.dao.DataAccessException.class)
    public ResponseEntity<ApiErrorResponseDto> handleDatabaseOperation(
            org.springframework.dao.DataAccessException ex,
            jakarta.servlet.http.HttpServletRequest request) {

        String errorCode = "DB_TECHNICAL_ERROR";

        Throwable cause = ex;
        while (cause != null) {
            if (cause instanceof java.sql.SQLException sqlEx) {
                errorCode = "ORA-" + sqlEx.getErrorCode();
                break;
            }
            cause = cause.getCause();
        }

        // 2. Log the sanitized code + the actual message for backend debugging
        log.error("DATABASE_FAULT | Path: {} | ErrorCode: {} | Real Message: {}",
                request.getRequestURI(), errorCode, ex.getMessage());

        // 3. Return a clean, safe response to the frontend
        return buildResponse(
                HttpStatus.INTERNAL_SERVER_ERROR,
                "Database Error",
                "A technical error occurred in the data layer. Reference: " + errorCode,
                request.getRequestURI(),
                null
        );
    }


    @ExceptionHandler(CustomExceptions.InvalidDataException.class)
    public ResponseEntity<ApiErrorResponseDto> handleInvalidData(CustomExceptions.InvalidDataException ex, HttpServletRequest request) {
        log.warn("INVALID_DATA | Path: {} | Msg: {}", request.getRequestURI(), ex.getMessage());
        return buildResponse(HttpStatus.BAD_REQUEST, "Invalid Data", ex.getMessage(), request.getRequestURI(), null);
    }
    @ExceptionHandler(CustomExceptions.ScheduleLapsedException.class)
    public ResponseEntity<ApiErrorResponseDto> handleScheduleLapsed(CustomExceptions.ScheduleLapsedException ex, HttpServletRequest request) {
        log.warn("SCHEDULE_LAPSED | Path: {} | Msg: {}", request.getRequestURI(), ex.getMessage());
        return buildResponse(HttpStatus.CONFLICT, "SCHEDULE_LAPSED", ex.getMessage(), request.getRequestURI(), null);
    }

    // Catches JSON parsing crashes BEFORE they fall into the generic IOException bucket
    @ExceptionHandler(org.springframework.http.converter.HttpMessageNotReadableException.class)
    public ResponseEntity<com.fincore.VoucherService.Dto.ApiErrorResponseDto> handleJsonParseError(org.springframework.http.converter.HttpMessageNotReadableException ex, jakarta.servlet.http.HttpServletRequest request) {
        log.error("JSON_PARSE_ERROR | Path: {} | Reason: {}", request.getRequestURI(), ex.getMostSpecificCause().getMessage());

        // This gives you a 400 Bad Request with the EXACT reason, instead of a 500 IO Error.
        return buildResponse(
                org.springframework.http.HttpStatus.BAD_REQUEST,
                "Malformed JSON Payload",
                "The server could not read the request. Reason: " + ex.getMostSpecificCause().getMessage(),
                request.getRequestURI(),
                null
        );
    }
}


