int variableSlidingWindow(int[] arr, int n) {
    int low = 0;
    int result = 0; // Or Integer.MAX_VALUE for "shortest" problems
    
    // State tracking (choose one based on problem: sum, map, set, etc.)
    int currentSum = 0; 
    // OR HashMap<Character, Integer> freqMap = new HashMap<>();

    // 1. EXPAND: 'high' always moves forward to include new elements
    for (int high = 0; high < n; high++) {
        
        // --- Add new element to window state ---
        currentSum += arr[high]; 
        // OR: freqMap.put(arr[high], freqMap.getOrDefault(arr[high], 0) + 1);

        // 2. SHRINK: Move 'low' forward ONLY while condition is INVALID
        // Example Condition: If finding min subarray with sum >= target
        // We shrink while the window is "too big" (valid) to find the minimum,
        // OR shrink while "invalid" depending on specific problem logic.
        // Standard "Longest Valid" logic: Shrink while INVALID.
        while (isConditionInvalid(currentSum, arr, low, high)) {
            
            // --- Remove outgoing element from state ---
            currentSum -= arr[low];
            // OR: freqMap.put(arr[low], freqMap.get(arr[low]) - 1);
            
            low++; // Contract window
        }

        // 3. UPDATE RESULT: Window [low, high] is now VALID
        // Calculate length: high - low + 1
        result = Math.max(result, high - low + 1);
    }
    
    return result;
}

