                rowId = String.valueOf(lfarReportMasterListRepository.getSeqId());
            }
            lfar2.setId(Integer.parseInt(rowId));

            // Construct the file name and file
            String fileName = lfar2.getId() + "_" + branch_code + "_" + quarterFolder + "_" + "Lfar2Observation"+ ".pdf";
            log.info("evidence " + data.get("evidence") );
