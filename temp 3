    private byte[] generateErrorExcel(List<ExcelRowData> rows) throws IOException {
        try (SXSSFWorkbook workbook = new SXSSFWorkbook(100)) {
            workbook.setCompressTempFiles(true);
            Sheet sheet = workbook.createSheet("Error Report");

            // Define Styles (Red for Errors)
            CellStyle errStyle = workbook.createCellStyle();
            Font errFont = workbook.createFont();
            errFont.setColor(IndexedColors.RED.getIndex());
            errStyle.setFont(errFont);

            Row header = sheet.createRow(0);
            String[] headers = {"Branch", "Currency", "CGL", "Amount", "ERRORS"};
            for(int i=0; i<headers.length; i++) header.createCell(i).setCellValue(headers[i]);

            int idx = 1;
            for(ExcelRowData d : rows) {
                Row r = sheet.createRow(idx++);
                r.createCell(0).setCellValue(d.branch);
                r.createCell(1).setCellValue(d.currency);
                r.createCell(2).setCellValue(d.cgl);
                r.createCell(3).setCellValue(d.amount != null ? d.amount.toString() : "");
                if(!d.errors.isEmpty()) {
                    Cell c = r.createCell(4);
                    c.setCellValue(String.join("; ", d.errors));
                    c.setCellStyle(errStyle);
                }
            }
            ByteArrayOutputStream out = new ByteArrayOutputStream();
            workbook.write(out);
            workbook.dispose();
            return out.toByteArray();
        }
    }

