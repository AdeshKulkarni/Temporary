import React, { useState, useRef, useEffect } from "react";
import {
  Box, Typography, Paper, TextField, Button, CircularProgress, Chip, Alert, Stack,
  Stepper, Step, StepLabel
} from "@mui/material";
import {
  CloudUpload, RestartAlt, Description, CheckCircle, Error as ErrorIcon, Download, Send,
  FormatListBulleted, Storage, Balance, DoneAll
} from "@mui/icons-material";
import { DataGrid } from "@mui/x-data-grid";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import { mainContainerStyle, uploadBoxStyle, controlPanelStyle, iconStyle, headerTextStyle, subTextStyle, dateinputfield, stepperContainerStyle, stepLabelStyle } from "./JournalBulkStyle";

const steps = ['Format Validation', 'Database Check', 'Balance Check', 'Finalizing'];

const JournalBulkUpload = () => {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  const [selectedDate, setSelectedDate] = useState("");
  const [file, setFile] = useState(null);
  
  const [requestId, setRequestId] = useState(null);
  const [activeStep, setActiveStep] = useState(0);
  const [failedStep, setFailedStep] = useState(-1); // -1 = None
  const [isProcessing, setIsProcessing] = useState(false);
  const [result, setResult] = useState(null);

  const fileInputRef = useRef(null);

  // Poll Status
  useEffect(() => {
    let interval;
    if (isProcessing && requestId) {
      interval = setInterval(async () => {
        try {
          const res = await callApi(`/JS/journals/bulk-status/${requestId}`, null, "GET");
          if (!res) return;

          // Update Stepper (Backend Stage 1..4 maps to Index 0..3)
          if (res.currentStage > 0) setActiveStep(res.currentStage - 1);

          if (res.status === "ERROR") {
            setIsProcessing(false);
            setFailedStep(res.currentStage - 1);
            setActiveStep(res.currentStage - 1);
            setResult(res);
            clearInterval(interval);
            showSnackBar(res.message, "error");
          } else if (res.status === "SUCCESS") {
            setIsProcessing(false);
            setActiveStep(4); // All done
            setResult(res);
            clearInterval(interval);
            showSnackBar("Validation Successful!", "success");
          }
        } catch (e) {}
      }, 1000);
    }
    return () => clearInterval(interval);
  }, [isProcessing, requestId]);

  const startValidation = async () => {
    if (!file || !selectedDate) { showSnackBar("Select Date and File", "warning"); return; }
    
    // Reset UI
    setActiveStep(0); setFailedStep(-1); setResult(null); setIsProcessing(true);

    const formData = new FormData();
    formData.append("file", file);
    formData.append("postingDate", selectedDate);

    try {
      const res = await callApi("/JS/journals/bulk-validate-init", formData, "POST", "json", "multipart/form-data");
      setRequestId(res.requestId);
    } catch (e) {
      setIsProcessing(false);
    }
  };

  const downloadFile = (type) => {
    const baseUrl = process.env.REACT_APP_API_URL || "http://localhost:8080";
    window.location.href = `${baseUrl}/JS/journals/download-bulk-file/${requestId}?type=${type}`;
  };

  const columns = [
    { field: "branch", headerName: "Branch", flex: 1 },
    { field: "currency", headerName: "Currency", width: 100 },
    { field: "cgl", headerName: "CGL", flex: 1.5 },
    { field: "amount", headerName: "Amount", flex: 1.5, align: "right" },
    { field: "remarks", headerName: "Remarks", flex: 2 }
  ];

  return (
    <Box sx={mainContainerStyle}>
      <Paper elevation={1} sx={controlPanelStyle}>
        
        {/* Date */}
        <Box sx={dateinputfield}>
            <TextField type="date" label="Posting Date" size="small"
                value={selectedDate} onChange={(e) => setSelectedDate(e.target.value)}
                InputLabelProps={{ shrink: true }} inputProps={{ max: new Date().toISOString().split("T")[0] }} />
        </Box>

        {/* Upload */}
        <Box sx={uploadBoxStyle} onClick={() => fileInputRef.current.click()}>
          <input type="file" hidden accept=".xlsx,.xls,.csv" onChange={(e) => { if(e.target.files[0]) setFile(e.target.files[0]); }} ref={fileInputRef} />
          {file ? ( <><Description color="success" sx={{ fontSize: 60 }} /><Typography sx={headerTextStyle}>{file.name}</Typography></> ) 
                : ( <><CloudUpload sx={iconStyle} /><Typography sx={headerTextStyle}>Click to Upload</Typography></> )}
        </Box>

        {/* Stepper */}
        {(isProcessing || activeStep > 0 || failedStep !== -1) && (
            <Box sx={stepperContainerStyle}>
                <Stepper activeStep={activeStep} alternativeLabel>
                    {steps.map((label, index) => (
                        <Step key={label}>
                            <StepLabel error={index === failedStep} StepIconComponent={() => {
                                if (index === failedStep) return <ErrorIcon color="error" />;
                                if (index < activeStep) return <CheckCircle color="success" />;
                                return <CircularProgress size={24} sx={{ display: index === activeStep && isProcessing ? 'block' : 'none' }} />;
                            }}>{label}</StepLabel>
                        </Step>
                    ))}
                </Stepper>
                {isProcessing && <Typography variant="caption" align="center" display="block" sx={{ mt: 1 }}>Processing...</Typography>}
            </Box>
        )}

        {/* Buttons */}
        <Stack direction="row" justifyContent="center" spacing={2} sx={{ mt: 2 }}>
            <Button variant="contained" onClick={startValidation} disabled={isProcessing || !file}>
                {isProcessing ? "Validating..." : "Validate"}
            </Button>
            <Button variant="outlined" color="error" onClick={() => window.location.reload()}>Reset</Button>
        </Stack>

        {/* Results */}
        <Box sx={{ mt: 3 }}>
            {result?.status === "ERROR" && (
                <Alert severity="error" action={
                    <Button color="inherit" size="small" onClick={() => downloadFile("ERROR")}>Download Report</Button>
                }>
                    Validation Failed: {result.message} ({result.errorCount} Errors)
                </Alert>
            )}

            {result?.status === "SUCCESS" && (
                <Paper variant="outlined" sx={{ p: 2, borderColor: "success.main" }}>
                    <Stack direction="row" justifyContent="space-between" alignItems="center">
                        <Box><Typography fontWeight="bold" color="success.main">Success!</Typography><Typography variant="body2">{result.totalRows} rows ready.</Typography></Box>
                        <Stack direction="row" spacing={2}>
                            <Button variant="outlined" onClick={() => downloadFile("SUCCESS")}>Download CSV</Button>
                            <Button variant="contained" color="success">Create Batch</Button>
                        </Stack>
                    </Stack>
                </Paper>
            )}
        </Box>
      </Paper>

      {result?.previewData && (
         <Paper elevation={1} sx={{ mt: 3, height: 500, width: '100%' }}>
             <DataGrid rows={JSON.parse(result.previewData)} columns={columns} />
         </Paper>
      )}
    </Box>
  );
};

export default JournalBulkUpload;

