    }
    return <Stack direction="row" spacing={1} alignItems="center">{icon}<Typography variant="body2" sx={textSx}>{label}</Typography></Stack>;
  };

  const columns = [
    { field: "branch", headerName: "Branch", flex: 1, align: "center", headerAlign: "center" },
    { field: "currency", headerName: "Currency", width: 100, align: "center", headerAlign: "center" },
    { field: "cgl", headerName: "CGL", flex: 1.5, align: "center", headerAlign: "center" },
    { field: "productCode", headerName: "Product", width: 120, align: "center", headerAlign: "center", renderCell: (p) => p.value || "-" },
    { field: "amount", headerName: "Amount", flex: 1.5, minWidth: 150, align: "right", headerAlign: "center", valueFormatter: (params) => { const val = params?.value || params; if (!val) return "0.00"; return val; } },
    { field: "txnType", headerName: "Type", width: 100, align: "center", headerAlign: "center", renderCell: (params) => ( <Chip label={params.value} color={params.value && (params.value.includes("CR") || params.value.includes("Credit")) ? "error" : "success"} size="small" variant="filled" sx={chipStyle} /> ) },
    { field: "remarks", headerName: "Remarks", flex: 2, align: "center", headerAlign: "center" },
  ];

  return (
    <Box sx={mainContainerStyle}>
      <Paper elevation={1} sx={controlPanelStyle}>
        <Box sx={{ display: 'flex', justifyContent: 'flex-end', mb: 2 }}>
          <Button variant="text" startIcon={<FileDownloadIcon />} onClick={handleDownloadTemplate}>Download Template</Button>
        </Box>
        <Stepper activeStep={activeStep} sx={{ mb: 4 }} alternativeLabel>
          {steps.map((label) => ( <Step key={label}><StepLabel>{label}</StepLabel></Step> ))}
        </Stepper>

        {activeStep === 0 && (
          <Fade in={true}>
            <Box>
              <Box sx={dateinputfield}>
                 <TextField type="date" label="Posting Date" value={selectedDate} onChange={handleDateChange} InputLabelProps={{ shrink: true }} size="small" disabled={isProcessing} sx={{ width: 200 }} />
              </Box>
              <Box sx={{...uploadBoxStyle, borderColor: resultStatus === 'ERROR' ? 'error.main' : 'primary.main', opacity: isProcessing ? 0.6 : 1}} onClick={() => { if (!isProcessing) fileInputRef.current.click(); }}>
                <input type="file" hidden ref={fileInputRef} onChange={handleFileSelect} accept=".xlsx,.csv" />
                {file ? (<><DescriptionIcon sx={{ fontSize: 60, color: "success.main", mb: 1 }} /><Typography sx={headerTextStyle}>{file.name}</Typography><Typography sx={subTextStyle}>Click to change</Typography></>) : (<><CloudUploadIcon sx={iconStyle} /><Typography sx={headerTextStyle}>Click to Upload File</Typography><Typography sx={subTextStyle}>.xlsx, .csv (Max 50MB)</Typography></>)}
              </Box>
              {(isProcessing || resultStatus) && (
                  <Box sx={{ mt: 3, p: 2, border: '1px solid', borderColor: 'divider', borderRadius: 2 }}>
                      <Typography variant="subtitle2" sx={{ mb: 2, color: 'text.secondary' }}>Validation Status:</Typography>
                      <Grid container spacing={2}>
                          <Grid item xs={12} md={4}>{renderValidationItem(1, "Format Checks (Date, Headers)")}</Grid>
                          <Grid item xs={12} md={4}>{renderValidationItem(2, "Database Checks (Branch, CGL)")}</Grid>
                          <Grid item xs={12} md={4}>{renderValidationItem(3, "Balance Checks (Dr/Cr)")}</Grid>
                      </Grid>
                      {resultStatus === 'ERROR' && <Alert severity="error" sx={alertStyle}>Validation Failed. Please correct errors.</Alert>}
                  </Box>
              )}
              <Stack direction="row" sx={actionButtonsContainer}>
                <Button variant="contained" size="large" onClick={handleStartValidation} disabled={!file || !selectedDate || isProcessing} startIcon={isProcessing ? <CircularProgress size={20} color="inherit"/> : <SendIcon/>}> {isProcessing ? "Validating..." : "Start Validation"} </Button>
              </Stack>
            </Box>
          </Fade>
        )}

        {activeStep === 1 && (
          <Fade in={true}>
            <Box>
              <Stack direction="row" justifyContent="space-between" alignItems="center" sx={{mb: 2}}>
                  <Alert severity="success" sx={{ flexGrow: 1, mr: 2 }}>Validation Successful! Total Rows: {totalRows.toLocaleString()}</Alert>
                  <Button variant="outlined" startIcon={<FileDownloadIcon />} onClick={() => handleDownloadFile("SUCCESS")}>Download CSV</Button>
              </Stack>
              <Paper elevation={1} sx={dataGridContainerStyle}>
                <Box sx={dataGridHeaderBoxStyle}> <Typography variant="h6" sx={dataGridTitleStyle}>Data Preview</Typography> </Box>
                <DataGrid rows={previewRows} columns={columns} initialState={{ pagination: { paginationModel: { pageSize: 50 } }, }} pageSizeOptions={[50, 100, 150]} disableSelectionOnClick density="comfortable" sx={{ border: "none" }} />
              </Paper>
              <Stack direction="row" sx={actionButtonsContainer}>
                <Button variant="outlined" onClick={resetAll} disabled={isCreatingBatch} startIcon={<RestartAltIcon />}>Cancel & Upload Again</Button>
                <Button variant="contained" color="success" size="large" onClick={handleCreateBatch} disabled={isCreatingBatch} startIcon={isCreatingBatch ? <CircularProgress size={20} color="inherit" /> : <SendIcon />}> {isCreatingBatch ? "Creating Batch..." : "Create Batch"} </Button>
              </Stack>
            </Box>
          </Fade>
        )}
      </Paper>
    </Box>
  );
};
export default JournalBulkUpload;

