    private List<ExcelRowData> parseCsvBytes(byte[] bytes) throws IOException {
        List<ExcelRowData> list = new ArrayList<>();
        try(BufferedReader br = new BufferedReader(new InputStreamReader(new ByteArrayInputStream(bytes), StandardCharsets.UTF_8))) {
            String line; int i=0;
            while((line=br.readLine())!=null) {
                if(line.trim().isEmpty()) continue;
                String[] c = line.split(",", -1); 
                if (i == 0) {
                     String headerCheck = c.length > 0 ? c[0].trim().toLowerCase() : "";
                     if ((headerCheck.contains("branch") || headerCheck.contains("batch")) && !headerCheck.equals("01")) { i++; continue; }
                }
                ExcelRowData d = new ExcelRowData();
                d.rowIndex = i++;
                if (c.length >= 14) {
                    d.isSystemFormat = true; d.sysSite=c[0]; d.sysDate=c[1]; d.sysYear=c[2]; d.sysPeriod=c[3];
                    validateSystemColumns(d, c[0], c[1], c[2], c[3], c[11], c[12], c[13]);
                    d.branch = c[4].trim(); d.currency = c[5].trim(); d.cgl = c[6].trim();
                    parseAmount(d, c[7].trim(), c[8].trim()); d.remarks = c[9].trim();
                    String rawProd = c[10].trim(); d.productCode = rawProd.isEmpty() ? "A" : rawProd;
                } else if (c.length >= 7) {
                    if (c[0].trim().equals("01")) d.formatErrors.add("Invalid System File Format: Missing Columns");
                    else {
                        d.branch = c[0].trim(); d.currency = c[1].trim(); d.cgl = c[2].trim();
                        parseAmount(d, c[3].trim(), c[4].trim()); d.remarks = c[5].trim();
                        String rawProd = c.length > 6 ? c[6].trim() : ""; d.productCode = rawProd.isEmpty() ? "A" : rawProd;
                    }
                } else { d.formatErrors.add("Invalid CSV Format"); }
                list.add(d);
            }
        }
        return list;
    }

