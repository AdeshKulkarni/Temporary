2. Backend: JournalBulkValidationService.java (Redis + 4 Stages)
This service now manages the entire lifecycle in Redis. It checks the 4 stages sequentially and stops immediately if one fails.
package com.fincore.JournalService.Service;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.fincore.JournalService.Dto.BulkUploadStateDto;
import com.fincore.JournalService.Models.*;
import com.fincore.JournalService.Repository.*;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import org.apache.poi.ss.usermodel.*;
import org.apache.poi.xssf.streaming.SXSSFWorkbook;
import org.apache.poi.xssf.usermodel.XSSFWorkbook;
import org.springframework.data.redis.core.StringRedisTemplate;
import org.springframework.scheduling.annotation.Async;
import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;

import java.io.*;
import java.math.BigDecimal;
import java.math.RoundingMode;
import java.nio.charset.StandardCharsets;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.*;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.TimeUnit;
import java.util.concurrent.atomic.LongAdder;
import java.util.regex.Pattern;
import java.util.stream.Collectors;

@Service
@RequiredArgsConstructor
@Slf4j
public class JournalBulkValidationService {

    private final BranchMasterRepository branchRepo;
    private final CglMasterRepository cglRepo;
    private final CurrencyMasterRepository currencyRepo;
    private final StringRedisTemplate redisTemplate;
    private final ObjectMapper objectMapper;

    private static final Pattern CLEAN_AMOUNT_REGEX = Pattern.compile("[^0-9.-]");
    private static final Pattern PRODUCT_CODE_REGEX = Pattern.compile("^\\d{8}$");
    private static final Pattern CGL_FORMAT_REGEX = Pattern.compile("^\\d{10}$"); 

    // Redis Key Constants
    private static final String KEY_META = "journal:upload:meta:";
    private static final String KEY_FILE_ERR = "journal:upload:file:err:";
    private static final String KEY_FILE_SUC = "journal:upload:file:suc:";
    private static final long TTL_MINUTES = 60;

    private static class ExcelRowData {
        int rowIndex;
        String branch = "", currency = "", cgl = "", txnType = "", remarks = "", productCode = "";
        BigDecimal amount;
        // Categorized Errors
        List<String> formatErrors = Collections.synchronizedList(new ArrayList<>());
        List<String> dbErrors = Collections.synchronizedList(new ArrayList<>());
        List<String> balErrors = Collections.synchronizedList(new ArrayList<>());
        
        boolean hasErrors() { return !formatErrors.isEmpty() || !dbErrors.isEmpty() || !balErrors.isEmpty(); }
    }

    // --- 1. INITIATE ---
    public String initiateValidation(MultipartFile file, LocalDate postingDate) throws IOException {
        String requestId = UUID.randomUUID().toString();

        // Init Redis State
        BulkUploadStateDto state = new BulkUploadStateDto();
        state.setRequestId(requestId);
        state.setStatus("PROCESSING");
        state.setCurrentStage(1); 
        state.setMessage("Validating Formats...");
        saveState(state);

        byte[] fileBytes = file.getBytes();
        String filename = file.getOriginalFilename();
        
        // Fire Async
        processAsync(requestId, fileBytes, filename, postingDate);

        return requestId;
    }

    // --- 2. ASYNC PIPELINE ---
    @Async("bulkExecutor") // Ensure AsyncConfig is present
    public void processAsync(String requestId, byte[] fileBytes, String filename, LocalDate postingDate) {
        try {
            // 0. Parse
            List<ExcelRowData> rows;
            if (filename != null && (filename.toLowerCase().endsWith(".csv") || filename.toLowerCase().endsWith(".txt"))) {
                rows = parseCsvBytes(fileBytes);
            } else {
                rows = parseExcelBytes(fileBytes);
            }
            boolean isInputCsv = filename != null && filename.toLowerCase().endsWith(".csv");

            // Update Total
            int total = rows.size();
            updateState(requestId, s -> s.setTotalRows(total));

            // --- STAGE 1: FORMAT CHECK ---
            if (runFormatCheck(rows)) {
                failRequest(requestId, rows, "Format Validation Failed", 1);
                return;
            }
            updateState(requestId, s -> { s.setCurrentStage(2); s.setMessage("Checking Database..."); });

            // --- STAGE 2: DB CHECK ---
            if (runDbCheck(rows)) {
                failRequest(requestId, rows, "Database Validation Failed", 2);
                return;
            }
            updateState(requestId, s -> { s.setCurrentStage(3); s.setMessage("Checking Balances..."); });

            // --- STAGE 3: BALANCE CHECK ---
            if (runBalanceCheck(rows)) {
                failRequest(requestId, rows, "Debit/Credit Balance Mismatch", 3);
                return;
            }

            // --- STAGE 4: SUCCESS ---
            completeRequest(requestId, rows, postingDate, isInputCsv);

        } catch (Exception e) {
            log.error("Async Error", e);
            updateState(requestId, s -> { s.setStatus("ERROR"); s.setMessage("System Error: " + e.getMessage()); });
        }
    }

    // --- STAGE LOGIC ---

    private boolean runFormatCheck(List<ExcelRowData> rows) {
        rows.parallelStream().forEach(d -> {
            if (d.branch == null || d.branch.isEmpty()) d.formatErrors.add("Branch Empty");
            if (d.currency == null || d.currency.length() != 3) d.formatErrors.add("Invalid Currency (3 chars)");
            if (d.cgl == null || !CGL_FORMAT_REGEX.matcher(d.cgl).matches()) d.formatErrors.add("Invalid CGL (10 digits)");
            if (d.amount == null || d.amount.compareTo(BigDecimal.ZERO) == 0) d.formatErrors.add("Invalid Amount");
            if (d.productCode != null && !d.productCode.isEmpty() && !PRODUCT_CODE_REGEX.matcher(d.productCode).matches()) {
                d.formatErrors.add("Invalid Product Code (8 digits)");
            }
        });
        return rows.stream().anyMatch(ExcelRowData::hasErrors);
    }

    private boolean runDbCheck(List<ExcelRowData> rows) {
        // Fetch All Codes in One Go
        Set<String> branches = rows.parallelStream().map(r -> r.branch).collect(Collectors.toSet());
        Set<String> cgls = rows.parallelStream().map(r -> r.cgl).collect(Collectors.toSet());
        Set<String> currs = rows.parallelStream().map(r -> r.currency).collect(Collectors.toSet());

        Set<String> validBranches = branchRepo.findAllById(branches).stream().map(BranchMaster::getCode).collect(Collectors.toSet());
        Set<String> validCgls = cglRepo.findAllById(cgls).stream().map(CglMaster::getCglNumber).collect(Collectors.toSet());
        Set<String> validCurrs = currencyRepo.findAllById(currs).stream().map(CurrencyMaster::getCurrencyCode).collect(Collectors.toSet());

        rows.parallelStream().forEach(d -> {
            if (!validBranches.contains(d.branch)) d.dbErrors.add("Branch Not Found: " + d.branch);
            if (!validCurrs.contains(d.currency)) d.dbErrors.add("Currency Not Found: " + d.currency);
            if (!validCgls.contains(d.cgl)) d.dbErrors.add("CGL Not Found: " + d.cgl);
        });
        return rows.stream().anyMatch(ExcelRowData::hasErrors);
    }

    private boolean runBalanceCheck(List<ExcelRowData> rows) {
        ConcurrentHashMap<String, LongAdder> balanceMap = new ConcurrentHashMap<>();
        
        // Accumulate
        rows.parallelStream().forEach(d -> {
            if (d.amount != null) {
                String type = d.cgl.startsWith("5") ? "MEMO" : "NORMAL";
                String key = d.branch + "_" + d.currency + "_" + type;
                long val = d.amount.multiply(new BigDecimal("10000")).longValue();
                balanceMap.computeIfAbsent(key, k -> new LongAdder()).add(val);
            }
        });

        // Verify
        rows.parallelStream().forEach(d -> {
            String type = d.cgl.startsWith("5") ? "MEMO" : "NORMAL";
            String key = d.branch + "_" + d.currency + "_" + type;
            LongAdder adder = balanceMap.get(key);
            if (adder != null && adder.sum() != 0) {
                BigDecimal diff = BigDecimal.valueOf(adder.sum()).divide(new BigDecimal("10000"));
                synchronized(d.balErrors) {
                    if (d.balErrors.isEmpty()) d.balErrors.add(type + " Mismatch: " + diff.toPlainString());
                }
            }
        });
        return rows.stream().anyMatch(ExcelRowData::hasErrors);
    }

    // --- STATE & FILE HELPERS ---

    private void failRequest(String reqId, List<ExcelRowData> rows, String msg, int stage) throws IOException {
        byte[] excel = generateErrorExcel(rows);
        saveFile(reqId, KEY_FILE_ERR, excel);
        
        updateState(reqId, s -> {
            s.setStatus("ERROR");
            s.setMessage(msg);
            s.setCurrentStage(stage);
            s.setErrorCount(rows.stream().filter(ExcelRowData::hasErrors).count());
            s.setHasErrorFile(true);
        });
    }

    private void completeRequest(String reqId, List<ExcelRowData> rows, LocalDate date, boolean isCsv) throws IOException {
        if (!isCsv) {
            byte[] csv = generateSuccessCsv(rows, date);
            saveFile(reqId, KEY_FILE_SUC, csv);
        }
        
        List<Map<String, Object>> preview = rows.stream().limit(100).map(this::mapToPreview).collect(Collectors.toList());
        String previewJson = objectMapper.writeValueAsString(preview);

        updateState(reqId, s -> {
            s.setStatus("SUCCESS");
            s.setCurrentStage(4);
            s.setMessage("Validation Successful");
            s.setHasSuccessFile(!isCsv);
            s.setPreviewDataJson(previewJson);
        });
    }

    private void saveState(BulkUploadStateDto state) {
        try {
            redisTemplate.opsForValue().set(KEY_META + state.getRequestId(), objectMapper.writeValueAsString(state), TTL_MINUTES, TimeUnit.MINUTES);
        } catch (Exception e) { log.error("Redis Save", e); }
    }

    private void updateState(String reqId, java.util.function.Consumer<BulkUploadStateDto> updater) {
        try {
            String json = redisTemplate.opsForValue().get(KEY_META + reqId);
            if (json != null) {
                BulkUploadStateDto state = objectMapper.readValue(json, BulkUploadStateDto.class);
                updater.accept(state);
                saveState(state);
            }
        } catch (Exception e) { log.error("Redis Update", e); }
    }

    private void saveFile(String reqId, String keyPrefix, byte[] data) {
        String base64 = Base64.getEncoder().encodeToString(data);
        redisTemplate.opsForValue().set(keyPrefix + reqId, base64, TTL_MINUTES, TimeUnit.MINUTES);
    }

    public BulkUploadStateDto getState(String reqId) {
        try {
            String json = redisTemplate.opsForValue().get(KEY_META + reqId);
            return json != null ? objectMapper.readValue(json, BulkUploadStateDto.class) : null;
        } catch (Exception e) { return null; }
    }

    public byte[] getFile(String reqId, String type) {
        String key = type.equals("ERROR") ? KEY_FILE_ERR + reqId : KEY_FILE_SUC + reqId;
        String base64 = redisTemplate.opsForValue().get(key);
        return base64 != null ? Base64.getDecoder().decode(base64) : null;
    }

    // --- EXCEL & CSV GENERATORS ---

    private byte[] generateErrorExcel(List<ExcelRowData> rows) throws IOException {
        try (SXSSFWorkbook workbook = new SXSSFWorkbook(100)) { 
            workbook.setCompressTempFiles(true);
            Sheet sheet = workbook.createSheet("Error Report");

            // Styles
            CellStyle redHeader = workbook.createCellStyle();
            Font redFont = workbook.createFont();
            redFont.setColor(IndexedColors.RED.getIndex());
            redFont.setBold(true);
            redHeader.setFont(redFont);

            CellStyle boldHeader = workbook.createCellStyle();
            Font boldFont = workbook.createFont();
            boldFont.setBold(true);
            boldHeader.setFont(boldFont);
            
            CellStyle redText = workbook.createCellStyle();
            Font redTextFont = workbook.createFont();
            redTextFont.setColor(IndexedColors.RED.getIndex());
            redText.setFont(redTextFont);

            Row head = sheet.createRow(0);
            String[] headers = {"Branch", "Currency", "CGL", "Amount", "FORMAT ERRORS", "DB ERRORS", "BALANCE ERRORS"};
            for(int i=0; i<headers.length; i++) {
                Cell c = head.createCell(i);
                c.setCellValue(headers[i]);
                c.setCellStyle(headers[i].contains("ERRORS") ? redHeader : boldHeader);
            }

            int idx = 1;
            for(ExcelRowData d : rows) {
                Row r = sheet.createRow(idx++);
                r.createCell(0).setCellValue(d.branch);
                r.createCell(1).setCellValue(d.currency);
                r.createCell(2).setCellValue(d.cgl);
                r.createCell(3).setCellValue(d.amount != null ? d.amount.toString() : "");
                
                if(!d.formatErrors.isEmpty()) {
                    Cell c = r.createCell(4); c.setCellValue(String.join("; ", d.formatErrors)); c.setCellStyle(redText);
                }
                if(!d.dbErrors.isEmpty()) {
                    Cell c = r.createCell(5); c.setCellValue(String.join("; ", d.dbErrors)); c.setCellStyle(redText);
                }
                if(!d.balErrors.isEmpty()) {
                    Cell c = r.createCell(6); c.setCellValue(String.join("; ", d.balErrors)); c.setCellStyle(redText);
                }
            }
            ByteArrayOutputStream out = new ByteArrayOutputStream();
            workbook.write(out);
            workbook.dispose();
            return out.toByteArray();
        }
    }

    private byte[] generateSuccessCsv(List<ExcelRowData> rows, LocalDate d) {
        StringBuilder csv = new StringBuilder();
        String dateStr = d.format(DateTimeFormatter.ofPattern("ddMMyyyy"));
        for(ExcelRowData r : rows) {
            String amtStr = r.amount.abs().setScale(4, RoundingMode.HALF_UP).toString();
            String txn = r.amount.signum() < 0 ? "Cr" : "Dr";
            csv.append("01,").append(dateStr).append(",,,").append(r.branch).append(",")
               .append(r.currency).append(",").append(r.cgl).append(",")
               .append(amtStr).append(",").append(txn).append(",")
               .append(r.remarks).append(",").append(r.productCode).append(",B,C,D\n");
        }
        return csv.toString().getBytes();
    }

    // --- PARSERS ---
    private List<ExcelRowData> parseExcelBytes(byte[] bytes) throws IOException {
        try(Workbook wb = new XSSFWorkbook(new ByteArrayInputStream(bytes))) {
            return parseSheet(wb.getSheetAt(0));
        }
    }
    
    private List<ExcelRowData> parseCsvBytes(byte[] bytes) throws IOException {
        List<ExcelRowData> list = new ArrayList<>();
        try(BufferedReader br = new BufferedReader(new InputStreamReader(new ByteArrayInputStream(bytes)))) {
            String line; int i=0;
            while((line=br.readLine())!=null) {
                if(line.trim().isEmpty()) continue;
                String[] c = line.split(",");
                if(c.length < 9) continue;
                ExcelRowData d = new ExcelRowData();
                d.rowIndex = i++;
                d.branch = c[4].trim(); d.currency = c[5].trim(); d.cgl = c[6].trim();
                parseAmount(d, c[7], c[8]);
                d.remarks = c.length>9?c[9].trim():""; 
                d.productCode = c.length>10?c[10].trim():"";
                list.add(d);
            }
        }
        return list;
    }

    private List<ExcelRowData> parseSheet(Sheet sheet) {
        List<ExcelRowData> list = new ArrayList<>();
        DataFormatter fmt = new DataFormatter();
        for(Row r : sheet) {
            if(r.getRowNum()==0) continue; // Skip Header if exists? Or assume no header? Usually skip 0.
            ExcelRowData d = new ExcelRowData();
            d.rowIndex = r.getRowNum();
            d.branch = fmt.formatCellValue(r.getCell(0)).trim();
            d.currency = fmt.formatCellValue(r.getCell(1)).trim();
            d.cgl = fmt.formatCellValue(r.getCell(2)).trim();
            parseAmount(d, fmt.formatCellValue(r.getCell(3)), fmt.formatCellValue(r.getCell(4)));
            d.remarks = fmt.formatCellValue(r.getCell(5));
            d.productCode = fmt.formatCellValue(r.getCell(6));
            if(!d.branch.isEmpty()) list.add(d);
        }
        return list;
    }

    private void parseAmount(ExcelRowData d, String amtRaw, String typeRaw) {
        try {
            d.txnType = typeRaw.toUpperCase();
            String clean = CLEAN_AMOUNT_REGEX.matcher(amtRaw).replaceAll("");
            if(clean.isEmpty()) return;
            BigDecimal v = new BigDecimal(clean);
            boolean isCr = d.txnType.contains("CR") || amtRaw.contains("-");
            d.amount = isCr ? v.abs().negate() : v.abs();
        } catch(Exception e) {}
    }

    private Map<String, Object> mapToPreview(ExcelRowData r) {
        Map<String, Object> m = new HashMap<>();
        m.put("id", r.rowIndex); m.put("branch", r.branch); m.put("currency", r.currency);
        m.put("cgl", r.cgl); m.put("amount", r.amount!=null?r.amount.abs().toString():"");
        m.put("txnType", r.txnType); m.put("remarks", r.remarks); m.put("productCode", r.productCode);
        return m;
    }
}

3. Backend: JournalRequestController.java (Endpoints)
    @Autowired
    private JournalBulkValidationService service;

    @PostMapping(value = "/bulk-validate-init", consumes = MediaType.MULTIPART_FORM_DATA_VALUE)
    public ResponseEntity<Map<String, String>> initiate(@RequestParam("file") MultipartFile file, @RequestParam("postingDate") String date) throws IOException {
        String reqId = service.initiateValidation(file, LocalDate.parse(date));
        return ResponseEntity.ok(Map.of("requestId", reqId, "status", "QUEUED"));
    }

    @GetMapping("/bulk-status/{requestId}")
    public ResponseEntity<BulkUploadStateDto> checkStatus(@PathVariable String requestId) {
        BulkUploadStateDto state = service.getState(requestId);
        return state != null ? ResponseEntity.ok(state) : ResponseEntity.notFound().build();
    }

    @GetMapping("/download-bulk-file/{requestId}")
    public ResponseEntity<Resource> download(@PathVariable String requestId, @RequestParam String type) {
        byte[] data = service.getFile(requestId, type);
        if (data == null) return ResponseEntity.notFound().build();
        String name = type.equals("ERROR") ? "Error_Report.xlsx" : "Success_File.csv";
        return ResponseEntity.ok()
            .header(HttpHeaders.CONTENT_DISPOSITION, "attachment; filename=\"" + name + "\"")
            .contentType(MediaType.APPLICATION_OCTET_STREAM)
            .body(new ByteArrayResource(data));
    }

