import java.time.LocalDate;
import java.util.Base64;
// ... other imports

    @PostMapping(value = "/bulk-validate", consumes = MediaType.MULTIPART_FORM_DATA_VALUE)
    public ResponseEntity<?> validateBulkUpload(
            @RequestParam("file") MultipartFile file,
            @RequestParam("postingDate") String postingDateStr
    ) throws IOException {
        
        LocalDate postingDate = LocalDate.parse(postingDateStr);

        Map<String, Object> result = journalBulkValidationService.validateAndProcessExcel(file, postingDate);

        byte[] fileContent = (byte[]) result.get("file");
        String base64File = (fileContent != null) ? Base64.getEncoder().encodeToString(fileContent) : null;

        if ("ERROR".equals(result.get("status"))) {
            long count = (long) result.get("errorCount");
            return ResponseEntity.ok(Map.of(
                "status", "ERROR",
                "message", "Validation failed. Found " + count + " errors.",
                "errorCount", count,
                "errorReportBase64", base64File
            ));
        }

        // SUCCESS: Send File AND Preview Data
        return ResponseEntity.ok(Map.of(
            "status", "SUCCESS",
            "message", "Validation Successful! Ready for download.",
            "successFileBase64", base64File,
            "previewData", result.get("previewData") // <--- Added for Grid
        ));
    }

3. Frontend: JournalBulkUpload.jsx (Updated)
I added the MUI DataGrid to display the successful rows when validation passes, along with the download button.
import React, { useState, useRef } from "react";
import {
  Box,
  Typography,
  Paper,
  Grid,
  TextField,
  Button,
  CircularProgress,
  Chip,
  Divider,
  Alert,
} from "@mui/material";
import {
  CloudUpload as CloudUploadIcon,
  RestartAlt as RestartAltIcon,
  Description as DescriptionIcon,
  CheckCircle as CheckCircleIcon,
  Error as ErrorIcon,
  Download as DownloadIcon,
} from "@mui/icons-material";

// Import DataGrid
import { DataGrid } from "@mui/x-data-grid";

import { mainContainerStyle, uploadBoxStyle, controlPanelStyle } from "./JournalBulkStyle";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

const JournalBulkUpload = () => {
  const { callApi, loading } = useApi(); 
  const showSnackBar = useCustomSnackbar();
  
  const [selectedDate, setSelectedDate] = useState("");
  const [file, setFile] = useState(null);
  const [uiError, setUiError] = useState("");
  const [errorCount, setErrorCount] = useState(0);
  
  const [successFile, setSuccessFile] = useState(null);
  const [previewRows, setPreviewRows] = useState([]); // State for Grid Data

  const fileInputRef = useRef(null);

  const downloadBase64File = (base64String, fileName, mimeType) => {
    try {
      const byteCharacters = atob(base64String);
      const byteNumbers = new Array(byteCharacters.length);
      for (let i = 0; i < byteCharacters.length; i++) {
        byteNumbers[i] = byteCharacters.charCodeAt(i);
      }
      const byteArray = new Uint8Array(byteNumbers);
      const blob = new Blob([byteArray], { type: mimeType });
      const url = window.URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.setAttribute("download", fileName);
      document.body.appendChild(link);
      link.click();
      link.parentNode.removeChild(link);
      window.URL.revokeObjectURL(url);
    } catch (e) {
      console.error("Failed to download", e);
      showSnackBar("Failed to download file.", "error");
    }
  };

  const handleDateChange = (e) => {
    setSelectedDate(e.target.value);
    setUiError("");
    setSuccessFile(null);
    setPreviewRows([]);
  };

  const handleFileChange = (e) => {
    const selectedFile = e.target.files[0];
    if (selectedFile) {
      const fileType = selectedFile.name.split(".").pop().toLowerCase();
      if (fileType !== "xlsx" && fileType !== "xls") {
        const msg = "Invalid file type. Please upload .xlsx or .xls";
        setUiError(msg);
        showSnackBar(msg, "error");
        setFile(null);
        return;
      }
      setFile(selectedFile);
      setUiError("");
      setErrorCount(0);
      setSuccessFile(null);
      setPreviewRows([]);
    }
  };

  const resetForm = () => {
    setFile(null);
    setSelectedDate("");
    setUiError("");
    setErrorCount(0);
    setSuccessFile(null);
    setPreviewRows([]);
    if (fileInputRef.current) fileInputRef.current.value = "";
  };

  const handleValidation = async () => {
    if (!selectedDate || !file) {
      const msg = "Please select a Date and upload a File.";
      setUiError(msg);
      showSnackBar(msg, "warning");
      return;
    }

    setUiError("");
    setErrorCount(0);
    setSuccessFile(null);
    setPreviewRows([]);

    const formData = new FormData();
    formData.append("file", file);
    formData.append("postingDate", selectedDate);

    try {
      const response = await callApi("JS/journals/bulk-validate", formData, "POST", "json", "multipart/form-data");

      if (response && response.status === "ERROR") {
        const count = response.errorCount || 0;
        setErrorCount(count);
        const msg = `Validation Failed with ${count} errors. Downloading report...`;
        setUiError(msg);
        showSnackBar(msg, "error");

        if (response.errorReportBase64) {
          downloadBase64File(response.errorReportBase64, `Error_Report.xlsx`, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
      } else if (response && response.status === "SUCCESS") {
        showSnackBar(response.message, "success");
        if (response.successFileBase64) setSuccessFile(response.successFileBase64);
        if (response.previewData) setPreviewRows(response.previewData); // Set Grid Data
      } 
    } catch (err) {
      console.error("Validation Error:", err);
    }
  };

  // Columns for DataGrid
  const columns = [
    { field: "branch", headerName: "Branch", flex: 1, align: "center", headerAlign: "center" },
    { field: "currency", headerName: "Currency", width: 100, align: "center", headerAlign: "center" },
    { field: "cgl", headerName: "CGL", flex: 1.5, align: "center", headerAlign: "center" },
    { 
      field: "amount", 
      headerName: "Amount", 
      flex: 1, 
      align: "right", 
      headerAlign: "center",
      valueFormatter: (params) => Number(params?.value).toFixed(2)
    },
    { 
      field: "txnType", 
      headerName: "Type", 
      width: 100, 
      align: "center", 
      headerAlign: "center",
      renderCell: (params) => (
        <Chip 
          label={params.value} 
          color={params.value === "Credit" ? "error" : "success"} 
          size="small" 
          variant="outlined"
        />
      )
    },
    { field: "remarks", headerName: "Remarks", flex: 2, headerAlign: "center" },
  ];

  return (
    <Box sx={mainContainerStyle}>
      <Paper elevation={3} sx={controlPanelStyle}>
        <Grid container spacing={3}>
          <Grid item xs={12} md={4}>
            <Typography variant="subtitle2" gutterBottom>1. Select Posting Date</Typography>
            <TextField type="date" fullWidth size="small" value={selectedDate} onChange={handleDateChange} InputLabelProps={{ shrink: true }} />
          </Grid>

          <Grid item xs={12} md={4}>
            <Typography variant="subtitle2" gutterBottom>2. Upload Excel File</Typography>
            <Box sx={uploadBoxStyle} onClick={() => fileInputRef.current.click()}>
              <input type="file" hidden accept=".xlsx, .xls" onChange={handleFileChange} ref={fileInputRef} />
              {file ? (
                <>
                  <DescriptionIcon color="success" fontSize="large" />
                  <Typography variant="body2" sx={{ mt: 1, fontWeight: "bold" }}>{file.name}</Typography>
                </>
              ) : (
                <>
                  <CloudUploadIcon color="action" fontSize="large" />
                  <Typography variant="body2" sx={{ mt: 1 }}>Click to Upload</Typography>
                </>
              )}
            </Box>
          </Grid>

          <Grid item xs={12} md={4} sx={{ display: "flex", flexDirection: "column", justifyContent: "center", gap: 2 }}>
            <Button variant="contained" color="primary" onClick={handleValidation} disabled={loading || !file || !selectedDate} startIcon={loading ? <CircularProgress size={20} color="inherit" /> : <CheckCircleIcon />}>
              {loading ? "Validating..." : "Validate & Process"}
            </Button>
            <Button variant="outlined" color="error" onClick={resetForm} startIcon={<RestartAltIcon />}>Reset</Button>
          </Grid>
        </Grid>

        <Divider sx={{ my: 3 }} />

        {/* FEEDBACK SECTION */}
        <Box>
          {loading && <Alert severity="info">Processing file on server...</Alert>}

          {uiError && (
            <Alert severity="error" sx={{ mt: 1 }} action={errorCount > 0 && <Chip label={`${errorCount} Errors`} color="error" />}>
              <Typography variant="subtitle2" fontWeight="bold">Validation Failed</Typography>
              <Typography variant="body2">{uiError}</Typography>
            </Alert>
          )}

          {successFile && !uiError && (
             <Alert severity="success" sx={{ mt: 1, alignItems: "center" }}>
                <Box sx={{ display: 'flex', justifyContent: 'space-between', width: '100%', alignItems: 'center' }}>
                    <Box>
                        <Typography variant="subtitle2" fontWeight="bold">Success!</Typography>
                        <Typography variant="body2">File validated. You can review data below or download the file.</Typography>
                    </Box>
                    <Button 
                        variant="contained" 
                        color="success" 
                        startIcon={<DownloadIcon />}
                        onClick={() => downloadBase64File(successFile, `Processed_Journal_${selectedDate}.csv`, "text/csv")}
                    >
                        Download Validated File
                    </Button>
                </Box>
             </Alert>
          )}
        </Box>
      </Paper>
      
      {/* DATA GRID PREVIEW */}
      {previewRows.length > 0 && !uiError && (
        <Paper elevation={3} sx={{ p: 2, mt: 3, height: 500, width: '100%' }}>
            <Typography variant="h6" gutterBottom color="primary">Validated Data Preview</Typography>
            <DataGrid
                rows={previewRows}
                columns={columns}
                pageSize={10}
                rowsPerPageOptions={[10, 25, 50]}
                disableSelectionOnClick
                density="compact"
                sx={{ border: 'none' }}
            />
        </Paper>
      )}
    </Box>
  );
};

export default JournalBulkUpload;

