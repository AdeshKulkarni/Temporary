import React, { useState, useRef } from 'react';
import { Upload, FileSpreadsheet, Download, Calendar, AlertCircle, CheckCircle, FileText, Trash2, RefreshCw } from 'lucide-react';

// We need the xlsx library for parsing Excel files.
// In a standard environment, you would run: npm install xlsx
// Here we inject it via script tag for the standalone artifact.

const JournalBulkUplod = () => {
  const [selectedDate, setSelectedDate] = useState('');
  const [file, setFile] = useState(null);
  const [processedRows, setProcessedRows] = useState([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');
  const [successMsg, setSuccessMsg] = useState('');
  const fileInputRef = useRef(null);

  // --- Utility Functions ---

  const padZeros = (str, length) => {
    const s = String(str || '');
    return s.padStart(length, '0');
  };

  const formatAmount = (val) => {
    // Ensure it's a number
    const num = parseFloat(val);
    if (isNaN(num)) return '0000000000000000.0000';

    // Fix to 4 decimal places first
    const fixed = num.toFixed(4);
    const [integerPart, decimalPart] = fixed.split('.');

    // Pad integer part to 16 digits
    const paddedInt = integerPart.padStart(16, '0');
    
    return `${paddedInt}.${decimalPart}`;
  };

  const getFinancialInfo = (dateString) => {
    if (!dateString) return { year: '', month: '', formattedDate: '' };
    
    const date = new Date(dateString);
    const day = date.getDate();
    const monthIndex = date.getMonth() + 1; // 1-12
    const fullYear = date.getFullYear();

    // Format Date as DDMMYYYY
    const dd = String(day).padStart(2, '0');
    const mm = String(monthIndex).padStart(2, '0');
    const formattedDate = `${dd}${mm}${fullYear}`;

    let finYear, finMonth;

    // Financial Year Logic (Apr - Mar)
    if (monthIndex >= 4) {
      // Apr (4) to Dec (12)
      finYear = fullYear;
      finMonth = monthIndex - 3;
    } else {
      // Jan (1) to Mar (3)
      finYear = fullYear - 1;
      finMonth = monthIndex + 9;
    }

    // Pad Financial Month to 2 digits
    const finMonthStr = String(finMonth).padStart(2, '0');

    return { 
      year: String(finYear), 
      month: finMonthStr, 
      formattedDate 
    };
  };

  // --- Handlers ---

  const handleDateChange = (e) => {
    setSelectedDate(e.target.value);
    setProcessedRows([]); // Reset preview if date changes
    setSuccessMsg('');
    setError('');
  };

  const handleFileChange = (e) => {
    const selectedFile = e.target.files[0];
    if (selectedFile) {
      const fileType = selectedFile.name.split('.').pop().toLowerCase();
      if (fileType !== 'xlsx' && fileType !== 'xls') {
        setError('Please upload a valid Excel file (.xlsx or .xls)');
        setFile(null);
        return;
      }
      setFile(selectedFile);
      setError('');
      setSuccessMsg('');
      setProcessedRows([]);
    }
  };

  const resetForm = () => {
    setFile(null);
    setProcessedRows([]);
    setError('');
    setSuccessMsg('');
    if (fileInputRef.current) fileInputRef.current.value = '';
  };

  const processFile = async () => {
    if (!selectedDate) {
      setError('Please select a Date first.');
      return;
    }
    if (!file) {
      setError('Please upload an Excel file.');
      return;
    }

    setLoading(true);
    setError('');

    // Dynamically load xlsx library if not present
    if (!window.XLSX) {
      const script = document.createElement('script');
      script.src = "https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js";
      document.body.appendChild(script);
      await new Promise((resolve) => {
        script.onload = resolve;
      });
    }

    const reader = new FileReader();
    reader.onload = (e) => {
      try {
        const data = new Uint8Array(e.target.result);
        const workbook = window.XLSX.read(data, { type: 'array' });
        
        // Assume first sheet
        const firstSheetName = workbook.SheetNames[0];
        const worksheet = workbook.Sheets[firstSheetName];
        
        // Convert to JSON
        const jsonData = window.XLSX.utils.sheet_to_json(worksheet);

        if (jsonData.length === 0) {
          setError('The uploaded Excel file is empty.');
          setLoading(false);
          return;
        }

        // --- CORE MAPPING LOGIC ---
        const { year: finYear, month: finMonth, formattedDate } = getFinancialInfo(selectedDate);

        const mappedData = jsonData.map((row, index) => {
          // Robust checking for column names (handles casing differences if any)
          const getVal = (key) => {
            const val = row[key] || row[key.toLowerCase()] || row[key.toUpperCase()] || '';
            return val;
          };

          // Mapping specific to user requirements
          // 1. Fixed "01"
          const col1 = "01";
          
          // 2. Date from User Input (DDMMYYYY)
          const col2 = formattedDate;

          // 3. Fin Year
          const col3 = finYear;

          // 4. Fin Month
          const col4 = finMonth;

          // 5. Branch (pad to 5)
          const rawBranch = getVal('branch') || getVal('Branch');
          const col5 = padZeros(rawBranch, 5);

          // 6. Currency
          const col6 = getVal('currency') || 'INR';

          // 7. CGL
          const col7 = getVal('cgl') || getVal('code') || ''; // Assuming 'code' in user mapping might refer to CGL, or strictly 'cgl' column

          // 8. Amount (16 digits . 4 decimals)
          const rawAmount = getVal('amount');
          const col8 = formatAmount(rawAmount);

          // 9. Txn Type
          const col9 = getVal('txntype') || getVal('TxnType');

          // 10. Remarks
          const col10 = getVal('Remarks') || getVal('remarks');

          // 11-14. Fixed/Trailing logic
          const col11 = "000000000";
          const col12 = "00000";
          const col13 = "0000000000";
          const col14 = "X";

          // Construct CSV Line
          const csvLine = [col1, col2, col3, col4, col5, col6, col7, col8, col9, col10, col11, col12, col13, col14].join(',');

          return {
            id: index,
            original: row,
            csvLine: csvLine,
            // Parsed fields for preview
            preview: {
              date: col2,
              finYear: col3,
              finMonth: col4,
              branch: col5,
              amount: col8,
              remarks: col10
            }
          };
        });

        setProcessedRows(mappedData);
        setSuccessMsg(`Successfully processed ${mappedData.length} records ready for download.`);
      } catch (err) {
        console.error(err);
        setError('Failed to parse Excel file. Please check the file format.');
      } finally {
        setLoading(false);
      }
    };

    reader.readAsArrayBuffer(file);
  };

  const downloadCSV = () => {
    if (processedRows.length === 0) return;

    const csvContent = processedRows.map(r => r.csvLine).join('\n');
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    const url = URL.createObjectURL(blob);
    
    // Create filename based on date or default
    const fileName = `Journal_Upload_${selectedDate || 'Processed'}.csv`;
    
    link.setAttribute('href', url);
    link.setAttribute('download', fileName);
    link.style.visibility = 'hidden';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  return (
    <div className="min-h-screen bg-slate-50 font-sans text-slate-900 p-4 md:p-8">
      <div className="max-w-5xl mx-auto space-y-6">
        
        {/* Header */}
        <div className="bg-white rounded-xl shadow-sm border border-slate-200 p-6 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="p-3 bg-blue-600 rounded-lg text-white">
              <FileSpreadsheet size={28} />
            </div>
            <div>
              <h1 className="text-2xl font-bold text-slate-800">JournalBulkUpload</h1>
              <p className="text-slate-500 text-sm">Excel to Bank CSV Converter</p>
            </div>
          </div>
          <div className="hidden md:block text-right">
            <p className="text-xs font-semibold text-blue-600 bg-blue-50 px-3 py-1 rounded-full uppercase tracking-wide">
              Format: Excel &rarr; CSV
            </p>
          </div>
        </div>

        {/* Main Control Card */}
        <div className="bg-white rounded-xl shadow-lg border border-slate-200 overflow-hidden">
          <div className="p-6 md:p-8 grid md:grid-cols-2 gap-8">
            
            {/* Left: Inputs */}
            <div className="space-y-6">
              
              {/* Step 1: Date Selection */}
              <div className="space-y-2">
                <label className="flex items-center gap-2 text-sm font-semibold text-slate-700">
                  <Calendar size={16} />
                  Step 1: Select Transaction Date
                </label>
                <input 
                  type="date" 
                  value={selectedDate}
                  onChange={handleDateChange}
                  className="w-full p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"
                />
                {selectedDate && (
                  <div className="text-xs text-slate-500 bg-slate-100 p-2 rounded flex gap-4">
                    <span>Fin Year: <strong>{getFinancialInfo(selectedDate).year}</strong></span>
                    <span>Fin Month: <strong>{getFinancialInfo(selectedDate).month}</strong></span>
                  </div>
                )}
              </div>

              {/* Step 2: File Upload */}
              <div className="space-y-2">
                <label className="flex items-center gap-2 text-sm font-semibold text-slate-700">
                  <Upload size={16} />
                  Step 2: Upload Excel File
                </label>
                
                <div 
                  className={`border-2 border-dashed rounded-xl p-8 text-center transition-colors cursor-pointer relative
                    ${file ? 'border-green-400 bg-green-50' : 'border-slate-300 hover:border-blue-400 hover:bg-slate-50'}
                  `}
                  onClick={() => fileInputRef.current.click()}
                >
                  <input 
                    type="file" 
                    ref={fileInputRef}
                    onChange={handleFileChange}
                    accept=".xlsx, .xls"
                    className="hidden"
                  />
                  
                  {file ? (
                    <div className="flex flex-col items-center text-green-700">
                      <FileText size={32} className="mb-2" />
                      <p className="font-medium">{file.name}</p>
                      <p className="text-xs opacity-75">{(file.size / 1024).toFixed(2)} KB</p>
                    </div>
                  ) : (
                    <div className="flex flex-col items-center text-slate-400">
                      <Upload size={32} className="mb-2" />
                      <p className="text-sm font-medium text-slate-600">Click to upload Excel</p>
                      <p className="text-xs">Supports .xlsx and .xls</p>
                    </div>
                  )}
                </div>
              </div>

              {/* Actions */}
              <div className="flex gap-3 pt-2">
                <button
                  onClick={processFile}
                  disabled={loading || !file || !selectedDate}
                  className={`flex-1 flex items-center justify-center gap-2 py-3 px-6 rounded-lg font-semibold text-white shadow-md transition-all
                    ${loading || !file || !selectedDate 
                      ? 'bg-slate-300 cursor-not-allowed' 
                      : 'bg-blue-600 hover:bg-blue-700 hover:shadow-lg active:scale-95'}
                  `}
                >
                  {loading ? <RefreshCw className="animate-spin" size={20}/> : <CheckCircle size={20} />}
                  {loading ? 'Processing...' : 'Process File'}
                </button>

                {file && (
                  <button 
                    onClick={resetForm}
                    className="p-3 text-red-500 border border-red-200 rounded-lg hover:bg-red-50 transition-colors"
                    title="Reset"
                  >
                    <Trash2 size={20} />
                  </button>
                )}
              </div>

              {/* Feedback Messages */}
              {error && (
                <div className="flex items-center gap-2 text-red-600 bg-red-50 p-3 rounded-lg text-sm border border-red-100">
                  <AlertCircle size={16} />
                  {error}
                </div>
              )}
              {successMsg && (
                <div className="flex items-center gap-2 text-green-700 bg-green-50 p-3 rounded-lg text-sm border border-green-100">
                  <CheckCircle size={16} />
                  {successMsg}
                </div>
              )}

            </div>

            {/* Right: Instructions & Logic Info */}
            <div className="bg-slate-50 rounded-xl p-6 border border-slate-200 text-sm space-y-4">
              <h3 className="font-semibold text-slate-800 flex items-center gap-2">
                <AlertCircle size={16} className="text-blue-500" />
                Conversion Logic Applied
              </h3>
              <ul className="space-y-3 text-slate-600">
                <li className="flex gap-2">
                  <span className="font-mono text-xs bg-white border px-1 rounded text-blue-600">Branch</span>
                  <span>Pads branch code to 5 digits (e.g., 3430 &rarr; 03430)</span>
                </li>
                <li className="flex gap-2">
                  <span className="font-mono text-xs bg-white border px-1 rounded text-blue-600">Amount</span>
                  <span>Formats to 16.4 precision (e.g., 236 &rarr; 0...0236.0000)</span>
                </li>
                <li className="flex gap-2">
                  <span className="font-mono text-xs bg-white border px-1 rounded text-blue-600">Date</span>
                  <span>Calculates Fin Year/Month based on April-March cycle.</span>
                </li>
                <li className="flex gap-2">
                  <span className="font-mono text-xs bg-white border px-1 rounded text-blue-600">Output</span>
                  <span>Strict comma-separated CSV format without headers.</span>
                </li>
              </ul>

              {processedRows.length > 0 && (
                <div className="mt-8 p-4 bg-green-100 rounded-lg border border-green-200 text-center">
                  <p className="font-bold text-green-800 text-lg mb-2">Ready to Export</p>
                  <button
                    onClick={downloadCSV}
                    className="w-full flex items-center justify-center gap-2 bg-green-600 text-white py-3 rounded-lg font-semibold hover:bg-green-700 transition-colors shadow-sm"
                  >
                    <Download size={20} />
                    Download CSV
                  </button>
                </div>
              )}
            </div>

          </div>
        </div>

        {/* Data Preview Section */}
        {processedRows.length > 0 && (
          <div className="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
            <div className="p-4 border-b border-slate-100 bg-slate-50 flex justify-between items-center">
              <h3 className="font-bold text-slate-700">Data Preview (First 5 Rows)</h3>
              <span className="text-xs text-slate-500">Total Rows: {processedRows.length}</span>
            </div>
            <div className="overflow-x-auto">
              <table className="w-full text-sm text-left">
                <thead className="text-xs text-slate-500 uppercase bg-slate-50 border-b">
                  <tr>
                    <th className="px-6 py-3">Date (DDMMYYYY)</th>
                    <th className="px-6 py-3">Fin Year</th>
                    <th className="px-6 py-3">Fin Month</th>
                    <th className="px-6 py-3">Branch</th>
                    <th className="px-6 py-3 text-right">Formatted Amount</th>
                    <th className="px-6 py-3">Remarks</th>
                    <th className="px-6 py-3">Raw CSV String</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-slate-100">
                  {processedRows.slice(0, 5).map((row) => (
                    <tr key={row.id} className="hover:bg-slate-50 transition-colors">
                      <td className="px-6 py-3 font-mono text-slate-600">{row.preview.date}</td>
                      <td className="px-6 py-3 font-mono text-slate-600">{row.preview.finYear}</td>
                      <td className="px-6 py-3 font-mono text-slate-600">{row.preview.finMonth}</td>
                      <td className="px-6 py-3 font-mono text-blue-600 font-bold">{row.preview.branch}</td>
                      <td className="px-6 py-3 font-mono text-right text-green-700">{row.preview.amount}</td>
                      <td className="px-6 py-3 text-slate-600 max-w-xs truncate" title={row.preview.remarks}>{row.preview.remarks}</td>
                      <td className="px-6 py-3">
                        <code className="text-[10px] bg-slate-100 p-1 rounded text-slate-500 block max-w-xs truncate">
                          {row.csvLine}
                        </code>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {processedRows.length > 5 && (
              <div className="p-3 text-center text-xs text-slate-400 bg-slate-50 border-t">
                ...and {processedRows.length - 5} more rows
              </div>
            )}
          </div>
        )}

      </div>
    </div>
  );
};

export default JournalBulkUplod;

