import org.apache.poi.ss.usermodel.*;
import org.apache.poi.xssf.streaming.SXSSFWorkbook;
import org.apache.poi.xssf.usermodel.XSSFWorkbook;
import org.springframework.data.redis.core.StringRedisTemplate;
import org.springframework.scheduling.annotation.Async;
import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;

import java.io.*;
import java.math.BigDecimal;
import java.math.RoundingMode;
import java.nio.charset.StandardCharsets;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.*;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.atomic.AtomicInteger;
import java.util.concurrent.atomic.LongAdder;
import java.util.regex.Pattern;
import java.util.stream.Collectors;

@Service
@RequiredArgsConstructor
@Slf4j
public class JournalBulkValidationService {

    private final BranchMasterRepository branchRepo;
    private final CglMasterRepository cglRepo;
    private final CurrencyMasterRepository currencyRepo;
    private final BulkUploadRepository bulkUploadRepo;
    private final ObjectMapper objectMapper;
    // Keeping Redis if you still want to use it for live counters, otherwise can rely on DB updates
    private final StringRedisTemplate redisTemplate; 

    private static final Pattern CLEAN_AMOUNT_REGEX = Pattern.compile("[^0-9.-]");
    private static final Pattern PRODUCT_CODE_REGEX = Pattern.compile("^\\d{8}$");
    private static final Pattern CGL_FORMAT_REGEX = Pattern.compile("^\\d{10}$");

    private static class ExcelRowData {
        int rowIndex;
        String branch = "";
        String currency = "";
        String cgl = "";
        BigDecimal amount; 
        String txnType = "";
        String remarks = "";
        String productCode = "";
        List<String> formatErrors = Collections.synchronizedList(new ArrayList<>());
        List<String> dbErrors = Collections.synchronizedList(new ArrayList<>());
        List<String> balErrors = Collections.synchronizedList(new ArrayList<>());
        
        boolean hasErrors() { return !formatErrors.isEmpty() || !dbErrors.isEmpty() || !balErrors.isEmpty(); }
    }

    public String initiateValidation(MultipartFile file, LocalDate postingDate) throws IOException {
        String requestId = UUID.randomUUID().toString();

        BulkUploadRequest request = new BulkUploadRequest();
        request.setRequestId(requestId);
        request.setStatus("PROCESSING");
        request.setCurrentStage(1); 
        request.setCreatedAt(LocalDateTime.now());
        bulkUploadRepo.save(request);

        byte[] fileBytes = file.getBytes();
        String filename = file.getOriginalFilename();
        processAsync(requestId, fileBytes, filename, postingDate);

        return requestId;
    }

    @Async("bulkExecutor")
    public void processAsync(String requestId, byte[] fileBytes, String filename, LocalDate postingDate) {
        try {
            List<ExcelRowData> parsedRows;
            if (filename != null && (filename.toLowerCase().endsWith(".csv") || filename.toLowerCase().endsWith(".txt"))) {
                parsedRows = parseCsvBytes(fileBytes);
            } else {
                parsedRows = parseExcelBytes(fileBytes);
            }
            boolean isInputCsv = filename != null && filename.toLowerCase().endsWith(".csv");

            // Update Total Rows
            updateStage(requestId, 1, parsedRows.size(), 0);

            // --- STAGE 1: FORMAT CHECK ---
            if (runFormatCheck(parsedRows)) {
                failRequest(requestId, parsedRows, "Format Validation Failed", 1);
                return;
            }
            updateStage(requestId, 2, null, null); 

            // --- STAGE 2: DB CHECK ---
            if (runDbCheck(parsedRows)) {
                failRequest(requestId, parsedRows, "Database Validation Failed", 2);
                return;
            }
            updateStage(requestId, 3, null, null);

            // --- STAGE 3: BALANCE CHECK ---
            if (runBalanceCheck(parsedRows)) {
                failRequest(requestId, parsedRows, "Debit/Credit Balance Mismatch", 3);
                return;
            }

            // --- STAGE 4: SUCCESS ---
            completeRequest(requestId, parsedRows, postingDate, isInputCsv);

        } catch (Exception e) {
            log.error("Async Error", e);
            updateStatus(requestId, "ERROR", "System Error: " + e.getMessage());
        }
    }

    private boolean runFormatCheck(List<ExcelRowData> rows) {
        rows.parallelStream().forEach(d -> {
            if (d.branch == null || d.branch.isEmpty()) d.formatErrors.add("Branch Empty");
            if (d.currency == null || d.currency.length() != 3) d.formatErrors.add("Invalid Currency (3 chars)");
            if (d.cgl == null || !CGL_FORMAT_REGEX.matcher(d.cgl).matches()) d.formatErrors.add("Invalid CGL (10 digits)");
            if (d.amount == null || d.amount.compareTo(BigDecimal.ZERO) == 0) d.formatErrors.add("Invalid Amount");
            if (d.productCode != null && !d.productCode.isEmpty() && !PRODUCT_CODE_REGEX.matcher(d.productCode).matches()) {
                d.formatErrors.add("Invalid Product Code (8 digits)");
            }
        });
        return rows.stream().anyMatch(ExcelRowData::hasErrors);
    }

    private boolean runDbCheck(List<ExcelRowData> rows) {
        Set<String> branches = rows.parallelStream().map(r -> r.branch).collect(Collectors.toSet());
        Set<String> cgls = rows.parallelStream().map(r -> r.cgl).collect(Collectors.toSet());
        Set<String> currs = rows.parallelStream().map(r -> r.currency).collect(Collectors.toSet());

        Set<String> validBranches = branchRepo.findAllById(branches).stream().map(BranchMaster::getCode).collect(Collectors.toSet());
        Set<String> validCgls = cglRepo.findAllById(cgls).stream().map(CglMaster::getCglNumber).collect(Collectors.toSet());
        Set<String> validCurrs = currencyRepo.findAllById(currs).stream().map(CurrencyMaster::getCurrencyCode).collect(Collectors.toSet());

        rows.parallelStream().forEach(d -> {
            if (!validBranches.contains(d.branch)) d.dbErrors.add("Branch Not Found: " + d.branch);
            if (!validCurrs.contains(d.currency)) d.dbErrors.add("Currency Not Found: " + d.currency);
            if (!validCgls.contains(d.cgl)) d.dbErrors.add("CGL Not Found: " + d.cgl);
        });
        return rows.stream().anyMatch(ExcelRowData::hasErrors);
    }

    private boolean runBalanceCheck(List<ExcelRowData> rows) {
        ConcurrentHashMap<String, LongAdder> balanceMap = new ConcurrentHashMap<>();
        rows.parallelStream().forEach(d -> {
            if (d.amount != null) {
                String type = d.cgl.startsWith("5") ? "MEMO" : "NORMAL";
                String key = d.branch + "_" + d.currency + "_" + type;
                long val = d.amount.multiply(new BigDecimal("10000")).longValue();
                balanceMap.computeIfAbsent(key, k -> new LongAdder()).add(val);
            }
        });

        rows.parallelStream().forEach(d -> {
            String type = d.cgl.startsWith("5") ? "MEMO" : "NORMAL";
            String key = d.branch + "_" + d.currency + "_" + type;
            LongAdder adder = balanceMap.get(key);
            if (adder != null && adder.sum() != 0) {
                BigDecimal diff = BigDecimal.valueOf(adder.sum()).divide(new BigDecimal("10000"));
                synchronized(d.balErrors) {
                    if (d.balErrors.isEmpty()) d.balErrors.add(type + " Mismatch: " + diff.toPlainString());
                }
            }
        });
        return rows.stream().anyMatch(ExcelRowData::hasErrors);
    }

    private void updateStage(String requestId, int stage, Integer totalRows, Integer processed) {
        BulkUploadRequest req = bulkUploadRepo.findById(requestId).orElse(null);
        if (req != null) {
            req.setCurrentStage(stage);
            if (totalRows != null) req.setTotalRows(totalRows);
            if (processed != null) req.setProcessedCount(processed);
            bulkUploadRepo.save(req);
        }
    }

    private void failRequest(String requestId, List<ExcelRowData> rows, String msg, int stage) throws IOException {
        long errCount = rows.stream().filter(ExcelRowData::hasErrors).count();
        BulkUploadRequest req = bulkUploadRepo.findById(requestId).orElse(new BulkUploadRequest());
        req.setStatus("ERROR");
        req.setErrorCount(errCount);
        req.setMessage(msg);
        req.setCurrentStage(stage);
        req.setErrorFile(generateErrorExcelFast(rows)); 
        bulkUploadRepo.save(req);
    }

    private void completeRequest(String requestId, List<ExcelRowData> rows, LocalDate pDate, boolean isCsv) throws IOException {
        BulkUploadRequest req = bulkUploadRepo.findById(requestId).orElse(new BulkUploadRequest());
        req.setCurrentStage(4);
        req.setStatus("SUCCESS");
        req.setMessage("Validation Successful");
        
        List<Map<String, Object>> preview = rows.stream().limit(100).map(this::mapToPreview).collect(Collectors.toList());
        req.setPreviewDataJson(objectMapper.writeValueAsString(preview));

        if (!isCsv) req.setSuccessFile(generateSuccessCsv(rows, pDate));
        
        bulkUploadRepo.save(req);
    }

    private void updateStatus(String requestId, String status, String message) {
        BulkUploadRequest req = bulkUploadRepo.findById(requestId).orElse(new BulkUploadRequest());
        req.setStatus(status);
        req.setMessage(message);
        bulkUploadRepo.save(req);
    }

    private byte[] generateErrorExcelFast(List<ExcelRowData> rows) throws IOException {
        try (SXSSFWorkbook workbook = new SXSSFWorkbook(100)) { 
            workbook.setCompressTempFiles(true);
            Sheet sheet = workbook.createSheet("Error Report");

            CellStyle normalHeaderStyle = workbook.createCellStyle();
            Font normalFont = workbook.createFont();
            normalFont.setBold(true);
            normalFont.setColor(IndexedColors.BLACK.getIndex());
            normalHeaderStyle.setFont(normalFont);

            CellStyle errorHeaderStyle = workbook.createCellStyle();
            Font errorFont = workbook.createFont();
            errorFont.setBold(true);
            errorFont.setColor(IndexedColors.RED.getIndex());
            errorHeaderStyle.setFont(errorFont);
            
            CellStyle errorDataStyle = workbook.createCellStyle();
            Font errorDataFont = workbook.createFont();
            errorDataFont.setColor(IndexedColors.RED.getIndex());
            errorDataStyle.setFont(errorDataFont);

            Row header = sheet.createRow(0);
            String[] headers = {"Branch", "Currency", "CGL", "Amount", "TxnType", "Remarks", "Product", "FORMAT ERRORS", "DB ERRORS", "BALANCE ERRORS"};
            for(int i=0; i<headers.length; i++) {
                Cell c = header.createCell(i);
                c.setCellValue(headers[i]);
                c.setCellStyle(headers[i].contains("ERRORS") ? errorHeaderStyle : normalHeaderStyle);
            }

            int idx = 1;
            for(ExcelRowData d : rows) {
                Row r = sheet.createRow(idx++);
                r.createCell(0).setCellValue(d.branch);
                r.createCell(1).setCellValue(d.currency);
                r.createCell(2).setCellValue(d.cgl);
                r.createCell(3).setCellValue(d.amount != null ? d.amount.toString() : "");
                r.createCell(4).setCellValue(d.txnType);
                r.createCell(5).setCellValue(d.remarks);
                r.createCell(6).setCellValue(d.productCode);
                
                if(!d.formatErrors.isEmpty()) {
                    Cell c = r.createCell(7); c.setCellValue(String.join("; ", d.formatErrors)); c.setCellStyle(errorDataStyle);
                }
                if(!d.dbErrors.isEmpty()) {
                    Cell c = r.createCell(8); c.setCellValue(String.join("; ", d.dbErrors)); c.setCellStyle(errorDataStyle);
                }
                if(!d.balErrors.isEmpty()) {
                    Cell c = r.createCell(9); c.setCellValue(String.join("; ", d.balErrors)); c.setCellStyle(errorDataStyle);
                }
            }
            ByteArrayOutputStream out = new ByteArrayOutputStream();
            workbook.write(out);
            workbook.dispose();
            return out.toByteArray();
        }
    }

    private List<ExcelRowData> parseExcelBytes(byte[] bytes) throws IOException {
        try (ByteArrayInputStream is = new ByteArrayInputStream(bytes);
             Workbook workbook = new XSSFWorkbook(is)) {
             return parseWorkbookLogic(workbook);
        }
    }

    private List<ExcelRowData> parseCsvBytes(byte[] bytes) throws IOException {
        try (BufferedReader reader = new BufferedReader(new InputStreamReader(new ByteArrayInputStream(bytes), StandardCharsets.UTF_8))) {
             return parseCsvReaderLogic(reader);
        }
    }
    
    private List<ExcelRowData> parseWorkbookLogic(Workbook workbook) {
        List<ExcelRowData> rows = new ArrayList<>();
        Sheet sheet = workbook.getSheetAt(0);
        DataFormatter formatter = new DataFormatter();
        for (Row row : sheet) {
            if (isRowEmpty(row)) continue;
            ExcelRowData data = new ExcelRowData();
            data.rowIndex = row.getRowNum();
            data.branch = parseCode(row.getCell(0), formatter);     
            data.currency = getCellValueAsString(row.getCell(1), formatter).toUpperCase().trim(); 
            data.cgl = parseCode(row.getCell(2), formatter);        
            String amountRaw = getCellValueAsString(row.getCell(3), formatter).trim(); 
            String typeRaw = getCellValueAsString(row.getCell(4), formatter).trim().toUpperCase(); 
            data.remarks = getCellValueAsString(row.getCell(5), formatter);
            data.productCode = parseCode(row.getCell(6), formatter); 
            data.txnType = typeRaw; 
            parseAmountAndType(data, amountRaw, typeRaw);
            rows.add(data);
        }
        return rows;
    }

    private List<ExcelRowData> parseCsvReaderLogic(BufferedReader reader) throws IOException {
        List<ExcelRowData> rows = new ArrayList<>();
        String line;
        int lineNum = 0;
        while ((line = reader.readLine()) != null) {
            if (line.trim().isEmpty()) continue;
            String[] cols = line.split(",", -1); 
            if (cols.length < 9) continue; 
            ExcelRowData data = new ExcelRowData();
            data.rowIndex = lineNum++;
            data.branch = cols[4].trim();
            data.currency = cols[5].trim();
            data.cgl = cols[6].trim();
            String amountRaw = cols[7].trim();
            String typeRaw = cols[8].trim();
            data.remarks = (cols.length > 9) ? cols[9].trim() : "";
            if (cols.length > 10) { String prod = cols[10].trim(); data.productCode = "A".equalsIgnoreCase(prod) ? "" : prod; }
            data.txnType = typeRaw;
            parseAmountAndType(data, amountRaw, typeRaw);
            rows.add(data);
        }
        return rows;
    }

    private void parseAmountAndType(ExcelRowData data, String amountRaw, String typeRaw) {
        try {
            String cleanAmountStr = CLEAN_AMOUNT_REGEX.matcher(amountRaw).replaceAll("");
            if (cleanAmountStr.isEmpty()) throw new NumberFormatException("Empty");
            BigDecimal amt = new BigDecimal(cleanAmountStr);
            boolean isCredit = false;
            if (typeRaw.startsWith("C") || typeRaw.contains("CR")) isCredit = true;
            if (amountRaw.toUpperCase().contains("CR")) isCredit = true;
            if (amountRaw.toUpperCase().contains("DR")) isCredit = false;
            if (amountRaw.startsWith("-")) isCredit = true;
            data.amount = isCredit ? amt.abs().negate() : amt.abs();
        } catch (Exception e) { data.amount = BigDecimal.ZERO; }
    }

    private byte[] generateSuccessCsv(List<ExcelRowData> rows, LocalDate postingDate) {
        StringBuilder csv = new StringBuilder(rows.size() * 100);
        DateTimeFormatter ddMMyyyy = DateTimeFormatter.ofPattern("ddMMyyyy");
        String col2 = postingDate.format(ddMMyyyy);
        int month = postingDate.getMonthValue();
        int year = postingDate.getYear();
        String col3 = (month >= 4) ? String.valueOf(year) : String.valueOf(year - 1);
        String col4 = (month >= 4) ? String.format("%02d", month - 3) : String.format("%02d", month + 9);

        for (ExcelRowData row : rows) {
            String col5 = String.format("%5s", row.branch).replace(' ', '0');
            String col6 = (row.currency == null || row.currency.isEmpty()) ? "INR" : row.currency;
            BigDecimal absAmt = row.amount.abs();
            String plainAmt = absAmt.setScale(4, RoundingMode.HALF_UP).toPlainString();
            int dotIndex = plainAmt.indexOf('.');
            String intPart = (dotIndex == -1) ? plainAmt : plainAmt.substring(0, dotIndex);
            String decPart = (dotIndex == -1) ? "0000" : plainAmt.substring(dotIndex + 1);
            String col8 = String.format("%16s", intPart).replace(' ', '0') + "." + decPart;
            String col9 = (row.amount.compareTo(BigDecimal.ZERO) < 0) ? "Cr" : "Dr";
            String col10 = (row.remarks != null) ? row.remarks.replace(",", " ") : "";
            String col11 = (row.productCode != null && !row.productCode.isEmpty()) ? row.productCode : "A";

            csv.append("01,").append(col2).append(",").append(col3).append(",").append(col4).append(",")
               .append(col5).append(",").append(col6).append(",").append(row.cgl).append(",")
               .append(col8).append(",").append(col9).append(",").append(col10).append(",")
               .append(col11).append(",B,C,D\n");
        }
        return csv.toString().getBytes();
    }

    private String parseCode(Cell cell, DataFormatter formatter) {
        if (cell == null) return "";
        String val = getCellValueAsString(cell, formatter).trim();
        if (val.endsWith(".0")) return val.substring(0, val.length() - 2);
        return val;
    }

    private String getCellValueAsString(Cell cell, DataFormatter formatter) {
        if (cell == null) return "";
        if (cell.getCellType() == CellType.STRING) return cell.getStringCellValue().trim();
        if (cell.getCellType() == CellType.NUMERIC) {
            if (DateUtil.isCellDateFormatted(cell)) return cell.getDateCellValue().toString();
            return BigDecimal.valueOf(cell.getNumericCellValue()).toPlainString();
        }
        if (cell.getCellType() == CellType.BOOLEAN) return String.valueOf(cell.getBooleanCellValue());
        return "";
    }

    private boolean isRowEmpty(Row row) {
        if (row == null) return true;
        for (int c = row.getFirstCellNum(); c < row.getLastCellNum(); c++) {
            Cell cell = row.getCell(c);
            if (cell != null && cell.getCellType() != CellType.BLANK && !getCellValueAsString(cell, new DataFormatter()).trim().isEmpty())
                return false;
        }
        return true;
    }

    private Map<String, Object> mapToPreview(ExcelRowData r) {
        Map<String, Object> m = new HashMap<>();
        m.put("id", r.rowIndex); m.put("branch", r.branch); m.put("currency", r.currency);
        m.put("cgl", r.cgl); m.put("amount", r.amount!=null?r.amount.abs().toString():"");
        m.put("txnType", r.txnType); m.put("remarks", r.remarks); m.put("productCode", r.productCode);
        return m;
    }
