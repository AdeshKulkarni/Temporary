// ... existing imports
import org.springframework.core.io.ByteArrayResource;
import org.springframework.http.HttpHeaders;
import org.springframework.http.MediaType;
import org.springframework.web.multipart.MultipartFile;
import com.fincore.JournalService.Service.JournalBulkValidationService;

// Inside JournalRequestController class
    
    private final JournalBulkValidationService journalBulkValidationService; // Add to constructor

    @PostMapping(value = "/bulk-validate", consumes = MediaType.MULTIPART_FORM_DATA_VALUE)
    public ResponseEntity<?> validateBulkUpload(@RequestParam("file") MultipartFile file) throws IOException {
        log.info("Received file for bulk validation: {}", file.getOriginalFilename());

        Map<String, Object> result = journalBulkValidationService.validateAndProcessExcel(file);

        if ("ERROR".equals(result.get("status"))) {
            byte[] fileContent = (byte[]) result.get("file");
            long count = (long) result.get("errorCount");

            ByteArrayResource resource = new ByteArrayResource(fileContent);

            // Return file download with error count in header or a composite object
            // Here we return the file, frontend will handle the blob
            return ResponseEntity.badRequest()
                    .header("X-Error-Count", String.valueOf(count))
                    .header(HttpHeaders.CONTENT_DISPOSITION, "attachment; filename=Error_Report.xlsx")
                    .contentType(MediaType.APPLICATION_OCTET_STREAM)
                    .body(resource);
        }

        // Success Case
        return ResponseEntity.ok(Map.of(
            "message", result.get("message"),
            "status", "SUCCESS"
        ));
    }

Part 2: Frontend Implementation
I have completely rewritten JournalBulkUpload.jsx to remove client-side processing and instead send the file to the backend, handle the validation errors, and download the error Excel if validation fails.
JournalBulkUpload.jsx
import React, { useState, useRef } from "react";
import {
  Box,
  Typography,
  Paper,
  Grid,
  TextField,
  Button,
  Alert,
  Stack,
  CircularProgress,
  Chip,
} from "@mui/material";
import {
  CloudUpload as CloudUploadIcon,
  RestartAlt as RestartAltIcon,
  Description as DescriptionIcon,
  CheckCircle as CheckCircleIcon,
  Error as ErrorIcon,
} from "@mui/icons-material";

// Import your useApi hook
import useApi from "../../hooks/useApi"; 

import {
  mainContainerStyle,
  uploadBoxStyle,
  controlPanelStyle,
} from "./JournalBulkStyle";

const JournalBulkUpload = () => {
  const { callApi } = useApi(); // Assuming this hook can handle basic fetch/axios wrapping

  const [selectedDate, setSelectedDate] = useState("");
  const [file, setFile] = useState(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const [successMsg, setSuccessMsg] = useState("");
  const [errorCount, setErrorCount] = useState(0);

  const fileInputRef = useRef(null);

  // --- Handlers ---

  const handleDateChange = (e) => {
    setSelectedDate(e.target.value);
    setSuccessMsg("");
    setError("");
    setErrorCount(0);
  };

  const handleFileChange = (e) => {
    const selectedFile = e.target.files[0];
    if (selectedFile) {
      const fileType = selectedFile.name.split(".").pop().toLowerCase();
      if (fileType !== "xlsx" && fileType !== "xls") {
        setError("Invalid file type. Please upload .xlsx or .xls");
        setFile(null);
        return;
      }
      setFile(selectedFile);
      setError("");
      setSuccessMsg("");
      setErrorCount(0);
    }
  };

  const handleUploadBoxClick = () => {
    fileInputRef.current.click();
  };

  const resetForm = () => {
    setFile(null);
    setSelectedDate("");
    setError("");
    setSuccessMsg("");
    setErrorCount(0);
    if (fileInputRef.current) fileInputRef.current.value = "";
  };

  const handleValidation = async () => {
    if (!selectedDate || !file) {
      setError("Please select a Date and upload a File.");
      return;
    }

    setLoading(true);
    setError("");
    setSuccessMsg("");
    setErrorCount(0);

    const formData = new FormData();
    formData.append("file", file);

    try {
      // Direct fetch is often easier for Blobs than wrappers unless wrapper handles blobs specifically
      const token = localStorage.getItem("token") || ""; // Adjust based on your auth storage
      const baseUrl = process.env.REACT_APP_API_URL || "http://localhost:8080/api"; // Adjust URL

      const response = await fetch(`${baseUrl}/JS/journals/bulk-validate`, {
        method: "POST",
        headers: {
          "Authorization": `Bearer ${token}`, // If you use JWT
        },
        body: formData,
      });

      const contentType = response.headers.get("content-type");

      if (!response.ok) {
        // Handle Validation Errors (Bad Request)
        if (contentType && contentType.includes("application/octet-stream")) {
            // It's a file download (Error Report)
            const count = response.headers.get("X-Error-Count");
            setErrorCount(count || "Unknown");
            setError("Validation Failed. Downloading error report...");

            const blob = await response.blob();
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = `Error_Report_${new Date().getTime()}.xlsx`;
            document.body.appendChild(a);
            a.click();
            a.remove();
        } else {
            // Standard JSON error
            const errData = await response.json();
            setError(errData.message || "Upload failed");
        }
      } else {
        // Success (200 OK)
        const data = await response.json();
        setSuccessMsg(data.message || "File validated successfully!");
      }

    } catch (err) {
      console.error(err);
      setError("An unexpected error occurred connecting to the server.");
    } finally {
      setLoading(false);
    }
  };

  return (
    <Box sx={mainContainerStyle}>
      <Paper elevation={3} sx={controlPanelStyle}>
        <Grid container spacing={3}>
          {/* 1. Date Picker */}
          <Grid item xs={12} md={4}>
            <Typography variant="subtitle2" gutterBottom>
              1. Select Posting Date
            </Typography>
            <TextField
              type="date"
              fullWidth
              size="small"
              value={selectedDate}
              onChange={handleDateChange}
              InputLabelProps={{ shrink: true }}
            />
          </Grid>

          {/* 2. File Upload */}
          <Grid item xs={12} md={4}>
            <Typography variant="subtitle2" gutterBottom>
              2. Upload Excel File
            </Typography>
            <Box sx={uploadBoxStyle} onClick={handleUploadBoxClick}>
              <input
                type="file"
                hidden
                accept=".xlsx, .xls"
                onChange={handleFileChange}
                ref={fileInputRef}
              />
              {file ? (
                <>
                  <DescriptionIcon color="success" fontSize="large" />
                  <Typography variant="body2" sx={{ mt: 1, fontWeight: "bold" }}>
                    {file.name}
                  </Typography>
                  <Typography variant="caption" color="textSecondary">
                    Click to change
                  </Typography>
                </>
              ) : (
                <>
                  <CloudUploadIcon color="action" fontSize="large" />
                  <Typography variant="body2" sx={{ mt: 1 }}>
                    Click to Upload Excel
                  </Typography>
                  <Typography variant="caption" color="textSecondary">
                    .xlsx or .xls
                  </Typography>
                </>
              )}
            </Box>
          </Grid>

          {/* 3. Actions */}
          <Grid
            item
            xs={12}
            md={4}
            sx={{
              display: "flex",
              flexDirection: "column",
              justifyContent: "center",
              gap: 2,
            }}
          >
            <Button
              variant="contained"
              color="primary"
              onClick={handleValidation}
              disabled={loading || !file || !selectedDate}
              startIcon={
                loading ? <CircularProgress size={20} color="inherit" /> : <CheckCircleIcon />
              }
              fullWidth
            >
              {loading ? "Validating..." : "Validate & Process"}
            </Button>

            <Button
              variant="outlined"
              color="error"
              onClick={resetForm}
              startIcon={<RestartAltIcon />}
              fullWidth
            >
              Reset
            </Button>
          </Grid>
        </Grid>

        {/* Feedback Section */}
        <Box sx={{ mt: 3 }}>
          {loading && (
            <Alert severity="info" icon={<CircularProgress size={20} />}>
              Validating Branch, CGL, Currency, and Balancing rules on Server...
            </Alert>
          )}

          {error && (
            <Alert 
                severity="error" 
                sx={{ mt: 1 }}
                action={
                    errorCount > 0 && (
                        <Chip 
                            icon={<ErrorIcon sx={{color: 'white !important'}}/>} 
                            label={`${errorCount} Errors Found`} 
                            color="error" 
                            variant="filled"
                        />
                    )
                }
            >
              <Typography variant="body2" fontWeight="bold">
                {error}
              </Typography>
              {errorCount > 0 && (
                <Typography variant="caption" display="block">
                    The error report has been downloaded automatically. Please correct the Excel file and re-upload.
                </Typography>
              )}
            </Alert>
          )}

          {successMsg && (
            <Alert severity="success" sx={{ mt: 1 }}>
              <Typography variant="subtitle2" fontWeight="bold">Success!</Typography>
              {successMsg}
            </Alert>
          )}
        </Box>
      </Paper>
      
      {/* Information Section */}
      <Box sx={{ mt: 2, p: 2, bgcolor: "#f5f5f5", borderRadius: 1 }}>
        <Typography variant="caption" color="textSecondary" component="div">
          <strong>Validation Rules:</strong>
          <ul>
            <li>Branch, Currency, and CGL must exist in Master tables.</li>
            <li>Amount cannot be zero.</li>
            <li>Remarks must be &le; 30 characters.</li>
            <li>Total Debit must equal Total Credit for every Branch.</li>
          </ul>
        </Typography>
      </Box>
    </Box>
  );
};

export default JournalBulkUpload;

Summary of Changes
 * Backend:
   * Created CurrencyMaster entity and repository.
   * Created JournalBulkValidationService to parse Excel, perform all specific validations (Master existence, Balance check, Regex/Logic checks), and generate a new Excel file with an "ERRORS" column if validation fails.
   * Updated JournalRequestController to expose the endpoint /bulk-validate.
 * Frontend:
   * Removed xlsx client-side parsing.
   * Updated UI to send FormData to the new backend endpoint.
   * Added logic to handle binary responses (Blob) for automatic download of the error report.
   * Added error counting and specific user feedback based on backend headers.
