    // --- 1. INITIATE ---
    public String initiateValidation(MultipartFile file, LocalDate postingDate) throws IOException {
        String requestId = UUID.randomUUID().toString();

        // Save Initial State to Redis
        BulkUploadStateDto state = new BulkUploadStateDto();
        state.setRequestId(requestId);
        state.setStatus("PROCESSING");
        state.setCurrentStage(1); // Start Stage 1
        state.setMessage("Validating Formats...");
        saveStateToRedis(state);

        byte[] fileBytes = file.getBytes();
        String filename = file.getOriginalFilename();
        processAsync(requestId, fileBytes, filename, postingDate);

        return requestId;
    }

    // --- 2. ASYNC PROCESS ---
    @Async("bulkExecutor")
    public void processAsync(String requestId, byte[] fileBytes, String filename, LocalDate postingDate) {
        try {
            // Parse
            List<ExcelRowData> parsedRows;
            if (filename != null && (filename.toLowerCase().endsWith(".csv") || filename.toLowerCase().endsWith(".txt"))) {
                parsedRows = parseCsvBytes(fileBytes);
            } else {
                parsedRows = parseExcelBytes(fileBytes);
            }
            boolean isInputCsv = filename != null && filename.toLowerCase().endsWith(".csv");

            // Update Total Rows
            updateState(requestId, s -> s.setTotalRows(parsedRows.size()));

            // ==========================================
            // STAGE 1: FORMAT VALIDATION
            // ==========================================
            if (runFormatValidation(parsedRows)) {
                failRequest(requestId, parsedRows, "Format Validation Failed (Stage 1)");
                return; // STOP
            }

            // Simulating a tiny delay if needed for UI smoothness (optional)
            updateState(requestId, s -> { s.setCurrentStage(2); s.setMessage("Checking Database..."); });

            // ==========================================
            // STAGE 2: DATABASE CHECK
            // ==========================================
            if (runDbValidation(parsedRows)) {
                failRequest(requestId, parsedRows, "Database Validation Failed (Stage 2)");
                return; // STOP
            }

            updateState(requestId, s -> { s.setCurrentStage(3); s.setMessage("Checking Balances..."); });

            // ==========================================
            // STAGE 3: BALANCE CHECK
            // ==========================================
            if (runBalanceCheck(parsedRows)) {
                failRequest(requestId, parsedRows, "Debit/Credit Balance Mismatch (Stage 3)");
                return; // STOP
            }

            // ==========================================
            // STAGE 4: FINALIZE
            // ==========================================
            completeRequest(requestId, parsedRows, postingDate, isInputCsv);

        } catch (Exception e) {
            log.error("Async Error", e);
            updateState(requestId, s -> { s.setStatus("ERROR"); s.setMessage("System Error: " + e.getMessage()); });
        }
    }

    // --- STAGE LOGIC ---

    private boolean runFormatValidation(List<ExcelRowData> rows) {
        rows.parallelStream().forEach(data -> {
            if (data.branch == null || data.branch.isEmpty()) data.errors.add("Format: Branch Empty");
            if (data.currency == null || data.currency.length() != 3) data.errors.add("Format: Currency invalid length");
            if (data.cgl == null || !CGL_FORMAT_REGEX.matcher(data.cgl).matches()) data.errors.add("Format: CGL invalid");
            if (data.amount == null || data.amount.compareTo(BigDecimal.ZERO) == 0) data.errors.add("Format: Amount Zero/Invalid");
            if (data.productCode != null && !data.productCode.isEmpty() && !PRODUCT_CODE_REGEX.matcher(data.productCode).matches()) {
                data.errors.add("Format: Product Code must be 8 digits");
            }
        });
        return rows.stream().anyMatch(r -> !r.errors.isEmpty());
    }

    private boolean runDbValidation(List<ExcelRowData> rows) {
        Set<String> branches = rows.parallelStream().map(r -> r.branch).collect(Collectors.toSet());
        Set<String> cgls = rows.parallelStream().map(r -> r.cgl).collect(Collectors.toSet());
        Set<String> currencies = rows.parallelStream().map(r -> r.currency).collect(Collectors.toSet());

        Set<String> validBranches = branchRepo.findAllById(branches).stream().map(BranchMaster::getCode).collect(Collectors.toSet());
        Set<String> validCgls = cglRepo.findAllById(cgls).stream().map(CglMaster::getCglNumber).collect(Collectors.toSet());
        Set<String> validCurrencies = currencyRepo.findAllById(currencies).stream().map(CurrencyMaster::getCurrencyCode).collect(Collectors.toSet());

        rows.parallelStream().forEach(data -> {
            if (!validBranches.contains(data.branch)) data.errors.add("DB: Branch not found (" + data.branch + ")");
            if (!validCurrencies.contains(data.currency)) data.errors.add("DB: Currency not found (" + data.currency + ")");
            if (!validCgls.contains(data.cgl)) data.errors.add("DB: CGL not found (" + data.cgl + ")");
        });
        return rows.stream().anyMatch(r -> !r.errors.isEmpty());
    }

    private boolean runBalanceCheck(List<ExcelRowData> rows) {
        ConcurrentHashMap<String, LongAdder> balanceMap = new ConcurrentHashMap<>();
        rows.parallelStream().forEach(data -> {
            if (data.amount != null) {
                String cglType = (data.cgl.startsWith("5")) ? "MEMO" : "NORMAL";
                String key = data.branch + "_" + data.currency + "_" + cglType;
                long val = data.amount.multiply(new BigDecimal("10000")).longValue();
                balanceMap.computeIfAbsent(key, k -> new LongAdder()).add(val);
            }
        });

        rows.parallelStream().forEach(data -> {
            String cglType = (data.cgl.startsWith("5")) ? "MEMO" : "NORMAL";
            String key = data.branch + "_" + data.currency + "_" + cglType;
            LongAdder adder = balanceMap.get(key);
            if (adder != null && adder.sum() != 0) {
                BigDecimal diff = BigDecimal.valueOf(adder.sum()).divide(new BigDecimal("10000"));
                synchronized(data.errors) {
                    if (data.errors.isEmpty()) data.errors.add(cglType + " Balance Mismatch: " + diff.toPlainString());
                }
            }
        });
        return rows.stream().anyMatch(r -> !r.errors.isEmpty());
    }

    // --- STATE MANAGEMENT HELPERS ---

    private void failRequest(String requestId, List<ExcelRowData> rows, String msg) throws IOException {
        byte[] errorFile = generateErrorExcel(rows);
        // Save File to Redis (Separate Key)
        saveFileToRedis(requestId, "ERROR", errorFile);

        updateState(requestId, s -> {
            s.setStatus("ERROR");
            s.setMessage(msg);
            s.setErrorCount(rows.stream().filter(r -> !r.errors.isEmpty()).count());
            s.setHasErrorFile(true);
        });
    }

    private void completeRequest(String requestId, List<ExcelRowData> rows, LocalDate pDate, boolean isCsv) throws IOException {
        if (!isCsv) {
            byte[] successFile = generateSuccessCsv(rows, pDate);
            saveFileToRedis(requestId, "SUCCESS", successFile);
        }

        List<Map<String, Object>> preview = rows.stream().limit(100).map(this::mapToPreview).collect(Collectors.toList());
        String previewJson = objectMapper.writeValueAsString(preview);

        updateState(requestId, s -> {
            s.setCurrentStage(4);
            s.setStatus("SUCCESS");
            s.setMessage("Validation Successful");
            s.setHasSuccessFile(!isCsv);
            s.setPreviewDataJson(previewJson);
        });
    }

    // --- REDIS UTILS ---

    private void saveStateToRedis(BulkUploadStateDto state) {
        try {
            String json = objectMapper.writeValueAsString(state);
            redisTemplate.opsForValue().set("upload:meta:" + state.getRequestId(), json, TTL, TimeUnit.MINUTES);
        } catch (Exception e) { log.error("Redis Save Error", e); }
    }

    private void updateState(String requestId, java.util.function.Consumer<BulkUploadStateDto> updater) {
        try {
            String json = redisTemplate.opsForValue().get("upload:meta:" + requestId);
            if (json != null) {
                BulkUploadStateDto state = objectMapper.readValue(json, BulkUploadStateDto.class);
                updater.accept(state);
                saveStateToRedis(state);
            }
        } catch (Exception e) { log.error("Redis Update Error", e); }
    }

    private void saveFileToRedis(String requestId, String type, byte[] data) {
        // Store file in a separate key to avoid loading it during status checks
        // Encoding to Base64 String for Redis Storage
        String key = "upload:file:" + type + ":" + requestId;
        String base64 = Base64.getEncoder().encodeToString(data);
        redisTemplate.opsForValue().set(key, base64, TTL, TimeUnit.MINUTES);
    }

    public byte[] getFileFromRedis(String requestId, String type) {
        String key = "upload:file:" + type + ":" + requestId;
        String base64 = redisTemplate.opsForValue().get(key);
        return base64 != null ? Base64.getDecoder().decode(base64) : null;
    }

    public BulkUploadStateDto getState(String requestId) {
        try {
            String json = redisTemplate.opsForValue().get("upload:meta:" + requestId);
            return json != null ? objectMapper.readValue(json, BulkUploadStateDto.class) : null;
        } catch (Exception e) { return null; }
    }

