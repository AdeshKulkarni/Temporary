    @Override
    @Transactional
    public void cancelMyRequest(Long requestId, String userId) {
        JournalRequest request = journalRequestRepository.findById(requestId)
                .orElseThrow(() -> new ResourceNotFoundException("Journal Request not found."));

        if (!userId.equals(request.getCreatorId())) {
            throw new IllegalStateException("Unauthorized");
        }
        if (request.getRequestStatus() != RequestStatus.PENDING) {
            throw new IllegalStateException("Already processed");
        }
        journalRequestRepository.delete(request);
    }

    @Override
    @Transactional
    public void cancelMyRequestsByBatchId(String batchId, String userId) {
        List<JournalRequest> requestsToCancel = journalRequestRepository.findByBatchIdAndCreatorIdAndRequestStatus(
                batchId, userId, RequestStatus.PENDING);

        if (requestsToCancel.isEmpty()) {
            throw new ResourceNotFoundException("No pending requests found.");
        }
        journalRequestRepository.deleteAll(requestsToCancel);
    }

    @Override
    @Transactional
    public void cancelMyRequestsByJournalPrefix(String journalIdPrefix, String userId) {
        List<JournalRequest> requestsToCancel = journalRequestRepository.findByJournalIdStartingWithAndCreatorIdAndRequestStatus(
                journalIdPrefix, userId, RequestStatus.PENDING);

        if (requestsToCancel.isEmpty()) {
            throw new ResourceNotFoundException("No pending requests found.");
        }
        journalRequestRepository.deleteAll(requestsToCancel);
    }

    @Override
    @Transactional
    public void cancelMyRequestsByJournalPrefixes(List<String> journalIdPrefixes, String userId) {
        Specification<JournalRequest> spec = (root, query, criteriaBuilder) -> {
            List<Predicate> predicates = new ArrayList<>();
            for (String prefix : journalIdPrefixes) {
                predicates.add(criteriaBuilder.like(root.get("journalId"), prefix + "%"));
            }
            Predicate journalIdOrPredicates = criteriaBuilder.or(predicates.toArray(new Predicate[0]));
            Predicate statusPredicate = criteriaBuilder.equal(root.get("requestStatus"), RequestStatus.PENDING);
            Predicate creatorPredicate = criteriaBuilder.equal(root.get("creatorId"), userId);
            return criteriaBuilder.and(journalIdOrPredicates, statusPredicate, creatorPredicate);
        };

        List<JournalRequest> requestsToCancel = journalRequestRepository.findAll(spec);
        if (requestsToCancel.isEmpty()) {
            throw new ResourceNotFoundException("No pending requests found.");
        }
        journalRequestRepository.deleteAll(requestsToCancel);
    }

    private void createNotification(String batchId, String creatorId, int size) {
        try {
            NotificationConfigDto config = permissionConfigService.getConfig("JOURNAL_AUTH");
            String message = String.format("Bulk Journal Batch %s (%d rows) by %s pending approval.", batchId, size, creatorId);
            notificationWriterService.createNotification(null, config.getTargetRoles(), message, config.getTargetUrl(), batchId, "JournalService");
        } catch (Exception e) {
            log.error("Failed to create notification", e);
        }
    }
