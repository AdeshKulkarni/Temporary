2. Frontend: JournalBulkUpload.js (Final)
Includes 4-Stage Stepper, Live Progress, and uses strictly the external styles.
import React, { useState, useRef, useEffect } from "react";
import {
  Box,
  Typography,
  Paper,
  TextField,
  Button,
  CircularProgress,
  Chip,
  Alert,
  Stack,
  Stepper,
  Step,
  StepLabel,
  LinearProgress,
} from "@mui/material";
import {
  CloudUpload as CloudUploadIcon,
  RestartAlt as RestartAltIcon,
  Description as DescriptionIcon,
  CheckCircle as CheckCircleIcon,
  Error as ErrorIcon,
  Download as DownloadIcon,
  Send as SendIcon,
  FormatListBulleted as FormatIcon,
  Storage as DbIcon,
  Balance as BalanceIcon,
  DoneAll as DoneIcon,
} from "@mui/icons-material";

import { DataGrid } from "@mui/x-data-grid";

import {
  mainContainerStyle,
  uploadBoxStyle,
  controlPanelStyle,
  iconStyle,
  headerTextStyle,
  subTextStyle,
  dateinputfield,
  stepperContainerStyle, // New from Style File
  stepLabelStyle,        // New from Style File
  progressContainerStyle // New from Style File
} from "./JournalBulkStyle";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

const steps = [
  { label: 'Format Validation', icon: <FormatIcon /> },
  { label: 'Database Check', icon: <DbIcon /> },
  { label: 'Balance Check', icon: <BalanceIcon /> },
  { label: 'Finalizing', icon: <DoneIcon /> }
];

const JournalBulkUpload = () => {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  const [selectedDate, setSelectedDate] = useState("");
  const [file, setFile] = useState(null);
  const [isCsvInput, setIsCsvInput] = useState(false);

  const [uiError, setUiError] = useState("");
  const [errorCount, setErrorCount] = useState(0);
  const [downloadStatus, setDownloadStatus] = useState("");

  const [requestId, setRequestId] = useState(null);
  const [hasSuccessFile, setHasSuccessFile] = useState(false);
  const [previewRows, setPreviewRows] = useState([]);
  
  // LIVE PROGRESS STATES
  const [totalRows, setTotalRows] = useState(0);
  const [processedRows, setProcessedRows] = useState(0);
  const [activeStep, setActiveStep] = useState(0);
  const [failedStep, setFailedStep] = useState(-1);
  const [isProcessing, setIsProcessing] = useState(false);

  const [isCreatingBatch, setIsCreatingBatch] = useState(false);

  const fileInputRef = useRef(null);

  // --- POLLING LOGIC ---
  useEffect(() => {
    let interval;
    if (isProcessing && requestId) {
      interval = setInterval(async () => {
        try {
          const res = await callApi(`/JS/journals/bulk-status/${requestId}`, null, "GET");
          if (!res) return;

          // 1. Update Live Counts
          if (res.totalRows) setTotalRows(res.totalRows);
          if (res.processedCount) setProcessedRows(res.processedCount);

          // 2. Update Stepper (Backend Stage 1..4 -> Index 0..3)
          if (res.currentStage > 0) {
             setActiveStep((prev) => Math.max(prev, res.currentStage - 1));
          }

          // 3. Check Status
          if (res.status === "ERROR") {
            setIsProcessing(false);
            setFailedStep(res.currentStage ? res.currentStage - 1 : 0);
            setErrorCount(res.errorCount || 0);
            setUiError(res.message || "Validation Failed");
            showSnackBar("Validation Failed", "error");
            clearInterval(interval);
          } else if (res.status === "SUCCESS") {
            setIsProcessing(false);
            setActiveStep(4); // Mark all complete
            setHasSuccessFile(res.hasSuccessFile);
            if (res.previewData) setPreviewRows(res.previewData);
            showSnackBar("Validation Successful!", "success");
            clearInterval(interval);
          }
        } catch (e) {
          console.error("Poll Error", e);
        }
      }, 1000); // Poll every 1 second
    }
    return () => clearInterval(interval);
  }, [isProcessing, requestId, callApi, showSnackBar]);

  const handleDownloadFile = (type) => {
    if (!requestId) return;
    const baseUrl = process.env.REACT_APP_API_URL || "http://localhost:8080";
    window.location.href = `${baseUrl}/JS/journals/download-bulk-file/${requestId}?type=${type}`;
    if (type === "ERROR") {
        setDownloadStatus("Report Downloaded");
    }
  };

  const handleDateChange = (e) => {
    setSelectedDate(e.target.value);
    resetState();
  };

  const handleFileChange = (e) => {
    const selectedFile = e.target.files[0];
    if (selectedFile) {
      const name = selectedFile.name.toLowerCase();
      if (!name.endsWith(".xlsx") && !name.endsWith(".xls") && !name.endsWith(".csv")) {
        showSnackBar("Invalid file type.", "error");
        setFile(null);
        return;
      }
      setFile(selectedFile);
      setIsCsvInput(name.endsWith(".csv"));
      resetState();
    }
  };

  const resetState = () => {
    setUiError("");
    setErrorCount(0);
    setHasSuccessFile(false);
    setPreviewRows([]);
    setTotalRows(0);
    setProcessedRows(0);
    setRequestId(null);
    setActiveStep(0);
    setFailedStep(-1);
    setDownloadStatus("");
  };

  const resetForm = () => {
    setFile(null);
    setSelectedDate("");
    resetState();
    setIsProcessing(false);
    setIsCreatingBatch(false);
    setIsCsvInput(false);
    if (fileInputRef.current) fileInputRef.current.value = "";
  };

  const startValidation = async () => {
    if (!file || !selectedDate) {
      showSnackBar("Please select Date and File.", "warning");
      return;
    }
    
    resetState();
    setIsProcessing(true);

    const formData = new FormData();
    formData.append("file", file);
    formData.append("postingDate", selectedDate);

    try {
      const res = await callApi("/JS/journals/bulk-validate-init", formData, "POST", "json", "multipart/form-data");
      if (res && res.requestId) {
          setRequestId(res.requestId);
      } else {
          setIsProcessing(false);
          showSnackBar("Failed to start validation.", "error");
      }
    } catch (err) {
      setIsProcessing(false);
      showSnackBar("System Error", "error");
    }
  };

  const handleSubmitBatch = async () => {
    if (previewRows.length === 0) return;
    setIsCreatingBatch(true);

    try {
      const payloadRows = previewRows.map((row) => ({
        changeType: "ADD",
        branch: row.branch,
        currency: row.currency,
        cgl: row.cgl,
        amount: row.txnType === "Credit" ? "-" + row.amount : row.amount,
        productType: row.productCode,
        remarks: row.remarks,
        arFlag: "A",
        acClassification: "A",
      }));

      const finalPayload = { commonBatchRemarks: `Bulk Upload - ${selectedDate}`, rows: payloadRows };
      const response = await callApi("/JS/journals/create-bulk-batch", finalPayload, "POST");

      if (response && response.status === "SUCCESS") {
        showSnackBar(`Batch Created! ID: ${response.batchId}`, "success");
        resetForm();
      }
    } catch (e) {
      showSnackBar("Failed to create batch.", "error");
    } finally {
      setIsCreatingBatch(false);
    }
  };

  // Percentage Calculation
  const progressPercent = totalRows > 0 ? Math.min(100, Math.round((processedRows / totalRows) * 100)) : 0;

  const columns = [
    { field: "branch", headerName: "Branch", flex: 1, align: "center", headerAlign: "center" },
    { field: "currency", headerName: "Currency", width: 100, align: "center", headerAlign: "center" },
    { field: "cgl", headerName: "CGL", flex: 1.5, align: "center", headerAlign: "center" },
    { field: "productCode", headerName: "Product", width: 120, align: "center", headerAlign: "center", renderCell: (p) => p.value || "-" },
    { 
      field: "amount", headerName: "Amount", flex: 1.5, minWidth: 150, align: "right", headerAlign: "center",
      valueFormatter: (params) => {
        const val = params?.value || params;
        if (!val) return "0.00";
        const parts = String(val).split(".");
        parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        return parts.join(".");
      }
    },
    { 
      field: "txnType", headerName: "Type", width: 100, align: "center", headerAlign: "center",
      renderCell: (params) => (
        <Chip 
          label={params.value} 
          color={params.value === "Credit" ? "error" : "success"} 
          size="small" 
          variant="filled"
          sx={{ fontWeight: "bold", width: "80px" }}
        />
      )
    },
    { field: "remarks", headerName: "Remarks", flex: 2, align: "center", headerAlign: "center" },
  ];

  return (
    <Box sx={mainContainerStyle}>
      <Paper elevation={1} sx={controlPanelStyle}>
        
        {/* Date Input */}
        <Box sx={dateinputfield}>
            <TextField
                type="date"
                label="Posting Date"
                sx={{ alignItems: "center" }}
                size="small"
                value={selectedDate}
                onChange={handleDateChange}
                InputLabelProps={{ shrink: true }}
                inputProps={{ max: new Date().toISOString().split("T")[0] }} // No Future Date
            />
        </Box>

        {/* Upload Box */}
        <Box sx={uploadBoxStyle} onClick={() => fileInputRef.current.click()}>
          <input type="file" hidden accept=".xlsx,.xls,.csv" onChange={handleFileChange} ref={fileInputRef} />
          {file ? (
            <>
              <DescriptionIcon color="success" sx={{ fontSize: 60, mb: 1 }} />
              <Typography variant="h6" sx={headerTextStyle}>{file.name}</Typography>
              <Chip label="Ready" color="success" size="small" variant="outlined" />
              <Typography variant="caption" sx={{ mt: 1, color: "text.disabled" }}>Click to change</Typography>
            </>
          ) : (
            <>
              <CloudUploadIcon sx={iconStyle} />
              <Typography variant="h6" sx={headerTextStyle}>Click to Upload</Typography>
              <Typography sx={subTextStyle}>Supported: .xlsx, .xls, .csv</Typography>
            </>
          )}
        </Box>

        {/* STEPPER UI */}
        {(isProcessing || activeStep > 0 || failedStep !== -1) && (
            <Box sx={stepperContainerStyle}>
                <Stepper activeStep={activeStep} alternativeLabel>
                    {steps.map((step, index) => {
                        const isFailed = index === failedStep;
                        return (
                            <Step key={step.label}>
                                <StepLabel 
                                    error={isFailed}
                                    sx={stepLabelStyle}
                                    StepIconComponent={() => {
                                        if (isFailed) return <ErrorIcon color="error" />;
                                        if (index < activeStep) return <CheckCircleIcon color="success" />;
                                        if (index === activeStep && isProcessing) return <CircularProgress size={20} />;
                                        return <Typography color="text.disabled" fontWeight="bold">{index + 1}</Typography>;
                                    }}
                                >
                                    {step.label}
                                </StepLabel>
                            </Step>
                        );
                    })}
                </Stepper>
                
                {/* LIVE PROGRESS BAR */}
                {isProcessing && totalRows > 0 && (
                    <Box sx={progressContainerStyle}>
                        <LinearProgress variant="determinate" value={progressPercent} sx={{ height: 8, borderRadius: 4 }} />
                        <Typography variant="caption" color="text.secondary" sx={{ display:'block', mt: 1 }}>
                            Processed: {processedRows.toLocaleString()} / {totalRows.toLocaleString()} ({progressPercent}%)
                        </Typography>
                    </Box>
                )}
            </Box>
        )}

        <br />
        <Stack direction="row" sx={{ display: "flex", justifyContent: "center" }} spacing={2}>
          <Button
            variant="contained"
            onClick={startValidation}
            disabled={isProcessing || !file || !selectedDate}
            startIcon={isProcessing ? <CircularProgress size={20} color="inherit" /> : <CheckCircleIcon />}
            size="large"
          >
            {isProcessing ? "Processing..." : "Validate"}
          </Button>

          <Button variant="outlined" color="error" onClick={resetForm} startIcon={<RestartAltIcon />} disabled={isProcessing} size="large">
            Reset
          </Button>
        </Stack>

        {/* RESULTS SECTION */}
        <Box sx={{ mt: 3 }}>
          {uiError && (
            <Alert severity="error" sx={{ mb: 2, border: "1px solid #ee0404ff" }}>
              <Typography variant="subtitle2" fontWeight="bold">Validation Failed</Typography>
              <Typography variant="body2">{uiError}</Typography>
              
              <Button 
                variant="outlined" 
                color="error" 
                size="small" 
                startIcon={<DownloadIcon />}
                sx={{ mt: 1, bgcolor: 'background.paper' }}
                onClick={() => handleDownloadFile("ERROR")}
              >
                {downloadStatus || "Download Error Report"}
              </Button>
            </Alert>
          )}

          {!uiError && previewRows.length > 0 && (
            <Paper variant="outlined" sx={{ p: 2, borderColor: "success.main" }}>
              <Stack direction={{ xs: "column", sm: "row" }} justifyContent="space-between" alignItems="center" spacing={2}>
                <Box>
                  <Stack direction="row" alignItems="center" spacing={1}>
                    <CheckCircleIcon color="success" />
                    <Typography variant="subtitle1" fontWeight="bold">Validation Successful!</Typography>
                  </Stack>
                  <Typography variant="body2">
                    {totalRows.toLocaleString()} rows verified. Ready for submission.
                  </Typography>
                </Box>
                <Stack direction="row" spacing={2}>
                  {!isCsvInput && hasSuccessFile && (
                    <Button
                      variant="outlined"
                      color="success"
                      startIcon={<DownloadIcon />}
                      onClick={() => handleDownloadFile("SUCCESS")}
                      sx={{ bgcolor: "background.paper" }}
                    >
                      Download CSV
                    </Button>
                  )}
                  <Button
                    variant="contained"
                    color="success"
                    startIcon={isCreatingBatch ? <CircularProgress size={20} color="inherit" /> : <SendIcon />}
                    onClick={handleSubmitBatch}
                    disabled={isCreatingBatch}
                  >
                    {isCreatingBatch ? "Creating..." : "Create Batch"}
                  </Button>
                </Stack>
              </Stack>
            </Paper>
          )}
        </Box>
      </Paper>

      {/* PREVIEW GRID */}
      {previewRows.length > 0 && !uiError && (
        <Paper elevation={1} sx={{ p: 0, mt: 3, height: 600, width: "100%", borderRadius: 2, overflow: "hidden" }}>
          <Box sx={{ p: 2, borderBottom: 1, borderColor: "divider" }}>
            <Typography variant="h6" sx={{ fontWeight: 600 }}>
                Data Preview {totalRows > previewRows.length ? `(First ${previewRows.length} rows)` : ""}
            </Typography>
          </Box>
          <DataGrid
            rows={previewRows}
            columns={columns}
            pageSize={10}
            rowsPerPageOptions={[10, 25, 50, 100]}
            disableSelectionOnClick
            density="comfortable"
            sx={{ border: "none" }}
          />
        </Paper>
      )}
    </Box>
  );
};

export default JournalBulkUpload;

