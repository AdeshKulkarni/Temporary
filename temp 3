1. HmacJwtUtil.java (Replaces signWith with encryptWith)
The cryptographic algorithm is changed to AES because A256GCM (the encryption method) requires a 256-bit AES key rather than an HMAC hashing key.
package com.fincore.gateway.JwtUtil;

import io.jsonwebtoken.Jwts;
import lombok.extern.slf4j.Slf4j;

import javax.crypto.SecretKey;
import javax.crypto.spec.SecretKeySpec;
import java.time.Instant;
import java.util.Base64;
import java.util.Date;
import java.util.Map;
import java.util.UUID;

/**
 * Utility class for generating Encrypted JSON Web Tokens (JWEs).
 */
@Slf4j
public final class HmacJwtUtil {

    private HmacJwtUtil() {
    }

    public static String generate(String base64Secret, String subject, long ttlSeconds, Map<String,Object> UserData) {
        byte[] secret = Base64.getDecoder().decode(base64Secret);
        
        // JWE with A256GCM requires an AES symmetric key, not an HMAC hashing key.
        SecretKey key = new SecretKeySpec(secret, "AES");

        Instant now = Instant.now();
        Instant exp = now.plusSeconds(ttlSeconds);
        log.info("Generated exp in Seconds={}", exp);
        String jti = UUID.randomUUID().toString();
        log.info("Jti generated={}", jti);

        return Jwts.builder()
                .claims(UserData)
                .subject(String.valueOf(subject))
                .id(jti)
                .issuedAt(Date.from(now))
                .expiration(Date.from(exp))
                // Encrypts the payload using Direct Encryption and A256GCM
                .encryptWith(key, Jwts.KEY.DIR, Jwts.ENC.A256GCM) 
                .compact();
    }
}

2. JwtDecoderConfig.java (Replaces Nimbus with JJWT's Decoder)
Because you are dropping Nimbus, this file creates a custom Spring Security ReactiveJwtDecoder bean that delegates the decryption and parsing strictly to JJWT.
package com.fincore.gateway.Config;

import io.jsonwebtoken.Claims;
import io.jsonwebtoken.Jwe;
import io.jsonwebtoken.JwtException;
import io.jsonwebtoken.Jwts;
import jakarta.annotation.PostConstruct;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.security.oauth2.jwt.BadJwtException;
import org.springframework.security.oauth2.jwt.Jwt;
import org.springframework.security.oauth2.jwt.ReactiveJwtDecoder;
import reactor.core.publisher.Mono;

import javax.crypto.SecretKey;
import javax.crypto.spec.SecretKeySpec;
import java.time.Instant;
import java.util.Base64;
import java.util.Map;

@Slf4j
@Configuration
public class JwtDecoderConfig {

    @Value("${security.jwt.mode:hmac}")
    private String mode;

    @Value("${security.jwt.hmac-base64-secret:}")
    private String hmacBase64Secret;

    @PostConstruct
    void sanity() {
        if ("hmac".equalsIgnoreCase(mode)) {
            if (hmacBase64Secret == null || hmacBase64Secret.isBlank()) {
                throw new IllegalStateException("HMAC mode selected but security.jwt.hmac-base64-secret is empty");
            }
        } else {
            throw new IllegalStateException("Unsupported security.jwt.mode for JWE: " + mode + " (Only HMAC/AES supported)");
        }
    }

    @Bean
    public ReactiveJwtDecoder jwtDecoder() {
        // Decode base64 secret to raw bytes and create a SecretKey for AES Decryption
        byte[] secretBytes = Base64.getDecoder().decode(hmacBase64Secret);
        SecretKey key = new SecretKeySpec(secretBytes, "AES");

        return token -> Mono.fromCallable(() -> {
            try {
                // Use JJWT to decrypt the token
                Jwe<Claims> jwe = Jwts.parser()
                        .decryptWith(key)
                        .build()
                        .parseEncryptedClaims(token);

                Claims claims = jwe.getPayload();
                Map<String, Object> headers = jwe.getHeader();

                Instant issuedAt = claims.getIssuedAt() != null ? claims.getIssuedAt().toInstant() : null;
                Instant expiresAt = claims.getExpiration() != null ? claims.getExpiration().toInstant() : null;

                // Map JJWT claims to Spring Security's native Jwt object
                return new Jwt(
                        token,
                        issuedAt,
                        expiresAt,
                        headers,
                        claims
                );
            } catch (JwtException | IllegalArgumentException e) {
                log.error("Failed to decrypt or parse JWE token: {}", e.getMessage());
                throw new BadJwtException("Invalid Encrypted Token", e);
            }
        });
    }
}

