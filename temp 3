import React, { useState, useRef, useEffect } from "react";
import {
  Box,
  Typography,
  Paper,
  TextField,
  Button,
  CircularProgress,
  Chip,
  Alert,
  Stack,
  Stepper,
  Step,
  StepLabel,
  LinearProgress,
} from "@mui/material";
import {
  CloudUpload as CloudUploadIcon,
  RestartAlt as RestartAltIcon,
  Description as DescriptionIcon,
  CheckCircle as CheckCircleIcon,
  Error as ErrorIcon,
  Download as DownloadIcon,
  Send as SendIcon,
  FormatListBulleted as FormatIcon,
  Storage as DbIcon,
  Balance as BalanceIcon,
  DoneAll as DoneIcon,
} from "@mui/icons-material";

import { DataGrid } from "@mui/x-data-grid";

import {
  mainContainerStyle,
  uploadBoxStyle,
  controlPanelStyle,
  iconStyle,
  headerTextStyle,
  subTextStyle,
  dateinputfield,
  stepperContainerStyle,
  stepLabelStyle,
  progressContainerStyle,
} from "./JournalBulkStyle";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

const steps = [
  "Format Validation",
  "Database Check",
  "Balance Check",
  "Finalizing",
];

const JournalBulkUpload = () => {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  const [selectedDate, setSelectedDate] = useState("");
  const [file, setFile] = useState(null);
  const [isCsvInput, setIsCsvInput] = useState(false);

  // Status State
  const [requestId, setRequestId] = useState(null);
  const [isProcessing, setIsProcessing] = useState(false);
  const [activeStep, setActiveStep] = useState(0);
  const [failedStep, setFailedStep] = useState(-1);

  // Result State
  const [resultStatus, setResultStatus] = useState(null); // SUCCESS or ERROR
  const [resultMsg, setResultMsg] = useState("");
  const [previewRows, setPreviewRows] = useState([]);
  const [totalRows, setTotalRows] = useState(0);
  const [processedRows, setProcessedRows] = useState(0);
  const [hasSuccessFile, setHasSuccessFile] = useState(false);
  const [errorCount, setErrorCount] = useState(0);

  // Download State
  const [isDownloading, setIsDownloading] = useState(false);
  const [downloadText, setDownloadText] = useState("");

  const [isCreatingBatch, setIsCreatingBatch] = useState(false);
  const fileInputRef = useRef(null);

  // --- 1. SECURE DOWNLOAD FUNCTION ---
  const handleDownloadFile = async (type) => {
    if (!requestId) return;
    setIsDownloading(true);

    try {
      // Get Token from Storage (Redux Persist pattern)
      let token = "";
      const storage =
        sessionStorage.getItem("persist:auth") ||
        localStorage.getItem("persist:auth");

      if (storage) {
        const parsed = JSON.parse(storage);
        if (parsed && parsed.token) {
          // Remove quotes if present
          token = parsed.token.replace(/^"|"$/g, "");
        }
      }

      // If useApi handles token automatically, you might need to extract that logic.
      // Assuming standard Bearer token here:
      const response = await fetch(
        `/JS/journals/download-bulk-file/${requestId}?type=${type}`,
        {
          method: "GET",
          headers: {
            Authorization: `Bearer ${token}`,
          },
        }
      );

      if (!response.ok) {
        throw new Error("Download failed");
      }

      const blob = await response.blob();
      const url = window.URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.setAttribute(
        "download",
        type === "ERROR"
          ? `Error_Report_${requestId}.xlsx`
          : `Success_Journal_${requestId}.csv`
      );
      document.body.appendChild(link);
      link.click();
      link.parentNode.removeChild(link);
      window.URL.revokeObjectURL(url);

      if (type === "ERROR") setDownloadText("Report Downloaded");
      showSnackBar("File downloaded successfully.", "success");
    } catch (error) {
      console.error("Download Error", error);
      showSnackBar("Failed to download file.", "error");
    } finally {
      setIsDownloading(false);
    }
  };

  // --- 2. POLLING LOGIC ---
  useEffect(() => {
    let interval;
    if (isProcessing && requestId) {
      interval = setInterval(async () => {
        try {
          const res = await callApi(
            `/JS/journals/bulk-status/${requestId}`,
            null,
            "GET"
          );
          if (!res) return;

          // Update Progress
          if (res.totalRows) setTotalRows(res.totalRows);
          if (res.processedCount) setProcessedRows(res.processedCount);
          if (res.currentStage > 0) setActiveStep(res.currentStage - 1);

          // Handle ERROR
          if (res.status === "ERROR") {
            setIsProcessing(false);
            setResultStatus("ERROR");
            setResultMsg(res.message);
            setErrorCount(res.errorCount);
            setFailedStep(res.currentStage ? res.currentStage - 1 : 0);
            setActiveStep(res.currentStage ? res.currentStage - 1 : 0);
            clearInterval(interval);

            showSnackBar(res.message, "error");

            // AUTO DOWNLOAD TRIGGER
            if (res.hasErrorFile) {
              setTimeout(() => {
                handleDownloadFile("ERROR");
              }, 1000);
            }
          }
          // Handle SUCCESS
          else if (res.status === "SUCCESS") {
            setIsProcessing(false);
            setResultStatus("SUCCESS");
            setActiveStep(4);
            setHasSuccessFile(res.hasSuccessFile);
            setTotalRows(res.totalRows);
            // Parse Preview JSON
            if (res.previewDataJson) {
              try {
                setPreviewRows(JSON.parse(res.previewDataJson));
              } catch (e) {
                console.error("JSON Parse Error", e);
              }
            } else if (res.previewData) {
              // Backward compatibility if backend sends object
              setPreviewRows(res.previewData);
            }

            clearInterval(interval);
            showSnackBar("Validation Successful!", "success");
          }
        } catch (e) {
          console.error("Poll Error", e);
        }
      }, 1000);
    }
    return () => clearInterval(interval);
  }, [isProcessing, requestId]); // Removed unnecessary deps to prevent loops

  // --- 3. STANDARD HANDLERS ---

  const handleDateChange = (e) => {
    setSelectedDate(e.target.value);
    resetState();
  };

  const handleFileChange = (e) => {
    const selectedFile = e.target.files[0];
    if (selectedFile) {
      const name = selectedFile.name.toLowerCase();
      if (
        !name.endsWith(".xlsx") &&
        !name.endsWith(".xls") &&
        !name.endsWith(".csv")
      ) {
        showSnackBar("Invalid file type.", "error");
        setFile(null);
        return;
      }
      setFile(selectedFile);
      setIsCsvInput(name.endsWith(".csv"));
      resetState();
    }
  };

  const resetState = () => {
    setUiError("");
    setErrorCount(0);
    setHasSuccessFile(false);
    setPreviewRows([]);
    setTotalRows(0);
    setProcessedRows(0);
    setRequestId(null);
    setActiveStep(0);
    setFailedStep(-1);
    setResultStatus(null);
    setDownloadText("");
  };

  const resetForm = () => {
    setFile(null);
    setSelectedDate("");
    resetState();
    setIsProcessing(false);
    setIsCreatingBatch(false);
    if (fileInputRef.current) fileInputRef.current.value = "";
  };

  const startValidation = async () => {
    if (!file || !selectedDate) {
      showSnackBar("Please select Date and File.", "warning");
      return;
    }
    resetState();
    setIsProcessing(true);

    const formData = new FormData();
    formData.append("file", file);
    formData.append("postingDate", selectedDate);

    try {
      const res = await callApi(
        "/JS/journals/bulk-validate-init",
        formData,
        "POST",
        "json",
        "multipart/form-data"
      );
      if (res && res.requestId) {
        setRequestId(res.requestId);
      } else {
        setIsProcessing(false);
        showSnackBar("Failed to start validation.", "error");
      }
    } catch (err) {
      setIsProcessing(false);
      showSnackBar("System Error", "error");
    }
  };

  const handleSubmitBatch = async () => {
    if (previewRows.length === 0) return;
    setIsCreatingBatch(true);
    try {
      const payloadRows = previewRows.map((row) => ({
        changeType: "ADD",
        branch: row.branch,
        currency: row.currency,
        cgl: row.cgl,
        amount: row.txnType === "Credit" ? "-" + row.amount : row.amount,
        productType: row.productCode,
        remarks: row.remarks,
        arFlag: "A",
        acClassification: "A",
      }));

      const finalPayload = {
        commonBatchRemarks: `Bulk Upload - ${selectedDate}`,
        rows: payloadRows,
      };
      const response = await callApi(
        "/JS/journals/create-bulk-batch",
        finalPayload,
        "POST"
      );

      if (response && response.status === "SUCCESS") {
        showSnackBar(`Batch Created! ID: ${response.batchId}`, "success");
        resetForm();
      }
    } catch (e) {
      showSnackBar("Failed to create batch", "error");
    } finally {
      setIsCreatingBatch(false);
    }
  };

  const columns = [
    {
      field: "branch",
      headerName: "Branch",
      flex: 1,
      align: "center",
      headerAlign: "center",
    },
    {
      field: "currency",
      headerName: "Currency",
      width: 100,
      align: "center",
      headerAlign: "center",
    },
    {
      field: "cgl",
      headerName: "CGL",
      flex: 1.5,
      align: "center",
      headerAlign: "center",
    },
    {
      field: "productCode",
      headerName: "Product",
      width: 120,
      align: "center",
      headerAlign: "center",
      renderCell: (p) => p.value || "-",
    },
    {
      field: "amount",
      headerName: "Amount",
      flex: 1.5,
      minWidth: 150,
      align: "right",
      headerAlign: "center",
    },
    {
      field: "txnType",
      headerName: "Type",
      width: 100,
      align: "center",
      headerAlign: "center",
      renderCell: (params) => (
        <Chip
          label={params.value}
          color={params.value === "Credit" ? "error" : "success"}
          size="small"
          variant="filled"
          sx={{ fontWeight: "bold", width: "80px" }}
        />
      ),
    },
    {
      field: "remarks",
      headerName: "Remarks",
      flex: 2,
      align: "center",
      headerAlign: "center",
    },
  ];

  // Percentage Calc
  const progressPercent =
    totalRows > 0
      ? Math.min(100, Math.round((processedRows / totalRows) * 100))
      : 0;

  return (
    <Box sx={mainContainerStyle}>
      <Paper elevation={1} sx={controlPanelStyle}>
        {/* Date Input */}
        <Box sx={dateinputfield}>
          <TextField
            type="date"
            label="Posting Date"
            size="small"
            value={selectedDate}
            onChange={handleDateChange}
            InputLabelProps={{ shrink: true }}
            inputProps={{ max: new Date().toISOString().split("T")[0] }}
          />
        </Box>

        {/* Upload Box */}
        <Box sx={uploadBoxStyle} onClick={() => fileInputRef.current.click()}>
          <input
            type="file"
            hidden
            accept=".xlsx,.xls,.csv"
            onChange={handleFileChange}
            ref={fileInputRef}
          />
          {file ? (
            <>
              <DescriptionIcon color="success" sx={{ fontSize: 60, mb: 1 }} />
              <Typography variant="h6" sx={headerTextStyle}>
                {file.name}
              </Typography>
              <Chip
                label="Ready"
                color="success"
                size="small"
                variant="outlined"
              />
            </>
          ) : (
            <>
              <CloudUploadIcon sx={iconStyle} />
              <Typography variant="h6" sx={headerTextStyle}>
                Click to Upload
              </Typography>
              <Typography sx={subTextStyle}>
                Supported: .xlsx, .xls, .csv
              </Typography>
            </>
          )}
        </Box>

        {/* STEPPER */}
        {(isProcessing || resultStatus === "SUCCESS" || resultStatus === "ERROR") && (
          <Box sx={stepperContainerStyle}>
            <Stepper activeStep={activeStep} alternativeLabel>
              {steps.map((label, index) => {
                const isFailed = index === failedStep;
                const isCompleted = index < activeStep || resultStatus === "SUCCESS";

                return (
                  <Step key={label}>
                    <StepLabel
                      error={isFailed}
                      sx={stepLabelStyle}
                      StepIconComponent={() => {
                        if (isFailed) return <ErrorIcon color="error" />;
                        if (isCompleted) return <CheckCircleIcon color="success" />;
                        if (index === activeStep && isProcessing)
                          return <CircularProgress size={20} />;
                        return (
                          <Typography
                            color="text.disabled"
                            fontWeight="bold"
                          >
                            {index + 1}
                          </Typography>
                        );
                      }}
                    >
                      {label}
                    </StepLabel>
                  </Step>
                );
              })}
            </Stepper>

            {/* LIVE PROGRESS */}
            {isProcessing && totalRows > 0 && (
              <Box sx={progressContainerStyle}>
                <LinearProgress
                  variant="determinate"
                  value={progressPercent}
                  sx={{ height: 8, borderRadius: 4 }}
                />
                <Typography
                  variant="caption"
                  color="text.secondary"
                  sx={{ display: "block", mt: 1 }}
                >
                  Processed: {processedRows.toLocaleString()} /{" "}
                  {totalRows.toLocaleString()} ({progressPercent}%)
                </Typography>
              </Box>
            )}
          </Box>
        )}

        <Stack
          direction="row"
          justifyContent="center"
          spacing={2}
          sx={{ mt: 2 }}
        >
          <Button
            variant="contained"
            onClick={startValidation}
            disabled={isProcessing || !file || !selectedDate}
            size="large"
          >
            {isProcessing ? "Validating..." : "Validate"}
          </Button>
          <Button
            variant="outlined"
            color="error"
            onClick={resetForm}
            disabled={isProcessing}
            size="large"
          >
            Reset
          </Button>
        </Stack>

        {/* RESULTS AREA */}
        <Box sx={{ mt: 3 }}>
          {/* ERROR PANEL */}
          {resultStatus === "ERROR" && (
            <Alert
              severity="error"
              sx={{ mb: 2, border: "1px solid #ee0404ff" }}
            >
              <Typography variant="subtitle2" fontWeight="bold">
                Validation Failed
              </Typography>
              <Typography variant="body2">{resultMsg}</Typography>

              <Button
                variant="outlined"
                color="error"
                size="small"
                startIcon={
                  isDownloading ? (
                    <CircularProgress size={16} />
                  ) : (
                    <DownloadIcon />
                  )
                }
                sx={{ mt: 1, bgcolor: "background.paper" }}
                onClick={() => handleDownloadFile("ERROR")}
                disabled={isDownloading}
              >
                {downloadText || "Download Error Report"}
              </Button>
            </Alert>
          )}

          {/* SUCCESS PANEL */}
          {resultStatus === "SUCCESS" && (
            <Paper
              variant="outlined"
              sx={{ p: 2, borderColor: "success.main" }}
            >
              <Stack
                direction={{ xs: "column", sm: "row" }}
                justifyContent="space-between"
                alignItems="center"
                spacing={2}
              >
                <Box>
                  <Stack direction="row" alignItems="center" spacing={1}>
                    <CheckCircleIcon color="success" />
                    <Typography variant="subtitle1" fontWeight="bold">
                      Validation Successful!
                    </Typography>
                  </Stack>
                  <Typography variant="body2">
                    {totalRows.toLocaleString()} rows verified.
                  </Typography>
                </Box>
                <Stack direction="row" spacing={2}>
                  {!isCsvInput && hasSuccessFile && (
                    <Button
                      variant="outlined"
                      color="success"
                      startIcon={<DownloadIcon />}
                      onClick={() => handleDownloadFile("SUCCESS")}
                      sx={{ bgcolor: "background.paper" }}
                      disabled={isDownloading}
                    >
                      Download CSV
                    </Button>
                  )}
                  <Button
                    variant="contained"
                    color="success"
                    startIcon={
                      isCreatingBatch ? (
                        <CircularProgress size={20} color="inherit" />
                      ) : (
                        <SendIcon />
                      )
                    }
                    onClick={handleSubmitBatch}
                    disabled={isCreatingBatch}
                  >
                    {isCreatingBatch ? "Creating..." : "Create Batch"}
                  </Button>
                </Stack>
              </Stack>
            </Paper>
          )}
        </Box>
      </Paper>

      {/* DATA GRID */}
      {resultStatus === "SUCCESS" && previewRows.length > 0 && (
        <Paper
          elevation={1}
          sx={{
            p: 0,
            mt: 3,
            height: 600,
            width: "100%",
            borderRadius: 2,
            overflow: "hidden",
          }}
        >
          <Box sx={{ p: 2, borderBottom: 1, borderColor: "divider" }}>
            <Typography variant="h6" sx={{ fontWeight: 600 }}>
              Data Preview (Top 100)
            </Typography>
          </Box>
          <DataGrid
            rows={previewRows}
            columns={columns}
            pageSize={10}
            rowsPerPageOptions={[10, 25, 50, 100]}
            disableSelectionOnClick
            density="comfortable"
            sx={{ border: "none" }}
          />
        </Paper>
      )}
    </Box>
  );
};

export default JournalBulkUpload;
