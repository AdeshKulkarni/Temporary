import React, { useState, useRef, useEffect } from "react";
import {
  Box,
  Typography,
  Paper,
  TextField,
  Button,
  CircularProgress,
  Chip,
  Alert,
  Stack,
  Stepper,
  Step,
  StepLabel,
  Grid,
  Fade,
  TablePagination,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow
} from "@mui/material";
import {
  CloudUpload,
  RestartAlt,
  Description,
  CheckCircle,
  Error as ErrorIcon, // Kept alias to avoid conflict with JS Error object
  Download,
  Send,
  FileDownload,
  RadioButtonUnchecked
} from "@mui/icons-material";
import { alpha } from "@mui/material/styles";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";

// ==========================================
//  INTERNAL STYLES
// ==========================================

const mainContainerStyle = {
  padding: 3,
  height: "100%",
  width: "100%",
};

const controlPanelStyle = {
  padding: "30px",
  marginBottom: "20px",
  borderRadius: "12px",
  backgroundColor: "background.paper",
  boxShadow: (theme) => theme.shadows[1],
};

const uploadBoxStyle = {
  display: "flex",
  flexDirection: "column",
  justifyContent: "center",
  alignItems: "center",
  border: 2,
  borderStyle: "dashed",
  borderColor: "primary.main",
  borderRadius: "12px",
  padding: "40px",
  cursor: "pointer",
  backgroundColor: (theme) => alpha(theme.palette.primary.main, 0.02),
  transition: "all 0.3s ease",
  minHeight: "200px",
  "&:hover": {
    backgroundColor: (theme) => alpha(theme.palette.primary.main, 0.08),
    borderColor: "primary.dark",
  },
};

const iconStyle = {
  fontSize: "5rem",
  color: "primary.main",
  marginBottom: "16px",
};

const headerTextStyle = {
  fontWeight: 600,
  fontSize: "1.1rem",
  textAlign: "center",
  color: "text.primary",
};

const subTextStyle = {
  color: "text.secondary",
  fontSize: "0.85rem",
  textAlign: "center",
  marginTop: "4px",
};

const dateinputfield = {
  display: "flex",
  justifyContent: "center",
  marginBottom: "30px",
  "& .MuiTextField-root": {
    minWidth: "250px",
  }
};

const stepperContainerStyle = {
  width: '100%',
  marginBottom: '40px',
  marginTop: '30px'
};

const stepLabelStyle = {
  "& .MuiStepLabel-label": {
    fontWeight: 600,
    fontSize: "0.9rem"
  },
  "& .MuiStepLabel-label.Mui-completed": {
    color: "success.main",
  },
  "& .MuiStepLabel-label.Mui-error": {
    color: "error.main",
  }
};

const progressContainerStyle = {
  width: '60%',
  margin: '20px auto',
  textAlign: 'center'
};

const tableContainerStyle = {
  borderRadius: "12px",
  border: "1px solid",
  borderColor: "divider",
  overflow: "hidden",
  marginTop: "20px",
  boxShadow: (theme) => theme.shadows[1],
  maxHeight: 600,
};

const tableHeaderStyle = {
  backgroundColor: (theme) => alpha(theme.palette.primary.main, 0.08),
  color: "text.primary",
  fontWeight: "bold",
  fontSize: "0.95rem",
};

const actionButtonsContainer = {
  display: "flex",
  justifyContent: "center",
  marginTop: 2,
  gap: 2
};

const alertStyle = {
  marginBottom: 2,
  borderColor: 'error.main',
  borderWidth: 1,
  borderStyle: 'solid'
};

const successPaperStyle = {
  padding: 2,
  borderColor: "success.main",
  backgroundColor: (theme) => alpha(theme.palette.success.main, 0.05)
};

const chipStyle = {
  fontWeight: "bold",
  width: "80px"
};

// ==========================================
//  COMPONENT LOGIC
// ==========================================

const steps = ["Upload & Validate", "Preview & Submit"];

const JournalBulkUpload = () => {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  // --- State ---
  const [selectedDate, setSelectedDate] = useState("");
  const [file, setFile] = useState(null);
  const fileInputRef = useRef(null);
  
  const [activeStep, setActiveStep] = useState(0); 
  
  // Processing
  const [requestId, setRequestId] = useState(null);
  const [isProcessing, setIsProcessing] = useState(false);
  const [validationStage, setValidationStage] = useState(0); 
  const [resultStatus, setResultStatus] = useState(null); 
  const [resultMsg, setResultMsg] = useState("");
  const [autoDlTriggered, setAutoDlTriggered] = useState(false);

  // Data
  const [previewRows, setPreviewRows] = useState([]);
  const [totalRows, setTotalRows] = useState(0);
  const [hasSuccessFile, setHasSuccessFile] = useState(false);
  const [hasErrorFile, setHasErrorFile] = useState(false);
  
  // Pagination State (for Table)
  const [page, setPage] = useState(0);
  const [rowsPerPage, setRowsPerPage] = useState(50);

  // Actions
  const [isCreatingBatch, setIsCreatingBatch] = useState(false);

  // --- Handlers ---
  const handleDateChange = (e) => setSelectedDate(e.target.value);

  const handleFileSelect = (e) => {
    if (e.target.files[0]) {
      setFile(e.target.files[0]);
      setResultStatus(null);
      setResultMsg("");
      setValidationStage(0);
    }
  };

  const resetAll = () => {
    setActiveStep(0);
    setRequestId(null);
    setResultStatus(null);
    setValidationStage(0);
    setResultMsg("");
    setPreviewRows([]);
    setTotalRows(0);
    setIsProcessing(false);
    setAutoDlTriggered(false);
    setHasSuccessFile(false);
    setHasErrorFile(false);
    if (fileInputRef.current) fileInputRef.current.value = "";
  };

  const handleDownloadTemplate = async () => {
    try {
      let token = "";
      const sAuth = sessionStorage.getItem("persist:auth") || localStorage.getItem("persist:auth");
      if (sAuth) { try { token = JSON.parse(sAuth).token.replace(/"/g, ""); } catch (e) { } }
      const res = await fetch("/JS/journals/download-template", { headers: { Authorization: `Bearer ${token}` } });
      if (!res.ok) throw new Error("Template download failed");
      const blob = await res.blob();
      const url = window.URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url; link.setAttribute("download", "Journal_Upload_Template.xlsx");
      document.body.appendChild(link); link.click(); link.remove();
    } catch (e) { showSnackBar("Failed to download template", "error"); }
  };

  const handleStartValidation = async () => {
    if (!selectedDate || !file) { showSnackBar("Please select Date and File.", "warning"); return; }
    
    setResultStatus(null); setResultMsg(""); setValidationStage(1); 
    setIsProcessing(true); setAutoDlTriggered(false);

    const formData = new FormData();
    formData.append("file", file);
    formData.append("postingDate", selectedDate);

    try {
      let token = "";
      const sAuth = sessionStorage.getItem("persist:auth") || localStorage.getItem("persist:auth");
      if (sAuth) { try { token = JSON.parse(sAuth).token.replace(/"/g, ""); } catch (e) { } }

      const res = await fetch("/JS/journals/bulk-validate-init", {
        method: "POST", headers: { "Authorization": `Bearer ${token}` }, body: formData
      });
      if (!res.ok) throw new Error(await res.text());
      const data = await res.json();
      setRequestId(data.requestId);
    } catch (err) {
      setIsProcessing(false); setResultStatus("ERROR"); setResultMsg("Init Failed: " + err.message);
    }
  };

  // Polling
  useEffect(() => {
    let interval;
    if (isProcessing && requestId) {
      interval = setInterval(async () => {
        try {
          const res = await callApi(`/JS/journals/bulk-status/${requestId}`, null, "GET");
          if (!res) return;
          if (res.totalRows) setTotalRows(res.totalRows);
          if (res.currentStage) setValidationStage(res.currentStage);

          if (res.status === "ERROR") {
            setIsProcessing(false); setResultStatus("ERROR"); setResultMsg(res.message);
            setHasErrorFile(res.hasErrorFile);
            clearInterval(interval);
            showSnackBar(res.message, "error", 5000);
            if (res.hasErrorFile && !autoDlTriggered) {
              setAutoDlTriggered(true);
              handleDownloadFile("ERROR", res.requestId);
            }
          }
          else if (res.status === "SUCCESS") {
            setIsProcessing(false); setResultStatus("SUCCESS"); setValidationStage(4);
            setTotalRows(res.totalRows);
            setHasSuccessFile(res.hasSuccessFile);
            if (res.previewDataJson) {
              const rows = JSON.parse(res.previewDataJson);
              setPreviewRows(rows);
            }
            // Auto-Forward
            setTimeout(() => { setActiveStep(1); }, 800);
            clearInterval(interval);
            showSnackBar("Validation Complete. Moving to Preview.", "success");
          }
        } catch (e) { console.error(e); }
      }, 800);
    }
    return () => clearInterval(interval);
  }, [isProcessing, requestId, callApi, showSnackBar, autoDlTriggered]);

  const handleDownloadFile = async (type, reqId = requestId) => {
    try {
      if(type === "ERROR") showSnackBar("Downloading Error Report...", "info");
      
      let token = "";
      const sAuth = sessionStorage.getItem("persist:auth") || localStorage.getItem("persist:auth");
      if (sAuth) { try { token = JSON.parse(sAuth).token.replace(/"/g, ""); } catch (e) { } }
      const response = await fetch(`/JS/journals/download-bulk-file/${reqId}?type=${type}`, {
        headers: { Authorization: `Bearer ${token}` }
      });
      if (!response.ok) throw new Error("Download failed");
      const blob = await response.blob();
      const url = window.URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.setAttribute("download", type === "ERROR" ? "Error_Report.xlsx" : "Success_Batch.csv");
      document.body.appendChild(link);
      link.click();
      link.remove();
      
      if(type === "SUCCESS") showSnackBar("Downloaded successfully.", "success");
    } catch (e) { showSnackBar("Download failed", "error"); }
  };

  const handleCreateBatch = async () => {
    setIsCreatingBatch(true);
    try {
      const payload = { requestId: requestId, commonBatchRemarks: `Bulk Upload - ${selectedDate}` };
      const res = await callApi("/JS/journals/create-bulk-batch-optimized", payload, "POST");
      if (res.status === "SUCCESS") {
        showSnackBar(`Batch ${res.batchId} Created Successfully!`, "success", 5000);
        resetAll();
      } else { throw new Error(res.message); }
    } catch (e) { showSnackBar("Failed to create batch: " + e.message, "error"); } 
    finally { setIsCreatingBatch(false); }
  };

  // UI Helper: Horizontal Validation Items
  const renderValidationItem = (stageNum, label) => {
    let icon = <RadioButtonUnchecked color="disabled" />;
    let textSx = { color: 'text.secondary' };

    if (validationStage > stageNum || (validationStage === stageNum && resultStatus === 'SUCCESS')) {
        icon = <CheckCircle color="success" />;
        textSx = { color: 'text.primary', fontWeight: 'bold' };
    } else if (validationStage === stageNum && resultStatus === 'ERROR') {
        icon = <ErrorIcon color="error" />;
        textSx = { color: 'error.main', fontWeight: 'bold' };
    } else if (validationStage === stageNum && isProcessing) {
        icon = <CircularProgress size={20} color="primary" />;
        textSx = { color: 'primary.main', fontWeight: 'bold' };
    }

    return (
        <Stack direction="row" spacing={1} alignItems="center">
            {icon}
            <Typography variant="body2" sx={textSx}>{label}</Typography>
        </Stack>
    );
  };

  // Pagination Change Handlers
  const handleChangePage = (event, newPage) => {
    setPage(newPage);
  };

  const handleChangeRowsPerPage = (event) => {
    setRowsPerPage(parseInt(event.target.value, 10));
    setPage(0);
  };

  return (
    <Box sx={mainContainerStyle}>
      <Paper elevation={1} sx={controlPanelStyle}>
        
        <Box sx={{ display: 'flex', justifyContent: 'flex-end', mb: 2 }}>
          <Button variant="text" startIcon={<FileDownload />} onClick={handleDownloadTemplate}>Download Template</Button>
        </Box>

        <Stepper activeStep={activeStep} sx={{ mb: 4 }} alternativeLabel>
          {steps.map((label) => (
            <Step key={label}><StepLabel>{label}</StepLabel></Step>
          ))}
        </Stepper>

        {/* --- STEP 1: UPLOAD & VALIDATE --- */}
        {activeStep === 0 && (
          <Fade in={true}>
            <Box>
              <Box sx={dateinputfield}>
                 <TextField
                    type="date" label="Posting Date" value={selectedDate} onChange={handleDateChange}
                    InputLabelProps={{ shrink: true }} size="small" disabled={isProcessing} sx={{ width: 200 }}
                 />
              </Box>

              <Box
                sx={{
                    ...uploadBoxStyle, 
                    borderColor: resultStatus === 'ERROR' ? 'error.main' : 'primary.main',
                    opacity: isProcessing ? 0.6 : 1
                }}
                onClick={() => { if (!isProcessing) fileInputRef.current.click(); }}
              >
                <input type="file" hidden ref={fileInputRef} onChange={handleFileSelect} accept=".xlsx,.csv" />
                {file ? (
                  <>
                    <Description sx={{ fontSize: 60, color: "success.main", mb: 1 }} />
                    <Typography sx={headerTextStyle}>{file.name}</Typography>
                    <Typography sx={subTextStyle}>Click to change</Typography>
                  </>
                ) : (
                  <>
                    <CloudUpload sx={iconStyle} />
                    <Typography sx={headerTextStyle}>Click to Upload File</Typography>
                    <Typography sx={subTextStyle}>.xlsx, .csv (Max 50MB)</Typography>
                  </>
                )}
              </Box>

              {(isProcessing || resultStatus) && (
                  <Box sx={{ mt: 3, p: 2, border: '1px solid', borderColor: 'divider', borderRadius: 2 }}>
                      <Typography variant="subtitle2" sx={{ mb: 2, color: 'text.secondary' }}>Validation Status:</Typography>
                      <Grid container spacing={2}>
                          <Grid item xs={12} md={4}>{renderValidationItem(1, "Format Checks (Date, Headers)")}</Grid>
                          <Grid item xs={12} md={4}>{renderValidationItem(2, "Database Checks (Branch, CGL)")}</Grid>
                          <Grid item xs={12} md={4}>{renderValidationItem(3, "Balance Checks (Dr/Cr)")}</Grid>
                      </Grid>
                      
                      {resultStatus === 'ERROR' && (
                          <Alert severity="error" sx={alertStyle}>
                              Validation Failed. Please correct the errors in the downloaded report and re-upload.
                          </Alert>
                      )}
                  </Box>
              )}

              <Stack direction="row" sx={actionButtonsContainer}>
                <Button
                  variant="contained" size="large" onClick={handleStartValidation}
                  disabled={!file || !selectedDate || isProcessing}
                  startIcon={isProcessing ? <CircularProgress size={20} color="inherit"/> : <Send/>}
                >
                  {isProcessing ? "Validating..." : "Start Validation"}
                </Button>
              </Stack>
            </Box>
          </Fade>
        )}

        {/* --- STEP 2: PREVIEW & SUBMIT --- */}
        {activeStep === 1 && (
          <Fade in={true}>
            <Box>
              <Stack direction="row" justifyContent="space-between" alignItems="center" sx={{mb: 2}}>
                  <Alert severity="success" sx={{ flexGrow: 1, mr: 2 }}>
                     Validation Successful! Total Rows: {totalRows.toLocaleString()}
                  </Alert>
                  <Button variant="outlined" startIcon={<FileDownload />} onClick={() => handleDownloadFile("SUCCESS")}>
                      Download CSV
                  </Button>
              </Stack>

              <TableContainer component={Paper} sx={tableContainerStyle}>
                <Table stickyHeader size="small">
                  <TableHead>
                    <TableRow>
                      <TableCell sx={tableHeaderStyle}>Row #</TableCell>
                      <TableCell sx={tableHeaderStyle}>Branch</TableCell>
                      <TableCell sx={tableHeaderStyle}>Currency</TableCell>
                      <TableCell sx={tableHeaderStyle}>CGL</TableCell>
                      <TableCell align="right" sx={tableHeaderStyle}>Amount</TableCell>
                      <TableCell align="center" sx={tableHeaderStyle}>Type</TableCell>
                      <TableCell sx={tableHeaderStyle}>Remarks</TableCell>
                      <TableCell sx={tableHeaderStyle}>Product</TableCell>
                    </TableRow>
                  </TableHead>
                  <TableBody>
                    {previewRows
                      .slice(page * rowsPerPage, page * rowsPerPage + rowsPerPage)
                      .map((row, idx) => (
                      <TableRow key={idx} hover>
                        <TableCell>{row.id}</TableCell>
                        <TableCell>{row.branch}</TableCell>
                        <TableCell>{row.currency}</TableCell>
                        <TableCell>{row.cgl}</TableCell>
                        <TableCell align="right">{row.amount}</TableCell>
                        <TableCell align="center">
                          <Chip
                            label={row.txnType} size="small"
                            color={row.txnType.includes("Credit") ? "error" : "success"}
                            sx={chipStyle}
                          />
                        </TableCell>
                        <TableCell>{row.remarks}</TableCell>
                        <TableCell>{row.productCode}</TableCell>
                      </TableRow>
                    ))}
                  </TableBody>
                </Table>
              </TableContainer>
              
              <TablePagination
                rowsPerPageOptions={[50, 100, 150]}
                component="div"
                count={previewRows.length}
                rowsPerPage={rowsPerPage}
                page={page}
                onPageChange={handleChangePage}
                onRowsPerPageChange={handleChangeRowsPerPage}
              />

              <Stack direction="row" sx={actionButtonsContainer}>
                <Button variant="outlined" onClick={resetAll} disabled={isCreatingBatch} startIcon={<RestartAlt />}>
                  Cancel & Upload Again
                </Button>
                <Button
                  variant="contained" color="success" size="large" onClick={handleCreateBatch}
                  disabled={isCreatingBatch}
                  startIcon={isCreatingBatch ? <CircularProgress size={20} color="inherit" /> : <Send />}
                >
                  {isCreatingBatch ? "Creating Batch..." : "Create Batch"}
                </Button>
              </Stack>
            </Box>
          </Fade>
        )}

      </Paper>
    </Box>
  );
};
export default JournalBulkUpload;
