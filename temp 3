    /**
     * Generates a Base64 encoded SHA-256 hash from a Base64 string.
     * @param base64String the Base64 string to hash
     * @return Base64 encoded hash string or null if an error occurs
     */
    public static String generateHash(String base64String) {
        if (base64String == null || base64String.isEmpty()) {
            throw new IllegalArgumentException("Input Base64 string cannot be null or empty");
        }

        try {
            // Decode the Base64 string
            byte[] decodedBytes = Base64.getDecoder().decode(base64String);

            // Generate the hash using SHA-256
            MessageDigest digest = MessageDigest.getInstance("SHA-256");
            byte[] hashBytes = digest.digest(decodedBytes);

            //  Encode the hash to Base64
            return Base64.getEncoder().encodeToString(hashBytes);
        } catch (IllegalArgumentException e) {
            System.err.println("Invalid Base64 input: " + e.getMessage());
            return null; // or handle as needed
        } catch (NoSuchAlgorithmException e) {
            System.err.println("Hashing algorithm not found: " + e.getMessage());
            return null; // or handle as needed
        } catch (Exception e) {
            System.err.println("An unexpected error occurred: " + e.getMessage());
            return null; // or handle as needed
        }
    }

