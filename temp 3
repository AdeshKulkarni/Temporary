import React, { useState, useEffect, useCallback } from "react";
import {
  Box, Typography, Chip, Dialog, DialogActions, DialogContent, DialogContentText,
  DialogTitle, TextField, Button, CircularProgress, Tooltip, IconButton, Stack,
  Table, TableBody, TableCell, TableContainer, TableHead, TableRow, Paper, Checkbox
} from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import { Check as CheckIcon, Clear as ClearIcon, Visibility as VisibilityIcon, Close as CloseIcon } from "@mui/icons-material";
import AccountCircleIcon from "@mui/icons-material/AccountCircle";
import InfoIcon from "@mui/icons-material/Info";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import { JournalStyles } from "./JournalStyles";

const formatCurrency = (num) => Number(num).toFixed(4);

export default function JournalRequestApproval() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  const [currentUserId, setCurrentUserId] = useState(null);
  const [loading, setLoading] = useState(true);
  const [rows, setRows] = useState([]);

  // Action States
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [isApproveLoading, setIsApproveLoading] = useState(false);
  const [isRejectLoading, setIsRejectLoading] = useState(false);
  const [selectedBatch, setSelectedBatch] = useState(null);
  const [modalMode, setModalMode] = useState("ACCEPTED");
  const [executorRemarks, setExecutorRemarks] = useState("");

  // View Modal
  const [isViewModalOpen, setIsViewModalOpen] = useState(false);
  const [isViewLoading, setIsViewLoading] = useState(false);
  const [batchDetails, setBatchDetails] = useState([]);
  const [viewingBatchId, setViewingBatchId] = useState(null);
  
  // Partial (View Modal Actions)
  const [selectedJournalPrefixes, setSelectedJournalPrefixes] = useState([]);
  const [partialExecutorRemarks, setPartialExecutorRemarks] = useState("");
  const [isPartialApproveLoading, setIsPartialApproveLoading] = useState(false);
  const [isPartialRejectLoading, setIsPartialRejectLoading] = useState(false);

  useEffect(() => {
     // ... (User Auth Logic same as provided previously)
     // Mocking fetch success
     setCurrentUserId("admin"); 
  }, []);

  const fetchPendingBatches = useCallback(async () => {
    setLoading(true);
    try {
      const pendingRequests = await callApi("/JS/journals/pending-requests", null, "GET");
      if (!Array.isArray(pendingRequests) || pendingRequests.length === 0) {
        setRows([]);
        return;
      }
      
      const groupedBatches = new Map();
      pendingRequests.forEach(req => {
         const batchId = req.batchId;
         if(!groupedBatches.has(batchId)) {
             groupedBatches.set(batchId, {
                id: batchId, batchId, creatorId: req.creatorId,
                requestDate: req.requestDate, commonBatchRemarks: req.commonBatchRemarks,
                totalDebit: 0, totalCredit: 0, requestCount: 0
             });
         }
         const detail = groupedBatches.get(batchId);
         detail.requestCount++;
         try {
             const pl = JSON.parse(req.payload);
             const amt = parseFloat(pl.amount) || 0;
             if(amt < 0) detail.totalCredit += Math.abs(amt);
             else detail.totalDebit += amt;
         } catch(e){}
      });
      setRows(Array.from(groupedBatches.values()));
    } catch (err) {
      showSnackBar("Failed to load requests", "error");
    } finally { setLoading(false); }
  }, [callApi, showSnackBar]);

  useEffect(() => { fetchPendingBatches(); }, [fetchPendingBatches]);

  const handleOpenModal = (batch, mode) => {
    setSelectedBatch(batch); setModalMode(mode); setExecutorRemarks(""); setIsModalOpen(true);
  };
  const handleCloseModal = () => { setIsModalOpen(false); setSelectedBatch(null); };

  const handleSubmitAction = async () => {
    if (modalMode === "REJECTED" && !executorRemarks.trim()) {
      showSnackBar("Remarks required for rejection.", "warning"); return;
    }
    const setLoadingFn = modalMode === "ACCEPTED" ? setIsApproveLoading : setIsRejectLoading;
    setLoadingFn(true);

    try {
      await callApi("/JS/journals/process-bulk", {
         batchId: selectedBatch.batchId, status: modalMode, remarks: executorRemarks || modalMode
      }, "POST");
      showSnackBar(`Batch ${modalMode === "ACCEPTED" ? "Approved" : "Rejected"} Successfully`, "success", 5000);
      handleCloseModal();
      fetchPendingBatches();
    } catch (e) { showSnackBar("Process Failed", "error"); }
    finally { setLoadingFn(false); }
  };

  const handleOpenViewModal = async (batchId, creatorId) => {
      setIsViewModalOpen(true); setIsViewLoading(true); setViewingBatchId(batchId);
      try {
          const data = await callApi(`/JS/journals/by-batch/${batchId}`, null, "GET");
          // Grouping logic for View Table
          const groups = new Map();
          data.filter(r => r.requestStatus === "PENDING").forEach(req => {
              const prefix = req.journalId.split("-")[0];
              if(!groups.has(prefix)) groups.set(prefix, []);
              try {
                  const pl = JSON.parse(req.payload);
                  groups.get(prefix).push({ ...req, payload: pl, journalPrefix: prefix, amount: Math.abs(pl.amount) });
              } catch(e){}
          });
          setBatchDetails(Array.from(groups.values()));
      } catch(e) { showSnackBar("Failed to load details", "error"); }
      finally { setIsViewLoading(false); }
  };

  // Sticky Logic Table Row
  const renderDetailRows = () => {
      return batchDetails.map((group, gIdx) => (
          group.map((row, rIdx) => {
              const isSelected = selectedJournalPrefixes.includes(row.journalPrefix);
              return (
                  <TableRow key={row.id} selected={isSelected} hover>
                      {/* Sticky Checkbox */}
                      {rIdx === 0 && (
                          <TableCell rowSpan={group.length} padding="checkbox" sx={{...JournalStyles.stickyColumn, top: 0, zIndex: 5}}>
                              <Checkbox checked={isSelected} onClick={() => {
                                  const newSel = isSelected ? selectedJournalPrefixes.filter(p => p !== row.journalPrefix) : [...selectedJournalPrefixes, row.journalPrefix];
                                  setSelectedJournalPrefixes(newSel);
                              }}/>
                          </TableCell>
                      )}
                      {/* Sticky ID */}
                      {rIdx === 0 && (
                          <TableCell rowSpan={group.length} sx={{...JournalStyles.stickyColumn, left: 48, zIndex: 5}}>
                              {row.journalPrefix}
                          </TableCell>
                      )}
                      <TableCell>{row.payload.branch}</TableCell>
                      <TableCell>{row.payload.currency}</TableCell>
                      <TableCell>{row.payload.cgl}</TableCell>
                      <TableCell>{formatCurrency(row.amount)}</TableCell>
                      <TableCell>{row.amount < 0 || row.payload.amount < 0 ? "Credit" : "Debit"}</TableCell>
                  </TableRow>
              );
          })
      ));
  };

  const columns = [
    { field: "batchId", headerName: "Batch ID", width: 150 },
    { field: "requestStatus", headerName: "Status", width: 120, renderCell: (p) => <Chip label={p.value} color="warning" size="small"/> },
    { field: "creatorId", headerName: "Creator", width: 150 },
    { field: "requestDate", headerName: "Date", width: 200, valueFormatter: (p) => new Date(p.value).toLocaleString() },
    { field: "actions", headerName: "Actions", width: 150, renderCell: (p) => (
       <Stack direction="row">
          <IconButton onClick={() => handleOpenViewModal(p.row.batchId, p.row.creatorId)}><VisibilityIcon/></IconButton>
          <IconButton onClick={() => handleOpenModal(p.row, "ACCEPTED")} color="success"><CheckIcon/></IconButton>
          <IconButton onClick={() => handleOpenModal(p.row, "REJECTED")} color="error"><ClearIcon/></IconButton>
       </Stack>
    )}
  ];

  return (
    <Box sx={JournalStyles.mainContainer}>
       <DataGrid rows={rows} columns={columns} loading={loading} sx={{height: 600}} disableRowSelectionOnClick />
       
       {/* Approve/Reject Dialog */}
       <Dialog open={isModalOpen} onClose={handleCloseModal} fullWidth maxWidth="sm">
          <DialogTitle>{modalMode === "ACCEPTED" ? "Approve" : "Reject"} Batch</DialogTitle>
          <DialogContent>
              <DialogContentText>Confirm action for Batch {selectedBatch?.batchId}?</DialogContentText>
              <TextField autoFocus={modalMode==="REJECTED"} label="Remarks" fullWidth variant="standard" 
                  value={executorRemarks} onChange={(e)=>setExecutorRemarks(e.target.value)} />
          </DialogContent>
          <DialogActions>
              <Button onClick={handleCloseModal}>Cancel</Button>
              <Button onClick={handleSubmitAction} variant="contained" color={modalMode==="ACCEPTED"?"success":"error"} 
                  disabled={isApproveLoading || isRejectLoading}>
                  {isApproveLoading || isRejectLoading ? <CircularProgress size={24}/> : "Confirm"}
              </Button>
          </DialogActions>
       </Dialog>

       {/* View Details Dialog */}
       <Dialog open={isViewModalOpen} onClose={() => setIsViewModalOpen(false)} fullWidth maxWidth="lg">
          <DialogTitle>Batch Details: {viewingBatchId}</DialogTitle>
          <DialogContent>
             {isViewLoading ? <CircularProgress/> : (
                <TableContainer component={Paper} sx={JournalStyles.tableContainer}>
                    <Table stickyHeader size="small">
                        <TableHead>
                            <TableRow>
                                <TableCell sx={{...JournalStyles.stickyHeader, zIndex: 20, left: 0}} padding="checkbox"><Checkbox/></TableCell>
                                <TableCell sx={{...JournalStyles.stickyHeader, zIndex: 20, left: 48}}>Journal ID</TableCell>
                                <TableCell sx={JournalStyles.tableHeader}>Branch</TableCell>
                                <TableCell sx={JournalStyles.tableHeader}>Currency</TableCell>
                                <TableCell sx={JournalStyles.tableHeader}>CGL</TableCell>
                                <TableCell sx={JournalStyles.tableHeader}>Amount</TableCell>
                                <TableCell sx={JournalStyles.tableHeader}>Type</TableCell>
                            </TableRow>
                        </TableHead>
                        <TableBody>{renderDetailRows()}</TableBody>
                    </Table>
                </TableContainer>
             )}
          </DialogContent>
          <DialogActions>
              <Button onClick={() => setIsViewModalOpen(false)}>Close</Button>
          </DialogActions>
       </Dialog>
    </Box>
  );
}

