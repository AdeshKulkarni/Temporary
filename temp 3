    /**
     * @description : method is used to save compliance comment, evidence file, evidence name along with existing data for Lfar3
     * Upload file is handled here with save row data using blob.
     */
    @Override
    public ResponseVo<Object> saveComplianceData(Map<String, Object> map) {
        Map<String, Object> result = new HashMap<>();
        try {
            // fetching the user & data from the map
            Map<String, String> user = (Map<String, String>) map.get("user");
            Map<String, Object> data = (Map<String, Object>) map.get("data");

            List<String> rowData = (List<String>) data.get("value");
            // log.info("rowData : " + rowData);

            // getting common data here
            String submissionId = String.valueOf(data.get("submissionId"));
            String branch_code = user.get("branch_code");
            SimpleDateFormat formatter = new SimpleDateFormat("dd/MM/yyyy");
            Date quarterEndDate = formatter.parse(user.get("quarterEndDate"));

            /*
             * 0 - Type
             * 1 - Sub Type
             * 2 - Name of The borrower
             * 3 - Account No / CIF no
             * 4 - Amount Limit in Rs
             * 5 - COMMENT
             * 6 - FILE NAME
             * 7 - FILE NAME
             * 8 - ROW ID
             * 9 - ROW ID
             * 10 - FALSE
             *
             */
            
            // fetch the existing entity by row id and update only compliance part
            String rowId = rowData.get(rowData.size() - 2);
            log.info("rowId : " + rowId);
            if (rowId == null || rowId.equals("") || rowId.equals(" ")) {
                throw new IllegalArgumentException("Row Id cannot be null or empty");
            }
            CrsLfar crsLfar = crsLfarRepository.findById(Integer.parseInt(rowId)).get();
            log.info("fetched crsLfar : " + crsLfar);
            crsLfar.setComment(rowData.get(5));

            // Construct the file name and file
            //String fileName = crsLfar.getLfarId() + "_" + branch_code + "_" + "Compliance" + "_" + "LFAR3Evidence" + ".pdf";
            String fileName = rowData.get(6);

            if (data.containsKey("evidence")) {
                Object evidence = data.get("evidence");
                if(evidence!=null ){
                    String evidenceStr = evidence.toString();
                    if(evidenceStr!=null && !evidenceStr.trim().isEmpty())
                    {
                        //String evidence = data.get("evidence").toString(); //byte64 as string
                        // Convert the base 64 to byte array
                        byte[] pdfBytes = Base64.getDecoder().decode(evidenceStr);

                        crsLfar.setEvidenceName(fileName);
                        crsLfar.setEvidenceFile(pdfBytes);
                    }
                }
            }

            CrsLfar entity = crsLfarRepository.save(crsLfar);
            result.put(STATUS, true);
            result.put("newId", entity.getLfarId());
            result.put("newRowNum", entity.getLfarId());
            result.put("fileId", fileName);
            result.put("fileName", fileName);

            // log.info("Data saved successfully : {}", entity);
        } catch (NullPointerException e) {
            log.error("Null Pointer Exception Occurred : {}", e.getMessage());
            result.put(STATUS, false);
            result.put("msg", e.getMessage());
        } catch (Exception e) {
            log.error("Exception Occurred : {}",e.getMessage());
            // e.printStackTrace();
            result.put(STATUS, false);
            result.put("msg", e.getMessage());
        }

        // return result;
        ResponseVo<Object> responseVo = new ResponseVo<>();
        if (result.get(STATUS).toString().equalsIgnoreCase("true")) {
            responseVo.setStatusCode(HttpStatus.OK.value());
            responseVo.setMessage("Data Saved successfully");
        }else {
            responseVo.setStatusCode(HttpStatus.INTERNAL_SERVER_ERROR.value());
            responseVo.setMessage("Failed to save data");
        }
        responseVo.setResult(result);

        return responseVo;
    }

    /**
    * Private functions
    */
    private Map<String, List<String>> getColumnsList() {
        Map<String, List<String>> result = new HashMap<>();

        List<List<String>> columnParams = crsLfarRepository.getColumnsParams();

        for (List<String> row : columnParams) {
            String type = row.get(0);
            String subType = row.get(1);

            if (!result.containsKey(type)) {
                List<String> tmp = new ArrayList<>();
                result.put(type, tmp);
            }
            result.get(type).add(subType);
        }

        return result;
    }


}


