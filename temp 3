        List<JournalRequest> requestsToProcess;
        if (StringUtils.hasText(dto.getBatchId())) {
            requestsToProcess = journalRequestRepository.findByBatchIdAndRequestStatus(dto.getBatchId(), RequestStatus.PENDING);
        } else {
            // ... (Prefix logic)
            requestsToProcess = new ArrayList<>();
        }
        
        if (requestsToProcess.isEmpty()) return Collections.emptyList();
        
        List<GlTransaction> txns = new ArrayList<>();
        List<JournalRequest> processed = new ArrayList<>();

        for (JournalRequest req : requestsToProcess) {
            req.setExecutorId(executorId);
            req.setExecutorRemarks(dto.getRemarks());
            req.setExecutionDate(LocalDateTime.now());
            req.setRequestStatus(dto.getStatus());

            if (RequestStatus.ACCEPTED.equals(dto.getStatus())) {
                CreateJournalRequestDto p = objectMapper.readValue(req.getPayload(), CreateJournalRequestDto.class);
                GlTransaction t = new GlTransaction();
                t.setBatchId(p.getBatchId());
                t.setJournalId(p.getJournalId());
                t.setPostDate(LocalDateTime.now());
                t.setTransactionDate(p.getPDate());
                t.setBranchCode(p.getBranch());
                t.setCurrency(p.getCurrency());
                t.setCgl(p.getCgl());
                t.setNarration(p.getRemarks());
                
                if (p.getAmount().signum() < 0) {
                    t.setCreditAmount(p.getAmount().abs()); t.setDebitAmount(BigDecimal.ZERO);
                } else {
                    t.setDebitAmount(p.getAmount()); t.setCreditAmount(BigDecimal.ZERO);
                }
                t.setTransactionCount(p.getTransactionCount());
                t.setSourceFlag("J");
                txns.add(t);
            }
            processed.add(req);
        }
        if(!txns.isEmpty()) glTransactionRepository.saveAll(txns);
        return journalRequestRepository.saveAll(processed);
    }

