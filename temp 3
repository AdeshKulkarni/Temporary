@Service
@RequiredArgsConstructor
@Slf4j
public class JournalBulkValidationService {

    private final BranchMasterRepository branchRepo;
    private final CglMasterRepository cglRepo;
    private final CurrencyMasterRepository currencyRepo;
    private final StringRedisTemplate redisTemplate;
    private final ObjectMapper objectMapper;

    private static final Pattern CLEAN_AMOUNT_REGEX = Pattern.compile("[^0-9.-]");
    private static final Pattern PRODUCT_CODE_REGEX = Pattern.compile("^\\d{8}$");
    private static final Pattern CGL_FORMAT_REGEX = Pattern.compile("^\\d{10}$"); 

    private static final String KEY_META = "journal:upload:meta:";
    private static final String KEY_FILE_ERR = "journal:upload:file:err:";
    private static final String KEY_FILE_SUC = "journal:upload:file:suc:";
    private static final long TTL_MINUTES = 60;

    private static class ExcelRowData {
        int rowIndex;
        String branch = "", currency = "", cgl = "", txnType = "", remarks = "", productCode = "";
        BigDecimal amount;
        
        // Specific Error Lists
        List<String> formatErrors = Collections.synchronizedList(new ArrayList<>());
        List<String> dbErrors = Collections.synchronizedList(new ArrayList<>());
        List<String> balErrors = Collections.synchronizedList(new ArrayList<>());
        
        // CRITICAL: Checks if ANY list has errors
        boolean hasErrors() { 
            return !formatErrors.isEmpty() || !dbErrors.isEmpty() || !balErrors.isEmpty(); 
        }
        
        // Helper to get all errors as one string for Excel
        String getAllErrorsString() {
            List<String> all = new ArrayList<>();
            all.addAll(formatErrors);
            all.addAll(dbErrors);
            all.addAll(balErrors);
            return String.join("; ", all);
        }
    }

    public String initiateValidation(MultipartFile file, LocalDate postingDate) throws IOException {
        String requestId = UUID.randomUUID().toString();
        BulkUploadStateDto state = new BulkUploadStateDto();
        state.setRequestId(requestId);
        state.setStatus("PROCESSING");
        state.setCurrentStage(1);
        state.setMessage("Validating Formats...");
        saveStateToRedis(state);

        byte[] fileBytes = file.getBytes();
        String filename = file.getOriginalFilename();
        processAsync(requestId, fileBytes, filename, postingDate);
        return requestId;
    }

    @Async("bulkExecutor")
    public void processAsync(String requestId, byte[] fileBytes, String filename, LocalDate postingDate) {
        try {
            List<ExcelRowData> parsedRows;
            if (filename != null && (filename.toLowerCase().endsWith(".csv") || filename.toLowerCase().endsWith(".txt"))) {
                parsedRows = parseCsvBytes(fileBytes);
            } else {
                parsedRows = parseExcelBytes(fileBytes);
            }
            boolean isInputCsv = filename != null && filename.toLowerCase().endsWith(".csv");

            updateState(requestId, s -> s.setTotalRows(parsedRows.size()));

            // --- STAGE 1: FORMAT CHECK ---
            if (runFormatCheck(parsedRows)) {
                failRequest(requestId, parsedRows, "Format Validation Failed", 1);
                return;
            }
            updateState(requestId, s -> { s.setCurrentStage(2); s.setMessage("Checking Database..."); });

            // --- STAGE 2: DB CHECK ---
            if (runDbCheck(parsedRows)) {
                failRequest(requestId, parsedRows, "Database Validation Failed", 2);
                return;
            }
            updateState(requestId, s -> { s.setCurrentStage(3); s.setMessage("Checking Balances..."); });

            // --- STAGE 3: BALANCE CHECK ---
            if (runBalanceCheck(parsedRows)) {
                failRequest(requestId, parsedRows, "Debit/Credit Balance Mismatch", 3);
                return;
            }

            // --- STAGE 4: SUCCESS ---
            completeRequest(requestId, parsedRows, postingDate, isInputCsv);

        } catch (Exception e) {
            log.error("Async Error", e);
            updateState(requestId, s -> { s.setStatus("ERROR"); s.setMessage("System Error: " + e.getMessage()); });
        }
    }

    private boolean runFormatCheck(List<ExcelRowData> rows) {
        rows.parallelStream().forEach(d -> {
            if (d.branch == null || d.branch.isEmpty()) d.formatErrors.add("Branch Empty");
            if (d.currency == null || d.currency.length() != 3) d.formatErrors.add("Invalid Currency");
            if (d.cgl == null || !CGL_FORMAT_REGEX.matcher(d.cgl).matches()) d.formatErrors.add("Invalid CGL");
            if (d.amount == null || d.amount.compareTo(BigDecimal.ZERO) == 0) d.formatErrors.add("Invalid Amount");
            if (d.productCode != null && !d.productCode.isEmpty() && !PRODUCT_CODE_REGEX.matcher(d.productCode).matches()) {
                d.formatErrors.add("Invalid Product Code");
            }
        });
        return rows.stream().anyMatch(ExcelRowData::hasErrors);
    }

    private boolean runDbCheck(List<ExcelRowData> rows) {
        Set<String> branches = rows.parallelStream().map(r -> r.branch).collect(Collectors.toSet());
        Set<String> cgls = rows.parallelStream().map(r -> r.cgl).collect(Collectors.toSet());
        Set<String> currs = rows.parallelStream().map(r -> r.currency).collect(Collectors.toSet());

        Set<String> validBranches = branchRepo.findAllById(branches).stream().map(BranchMaster::getCode).collect(Collectors.toSet());
        Set<String> validCgls = cglRepo.findAllById(cgls).stream().map(CglMaster::getCglNumber).collect(Collectors.toSet());
        Set<String> validCurrs = currencyRepo.findAllById(currs).stream().map(CurrencyMaster::getCurrencyCode).collect(Collectors.toSet());

        rows.parallelStream().forEach(d -> {
            if (!validBranches.contains(d.branch)) d.dbErrors.add("Branch Not Found: " + d.branch);
            if (!validCurrs.contains(d.currency)) d.dbErrors.add("Currency Not Found: " + d.currency);
            if (!validCgls.contains(d.cgl)) d.dbErrors.add("CGL Not Found: " + d.cgl);
        });
        return rows.stream().anyMatch(ExcelRowData::hasErrors);
    }

    private boolean runBalanceCheck(List<ExcelRowData> rows) {
        ConcurrentHashMap<String, LongAdder> balanceMap = new ConcurrentHashMap<>();
        rows.parallelStream().forEach(d -> {
            if (d.amount != null) {
                String type = d.cgl.startsWith("5") ? "MEMO" : "NORMAL";
                String key = d.branch + "_" + d.currency + "_" + type;
                long val = d.amount.multiply(new BigDecimal("10000")).longValue();
                balanceMap.computeIfAbsent(key, k -> new LongAdder()).add(val);
            }
        });

        rows.parallelStream().forEach(d -> {
            String type = d.cgl.startsWith("5") ? "MEMO" : "NORMAL";
            String key = d.branch + "_" + d.currency + "_" + type;
            LongAdder adder = balanceMap.get(key);
            if (adder != null && adder.sum() != 0) {
                BigDecimal diff = BigDecimal.valueOf(adder.sum()).divide(new BigDecimal("10000"));
                synchronized(d.balErrors) {
                    if (d.balErrors.isEmpty()) d.balErrors.add(type + " Mismatch: " + diff.toPlainString());
                }
            }
        });
        return rows.stream().anyMatch(ExcelRowData::hasErrors);
    }

    private void failRequest(String reqId, List<ExcelRowData> rows, String msg, int stage) throws IOException {
        // Generate Excel capturing ALL errors
        byte[] excel = generateErrorExcelFast(rows);
        saveFileToRedis(reqId, "ERROR", excel);
        
        updateState(reqId, s -> {
            s.setStatus("ERROR");
            s.setMessage(msg);
            s.setCurrentStage(stage);
            // Count rows that have ANY error
            s.setErrorCount(rows.stream().filter(ExcelRowData::hasErrors).count());
            s.setHasErrorFile(true);
        });
    }

    private void completeRequest(String reqId, List<ExcelRowData> rows, LocalDate pDate, boolean isCsv) throws IOException {
        if (!isCsv) {
            byte[] csv = generateSuccessCsv(rows, pDate);
            saveFileToRedis(reqId, "SUCCESS", csv);
        }
        
        List<Map<String, Object>> preview = rows.stream().limit(100).map(this::mapToPreview).collect(Collectors.toList());
        String previewJson = objectMapper.writeValueAsString(preview);

        updateState(reqId, s -> {
            s.setCurrentStage(4);
            s.setStatus("SUCCESS");
            s.setMessage("Validation Successful");
            s.setHasSuccessFile(!isCsv);
            s.setPreviewDataJson(previewJson);
        });
    }

    // --- FILE GENERATION (FIXED to read from all error lists) ---
    private byte[] generateErrorExcelFast(List<ExcelRowData> rows) throws IOException {
        try (SXSSFWorkbook workbook = new SXSSFWorkbook(100)) { 
            workbook.setCompressTempFiles(true);
            Sheet sheet = workbook.createSheet("Error Report");

            CellStyle errorHeaderStyle = workbook.createCellStyle();
            Font errorFont = workbook.createFont();
            errorFont.setBold(true);
            errorFont.setColor(IndexedColors.RED.getIndex());
            errorHeaderStyle.setFont(errorFont);
            
            CellStyle errorDataStyle = workbook.createCellStyle();
            Font errorDataFont = workbook.createFont();
            errorDataFont.setColor(IndexedColors.RED.getIndex());
            errorDataStyle.setFont(errorDataFont);

            Row header = sheet.createRow(0);
            String[] headers = {"Branch", "Currency", "CGL", "Amount", "TxnType", "Remarks", "Product", "ERRORS"};
            for(int i=0; i<headers.length; i++) {
                Cell c = header.createCell(i);
                c.setCellValue(headers[i]);
                if (headers[i].equals("ERRORS")) c.setCellStyle(errorHeaderStyle);
            }

            int idx = 1;
            for(ExcelRowData d : rows) {
                // IMPORTANT: Only write rows that actually have errors
                if (d.hasErrors()) {
                    Row r = sheet.createRow(idx++);
                    r.createCell(0).setCellValue(d.branch);
                    r.createCell(1).setCellValue(d.currency);
                    r.createCell(2).setCellValue(d.cgl);
                    r.createCell(3).setCellValue(d.amount != null ? d.amount.toString() : "");
                    r.createCell(4).setCellValue(d.txnType);
                    r.createCell(5).setCellValue(d.remarks);
                    r.createCell(6).setCellValue(d.productCode);
                    
                    // Combine all errors into one cell
                    Cell errCell = r.createCell(7);
                    errCell.setCellValue(d.getAllErrorsString());
                    errCell.setCellStyle(errorDataStyle);
                }
            }
            
            ByteArrayOutputStream out = new ByteArrayOutputStream();
            workbook.write(out);
            workbook.dispose();
            return out.toByteArray();
        }
    }

    private void saveStateToRedis(BulkUploadStateDto state) {
        try {
            String json = objectMapper.writeValueAsString(state);
            redisTemplate.opsForValue().set(KEY_META + state.getRequestId(), json, TTL_MINUTES, TimeUnit.MINUTES);
        } catch (Exception e) { log.error("Redis Save Error", e); }
    }

    private void updateState(String requestId, java.util.function.Consumer<BulkUploadStateDto> updater) {
        try {
            String json = redisTemplate.opsForValue().get(KEY_META + requestId);
            if (json != null) {
                BulkUploadStateDto state = objectMapper.readValue(json, BulkUploadStateDto.class);
                updater.accept(state);
                saveStateToRedis(state);
            }
        } catch (Exception e) { log.error("Redis Update Error", e); }
    }

    private void saveFileToRedis(String requestId, String type, byte[] data) {
        String key = (type.equals("ERROR") ? KEY_FILE_ERR : KEY_FILE_SUC) + requestId;
        String base64 = Base64.getEncoder().encodeToString(data);
        redisTemplate.opsForValue().set(key, base64, TTL_MINUTES, TimeUnit.MINUTES);
    }

    public BulkUploadStateDto getState(String reqId) {
        try {
            String json = redisTemplate.opsForValue().get(KEY_META + reqId);
            return json != null ? objectMapper.readValue(json, BulkUploadStateDto.class) : null;
        } catch (Exception e) { return null; }
    }

    public byte[] getFileFromRedis(String reqId, String type) {
        String key = (type.equals("ERROR") ? KEY_FILE_ERR : KEY_FILE_SUC) + reqId;
        String base64 = redisTemplate.opsForValue().get(key);
        return base64 != null ? Base64.getDecoder().decode(base64) : null;
    }

    // --- PARSERS & HELPERS (Keep existing logic) ---
    private List<ExcelRowData> parseExcelBytes(byte[] bytes) throws IOException {
        try (Workbook workbook = new XSSFWorkbook(new ByteArrayInputStream(bytes))) { return parseWorkbookLogic(workbook); }
    }
    private List<ExcelRowData> parseCsvBytes(byte[] bytes) throws IOException {
        try (BufferedReader reader = new BufferedReader(new InputStreamReader(new ByteArrayInputStream(bytes), StandardCharsets.UTF_8))) { return parseCsvReaderLogic(reader); }
    }
    private List<ExcelRowData> parseWorkbookLogic(Workbook workbook) {
        List<ExcelRowData> rows = new ArrayList<>();
        Sheet sheet = workbook.getSheetAt(0);
        DataFormatter formatter = new DataFormatter();
        for (Row row : sheet) {
            if (row.getRowNum() == 0) continue; // Skip Header
            if (isRowEmpty(row)) continue;
            ExcelRowData data = new ExcelRowData();
            data.rowIndex = row.getRowNum();
            data.branch = parseCode(row.getCell(0), formatter);     
            data.currency = getCellValueAsString(row.getCell(1), formatter).toUpperCase().trim(); 
            data.cgl = parseCode(row.getCell(2), formatter);        
            String amountRaw = getCellValueAsString(row.getCell(3), formatter).trim(); 
            String typeRaw = getCellValueAsString(row.getCell(4), formatter).trim().toUpperCase(); 
            data.remarks = getCellValueAsString(row.getCell(5), formatter);
            data.productCode = parseCode(row.getCell(6), formatter); 
            data.txnType = typeRaw; 
            parseAmountAndType(data, amountRaw, typeRaw);
            rows.add(data);
        }
        return rows;
    }
    private List<ExcelRowData> parseCsvReaderLogic(BufferedReader reader) throws IOException {
        List<ExcelRowData> rows = new ArrayList<>();
        String line; int i=0;
        while ((line = reader.readLine()) != null) {
            if (line.trim().isEmpty()) continue;
            String[] c = line.split(",");
            if (c.length < 9) continue;
            ExcelRowData d = new ExcelRowData();
            d.rowIndex = i++;
            d.branch = c[4].trim(); d.currency = c[5].trim(); d.cgl = c[6].trim();
            parseAmountAndType(d, c[7].trim(), c[8].trim());
            d.remarks = c.length>9?c[9].trim():""; d.productCode = c.length>10?c[10].trim():"";
            rows.add(d);
        }
        return rows;
    }
    private void parseAmountAndType(ExcelRowData data, String amountRaw, String typeRaw) {
        try {
            String clean = CLEAN_AMOUNT_REGEX.matcher(amountRaw).replaceAll("");
            if (clean.isEmpty()) return;
            BigDecimal val = new BigDecimal(clean);
            boolean isCr = typeRaw.contains("CR") || amountRaw.contains("-");
            data.amount = isCr ? val.abs().negate() : val.abs();
            data.txnType = typeRaw.toUpperCase();
        } catch (Exception e) {}
    }
    private byte[] generateSuccessCsv(List<ExcelRowData> rows, LocalDate d) { return new byte[0]; } // Mock for brevity, use previous full version
    private Map<String, Object> mapToPreview(ExcelRowData r) {
        Map<String, Object> m = new HashMap<>();
        m.put("id", r.rowIndex); m.put("branch", r.branch); m.put("currency", r.currency);
        m.put("cgl", r.cgl); m.put("amount", r.amount!=null?r.amount.abs().toString():"");
        m.put("txnType", r.txnType); m.put("remarks", r.remarks); m.put("productCode", r.productCode);
        return m;
    }
    private String parseCode(Cell c, DataFormatter f) { return getCellValueAsString(c, f).split("\\.")[0]; }
    private String getCellValueAsString(Cell c, DataFormatter f) { return f.formatCellValue(c).trim(); }
    private boolean isRowEmpty(Row r) { return false; }
}

