import React, { useState, useRef, useEffect } from "react";
import {
  Box, Typography, Paper, TextField, Button, CircularProgress, Chip, Alert,
  Stack, Stepper, Step, StepLabel, Table, TableBody, TableCell, TableContainer,
  TableHead, TableRow
} from "@mui/material";
import {
  CloudUpload, CheckCircle, Error as ErrorIcon, Send, RestartAlt,
  FileDownload
} from "@mui/icons-material";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import { JournalStyles } from "./JournalStyles";

const steps = ["Upload File", "Validation", "Preview & Submit"];

const JournalBulkUpload = () => {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  
  // Inputs
  const [selectedDate, setSelectedDate] = useState("");
  const [file, setFile] = useState(null);
  const fileInputRef = useRef(null);

  // Status
  const [activeStep, setActiveStep] = useState(0);
  const [requestId, setRequestId] = useState(null);
  const [isProcessing, setIsProcessing] = useState(false);
  const [resultStatus, setResultStatus] = useState(null); // SUCCESS, ERROR
  const [errorMsg, setErrorMsg] = useState("");
  
  // Data
  const [previewRows, setPreviewRows] = useState([]);
  const [totalRows, setTotalRows] = useState(0);
  const [hasProductColumn, setHasProductColumn] = useState(false);
  const [autoDlTriggered, setAutoDlTriggered] = useState(false);

  // Batch Creation
  const [isCreatingBatch, setIsCreatingBatch] = useState(false);

  const handleDateChange = (e) => {
    setSelectedDate(e.target.value);
    if(resultStatus) resetProcess(); 
  };

  const handleFileSelect = (e) => {
    if (e.target.files[0]) {
      setFile(e.target.files[0]);
      resetProcess();
    }
  };

  const resetProcess = () => {
    setActiveStep(0);
    setRequestId(null);
    setResultStatus(null);
    setErrorMsg("");
    setPreviewRows([]);
    setTotalRows(0);
    setIsProcessing(false);
    setAutoDlTriggered(false);
    if (fileInputRef.current) fileInputRef.current.value = "";
  };

  const handleStartValidation = async () => {
    if (!selectedDate || !file) {
      showSnackBar("Please select a Posting Date and File.", "warning");
      return;
    }
    if (file.size === 0) {
      showSnackBar("File is empty.", "error");
      return;
    }

    setIsProcessing(true);
    setActiveStep(1);

    const formData = new FormData();
    formData.append("file", file);
    formData.append("postingDate", selectedDate);

    try {
      let token = ""; 
      const storageAuth = sessionStorage.getItem("persist:auth") || localStorage.getItem("persist:auth");
      if(storageAuth) { try { token = JSON.parse(storageAuth).token.replace(/"/g, ""); } catch(e){} }

      const res = await fetch("/JS/journals/bulk-validate-init", {
        method: "POST",
        headers: { "Authorization": `Bearer ${token}` },
        body: formData
      });

      if(!res.ok) throw new Error(await res.text());
      const data = await res.json();
      setRequestId(data.requestId); 
    } catch (err) {
      setIsProcessing(false);
      setResultStatus("ERROR");
      setErrorMsg("Upload failed: " + err.message);
      showSnackBar("Upload failed.", "error");
    }
  };

  // Polling Logic
  useEffect(() => {
    let interval;
    if (isProcessing && requestId) {
      interval = setInterval(async () => {
        try {
          const res = await callApi(`/JS/journals/bulk-status/${requestId}`, null, "GET");
          
          if (res.status === "ERROR") {
            setIsProcessing(false);
            setResultStatus("ERROR");
            setErrorMsg(res.message);
            clearInterval(interval);
            showSnackBar(res.message, "error", 5000); 
            
            if (res.hasErrorFile && !autoDlTriggered) {
                setAutoDlTriggered(true);
                handleDownloadFile("ERROR", res.requestId);
            }
          } 
          else if (res.status === "SUCCESS") {
            setIsProcessing(false);
            setResultStatus("SUCCESS");
            setTotalRows(res.totalRows);
            if (res.previewDataJson) {
               const rows = JSON.parse(res.previewDataJson);
               setPreviewRows(rows);
               setHasProductColumn(rows.some(r => r.productCode && r.productCode !== "A"));
            }
            setActiveStep(2);
            clearInterval(interval);
            showSnackBar("Validation Successful!", "success", 5000);
          }
        } catch (e) { console.error(e); }
      }, 1000);
    }
    return () => clearInterval(interval);
  }, [isProcessing, requestId, callApi, showSnackBar, autoDlTriggered]);

  const handleDownloadFile = async (type, reqId = requestId) => {
    try {
        let token = "";
        const storageAuth = sessionStorage.getItem("persist:auth") || localStorage.getItem("persist:auth");
        if(storageAuth) { try { token = JSON.parse(storageAuth).token.replace(/"/g, ""); } catch(e){} }
        
        const response = await fetch(`/JS/journals/download-bulk-file/${reqId}?type=${type}`, {
             headers: { Authorization: `Bearer ${token}` }
        });
        if(!response.ok) throw new Error("Download failed");
        
        const blob = await response.blob();
        const url = window.URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.setAttribute("download", type === "ERROR" ? "Error_Report.xlsx" : "Success_Batch.csv");
        document.body.appendChild(link);
        link.click();
        link.remove();
        
        if (type === "ERROR") showSnackBar("Error report downloaded. Please check Site, Date, Year, Period columns.", "info", 6000);
    } catch(e) { showSnackBar("Download failed", "error"); }
  };
  
  const handleDownloadTemplate = async () => {
     // ... Logic for template download (similar fetch)
     showSnackBar("Template Downloading...", "info");
  };

  const handleCreateBatch = async () => {
    setIsCreatingBatch(true);
    try {
      const payload = { 
        requestId: requestId, 
        commonBatchRemarks: `Bulk Upload - ${selectedDate}` 
      };
      
      const res = await callApi("/JS/journals/create-bulk-batch-optimized", payload, "POST");
      
      if (res.status === "SUCCESS") {
         showSnackBar(`Batch ${res.batchId} Created Successfully!`, "success", 5000);
         resetProcess();
         setFile(null);
         setSelectedDate("");
      } else {
         throw new Error(res.message);
      }
    } catch (e) {
      showSnackBar("Failed to create batch: " + e.message, "error", 5000);
    } finally {
      setIsCreatingBatch(false);
    }
  };

  return (
    <Box sx={JournalStyles.mainContainer}>
      <Paper sx={JournalStyles.controlPanel}>
        <Box sx={{display:'flex', justifyContent:'flex-end'}}>
           <Button startIcon={<FileDownload/>} onClick={handleDownloadTemplate}>Template</Button>
        </Box>
        
        <Stepper activeStep={activeStep} sx={JournalStyles.stepperContainer} alternativeLabel>
          {steps.map((label, idx) => (
             <Step key={label}>
               <StepLabel error={resultStatus === "ERROR" && activeStep === idx}>
                 {label}
               </StepLabel>
             </Step>
          ))}
        </Stepper>

        {/* STEP 0: UPLOAD */}
        {activeStep === 0 && (
          <>
             <Box sx={JournalStyles.dateInputContainer}>
                <TextField 
                   type="date" label="Posting Date" value={selectedDate} onChange={handleDateChange}
                   InputLabelProps={{ shrink: true }} size="small"
                />
             </Box>
             
             <Box sx={JournalStyles.uploadBox} onClick={() => { if(selectedDate) fileInputRef.current.click(); else showSnackBar("Select Date First", "warning"); }}>
                <input type="file" hidden ref={fileInputRef} onChange={handleFileSelect} accept=".xlsx,.csv" />
                {file ? (
                   <>
                     <CheckCircle sx={{ fontSize: 60, color: "success.main" }} />
                     <Typography sx={JournalStyles.uploadText}>{file.name}</Typography>
                     <Chip label="Ready to Validate" color="primary" sx={{mt:1}} />
                   </>
                ) : (
                   <>
                     <CloudUpload sx={JournalStyles.uploadIcon} />
                     <Typography sx={JournalStyles.uploadText}>Click to Upload</Typography>
                     <Typography sx={JournalStyles.uploadSubText}>.xlsx, .csv (Max 50MB)</Typography>
                   </>
                )}
             </Box>

             <Box sx={JournalStyles.actionButtons}>
               <Button variant="contained" size="large" onClick={handleStartValidation} disabled={!file || !selectedDate}>
                  Next: Validate
               </Button>
             </Box>
          </>
        )}

        {/* STEP 1: PROCESSING / ERROR */}
        {activeStep === 1 && (
          <Box sx={{textAlign: 'center', py: 5}}>
             {resultStatus === "ERROR" ? (
                <Alert severity="error" sx={{maxWidth: 600, mx: 'auto'}}>
                   <Typography variant="h6">Validation Failed</Typography>
                   <Typography>{errorMsg}</Typography>
                   <Button startIcon={<RestartAlt />} onClick={resetProcess} sx={{mt: 2}}>Try Again</Button>
                </Alert>
             ) : (
                <>
                   <CircularProgress size={50} />
                   <Typography sx={{mt: 2}}>Validating Records...</Typography>
                </>
             )}
          </Box>
        )}

        {/* STEP 2: PREVIEW */}
        {activeStep === 2 && (
           <>
              <Alert severity="success" icon={<CheckCircle fontSize="inherit" />}>
                 Validation Successful! {totalRows.toLocaleString()} rows ready.
              </Alert>
              
              {totalRows > 2000 && (
                 <Alert severity="warning" sx={{mt: 1}}>
                    Displaying first 2000 rows only. Full batch will be created.
                 </Alert>
              )}

              <TableContainer component={Paper} sx={JournalStyles.tableContainer}>
                 <Table stickyHeader size="small">
                    <TableHead>
                       <TableRow>
                          <TableCell sx={JournalStyles.tableHeader}>ID</TableCell>
                          <TableCell sx={JournalStyles.tableHeader}>Branch</TableCell>
                          <TableCell sx={JournalStyles.tableHeader}>Currency</TableCell>
                          <TableCell sx={JournalStyles.tableHeader}>CGL</TableCell>
                          <TableCell align="right" sx={JournalStyles.tableHeader}>Amount</TableCell>
                          <TableCell align="center" sx={JournalStyles.tableHeader}>Type</TableCell>
                          <TableCell sx={JournalStyles.tableHeader}>Remarks</TableCell>
                          {hasProductColumn && <TableCell sx={JournalStyles.tableHeader}>Product</TableCell>}
                       </TableRow>
                    </TableHead>
                    <TableBody>
                       {previewRows.map((row, idx) => (
                          <TableRow key={idx} hover>
                             <TableCell>{row.id}</TableCell>
                             <TableCell>{row.branch}</TableCell>
                             <TableCell>{row.currency}</TableCell>
