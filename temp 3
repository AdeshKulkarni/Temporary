      headerAlign: "center" 
    },
    { 
      field: "amount", 
      headerName: "Amount", 
      flex: 1.5, 
      align: "right", 
      headerAlign: "center",
      // FIXED: Displays String directly to handle huge numbers (16.4 precision)
      valueFormatter: (params) => {
        const val = (params && typeof params === 'object' && 'value' in params) ? params.value : params;
        
        if (!val) return "0.00";
        
        // Simple formatter: Add commas to integer part, keep decimal part exactly as is
