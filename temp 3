import React, { useState, useRef } from 'react';
import { 
  AppBar, 
  Toolbar, 
  Typography, 
  Container, 
  Paper, 
  Box, 
  Grid, 
  TextField, 
  Button, 
  Card, 
  CardContent, 
  Alert, 
  Table, 
  TableBody, 
  TableCell, 
  TableContainer, 
  TableHead, 
  TableRow, 
  Chip,
  Stack,
  CircularProgress,
  Divider
} from '@mui/material';
import { 
  CloudUpload as CloudUploadIcon, 
  DateRange as DateRangeIcon, 
  Description as DescriptionIcon, 
  CheckCircle as CheckCircleIcon,
  Download as DownloadIcon,
  RestartAlt as RestartAltIcon
} from '@mui/icons-material';

const JournalBulkUplod = () => {
  const [selectedDate, setSelectedDate] = useState('');
  const [file, setFile] = useState(null);
  const [processedRows, setProcessedRows] = useState([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');
  const [successMsg, setSuccessMsg] = useState('');
  
  // Hidden input ref for file upload
  const fileInputRef = useRef(null);

  // --- LOGIC FUNCTIONS (Same as before) ---

  const padZeros = (str, length) => {
    const s = String(str || '');
    return s.padStart(length, '0');
  };

  const formatAmount = (val) => {
    const num = parseFloat(val);
    if (isNaN(num)) return '0000000000000000.0000';
    const fixed = num.toFixed(4);
    const [integerPart, decimalPart] = fixed.split('.');
    const paddedInt = integerPart.padStart(16, '0');
    return `${paddedInt}.${decimalPart}`;
  };

  const getFinancialInfo = (dateString) => {
    if (!dateString) return { year: '', month: '', formattedDate: '' };
    
    const date = new Date(dateString);
    const day = date.getDate();
    const monthIndex = date.getMonth() + 1; 
    const fullYear = date.getFullYear();

    const dd = String(day).padStart(2, '0');
    const mm = String(monthIndex).padStart(2, '0');
    const formattedDate = `${dd}${mm}${fullYear}`;

    let finYear, finMonth;
    if (monthIndex >= 4) {
      finYear = fullYear;
      finMonth = monthIndex - 3;
    } else {
      finYear = fullYear - 1;
      finMonth = monthIndex + 9;
    }

    return { 
      year: String(finYear), 
      month: String(finMonth).padStart(2, '0'), 
      formattedDate 
    };
  };

  // --- HANDLERS ---

  const handleDateChange = (e) => {
    setSelectedDate(e.target.value);
    setProcessedRows([]);
    setSuccessMsg('');
    setError('');
  };

  const handleFileChange = (e) => {
    const selectedFile = e.target.files[0];
    if (selectedFile) {
      const fileType = selectedFile.name.split('.').pop().toLowerCase();
      if (fileType !== 'xlsx' && fileType !== 'xls') {
        setError('Invalid file type. Please upload .xlsx or .xls');
        setFile(null);
        return;
      }
      setFile(selectedFile);
      setError('');
      setSuccessMsg('');
      setProcessedRows([]);
    }
  };

  const resetForm = () => {
    setFile(null);
    setSelectedDate('');
    setProcessedRows([]);
    setError('');
    setSuccessMsg('');
    if (fileInputRef.current) fileInputRef.current.value = '';
  };

  const processFile = async () => {
    if (!selectedDate || !file) {
      setError('Please select a Date and upload a File.');
      return;
    }

    setLoading(true);
    setError('');

    // Load XLSX via CDN if not present (simulating environment)
    if (!window.XLSX) {
      const script = document.createElement('script');
      script.src = "https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js";
      document.body.appendChild(script);
      await new Promise((resolve) => script.onload = resolve);
    }

    const reader = new FileReader();
    reader.onload = (e) => {
      try {
        const data = new Uint8Array(e.target.result);
        const workbook = window.XLSX.read(data, { type: 'array' });
        const worksheet = workbook.Sheets[workbook.SheetNames[0]];
        const jsonData = window.XLSX.utils.sheet_to_json(worksheet);

        if (jsonData.length === 0) {
          setError('File is empty.');
          setLoading(false);
          return;
        }

        const { year: finYear, month: finMonth, formattedDate } = getFinancialInfo(selectedDate);

        const mappedData = jsonData.map((row, index) => {
          const getVal = (key) => row[key] || row[key.toLowerCase()] || row[key.toUpperCase()] || '';

          // Mapping Logic
          const col1 = "01";
          const col2 = formattedDate;
          const col3 = finYear;
          const col4 = finMonth;
          const col5 = padZeros(getVal('branch') || getVal('Branch'), 5);
          const col6 = getVal('currency') || 'INR';
          const col7 = getVal('cgl') || getVal('code') || ''; 
          const col8 = formatAmount(getVal('amount'));
          const col9 = getVal('txntype') || getVal('TxnType');
          const col10 = getVal('Remarks') || getVal('remarks');
          
          // Fixed trailing columns
          const csvLine = [col1, col2, col3, col4, col5, col6, col7, col8, col9, col10, "000000000", "00000", "0000000000", "X"].join(',');

          return {
            id: index,
            csvLine: csvLine,
            preview: { date: col2, finYear: col3, finMonth: col4, branch: col5, amount: col8, remarks: col10 }
          };
        });

        setProcessedRows(mappedData);
        setSuccessMsg(`Processed ${mappedData.length} records successfully.`);
      } catch (err) {
        console.error(err);
        setError('Failed to process file. Check format.');
      } finally {
        setLoading(false);
      }
    };
    reader.readAsArrayBuffer(file);
  };

  const downloadCSV = () => {
    if (processedRows.length === 0) return;
    const csvContent = processedRows.map(r => r.csvLine).join('\n');
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    const url = URL.createObjectURL(blob);
    const fileName = `Journal_Upload_${selectedDate}.csv`;
    link.setAttribute('href', url);
    link.setAttribute('download', fileName);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  // --- UI RENDER ---

  const financialInfo = getFinancialInfo(selectedDate);

  return (
    <Box sx={{ flexGrow: 1, bgcolor: '#f5f5f5', minHeight: '100vh', pb: 4 }}>
      {/* 1. App Bar */}
      <AppBar position="static" color="primary" elevation={2}>
        <Toolbar>
          <DescriptionIcon sx={{ mr: 2 }} />
          <Typography variant="h6" component="div" sx={{ flexGrow: 1 }}>
            JournalBulkUplod
          </Typography>
          <Chip label="v1.0.0" size="small" color="secondary" />
        </Toolbar>
      </AppBar>

      <Container maxWidth="lg" sx={{ mt: 4 }}>
        <Grid container spacing={3}>
          
          {/* 2. Controls Section */}
          <Grid item xs={12}>
            <Card elevation={3}>
              <CardContent>
                <Grid container spacing={3} alignItems="flex-start">
                  
                  {/* Step 1: Date Selection */}
                  <Grid item xs={12} md={4}>
                    <Typography variant="subtitle2" color="textSecondary" gutterBottom>
                      Step 1: Select Date
                    </Typography>
                    <TextField
                      type="date"
                      fullWidth
                      variant="outlined"
                      value={selectedDate}
                      onChange={handleDateChange}
                      InputLabelProps={{ shrink: true }}
                    />
                    {selectedDate && (
                      <Stack direction="row" spacing={1} sx={{ mt: 1 }}>
                        <Chip label={`Fin Year: ${financialInfo.year}`} size="small" color="primary" variant="outlined" />
                        <Chip label={`Fin Month: ${financialInfo.month}`} size="small" color="primary" variant="outlined" />
                      </Stack>
                    )}
                  </Grid>

                  {/* Step 2: File Upload */}
                  <Grid item xs={12} md={4}>
                    <Typography variant="subtitle2" color="textSecondary" gutterBottom>
                      Step 2: Upload Excel
                    </Typography>
                    <Box sx={{ display: 'flex', flexDirection: 'column', gap: 1 }}>
                      <Button
                        variant="outlined"
                        component="label"
                        startIcon={<CloudUploadIcon />}
                        fullWidth
                        sx={{ height: 56, borderStyle: 'dashed', borderWidth: 2 }}
                      >
                        {file ? 'Change File' : 'Select Excel File'}
                        <input
                          type="file"
                          hidden
                          accept=".xlsx, .xls"
                          onChange={handleFileChange}
                          ref={fileInputRef}
                        />
                      </Button>
                      {file && (
                        <Typography variant="caption" sx={{ display: 'block', textAlign: 'center' }}>
                          Selected: <strong>{file.name}</strong>
                        </Typography>
                      )}
                    </Box>
                  </Grid>

                  {/* Step 3: Actions */}
                  <Grid item xs={12} md={4} sx={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
                    <Typography variant="subtitle2" color="textSecondary" gutterBottom>
                      Step 3: Process
                    </Typography>
                    <Button
                      variant="contained"
                      size="large"
                      onClick={processFile}
                      disabled={loading || !file || !selectedDate}
                      startIcon={loading ? <CircularProgress size={20} color="inherit" /> : <CheckCircleIcon />}
                      fullWidth
                    >
                      {loading ? 'Processing...' : 'Process & Preview'}
                    </Button>
                    <Button 
                      variant="text" 
                      color="error" 
                      size="small" 
                      onClick={resetForm}
                      startIcon={<RestartAltIcon />}
                    >
                      Reset All
                    </Button>
                  </Grid>
                </Grid>

                {/* Status Messages */}
                <Box sx={{ mt: 3 }}>
                  {error && <Alert severity="error">{error}</Alert>}
                  {successMsg && <Alert severity="success">{successMsg}</Alert>}
                </Box>
              </CardContent>
            </Card>
          </Grid>

          {/* 3. Preview Section */}
          {processedRows.length > 0 && (
            <Grid item xs={12}>
              <Paper elevation={3} sx={{ overflow: 'hidden' }}>
                <Box sx={{ p: 2, display: 'flex', justifyContent: 'space-between', alignItems: 'center', bgcolor: '#e3f2fd' }}>
                  <Typography variant="h6" color="primary">
                    Data Preview ({processedRows.length} rows)
                  </Typography>
                  <Button 
                    variant="contained" 
                    color="success" 
                    startIcon={<DownloadIcon />}
                    onClick={downloadCSV}
                  >
                    Download CSV
                  </Button>
                </Box>
                <Divider />
                <TableContainer sx={{ maxHeight: 440 }}>
                  <Table stickyHeader size="small">
                    <TableHead>
                      <TableRow>
                        <TableCell><strong>Date</strong></TableCell>
                        <TableCell><strong>FY</strong></TableCell>
                        <TableCell><strong>FM</strong></TableCell>
                        <TableCell><strong>Branch</strong></TableCell>
                        <TableCell align="right"><strong>Amount (16.4)</strong></TableCell>
                        <TableCell><strong>Remarks</strong></TableCell>
                        <TableCell><strong>Raw CSV String</strong></TableCell>
                      </TableRow>
                    </TableHead>
                    <TableBody>
                      {processedRows.slice(0, 50).map((row) => (
                        <TableRow hover key={row.id}>
                          <TableCell>{row.preview.date}</TableCell>
                          <TableCell>{row.preview.finYear}</TableCell>
                          <TableCell>{row.preview.finMonth}</TableCell>
                          <TableCell sx={{ color: 'primary.main', fontWeight: 'bold' }}>
                            {row.preview.branch}
                          </TableCell>
                          <TableCell align="right" sx={{ fontFamily: 'monospace' }}>
                            {row.preview.amount}
                          </TableCell>
                          <TableCell>{row.preview.remarks}</TableCell>
                          <TableCell sx={{ fontFamily: 'monospace', fontSize: '0.75rem', color: 'text.secondary' }}>
                            {row.csvLine}
                          </TableCell>
                        </TableRow>
                      ))}
                    </TableBody>
                  </Table>
                </TableContainer>
                {processedRows.length > 50 && (
                  <Box sx={{ p: 1, textAlign: 'center', bgcolor: '#f5f5f5' }}>
                    <Typography variant="caption">Showing first 50 rows only</Typography>
                  </Box>
                )}
              </Paper>
            </Grid>
          )}
        </Grid>
      </Container>
    </Box>
  );
};

export default JournalBulkUplod;
