The issue you are facing is almost certainly due to Security/Authentication.
When you use window.location.href, the browser makes a standard GET request without your Authorization Bearer Token. If your backend is secured (which it is), the server returns 401 Unauthorized or 403 Forbidden, and the download silently fails or redirects to a login page.
To fix this, we must fetch the file using JavaScript (with the token), create a "Blob" (file object) in memory, and then download it.
Here are the corrected, production-ready files.
1. Frontend: JournalBulkUpload.js (Fixed Download Logic)
Key Fixes:
 * downloadFileWithAuth: A new function that uses fetch (or your API hook) to get the file with headers.
 * Auto-Download: Automatically calls this function when ERROR status is detected.
 * UI Feedback: Shows "Downloading..." while the file is being fetched.
<!-- end list -->
import React, { useState, useRef, useEffect } from "react";
import {
  Box, Typography, Paper, TextField, Button, CircularProgress, Chip, Alert, Stack,
  Stepper, Step, StepLabel, LinearProgress
} from "@mui/material";
import {
  CloudUpload as CloudUploadIcon, RestartAlt as RestartAltIcon, Description as DescriptionIcon,
  CheckCircle as CheckCircleIcon, Error as ErrorIcon, Download as DownloadIcon, Send as SendIcon,
  FormatListBulleted as FormatIcon, Storage as DbIcon, Balance as BalanceIcon, DoneAll as DoneIcon
} from "@mui/icons-material";
import { DataGrid } from "@mui/x-data-grid";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import {
  mainContainerStyle, uploadBoxStyle, controlPanelStyle, iconStyle, headerTextStyle, subTextStyle, dateinputfield, stepperContainerStyle, stepLabelStyle, progressContainerStyle
} from "./JournalBulkStyle";

const steps = ['Format Validation', 'Database Check', 'Balance Check', 'Finalizing'];

const JournalBulkUpload = () => {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  const [selectedDate, setSelectedDate] = useState("");
  const [file, setFile] = useState(null);
  
  // State
  const [requestId, setRequestId] = useState(null);
  const [isProcessing, setIsProcessing] = useState(false);
  const [activeStep, setActiveStep] = useState(0);
  const [failedStep, setFailedStep] = useState(-1);
  
  // Results
  const [resultStatus, setResultStatus] = useState(null); // SUCCESS/ERROR
  const [resultMsg, setResultMsg] = useState("");
  const [previewRows, setPreviewRows] = useState([]);
  const [totalRows, setTotalRows] = useState(0);
  const [processedRows, setProcessedRows] = useState(0);
  const [hasSuccessFile, setHasSuccessFile] = useState(false);
  const [errorCount, setErrorCount] = useState(0);
  const [isDownloading, setIsDownloading] = useState(false);

  const [isCreatingBatch, setIsCreatingBatch] = useState(false);
  const fileInputRef = useRef(null);

  // --- CRITICAL: AUTHENTICATED DOWNLOAD FUNCTION ---
  const downloadFileWithAuth = async (type) => {
    if (!requestId) return;
    setIsDownloading(true);
    
    try {
        // 1. Get Token from Storage (Adjust key 'persist:auth' or wherever you store it)
        let token = "";
        const authData = sessionStorage.getItem("persist:auth") || localStorage.getItem("persist:auth");
        if (authData) {
            const parsed = JSON.parse(authData);
            // Assuming structure. Adjust if your token is stored differently.
            if(parsed.token) token = parsed.token.replace(/"/g, ''); 
        }

        // 2. Fetch Blob with Auth Header
        const response = await fetch(`/JS/journals/download-bulk-file/${requestId}?type=${type}`, {
            method: 'GET',
            headers: {
                'Authorization': `Bearer ${token}`, // ATTACH TOKEN
            },
        });

        if (!response.ok) throw new Error("Download failed");

        // 3. Create Blob & Trigger Download
        const blob = await response.blob();
        const url = window.URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        // Set extension based on type
        link.setAttribute('download', type === "ERROR" ? `Error_Report_${requestId}.xlsx` : `Success_Journal_${requestId}.csv`);
        document.body.appendChild(link);
        link.click();
        link.parentNode.removeChild(link);
        window.URL.revokeObjectURL(url);
        
        showSnackBar("Report downloaded successfully.", "success");

    } catch (error) {
        console.error("Download Error", error);
        showSnackBar("Failed to download report. Please try again.", "error");
    } finally {
        setIsDownloading(false);
    }
  };

  // --- POLLING LOGIC ---
  useEffect(() => {
    let interval;
    if (isProcessing && requestId) {
      interval = setInterval(async () => {
        try {
          // Poll Status
          const res = await callApi(`/JS/journals/bulk-status/${requestId}`, null, "GET");
          if (!res) return;

          // Update Progress UI
          if (res.totalRows) setTotalRows(res.totalRows);
          if (res.processedCount) setProcessedRows(res.processedCount);
          if (res.currentStage > 0) setActiveStep(res.currentStage - 1);

          // CHECK: ERROR
          if (res.status === "ERROR") {
            clearInterval(interval); // Stop Polling
            setIsProcessing(false);
            
            // Set Error State
            setResultStatus("ERROR");
            setResultMsg(res.message);
            setErrorCount(res.errorCount);
            setFailedStep(res.currentStage ? res.currentStage - 1 : 0);
            setActiveStep(res.currentStage ? res.currentStage - 1 : 0);
            
            // Show Msg
            showSnackBar(res.message || "Validation Failed", "error");
            
            // AUTO DOWNLOAD ERROR REPORT
            if (res.hasErrorFile) {
                // Small delay to ensure UI updates first
                setTimeout(() => downloadFileWithAuth("ERROR"), 500); 
            }
          } 
          // CHECK: SUCCESS
          else if (res.status === "SUCCESS") {
            clearInterval(interval); // Stop Polling
            setIsProcessing(false);
            
            // Set Success State
            setResultStatus("SUCCESS");
            setActiveStep(4); // Complete
            setHasSuccessFile(res.hasSuccessFile);
            setTotalRows(res.totalRows); // Ensure final count matches
            if (res.previewData) setPreviewRows(res.previewData);
            
            showSnackBar("Validation Successful!", "success");
          }
        } catch (e) { 
            console.error("Poll Error", e);
            // Don't stop polling on single network glitch, but maybe log it
        }
      }, 1000); // 1 Second Interval
    }
    return () => clearInterval(interval);
  }, [isProcessing, requestId, callApi, showSnackBar]); // Dependencies

  // --- STANDARD HANDLERS ---
  
  const handleDateChange = (e) => {
    setSelectedDate(e.target.value);
    resetState();
  };

  const handleFileChange = (e) => {
    const selectedFile = e.target.files[0];
    if (selectedFile) {
      const name = selectedFile.name.toLowerCase();
      if (!name.endsWith(".xlsx") && !name.endsWith(".xls") && !name.endsWith(".csv")) {
        showSnackBar("Invalid file type. Only Excel/CSV allowed.", "error");
        setFile(null);
        return;
      }
      setFile(selectedFile);
      // Reset everything when new file picked
      resetState();
    }
  };

  const resetState = () => {
    setUiError("");
    setErrorCount(0);
    setHasSuccessFile(false);
    setPreviewRows([]);
    setTotalRows(0);
    setProcessedRows(0);
    setRequestId(null);
    setActiveStep(0);
    setFailedStep(-1);
    setResultStatus(null);
  };

  const resetForm = () => {
    setFile(null);
    setSelectedDate("");
    resetState();
    setIsProcessing(false);
    setIsCreatingBatch(false);
    if (fileInputRef.current) fileInputRef.current.value = "";
  };

  const startValidation = async () => {
    if (!file || !selectedDate) {
      showSnackBar("Please select Posting Date and File.", "warning");
      return;
    }
    resetState();
    setIsProcessing(true); // Start Spinner

    const formData = new FormData();
    formData.append("file", file);
    formData.append("postingDate", selectedDate);

    try {
      const res = await callApi("/JS/journals/bulk-validate-init", formData, "POST", "json", "multipart/form-data");
      if (res && res.requestId) {
          setRequestId(res.requestId);
          // Polling effect will kick in now because isProcessing=true and requestId is set
      } else {
          setIsProcessing(false);
          showSnackBar("Failed to initiate validation.", "error");
      }
    } catch (err) {
      setIsProcessing(false);
      showSnackBar("System Error: Could not connect to server.", "error");
    }
  };

  const handleSubmitBatch = async () => {
    if (previewRows.length === 0) return;
    setIsCreatingBatch(true);
    try {
      const payloadRows = previewRows.map((row) => ({
        changeType: "ADD",
        branch: row.branch,
        currency: row.currency,
        cgl: row.cgl,
        amount: row.txnType === "Credit" ? "-" + row.amount : row.amount,
        productType: row.productCode,
        remarks: row.remarks,
        arFlag: "A", acClassification: "A",
      }));
      const finalPayload = { commonBatchRemarks: `Bulk Upload - ${selectedDate}`, rows: payloadRows };
      const response = await callApi("/JS/journals/create-bulk-batch", finalPayload, "POST");
      if (response && response.status === "SUCCESS") {
        showSnackBar(`Batch Created! ID: ${response.batchId}`, "success");
        resetForm();
      }
    } catch (e) { showSnackBar("Failed to create batch.", "error"); } 
    finally { setIsCreatingBatch(false); }
  };

  // Columns Configuration
  const columns = [
    { field: "branch", headerName: "Branch", flex: 1, align: "center", headerAlign: "center" },
    { field: "currency", headerName: "Currency", width: 100, align: "center", headerAlign: "center" },
    { field: "cgl", headerName: "CGL", flex: 1.5, align: "center", headerAlign: "center" },
    { field: "productCode", headerName: "Product", width: 120, align: "center", headerAlign: "center", renderCell: (p) => p.value || "-" },
    { 
      field: "amount", headerName: "Amount", flex: 1.5, minWidth: 150, align: "right", headerAlign: "center",
      valueFormatter: (params) => {
        const val = params?.value || params;
        if (!val) return "0.00";
        const parts = String(val).split(".");
        parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        return parts.join(".");
      }
    },
    { 
      field: "txnType", headerName: "Type", width: 100, align: "center", headerAlign: "center",
      renderCell: (params) => (
        <Chip label={params.value} color={params.value === "Credit" ? "error" : "success"} size="small" variant="filled" sx={{ fontWeight: "bold", width: "80px" }} />
      )
    },
    { field: "remarks", headerName: "Remarks", flex: 2, align: "center", headerAlign: "center" },
  ];

  const progressPercent = totalRows > 0 ? Math.min(100, Math.round((processedRows / totalRows) * 100)) : 0;

  return (
    <Box sx={mainContainerStyle}>
      <Paper elevation={1} sx={controlPanelStyle}>
        
        <Box sx={dateinputfield}>
            <TextField type="date" label="Posting Date" size="small"
                value={selectedDate} onChange={handleDateChange}
                InputLabelProps={{ shrink: true }} inputProps={{ max: new Date().toISOString().split("T")[0] }} />
        </Box>

        <Box sx={uploadBoxStyle} onClick={() => fileInputRef.current.click()}>
          <input type="file" hidden accept=".xlsx,.xls,.csv" onChange={handleFileChange} ref={fileInputRef} />
          {file ? (
             <><DescriptionIcon color="success" sx={{ fontSize: 60, mb: 1 }} /><Typography sx={headerTextStyle}>{file.name}</Typography><Chip label="Ready" color="success" size="small" /></>
          ) : (
             <><CloudUploadIcon sx={iconStyle} /><Typography sx={headerTextStyle}>Click to Upload</Typography><Typography sx={subTextStyle}>Supported: .xlsx, .xls, .csv</Typography></>
          )}
        </Box>

        {/* STEPPER & PROGRESS */}
        {(isProcessing || resultStatus === "SUCCESS" || resultStatus === "ERROR") && (
            <Box sx={stepperContainerStyle}>
                <Stepper activeStep={activeStep} alternativeLabel>
                    {steps.map((label, index) => (
                        <Step key={label}>
                            <StepLabel error={index === failedStep} StepIconComponent={() => {
                                if (index === failedStep) return <ErrorIcon color="error" />;
                                if (index < activeStep) return <CheckCircleIcon color="success" />;
                                if (index === activeStep && isProcessing) return <CircularProgress size={20} />;
                                return <Typography color="text.disabled" fontWeight="bold">{index + 1}</Typography>;
                            }}>{label}</StepLabel>
                        </Step>
                    ))}
                </Stepper>
                {/* Live Count */}
                {isProcessing && totalRows > 0 && (
                    <Box sx={progressContainerStyle}>
                        <LinearProgress variant="determinate" value={progressPercent} sx={{ height: 8, borderRadius: 4 }} />
                        <Typography variant="caption" color="text.secondary" sx={{ display:'block', mt: 1 }}>
                            Processed: {processedRows.toLocaleString()} / {totalRows.toLocaleString()} ({progressPercent}%)
                        </Typography>
                    </Box>
                )}
            </Box>
        )}

        <Stack direction="row" justifyContent="center" spacing={2} sx={{ mt: 2 }}>
            <Button variant="contained" onClick={startValidation} disabled={isProcessing || !file || !selectedDate} size="large">
                {isProcessing ? "Processing..." : "Validate"}
            </Button>
            <Button variant="outlined" color="error" onClick={resetForm} disabled={isProcessing} size="large">Reset</Button>
        </Stack>

        {/* RESULTS AREA */}
        <Box sx={{ mt: 3 }}>
            
            {/* ERROR PANEL */}
            {resultStatus === "ERROR" && (
                <Alert severity="error" sx={{ mb: 2, border: "1px solid #ee0404ff" }}>
                    <Typography variant="subtitle2" fontWeight="bold">Validation Failed</Typography>
                    <Typography variant="body2">{resultMsg}</Typography>
                    <Button 
                        variant="outlined" color="error" size="small" startIcon={isDownloading ? <CircularProgress size={16} /> : <DownloadIcon />}
                        sx={{ mt: 1, bgcolor: 'background.paper' }}
                        onClick={() => downloadFileWithAuth("ERROR")}
                        disabled={isDownloading}
                    >
                        {isDownloading ? "Downloading..." : "Download Error Report"}
                    </Button>
                </Alert>
            )}

            {/* SUCCESS PANEL */}
            {resultStatus === "SUCCESS" && (
                <Paper variant="outlined" sx={{ p: 2, borderColor: "success.main" }}>
                    <Stack direction={{ xs: "column", sm: "row" }} justifyContent="space-between" alignItems="center" spacing={2}>
                        <Box>
                            <Stack direction="row" alignItems="center" spacing={1}>
                                <CheckCircleIcon color="success" />
                                <Typography variant="subtitle1" fontWeight="bold">Validation Successful!</Typography>
                            </Stack>
                            <Typography variant="body2">{totalRows.toLocaleString()} rows verified.</Typography>
                        </Box>
                        <Stack direction="row" spacing={2}>
                            {hasSuccessFile && !isCsvInput && (
                                <Button 
                                    variant="outlined" color="success" startIcon={<DownloadIcon />} 
                                    onClick={() => downloadFileWithAuth("SUCCESS")}
                                    sx={{ bgcolor: "background.paper" }}
                                    disabled={isDownloading}
                                >
                                    Download CSV
                                </Button>
                            )}
                            <Button 
                                variant="contained" color="success" startIcon={isCreatingBatch ? <CircularProgress size={20} color="inherit" /> : <SendIcon />} 
                                onClick={handleSubmitBatch} disabled={isCreatingBatch}
                            >
                                {isCreatingBatch ? "Creating..." : "Create Batch"}
                            </Button>
                        </Stack>
                    </Stack>
                </Paper>
            )}
        </Box>
      </Paper>

      {/* DATA GRID - Only show on Success */}
      {resultStatus === "SUCCESS" && previewRows.length > 0 && (
        <Paper elevation={1} sx={{ p: 0, mt: 3, height: 600, width: "100%", borderRadius: 2, overflow: "hidden" }}>
          <Box sx={{ p: 2, borderBottom: 1, borderColor: "divider" }}><Typography variant="h6" sx={{ fontWeight: 600 }}>Data Preview (Top 100)</Typography></Box>
          <DataGrid rows={previewRows} columns={columns} pageSize={10} rowsPerPageOptions={[10, 25, 50, 100]} disableSelectionOnClick density="comfortable" sx={{ border: "none" }} />
        </Paper>
      )}
    </Box>
  );
};

export default JournalBulkUpload;

2. Backend: JournalRequestController.java (Ensure Correct MIME)
Make sure your downloadBulkFile returns the correct Content-Type so the browser treats it as a file.
    @GetMapping("/download-bulk-file/{requestId}")
    public ResponseEntity<Resource> downloadBulkFile(
            @PathVariable String requestId, 
            @RequestParam String type 
    ) {
        byte[] fileData = journalBulkValidationService.getFileFromRedis(requestId, type);

        if (fileData == null) return ResponseEntity.notFound().build();

        String fileName = "ERROR".equalsIgnoreCase(type) ? "Error_Report.xlsx" : "Processed_Journal.csv";
        // CRITICAL: Use correct MIME for Excel
        String mimeType = "ERROR".equalsIgnoreCase(type) 
                          ? "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" 
                          : "text/csv";

        return ResponseEntity.ok()
                .header(HttpHeaders.CONTENT_DISPOSITION, "attachment; filename=\"" + fileName + "\"")
                .contentLength(fileData.length)
                .contentType(MediaType.parseMediaType(mimeType))
                .body(new ByteArrayResource(fileData));
    }

