 public RequestVid terminateVoucher(TerminateVidDto terminateDto) {

                RequestVid requestVid = requestVidRepository.findById(terminateDto.getId())
                                .orElseThrow(() -> new RuntimeException("Voucher not found"));

                requestVid.setStatus("TERMINATED");
                String name = SecurityContextHolder.getContext().getAuthentication().getName();
                log.info("name >>" + name);
                log.info("Dto name >>" + terminateDto.getTerminatedBy());
                requestVid.setTerminatedBy(SecurityContextHolder.getContext().getAuthentication().getName());
                requestVid.setTerminatedAt(LocalDateTime.now(ZoneId.of("Asia/Kolkata")));
                requestVid.setRemarks(terminateDto.getRemarks());
                return requestVidRepository.save(requestVid);
        }
