        </Box>

        <Box sx={uploadBoxStyle} onClick={handleUploadClick}>
          <input type="file" hidden accept=".xlsx,.xls,.csv" onChange={handleFileChange} ref={fileInputRef} />
          {file ? (
             <><DescriptionIcon color="success" sx={{ fontSize: 60, display: 'block', margin: '0 auto' }} />
               <Typography sx={headerTextStyle}>{file.name}</Typography>
               <Chip label="Ready" color="success" size="small" sx={{ margin: '0 auto' }} /></>
          ) : (
             <><CloudUploadIcon sx={iconStyle} /><Typography sx={headerTextStyle}>Click to Upload</Typography></>
          )}
        </Box>

        {(isProcessing || resultStatus) && (
            <Box sx={stepperContainerStyle}>
                <Stepper activeStep={activeStep} alternativeLabel>
                    {steps.map((label, index) => (
                        <Step key={label}>
                            <StepLabel error={index === failedStep} StepIconComponent={() => {
                                if (index === failedStep) return <ErrorIcon color="error" />;
                                if (index < activeStep || resultStatus === "SUCCESS") return <CheckCircleIcon color="success" />;
                                if (index === activeStep && isProcessing) return <CircularProgress size={20} />;
                                return <Typography color="text.disabled" fontWeight="bold">{index + 1}</Typography>;
                            }}>{label}</StepLabel>
                        </Step>
                    ))}
                </Stepper>
            </Box>
        )}

        <Stack direction="row" justifyContent="center" spacing={2} sx={{ mt: 2 }}>
            <Button variant="contained" onClick={startValidation} disabled={isProcessing || !file || !selectedDate} size="large">
                {isProcessing ? "Processing..." : "Validate"}
            </Button>
            <Button variant="outlined" color="error" onClick={resetForm} disabled={isProcessing} size="large">Reset</Button>
        </Stack>

        <Box sx={{ mt: 3 }}>
            {resultStatus === "ERROR" && (
                <Alert severity="error" sx={{ mb: 2, border: "1px solid #ee0404ff" }}>
                    <Typography variant="subtitle2" fontWeight="bold">Validation Failed</Typography>
                    <Typography variant="body2">{resultMsg}</Typography>
                    {downloadStatus ? (
                        <Button color="inherit" size="small" onClick={() => handleDownloadFile("ERROR")}>Download Again</Button>
                    ) : (
                        <Typography variant="caption" sx={{ mt: 1 }}>Downloading Report...</Typography>
                    )}
                </Alert>
            )}

            {resultStatus === "SUCCESS" && (
                <Paper variant="outlined" sx={{ p: 2, borderColor: "success.main" }}>
                    <Stack direction={{ xs: "column", sm: "row" }} justifyContent="space-between" alignItems="center">
                        <Box><Typography fontWeight="bold" color="success.main">Success!</Typography><Typography variant="body2">{totalRows} rows ready.</Typography></Box>
                        <Stack direction="row" spacing={2}>
                            <Button variant="outlined" onClick={() => handleDownloadFile("SUCCESS")}>Download CSV</Button>
                            <Button variant="contained" color="success" onClick={handleSubmitBatch}>Create Batch</Button>
                        </Stack>
                    </Stack>
                </Paper>
            )}
        </Box>
      </Paper>

      {resultStatus === "SUCCESS" && previewRows.length > 0 && (
         <Paper elevation={1} sx={{ mt: 3, height: 500, width: '100%' }}>
             <DataGrid rows={previewRows} columns={columns} />
         </Paper>
      )}
    </Box>
  );
};

export default JournalBulkUpload;

