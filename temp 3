import java.util.ArrayList;
import java.util.List;

public class SlidingWindowTemplate {

    public List<Integer> fixedSlidingWindow(String s, int k) {
        List<Integer> result = new ArrayList<>();
        int M = s.length();
        
        // Edge case: string is shorter than the fixed window size
        if (s == null || M < k) {
            return result;
        }

        // 1. Initialize state (e.g., array for character frequencies)
        int[] windowCounts = new int[26]; 
        
        // 2. Initialize our two pointers
        int low = 0;
        int high = 0;

        // 3. Traverse the string
        while (high < M) {
            
            // Step A: Include the character at the 'high' pointer
            char c = s.charAt(high);
            windowCounts[c - 'a']++;

            // Step B: Check window size (high - low + 1)
            
            if (high - low + 1 < k) {
                // The window is not yet full. 
                // Only expand the 'high' pointer.
                high++;
            } 
            else if (high - low + 1 == k) {
                // The window has hit exactly size k.
                
                // ==========================================
                // Step C: PROCESS YOUR BUSINESS LOGIC HERE
                // Example: if (isValid(windowCounts)) { result.add(low); }
                // ==========================================

                // Step D: Remove the character at the 'low' pointer
                // to prepare the window for the next slide.
                char leftChar = s.charAt(low);
                windowCounts[leftChar - 'a']--;

                // Step E: Slide the entire window forward
                low++;
                high++;
            }
        }
        
        return result;
    }
}
