Here are the exact replacements to make in your pom.xml to resolve all the identified vulnerabilities.
1. Update Properties (Fixes Jackson & Log4j)
Replace this:
        <!-- ADDED: fixes jackson-core 2.21.4 / 3.1.4 (transitive) CVEs -->
        <jackson-bom.version>3.2.3</jackson-bom.version>
        <jackson-2-bom.version>2.22.3</jackson-2-bom.version>

With this (updates Jackson and adds a standard Spring Boot property to force the secure Log4j version):
        <!-- Fixes Jackson CVE-2026-110879 & CVE-2026-110729 -->
        <jackson-bom.version>3.2.4</jackson-bom.version>
        <jackson-2-bom.version>2.22.4</jackson-2-bom.version>
        <!-- Fixes Log4j CVE-2026-49844 -->
        <log4j2.version>2.25.5</log4j2.version>

2. Update Jackson Dependencies (Fixes Jackson DataBind)
Replace this:
        <!-- Fix for Jackson 3.x (CHANGED: 3.2.2 -> 3.2.3) -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>3.2.3</version>
        </dependency>

        <!-- Fix for Jackson 2.x (CHANGED: 2.22.2 -> 2.22.3) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.22.3</version>
        </dependency>

With this:
        <!-- Fix for Jackson 3.x -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>3.2.4</version>
        </dependency>

        <!-- Fix for Jackson 2.x -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.22.4</version>
        </dependency>

3. Update Apache POI Dependencies (Fixes POI & Commons-Compress)
Replace this:
         <dependency>
    		<groupId>org.apache.poi</groupId>
   			<artifactId>poi</artifactId>
   			<version>5.2.5</version>
		</dependency>
		<dependency>
    		<groupId>org.apache.poi</groupId>
    		<artifactId>poi-ooxml</artifactId>
    		<version>5.2.5</version>
		</dependency>

With this (updates POI and explicitly forces the secure version of commons-compress to satisfy the scanner):
         <dependency>
    		<groupId>org.apache.poi</groupId>
   			<artifactId>poi</artifactId>
   			<version>5.4.0</version>
		</dependency>
		<dependency>
    		<groupId>org.apache.poi</groupId>
    		<artifactId>poi-ooxml</artifactId>
    		<version>5.4.0</version>
		</dependency>
        <!-- Fixes Commons Compress CVE-2024-25710 & CVE-2024-26308 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>1.26.0</version>
        </dependency>

