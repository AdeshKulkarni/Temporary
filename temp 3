                 String evidence = data.get("evidence").toString(); // //byte64 as string
                // Convert the base 64 to byte array
                byte[] pdfBytes = Base64.getDecoder().decode(evidence);

                // generate the hashValue
                String hash = generateHash(evidence);

                lfar2.setObservationName(fileName);
                lfar2.setObservationUploadDate(new Date());
                lfar2.setObservationHash(hash);
                lfar2.setObservationFile(pdfBytes);
            }

            Lfar2 entity = lfar2Repository.save(lfar2);
            result.put("status", true);
            result.put("newId", entity.getId());
            result.put("newRowNum", entity.getId());
            result.put("fileId", fileName);
            result.put("fileName", fileName);
            log.info("Data saved successfully LFAR-2 : " + lfar2.getId());

        } catch (NullPointerException e) {
            log.info("Null Pointer Exception Occured" + e);
            result.put("status", false);
        } catch (Exception e) {
            log.info("Exception Occured" + e);
            result.put("status", false);
