class Solution {

    public int Helper(TreeNode root, int currentSum) {
        
        // Base Case: If we hit a null gap, return 0 sum
        if (root == null) {
            return 0;
        }
        
        // 1. Update the sum using Binary Math (Multiply by 2)
        currentSum = (currentSum * 2) + root.val;   

        // 2. If it's a leaf node, this path is finished! Return the final number.
        if (root.left == null && root.right == null) {
            return currentSum;
        }

        // 3. Otherwise, pass the updated 'currentSum' down BOTH branches
        // so the children remember the story so far.
        int leftSum = Helper(root.left, currentSum);
        int rightSum = Helper(root.right, currentSum);

        // 4. Send the total of both branches back up the tree
        return leftSum + rightSum;
    }

    public int sumRootToLeaf(TreeNode root) {
        // We pass 0 here because the Root node starts with no history.
        return Helper(root, 0);
    }
}
