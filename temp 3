class Solution {

    public int Helper(TreeNode root , int FinalSum , int currentSum) {

        if(root == null) {
            return 0;
        }
        
        currentSum = root.val * 10 + root.val;   

        if(root.left == null && root.right == null) {
            FinalSum += ConvertToInteger(currentSum);
        }

        Helper(root.left , FinalSum  , currentSum);
        Helper(root.right , FinalSum , currentSum);

        

        return FinalSum;
        
    }
    public int sumRootToLeaf(TreeNode root) {

        return Helper(root , 0, 0);
        
    }
}
