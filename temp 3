The problem is that you placed the error handling logic inside the try block, where the error variable does not exist.
When an API fails, the code immediately jumps to the catch (error) block, skipping your showSnackBar entirely. If the API succeeds, your code crashes because it tries to read from an error object that hasn't been defined.
Here is exactly what to replace to fix the handleTerminate function.
REPLACE THIS:
  const handleTerminate = async () => {
    try {
      const payload = {
        id: selectedRow?.id,
        terminatedBy: sessionStorage.getItem("userId"),
        remarks: deleteRemark,
      };

      await callApi(
        "/VE/voucher-transactions/terminate-vid",
        payload,
        "POST"
      );

      setDeleteDialogOpen(false);
       const errorMessage = error?.response?.data?.message || error?.message || "Failed To Create Voucher";

      showSnackBar(
          errorMessage,
          "error"
        );

      fetchVouchers();
    } catch (error) {
      setSnackbar({
        open: true,
        message: "Terminate failed",
        severity: "error",
      });
    }
  };

WITH THIS:
  const handleTerminate = async () => {
    try {
      const payload = {
        id: selectedRow?.id,
        terminatedBy: sessionStorage.getItem("userId"),
        remarks: deleteRemark,
      };

      await callApi(
        "/VE/voucher-transactions/terminate-vid",
        payload,
        "POST"
      );

      setDeleteDialogOpen(false);
      fetchVouchers();
      
      // Call success snackbar since the try block succeeded
      showSnackBar("Voucher terminated successfully", "success");
      
    } catch (error) {
      // The error object only exists down here in the catch block
      console.error("Terminate Error =>", error);
      setDeleteDialogOpen(false);
      
      const errorMessage = error?.response?.data?.message || error?.message || "Failed To Terminate Voucher";
      
      // Show the custom snackbar with the extracted error message
      showSnackBar(errorMessage, "error");
    }
  };

