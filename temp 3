  const [isCreatingBatch, setIsCreatingBatch] = useState(false);
  const fileInputRef = useRef(null);

  // --- DOWNLOAD HELPER ---
  const handleDownloadFile = async (type) => {
    if (!requestId) return;
    try {
        let token = "";
        const storage = sessionStorage.getItem("persist:auth") || localStorage.getItem("persist:auth");
        if (storage) {
            const parsed = JSON.parse(storage);
            if (parsed?.token) token = parsed.token.replace(/^"|"$/g, "");
        }

        const response = await fetch(`/JS/journals/download-bulk-file/${requestId}?type=${type}`, {
            method: "GET", headers: { Authorization: `Bearer ${token}` }
        });

        if (!response.ok) throw new Error("Download failed");

        const blob = await response.blob();
        const url = window.URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.setAttribute("download", type === "ERROR" ? `Error_Report_${requestId}.xlsx` : `Success_Journal_${requestId}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        window.URL.revokeObjectURL(url);

        if(type === "ERROR") setDownloadStatus("Report Downloaded");
        showSnackBar("File downloaded.", "success");
    } catch (e) {
        showSnackBar("Download failed.", "error");
    }
  };

  // --- POLLING ---
  useEffect(() => {
    let interval;
    if (isProcessing && requestId) {
      interval = setInterval(async () => {
        try {
          const res = await callApi(`/JS/journals/bulk-status/${requestId}`, null, "GET");
          if (!res) return;

          if (res.totalRows) setTotalRows(res.totalRows);
          if (res.currentStage > 0) setActiveStep(res.currentStage - 1);

          if (res.status === "ERROR") {
            setIsProcessing(false);
            setResultStatus("ERROR");
            setResultMsg(res.message);
            setErrorCount(res.errorCount);
            setFailedStep(res.currentStage ? res.currentStage - 1 : 0);
            clearInterval(interval);
            showSnackBar(res.message, "error");
            if (res.hasErrorFile) {
                setTimeout(() => handleDownloadFile("ERROR"), 500);
            }
          } else if (res.status === "SUCCESS") {
            setIsProcessing(false);
            setResultStatus("SUCCESS");
            setActiveStep(4);
            setHasSuccessFile(res.hasSuccessFile);
            setTotalRows(res.totalRows);
            if (res.previewDataJson) setPreviewRows(JSON.parse(res.previewDataJson));
            else if (res.previewData) setPreviewRows(res.previewData);
            clearInterval(interval);
            showSnackBar("Validation Successful!", "success");
          }
        } catch (e) {}
      }, 1000);
    }
    return () => clearInterval(interval);
  }, [isProcessing, requestId]);

  const handleUploadClick = () => {
