4. JournalBulkValidationService.java (New Service)
This service contains all the logic for parsing, validating masters, checking balances, and generating the error Excel file.
package com.fincore.JournalService.Service;

import com.fincore.JournalService.Models.BranchMaster;
import com.fincore.JournalService.Models.CglMaster;
import com.fincore.JournalService.Models.CurrencyMaster;
import com.fincore.JournalService.Repository.BranchMasterRepository;
import com.fincore.JournalService.Repository.CglMasterRepository;
import com.fincore.JournalService.Repository.CurrencyMasterRepository;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.apache.poi.ss.usermodel.*;
import org.apache.poi.xssf.usermodel.XSSFWorkbook;
import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;

import java.io.ByteArrayOutputStream;
import java.io.IOException;
import java.math.BigDecimal;
import java.util.*;
import java.util.stream.Collectors;

@Service
@RequiredArgsConstructor
@Slf4j
public class JournalBulkValidationService {

    private final BranchMasterRepository branchRepo;
    private final CglMasterRepository cglRepo;
    private final CurrencyMasterRepository currencyRepo;

    // Helper class to store row data temporarily
    private static class ExcelRowData {
        int rowIndex;
        String branch;
        String currency;
        String cgl;
        BigDecimal amount; // Signed amount (Credit is negative)
        String txnType;
        String remarks;
        List<String> errors = new ArrayList<>();
        Row originalRow; // To copy other cells if needed
    }

    public Map<String, Object> validateAndProcessExcel(MultipartFile file) throws IOException {
        // 1. Load Masters for Fast Lookup (Cache logic)
        Set<String> validBranches = branchRepo.findAll().stream()
                .map(BranchMaster::getCode).collect(Collectors.toSet());
        
        Set<String> validCgls = cglRepo.findAll().stream()
                .map(CglMaster::getCglNumber).collect(Collectors.toSet());
        
        // Assuming flag 1 is active, filtering active currencies
        Set<String> validCurrencies = currencyRepo.findAll().stream()
                .filter(c -> c.getFlag() != null && c.getFlag() == 1) // Only Active
                .map(CurrencyMaster::getCurrencyCode).collect(Collectors.toSet());

        // 2. Parse Excel
        List<ExcelRowData> parsedRows = new ArrayList<>();
        Workbook workbook = new XSSFWorkbook(file.getInputStream());
        Sheet sheet = workbook.getSheetAt(0);

        Map<String, BigDecimal> branchBalanceMap = new HashMap<>();

        for (Row row : sheet) {
            if (row.getRowNum() == 0) continue; // Skip Header if exists
            
            // Skip empty rows
            if (isRowEmpty(row)) continue;

            ExcelRowData data = new ExcelRowData();
            data.rowIndex = row.getRowNum();
            data.originalRow = row;

            // --- Read Columns (Assuming Fixed Order: 0:Branch, 1:Currency, 2:CGL, 3:Amount, 4:Type, 5:Remark) ---
            data.branch = getCellValueAsString(row.getCell(0));
            data.currency = getCellValueAsString(row.getCell(1));
            data.cgl = getCellValueAsString(row.getCell(2));
            String amountStr = getCellValueAsString(row.getCell(3));
            data.txnType = getCellValueAsString(row.getCell(4)); // Debit/Credit
            data.remarks = getCellValueAsString(row.getCell(5));

            // --- Individual Row Validation ---
            
            // 1. Master Validation
            if (!validBranches.contains(data.branch)) {
                data.errors.add("Invalid Branch Code");
            }
            if (!validCurrencies.contains(data.currency)) {
                data.errors.add("Invalid Currency Code");
            }
            if (!validCgls.contains(data.cgl)) {
                data.errors.add("Invalid CGL Number");
            }

            // 2. Remark Length Validation
            if (data.remarks != null && data.remarks.length() > 30) {
                data.errors.add("Remarks exceed 30 chars");
            }

            // 3. Amount Validation
            try {
                BigDecimal amt = new BigDecimal(amountStr);
                if (amt.compareTo(BigDecimal.ZERO) == 0) {
                    data.errors.add("Amount cannot be Zero");
                }
                
                // Determine sign for balancing check
                boolean isCredit = "Credit".equalsIgnoreCase(data.txnType) || "C".equalsIgnoreCase(data.txnType);
                if (isCredit) {
                    data.amount = amt.abs().negate();
                } else {
                    data.amount = amt.abs();
                }

            } catch (Exception e) {
                data.errors.add("Invalid Amount Format");
                data.amount = BigDecimal.ZERO;
            }

            // Add to Branch Balance Map (Key: Branch + Currency to be stricter, or just Branch as per requirement)
            // Requirement says "Branch wise total", usually implies per currency too, but sticking to prompt "Branch wise".
            String balanceKey = data.branch; 
            branchBalanceMap.put(balanceKey, 
                branchBalanceMap.getOrDefault(balanceKey, BigDecimal.ZERO).add(data.amount)
            );

            parsedRows.add(data);
        }

        // --- 4. Post-Row Validation: Branch Balancing ---
        boolean hasBalanceErrors = false;
        for (ExcelRowData data : parsedRows) {
            // Only check balance if the branch code itself was valid
            if (validBranches.contains(data.branch)) {
                BigDecimal total = branchBalanceMap.getOrDefault(data.branch, BigDecimal.ZERO);
                if (total.compareTo(BigDecimal.ZERO) != 0) {
                    data.errors.add("Branch Total Debit & Credit Mismatch");
                    hasBalanceErrors = true;
                }
            }
        }

        long errorCount = parsedRows.stream().filter(r -> !r.errors.isEmpty()).count();

        Map<String, Object> result = new HashMap<>();
        
        if (errorCount > 0) {
            // Generate Error Excel
            byte[] errorFile = generateErrorExcel(parsedRows);
            result.put("status", "ERROR");
            result.put("errorCount", errorCount);
            result.put("file", errorFile);
            result.put("message", "Validation failed. Found " + errorCount + " invalid rows.");
        } else {
            result.put("status", "SUCCESS");
            result.put("message", "All " + parsedRows.size() + " rows validated successfully!");
            // Here you would typically save the data to the DB if the requirement asked for it.
            // For now, we return success.
        }

        workbook.close();
        return result;
    }

    private byte[] generateErrorExcel(List<ExcelRowData> rows) throws IOException {
        Workbook workbook = new XSSFWorkbook();
        Sheet sheet = workbook.createSheet("Error Report");
        
        // Header Style
        CellStyle headerStyle = workbook.createCellStyle();
        Font font = workbook.createFont();
        font.setBold(true);
        font.setColor(IndexedColors.RED.getIndex());
        headerStyle.setFont(font);

        // Create Header
        Row header = sheet.createRow(0);
        String[] headers = {"Branch", "Currency", "CGL", "Amount", "TxnType", "Remarks", "ERRORS"};
        for (int i = 0; i < headers.length; i++) {
            Cell cell = header.createCell(i);
            cell.setCellValue(headers[i]);
            cell.setCellStyle(headerStyle);
        }

        int rowIdx = 1;
        for (ExcelRowData data : rows) {
            // Write all rows, even valid ones, but highlight errors? 
            // Usually only error rows are returned, or all rows with error column filled.
            // Let's return all rows so user can correct in place.
            
            Row row = sheet.createRow(rowIdx++);
            row.createCell(0).setCellValue(data.branch);
            row.createCell(1).setCellValue(data.currency);
            row.createCell(2).setCellValue(data.cgl);
            row.createCell(3).setCellValue(data.amount.abs().toString()); // Show absolute
            row.createCell(4).setCellValue(data.txnType);
            row.createCell(5).setCellValue(data.remarks);
            
            if (!data.errors.isEmpty()) {
                Cell errorCell = row.createCell(6);
                errorCell.setCellValue(String.join("; ", data.errors));
                errorCell.setCellStyle(headerStyle); // Reuse red font style
            }
        }

        // Autosize columns
        for(int i=0; i<7; i++) sheet.autoSizeColumn(i);

        ByteArrayOutputStream out = new ByteArrayOutputStream();
        workbook.write(out);
        workbook.close();
        return out.toByteArray();
    }

    private String getCellValueAsString(Cell cell) {
        if (cell == null) return "";
        switch (cell.getCellType()) {
            case STRING: return cell.getStringCellValue().trim();
            case NUMERIC: 
                if (DateUtil.isCellDateFormatted(cell)) return cell.getDateCellValue().toString();
                // Prevent scientific notation for large numbers/account numbers
                DataFormatter formatter = new DataFormatter();
                return formatter.formatCellValue(cell).trim();
            case BOOLEAN: return String.valueOf(cell.getBooleanCellValue());
            default: return "";
        }
    }

    private boolean isRowEmpty(Row row) {
        if (row == null) return true;
        for (int c = row.getFirstCellNum(); c < row.getLastCellNum(); c++) {
            Cell cell = row.getCell(c);
            if (cell != null && cell.getCellType() != CellType.BLANK && !getCellValueAsString(cell).trim().isEmpty())
                return false;
        }
        return true;
    }
}

